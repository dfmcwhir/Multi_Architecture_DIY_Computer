Name     SERIAL_DEC ;
PartNo   00 ;
Date     11/04/2026 ;
Revision 01 ;
Designer Engineer ;
Company  none ;
Assembly ISA serial card rev 3 (6551 + AVR keyboard/mouse/console) ;
Location U1 ;
Device   G22V10 ;

/*
 * Address map (6502 / Z80 port):
 *   $7F14-$7F17 / $14-$17  6551 ACIA (RS0 = A0, RS1 = A1)
 *   $7F1E       / $1E      read : key / mouse byte ('573 -> bus)
 *                          write: serial TX byte / command (bus -> '574)
 *   $7F1F       / $1F      read : status  D7 = KBAVAIL, D6 = DBUSY
 *                                 (BIT $7F1F: N = byte waiting, V = TX busy)
 *   $7F1C-$7F1D are the PICO9918 card's; this card ignores them.
 *
 * Rules followed (same as the other cards):
 *   - 6551 /CS2 is address-only (no clock): the 6551 samples it on phi2.
 *     6551 R/W comes straight from bus /IOw (not clock-gated).
 *   - "Read" = selected and /IOw high, valid during clock-low, so the
 *     keyboard strobes don't depend on the clock-gated /IOr (pin 2 unused).
 *   - Keyboard read strobe and the '574 clock are gated with CLK, so each
 *     access gives exactly one pulse.
 *   - DBUSY is registered on CLK rising (pin 1): set at the start of a
 *     write to $7F1E, cleared when the AVR holds /DOE low.
 *   - /KB_INT is open-drain, so it can share a bus IRQ line (J2).
 */

/* *************** INPUT PINS *********************/
PIN 1  = CLK ;       /* bus OSC (CPU clock) - also register clock      */
PIN 2  = nIOR ;      /* bus /IOR - not used                            */
PIN 3  = nIOW ;      /* bus /IOW - low = write, not clock-gated        */
PIN 4  = nIOEN ;     /* bus /IO_EN                                     */
PIN 5  = A7 ;
PIN 6  = A6 ;
PIN 7  = A5 ;
PIN 8  = A4 ;
PIN 9  = A3 ;
PIN 10 = A2 ;
PIN 11 = A1 ;
PIN 13 = A0 ;
PIN 14 = KBAVAIL ;   /* from AVR PC5 (I/O pin used as input)           */
PIN 23 = nDOE ;      /* from AVR PD4 (I/O pin used as input)           */

/* *************** OUTPUT PINS *********************/
PIN 15 = nKBINT ;    /* to J2 -> IRQ5/IRQ6, open drain                 */
PIN 16 = D7 ;        /* bus D7, status read only                       */
PIN 17 = !KBRD ;     /* '573 /OE and AVR PD2 (INT0)                    */
PIN 19 = !SERCS ;    /* 6551 /CS2                                      */
PIN 20 = D6 ;        /* bus D6, status read only                       */
PIN 21 = !KBWE ;     /* '574 CP - latches on the rising edge           */
PIN 22 = DBUSY ;     /* registered, to AVR PD3                         */
/* pin 18 unused */

/** Decodes (address only) **/
SELSER = !nIOEN & !A7 & !A6 & !A5 & A4 & !A3 & A2;             /* $14-$17 */
SELKB  = !nIOEN & !A7 & !A6 & !A5 & A4 & A3 & A2 & A1;         /* $1E-$1F */

/** 6551 **/
SERCS = SELSER;

/** Keyboard / mouse / console **/
KBRD = SELKB & !A0 & nIOW & CLK;           /* read $7F1E            */
KBWE = SELKB & !A0 & !nIOW & CLK;          /* write $7F1E           */

/* status read $7F1F */
D7    = KBAVAIL;
D7.oe = SELKB & A0 & nIOW & CLK;
D6    = DBUSY;
D6.oe = SELKB & A0 & nIOW & CLK;

/* TX handshake flag (sampled on CLK rising edges) */
DBUSY.d  = (SELKB & !A0 & !nIOW) # (DBUSY & nDOE);
DBUSY.ar = 'b'0;
DBUSY.sp = 'b'0;

/* open-drain interrupt: low while a byte is waiting */
nKBINT    = 'b'0;
nKBINT.oe = KBAVAIL;

/* always-enabled outputs */
KBRD.oe  = 'b'1;
SERCS.oe = 'b'1;
KBWE.oe  = 'b'1;
DBUSY.oe = 'b'1;
