	(text_box "/* \nGAL20V10\n\nInput Pins\n*/\n\nPIN 2 = A0;\nPIN 3 = A1;\nPIN 4 = A2;\nPIN 5 = A3;\nPIN 6 = A4;\nPIN 7 = A5;\nPIN 8 = A6;\nPIN 9 = A7;\nPIN 10 = IOr;\nPIN 11 = IOen;\n\n/* Output Pins */\nPIN 20 = CSR;\nPIN 21 = CSW;\nPIN 22 = BC1;\nPIN 23 = BDir;\n\n/* Addresses\nAYcmd= 7F22=	01111111 00100010\nAYdata= 7F23=	01111111 00100011\nSPOcs= 7F26=	01111111 00100110\n\n*/\n\nbaseAddr = !IOen & !A7 & !A6 & A5 & !A4 & !A3 & A1;\nAYcmd = baseAddr & !A2 & !A0;\nAYdata = baseAddr & !A2 & A0;\nSPOcs = baseAddr & A2 & !A0;\n\nBdir = (AYcmd & IOr) # (AYdata & IOr);\nBC1 = (AYdata & !IOr) # (AYcmd & IOr);\nCSR = !SPOcs # IOr\nCSW = !SPOcs # !IOr\n\n/*	AYcmd	AYdata	IOr	| Bdir	BC1	| State\n	0		0		X	|	0	0	|	INACTIVE\n	0		1		0	|	0	1	|	PSG Read\n	0		1		1	|	1	0	|	PSG Write\n	1		0		1	|	1	1	|	Address Latch\n\n/CSW = SPOcs & IOr	= Write to SPO\n/CSR = SPOcs & !IOr	= Read SPO status\n*/\n"
		(exclude_from_sim no)
		(at 87.63 143.51 0)
		(size 67.31 102.0905)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7d29ddd0-739e-4eb0-9235-dfca77b2b00c")
	)
