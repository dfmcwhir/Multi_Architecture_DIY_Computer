 10:
 11:/* 
 12:GAL20V10
 13:
 14:Input Pins
 15:*/
 16:
 17:PIN 2 = A0;
 18:PIN 3 = A1;
 19:PIN 4 = A2;
 20:PIN 5 = A3;
 21:PIN 6 = A4;
 22:PIN 7 = A5;
 23:PIN 8 = A6;
 24:PIN 9 = A7;
 25:PIN 10 = IOr;
 26:PIN 11 = IOen;
 27:
 28:/* Output Pins */
 29:PIN 20 = CSR;
 30:PIN 21 = CSW;
 31:PIN 22 = BC1;
 32:PIN 23 = BDir;
 33:
 34:/* Addresses
 35:AYcmd= 7F22=    01111111 00100010
 36:AYdata= 7F23=   01111111 00100011
 37:SPOcs= 7F26=    01111111 00100110
 38:
 39:*/
 40:
 41:baseAddr = !IOen & !A7 & !A6 & A5 & !A4 & !A3 & A1;
 42:AYcmd = baseAddr & !A2 & !A0;
 43:AYdata = baseAddr & !A2 & A0;
 44:SPOcs = baseAddr & A2 & !A0;
 45:
 46:BDir = (AYcmd & IOr) # (AYdata & IOr);
 47:BC1 = (AYdata & !IOr) # (AYcmd & IOr);
 48:CSR = !SPOcs # IOr;
 49:CSW = !SPOcs # !IOr;
 50:
 51:/*      AYcmd   AYdata  IOr     | Bdir  BC1     | State
 52:        0               0               X       |       0       0       |       INACTIVE
 53:        0               1               0       |       0       1       |       PSG Read

