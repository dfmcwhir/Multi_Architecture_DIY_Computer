	(text_box "* Wired directly, not through this GAL:\n *   bus A0       -> VDP pin 13 (MODE)\n *   bus A1       -> VDP pin 11 (MODE1)  (or GND)\n *   bus /RESET   -> VDP pin 34\n *   VDP /INT     -> SBC IRQ6 (socket pin 16)\n *   6502 D0..D7  -> VDP pins 17..24 (CD7..CD0, reversed: D7 -> pin 24)\n *   '573: D <- AVR bus, Q -> 6502 bus, LE <- AVR PD5, /OE <- nKBRD\n *   TX latch: see below.\n *\n * Rev 06 change - the serial TX latch is clocked straight from PHI2:\n *   nDISPWE (pin 21) is now \"write cycle to $7F1E\" with NO PHI2 term. It is\n *   settled during PHI2 low, long before PHI2 falls at the end of the cycle.\n *   The latch clock edge is then made from PHI2 by a fast gate on the card,\n *   a few ns after PHI2 falls - inside the 65C02's ~10 ns write data hold -\n *   so GAL speed no longer matters for this latch. Two ways to build it:\n *\n *   A) 74HCT574 (keep it), CLK <- 74ACT02 NOR(PHI2, nDISPWE), /OE <- /DOE\n *        CLK rises when PHI2 falls during a $7F1E write.\n *        It also rises once early in that write cycle (when nDISPWE goes\n *        low while PHI2 is still low), latching junk that the real edge\n *        then overwrites - harmless, as the handshake guarantees the AVR\n *        has already taken the previous byte.\n *        One gate, no other new chips.\n *\n *   B) 74HCT377, /E <- nDISPWE, CLK <- PHI2 via 74ACT04/74F04 inverter,\n *      plus a 74HCT541 between the '377 Q outputs and the AVR bus\n *      (/OE <- /DOE), because the '377 has no output enable.\n *        Cleanest: exactly one clock edge per cycle, no early edge.\n *        Costs two extra chips.\n */\n\n/* ---------------- Inputs ---------------- */\nPIN 1  = PHI2;      /* bus CLK_IN (PHI2), also the register clock */\nPIN 2  = nIOR;      /* /IOr from main GAL - not used in rev 05    */\nPIN 3  = nIOW;      /* /IOw from main GAL (address only)         */\nPIN 4  = nIO_EN;    /* /IO_EN, low when A15-A8 = $7F             */\nPIN 5  = A7;\nPIN 6  = A6;\nPIN 7  = A5;\nPIN 8  = A4;\nPIN 9  = A3;\nPIN 10 = A2;\nPIN 11 = A1;\nPIN 13 = A0;\nPIN 14 = KBAVAIL;   /* from AVR PC5, active high (I/O pin as input) */\nPIN 23 = nDOE;      /* from AVR PD4, low while AVR reads '574       */\n\n/* ---------------- Outputs ---------------- */\nPIN 15 = nKBIRQ;    /* to SBC IRQ5, active low                   */\nPIN 16 = D7;        /* to 6502 data bus D7, tri-state            */\nPIN 17 = nKBRD;     /* to '573 /OE and AVR PD2 (INT0)            */\nPIN 18 = nCSW;      /* to VDP pin 14                             */\nPIN 19 = nCSR;      /* to VDP pin 15                             */\nPIN 20 = D6;        /* to 6502 data bus D6, tri-state            */\nPIN 21 = nDISPWE;   /* TX latch enable (no PHI2) - see rev 06    */\nPIN 22 = DBUSY;     /* registered, to AVR PD3                    */\n"
		(exclude_from_sim no)
		(at 196.85 157.48 0)
		(size 100.33 120.65)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2623563f-3ce7-45f7-b459-e07ee9652f00")
