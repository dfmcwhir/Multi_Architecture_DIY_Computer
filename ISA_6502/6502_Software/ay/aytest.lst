000000r 1               ; ============================================================================
000000r 1               ; aytest.s - AYTEST: a test program for the AY-3-8910 sound card
000000r 1               ;
000000r 1               ;   build:  make.bat  (or make)        run:  L AYTEST 0500   then   R
000000r 1               ;
000000r 1               ; A menu of tests, each of which says what you should hear:
000000r 1               ;   1  each channel on its own (A, B, C at 440 Hz): checks the three outputs
000000r 1               ;   2  a scale on channel A (tone periods)
000000r 1               ;   3  a chord on A, B and C together, then arpeggios
000000r 1               ;   4  noise on all channels, low to high (noise period, mixer)
000000r 1               ;   5  the 8 envelope shapes (envelope period and shape registers)
000000r 1               ;   6  volume 0 to 15 and back (volume registers)
000000r 1               ;   7  sound effects: laser, explosion, siren, bell
000000r 1               ;   8  a sweep over every tone period, 4095 down to 1 (all 12 period bits)
000000r 1               ;   9  all of them, one after another
000000r 1               ;   Q  quit (to the boot menu)
000000r 1               ; Any key stops a test and goes back to the menu.  The card is write only,
000000r 1               ; so the program can't check itself: listen.
000000r 1               ; ============================================================================
000000r 1               
000000r 1                       .setcpu "6502"
000000r 1                       .include "sbc_api.inc"
000000r 2               ; sbc_api.inc - fixed ROM entry points of the SBC (see jumptable.s), and the
000000r 2               ; CPU clock.  Use in your own ca65 programs:  .include "sbc_api.inc"
000000r 2               ; (the games find it one folder up: their make.bat passes  -I ..  to ca65)
000000r 2               SBC_CHRIN       = $FE00         ; carry set + A = char, carry clear = none waiting
000000r 2               SBC_CHROUT      = $FE03         ; print A (A, X, Y preserved)
000000r 2               SBC_MENU        = $FE06         ; boot menu
000000r 2               SBC_COLD        = $FE09         ; BASIC cold start
000000r 2               SBC_WARM        = $FE0C         ; BASIC warm start
000000r 2               SBC_MONITOR     = $FE0F         ; monitor prompt (or JMP $FF00)
000000r 2               SBC_PADSTATE    = $FE12         ; A = gamepad buttons held: bit0 A,1 B,2 Select,3 Start,4 Up,5 Down,6 Left,7 Right
000000r 2               SBC_LOAD        = $FE15         ; load a file: A/Y = parameter block (.word addr, .word max, "NAME.EXT",0)
000000r 2                                               ;   carry clear = loaded, X/Y = length; carry set = failed, A = error code
000000r 2               SBC_CWD         = $FE18         ; A/Y = the monitor's current folder: 0-ended, "" (the top) or "/A/B"
000000r 2                                               ;   (newer ROMs: check for a JMP ($4C) at $FE18 first)
000000r 2               
000000r 2               ; The CPU clock in MHz (whole numbers, 1 to 8).  Programs size their delay
000000r 2               ; loops from it, so a millisecond stays a millisecond.  To build for another
000000r 2               ; clock, change it here or give it on the command line:  make.bat 1
000000r 2               .ifndef CLOCK_MHZ
000000r 2               CLOCK_MHZ       = 2
000000r 2               .endif
000000r 2               
000000r 1               
000000r 1                       .segment "CODE"
000000r 1  4C rr rr             jmp     start
000003r 1               
000003r 1                       .include "common.s"
000003r 2               ; ============================================================================
000003r 2               ; common.s - small helpers shared by AYTEST and YMPLAY: printing, keys, delays
000003r 2               ; ============================================================================
000003r 2               
000003r 2               ; PRINT label: print the 0-ended string at label; keeps X
000003r 2               .macro  PRINT   str
000003r 2                       lda     #<str
000003r 2                       ldy     #>str
000003r 2                       jsr     print
000003r 2               .endmacro
000003r 2               
000003r 2               ; print the 0-ended string at A (low) / Y (high).  Keeps X.
000003r 2  8D rr rr     print:  sta     @ld+1
000006r 2  8C rr rr             sty     @ld+2
000009r 2  AD FF FF     @ld:    lda     $FFFF
00000Cr 2  F0 0D                beq     @r
00000Er 2  20 03 FE             jsr     SBC_CHROUT
000011r 2  EE rr rr             inc     @ld+1
000014r 2  D0 F3                bne     @ld
000016r 2  EE rr rr             inc     @ld+2
000019r 2  D0 EE                bne     @ld
00001Br 2  60           @r:     rts
00001Cr 2               
00001Cr 2  A9 0D        crlf:   lda     #13
00001Er 2  20 03 FE             jsr     SBC_CHROUT
000021r 2  A9 0A                lda     #10
000023r 2  4C 03 FE             jmp     SBC_CHROUT
000026r 2               
000026r 2               ; print A as 2 decimal digits (0-99)
000026r 2  A2 30        prdec2: ldx     #'0'
000028r 2  C9 0A        @t:     cmp     #10
00002Ar 2  90 05                bcc     @u
00002Cr 2  E9 0A                sbc     #10
00002Er 2  E8                   inx
00002Fr 2  D0 F7                bne     @t
000031r 2  48           @u:     pha
000032r 2  8A                   txa
000033r 2  20 03 FE             jsr     SBC_CHROUT
000036r 2  68                   pla
000037r 2  09 30                ora     #'0'
000039r 2  4C 03 FE             jmp     SBC_CHROUT
00003Cr 2               
00003Cr 2               ; print A in hex
00003Cr 2  48           prhex:  pha
00003Dr 2  4A                   lsr
00003Er 2  4A                   lsr
00003Fr 2  4A                   lsr
000040r 2  4A                   lsr
000041r 2  20 rr rr             jsr     @d
000044r 2  68                   pla
000045r 2  29 0F                and     #$0F
000047r 2  C9 0A        @d:     cmp     #10
000049r 2  90 02                bcc     @n
00004Br 2  69 06                adc     #'A' - '0' - 10 - 1
00004Dr 2  69 30        @n:     adc     #'0'
00004Fr 2  4C 03 FE             jmp     SBC_CHROUT
000052r 2               
000052r 2               ; a key: carry set and A = the key (letters in upper case), or carry clear
000052r 2  20 00 FE     getkey: jsr     SBC_CHRIN
000055r 2  90 0B                bcc     @r
000057r 2  C9 61                cmp     #'a'
000059r 2  90 06                bcc     @y
00005Br 2  C9 7B                cmp     #'z' + 1
00005Dr 2  B0 02                bcs     @y
00005Fr 2  29 DF                and     #$DF
000061r 2  38           @y:     sec
000062r 2  60           @r:     rts
000063r 2               
000063r 2               ; wait for a key; A = the key (upper case)
000063r 2  20 rr rr     waitkey:jsr     getkey
000066r 2  90 FB                bcc     waitkey
000068r 2  60                   rts
000069r 2               
000069r 2               ; wait about A ms.  The inner loop is sized for the clock (CLOCK_MHZ in
000069r 2               ; sbc_api.inc): 5 + 4 * (CLOCK_MHZ - 1) cycles a turn, DELAY_N turns a ms.
000069r 2               DELAY_N = (1000 * CLOCK_MHZ - 7) / (5 + 4 * (CLOCK_MHZ - 1))
000069r 2               delay_ms:
000069r 2  AA                   tax
00006Ar 2  F0 0A                beq     @done
00006Cr 2  A0 DD        @o:     ldy     #DELAY_N
00006Er 2               @i:
00006Er 2  EA EA        .repeat CLOCK_MHZ - 1
000070r 2                       nop
000070r 2                       nop
000070r 2               .endrepeat
000070r 2  88                   dey
000071r 2  D0 FB                bne     @i
000073r 2  CA                   dex
000074r 2  D0 F6                bne     @o
000076r 2  60           @done:  rts
000077r 2               
000077r 1                       .include "ay.s"
000077r 2               ; ============================================================================
000077r 2               ; ay.s - AY-3-8910 sound chip driver for the 6502 SBC (ca65)
000077r 2               ;
000077r 2               ; The card (write only):
000077r 2               ;   AY_ADDR  $7F22  write the number of the register to use  (BDIR = BC1 = 1)
000077r 2               ;   AY_DATA  $7F23  write a value to that register           (BDIR = 1, BC1 = 0)
000077r 2               ;   BC2 and A8 tied high, A9 low; chip clock 2 MHz; the three channels mixed
000077r 2               ;   together (mono).  The I/O ports aren't used: register 7 keeps them inputs.
000077r 2               ;
000077r 2               ; Only plain STA abs is used on the card's addresses: an indexed store
000077r 2               ; (STA abs,X) can make an extra read cycle there first, and the card decodes
000077r 2               ; the address without looking at R/W.
000077r 2               ;
000077r 2               ; Routines (A, X, Y may change unless it says):
000077r 2               ;   ay_write    register X = A (A, X, Y kept)
000077r 2               ;   ay_silence  all channels off, volumes 0, envelope stopped
000077r 2               ;   ay_regs     registers 0-13 from the 14 bytes at (ay_ptr); register 13 is
000077r 2               ;               only written when it isn't $FF (writing it restarts the
000077r 2               ;               envelope)
000077r 2               ;   ay_tone     channel X (0-2) to tone period A (low) / Y (high)
000077r 2               ;   ay_note     channel X (0-2) to note A (0 = C1 .. 95 = B8, 45 = A4 440 Hz)
000077r 2               ;   ay_volume   channel X (0-2) to volume A (0-15; 16 = the envelope)
000077r 2               ;   ay_mixer    register 7 = A, the I/O port bits kept as inputs
000077r 2               ;
000077r 2               ; The registers:
000077r 2               ;   0/1 2/3 4/5  tone period of A, B, C (12 bits: low, high 4 bits):
000077r 2               ;                frequency = 2 MHz / (16 * period)
000077r 2               ;   6            noise period (5 bits)
000077r 2               ;   7            mixer: bits 0-2 tone A-C off, bits 3-5 noise A-C off
000077r 2               ;                (0 = on), bits 6-7 I/O port directions (kept 0)
000077r 2               ;   8 9 10       volume A, B, C (0-15), bit 4 = use the envelope
000077r 2               ;   11/12        envelope period (16 bits): one ramp (16 steps) lasts
000077r 2               ;                256 x period / 2 MHz
000077r 2               ;   13           envelope shape (writing it restarts the envelope)
000077r 2               ; ============================================================================
000077r 2               
000077r 2               AY_ADDR         = $7F22
000077r 2               AY_DATA         = $7F23
000077r 2               
000077r 2               AY_TONE_A       = 0
000077r 2               AY_NOISE        = 6
000077r 2               AY_MIXER        = 7
000077r 2               AY_VOL_A        = 8
000077r 2               AY_ENV_LO       = 11
000077r 2               AY_ENV_HI       = 12
000077r 2               AY_ENV_SHAPE    = 13
000077r 2               
000077r 2               ; envelope shapes (register 13)
000077r 2               ENV_DECAY       = $00           ; \______   fade out once
000077r 2               ENV_ATTACK      = $0D           ; /~~~~~~   fade in once, then stay up
000077r 2               ENV_SAW_DOWN    = $08           ; \\\\\\\   repeat
000077r 2               ENV_SAW_UP      = $0C           ; ///////   repeat
000077r 2               ENV_TRIANGLE    = $0E           ; /\/\/\/   repeat
000077r 2               ENV_TRIANGLE2   = $0A           ; \/\/\/\   repeat
000077r 2               ENV_DECAY_HOLD  = $0B           ; \~~~~~~   fade out, then jump up and stay
000077r 2               ENV_ATTACK_ZERO = $0F           ; /______   fade in, then drop to 0
000077r 2               
000077r 2               ; register X = A.  Keeps A, X and Y.
000077r 2               ay_write:
000077r 2  8E 22 7F             stx     AY_ADDR
00007Ar 2  8D 23 7F             sta     AY_DATA
00007Dr 2  60                   rts
00007Er 2               
00007Er 2               ; everything quiet: tones and noise off, volumes 0, the envelope stopped
00007Er 2               ay_silence:
00007Er 2  48                   pha
00007Fr 2  8A                   txa
000080r 2  48                   pha
000081r 2  A9 3F                lda     #$3F            ; mixer: all off (and the ports inputs)
000083r 2  A2 07                ldx     #AY_MIXER
000085r 2  20 rr rr             jsr     ay_write
000088r 2  A9 00                lda     #0
00008Ar 2  A2 08                ldx     #AY_VOL_A       ; volumes 0
00008Cr 2  20 rr rr             jsr     ay_write
00008Fr 2  E8                   inx
000090r 2  20 rr rr             jsr     ay_write
000093r 2  E8                   inx
000094r 2  20 rr rr             jsr     ay_write
000097r 2  A2 00                ldx     #0              ; tone and noise periods 0
000099r 2  20 rr rr     @p:     jsr     ay_write
00009Cr 2  E8                   inx
00009Dr 2  E0 07                cpx     #AY_MIXER
00009Fr 2  D0 F8                bne     @p
0000A1r 2  A2 0B                ldx     #AY_ENV_LO      ; envelope period 0, shape 0 (fades to 0)
0000A3r 2  20 rr rr             jsr     ay_write
0000A6r 2  E8                   inx
0000A7r 2  20 rr rr             jsr     ay_write
0000AAr 2  E8                   inx
0000ABr 2  20 rr rr             jsr     ay_write
0000AEr 2  68                   pla
0000AFr 2  AA                   tax
0000B0r 2  68                   pla
0000B1r 2  60                   rts
0000B2r 2               
0000B2r 2               ; registers 0-13 from (ay_ptr); register 13 only if it isn't $FF
0000B2r 2               ay_regs:
0000B2r 2  AD rr rr             lda     ay_ptr
0000B5r 2  8D rr rr             sta     @ld+1
0000B8r 2  AD rr rr             lda     ay_ptr+1
0000BBr 2  8D rr rr             sta     @ld+2
0000BEr 2  A2 00                ldx     #0
0000C0r 2               @l:
0000C0r 2  BD FF FF     @ld:    lda     $FFFF,x
0000C3r 2  E0 0D                cpx     #AY_ENV_SHAPE
0000C5r 2  D0 04                bne     @w
0000C7r 2  C9 FF                cmp     #$FF
0000C9r 2  F0 0B                beq     @r
0000CBr 2  8E 22 7F     @w:     stx     AY_ADDR
0000CEr 2  8D 23 7F             sta     AY_DATA
0000D1r 2  E8                   inx
0000D2r 2  E0 0E                cpx     #14
0000D4r 2  D0 EA                bne     @l
0000D6r 2  60           @r:     rts
0000D7r 2               
0000D7r 2               ; channel X (0-2): tone period A (low) / Y (high)
0000D7r 2               ay_tone:
0000D7r 2  48                   pha
0000D8r 2  8A                   txa
0000D9r 2  0A                   asl
0000DAr 2  AA                   tax
0000DBr 2  68                   pla
0000DCr 2  20 rr rr             jsr     ay_write        ; the low byte
0000DFr 2  E8                   inx
0000E0r 2  98                   tya
0000E1r 2  20 rr rr             jsr     ay_write        ; the high 4 bits
0000E4r 2  8A                   txa
0000E5r 2  4A                   lsr
0000E6r 2  AA                   tax
0000E7r 2  60                   rts
0000E8r 2               
0000E8r 2               ; channel X (0-2): note A (0 = C1 .. 95 = B8)
0000E8r 2               ay_note:
0000E8r 2  C9 60                cmp     #AY_NOTES
0000EAr 2  90 02                bcc     @ok
0000ECr 2  A9 5F                lda     #AY_NOTES - 1
0000EEr 2  A8           @ok:    tay
0000EFr 2  B9 rr rr             lda     note_hi,y
0000F2r 2  48                   pha
0000F3r 2  B9 rr rr             lda     note_lo,y
0000F6r 2  A8                   tay
0000F7r 2  68                   pla                     ; (A = high, Y = low: swapped for ay_tone)
0000F8r 2  8D rr rr             sta     ay_tmp
0000FBr 2  98                   tya
0000FCr 2  AC rr rr             ldy     ay_tmp
0000FFr 2  4C rr rr             jmp     ay_tone
000102r 2               
000102r 2               ; channel X (0-2): volume A (0-15, 16 = follow the envelope)
000102r 2               ay_volume:
000102r 2  48                   pha
000103r 2  8A                   txa
000104r 2  18                   clc
000105r 2  69 08                adc     #AY_VOL_A
000107r 2  AA                   tax
000108r 2  68                   pla
000109r 2  20 rr rr             jsr     ay_write
00010Cr 2  48                   pha
00010Dr 2  8A                   txa
00010Er 2  38                   sec
00010Fr 2  E9 08                sbc     #AY_VOL_A
000111r 2  AA                   tax
000112r 2  68                   pla
000113r 2  60                   rts
000114r 2               
000114r 2               ; mixer (register 7) = A: the port direction bits are always kept 0 (inputs)
000114r 2               ay_mixer:
000114r 2  29 3F                and     #$3F
000116r 2  A2 07                ldx     #AY_MIXER
000118r 2  4C rr rr             jmp     ay_write
00011Br 2               
00011Br 2                       .include "ay_notes.inc"
00011Br 3               ; generated by tools/gen_notes.py: tone periods for a 2000000 Hz chip clock
00011Br 3               ; note n = octave * 12 + semitone (C1 = 0 ... B8 = 95); A4 (n = 45) is 440 Hz
00011Br 3               AY_NOTES = 96
00011Br 3               note_lo:
00011Br 3  EE 18 4D 8E          .byte   $EE, $18, $4D, $8E, $DA, $2F, $8F, $F7, $68, $E1, $61, $E9   ; octave 1
00011Fr 3  DA 2F 8F F7  
000123r 3  68 E1 61 E9  
000127r 3  77 0C A7 47          .byte   $77, $0C, $A7, $47, $ED, $98, $47, $FC, $B4, $70, $31, $F4   ; octave 2
00012Br 3  ED 98 47 FC  
00012Fr 3  B4 70 31 F4  
000133r 3  BC 86 53 24          .byte   $BC, $86, $53, $24, $F6, $CC, $A4, $7E, $5A, $38, $18, $FA   ; octave 3
000137r 3  F6 CC A4 7E  
00013Br 3  5A 38 18 FA  
00013Fr 3  DE C3 AA 92          .byte   $DE, $C3, $AA, $92, $7B, $66, $52, $3F, $2D, $1C, $0C, $FD   ; octave 4
000143r 3  7B 66 52 3F  
000147r 3  2D 1C 0C FD  
00014Br 3  EF E1 D5 C9          .byte   $EF, $E1, $D5, $C9, $BE, $B3, $A9, $9F, $96, $8E, $86, $7F   ; octave 5
00014Fr 3  BE B3 A9 9F  
000153r 3  96 8E 86 7F  
000157r 3  77 71 6A 64          .byte   $77, $71, $6A, $64, $5F, $59, $54, $50, $4B, $47, $43, $3F   ; octave 6
00015Br 3  5F 59 54 50  
00015Fr 3  4B 47 43 3F  
000163r 3  3C 38 35 32          .byte   $3C, $38, $35, $32, $2F, $2D, $2A, $28, $26, $24, $22, $20   ; octave 7
000167r 3  2F 2D 2A 28  
00016Br 3  26 24 22 20  
00016Fr 3  1E 1C 1B 19          .byte   $1E, $1C, $1B, $19, $18, $16, $15, $14, $13, $12, $11, $10   ; octave 8
000173r 3  18 16 15 14  
000177r 3  13 12 11 10  
00017Br 3               note_hi:
00017Br 3  0E 0E 0D 0C          .byte   $0E, $0E, $0D, $0C, $0B, $0B, $0A, $09, $09, $08, $08, $07
00017Fr 3  0B 0B 0A 09  
000183r 3  09 08 08 07  
000187r 3  07 07 06 06          .byte   $07, $07, $06, $06, $05, $05, $05, $04, $04, $04, $04, $03
00018Br 3  05 05 05 04  
00018Fr 3  04 04 04 03  
000193r 3  03 03 03 03          .byte   $03, $03, $03, $03, $02, $02, $02, $02, $02, $02, $02, $01
000197r 3  02 02 02 02  
00019Br 3  02 02 02 01  
00019Fr 3  01 01 01 01          .byte   $01, $01, $01, $01, $01, $01, $01, $01, $01, $01, $01, $00
0001A3r 3  01 01 01 01  
0001A7r 3  01 01 01 00  
0001ABr 3  00 00 00 00          .byte   $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00
0001AFr 3  00 00 00 00  
0001B3r 3  00 00 00 00  
0001B7r 3  00 00 00 00          .byte   $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00
0001BBr 3  00 00 00 00  
0001BFr 3  00 00 00 00  
0001C3r 3  00 00 00 00          .byte   $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00
0001C7r 3  00 00 00 00  
0001CBr 3  00 00 00 00  
0001CFr 3  00 00 00 00          .byte   $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00
0001D3r 3  00 00 00 00  
0001D7r 3  00 00 00 00  
0001DBr 3               
0001DBr 2               
0001DBr 2                       .segment "BSS"
000000r 2  xx xx        ay_ptr:     .res 2              ; ay_regs: where the 14 register values are
000002r 2  xx           ay_tmp:     .res 1
000003r 2                       .segment "CODE"
0001DBr 2               
0001DBr 1               
0001DBr 1               ; ---- the menu ----------------------------------------------------------------------
0001DBr 1  D8           start:  cld
0001DCr 1  A2 FF                ldx     #$FF
0001DEr 1  9A                   txs
0001DFr 1  20 rr rr             jsr     ay_silence
0001E2r 1  20 rr rr     menu:   jsr     ay_silence
0001E5r 1  A9 rr A0 rr          PRINT   menu_txt
0001E9r 1  20 rr rr     
0001ECr 1  20 rr rr     @k:     jsr     waitkey
0001EFr 1  C9 51                cmp     #'Q'
0001F1r 1  D0 0D                bne     @n
0001F3r 1  20 rr rr             jsr     ay_silence
0001F6r 1  A9 rr A0 rr          PRINT   bye_txt
0001FAr 1  20 rr rr     
0001FDr 1  4C 06 FE             jmp     SBC_MENU
000200r 1  C9 31        @n:     cmp     #'1'
000202r 1  90 E8                bcc     @k
000204r 1  C9 3A                cmp     #'9' + 1
000206r 1  B0 E4                bcs     @k
000208r 1  38                   sec
000209r 1  E9 31                sbc     #'1'
00020Br 1  C9 08                cmp     #8
00020Dr 1  F0 06                beq     @all
00020Fr 1  20 rr rr             jsr     run_test
000212r 1  4C rr rr             jmp     menu
000215r 1  A9 00        @all:   lda     #0              ; 9: each in turn, until a key
000217r 1  48           @a:     pha
000218r 1  20 rr rr             jsr     run_test
00021Br 1  68                   pla
00021Cr 1  2C rr rr             bit     stopped
00021Fr 1  30 07                bmi     @done
000221r 1  18                   clc
000222r 1  69 01                adc     #1
000224r 1  C9 08                cmp     #8
000226r 1  D0 EF                bne     @a
000228r 1  4C rr rr     @done:  jmp     menu
00022Br 1               
00022Br 1               ; run test A (0-7)
00022Br 1               run_test:
00022Br 1  0A                   asl
00022Cr 1  AA                   tax
00022Dr 1  BD rr rr             lda     tests,x
000230r 1  8D rr rr             sta     @j+1
000233r 1  BD rr rr             lda     tests+1,x
000236r 1  8D rr rr             sta     @j+2
000239r 1  A9 00                lda     #0
00023Br 1  8D rr rr             sta     stopped
00023Er 1  20 rr rr             jsr     crlf
000241r 1  20 rr rr             jsr     ay_silence
000244r 1  20 FF FF     @j:     jsr     $FFFF
000247r 1  20 rr rr             jsr     ay_silence
00024Ar 1  60                   rts
00024Br 1  rr rr rr rr  tests:  .word   t_channels, t_scale, t_chord, t_noise, t_envelope, t_volume, t_effects, t_sweep
00024Fr 1  rr rr rr rr  
000253r 1  rr rr rr rr  
00025Br 1               
00025Br 1               ; wait A x 10 ms; a key stops the test: then the carry is set (and stays set
00025Br 1               ; for the rest of it: stopped has bit 7 set)
00025Br 1  8D rr rr     wait10: sta     wcount
00025Er 1  2C rr rr     @l:     bit     stopped
