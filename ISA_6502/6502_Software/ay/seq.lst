0003F7r 2  88                   dey
0003F8r 2  D0 F7                bne     @sh
0003FAr 2  BD rr rr             lda     per_lo,x
0003FDr 2  18                   clc
0003FEr 2  6D rr rr             adc     s_t1
000401r 2  9D rr rr             sta     per_lo,x
000404r 2  8D rr rr             sta     p_lo
000407r 2  BD rr rr             lda     per_hi,x
00040Ar 2  6D rr rr             adc     s_t2
00040Dr 2  C9 10                cmp     #$10            ; (12 bits at most)
00040Fr 2  90 0A                bcc     @sw
000411r 2  A9 FF                lda     #$FF
000413r 2  9D rr rr             sta     per_lo,x
000416r 2  8D rr rr             sta     p_lo
000419r 2  A9 0F                lda     #$0F
00041Br 2  9D rr rr     @sw:    sta     per_hi,x
00041Er 2  8D rr rr             sta     p_hi
000421r 2  4C rr rr             jmp     @tone
000424r 2  BD rr rr     @pitch: lda     note,x          ; the note, or a note of the chord
000427r 2  AC rr rr             ldy     fl
00042Ar 2  C0 10                cpy     #F_CHORD
00042Cr 2  D0 0D                bne     @n
00042Er 2  AC rr rr             ldy     arp3
000431r 2  18                   clc
000432r 2  79 rr rr             adc     chord,y
000435r 2  C9 60                cmp     #AY_NOTES
000437r 2  90 02                bcc     @n
000439r 2  A9 5F                lda     #AY_NOTES - 1
00043Br 2  A8           @n:     tay
00043Cr 2  B9 rr rr             lda     note_lo,y
00043Fr 2  8D rr rr             sta     p_lo
000442r 2  B9 rr rr             lda     note_hi,y
000445r 2  8D rr rr             sta     p_hi
000448r 2  AD rr rr             lda     fl              ; the octave above, every other frame
00044Br 2  29 08                and     #F_OCT
00044Dr 2  F0 0C                beq     @vib
00044Fr 2  AD rr rr             lda     frame
000452r 2  4A                   lsr
000453r 2  90 06                bcc     @vib
000455r 2  4E rr rr             lsr     p_hi
000458r 2  6E rr rr             ror     p_lo
00045Br 2  AD rr rr     @vib:   lda     fl              ; vibrato: + d, 0, - d, 0 ...
00045Er 2  10 5B                bpl     @tone
000460r 2  A0 07                ldy     #I_VDEL
000462r 2  BD rr rr             lda     age,x
000465r 2  D9 rr rr             cmp     cur_ins,y
000468r 2  90 51                bcc     @tone
00046Ar 2  A0 06                ldy     #I_VIB
00046Cr 2  B9 rr rr             lda     cur_ins,y
00046Fr 2  A8                   tay
000470r 2  AD rr rr             lda     p_lo
000473r 2  8D rr rr             sta     s_t1
000476r 2  AD rr rr             lda     p_hi
000479r 2  8D rr rr             sta     s_t2
00047Cr 2  4E rr rr     @vs:    lsr     s_t2
