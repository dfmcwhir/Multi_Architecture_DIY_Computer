000482r 2  88                   dey
000483r 2  D0 F7                bne     @vs
000485r 2  AD rr rr             lda     frame
000488r 2  29 06                and     #6
00048Ar 2  C9 02                cmp     #2
00048Cr 2  F0 1A                beq     @vup
00048Er 2  C9 06                cmp     #6
000490r 2  D0 29                bne     @tone
000492r 2  AD rr rr             lda     p_lo            ; down: - d
000495r 2  38                   sec
000496r 2  ED rr rr             sbc     s_t1
000499r 2  8D rr rr             sta     p_lo
00049Cr 2  AD rr rr             lda     p_hi
00049Fr 2  ED rr rr             sbc     s_t2
0004A2r 2  8D rr rr             sta     p_hi
0004A5r 2  4C rr rr             jmp     @tone
0004A8r 2  AD rr rr     @vup:   lda     p_lo
0004ABr 2  18                   clc
0004ACr 2  6D rr rr             adc     s_t1
0004AFr 2  8D rr rr             sta     p_lo
0004B2r 2  AD rr rr             lda     p_hi
