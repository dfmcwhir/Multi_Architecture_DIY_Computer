000C75r 1  99 rr rr             sta     bass,y
000C78r 1  60                   rts
000C79r 1  99 rr rr     @l:     sta     lead,y
000C7Cr 1  60                   rts
000C7Dr 1               
000C7Dr 1               ; a note key (offset A from C of the octave): the note in, heard, on a step;
000C7Dr 1               ; on a drum track: the drum on, heard
000C7Dr 1               note_key:
000C7Dr 1  8D rr rr             sta     tmp
000C80r 1  AD rr rr             lda     cur_tr
