00057Br 2  02 00 00 00  
00057Fr 2  00 00 FF 00  
000587r 2  F0 0C 28 00          .byte   240, 12,  40,  0,   3, 0,                  0,  0, 0, 0, $FF, 0,  6, 0,0,0  ; HARP
00058Br 2  03 00 00 00  
00058Fr 2  00 00 FF 00  
000597r 2  3C 00 D0 1E          .byte    60,  0, 208, 30,   8, 0,                  0,  0, 0, 0, $FF, 0, 40, 0,0,0  ; ORGAN
00059Br 2  08 00 00 00  
00059Fr 2  00 00 FF 00  
0005A7r 2  0C 00 C0 28          .byte    12,  0, 192, 40,   4, F_VIB,              7, 15, 0, 0, $FF, 0, 40, 0,0,0  ; STRINGS
0005ABr 2  04 80 07 0F  
0005AFr 2  00 00 FF 00  
0005B7r 2  F0 04 A0 14          .byte   240,  4, 160, 20,   4, F_OCT,              0,  0, 0, 0, $FF, 0,  6, 0,0,0  ; CHIP
0005BBr 2  04 08 00 00  
0005BFr 2  00 00 FF 00  
0005C7r 2  F0 04 A0 14          .byte   240,  4, 160, 20,   4, F_CHORD,            0,  0, 0, 0, $FF, 0,  6, 0,0,0  ; CHORD
0005CBr 2  04 10 00 00  
0005CFr 2  00 00 FF 00  
0005D7r 2  F0 00 F0 19          .byte   240,  0, 240, 25, 240, F_BUZZ|F_NOTONE,    0,  0, 0, 0, $FF, 0, 40, 0,0,0  ; BUZZ
0005DBr 2  F0 06 00 00  
0005DFr 2  00 00 FF 00  
0005E7r 2  F0 28 00 00          .byte   240, 40,   0,  0,   0, F_DRUMS,            0,  0, 0, 0, $FF, 0,  6, 0,0,0  ; DRUMS (the kit:)
0005EBr 2  00 40 00 00  
0005EFr 2  00 00 FF 00  
0005F7r 2  F0 18 00 00          .byte   240, 24,   0,  0,   0, F_SWEEP,            0,  0, 2, 0,  31, 0,  6, 0,0,0  ; kick
0005FBr 2  00 20 00 00  
0005FFr 2  02 00 1F 00  
000607r 2  F0 0E 00 00          .byte   240, 14,   0,  0,   0, F_NOISE|F_SWEEP,    0,  0, 4, 6,  43, 0,  6, 0,0,0  ; snare
00060Br 2  00 21 00 00  
00060Fr 2  04 06 2B 00  
000617r 2  F0 28 00 00          .byte   240, 40,   0,  0,   0, F_NOISE|F_NOTONE,   0,  0, 0, 1, $FF, 0,  6, 0,0,0  ; closed hi-hat
00061Br 2  00 03 00 00  
00061Fr 2  00 01 FF 00  
000627r 2  F0 0A 00 00          .byte   240, 10,   0,  0,   0, F_NOISE|F_NOTONE,   0,  0, 0, 1, $FF, 0,  6, 0,0,0  ; open hi-hat
00062Br 2  00 03 00 00  
00062Fr 2  00 01 FF 00  
000637r 2  F0 0C 00 00          .byte   240, 12,   0,  0,   0, F_SWEEP,            0,  0, 4, 0, $FF, 0,  6, 0,0,0  ; tom
00063Br 2  00 20 00 00  
00063Fr 2  04 00 FF 00  
000647r 2  F0 05 00 00          .byte   240,  5,   0,  0,   0, F_NOISE|F_NOTONE,   0,  0, 0, 3, $FF, 0,  6, 0,0,0  ; crash
00064Br 2  00 03 00 00  
00064Fr 2  00 03 FF 00  
000657r 2               
000657r 2               
000657r 2                       .segment "BSS"
000003r 2  xx           frame:      .res 1
000004r 2  xx           arp3:       .res 1
000005r 2  xx           mixer:      .res 1
000006r 2  xx           cx:         .res 1
000007r 2  xx           fl:         .res 1
000008r 2  xx           p_lo:       .res 1
000009r 2  xx           p_hi:       .res 1
00000Ar 2  xx           k_note:     .res 1
00000Br 2  xx           k_ins:      .res 1
00000Cr 2  xx xx xx xx  cur_ins:    .res 16             ; the sound in use (ins_ptr)
000010r 2  xx xx xx xx  
000014r 2  xx xx xx xx  
00001Cr 2  xx xx xx     st:         .res 3              ; each channel: the stage,
00001Fr 2  xx xx xx     note:       .res 3              ;  the note,
000022r 2  xx xx xx     ins:        .res 3              ;  the sound
000025r 2  xx xx xx     vol:        .res 3              ;  the volume x 16
000028r 2  xx xx xx     t:          .res 3              ;  frames in the sustain
00002Br 2  xx xx xx     age:        .res 3              ;  frames since it started
00002Er 2  xx xx xx     last:       .res 3              ;  frames since its key was last pressed
000031r 2  xx xx xx     hold:       .res 3              ;  frames still held by key repeats
000034r 2  xx xx xx     per_lo:     .res 3              ;  the period (the sweeps)
000037r 2  xx xx xx     per_hi:     .res 3
00003Ar 2  xx           s_t1:       .res 1
00003Br 2  xx           gate_mode:  .res 1
00003Cr 2  xx           s_t2:       .res 1
00003Dr 2                       .segment "CODE"
000657r 2               
000657r 1                       .include "ch376r.s"
000657r 2               ; ============================================================================
000657r 2               ; ch376r.s - reading files from the USB drive through the CH376 (parallel
000657r 2               ; mode, at $7F20 data / $7F21 command and status), for programs loaded from
000657r 2               ; the monitor: start the chip, list a directory, open, read, seek, close.
000657r 2               ; The same protocol as the firmware's driver (ch376_abs.s), cut down to
000657r 2               ; reading.  Every wait has a time-out, so a missing drive can't hang it.
000657r 2               ;
000657r 2               ;   ch_check    is the chip there?  carry set if not
000657r 2               ;   ch_start    check the chip, USB host mode, mount the drive: carry set =
000657r 2               ;               failed (A = what failed: 1 no chip, 2 mode, 3 no drive).  This
000657r 2               ;               starts the drive afresh, in its top folder.
000657r 2               ;   ch_open     open the file whose 0-ended name is at A/Y: "NAME.EXT" in the
000657r 2               ;               current folder, "/NAME.EXT" in the top one: A = the CH376
000657r 2               ;               status ($14 = open, $42 = not found)
000657r 2               ;   ch_read     read ch_len bytes to (ch_ptr): A = $14 when done, ch_got =
000657r 2               ;               bytes read (fewer at the end of the file)
000657r 2               ;   ch_seek     to the 32 bit offset in ch_off
000657r 2               ;   ch_close    close the open file
000657r 2               ; With CH_WRITE defined, also writing:
000657r 2               ;   ch_create   make the file whose 0-ended name is at A/Y (emptied if it is
000657r 2               ;               there), open for writing: A = the status ($14 = made)
000657r 2               ;   ch_write    write ch_len bytes from (ch_ptr): A = $14 when done
000657r 2               ;   ch_close_w  close it, with its length kept
000657r 2               ;   ch_dir      list the files that match the 0-ended name at A/Y ("/*": the
000657r 2               ;               top folder, "*": the current one): calls (ch_entry_fn) for
000657r 2               ;               each, with the 32 byte FAT entry in ch_ent (0-7 name, 8-10
000657r 2               ;               extension, 11 attributes, 28-31 size).  A = $42 when it has
000657r 2               ;               listed them all, or the status that stopped it (no drive ...)
000657r 2               ;   ch_enter    make the folder whose 0-ended path is at A/Y ("" the top,
000657r 2               ;               "/A" or "/A/B") the current one, a level at a time: "/A",
000657r 2               ;               then "B".  A = $41 (ERR_OPEN_DIR) when it is in, else the
000657r 2               ;               status that stopped it ($42: a folder isn't there)
000657r 2               ;
000657r 2               ; The current folder: the CH376 keeps the last folder opened as its current
000657r 2               ; one, and names without a "/" are found there.  It isn't kept for long:
000657r 2               ; opening a file leaves the chip with no current folder that works, so enter
000657r 2               ; the folder again before each relative name (as the monitor does).
000657r 2               ; ============================================================================
000657r 2               
000657r 2               CH_DATA         = $7F20
000657r 2               CH_CMD          = $7F21
000657r 2               
000657r 2               CMD_CHECK_EXIST = $06
000657r 2               CMD_SET_USB_MODE= $15
000657r 2               CMD_GET_STATUS  = $22
000657r 2               CMD_RD_USB_DATA0= $27
000657r 2               CMD_SET_FILE_NAME = $2F
000657r 2               CMD_DISK_CONNECT= $30
000657r 2               CMD_DISK_MOUNT  = $31
000657r 2               CMD_FILE_OPEN   = $32
000657r 2               CMD_FILE_ENUM_GO= $33
000657r 2               CMD_FILE_CLOSE  = $36
000657r 2               CMD_BYTE_LOCATE = $39
000657r 2               CMD_BYTE_READ   = $3A
000657r 2               CMD_BYTE_RD_GO  = $3B
000657r 2               CMD_WR_REQ_DATA = $2D
000657r 2               CMD_FILE_CREATE = $34
000657r 2               CMD_BYTE_WRITE  = $3C
000657r 2               CMD_BYTE_WR_GO  = $3D
000657r 2               USB_INT_DISK_WRITE = $1E
000657r 2               
000657r 2               USB_INT_SUCCESS = $14
000657r 2               USB_INT_DISK_READ = $1D
000657r 2               ERR_OPEN_DIR    = $41
000657r 2               ERR_MISS_FILE   = $42
000657r 2               CMD_RET_SUCCESS = $51
000657r 2               
000657r 2               ; wait while the chip is busy (status bit 4), at most ~100 ms.  Keeps X, Y.
000657r 2               ch_wait_busy:
000657r 2  AD 21 7F             lda     CH_CMD
00065Ar 2  29 10                and     #$10
00065Cr 2  F0 19                beq     @r
00065Er 2  8A                   txa
00065Fr 2  48                   pha
000660r 2  98                   tya
000661r 2  48                   pha
000662r 2  A0 07                ldy     #CH_BUSY_OUTER
000664r 2  A2 00                ldx     #0
000666r 2  AD 21 7F     @l:     lda     CH_CMD
000669r 2  29 10                and     #$10
00066Br 2  F0 06                beq     @ok
00066Dr 2  CA                   dex
00066Er 2  D0 F6                bne     @l
000670r 2  88                   dey
000671r 2  D0 F3                bne     @l
000673r 2  68           @ok:    pla
000674r 2  A8                   tay
000675r 2  68                   pla
000676r 2  AA                   tax
000677r 2  60           @r:     rts
000678r 2               CH_BUSY_OUTER = (CLOCK_MHZ * 100000) / 3333 / 10 + 1     ; 256 x 13 cycles a turn
000678r 2               
000678r 2               ; a command (A).  Keeps X, Y.
000678r 2  48           ch_cmd: pha
000679r 2  20 rr rr             jsr     ch_wait_busy
00067Cr 2  68                   pla
00067Dr 2  8D 21 7F             sta     CH_CMD
000680r 2  EA                   nop                     ; (the chip wants ~1.5 us before the next access)
000681r 2  EA                   nop
000682r 2  EA                   nop
000683r 2  EA                   nop
000684r 2  60                   rts
000685r 2               
000685r 2               ; a data byte (A) to the chip.  Keeps X, Y.
000685r 2  48           ch_wr:  pha
000686r 2  20 rr rr             jsr     ch_wait_busy
000689r 2  68                   pla
00068Ar 2  8D 20 7F             sta     CH_DATA
00068Dr 2  60                   rts
00068Er 2               
00068Er 2               ; a data byte from the chip, in A.  Keeps X, Y.
00068Er 2  20 rr rr     ch_rd:  jsr     ch_wait_busy
000691r 2  AD 20 7F             lda     CH_DATA
000694r 2  60                   rts
000695r 2               
000695r 2               ; wait for the chip's interrupt (status bit 7 low), at most ~3 s: carry set
000695r 2               ; if it never came.  Keeps X, Y.
000695r 2               ch_wait_int:
000695r 2  8A                   txa
000696r 2  48                   pha
000697r 2  98                   tya
000698r 2  48                   pha
000699r 2  A9 08                lda     #CH_INT_OUTER
00069Br 2  8D rr rr             sta     ch_tmo
00069Er 2  A0 00                ldy     #0
0006A0r 2  A2 00                ldx     #0
0006A2r 2  AD 21 7F     @l:     lda     CH_CMD
0006A5r 2  10 11                bpl     @got
0006A7r 2  E8                   inx
0006A8r 2  D0 F8                bne     @l
0006AAr 2  C8                   iny
0006ABr 2  D0 F5                bne     @l
0006ADr 2  CE rr rr             dec     ch_tmo
0006B0r 2  D0 F0                bne     @l
0006B2r 2  68                   pla
0006B3r 2  A8                   tay
0006B4r 2  68                   pla
0006B5r 2  AA                   tax
0006B6r 2  38                   sec
0006B7r 2  60                   rts
0006B8r 2  68           @got:   pla
0006B9r 2  A8                   tay
0006BAr 2  68                   pla
0006BBr 2  AA                   tax
0006BCr 2  18                   clc
0006BDr 2  60                   rts
0006BEr 2               CH_INT_OUTER = (CLOCK_MHZ * 3) * 1000000 / 786000 + 1    ; 65536 x 12 cycles a turn
0006BEr 2               
0006BEr 2               ; the interrupt's status in A (and the interrupt cleared); $FF and carry set
0006BEr 2               ; on a time-out.  Keeps X, Y.
0006BEr 2               ch_status:
0006BEr 2  20 rr rr             jsr     ch_wait_int
0006C1r 2  B0 08                bcs     @t
0006C3r 2  A9 22                lda     #CMD_GET_STATUS
0006C5r 2  20 rr rr             jsr     ch_cmd
0006C8r 2  4C rr rr             jmp     ch_rd
0006CBr 2  A9 FF        @t:     lda     #$FF
0006CDr 2  60                   rts
0006CEr 2               
0006CEr 2               ; ---- is the chip there?  (carry set if not) -------------------------------------------
0006CEr 2               ch_check:
0006CEr 2  A9 06                lda     #CMD_CHECK_EXIST
0006D0r 2  20 rr rr             jsr     ch_cmd
0006D3r 2  A9 55                lda     #$55
0006D5r 2  20 rr rr             jsr     ch_wr
0006D8r 2  20 rr rr             jsr     ch_rd
0006DBr 2  C9 AA                cmp     #$AA
0006DDr 2  F0 02                beq     @ok
0006DFr 2  38                   sec
0006E0r 2  60                   rts
0006E1r 2  18           @ok:    clc
0006E2r 2  60                   rts
0006E3r 2               
0006E3r 2               ; ---- start: check the chip, USB host mode, mount --------------------------------------
0006E3r 2               ch_start:
0006E3r 2  A9 06                lda     #CMD_CHECK_EXIST
0006E5r 2  20 rr rr             jsr     ch_cmd
0006E8r 2  A9 55                lda     #$55
0006EAr 2  20 rr rr             jsr     ch_wr
0006EDr 2  20 rr rr             jsr     ch_rd
0006F0r 2  C9 AA                cmp     #$AA
0006F2r 2  F0 04                beq     @mode
0006F4r 2  A9 01                lda     #1              ; no chip
0006F6r 2  38                   sec
0006F7r 2  60                   rts
0006F8r 2  A9 15        @mode:  lda     #CMD_SET_USB_MODE
0006FAr 2  20 rr rr             jsr     ch_cmd
0006FDr 2  A9 06                lda     #6              ; USB host, generate SOF
0006FFr 2  20 rr rr             jsr     ch_wr
000702r 2  A9 01                lda     #1
000704r 2  20 rr rr             jsr     delay_ms
000707r 2  20 rr rr             jsr     ch_rd
00070Ar 2  C9 51                cmp     #CMD_RET_SUCCESS
00070Cr 2  F0 04                beq     @m0
00070Er 2  A9 02                lda     #2
000710r 2  38                   sec
000711r 2  60                   rts
000712r 2  A9 14        @m0:    lda     #20             ; (a "drive connected" interrupt may come:
000714r 2  20 rr rr             jsr     delay_ms        ;  clear it)
000717r 2  AD 21 7F             lda     CH_CMD
00071Ar 2  30 08                bmi     @mnt
00071Cr 2  A9 22                lda     #CMD_GET_STATUS
00071Er 2  20 rr rr             jsr     ch_cmd
000721r 2  20 rr rr             jsr     ch_rd
000724r 2  A9 05        @mnt:   lda     #5              ; mount: up to 5 tries
000726r 2  8D rr rr             sta     ch_try
000729r 2  A9 30        @m1:    lda     #CMD_DISK_CONNECT
00072Br 2  20 rr rr             jsr     ch_cmd
00072Er 2  20 rr rr             jsr     ch_status
000731r 2  A9 31                lda     #CMD_DISK_MOUNT
000733r 2  20 rr rr             jsr     ch_cmd
000736r 2  20 rr rr             jsr     ch_status
000739r 2  C9 14                cmp     #USB_INT_SUCCESS
00073Br 2  F0 0E                beq     @ok
00073Dr 2  A9 C8                lda     #200
00073Fr 2  20 rr rr             jsr     delay_ms
000742r 2  CE rr rr             dec     ch_try
000745r 2  D0 E2                bne     @m1
000747r 2  A9 03                lda     #3              ; no drive
000749r 2  38                   sec
00074Ar 2  60                   rts
00074Br 2  18           @ok:    clc
00074Cr 2  60                   rts
00074Dr 2               
00074Dr 2               ; the file name: the 0-ended string at A/Y
00074Dr 2               ch_name:
00074Dr 2  8D rr rr             sta     @ld+1
000750r 2  8C rr rr             sty     @ld+2
000753r 2  A9 2F                lda     #CMD_SET_FILE_NAME
000755r 2  20 rr rr             jsr     ch_cmd
000758r 2  A2 00                ldx     #0
00075Ar 2               @l:
00075Ar 2  BD FF FF     @ld:    lda     $FFFF,x
00075Dr 2  20 rr rr             jsr     ch_wr
000760r 2  F0 0A                beq     @r
000762r 2  E8                   inx
000763r 2  E0 0E                cpx     #14
000765r 2  D0 F3                bne     @l
000767r 2  A9 00                lda     #0
000769r 2  20 rr rr             jsr     ch_wr
00076Cr 2  60           @r:     rts
00076Dr 2               
00076Dr 2               ch_open:
00076Dr 2  20 rr rr             jsr     ch_name
000770r 2  A9 32                lda     #CMD_FILE_OPEN
000772r 2  20 rr rr             jsr     ch_cmd
000775r 2  4C rr rr             jmp     ch_status
000778r 2               
000778r 2               ch_close:
000778r 2  A9 36                lda     #CMD_FILE_CLOSE
00077Ar 2  20 rr rr             jsr     ch_cmd
00077Dr 2  A9 00                lda     #0              ; (no length update: read only)
00077Fr 2  20 rr rr             jsr     ch_wr
000782r 2  4C rr rr             jmp     ch_status
000785r 2               
000785r 2               .ifdef CH_WRITE
000785r 2               ch_create:
000785r 2  20 rr rr             jsr     ch_name
000788r 2  A9 34                lda     #CMD_FILE_CREATE
00078Ar 2  20 rr rr             jsr     ch_cmd
00078Dr 2  4C rr rr             jmp     ch_status
000790r 2               
000790r 2               ch_close_w:
000790r 2  A9 36                lda     #CMD_FILE_CLOSE
000792r 2  20 rr rr             jsr     ch_cmd
000795r 2  A9 01                lda     #1              ; (the length kept)
000797r 2  20 rr rr             jsr     ch_wr
00079Ar 2  4C rr rr             jmp     ch_status
00079Dr 2               
00079Dr 2               ; write ch_len bytes from (ch_ptr), in the chunks the chip asks for
00079Dr 2               ch_write:
00079Dr 2  AD rr rr             lda     ch_ptr
0007A0r 2  8D rr rr             sta     @ld+1
0007A3r 2  AD rr rr             lda     ch_ptr+1
0007A6r 2  8D rr rr             sta     @ld+2
0007A9r 2  A9 3C                lda     #CMD_BYTE_WRITE
0007ABr 2  20 rr rr             jsr     ch_cmd
0007AEr 2  AD rr rr             lda     ch_len
0007B1r 2  20 rr rr             jsr     ch_wr
0007B4r 2  AD rr rr             lda     ch_len+1
0007B7r 2  20 rr rr             jsr     ch_wr
0007BAr 2  20 rr rr     @next:  jsr     ch_status
0007BDr 2  C9 1E                cmp     #USB_INT_DISK_WRITE
0007BFr 2  D0 2B                bne     @done           ; $14: all of it
0007C1r 2  A9 2D                lda     #CMD_WR_REQ_DATA
0007C3r 2  20 rr rr             jsr     ch_cmd
0007C6r 2  20 rr rr             jsr     ch_rd           ; how many it takes
0007C9r 2  8D rr rr             sta     ch_cnt
0007CCr 2  F0 16                beq     @go
0007CEr 2  A0 00                ldy     #0
0007D0r 2  AD FF FF     @ld:    lda     $FFFF
0007D3r 2  20 rr rr             jsr     ch_wr
0007D6r 2  EE rr rr             inc     @ld+1
0007D9r 2  D0 03                bne     :+
0007DBr 2  EE rr rr             inc     @ld+2
0007DEr 2  C8           :       iny
0007DFr 2  CC rr rr             cpy     ch_cnt
0007E2r 2  D0 EC                bne     @ld
0007E4r 2  A9 3D        @go:    lda     #CMD_BYTE_WR_GO
0007E6r 2  20 rr rr             jsr     ch_cmd
0007E9r 2  4C rr rr             jmp     @next
0007ECr 2  60           @done:  rts
0007EDr 2               .endif
0007EDr 2               
0007EDr 2               ch_seek:
0007EDr 2  A9 39                lda     #CMD_BYTE_LOCATE
0007EFr 2  20 rr rr             jsr     ch_cmd
0007F2r 2  A2 00                ldx     #0
0007F4r 2  BD rr rr     @l:     lda     ch_off,x
0007F7r 2  20 rr rr             jsr     ch_wr
0007FAr 2  E8                   inx
0007FBr 2  E0 04                cpx     #4
0007FDr 2  D0 F5                bne     @l
0007FFr 2  4C rr rr             jmp     ch_status
000802r 2               
000802r 2               ; read ch_len (up to 65535) bytes to (ch_ptr): in chunks of up to 64 the chip
000802r 2               ; hands over
000802r 2               ch_read:
000802r 2  A9 00                lda     #0
000804r 2  8D rr rr             sta     ch_got
000807r 2  8D rr rr             sta     ch_got+1
00080Ar 2  AD rr rr             lda     ch_ptr
00080Dr 2  8D rr rr             sta     @st+1
000810r 2  AD rr rr             lda     ch_ptr+1
000813r 2  8D rr rr             sta     @st+2
000816r 2  A9 3A                lda     #CMD_BYTE_READ
000818r 2  20 rr rr             jsr     ch_cmd
00081Br 2  AD rr rr             lda     ch_len
00081Er 2  20 rr rr             jsr     ch_wr
000821r 2  AD rr rr             lda     ch_len+1
000824r 2  20 rr rr             jsr     ch_wr
000827r 2  20 rr rr     @next:  jsr     ch_status
00082Ar 2  C9 1D                cmp     #USB_INT_DISK_READ
00082Cr 2  D0 3A                bne     @done           ; $14: all of it (or the end of the file)
00082Er 2  A9 27                lda     #CMD_RD_USB_DATA0
000830r 2  20 rr rr             jsr     ch_cmd
000833r 2  20 rr rr             jsr     ch_rd           ; how many
000836r 2  8D rr rr             sta     ch_cnt
000839r 2  F0 25                beq     @go
00083Br 2  A0 00                ldy     #0
00083Dr 2  20 rr rr     @c:     jsr     ch_rd
000840r 2  8D FF FF     @st:    sta     $FFFF
000843r 2  EE rr rr             inc     @st+1
000846r 2  D0 03                bne     @c1
000848r 2  EE rr rr             inc     @st+2
00084Br 2  C8           @c1:    iny
00084Cr 2  CC rr rr             cpy     ch_cnt
00084Fr 2  D0 EC                bne     @c
000851r 2  AD rr rr             lda     ch_got
000854r 2  18                   clc
000855r 2  6D rr rr             adc     ch_cnt
000858r 2  8D rr rr             sta     ch_got
00085Br 2  90 03                bcc     @go
00085Dr 2  EE rr rr             inc     ch_got+1
000860r 2  A9 3B        @go:    lda     #CMD_BYTE_RD_GO
000862r 2  20 rr rr             jsr     ch_cmd
000865r 2  4C rr rr             jmp     @next
000868r 2  60           @done:  rts
000869r 2               
000869r 2               ; list the files matching the name at A/Y: (ch_entry_fn) for each entry
000869r 2               ; (ch_ent); A = $42 at the end, or an error status
000869r 2  20 rr rr     ch_dir: jsr     ch_name
00086Cr 2  A9 32                lda     #CMD_FILE_OPEN
00086Er 2  20 rr rr             jsr     ch_cmd
000871r 2  20 rr rr     @next:  jsr     ch_status
000874r 2  C9 1D                cmp     #USB_INT_DISK_READ
000876r 2  D0 31                bne     @r
000878r 2  A9 27                lda     #CMD_RD_USB_DATA0
00087Ar 2  20 rr rr             jsr     ch_cmd
00087Dr 2  20 rr rr             jsr     ch_rd
000880r 2  8D rr rr             sta     ch_cnt
000883r 2  A0 00                ldy     #0
000885r 2  CC rr rr     @rd:    cpy     ch_cnt
000888r 2  B0 0D                bcs     @got
00088Ar 2  20 rr rr             jsr     ch_rd
00088Dr 2  C0 20                cpy     #32
00088Fr 2  B0 03                bcs     @sk
000891r 2  99 rr rr             sta     ch_ent,y
000894r 2  C8           @sk:    iny
000895r 2  D0 EE                bne     @rd
000897r 2  AD rr rr     @got:   lda     ch_cnt
00089Ar 2  C9 20                cmp     #32
00089Cr 2  90 03                bcc     @more
00089Er 2  20 rr rr             jsr     @call
0008A1r 2  A9 33        @more:  lda     #CMD_FILE_ENUM_GO
0008A3r 2  20 rr rr             jsr     ch_cmd
0008A6r 2  4C rr rr             jmp     @next
0008A9r 2  60           @r:     rts
0008AAr 2  6C rr rr     @call:  jmp     (ch_entry_fn)
0008ADr 2               
0008ADr 2               ; enter the folder whose path is at A/Y ("" / "/A" / "/A/B"), a level at a
0008ADr 2               ; time; A = $41 when in it
0008ADr 2               ch_enter:
0008ADr 2  8D rr rr             sta     ce_get+1
0008B0r 2  8C rr rr             sty     ce_get+2
0008B3r 2  A0 00                ldy     #0
0008B5r 2  A2 00        @part:  ldx     #0              ; the next part: "/A" the first time, then "B"
0008B7r 2  20 rr rr             jsr     ce_get
0008BAr 2  F0 36                beq     @in             ; (the end of the path)
0008BCr 2  C0 00                cpy     #0
0008BEr 2  D0 04                bne     @skip
0008C0r 2  8D rr rr             sta     ch_part         ; (only the first keeps its "/")
0008C3r 2  E8                   inx
0008C4r 2  C8           @skip:  iny
0008C5r 2  20 rr rr     @cp:    jsr     ce_get
0008C8r 2  F0 0D                beq     @end
0008CAr 2  C9 2F                cmp     #'/'
0008CCr 2  F0 09                beq     @end
0008CEr 2  9D rr rr             sta     ch_part,x
0008D1r 2  E8                   inx
0008D2r 2  C8                   iny
0008D3r 2  E0 0E                cpx     #14
0008D5r 2  90 EE                bcc     @cp
0008D7r 2  A9 00        @end:   lda     #0
0008D9r 2  9D rr rr             sta     ch_part,x
0008DCr 2  8C rr rr             sty     ch_py           ; (where we are in the path)
0008DFr 2  A9 rr                lda     #<ch_part
0008E1r 2  A0 rr                ldy     #>ch_part
0008E3r 2  20 rr rr             jsr     ch_open
0008E6r 2  AC rr rr             ldy     ch_py
0008E9r 2  C9 41                cmp     #ERR_OPEN_DIR
0008EBr 2  D0 07                bne     @r              ; not a folder (or not there)
0008EDr 2  20 rr rr             jsr     ce_get          ; more?
0008F0r 2  D0 C3                bne     @part
0008F2r 2  A9 41        @in:    lda     #ERR_OPEN_DIR
0008F4r 2  60           @r:     rts
0008F5r 2  B9 FF FF     ce_get: lda     $FFFF,y         ; (the path's next character)
0008F8r 2  60                   rts
0008F9r 2               
0008F9r 2                       .segment "BSS"
00003Dr 2  xx xx        ch_ptr:     .res 2
