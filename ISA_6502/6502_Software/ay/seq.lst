000000r 1               ; ============================================================================
000000r 1               ; seq.s - SEQ: a step sequencer for the AY-3-8910 card (a small "Fruity Loops")
000000r 1               ;
000000r 1               ;   build:  make.bat  (or make)        run:  L SEQ 0500   then   R
000000r 1               ;
000000r 1               ; A pattern is 16 steps (16th notes) of 7 tracks: five drums (KICK, SNARE,
000000r 1               ; HI-HAT, OPEN HAT, CRASH) and two note tracks (BASS and LEAD), each with a
000000r 1               ; sound from PIANO's eight.  There are 4 patterns, A-D: playing goes through
000000r 1               ; the ones in use, A to the last that has anything in it, and round again (or
000000r 1               ; ";" keeps it on the pattern on screen).  The sounds are PIANO's (synth.s).
000000r 1               ;
000000r 1               ;   arrows          move (up/down: the track, left/right: the step)
000000r 1               ;   note keys       a note on BASS or LEAD (as in PIANO: Z S X D C V G B H N
000000r 1               ;                   J M , and Q 2 W 3 E R 5 T 6 Y 7 U I 9 O 0 P), heard as it
000000r 1               ;                   goes in, and on to the next step; on a drum: the drum on
000000r 1               ;   space           a drum on/off, a note out
000000r 1               ;   .               a note held on from the step before
000000r 1               ;   Backspace       out, and back a step
000000r 1               ;   Enter           play / stop                ;  all patterns / this one
000000r 1               ;   - =             tempo (40-250)             [ ]  octave of the note keys
000000r 1               ;   K L             the pattern: A B C D       Tab  the sound of BASS/LEAD
000000r 1               ;   F               files: S save, L load (to BEAT1.SEQ ... BEAT9.SEQ in the
000000r 1               ;                   monitor's current folder), N new, C copy the pattern before
000000r 1               ;   Esc             quit (it asks)
000000r 1               ;
000000r 1               ; The three channels: A plays BASS, B plays LEAD, C the drums (one at a time:
000000r 1               ; on a step with more than one, kick, then snare, crash, open hat, hi-hat).
000000r 1               ; A note sounds for its step, longer if the next steps hold it (".").
000000r 1               ;
000000r 1               ; Timing: VIA timer 2, polled, 100 ticks a second; the steps come from the
000000r 1               ; tempo with an exact running count (no drift), the sounds move every other
000000r 1               ; tick.
000000r 1               ; ============================================================================
000000r 1               
000000r 1                       .setcpu "6502"
000000r 1                       .include "sbc_api.inc"
000000r 2               ; sbc_api.inc - fixed ROM entry points of the SBC (see jumptable.s), and the
000000r 2               ; CPU clock.  Use in your own ca65 programs:  .include "sbc_api.inc"
000000r 2               ; (the games find it one folder up: their make.bat passes  -I ..  to ca65)
000000r 2               SBC_CHRIN       = $FE00         ; carry set + A = char, carry clear = none waiting
000000r 2               SBC_CHROUT      = $FE03         ; print A (A, X, Y preserved)
000000r 2               SBC_MENU        = $FE06         ; boot menu
000000r 2               SBC_COLD        = $FE09         ; BASIC cold start
000000r 2               SBC_WARM        = $FE0C         ; BASIC warm start
000000r 2               SBC_MONITOR     = $FE0F         ; monitor prompt (or JMP $FF00)
000000r 2               SBC_PADSTATE    = $FE12         ; A = gamepad buttons held: bit0 A,1 B,2 Select,3 Start,4 Up,5 Down,6 Left,7 Right
000000r 2               SBC_LOAD        = $FE15         ; load a file: A/Y = parameter block (.word addr, .word max, "NAME.EXT",0)
000000r 2                                               ;   carry clear = loaded, X/Y = length; carry set = failed, A = error code
000000r 2               SBC_CWD         = $FE18         ; A/Y = the monitor's current folder: 0-ended, "" (the top) or "/A/B"
000000r 2                                               ;   (newer ROMs: check for a JMP ($4C) at $FE18 first)
000000r 2               
000000r 2               ; The CPU clock in MHz (whole numbers, 1 to 8).  Programs size their delay
000000r 2               ; loops from it, so a millisecond stays a millisecond.  To build for another
000000r 2               ; clock, change it here or give it on the command line:  make.bat 1
000000r 2               .ifndef CLOCK_MHZ
000000r 2               CLOCK_MHZ       = 2
000000r 2               .endif
000000r 2               
000000r 1               CH_WRITE        = 1             ; (ch376r.s: writing too)
000000r 1               
000000r 1               VIA_T2CL        = $7F08
000000r 1               VIA_T2CH        = $7F09
000000r 1               VIA_ACR         = $7F0B
000000r 1               VIA_IFR         = $7F0D
000000r 1               VIA_IER         = $7F0E
000000r 1               TICK            = CLOCK_MHZ * 10000 - 2     ; 1/100 s (the timer runs count + 2)
000000r 1               .assert TICK < 65536, error, "the clock is too fast for a 1/100 s tick"
000000r 1               .ifndef SBC_CWD
000000r 1               SBC_CWD         = $FE18
000000r 1               .endif
000000r 1               CWD_MAX         = 31
000000r 1               
000000r 1               N_TRACKS        = 7
000000r 1               N_DRUMS         = 5
000000r 1               T_BASS          = 5
000000r 1               T_LEAD          = 6
000000r 1               STEPS           = 16
000000r 1               N_PATS          = 4
000000r 1               EMPTY           = $FF           ; a note step: nothing
000000r 1               TIE             = $FE           ;  the note before, held on
000000r 1               
000000r 1               ; the screen
000000r 1               GRID_COL        = 11            ; step s at GRID_COL + 4 s + s / 4
000000r 1               NUM_ROW         = 3
000000r 1               HEAD_ROW        = 4
000000r 1               TRACK_ROW       = 5             ; the tracks: rows 5-11
000000r 1               SND_ROW         = 13
000000r 1               HELP_ROW        = 15
000000r 1               MSG_ROW         = 20
000000r 1               
000000r 1                       .segment "CODE"
000000r 1  4C rr rr             jmp     start
000003r 1               
000003r 1                       .include "common.s"
000003r 2               ; ============================================================================
000003r 2               ; common.s - small helpers shared by AYTEST and YMPLAY: printing, keys, delays
000003r 2               ; ============================================================================
000003r 2               
000003r 2               ; PRINT label: print the 0-ended string at label; keeps X
000003r 2               .macro  PRINT   str
000003r 2                       lda     #<str
000003r 2                       ldy     #>str
000003r 2                       jsr     print
000003r 2               .endmacro
000003r 2               
000003r 2               ; print the 0-ended string at A (low) / Y (high).  Keeps X.
000003r 2  8D rr rr     print:  sta     @ld+1
000006r 2  8C rr rr             sty     @ld+2
000009r 2  AD FF FF     @ld:    lda     $FFFF
00000Cr 2  F0 0D                beq     @r
00000Er 2  20 03 FE             jsr     SBC_CHROUT
000011r 2  EE rr rr             inc     @ld+1
000014r 2  D0 F3                bne     @ld
000016r 2  EE rr rr             inc     @ld+2
000019r 2  D0 EE                bne     @ld
00001Br 2  60           @r:     rts
00001Cr 2               
00001Cr 2  A9 0D        crlf:   lda     #13
00001Er 2  20 03 FE             jsr     SBC_CHROUT
000021r 2  A9 0A                lda     #10
000023r 2  4C 03 FE             jmp     SBC_CHROUT
000026r 2               
000026r 2               ; print A as 2 decimal digits (0-99)
000026r 2  A2 30        prdec2: ldx     #'0'
000028r 2  C9 0A        @t:     cmp     #10
00002Ar 2  90 05                bcc     @u
00002Cr 2  E9 0A                sbc     #10
00002Er 2  E8                   inx
00002Fr 2  D0 F7                bne     @t
000031r 2  48           @u:     pha
000032r 2  8A                   txa
000033r 2  20 03 FE             jsr     SBC_CHROUT
000036r 2  68                   pla
000037r 2  09 30                ora     #'0'
000039r 2  4C 03 FE             jmp     SBC_CHROUT
00003Cr 2               
00003Cr 2               ; print A in hex
00003Cr 2  48           prhex:  pha
00003Dr 2  4A                   lsr
00003Er 2  4A                   lsr
00003Fr 2  4A                   lsr
000040r 2  4A                   lsr
000041r 2  20 rr rr             jsr     @d
000044r 2  68                   pla
000045r 2  29 0F                and     #$0F
000047r 2  C9 0A        @d:     cmp     #10
000049r 2  90 02                bcc     @n
00004Br 2  69 06                adc     #'A' - '0' - 10 - 1
00004Dr 2  69 30        @n:     adc     #'0'
00004Fr 2  4C 03 FE             jmp     SBC_CHROUT
000052r 2               
000052r 2               ; a key: carry set and A = the key (letters in upper case), or carry clear
000052r 2  20 00 FE     getkey: jsr     SBC_CHRIN
000055r 2  90 0B                bcc     @r
000057r 2  C9 61                cmp     #'a'
000059r 2  90 06                bcc     @y
00005Br 2  C9 7B                cmp     #'z' + 1
00005Dr 2  B0 02                bcs     @y
00005Fr 2  29 DF                and     #$DF
000061r 2  38           @y:     sec
000062r 2  60           @r:     rts
000063r 2               
000063r 2               ; wait for a key; A = the key (upper case)
000063r 2  20 rr rr     waitkey:jsr     getkey
000066r 2  90 FB                bcc     waitkey
000068r 2  60                   rts
000069r 2               
000069r 2               ; wait about A ms.  The inner loop is sized for the clock (CLOCK_MHZ in
000069r 2               ; sbc_api.inc): 5 + 4 * (CLOCK_MHZ - 1) cycles a turn, DELAY_N turns a ms.
000069r 2               DELAY_N = (1000 * CLOCK_MHZ - 7) / (5 + 4 * (CLOCK_MHZ - 1))
000069r 2               delay_ms:
000069r 2  AA                   tax
00006Ar 2  F0 0A                beq     @done
00006Cr 2  A0 DD        @o:     ldy     #DELAY_N
00006Er 2               @i:
00006Er 2  EA EA        .repeat CLOCK_MHZ - 1
000070r 2                       nop
000070r 2                       nop
000070r 2               .endrepeat
000070r 2  88                   dey
000071r 2  D0 FB                bne     @i
000073r 2  CA                   dex
000074r 2  D0 F6                bne     @o
000076r 2  60           @done:  rts
000077r 2               
000077r 1                       .include "ay.s"
000077r 2               ; ============================================================================
000077r 2               ; ay.s - AY-3-8910 sound chip driver for the 6502 SBC (ca65)
000077r 2               ;
000077r 2               ; The card (write only):
000077r 2               ;   AY_ADDR  $7F22  write the number of the register to use  (BDIR = BC1 = 1)
000077r 2               ;   AY_DATA  $7F23  write a value to that register           (BDIR = 1, BC1 = 0)
000077r 2               ;   BC2 and A8 tied high, A9 low; chip clock 2 MHz; the three channels mixed
000077r 2               ;   together (mono).  The I/O ports aren't used: register 7 keeps them inputs.
000077r 2               ;
000077r 2               ; Only plain STA abs is used on the card's addresses: an indexed store
000077r 2               ; (STA abs,X) can make an extra read cycle there first, and the card decodes
000077r 2               ; the address without looking at R/W.
000077r 2               ;
000077r 2               ; Routines (A, X, Y may change unless it says):
000077r 2               ;   ay_write    register X = A (A, X, Y kept)
000077r 2               ;   ay_silence  all channels off, volumes 0, envelope stopped
000077r 2               ;   ay_regs     registers 0-13 from the 14 bytes at (ay_ptr); register 13 is
000077r 2               ;               only written when it isn't $FF (writing it restarts the
000077r 2               ;               envelope)
000077r 2               ;   ay_tone     channel X (0-2) to tone period A (low) / Y (high)
000077r 2               ;   ay_note     channel X (0-2) to note A (0 = C1 .. 95 = B8, 45 = A4 440 Hz)
000077r 2               ;   ay_volume   channel X (0-2) to volume A (0-15; 16 = the envelope)
000077r 2               ;   ay_mixer    register 7 = A, the I/O port bits kept as inputs
000077r 2               ;
000077r 2               ; The registers:
000077r 2               ;   0/1 2/3 4/5  tone period of A, B, C (12 bits: low, high 4 bits):
000077r 2               ;                frequency = 2 MHz / (16 * period)
000077r 2               ;   6            noise period (5 bits)
000077r 2               ;   7            mixer: bits 0-2 tone A-C off, bits 3-5 noise A-C off
000077r 2               ;                (0 = on), bits 6-7 I/O port directions (kept 0)
000077r 2               ;   8 9 10       volume A, B, C (0-15), bit 4 = use the envelope
000077r 2               ;   11/12        envelope period (16 bits): one ramp (16 steps) lasts
000077r 2               ;                256 x period / 2 MHz
000077r 2               ;   13           envelope shape (writing it restarts the envelope)
000077r 2               ; ============================================================================
000077r 2               
000077r 2               AY_ADDR         = $7F22
000077r 2               AY_DATA         = $7F23
000077r 2               
000077r 2               AY_TONE_A       = 0
000077r 2               AY_NOISE        = 6
000077r 2               AY_MIXER        = 7
000077r 2               AY_VOL_A        = 8
000077r 2               AY_ENV_LO       = 11
000077r 2               AY_ENV_HI       = 12
000077r 2               AY_ENV_SHAPE    = 13
000077r 2               
000077r 2               ; envelope shapes (register 13)
000077r 2               ENV_DECAY       = $00           ; \______   fade out once
000077r 2               ENV_ATTACK      = $0D           ; /~~~~~~   fade in once, then stay up
000077r 2               ENV_SAW_DOWN    = $08           ; \\\\\\\   repeat
000077r 2               ENV_SAW_UP      = $0C           ; ///////   repeat
000077r 2               ENV_TRIANGLE    = $0E           ; /\/\/\/   repeat
000077r 2               ENV_TRIANGLE2   = $0A           ; \/\/\/\   repeat
000077r 2               ENV_DECAY_HOLD  = $0B           ; \~~~~~~   fade out, then jump up and stay
000077r 2               ENV_ATTACK_ZERO = $0F           ; /______   fade in, then drop to 0
000077r 2               
000077r 2               ; register X = A.  Keeps A, X and Y.
000077r 2               ay_write:
000077r 2  8E 22 7F             stx     AY_ADDR
00007Ar 2  8D 23 7F             sta     AY_DATA
00007Dr 2  60                   rts
00007Er 2               
00007Er 2               ; everything quiet: tones and noise off, volumes 0, the envelope stopped
00007Er 2               ay_silence:
00007Er 2  48                   pha
00007Fr 2  8A                   txa
000080r 2  48                   pha
000081r 2  A9 3F                lda     #$3F            ; mixer: all off (and the ports inputs)
000083r 2  A2 07                ldx     #AY_MIXER
000085r 2  20 rr rr             jsr     ay_write
000088r 2  A9 00                lda     #0
00008Ar 2  A2 08                ldx     #AY_VOL_A       ; volumes 0
00008Cr 2  20 rr rr             jsr     ay_write
00008Fr 2  E8                   inx
000090r 2  20 rr rr             jsr     ay_write
000093r 2  E8                   inx
000094r 2  20 rr rr             jsr     ay_write
000097r 2  A2 00                ldx     #0              ; tone and noise periods 0
000099r 2  20 rr rr     @p:     jsr     ay_write
00009Cr 2  E8                   inx
00009Dr 2  E0 07                cpx     #AY_MIXER
00009Fr 2  D0 F8                bne     @p
0000A1r 2  A2 0B                ldx     #AY_ENV_LO      ; envelope period 0, shape 0 (fades to 0)
0000A3r 2  20 rr rr             jsr     ay_write
0000A6r 2  E8                   inx
0000A7r 2  20 rr rr             jsr     ay_write
0000AAr 2  E8                   inx
0000ABr 2  20 rr rr             jsr     ay_write
0000AEr 2  68                   pla
0000AFr 2  AA                   tax
0000B0r 2  68                   pla
0000B1r 2  60                   rts
0000B2r 2               
0000B2r 2               ; registers 0-13 from (ay_ptr); register 13 only if it isn't $FF
0000B2r 2               ay_regs:
0000B2r 2  AD rr rr             lda     ay_ptr
0000B5r 2  8D rr rr             sta     @ld+1
0000B8r 2  AD rr rr             lda     ay_ptr+1
0000BBr 2  8D rr rr             sta     @ld+2
0000BEr 2  A2 00                ldx     #0
0000C0r 2               @l:
0000C0r 2  BD FF FF     @ld:    lda     $FFFF,x
0000C3r 2  E0 0D                cpx     #AY_ENV_SHAPE
0000C5r 2  D0 04                bne     @w
0000C7r 2  C9 FF                cmp     #$FF
0000C9r 2  F0 0B                beq     @r
0000CBr 2  8E 22 7F     @w:     stx     AY_ADDR
0000CEr 2  8D 23 7F             sta     AY_DATA
0000D1r 2  E8                   inx
0000D2r 2  E0 0E                cpx     #14
0000D4r 2  D0 EA                bne     @l
0000D6r 2  60           @r:     rts
0000D7r 2               
0000D7r 2               ; channel X (0-2): tone period A (low) / Y (high)
0000D7r 2               ay_tone:
0000D7r 2  48                   pha
0000D8r 2  8A                   txa
0000D9r 2  0A                   asl
0000DAr 2  AA                   tax
0000DBr 2  68                   pla
0000DCr 2  20 rr rr             jsr     ay_write        ; the low byte
0000DFr 2  E8                   inx
0000E0r 2  98                   tya
0000E1r 2  20 rr rr             jsr     ay_write        ; the high 4 bits
0000E4r 2  8A                   txa
0000E5r 2  4A                   lsr
0000E6r 2  AA                   tax
0000E7r 2  60                   rts
0000E8r 2               
0000E8r 2               ; channel X (0-2): note A (0 = C1 .. 95 = B8)
0000E8r 2               ay_note:
0000E8r 2  C9 60                cmp     #AY_NOTES
0000EAr 2  90 02                bcc     @ok
0000ECr 2  A9 5F                lda     #AY_NOTES - 1
0000EEr 2  A8           @ok:    tay
0000EFr 2  B9 rr rr             lda     note_hi,y
0000F2r 2  48                   pha
0000F3r 2  B9 rr rr             lda     note_lo,y
0000F6r 2  A8                   tay
0000F7r 2  68                   pla                     ; (A = high, Y = low: swapped for ay_tone)
0000F8r 2  8D rr rr             sta     ay_tmp
0000FBr 2  98                   tya
0000FCr 2  AC rr rr             ldy     ay_tmp
0000FFr 2  4C rr rr             jmp     ay_tone
000102r 2               
000102r 2               ; channel X (0-2): volume A (0-15, 16 = follow the envelope)
000102r 2               ay_volume:
000102r 2  48                   pha
000103r 2  8A                   txa
000104r 2  18                   clc
000105r 2  69 08                adc     #AY_VOL_A
000107r 2  AA                   tax
000108r 2  68                   pla
000109r 2  20 rr rr             jsr     ay_write
00010Cr 2  48                   pha
00010Dr 2  8A                   txa
00010Er 2  38                   sec
00010Fr 2  E9 08                sbc     #AY_VOL_A
000111r 2  AA                   tax
000112r 2  68                   pla
000113r 2  60                   rts
000114r 2               
000114r 2               ; mixer (register 7) = A: the port direction bits are always kept 0 (inputs)
000114r 2               ay_mixer:
000114r 2  29 3F                and     #$3F
000116r 2  A2 07                ldx     #AY_MIXER
000118r 2  4C rr rr             jmp     ay_write
00011Br 2               
00011Br 2                       .include "ay_notes.inc"
00011Br 3               ; generated by tools/gen_notes.py: tone periods for a 2000000 Hz chip clock
00011Br 3               ; note n = octave * 12 + semitone (C1 = 0 ... B8 = 95); A4 (n = 45) is 440 Hz
00011Br 3               AY_NOTES = 96
00011Br 3               note_lo:
00011Br 3  EE 18 4D 8E          .byte   $EE, $18, $4D, $8E, $DA, $2F, $8F, $F7, $68, $E1, $61, $E9   ; octave 1
00011Fr 3  DA 2F 8F F7  
000123r 3  68 E1 61 E9  
000127r 3  77 0C A7 47          .byte   $77, $0C, $A7, $47, $ED, $98, $47, $FC, $B4, $70, $31, $F4   ; octave 2
00012Br 3  ED 98 47 FC  
00012Fr 3  B4 70 31 F4  
000133r 3  BC 86 53 24          .byte   $BC, $86, $53, $24, $F6, $CC, $A4, $7E, $5A, $38, $18, $FA   ; octave 3
000137r 3  F6 CC A4 7E  
00013Br 3  5A 38 18 FA  
00013Fr 3  DE C3 AA 92          .byte   $DE, $C3, $AA, $92, $7B, $66, $52, $3F, $2D, $1C, $0C, $FD   ; octave 4
000143r 3  7B 66 52 3F  
000147r 3  2D 1C 0C FD  
00014Br 3  EF E1 D5 C9          .byte   $EF, $E1, $D5, $C9, $BE, $B3, $A9, $9F, $96, $8E, $86, $7F   ; octave 5
00014Fr 3  BE B3 A9 9F  
000153r 3  96 8E 86 7F  
000157r 3  77 71 6A 64          .byte   $77, $71, $6A, $64, $5F, $59, $54, $50, $4B, $47, $43, $3F   ; octave 6
00015Br 3  5F 59 54 50  
00015Fr 3  4B 47 43 3F  
000163r 3  3C 38 35 32          .byte   $3C, $38, $35, $32, $2F, $2D, $2A, $28, $26, $24, $22, $20   ; octave 7
000167r 3  2F 2D 2A 28  
00016Br 3  26 24 22 20  
00016Fr 3  1E 1C 1B 19          .byte   $1E, $1C, $1B, $19, $18, $16, $15, $14, $13, $12, $11, $10   ; octave 8
000173r 3  18 16 15 14  
000177r 3  13 12 11 10  
00017Br 3               note_hi:
00017Br 3  0E 0E 0D 0C          .byte   $0E, $0E, $0D, $0C, $0B, $0B, $0A, $09, $09, $08, $08, $07
00017Fr 3  0B 0B 0A 09  
000183r 3  09 08 08 07  
000187r 3  07 07 06 06          .byte   $07, $07, $06, $06, $05, $05, $05, $04, $04, $04, $04, $03
00018Br 3  05 05 05 04  
00018Fr 3  04 04 04 03  
000193r 3  03 03 03 03          .byte   $03, $03, $03, $03, $02, $02, $02, $02, $02, $02, $02, $01
000197r 3  02 02 02 02  
00019Br 3  02 02 02 01  
00019Fr 3  01 01 01 01          .byte   $01, $01, $01, $01, $01, $01, $01, $01, $01, $01, $01, $00
0001A3r 3  01 01 01 01  
0001A7r 3  01 01 01 00  
0001ABr 3  00 00 00 00          .byte   $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00
0001AFr 3  00 00 00 00  
0001B3r 3  00 00 00 00  
0001B7r 3  00 00 00 00          .byte   $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00
0001BBr 3  00 00 00 00  
0001BFr 3  00 00 00 00  
0001C3r 3  00 00 00 00          .byte   $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00
0001C7r 3  00 00 00 00  
0001CBr 3  00 00 00 00  
0001CFr 3  00 00 00 00          .byte   $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00
0001D3r 3  00 00 00 00  
0001D7r 3  00 00 00 00  
0001DBr 3               
0001DBr 2               
0001DBr 2                       .segment "BSS"
000000r 2  xx xx        ay_ptr:     .res 2              ; ay_regs: where the 14 register values are
000002r 2  xx           ay_tmp:     .res 1
000003r 2                       .segment "CODE"
0001DBr 2               
0001DBr 1                       .include "synth.s"
0001DBr 2               ; ============================================================================
0001DBr 2               ; synth.s - the sounds of PIANO and SEQ: 8 sounds and a drum kit on the three
0001DBr 2               ; channels, each note with its own shape (attack, decay to a sustain level, a
0001DBr 2               ; time held, release), vibrato, octave and chord arpeggios, falling pitch,
0001DBr 2               ; noise, and the envelope as a saw wave (BUZZ).
0001DBr 2               ;
0001DBr 2               ;   syn_init    all off
0001DBr 2               ;   syn_start   start a note: sound k_ins, note k_note, on channel X
0001DBr 2               ;   step_all    every 1/50 s: every channel a frame on, the registers written
0001DBr 2               ;   all_off     all the notes off now
0001DBr 2               ;   chan_out    channel X's registers from its state
0001DBr 2               ;   hold,x      frames a note stays in its sustain (beyond its own time)
0001DBr 2               ;   gate_mode   1: a note sustains only while hold,x lasts (SEQ's steps)
0001DBr 2               ;
0001DBr 2               ; Needs ay.s (ay_write, ay_tone, ay_volume, ay_mixer, the note table).
0001DBr 2               ; ============================================================================
0001DBr 2               
0001DBr 2               ; the sounds: 16 bytes each
0001DBr 2               I_ATK           = 0             ; attack: added to the volume a frame (240 = at once)
0001DBr 2               I_DEC           = 1             ; decay: taken off a frame, down to
0001DBr 2               I_SUS           = 2             ;  the sustain level (volume x 16, 0-240)
0001DBr 2               I_SUST          = 3             ; frames it sustains at least (more while held)
0001DBr 2               I_REL           = 4             ; release: taken off a frame
0001DBr 2               I_FLAGS         = 5
0001DBr 2               I_VIB           = 6             ; vibrato: the period / 2^n either way
0001DBr 2               I_VDEL          = 7             ;  after this many frames
0001DBr 2               I_SWEEP         = 8             ; the pitch falls: period += period / 2^n a frame
0001DBr 2               I_NOISE         = 9             ; the noise period to set (0: not)
0001DBr 2               I_NOTE          = 10            ; a fixed note ($FF: the key's)
0001DBr 2               I_NFR           = 11            ; noise only for this many frames (0: all along)
0001DBr 2               I_REP           = 12            ; a key again within this many frames: a repeat
0001DBr 2               
0001DBr 2               F_NOISE         = 1
0001DBr 2               F_NOTONE        = 2
0001DBr 2               F_BUZZ          = 4             ; the envelope as a saw wave at the note
0001DBr 2               F_OCT           = 8             ; the octave above every other frame
0001DBr 2               F_CHORD         = 16            ; a major chord, a note a frame
0001DBr 2               F_SWEEP         = 32
0001DBr 2               F_DRUMS         = 64            ; the key picks a drum
0001DBr 2               F_VIB           = 128
0001DBr 2               
0001DBr 2               N_SOUNDS        = 8             ; the ones to choose from
0001DBr 2               DRUM_KIT        = 8             ; the drums after them
0001DBr 2               HOLD            = 8             ; frames a key repeat holds a note for
0001DBr 2               
0001DBr 2               ST_OFF          = 0
0001DBr 2               ST_ATK          = 1
0001DBr 2               ST_DEC          = 2
0001DBr 2               ST_SUS          = 3
0001DBr 2               ST_REL          = 4
0001DBr 2               
0001DBr 2               ; all off: the channels silent, tones on, noise off
0001DBr 2               syn_init:
0001DBr 2  A9 38                lda     #$38
0001DDr 2  8D rr rr             sta     mixer
0001E0r 2  20 rr rr             jsr     ay_mixer
0001E3r 2  A2 02                ldx     #2
0001E5r 2  A9 00        @c:     lda     #ST_OFF
0001E7r 2  9D rr rr             sta     st,x
0001EAr 2  9D rr rr             sta     vol,x
0001EDr 2  9D rr rr             sta     hold,x
0001F0r 2  CA                   dex
0001F1r 2  10 F2                bpl     @c
0001F3r 2  A9 00                lda     #0
0001F5r 2  8D rr rr             sta     frame
0001F8r 2  8D rr rr             sta     arp3
0001FBr 2  8D rr rr             sta     gate_mode
0001FEr 2  60                   rts
0001FFr 2               
0001FFr 2               ; start a note: sound k_ins, note k_note (or the sound's own) on channel X;
0001FFr 2               ; its registers are written at once
0001FFr 2               syn_start:
0001FFr 2  AD rr rr             lda     k_ins
000202r 2  9D rr rr             sta     ins,x
000205r 2  20 rr rr             jsr     ins_ptr
000208r 2  A0 0A                ldy     #I_NOTE
00020Ar 2  B9 rr rr             lda     cur_ins,y
00020Dr 2  C9 FF                cmp     #$FF
00020Fr 2  D0 03                bne     @fix
000211r 2  AD rr rr             lda     k_note
000214r 2  9D rr rr     @fix:   sta     note,x
000217r 2  A8                   tay
000218r 2  B9 rr rr             lda     note_lo,y       ; the period, for the sweeps
00021Br 2  9D rr rr             sta     per_lo,x
00021Er 2  B9 rr rr             lda     note_hi,y
000221r 2  9D rr rr             sta     per_hi,x
000224r 2  A9 00                lda     #0
000226r 2  9D rr rr             sta     t,x
000229r 2  9D rr rr             sta     age,x
00022Cr 2  9D rr rr             sta     last,x
00022Fr 2  9D rr rr             sta     hold,x
000232r 2  A9 01                lda     #ST_ATK
000234r 2  9D rr rr             sta     st,x
000237r 2  A0 00                ldy     #I_ATK          ; at once: straight to the decay
000239r 2  B9 rr rr             lda     cur_ins,y
00023Cr 2  C9 F0                cmp     #240
00023Er 2  90 0A                bcc     @noise
000240r 2  A9 F0                lda     #240
000242r 2  9D rr rr             sta     vol,x
000245r 2  A9 02                lda     #ST_DEC
000247r 2  9D rr rr             sta     st,x
00024Ar 2  A0 09        @noise: ldy     #I_NOISE
00024Cr 2  B9 rr rr             lda     cur_ins,y
00024Fr 2  F0 0B                beq     @buzz
000251r 2  8E rr rr             stx     s_t1
000254r 2  A2 06                ldx     #AY_NOISE
000256r 2  20 rr rr             jsr     ay_write
000259r 2  AE rr rr             ldx     s_t1
00025Cr 2  A0 05        @buzz:  ldy     #I_FLAGS
00025Er 2  B9 rr rr             lda     cur_ins,y
000261r 2  29 04                and     #F_BUZZ
000263r 2  F0 38                beq     @out
000265r 2  8E rr rr             stx     s_t1             ; the envelope period: the tone period / 16
000268r 2  BD rr rr             lda     per_lo,x
00026Br 2  18                   clc
00026Cr 2  69 08                adc     #8
00026Er 2  8D rr rr             sta     s_t2
000271r 2  BD rr rr             lda     per_hi,x
000274r 2  69 00                adc     #0
000276r 2  4A                   lsr
000277r 2  6E rr rr             ror     s_t2
00027Ar 2  4A                   lsr
00027Br 2  6E rr rr             ror     s_t2
00027Er 2  4A                   lsr
00027Fr 2  6E rr rr             ror     s_t2
000282r 2  4A                   lsr
000283r 2  6E rr rr             ror     s_t2
000286r 2  A2 0C                ldx     #AY_ENV_HI
000288r 2  20 rr rr             jsr     ay_write
00028Br 2  AD rr rr             lda     s_t2
00028Er 2  A2 0B                ldx     #AY_ENV_LO
000290r 2  20 rr rr             jsr     ay_write
000293r 2  A9 08                lda     #ENV_SAW_DOWN   ; (starts it)
000295r 2  A2 0D                ldx     #AY_ENV_SHAPE
000297r 2  20 rr rr             jsr     ay_write
00029Ar 2  AE rr rr             ldx     s_t1
00029Dr 2  4C rr rr     @out:   jmp     chan_out        ; on the chip now
0002A0r 2               
0002A0r 2               ; cur_ins = the sound A's 16 bytes (keeps X)
0002A0r 2               ins_ptr:
0002A0r 2  0A                   asl
0002A1r 2  0A                   asl
0002A2r 2  0A                   asl
0002A3r 2  0A                   asl
0002A4r 2  A8                   tay
0002A5r 2  8E rr rr             stx     @x
0002A8r 2  A2 00                ldx     #0
0002AAr 2  B9 rr rr     @c:     lda     ins_tab,y
0002ADr 2  9D rr rr             sta     cur_ins,x
0002B0r 2  C8                   iny
0002B1r 2  E8                   inx
0002B2r 2  E0 10                cpx     #16
0002B4r 2  D0 F4                bne     @c
0002B6r 2  AE rr rr             ldx     @x
0002B9r 2  60                   rts
0002BAr 2  00           @x:     .byte   0
0002BBr 2               
0002BBr 2               ; A = A mod 12
0002BBr 2  C9 0C        mod12:  cmp     #12
0002BDr 2  90 04                bcc     @r
0002BFr 2  E9 0C                sbc     #12
0002C1r 2  B0 F8                bcs     mod12
0002C3r 2  60           @r:     rts
0002C4r 2               
0002C4r 2               ; all the notes off at once
0002C4r 2               all_off:
0002C4r 2  A2 02                ldx     #2
0002C6r 2  A9 00        @c:     lda     #ST_OFF
0002C8r 2  9D rr rr             sta     st,x
0002CBr 2  9D rr rr             sta     vol,x
0002CEr 2  20 rr rr             jsr     chan_out
0002D1r 2  CA                   dex
0002D2r 2  10 F2                bpl     @c
0002D4r 2  60                   rts
0002D5r 2               
0002D5r 2               
0002D5r 2               ; ---- the sounds, a frame on ------------------------------------------------------------
0002D5r 2               step_all:
0002D5r 2  EE rr rr             inc     frame
0002D8r 2  EE rr rr             inc     arp3            ; (0 1 2: the chord's notes)
0002DBr 2  AD rr rr             lda     arp3
0002DEr 2  C9 03                cmp     #3
0002E0r 2  90 05                bcc     @a
0002E2r 2  A9 00                lda     #0
0002E4r 2  8D rr rr             sta     arp3
0002E7r 2  A2 02        @a:     ldx     #2
0002E9r 2  20 rr rr     @c:     jsr     chan_step
0002ECr 2  20 rr rr             jsr     chan_out
0002EFr 2  CA                   dex
0002F0r 2  10 F7                bpl     @c
0002F2r 2  60                   rts
0002F3r 2               
0002F3r 2               ; channel X: its volume a frame on (attack, decay, sustain, release)
0002F3r 2               chan_step:
0002F3r 2  BD rr rr             lda     age,x           ; (the counts, kept at 255)
0002F6r 2  C9 FF                cmp     #255
0002F8r 2  F0 03                beq     :+
0002FAr 2  FE rr rr             inc     age,x
0002FDr 2  BD rr rr     :       lda     last,x
000300r 2  C9 FF                cmp     #255
000302r 2  F0 03                beq     :+
000304r 2  FE rr rr             inc     last,x
000307r 2  BD rr rr     :       lda     hold,x
00030Ar 2  F0 03                beq     :+
00030Cr 2  DE rr rr             dec     hold,x
00030Fr 2  BD rr rr     :       lda     st,x
000312r 2  D0 01                bne     :+
000314r 2  60                   rts
000315r 2  BD rr rr     :       lda     ins,x
000318r 2  20 rr rr             jsr     ins_ptr
00031Br 2  BD rr rr             lda     st,x
00031Er 2  C9 01                cmp     #ST_ATK
000320r 2  D0 1E                bne     @dec
000322r 2  A0 00                ldy     #I_ATK
000324r 2  BD rr rr             lda     vol,x
000327r 2  18                   clc
000328r 2  79 rr rr             adc     cur_ins,y
00032Br 2  B0 04                bcs     @top
00032Dr 2  C9 F0                cmp     #240
00032Fr 2  90 0B                bcc     @sv
000331r 2  A9 F0        @top:   lda     #240
000333r 2  9D rr rr             sta     vol,x
000336r 2  A9 02                lda     #ST_DEC
000338r 2  9D rr rr             sta     st,x
00033Br 2  60                   rts
00033Cr 2  9D rr rr     @sv:    sta     vol,x
00033Fr 2  60                   rts
000340r 2  C9 02        @dec:   cmp     #ST_DEC
000342r 2  D0 35                bne     @sus
000344r 2  A0 01                ldy     #I_DEC
000346r 2  B9 rr rr             lda     cur_ins,y
000349r 2  F0 19                beq     @tosus          ; (no decay: straight to the sustain level)
00034Br 2  8D rr rr             sta     s_t1
00034Er 2  BD rr rr             lda     vol,x
000351r 2  38                   sec
000352r 2  ED rr rr             sbc     s_t1
000355r 2  90 0D                bcc     @tosus
000357r 2  A0 02                ldy     #I_SUS
000359r 2  D9 rr rr             cmp     cur_ins,y
00035Cr 2  90 06                bcc     @tosus
00035Er 2  F0 04                beq     @tosus
000360r 2  9D rr rr             sta     vol,x
000363r 2  60                   rts
000364r 2  A0 02        @tosus: ldy     #I_SUS
000366r 2  B9 rr rr             lda     cur_ins,y
000369r 2  9D rr rr             sta     vol,x
00036Cr 2  F0 44                beq     @off            ; (sustain 0: the note is over)
00036Er 2  A9 03                lda     #ST_SUS
000370r 2  9D rr rr             sta     st,x
000373r 2  A9 00                lda     #0
000375r 2  9D rr rr             sta     t,x
000378r 2  60                   rts
000379r 2  C9 03        @sus:   cmp     #ST_SUS
00037Br 2  D0 24                bne     @rel
00037Dr 2  BD rr rr             lda     t,x
000380r 2  C9 FF                cmp     #255
000382r 2  F0 03                beq     :+
000384r 2  FE rr rr             inc     t,x
000387r 2  BD rr rr     :       lda     hold,x          ; held: stay
00038Ar 2  D0 14                bne     @r
00038Cr 2  AD rr rr             lda     gate_mode       ; (SEQ: only as long as held)
00038Fr 2  D0 0A                bne     @torel
000391r 2  A0 03                ldy     #I_SUST
000393r 2  BD rr rr             lda     t,x
000396r 2  D9 rr rr             cmp     cur_ins,y
000399r 2  90 05                bcc     @r
00039Br 2  A9 04        @torel: lda     #ST_REL
00039Dr 2  9D rr rr             sta     st,x
0003A0r 2  60           @r:     rts
0003A1r 2  A0 04        @rel:   ldy     #I_REL
0003A3r 2  BD rr rr             lda     vol,x
0003A6r 2  38                   sec
0003A7r 2  F9 rr rr             sbc     cur_ins,y
0003AAr 2  90 06                bcc     @off
0003ACr 2  F0 04                beq     @off
0003AEr 2  9D rr rr             sta     vol,x
0003B1r 2  60                   rts
0003B2r 2  A9 00        @off:   lda     #ST_OFF
0003B4r 2  9D rr rr             sta     st,x
0003B7r 2  A9 00                lda     #0
0003B9r 2  9D rr rr             sta     vol,x
0003BCr 2  60                   rts
0003BDr 2               
0003BDr 2               ; channel X's registers from how it is now: tone period, volume, the mixer
0003BDr 2               chan_out:
0003BDr 2  8E rr rr             stx     cx
0003C0r 2  BD rr rr             lda     st,x
0003C3r 2  D0 08                bne     @on
0003C5r 2  A9 00                lda     #0              ; off: volume 0
0003C7r 2  20 rr rr             jsr     ay_volume
0003CAr 2  4C rr rr             jmp     @mix
0003CDr 2  BD rr rr     @on:    lda     ins,x
0003D0r 2  20 rr rr             jsr     ins_ptr
0003D3r 2  A0 05                ldy     #I_FLAGS
0003D5r 2  B9 rr rr             lda     cur_ins,y
0003D8r 2  8D rr rr             sta     fl
0003DBr 2  29 20                and     #F_SWEEP        ; the pitch falling: per += per >> n
0003DDr 2  F0 45                beq     @pitch
0003DFr 2  A0 08                ldy     #I_SWEEP
0003E1r 2  B9 rr rr             lda     cur_ins,y
0003E4r 2  A8                   tay
0003E5r 2  BD rr rr             lda     per_lo,x
0003E8r 2  8D rr rr             sta     s_t1
0003EBr 2  BD rr rr             lda     per_hi,x
0003EEr 2  8D rr rr             sta     s_t2
0003F1r 2  4E rr rr     @sh:    lsr     s_t2
