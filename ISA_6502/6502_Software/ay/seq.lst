00095Ar 1  20 rr rr             jsr     draw_screen
00095Dr 1  20 rr rr             jsr     t_start
000960r 1               
000960r 1               ; ---- the main loop: keys all the time; steps from the tempo; sounds every other tick ----
000960r 1  20 rr rr     main:   jsr     getkey
000963r 1  90 03                bcc     @t
000965r 1  20 rr rr             jsr     do_key
000968r 1  AD 0D 7F     @t:     lda     VIA_IFR
00096Br 1  29 20                and     #$20
00096Dr 1  F0 F1                beq     main
00096Fr 1  20 rr rr             jsr     t_start
000972r 1  AD rr rr             lda     playing         ; the steps: acc += tempo a tick, a step at 1500
000975r 1  F0 33                beq     @snd            ;  (1500 / tempo ticks = a 16th note)
000977r 1  AD rr rr             lda     acc
00097Ar 1  18                   clc
00097Br 1  6D rr rr             adc     song_tempo
00097Er 1  8D rr rr             sta     acc
000981r 1  90 03                bcc     :+
000983r 1  EE rr rr             inc     acc+1
000986r 1  AD rr rr     :       lda     acc+1
000989r 1  C9 05                cmp     #>1500
00098Br 1  90 1D                bcc     @snd
00098Dr 1  D0 07                bne     @st
00098Fr 1  AD rr rr             lda     acc
000992r 1  C9 DC                cmp     #<1500
000994r 1  90 14                bcc     @snd
000996r 1  AD rr rr     @st:    lda     acc
000999r 1  38                   sec
00099Ar 1  E9 DC                sbc     #<1500
00099Cr 1  8D rr rr             sta     acc
00099Fr 1  AD rr rr             lda     acc+1
0009A2r 1  E9 05                sbc     #>1500
0009A4r 1  8D rr rr             sta     acc+1
0009A7r 1  20 rr rr             jsr     play_step
0009AAr 1  AD rr rr     @snd:   lda     tick
0009ADr 1  49 01                eor     #1
0009AFr 1  8D rr rr             sta     tick
0009B2r 1  F0 AC                beq     main
0009B4r 1  20 rr rr             jsr     step_all
0009B7r 1  4C rr rr             jmp     main
0009BAr 1               
0009BAr 1  A9 1E        t_start:lda     #<TICK
0009BCr 1  8D 08 7F             sta     VIA_T2CL
0009BFr 1  A9 4E                lda     #>TICK
0009C1r 1  8D 09 7F             sta     VIA_T2CH
0009C4r 1  60                   rts
0009C5r 1               
0009C5r 1               ; ---- playing ---------------------------------------------------------------------------
0009C5r 1               ; Enter: play from the start of the pattern on screen / stop
0009C5r 1               play_stop:
0009C5r 1  AD rr rr             lda     playing
0009C8r 1  F0 0E                beq     @go
0009CAr 1  A9 00                lda     #0
0009CCr 1  8D rr rr             sta     playing
0009CFr 1  20 rr rr             jsr     all_off
0009D2r 1  20 rr rr             jsr     head_off
0009D5r 1  4C rr rr             jmp     show_play
0009D8r 1  AD rr rr     @go:    lda     pat
0009DBr 1  8D rr rr             sta     play_pat
0009DEr 1  A9 FF                lda     #$FF            ; (the first step comes at once)
0009E0r 1  8D rr rr             sta     play_pos
0009E3r 1  A9 DC                lda     #<1500
0009E5r 1  8D rr rr             sta     acc
0009E8r 1  A9 05                lda     #>1500
0009EAr 1  8D rr rr             sta     acc+1
0009EDr 1  A9 01                lda     #1
0009EFr 1  8D rr rr             sta     playing
0009F2r 1  4C rr rr             jmp     show_play
0009F5r 1               
0009F5r 1               ; the next step: its drum and notes
0009F5r 1               play_step:
0009F5r 1  EE rr rr             inc     play_pos
0009F8r 1  AD rr rr             lda     play_pos
0009FBr 1  C9 10                cmp     #STEPS
0009FDr 1  90 31                bcc     @in
0009FFr 1  A9 00                lda     #0              ; the end of the pattern: the next one (or
000A01r 1  8D rr rr             sta     play_pos        ;  this one again)
000A04r 1  AD rr rr             lda     loop_one
000A07r 1  D0 1E                bne     @one
000A09r 1  EE rr rr             inc     play_pat
000A0Cr 1  AD rr rr             lda     play_pat
000A0Fr 1  C9 04                cmp     #N_PATS
000A11r 1  B0 0D                bcs     @first
000A13r 1  20 rr rr             jsr     pat_used        ; (patterns after the last in use: back to A)
000A16r 1  D0 15                bne     @shown
000A18r 1  AD rr rr             lda     play_pat
000A1Br 1  20 rr rr             jsr     later_used
000A1Er 1  D0 0D                bne     @shown
000A20r 1  A9 00        @first: lda     #0
000A22r 1  8D rr rr             sta     play_pat
000A25r 1  F0 06                beq     @shown
000A27r 1  AD rr rr     @one:   lda     pat
000A2Ar 1  8D rr rr             sta     play_pat
000A2Dr 1  20 rr rr     @shown: jsr     show_play
000A30r 1  20 rr rr     @in:    jsr     head_show
000A33r 1  AD rr rr             lda     play_pat        ; Y = the step's index: pattern x 16 + step
000A36r 1  0A                   asl
000A37r 1  0A                   asl
000A38r 1  0A                   asl
000A39r 1  0A                   asl
000A3Ar 1  0D rr rr             ora     play_pos
000A3Dr 1  8D rr rr             sta     sx
