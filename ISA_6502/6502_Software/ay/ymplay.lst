00096Cr 1               
00096Cr 1               ; ---- the reader: a step at a time, never waiting for the drive ------------------------
00096Cr 1               RS_IDLE = 0                     ; no read going: start one (or seek back, or stop)
00096Cr 1               RS_READ = 1                     ; a BYTE_READ going: take its blocks as they come
00096Cr 1               RS_STOP = 2                     ; all read (or an error)
00096Cr 1               
00096Cr 1  AD rr rr     reader: lda     rd_state
00096Fr 1  F0 08                beq     @idle
000971r 1  C9 01                cmp     #RS_READ
000973r 1  D0 03                bne     :+
000975r 1  4C rr rr             jmp     @read
000978r 1               :
000978r 1  60                   rts
000979r 1  AD rr rr     @idle:  lda     rd_left         ; anything left to read?
00097Cr 1  0D rr rr             ora     rd_left+1
00097Fr 1  0D rr rr             ora     rd_left+2
000982r 1  0D rr rr             ora     rd_left+3
000985r 1  D0 55                bne     @req
000987r 1  AD rr rr             lda     loop_on         ; no: back to the loop frame (if looping:
00098Ar 1  D0 01                bne     @seek           ; it may be turned on later)
00098Cr 1  60                   rts
00098Dr 1  A2 03        @seek:  ldx     #3              ; offset 128 + loop x 14
00098Fr 1  BD rr rr     @s1:    lda     hdr+10,x
000992r 1  9D rr rr             sta     acc,x
000995r 1  CA                   dex
000996r 1  10 F7                bpl     @s1
000998r 1  20 rr rr             jsr     mul14
00099Br 1  AD rr rr             lda     acc
00099Er 1  18                   clc
00099Fr 1  69 80                adc     #128
0009A1r 1  8D rr rr             sta     ch_off
0009A4r 1  A2 01                ldx     #1
0009A6r 1  A0 03                ldy     #3              ; (counted in Y: CPX would upset the carry)
0009A8r 1  BD rr rr     @s2:    lda     acc,x
0009ABr 1  69 00                adc     #0
0009ADr 1  9D rr rr             sta     ch_off,x
0009B0r 1  E8                   inx
0009B1r 1  88                   dey
0009B2r 1  D0 F4                bne     @s2
0009B4r 1  20 rr rr             jsr     ch_seek
0009B7r 1  C9 14                cmp     #USB_INT_SUCCESS
0009B9r 1  D0 55                bne     @err
0009BBr 1  A2 03                ldx     #3              ; (frames - loop) x 14 bytes to go
0009BDr 1  38                   sec
0009BEr 1  A0 00                ldy     #0
0009C0r 1  B9 rr rr     @s3:    lda     hdr+6,y
0009C3r 1  F9 rr rr             sbc     hdr+10,y
0009C6r 1  99 rr rr             sta     acc,y
0009C9r 1  C8                   iny
0009CAr 1  CA                   dex
0009CBr 1  10 F3                bpl     @s3
0009CDr 1  20 rr rr             jsr     mul14
0009D0r 1  A2 03                ldx     #3
0009D2r 1  BD rr rr     @s4:    lda     acc,x
0009D5r 1  9D rr rr             sta     rd_left,x
0009D8r 1  CA                   dex
0009D9r 1  10 F7                bpl     @s4
0009DBr 1  60                   rts
0009DCr 1  A9 00        @req:   lda     #<$F000         ; ask for min(rd_left, $F000) bytes
0009DEr 1  A2 F0                ldx     #>$F000
0009E0r 1  AC rr rr             ldy     rd_left+3
0009E3r 1  D0 12                bne     @big
0009E5r 1  AC rr rr             ldy     rd_left+2
0009E8r 1  D0 0D                bne     @big
0009EAr 1  AC rr rr             ldy     rd_left+1
0009EDr 1  C0 F0                cpy     #>$F000
0009EFr 1  B0 06                bcs     @big
0009F1r 1  AD rr rr             lda     rd_left
0009F4r 1  AE rr rr             ldx     rd_left+1
0009F7r 1  48           @big:   pha
0009F8r 1  A9 3A                lda     #CMD_BYTE_READ
0009FAr 1  20 rr rr             jsr     ch_cmd
0009FDr 1  68                   pla
0009FEr 1  20 rr rr             jsr     ch_wr
000A01r 1  8A                   txa
000A02r 1  20 rr rr             jsr     ch_wr
000A05r 1  A9 00                lda     #0
000A07r 1  8D rr rr             sta     rd_got
000A0Ar 1  A9 01                lda     #RS_READ
000A0Cr 1  8D rr rr             sta     rd_state
000A0Fr 1  60                   rts
000A10r 1  A9 01        @err:   lda     #1
000A12r 1  8D rr rr             sta     rd_err
000A15r 1  A9 02                lda     #RS_STOP
000A17r 1  8D rr rr             sta     rd_state
000A1Ar 1  60                   rts
000A1Br 1               
000A1Br 1  AD 21 7F     @read:  lda     CH_CMD          ; the drive not ready yet: next time
000A1Er 1  30 32                bmi     @r
000A20r 1  AD rr rr             lda     fill+1          ; room for a block? (64 bytes; 255 allowed for)
000A23r 1  C9 0F                cmp     #>(RING_SIZE - 256)
000A25r 1  90 0B                bcc     @room
000A27r 1  D0 29                bne     @r
000A29r 1  AD rr rr             lda     fill
000A2Cr 1  C9 00                cmp     #<(RING_SIZE - 256)
000A2Er 1  F0 02                beq     @room
000A30r 1  B0 20                bcs     @r
000A32r 1  A9 22        @room:  lda     #CMD_GET_STATUS
000A34r 1  20 rr rr             jsr     ch_cmd
000A37r 1  20 rr rr             jsr     ch_rd
