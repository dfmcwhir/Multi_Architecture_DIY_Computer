000666r 1  8D rr rr             sta     @ld+1
000669r 1  8C rr rr             sty     @ld+2
00066Cr 1  A0 00                ldy     #0
00066Er 1  A2 01                ldx     #1
000670r 1               @c:
000670r 1  B9 FF FF     @ld:    lda     $FFFF,y
000673r 1  C9 20                cmp     #' '
000675r 1  F0 09                beq     @e
000677r 1  9D rr rr             sta     path_buf,x
00067Ar 1  E8                   inx
00067Br 1  C8                   iny
00067Cr 1  C0 08                cpy     #8
00067Er 1  D0 F0                bne     @c
000680r 1  A0 00        @e:     ldy     #0
000682r 1  B9 rr rr     @x:     lda     ays_ext,y
000685r 1  9D rr rr             sta     path_buf,x
000688r 1  E8                   inx
000689r 1  C8                   iny
00068Ar 1  C0 05                cpy     #5
00068Cr 1  D0 F4                bne     @x
00068Er 1  A9 2F                lda     #'/'
000690r 1  8D rr rr             sta     path_buf
000693r 1  CA                   dex
000694r 1  CA                   dex
000695r 1  8E rr rr             stx     name_len
000698r 1  60                   rts
