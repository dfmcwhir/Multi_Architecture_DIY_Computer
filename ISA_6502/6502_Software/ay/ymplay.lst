000A7Br 1  AC rr rr             ldy     @st+2
000A7Er 1  C8                   iny
000A7Fr 1  C0 70                cpy     #>RING_END
000A81r 1  D0 02                bne     @c0
000A83r 1  A0 60                ldy     #>RING
000A85r 1  8C rr rr     @c0:    sty     @st+2
000A88r 1  CA           @c1:    dex
000A89r 1  D0 E5                bne     @c
000A8Br 1  AD rr rr             lda     @st+1
000A8Er 1  8D rr rr             sta     wr_ptr
000A91r 1  AD rr rr             lda     @st+2
000A94r 1  8D rr rr             sta     wr_ptr+1
000A97r 1  AD rr rr             lda     fill            ; fill += n, rd_left -= n
000A9Ar 1  18                   clc
000A9Br 1  6D rr rr             adc     ch_cnt
000A9Er 1  8D rr rr             sta     fill
000AA1r 1  90 03                bcc     @f
000AA3r 1  EE rr rr             inc     fill+1
000AA6r 1  AD rr rr     @f:     lda     rd_left
000AA9r 1  38                   sec
000AAAr 1  ED rr rr             sbc     ch_cnt
000AADr 1  8D rr rr             sta     rd_left
000AB0r 1  A2 01                ldx     #1
000AB2r 1  A0 03                ldy     #3              ; (counted in Y: CPX would upset the carry)
000AB4r 1  BD rr rr     @f1:    lda     rd_left,x
000AB7r 1  E9 00                sbc     #0
000AB9r 1  9D rr rr             sta     rd_left,x
000ABCr 1  E8                   inx
000ABDr 1  88                   dey
000ABEr 1  D0 F4                bne     @f1
000AC0r 1  A9 3B        @go:    lda     #CMD_BYTE_RD_GO
000AC2r 1  20 rr rr             jsr     ch_cmd
000AC5r 1  60                   rts
000AC6r 1               
000AC6r 1               ; ---- timing: VIA timer 2, one shot, polled --------------------------------------------------
000AC6r 1               ; the frame time in cycles is CLOCK_MHZ x 1000000 / rate; when that is more
000AC6r 1               ; than the timer holds it is halved (and counted out in 2, 4 ... runs)
000AC6r 1               timer_setup:
000AC6r 1  A9 80                lda     #<(CLOCK_MHZ * 1000000)
000AC8r 1  8D rr rr             sta     acc
000ACBr 1  A9 84                lda     #>(CLOCK_MHZ * 1000000)
000ACDr 1  8D rr rr             sta     acc+1
000AD0r 1  A9 1E                lda     #^(CLOCK_MHZ * 1000000)
000AD2r 1  8D rr rr             sta     acc+2
000AD5r 1  A9 00                lda     #0
000AD7r 1  8D rr rr             sta     acc+3
000ADAr 1  AD rr rr             lda     hdr+4
000ADDr 1  20 rr rr             jsr     div32
000AE0r 1  A9 01                lda     #1
000AE2r 1  8D rr rr             sta     t_runs
000AE5r 1  AD rr rr     @h:     lda     acc+2
000AE8r 1  0D rr rr             ora     acc+3
000AEBr 1  F0 12                beq     @fit
000AEDr 1  4E rr rr             lsr     acc+3
000AF0r 1  6E rr rr             ror     acc+2
000AF3r 1  6E rr rr             ror     acc+1
000AF6r 1  6E rr rr             ror     acc
000AF9r 1  0E rr rr             asl     t_runs
000AFCr 1  4C rr rr             jmp     @h
000AFFr 1  AD rr rr     @fit:   lda     acc             ; (the timer runs for its count + 2 cycles)
000B02r 1  38                   sec
000B03r 1  E9 02                sbc     #2
000B05r 1  8D rr rr             sta     t_lo
000B08r 1  AD rr rr             lda     acc+1
000B0Br 1  E9 00                sbc     #0
000B0Dr 1  8D rr rr             sta     t_hi
000B10r 1  60                   rts
000B11r 1               T2_FIX  = 39                    ; cycles from reading the timer to starting it, -2
000B11r 1               
000B11r 1               timer_start:
000B11r 1  AD rr rr             lda     t_runs
000B14r 1  8D rr rr             sta     t_left
000B17r 1  AD rr rr             lda     t_lo
000B1Ar 1  8D 08 7F             sta     VIA_T2CL
000B1Dr 1  AD rr rr             lda     t_hi
000B20r 1  8D 09 7F             sta     VIA_T2CH        ; (starts it, and clears its flag)
000B23r 1  60                   rts
000B24r 1               
000B24r 1               ; wait for the end of the frame, and start the next one
000B24r 1               timer_wait:
000B24r 1  AD 0D 7F     @w:     lda     VIA_IFR
000B27r 1  29 20                and     #$20
000B29r 1  F0 F9                beq     @w
000B2Br 1                       ; the timer has gone on counting down past 0 ($FFFF, $FFFE ...): it
000B2Br 1                       ; says how late this is, so the next run is made that much shorter
000B2Br 1                       ; and the beat doesn't drift
000B2Br 1  AE 09 7F     @rd:    ldx     VIA_T2CH
000B2Er 1  AD 08 7F             lda     VIA_T2CL
000B31r 1  EC 09 7F             cpx     VIA_T2CH        ; (the high byte changed in between: again)
000B34r 1  D0 F5                bne     @rd
000B36r 1  38                   sec                     ; count + 1 + the timer - T2_FIX
000B37r 1  6D rr rr             adc     t_lo
000B3Ar 1  A8                   tay
000B3Br 1  8A                   txa
000B3Cr 1  6D rr rr             adc     t_hi
000B3Fr 1  90 1A                bcc     @late           ; (more than a whole run late)
000B41r 1  AA                   tax
000B42r 1  98                   tya
000B43r 1  38                   sec
000B44r 1  E9 27                sbc     #T2_FIX
000B46r 1  B0 01                bcs     @s
000B48r 1  CA                   dex
000B49r 1  8D 08 7F     @s:     sta     VIA_T2CL
000B4Cr 1  8E 09 7F             stx     VIA_T2CH
000B4Fr 1  CE rr rr             dec     t_left
000B52r 1  D0 D0                bne     @w
000B54r 1  AD rr rr             lda     t_runs
000B57r 1  8D rr rr             sta     t_left
000B5Ar 1  60                   rts
000B5Br 1  A9 64        @late:  lda     #100
000B5Dr 1  8D 08 7F             sta     VIA_T2CL
000B60r 1  A9 00                lda     #0
000B62r 1  8D 09 7F             sta     VIA_T2CH
000B65r 1  CE rr rr             dec     t_left
000B68r 1  D0 BA                bne     @w
000B6Ar 1  AD rr rr             lda     t_runs
000B6Dr 1  8D rr rr             sta     t_left
000B70r 1  60                   rts
000B71r 1               
000B71r 1               ; ---- the time shown -------------------------------------------------------------------------
000B71r 1               count_time:
000B71r 1  EE rr rr             inc     sec_frames
000B74r 1  AD rr rr             lda     sec_frames
000B77r 1  CD rr rr             cmp     hdr+4
000B7Ar 1  90 17                bcc     @r
000B7Cr 1  A9 00                lda     #0
000B7Er 1  8D rr rr             sta     sec_frames
