001098r 1  29 10                and     #16
00109Ar 1  F0 11                beq     @m0
00109Cr 1  D0 07                bne     @m1
00109Er 1  AD rr rr     @one:   lda     tmp             ; once: the first cycle, then after it
0010A1r 1  C9 10                cmp     #16
0010A3r 1  90 08                bcc     @m0
0010A5r 1  AD rr rr     @m1:    lda     tmp3
0010A8r 1  29 03                and     #3
