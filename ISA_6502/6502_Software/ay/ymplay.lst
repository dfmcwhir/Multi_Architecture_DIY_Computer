ca65 V2.19 - Git a6530f4
Main file   : ymplay.s
Current file: ymplay.s

000000r 1               ; ============================================================================
000000r 1               ; ymplay.s - YMPLAY: plays chip music from the USB drive on the AY-3-8910 card
000000r 1               ;
000000r 1               ;   build:  make.bat  (or make)        run:  L YMPLAY 0500   then   R
000000r 1               ;
000000r 1               ; The songs are .AYS files: .YM files converted on the PC by tools\ym2ays.py
000000r 1               ; (the .YM format is packed and needs more RAM to unpack than the SBC has).
000000r 1               ; YMPLAY lists the .AYS files in the monitor's current folder (its L command
000000r 1               ; changes folders), which it asks the ROM for: SBC_CWD ($FE18) gives the path
000000r 1               ; ("" for the top folder, "/MUSIC", "/A/B").  A ROM without SBC_CWD: the top
000000r 1               ; folder.  The folder is entered a level at a time before the list and before
000000r 1               ; each song (the CH376 forgets its current folder when a file is opened).
000000r 1               ; YMPLAY uses the drive as the monitor left it, and starts it afresh only if
000000r 1               ; that doesn't work.
000000r 1               ;
000000r 1               ; The song list:  W/S (or up/down on the gamepad) choose, a number picks one
000000r 1               ;                 directly, space/Enter (pad A) plays, Q quits.
000000r 1               ; Playing:        space (pad A) pause, N or D (pad right) next song,
000000r 1               ;                 A or P (pad left) previous song, L or W (pad up) loop the
000000r 1               ;                 song on/off, V the level bars on/off, S or Esc (pad down)
000000r 1               ;                 back to the list, Q quits.
000000r 1               ; Without looping, the next song starts when one ends.
000000r 1               ;
000000r 1               ; How it plays: the song is read from the drive into a 4 KB ring buffer, a
000000r 1               ; 64 byte block at a time, between frames, while the frames are played from
000000r 1               ; the other end; VIA timer 2, polled (its interrupt stays off), times the
000000r 1               ; frames (50 a second for most songs).  Timer 1 and the gamepad aren't
000000r 1               ; touched.
000000r 1               ;
000000r 1               ; The level bars: one for each channel, from the registers as they are
000000r 1               ; written (there is no sound to measure): the volume, or for a channel on the
000000r 1               ; envelope, the envelope's level, worked out from its shape and period.  A bar
000000r 1               ; jumps up and falls back slowly, with a peak mark that waits, then falls.
000000r 1               ; Only the cells that changed are sent, a few a frame (fewer the more frames a
000000r 1               ; second), so the terminal keeps up and the frames stay on time.
000000r 1               ; ============================================================================
000000r 1               
000000r 1                       .setcpu "6502"
000000r 1                       .include "sbc_api.inc"
000000r 2               ; sbc_api.inc - fixed ROM entry points of the SBC (see jumptable.s), and the
000000r 2               ; CPU clock.  Use in your own ca65 programs:  .include "sbc_api.inc"
000000r 2               ; (the games find it one folder up: their make.bat passes  -I ..  to ca65)
000000r 2               SBC_CHRIN       = $FE00         ; carry set + A = char, carry clear = none waiting
000000r 2               SBC_CHROUT      = $FE03         ; print A (A, X, Y preserved)
000000r 2               SBC_MENU        = $FE06         ; boot menu
000000r 2               SBC_COLD        = $FE09         ; BASIC cold start
000000r 2               SBC_WARM        = $FE0C         ; BASIC warm start
000000r 2               SBC_MONITOR     = $FE0F         ; monitor prompt (or JMP $FF00)
000000r 2               SBC_PADSTATE    = $FE12         ; A = gamepad buttons held: bit0 A,1 B,2 Select,3 Start,4 Up,5 Down,6 Left,7 Right
000000r 2               SBC_LOAD        = $FE15         ; load a file: A/Y = parameter block (.word addr, .word max, "NAME.EXT",0)
000000r 2                                               ;   carry clear = loaded, X/Y = length; carry set = failed, A = error code
000000r 2               SBC_CWD         = $FE18         ; A/Y = the monitor's current folder: 0-ended, "" (the top) or "/A/B"
000000r 2                                               ;   (newer ROMs: check for a JMP ($4C) at $FE18 first)
000000r 2               
000000r 2               ; The CPU clock in MHz (whole numbers, 1 to 8).  Programs size their delay
000000r 2               ; loops from it, so a millisecond stays a millisecond.  To build for another
000000r 2               ; clock, change it here or give it on the command line:  make.bat 1
000000r 2               .ifndef CLOCK_MHZ
000000r 2               CLOCK_MHZ       = 2
000000r 2               .endif
000000r 2               
000000r 1               
000000r 1               VIA_T2CL        = $7F08
000000r 1               VIA_T2CH        = $7F09
000000r 1               VIA_ACR         = $7F0B
000000r 1               VIA_IFR         = $7F0D
000000r 1               VIA_IER         = $7F0E
000000r 1               
000000r 1               RING            = $6000         ; the ring buffer, $6000-$6FFF
000000r 1               RING_END        = $7000
000000r 1               RING_SIZE       = RING_END - RING
000000r 1               MAX_SONGS       = 60
000000r 1               CWD_MAX         = 31            ; the longest path (the monitor's too)
000000r 1               .ifndef SBC_CWD
000000r 1               SBC_CWD         = $FE18         ; (newer ROMs: A/Y = the monitor's current folder)
000000r 1               .endif
000000r 1               
000000r 1                       .segment "CODE"
000000r 1  4C rr rr             jmp     start
000003r 1               
000003r 1                       .include "common.s"
000003r 2               ; ============================================================================
000003r 2               ; common.s - small helpers shared by AYTEST and YMPLAY: printing, keys, delays
000003r 2               ; ============================================================================
000003r 2               
000003r 2               ; PRINT label: print the 0-ended string at label; keeps X
000003r 2               .macro  PRINT   str
000003r 2                       lda     #<str
000003r 2                       ldy     #>str
000003r 2                       jsr     print
000003r 2               .endmacro
000003r 2               
000003r 2               ; print the 0-ended string at A (low) / Y (high).  Keeps X.
000003r 2  8D rr rr     print:  sta     @ld+1
000006r 2  8C rr rr             sty     @ld+2
000009r 2  AD FF FF     @ld:    lda     $FFFF
00000Cr 2  F0 0D                beq     @r
00000Er 2  20 03 FE             jsr     SBC_CHROUT
000011r 2  EE rr rr             inc     @ld+1
000014r 2  D0 F3                bne     @ld
000016r 2  EE rr rr             inc     @ld+2
000019r 2  D0 EE                bne     @ld
00001Br 2  60           @r:     rts
00001Cr 2               
00001Cr 2  A9 0D        crlf:   lda     #13
00001Er 2  20 03 FE             jsr     SBC_CHROUT
000021r 2  A9 0A                lda     #10
000023r 2  4C 03 FE             jmp     SBC_CHROUT
000026r 2               
000026r 2               ; print A as 2 decimal digits (0-99)
000026r 2  A2 30        prdec2: ldx     #'0'
000028r 2  C9 0A        @t:     cmp     #10
00002Ar 2  90 05                bcc     @u
00002Cr 2  E9 0A                sbc     #10
00002Er 2  E8                   inx
00002Fr 2  D0 F7                bne     @t
000031r 2  48           @u:     pha
000032r 2  8A                   txa
000033r 2  20 03 FE             jsr     SBC_CHROUT
000036r 2  68                   pla
000037r 2  09 30                ora     #'0'
000039r 2  4C 03 FE             jmp     SBC_CHROUT
00003Cr 2               
00003Cr 2               ; print A in hex
00003Cr 2  48           prhex:  pha
00003Dr 2  4A                   lsr
00003Er 2  4A                   lsr
00003Fr 2  4A                   lsr
000040r 2  4A                   lsr
000041r 2  20 rr rr             jsr     @d
000044r 2  68                   pla
000045r 2  29 0F                and     #$0F
000047r 2  C9 0A        @d:     cmp     #10
000049r 2  90 02                bcc     @n
00004Br 2  69 06                adc     #'A' - '0' - 10 - 1
00004Dr 2  69 30        @n:     adc     #'0'
00004Fr 2  4C 03 FE             jmp     SBC_CHROUT
000052r 2               
000052r 2               ; a key: carry set and A = the key (letters in upper case), or carry clear
000052r 2  20 00 FE     getkey: jsr     SBC_CHRIN
000055r 2  90 0B                bcc     @r
000057r 2  C9 61                cmp     #'a'
000059r 2  90 06                bcc     @y
00005Br 2  C9 7B                cmp     #'z' + 1
00005Dr 2  B0 02                bcs     @y
00005Fr 2  29 DF                and     #$DF
000061r 2  38           @y:     sec
000062r 2  60           @r:     rts
000063r 2               
000063r 2               ; wait for a key; A = the key (upper case)
000063r 2  20 rr rr     waitkey:jsr     getkey
000066r 2  90 FB                bcc     waitkey
000068r 2  60                   rts
000069r 2               
000069r 2               ; wait about A ms.  The inner loop is sized for the clock (CLOCK_MHZ in
000069r 2               ; sbc_api.inc): 5 + 4 * (CLOCK_MHZ - 1) cycles a turn, DELAY_N turns a ms.
000069r 2               DELAY_N = (1000 * CLOCK_MHZ - 7) / (5 + 4 * (CLOCK_MHZ - 1))
000069r 2               delay_ms:
000069r 2  AA                   tax
00006Ar 2  F0 0A                beq     @done
00006Cr 2  A0 DD        @o:     ldy     #DELAY_N
00006Er 2               @i:
00006Er 2  EA EA        .repeat CLOCK_MHZ - 1
000070r 2                       nop
000070r 2                       nop
000070r 2               .endrepeat
000070r 2  88                   dey
000071r 2  D0 FB                bne     @i
000073r 2  CA                   dex
000074r 2  D0 F6                bne     @o
000076r 2  60           @done:  rts
000077r 2               
000077r 1                       .include "ay.s"
000077r 2               ; ============================================================================
000077r 2               ; ay.s - AY-3-8910 sound chip driver for the 6502 SBC (ca65)
000077r 2               ;
000077r 2               ; The card (write only):
000077r 2               ;   AY_ADDR  $7F22  write the number of the register to use  (BDIR = BC1 = 1)
000077r 2               ;   AY_DATA  $7F23  write a value to that register           (BDIR = 1, BC1 = 0)
000077r 2               ;   BC2 and A8 tied high, A9 low; chip clock 2 MHz; the three channels mixed
000077r 2               ;   together (mono).  The I/O ports aren't used: register 7 keeps them inputs.
000077r 2               ;
000077r 2               ; Only plain STA abs is used on the card's addresses: an indexed store
000077r 2               ; (STA abs,X) can make an extra read cycle there first, and the card decodes
000077r 2               ; the address without looking at R/W.
000077r 2               ;
000077r 2               ; Routines (A, X, Y may change unless it says):
000077r 2               ;   ay_write    register X = A (A, X, Y kept)
000077r 2               ;   ay_silence  all channels off, volumes 0, envelope stopped
000077r 2               ;   ay_regs     registers 0-13 from the 14 bytes at (ay_ptr); register 13 is
000077r 2               ;               only written when it isn't $FF (writing it restarts the
000077r 2               ;               envelope)
000077r 2               ;   ay_tone     channel X (0-2) to tone period A (low) / Y (high)
000077r 2               ;   ay_note     channel X (0-2) to note A (0 = C1 .. 95 = B8, 45 = A4 440 Hz)
000077r 2               ;   ay_volume   channel X (0-2) to volume A (0-15; 16 = the envelope)
000077r 2               ;   ay_mixer    register 7 = A, the I/O port bits kept as inputs
000077r 2               ;
000077r 2               ; The registers:
000077r 2               ;   0/1 2/3 4/5  tone period of A, B, C (12 bits: low, high 4 bits):
000077r 2               ;                frequency = 2 MHz / (16 * period)
000077r 2               ;   6            noise period (5 bits)
000077r 2               ;   7            mixer: bits 0-2 tone A-C off, bits 3-5 noise A-C off
000077r 2               ;                (0 = on), bits 6-7 I/O port directions (kept 0)
000077r 2               ;   8 9 10       volume A, B, C (0-15), bit 4 = use the envelope
000077r 2               ;   11/12        envelope period (16 bits): one ramp (16 steps) lasts
000077r 2               ;                256 x period / 2 MHz
000077r 2               ;   13           envelope shape (writing it restarts the envelope)
000077r 2               ; ============================================================================
000077r 2               
000077r 2               AY_ADDR         = $7F22
000077r 2               AY_DATA         = $7F23
000077r 2               
000077r 2               AY_TONE_A       = 0
000077r 2               AY_NOISE        = 6
000077r 2               AY_MIXER        = 7
000077r 2               AY_VOL_A        = 8
000077r 2               AY_ENV_LO       = 11
000077r 2               AY_ENV_HI       = 12
000077r 2               AY_ENV_SHAPE    = 13
000077r 2               
000077r 2               ; envelope shapes (register 13)
000077r 2               ENV_DECAY       = $00           ; \______   fade out once
000077r 2               ENV_ATTACK      = $0D           ; /~~~~~~   fade in once, then stay up
000077r 2               ENV_SAW_DOWN    = $08           ; \\\\\\\   repeat
000077r 2               ENV_SAW_UP      = $0C           ; ///////   repeat
000077r 2               ENV_TRIANGLE    = $0E           ; /\/\/\/   repeat
000077r 2               ENV_TRIANGLE2   = $0A           ; \/\/\/\   repeat
000077r 2               ENV_DECAY_HOLD  = $0B           ; \~~~~~~   fade out, then jump up and stay
000077r 2               ENV_ATTACK_ZERO = $0F           ; /______   fade in, then drop to 0
000077r 2               
000077r 2               ; register X = A.  Keeps A, X and Y.
000077r 2               ay_write:
000077r 2  8E 22 7F             stx     AY_ADDR
00007Ar 2  8D 23 7F             sta     AY_DATA
00007Dr 2  60                   rts
00007Er 2               
00007Er 2               ; everything quiet: tones and noise off, volumes 0, the envelope stopped
00007Er 2               ay_silence:
00007Er 2  48                   pha
00007Fr 2  8A                   txa
000080r 2  48                   pha
000081r 2  A9 3F                lda     #$3F            ; mixer: all off (and the ports inputs)
000083r 2  A2 07                ldx     #AY_MIXER
000085r 2  20 rr rr             jsr     ay_write
000088r 2  A9 00                lda     #0
00008Ar 2  A2 08                ldx     #AY_VOL_A       ; volumes 0
00008Cr 2  20 rr rr             jsr     ay_write
00008Fr 2  E8                   inx
000090r 2  20 rr rr             jsr     ay_write
000093r 2  E8                   inx
000094r 2  20 rr rr             jsr     ay_write
000097r 2  A2 00                ldx     #0              ; tone and noise periods 0
000099r 2  20 rr rr     @p:     jsr     ay_write
00009Cr 2  E8                   inx
00009Dr 2  E0 07                cpx     #AY_MIXER
00009Fr 2  D0 F8                bne     @p
0000A1r 2  A2 0B                ldx     #AY_ENV_LO      ; envelope period 0, shape 0 (fades to 0)
0000A3r 2  20 rr rr             jsr     ay_write
0000A6r 2  E8                   inx
0000A7r 2  20 rr rr             jsr     ay_write
0000AAr 2  E8                   inx
0000ABr 2  20 rr rr             jsr     ay_write
0000AEr 2  68                   pla
0000AFr 2  AA                   tax
0000B0r 2  68                   pla
0000B1r 2  60                   rts
0000B2r 2               
0000B2r 2               ; registers 0-13 from (ay_ptr); register 13 only if it isn't $FF
0000B2r 2               ay_regs:
0000B2r 2  AD rr rr             lda     ay_ptr
0000B5r 2  8D rr rr             sta     @ld+1
0000B8r 2  AD rr rr             lda     ay_ptr+1
0000BBr 2  8D rr rr             sta     @ld+2
0000BEr 2  A2 00                ldx     #0
0000C0r 2               @l:
0000C0r 2  BD FF FF     @ld:    lda     $FFFF,x
0000C3r 2  E0 0D                cpx     #AY_ENV_SHAPE
0000C5r 2  D0 04                bne     @w
0000C7r 2  C9 FF                cmp     #$FF
0000C9r 2  F0 0B                beq     @r
0000CBr 2  8E 22 7F     @w:     stx     AY_ADDR
0000CEr 2  8D 23 7F             sta     AY_DATA
0000D1r 2  E8                   inx
0000D2r 2  E0 0E                cpx     #14
0000D4r 2  D0 EA                bne     @l
0000D6r 2  60           @r:     rts
0000D7r 2               
0000D7r 2               ; channel X (0-2): tone period A (low) / Y (high)
0000D7r 2               ay_tone:
0000D7r 2  48                   pha
0000D8r 2  8A                   txa
0000D9r 2  0A                   asl
0000DAr 2  AA                   tax
0000DBr 2  68                   pla
0000DCr 2  20 rr rr             jsr     ay_write        ; the low byte
0000DFr 2  E8                   inx
0000E0r 2  98                   tya
0000E1r 2  20 rr rr             jsr     ay_write        ; the high 4 bits
0000E4r 2  8A                   txa
0000E5r 2  4A                   lsr
0000E6r 2  AA                   tax
0000E7r 2  60                   rts
0000E8r 2               
0000E8r 2               ; channel X (0-2): note A (0 = C1 .. 95 = B8)
0000E8r 2               ay_note:
0000E8r 2  C9 60                cmp     #AY_NOTES
0000EAr 2  90 02                bcc     @ok
0000ECr 2  A9 5F                lda     #AY_NOTES - 1
0000EEr 2  A8           @ok:    tay
0000EFr 2  B9 rr rr             lda     note_hi,y
0000F2r 2  48                   pha
0000F3r 2  B9 rr rr             lda     note_lo,y
0000F6r 2  A8                   tay
0000F7r 2  68                   pla                     ; (A = high, Y = low: swapped for ay_tone)
0000F8r 2  8D rr rr             sta     ay_tmp
0000FBr 2  98                   tya
0000FCr 2  AC rr rr             ldy     ay_tmp
0000FFr 2  4C rr rr             jmp     ay_tone
000102r 2               
000102r 2               ; channel X (0-2): volume A (0-15, 16 = follow the envelope)
000102r 2               ay_volume:
000102r 2  48                   pha
000103r 2  8A                   txa
000104r 2  18                   clc
000105r 2  69 08                adc     #AY_VOL_A
000107r 2  AA                   tax
000108r 2  68                   pla
000109r 2  20 rr rr             jsr     ay_write
00010Cr 2  48                   pha
00010Dr 2  8A                   txa
00010Er 2  38                   sec
00010Fr 2  E9 08                sbc     #AY_VOL_A
000111r 2  AA                   tax
000112r 2  68                   pla
000113r 2  60                   rts
000114r 2               
000114r 2               ; mixer (register 7) = A: the port direction bits are always kept 0 (inputs)
000114r 2               ay_mixer:
000114r 2  29 3F                and     #$3F
000116r 2  A2 07                ldx     #AY_MIXER
000118r 2  4C rr rr             jmp     ay_write
00011Br 2               
00011Br 2                       .include "ay_notes.inc"
00011Br 3               ; generated by tools/gen_notes.py: tone periods for a 2000000 Hz chip clock
00011Br 3               ; note n = octave * 12 + semitone (C1 = 0 ... B8 = 95); A4 (n = 45) is 440 Hz
00011Br 3               AY_NOTES = 96
00011Br 3               note_lo:
00011Br 3  EE 18 4D 8E          .byte   $EE, $18, $4D, $8E, $DA, $2F, $8F, $F7, $68, $E1, $61, $E9   ; octave 1
00011Fr 3  DA 2F 8F F7  
000123r 3  68 E1 61 E9  
000127r 3  77 0C A7 47          .byte   $77, $0C, $A7, $47, $ED, $98, $47, $FC, $B4, $70, $31, $F4   ; octave 2
00012Br 3  ED 98 47 FC  
00012Fr 3  B4 70 31 F4  
000133r 3  BC 86 53 24          .byte   $BC, $86, $53, $24, $F6, $CC, $A4, $7E, $5A, $38, $18, $FA   ; octave 3
000137r 3  F6 CC A4 7E  
00013Br 3  5A 38 18 FA  
00013Fr 3  DE C3 AA 92          .byte   $DE, $C3, $AA, $92, $7B, $66, $52, $3F, $2D, $1C, $0C, $FD   ; octave 4
000143r 3  7B 66 52 3F  
000147r 3  2D 1C 0C FD  
00014Br 3  EF E1 D5 C9          .byte   $EF, $E1, $D5, $C9, $BE, $B3, $A9, $9F, $96, $8E, $86, $7F   ; octave 5
00014Fr 3  BE B3 A9 9F  
000153r 3  96 8E 86 7F  
000157r 3  77 71 6A 64          .byte   $77, $71, $6A, $64, $5F, $59, $54, $50, $4B, $47, $43, $3F   ; octave 6
00015Br 3  5F 59 54 50  
00015Fr 3  4B 47 43 3F  
000163r 3  3C 38 35 32          .byte   $3C, $38, $35, $32, $2F, $2D, $2A, $28, $26, $24, $22, $20   ; octave 7
000167r 3  2F 2D 2A 28  
00016Br 3  26 24 22 20  
00016Fr 3  1E 1C 1B 19          .byte   $1E, $1C, $1B, $19, $18, $16, $15, $14, $13, $12, $11, $10   ; octave 8
000173r 3  18 16 15 14  
000177r 3  13 12 11 10  
00017Br 3               note_hi:
00017Br 3  0E 0E 0D 0C          .byte   $0E, $0E, $0D, $0C, $0B, $0B, $0A, $09, $09, $08, $08, $07
00017Fr 3  0B 0B 0A 09  
000183r 3  09 08 08 07  
000187r 3  07 07 06 06          .byte   $07, $07, $06, $06, $05, $05, $05, $04, $04, $04, $04, $03
00018Br 3  05 05 05 04  
00018Fr 3  04 04 04 03  
000193r 3  03 03 03 03          .byte   $03, $03, $03, $03, $02, $02, $02, $02, $02, $02, $02, $01
000197r 3  02 02 02 02  
00019Br 3  02 02 02 01  
00019Fr 3  01 01 01 01          .byte   $01, $01, $01, $01, $01, $01, $01, $01, $01, $01, $01, $00
0001A3r 3  01 01 01 01  
0001A7r 3  01 01 01 00  
0001ABr 3  00 00 00 00          .byte   $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00
0001AFr 3  00 00 00 00  
0001B3r 3  00 00 00 00  
0001B7r 3  00 00 00 00          .byte   $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00
0001BBr 3  00 00 00 00  
0001BFr 3  00 00 00 00  
0001C3r 3  00 00 00 00          .byte   $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00
0001C7r 3  00 00 00 00  
0001CBr 3  00 00 00 00  
0001CFr 3  00 00 00 00          .byte   $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00
0001D3r 3  00 00 00 00  
0001D7r 3  00 00 00 00  
0001DBr 3               
0001DBr 2               
0001DBr 2                       .segment "BSS"
000000r 2  xx xx        ay_ptr:     .res 2              ; ay_regs: where the 14 register values are
000002r 2  xx           ay_tmp:     .res 1
000003r 2                       .segment "CODE"
0001DBr 2               
0001DBr 1                       .include "ch376r.s"
0001DBr 2               ; ============================================================================
0001DBr 2               ; ch376r.s - reading files from the USB drive through the CH376 (parallel
0001DBr 2               ; mode, at $7F20 data / $7F21 command and status), for programs loaded from
0001DBr 2               ; the monitor: start the chip, list a directory, open, read, seek, close.
0001DBr 2               ; The same protocol as the firmware's driver (ch376_abs.s), cut down to
0001DBr 2               ; reading.  Every wait has a time-out, so a missing drive can't hang it.
0001DBr 2               ;
0001DBr 2               ;   ch_check    is the chip there?  carry set if not
0001DBr 2               ;   ch_start    check the chip, USB host mode, mount the drive: carry set =
0001DBr 2               ;               failed (A = what failed: 1 no chip, 2 mode, 3 no drive).  This
0001DBr 2               ;               starts the drive afresh, in its top folder.
0001DBr 2               ;   ch_open     open the file whose 0-ended name is at A/Y: "NAME.EXT" in the
0001DBr 2               ;               current folder, "/NAME.EXT" in the top one: A = the CH376
0001DBr 2               ;               status ($14 = open, $42 = not found)
0001DBr 2               ;   ch_read     read ch_len bytes to (ch_ptr): A = $14 when done, ch_got =
0001DBr 2               ;               bytes read (fewer at the end of the file)
0001DBr 2               ;   ch_seek     to the 32 bit offset in ch_off
0001DBr 2               ;   ch_close    close the open file
0001DBr 2               ; With CH_WRITE defined, also writing:
0001DBr 2               ;   ch_create   make the file whose 0-ended name is at A/Y (emptied if it is
0001DBr 2               ;               there), open for writing: A = the status ($14 = made)
0001DBr 2               ;   ch_write    write ch_len bytes from (ch_ptr): A = $14 when done
0001DBr 2               ;   ch_close_w  close it, with its length kept
0001DBr 2               ;   ch_dir      list the files that match the 0-ended name at A/Y ("/*": the
0001DBr 2               ;               top folder, "*": the current one): calls (ch_entry_fn) for
0001DBr 2               ;               each, with the 32 byte FAT entry in ch_ent (0-7 name, 8-10
0001DBr 2               ;               extension, 11 attributes, 28-31 size).  A = $42 when it has
0001DBr 2               ;               listed them all, or the status that stopped it (no drive ...)
0001DBr 2               ;   ch_enter    make the folder whose 0-ended path is at A/Y ("" the top,
0001DBr 2               ;               "/A" or "/A/B") the current one, a level at a time: "/A",
0001DBr 2               ;               then "B".  A = $41 (ERR_OPEN_DIR) when it is in, else the
0001DBr 2               ;               status that stopped it ($42: a folder isn't there)
0001DBr 2               ;
0001DBr 2               ; The current folder: the CH376 keeps the last folder opened as its current
0001DBr 2               ; one, and names without a "/" are found there.  It isn't kept for long:
0001DBr 2               ; opening a file leaves the chip with no current folder that works, so enter
0001DBr 2               ; the folder again before each relative name (as the monitor does).
0001DBr 2               ; ============================================================================
0001DBr 2               
0001DBr 2               CH_DATA         = $7F20
0001DBr 2               CH_CMD          = $7F21
0001DBr 2               
0001DBr 2               CMD_CHECK_EXIST = $06
0001DBr 2               CMD_SET_USB_MODE= $15
0001DBr 2               CMD_GET_STATUS  = $22
0001DBr 2               CMD_RD_USB_DATA0= $27
0001DBr 2               CMD_SET_FILE_NAME = $2F
0001DBr 2               CMD_DISK_CONNECT= $30
0001DBr 2               CMD_DISK_MOUNT  = $31
0001DBr 2               CMD_FILE_OPEN   = $32
0001DBr 2               CMD_FILE_ENUM_GO= $33
0001DBr 2               CMD_FILE_CLOSE  = $36
0001DBr 2               CMD_BYTE_LOCATE = $39
0001DBr 2               CMD_BYTE_READ   = $3A
0001DBr 2               CMD_BYTE_RD_GO  = $3B
0001DBr 2               CMD_WR_REQ_DATA = $2D
0001DBr 2               CMD_FILE_CREATE = $34
0001DBr 2               CMD_BYTE_WRITE  = $3C
0001DBr 2               CMD_BYTE_WR_GO  = $3D
0001DBr 2               USB_INT_DISK_WRITE = $1E
0001DBr 2               
0001DBr 2               USB_INT_SUCCESS = $14
0001DBr 2               USB_INT_DISK_READ = $1D
0001DBr 2               ERR_OPEN_DIR    = $41
0001DBr 2               ERR_MISS_FILE   = $42
0001DBr 2               CMD_RET_SUCCESS = $51
0001DBr 2               
0001DBr 2               ; wait while the chip is busy (status bit 4), at most ~100 ms.  Keeps X, Y.
0001DBr 2               ch_wait_busy:
0001DBr 2  AD 21 7F             lda     CH_CMD
0001DEr 2  29 10                and     #$10
0001E0r 2  F0 19                beq     @r
0001E2r 2  8A                   txa
0001E3r 2  48                   pha
0001E4r 2  98                   tya
0001E5r 2  48                   pha
0001E6r 2  A0 07                ldy     #CH_BUSY_OUTER
0001E8r 2  A2 00                ldx     #0
0001EAr 2  AD 21 7F     @l:     lda     CH_CMD
0001EDr 2  29 10                and     #$10
0001EFr 2  F0 06                beq     @ok
0001F1r 2  CA                   dex
0001F2r 2  D0 F6                bne     @l
0001F4r 2  88                   dey
0001F5r 2  D0 F3                bne     @l
0001F7r 2  68           @ok:    pla
0001F8r 2  A8                   tay
0001F9r 2  68                   pla
0001FAr 2  AA                   tax
0001FBr 2  60           @r:     rts
0001FCr 2               CH_BUSY_OUTER = (CLOCK_MHZ * 100000) / 3333 / 10 + 1     ; 256 x 13 cycles a turn
0001FCr 2               
0001FCr 2               ; a command (A).  Keeps X, Y.
0001FCr 2  48           ch_cmd: pha
0001FDr 2  20 rr rr             jsr     ch_wait_busy
000200r 2  68                   pla
000201r 2  8D 21 7F             sta     CH_CMD
000204r 2  EA                   nop                     ; (the chip wants ~1.5 us before the next access)
000205r 2  EA                   nop
000206r 2  EA                   nop
000207r 2  EA                   nop
000208r 2  60                   rts
000209r 2               
000209r 2               ; a data byte (A) to the chip.  Keeps X, Y.
000209r 2  48           ch_wr:  pha
00020Ar 2  20 rr rr             jsr     ch_wait_busy
00020Dr 2  68                   pla
00020Er 2  8D 20 7F             sta     CH_DATA
000211r 2  60                   rts
000212r 2               
000212r 2               ; a data byte from the chip, in A.  Keeps X, Y.
000212r 2  20 rr rr     ch_rd:  jsr     ch_wait_busy
000215r 2  AD 20 7F             lda     CH_DATA
000218r 2  60                   rts
000219r 2               
000219r 2               ; wait for the chip's interrupt (status bit 7 low), at most ~3 s: carry set
000219r 2               ; if it never came.  Keeps X, Y.
000219r 2               ch_wait_int:
000219r 2  8A                   txa
00021Ar 2  48                   pha
00021Br 2  98                   tya
00021Cr 2  48                   pha
00021Dr 2  A9 08                lda     #CH_INT_OUTER
00021Fr 2  8D rr rr             sta     ch_tmo
000222r 2  A0 00                ldy     #0
000224r 2  A2 00                ldx     #0
000226r 2  AD 21 7F     @l:     lda     CH_CMD
000229r 2  10 11                bpl     @got
00022Br 2  E8                   inx
00022Cr 2  D0 F8                bne     @l
00022Er 2  C8                   iny
00022Fr 2  D0 F5                bne     @l
000231r 2  CE rr rr             dec     ch_tmo
000234r 2  D0 F0                bne     @l
000236r 2  68                   pla
000237r 2  A8                   tay
000238r 2  68                   pla
000239r 2  AA                   tax
00023Ar 2  38                   sec
00023Br 2  60                   rts
00023Cr 2  68           @got:   pla
00023Dr 2  A8                   tay
00023Er 2  68                   pla
00023Fr 2  AA                   tax
000240r 2  18                   clc
000241r 2  60                   rts
000242r 2               CH_INT_OUTER = (CLOCK_MHZ * 3) * 1000000 / 786000 + 1    ; 65536 x 12 cycles a turn
000242r 2               
000242r 2               ; the interrupt's status in A (and the interrupt cleared); $FF and carry set
000242r 2               ; on a time-out.  Keeps X, Y.
000242r 2               ch_status:
000242r 2  20 rr rr             jsr     ch_wait_int
000245r 2  B0 08                bcs     @t
000247r 2  A9 22                lda     #CMD_GET_STATUS
000249r 2  20 rr rr             jsr     ch_cmd
00024Cr 2  4C rr rr             jmp     ch_rd
00024Fr 2  A9 FF        @t:     lda     #$FF
000251r 2  60                   rts
000252r 2               
000252r 2               ; ---- is the chip there?  (carry set if not) -------------------------------------------
000252r 2               ch_check:
000252r 2  A9 06                lda     #CMD_CHECK_EXIST
000254r 2  20 rr rr             jsr     ch_cmd
000257r 2  A9 55                lda     #$55
000259r 2  20 rr rr             jsr     ch_wr
00025Cr 2  20 rr rr             jsr     ch_rd
00025Fr 2  C9 AA                cmp     #$AA
000261r 2  F0 02                beq     @ok
000263r 2  38                   sec
000264r 2  60                   rts
000265r 2  18           @ok:    clc
000266r 2  60                   rts
000267r 2               
000267r 2               ; ---- start: check the chip, USB host mode, mount --------------------------------------
000267r 2               ch_start:
000267r 2  A9 06                lda     #CMD_CHECK_EXIST
000269r 2  20 rr rr             jsr     ch_cmd
00026Cr 2  A9 55                lda     #$55
00026Er 2  20 rr rr             jsr     ch_wr
000271r 2  20 rr rr             jsr     ch_rd
000274r 2  C9 AA                cmp     #$AA
000276r 2  F0 04                beq     @mode
000278r 2  A9 01                lda     #1              ; no chip
00027Ar 2  38                   sec
00027Br 2  60                   rts
00027Cr 2  A9 15        @mode:  lda     #CMD_SET_USB_MODE
00027Er 2  20 rr rr             jsr     ch_cmd
000281r 2  A9 06                lda     #6              ; USB host, generate SOF
000283r 2  20 rr rr             jsr     ch_wr
000286r 2  A9 01                lda     #1
000288r 2  20 rr rr             jsr     delay_ms
00028Br 2  20 rr rr             jsr     ch_rd
00028Er 2  C9 51                cmp     #CMD_RET_SUCCESS
000290r 2  F0 04                beq     @m0
000292r 2  A9 02                lda     #2
000294r 2  38                   sec
000295r 2  60                   rts
000296r 2  A9 14        @m0:    lda     #20             ; (a "drive connected" interrupt may come:
000298r 2  20 rr rr             jsr     delay_ms        ;  clear it)
00029Br 2  AD 21 7F             lda     CH_CMD
00029Er 2  30 08                bmi     @mnt
0002A0r 2  A9 22                lda     #CMD_GET_STATUS
0002A2r 2  20 rr rr             jsr     ch_cmd
0002A5r 2  20 rr rr             jsr     ch_rd
0002A8r 2  A9 05        @mnt:   lda     #5              ; mount: up to 5 tries
0002AAr 2  8D rr rr             sta     ch_try
0002ADr 2  A9 30        @m1:    lda     #CMD_DISK_CONNECT
0002AFr 2  20 rr rr             jsr     ch_cmd
0002B2r 2  20 rr rr             jsr     ch_status
0002B5r 2  A9 31                lda     #CMD_DISK_MOUNT
0002B7r 2  20 rr rr             jsr     ch_cmd
0002BAr 2  20 rr rr             jsr     ch_status
0002BDr 2  C9 14                cmp     #USB_INT_SUCCESS
0002BFr 2  F0 0E                beq     @ok
0002C1r 2  A9 C8                lda     #200
0002C3r 2  20 rr rr             jsr     delay_ms
0002C6r 2  CE rr rr             dec     ch_try
0002C9r 2  D0 E2                bne     @m1
0002CBr 2  A9 03                lda     #3              ; no drive
0002CDr 2  38                   sec
0002CEr 2  60                   rts
0002CFr 2  18           @ok:    clc
0002D0r 2  60                   rts
0002D1r 2               
0002D1r 2               ; the file name: the 0-ended string at A/Y
0002D1r 2               ch_name:
0002D1r 2  8D rr rr             sta     @ld+1
0002D4r 2  8C rr rr             sty     @ld+2
0002D7r 2  A9 2F                lda     #CMD_SET_FILE_NAME
0002D9r 2  20 rr rr             jsr     ch_cmd
0002DCr 2  A2 00                ldx     #0
0002DEr 2               @l:
0002DEr 2  BD FF FF     @ld:    lda     $FFFF,x
0002E1r 2  20 rr rr             jsr     ch_wr
0002E4r 2  F0 0A                beq     @r
0002E6r 2  E8                   inx
0002E7r 2  E0 0E                cpx     #14
0002E9r 2  D0 F3                bne     @l
0002EBr 2  A9 00                lda     #0
0002EDr 2  20 rr rr             jsr     ch_wr
0002F0r 2  60           @r:     rts
0002F1r 2               
0002F1r 2               ch_open:
0002F1r 2  20 rr rr             jsr     ch_name
0002F4r 2  A9 32                lda     #CMD_FILE_OPEN
0002F6r 2  20 rr rr             jsr     ch_cmd
0002F9r 2  4C rr rr             jmp     ch_status
0002FCr 2               
0002FCr 2               ch_close:
0002FCr 2  A9 36                lda     #CMD_FILE_CLOSE
0002FEr 2  20 rr rr             jsr     ch_cmd
000301r 2  A9 00                lda     #0              ; (no length update: read only)
000303r 2  20 rr rr             jsr     ch_wr
000306r 2  4C rr rr             jmp     ch_status
000309r 2               
000309r 2               .ifdef CH_WRITE
000309r 2               ch_create:
000309r 2                       jsr     ch_name
000309r 2                       lda     #CMD_FILE_CREATE
000309r 2                       jsr     ch_cmd
000309r 2                       jmp     ch_status
000309r 2               
000309r 2               ch_close_w:
000309r 2                       lda     #CMD_FILE_CLOSE
000309r 2                       jsr     ch_cmd
000309r 2                       lda     #1              ; (the length kept)
000309r 2                       jsr     ch_wr
000309r 2                       jmp     ch_status
000309r 2               
000309r 2               ; write ch_len bytes from (ch_ptr), in the chunks the chip asks for
000309r 2               ch_write:
000309r 2                       lda     ch_ptr
000309r 2                       sta     @ld+1
000309r 2                       lda     ch_ptr+1
000309r 2                       sta     @ld+2
000309r 2                       lda     #CMD_BYTE_WRITE
000309r 2                       jsr     ch_cmd
000309r 2                       lda     ch_len
000309r 2                       jsr     ch_wr
000309r 2                       lda     ch_len+1
000309r 2                       jsr     ch_wr
000309r 2               @next:  jsr     ch_status
000309r 2                       cmp     #USB_INT_DISK_WRITE
000309r 2                       bne     @done           ; $14: all of it
000309r 2                       lda     #CMD_WR_REQ_DATA
000309r 2                       jsr     ch_cmd
000309r 2                       jsr     ch_rd           ; how many it takes
000309r 2                       sta     ch_cnt
000309r 2                       beq     @go
000309r 2                       ldy     #0
000309r 2               @ld:    lda     $FFFF
000309r 2                       jsr     ch_wr
000309r 2                       inc     @ld+1
000309r 2                       bne     :+
000309r 2                       inc     @ld+2
000309r 2               :       iny
000309r 2                       cpy     ch_cnt
000309r 2                       bne     @ld
000309r 2               @go:    lda     #CMD_BYTE_WR_GO
000309r 2                       jsr     ch_cmd
000309r 2                       jmp     @next
000309r 2               @done:  rts
000309r 2               .endif
000309r 2               
000309r 2               ch_seek:
000309r 2  A9 39                lda     #CMD_BYTE_LOCATE
00030Br 2  20 rr rr             jsr     ch_cmd
00030Er 2  A2 00                ldx     #0
000310r 2  BD rr rr     @l:     lda     ch_off,x
000313r 2  20 rr rr             jsr     ch_wr
000316r 2  E8                   inx
000317r 2  E0 04                cpx     #4
000319r 2  D0 F5                bne     @l
00031Br 2  4C rr rr             jmp     ch_status
00031Er 2               
00031Er 2               ; read ch_len (up to 65535) bytes to (ch_ptr): in chunks of up to 64 the chip
00031Er 2               ; hands over
00031Er 2               ch_read:
00031Er 2  A9 00                lda     #0
000320r 2  8D rr rr             sta     ch_got
000323r 2  8D rr rr             sta     ch_got+1
000326r 2  AD rr rr             lda     ch_ptr
000329r 2  8D rr rr             sta     @st+1
00032Cr 2  AD rr rr             lda     ch_ptr+1
00032Fr 2  8D rr rr             sta     @st+2
000332r 2  A9 3A                lda     #CMD_BYTE_READ
000334r 2  20 rr rr             jsr     ch_cmd
000337r 2  AD rr rr             lda     ch_len
00033Ar 2  20 rr rr             jsr     ch_wr
00033Dr 2  AD rr rr             lda     ch_len+1
000340r 2  20 rr rr             jsr     ch_wr
000343r 2  20 rr rr     @next:  jsr     ch_status
000346r 2  C9 1D                cmp     #USB_INT_DISK_READ
000348r 2  D0 3A                bne     @done           ; $14: all of it (or the end of the file)
00034Ar 2  A9 27                lda     #CMD_RD_USB_DATA0
00034Cr 2  20 rr rr             jsr     ch_cmd
00034Fr 2  20 rr rr             jsr     ch_rd           ; how many
000352r 2  8D rr rr             sta     ch_cnt
000355r 2  F0 25                beq     @go
000357r 2  A0 00                ldy     #0
000359r 2  20 rr rr     @c:     jsr     ch_rd
00035Cr 2  8D FF FF     @st:    sta     $FFFF
00035Fr 2  EE rr rr             inc     @st+1
000362r 2  D0 03                bne     @c1
000364r 2  EE rr rr             inc     @st+2
000367r 2  C8           @c1:    iny
000368r 2  CC rr rr             cpy     ch_cnt
00036Br 2  D0 EC                bne     @c
00036Dr 2  AD rr rr             lda     ch_got
000370r 2  18                   clc
000371r 2  6D rr rr             adc     ch_cnt
000374r 2  8D rr rr             sta     ch_got
000377r 2  90 03                bcc     @go
000379r 2  EE rr rr             inc     ch_got+1
00037Cr 2  A9 3B        @go:    lda     #CMD_BYTE_RD_GO
00037Er 2  20 rr rr             jsr     ch_cmd
000381r 2  4C rr rr             jmp     @next
000384r 2  60           @done:  rts
000385r 2               
000385r 2               ; list the files matching the name at A/Y: (ch_entry_fn) for each entry
000385r 2               ; (ch_ent); A = $42 at the end, or an error status
000385r 2  20 rr rr     ch_dir: jsr     ch_name
000388r 2  A9 32                lda     #CMD_FILE_OPEN
00038Ar 2  20 rr rr             jsr     ch_cmd
00038Dr 2  20 rr rr     @next:  jsr     ch_status
000390r 2  C9 1D                cmp     #USB_INT_DISK_READ
000392r 2  D0 31                bne     @r
000394r 2  A9 27                lda     #CMD_RD_USB_DATA0
000396r 2  20 rr rr             jsr     ch_cmd
000399r 2  20 rr rr             jsr     ch_rd
00039Cr 2  8D rr rr             sta     ch_cnt
00039Fr 2  A0 00                ldy     #0
0003A1r 2  CC rr rr     @rd:    cpy     ch_cnt
0003A4r 2  B0 0D                bcs     @got
0003A6r 2  20 rr rr             jsr     ch_rd
0003A9r 2  C0 20                cpy     #32
0003ABr 2  B0 03                bcs     @sk
0003ADr 2  99 rr rr             sta     ch_ent,y
0003B0r 2  C8           @sk:    iny
0003B1r 2  D0 EE                bne     @rd
0003B3r 2  AD rr rr     @got:   lda     ch_cnt
0003B6r 2  C9 20                cmp     #32
0003B8r 2  90 03                bcc     @more
0003BAr 2  20 rr rr             jsr     @call
0003BDr 2  A9 33        @more:  lda     #CMD_FILE_ENUM_GO
0003BFr 2  20 rr rr             jsr     ch_cmd
0003C2r 2  4C rr rr             jmp     @next
0003C5r 2  60           @r:     rts
0003C6r 2  6C rr rr     @call:  jmp     (ch_entry_fn)
0003C9r 2               
0003C9r 2               ; enter the folder whose path is at A/Y ("" / "/A" / "/A/B"), a level at a
0003C9r 2               ; time; A = $41 when in it
0003C9r 2               ch_enter:
0003C9r 2  8D rr rr             sta     ce_get+1
0003CCr 2  8C rr rr             sty     ce_get+2
0003CFr 2  A0 00                ldy     #0
0003D1r 2  A2 00        @part:  ldx     #0              ; the next part: "/A" the first time, then "B"
0003D3r 2  20 rr rr             jsr     ce_get
0003D6r 2  F0 36                beq     @in             ; (the end of the path)
0003D8r 2  C0 00                cpy     #0
0003DAr 2  D0 04                bne     @skip
0003DCr 2  8D rr rr             sta     ch_part         ; (only the first keeps its "/")
0003DFr 2  E8                   inx
0003E0r 2  C8           @skip:  iny
0003E1r 2  20 rr rr     @cp:    jsr     ce_get
0003E4r 2  F0 0D                beq     @end
0003E6r 2  C9 2F                cmp     #'/'
0003E8r 2  F0 09                beq     @end
0003EAr 2  9D rr rr             sta     ch_part,x
0003EDr 2  E8                   inx
0003EEr 2  C8                   iny
0003EFr 2  E0 0E                cpx     #14
0003F1r 2  90 EE                bcc     @cp
0003F3r 2  A9 00        @end:   lda     #0
0003F5r 2  9D rr rr             sta     ch_part,x
0003F8r 2  8C rr rr             sty     ch_py           ; (where we are in the path)
0003FBr 2  A9 rr                lda     #<ch_part
0003FDr 2  A0 rr                ldy     #>ch_part
0003FFr 2  20 rr rr             jsr     ch_open
000402r 2  AC rr rr             ldy     ch_py
000405r 2  C9 41                cmp     #ERR_OPEN_DIR
000407r 2  D0 07                bne     @r              ; not a folder (or not there)
000409r 2  20 rr rr             jsr     ce_get          ; more?
00040Cr 2  D0 C3                bne     @part
00040Er 2  A9 41        @in:    lda     #ERR_OPEN_DIR
000410r 2  60           @r:     rts
000411r 2  B9 FF FF     ce_get: lda     $FFFF,y         ; (the path's next character)
000414r 2  60                   rts
000415r 2               
000415r 2                       .segment "BSS"
000003r 2  xx xx        ch_ptr:     .res 2
000005r 2  xx xx        ch_len:     .res 2
000007r 2  xx xx        ch_got:     .res 2
000009r 2  xx           ch_cnt:     .res 1
00000Ar 2  xx xx xx xx  ch_off:     .res 4
00000Er 2  xx           ch_tmo:     .res 1
00000Fr 2  xx           ch_try:     .res 1
000010r 2  xx xx        ch_entry_fn:.res 2
000012r 2  xx xx xx xx  ch_ent:     .res 32
000016r 2  xx xx xx xx  
00001Ar 2  xx xx xx xx  
000032r 2  xx xx xx xx  ch_part:    .res 16             ; (ch_enter: one part of a path,
000036r 2  xx xx xx xx  
00003Ar 2  xx xx xx xx  
000042r 2  xx           ch_py:      .res 1              ;  and where it is in the path)
000043r 2                       .segment "CODE"
000415r 2               
000415r 1               
000415r 1               ; ---- start ---------------------------------------------------------------------------
000415r 1  D8           start:  cld
000416r 1  A2 FF                ldx     #$FF
000418r 1  9A                   txs
000419r 1  20 rr rr             jsr     ay_silence
00041Cr 1  AD 0B 7F             lda     VIA_ACR         ; timer 2: one shot (the count down mode)
00041Fr 1  29 DF                and     #$DF
000421r 1  8D 0B 7F             sta     VIA_ACR
000424r 1  A9 20                lda     #$20            ; and its interrupt off
000426r 1  8D 0E 7F             sta     VIA_IER
000429r 1  A9 rr A0 rr          PRINT   hello_txt
00042Dr 1  20 rr rr     
000430r 1  A9 00                lda     #0              ; the monitor's current folder (from the ROM:
000432r 1  8D rr rr             sta     cwd_buf         ; SBC_CWD; without it, the top folder)
000435r 1  AD 18 FE             lda     SBC_CWD
000438r 1  C9 4C                cmp     #$4C            ; (a JMP there?)
00043Ar 1  D0 1D                bne     @nocwd
00043Cr 1  20 18 FE             jsr     SBC_CWD
00043Fr 1  8D rr rr             sta     @cw+1
000442r 1  8C rr rr             sty     @cw+2
000445r 1  A2 00                ldx     #0
000447r 1  BD FF FF     @cw:    lda     $FFFF,x
00044Ar 1  9D rr rr             sta     cwd_buf,x
00044Dr 1  F0 0A                beq     @nocwd
00044Fr 1  E8                   inx
000450r 1  E0 1F                cpx     #CWD_MAX
000452r 1  90 F3                bcc     @cw
000454r 1  A9 00                lda     #0              ; (too long: the top folder)
000456r 1  8D rr rr             sta     cwd_buf
000459r 1  20 rr rr     @nocwd: jsr     ch_check        ; the chip?
00045Cr 1  A9 01                lda     #1
00045Er 1  B0 0C                bcs     @err
000460r 1  20 rr rr             jsr     list_dir        ; the songs in the current folder
