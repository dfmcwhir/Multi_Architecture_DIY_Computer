000A3Cr 1  F0 15                beq     @blk
000A3Er 1  C9 14                cmp     #USB_INT_SUCCESS
000A40r 1  D0 CE                bne     @err
000A42r 1  AD rr rr             lda     rd_got          ; the read is done; one that got nothing
000A45r 1  D0 06                bne     @done           ; means the file ended early
000A47r 1  A9 02                lda     #RS_STOP
000A49r 1  8D rr rr             sta     rd_state
000A4Cr 1  60                   rts
000A4Dr 1  A9 00        @done:  lda     #RS_IDLE
000A4Fr 1  8D rr rr             sta     rd_state
000A52r 1  60           @r:     rts
000A53r 1  A9 27        @blk:   lda     #CMD_RD_USB_DATA0
000A55r 1  20 rr rr             jsr     ch_cmd
000A58r 1  20 rr rr             jsr     ch_rd
000A5Br 1  8D rr rr             sta     ch_cnt
000A5Er 1  8D rr rr             sta     rd_got
000A61r 1  AA                   tax
000A62r 1  F0 5C                beq     @go
000A64r 1  AD rr rr             lda     wr_ptr
000A67r 1  8D rr rr             sta     @st+1
