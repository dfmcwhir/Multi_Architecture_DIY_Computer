00051Fr 1  4C rr rr             jmp     bye
000522r 1  C9 57        @k1:    cmp     #'W'
000524r 1  D0 0B                bne     @k2
000526r 1  AD rr rr             lda     sel             ; up
000529r 1  F0 ED                beq     @k
00052Br 1  CE rr rr             dec     sel
