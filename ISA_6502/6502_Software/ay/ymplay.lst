0006A6r 1  AD rr rr             lda     playing
0006A9r 1  F0 03                beq     @b
0006ABr 1  20 rr rr             jsr     stop_file
0006AEr 1  A9 rr A0 rr  @b:     PRINT   bye_txt
0006B2r 1  20 rr rr     
0006B5r 1  4C 06 FE             jmp     SBC_MENU
0006B8r 1               
0006B8r 1               ; ---- playing a song ---------------------------------------------------------------------
0006B8r 1               play_sel:
0006B8r 1  A9 00                lda     #0
0006BAr 1  8D rr rr             sta     playing
0006BDr 1               play_again:
0006BDr 1  20 rr rr             jsr     ay_silence
0006C0r 1  20 rr rr             jsr     to_msg          ; (below the last song's screen)
0006C3r 1  AE rr rr             ldx     sel
0006C6r 1  20 rr rr             jsr     song_name
0006C9r 1  A9 rr A0 rr          PRINT   playing_txt
0006CDr 1  20 rr rr     
0006D0r 1  A9 rr A0 rr          PRINT   name_buf
0006D4r 1  20 rr rr     
0006D7r 1  20 rr rr             jsr     crlf
0006DAr 1  20 rr rr             jsr     enter_cwd       ; into its folder again
0006DDr 1  D0 10                bne     @nop
0006DFr 1  A9 rr                lda     #<name_buf      ; in it: no "/" (the top folder: "/NAME.AYS")
0006E1r 1  A0 rr                ldy     #>name_buf
0006E3r 1  AE rr rr             ldx     cwd_buf
0006E6r 1  D0 04                bne     @o
0006E8r 1  A9 rr                lda     #<path_buf
0006EAr 1  A0 rr                ldy     #>path_buf
0006ECr 1  20 rr rr     @o:     jsr     ch_open
0006EFr 1               @nop:
0006EFr 1  C9 14                cmp     #USB_INT_SUCCESS
0006F1r 1  F0 0D                beq     @op
0006F3r 1  20 rr rr             jsr     prhex
0006F6r 1  A9 rr A0 rr          PRINT   open_err_txt
0006FAr 1  20 rr rr     
0006FDr 1  4C rr rr             jmp     song_over
000700r 1  EE rr rr     @op:    inc     playing
000703r 1  A9 rr                lda     #<hdr           ; the 128 byte header
000705r 1  8D rr rr             sta     ch_ptr
000708r 1  A9 rr                lda     #>hdr
00070Ar 1  8D rr rr             sta     ch_ptr+1
00070Dr 1  A9 80                lda     #128
00070Fr 1  8D rr rr             sta     ch_len
000712r 1  A9 00                lda     #0
000714r 1  8D rr rr             sta     ch_len+1
000717r 1  20 rr rr             jsr     ch_read
00071Ar 1  AD rr rr             lda     ch_got
00071Dr 1  C9 80                cmp     #128
00071Fr 1  D0 20                bne     @bad
000721r 1  A2 03                ldx     #3
000723r 1  BD rr rr     @sig:   lda     hdr,x
000726r 1  DD rr rr             cmp     ays_sig,x
000729r 1  D0 16                bne     @bad
00072Br 1  CA                   dex
00072Cr 1  10 F5                bpl     @sig
00072Er 1  AD rr rr             lda     hdr+4           ; frames a second
000731r 1  F0 0E                beq     @bad
000733r 1  AD rr rr             lda     hdr+6           ; any frames?
000736r 1  0D rr rr             ora     hdr+7
000739r 1  0D rr rr             ora     hdr+8
00073Cr 1  0D rr rr             ora     hdr+9
00073Fr 1  D0 0D                bne     @ok
000741r 1  A9 rr A0 rr  @bad:   PRINT   bad_txt
000745r 1  20 rr rr     
000748r 1  20 rr rr             jsr     stop_file
00074Br 1  4C rr rr             jmp     song_over
00074Er 1               
00074Er 1  20 rr rr     @ok:    jsr     timer_setup
000751r 1  20 rr rr             jsr     vis_song
000754r 1  20 rr rr             jsr     draw_screen
000757r 1                       ; the reader: from the first frame, nframes x 14 bytes to go
000757r 1  A2 03                ldx     #3
000759r 1  BD rr rr     @n:     lda     hdr+6,x
00075Cr 1  9D rr rr             sta     acc,x
00075Fr 1  CA                   dex
000760r 1  10 F7                bpl     @n
000762r 1  20 rr rr             jsr     mul14
000765r 1  A2 03                ldx     #3
000767r 1  BD rr rr     @n2:    lda     acc,x
00076Ar 1  9D rr rr             sta     rd_left,x
00076Dr 1  A9 00                lda     #0
00076Fr 1  9D rr rr             sta     play_frame,x
000772r 1  CA                   dex
000773r 1  10 F2                bpl     @n2
000775r 1  A9 00                lda     #<RING
000777r 1  8D rr rr             sta     wr_ptr
00077Ar 1  8D rr rr             sta     rp_ptr
00077Dr 1  A9 60                lda     #>RING
00077Fr 1  8D rr rr             sta     wr_ptr+1
000782r 1  8D rr rr             sta     rp_ptr+1
000785r 1  A9 00                lda     #0
000787r 1  8D rr rr             sta     fill
00078Ar 1  8D rr rr             sta     fill+1
00078Dr 1  8D rr rr             sta     rd_state        ; idle
000790r 1  8D rr rr             sta     rd_err
000793r 1  8D rr rr             sta     paused
000796r 1  8D rr rr             sta     secs
000799r 1  8D rr rr             sta     secs+1
00079Cr 1  8D rr rr             sta     sec_frames
00079Fr 1  A2 08                ldx     #8              ; fill the buffer a bit before starting
0007A1r 1  20 rr rr     @pre:   jsr     reader
0007A4r 1  20 rr rr             jsr     reader
0007A7r 1  CA                   dex
0007A8r 1  D0 F7                bne     @pre
0007AAr 1  20 rr rr             jsr     show_time
0007ADr 1  20 rr rr             jsr     timer_start
0007B0r 1               
0007B0r 1               ; once a frame: wait for the timer, write the registers, read ahead, keys
0007B0r 1  20 rr rr     frame:  jsr     timer_wait
0007B3r 1  AD rr rr             lda     paused
0007B6r 1  D0 4C                bne     @keys
0007B8r 1  AD rr rr             lda     fill+1          ; a whole frame in the buffer?
0007BBr 1  D0 14                bne     @play
0007BDr 1  AD rr rr             lda     fill
0007C0r 1  C9 0E                cmp     #14
0007C2r 1  B0 0D                bcs     @play
0007C4r 1  AD rr rr             lda     rd_state        ; no: the end of the data (or an error)?
0007C7r 1  C9 02                cmp     #RS_STOP
0007C9r 1  D0 03                bne     :+
0007CBr 1  4C rr rr             jmp     @end
0007CEr 1               :
0007CEr 1  4C rr rr             jmp     @read           ; (or not here yet: wait)
0007D1r 1  20 rr rr     @play:  jsr     play_frame_regs
0007D4r 1  20 rr rr             jsr     count_time
0007D7r 1  A2 03                ldx     #3              ; the end of the song?
0007D9r 1  BD rr rr     @e:     lda     play_frame,x
0007DCr 1  DD rr rr             cmp     hdr+6,x
0007DFr 1  D0 16                bne     @read
0007E1r 1  CA                   dex
0007E2r 1  10 F5                bpl     @e
0007E4r 1  AD rr rr             lda     loop_on
0007E7r 1  D0 03                bne     :+
0007E9r 1  4C rr rr             jmp     @end
0007ECr 1               :
0007ECr 1  A2 03                ldx     #3              ; looping: from the loop frame (the reader
0007EEr 1  BD rr rr     @lp:    lda     hdr+10,x        ; has gone back there too)
0007F1r 1  9D rr rr             sta     play_frame,x
0007F4r 1  CA                   dex
0007F5r 1  10 F7                bpl     @lp
0007F7r 1  20 rr rr     @read:  jsr     reader          ; read ahead: a block of 64 a frame, 2 when
0007FAr 1  AD rr rr             lda     fill+1          ; the buffer is under half full
0007FDr 1  C9 08                cmp     #>(RING_SIZE / 2)
0007FFr 1  B0 03                bcs     @keys
000801r 1  20 rr rr             jsr     reader
000804r 1  20 rr rr     @keys:  jsr     vis_tick        ; the bars
000807r 1  20 rr rr             jsr     getkey
00080Ar 1  B0 03                bcs     @key
00080Cr 1  4C rr rr             jmp     frame
00080Fr 1               @key:
00080Fr 1  C9 20                cmp     #' '
000811r 1  F0 37                beq     @pause
000813r 1  C9 4E                cmp     #'N'
000815r 1  D0 03                bne     :+
000817r 1  4C rr rr             jmp     @next
00081Ar 1               :
00081Ar 1  C9 44                cmp     #'D'
00081Cr 1  D0 03                bne     :+
00081Er 1  4C rr rr             jmp     @next
000821r 1               :
000821r 1  C9 41                cmp     #'A'
000823r 1  F0 6E                beq     @prev
000825r 1  C9 50                cmp     #'P'
000827r 1  F0 6A                beq     @prev
000829r 1  C9 4C                cmp     #'L'
00082Br 1  F0 41                beq     @loop
00082Dr 1  C9 57                cmp     #'W'
00082Fr 1  F0 3D                beq     @loop
000831r 1  C9 53                cmp     #'S'
000833r 1  F0 55                beq     @list
000835r 1  C9 1B                cmp     #27
000837r 1  F0 51                beq     @list
000839r 1  C9 51                cmp     #'Q'
00083Br 1  F0 0A                beq     @quit
00083Dr 1  C9 56                cmp     #'V'
00083Fr 1  D0 03                bne     :+
000841r 1  4C rr rr             jmp     @vis
000844r 1  4C rr rr     :       jmp     frame
000847r 1  4C rr rr     @quit:  jmp     bye
00084Ar 1  AD rr rr     @pause: lda     paused
00084Dr 1  49 01                eor     #1
00084Fr 1  8D rr rr             sta     paused
