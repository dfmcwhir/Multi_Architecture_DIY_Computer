000502r 1  29 03                and     #3
000504r 1  F0 03                beq     @h
000506r 1  20 rr rr             jsr     crlf
000509r 1  A9 rr A0 rr  @h:     PRINT   keys_txt
00050Dr 1  20 rr rr     
000510r 1  A9 00                lda     #0
000512r 1  8D rr rr             sta     digits
000515r 1  20 rr rr     @show:  jsr     show_sel
000518r 1  20 rr rr     @k:     jsr     waitkey
00051Br 1  C9 51                cmp     #'Q'
