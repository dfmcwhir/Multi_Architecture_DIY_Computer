000B84r 1  D0 03                bne     @t
000B86r 1  EE rr rr             inc     secs+1
000B89r 1  A2 02        @t:     ldx     #2              ; just the time played, over the old one
000B8Br 1  A0 03                ldy     #TIME_ROW
000B8Dr 1  20 rr rr             jsr     goto
000B90r 1  4C rr rr             jmp     pr_secs
000B93r 1  60           @r:     rts
000B94r 1               
000B94r 1               ; "  mm:ss / mm:ss  LOOP" over the last one
000B94r 1               show_time:
