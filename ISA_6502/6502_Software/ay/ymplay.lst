000B9Fr 1  20 rr rr     
000BA2r 1  20 rr rr             jsr     pr_secs
000BA5r 1  A9 rr A0 rr          PRINT   of_txt
000BA9r 1  20 rr rr     
000BACr 1  A2 03                ldx     #3
000BAEr 1  BD rr rr     @c:     lda     hdr+6,x
000BB1r 1  9D rr rr             sta     acc,x
000BB4r 1  CA                   dex
000BB5r 1  10 F7                bpl     @c
000BB7r 1  AD rr rr             lda     hdr+4
