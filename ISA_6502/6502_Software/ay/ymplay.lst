001082r 1  BD rr rr             lda     env_tab,x
001085r 1  8D rr rr             sta     tmp3
001088r 1  10 14                bpl     @one
00108Ar 1  AD rr rr             lda     env_inc+1       ; repeating, at 16 steps or more an update:
00108Dr 1  0D rr rr             ora     env_inc+2       ;  too fast to follow, shown steady
001090r 1  F0 03                beq     @rs
001092r 1  A9 0B                lda     #11
001094r 1  60                   rts
