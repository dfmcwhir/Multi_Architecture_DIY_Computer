0005D6r 1  A0 rr                ldy     #>star_txt
0005D8r 1  AE rr rr             ldx     cwd_buf
0005DBr 1  D0 04                bne     @d
0005DDr 1  A9 rr                lda     #<rstar_txt
0005DFr 1  A0 rr                ldy     #>rstar_txt
0005E1r 1  4C rr rr     @d:     jmp     ch_dir
0005E4r 1  60           @r:     rts
