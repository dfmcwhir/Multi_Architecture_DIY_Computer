000601r 1               
000601r 1               ; A FAT entry from the directory: keep it if it is an .AYS file
000601r 1               add_song:
000601r 1  AD rr rr             lda     ch_ent+11       ; not a folder or the volume name
000604r 1  29 18                and     #$18
000606r 1  D0 3C                bne     @r
000608r 1  AD rr rr             lda     ch_ent
00060Br 1  F0 37                beq     @r
00060Dr 1  C9 E5                cmp     #$E5            ; (deleted)
00060Fr 1  F0 33                beq     @r
000611r 1  AD rr rr             lda     ch_ent+8
000614r 1  C9 41                cmp     #'A'
000616r 1  D0 2C                bne     @r
000618r 1  AD rr rr             lda     ch_ent+9
00061Br 1  C9 59                cmp     #'Y'
00061Dr 1  D0 25                bne     @r
00061Fr 1  AD rr rr             lda     ch_ent+10
000622r 1  C9 53                cmp     #'S'
000624r 1  D0 1E                bne     @r
000626r 1  AD rr rr             lda     nsongs
000629r 1  C9 3C                cmp     #MAX_SONGS
00062Br 1  B0 17                bcs     @r
00062Dr 1  20 rr rr             jsr     song_addr
000630r 1  8D rr rr             sta     @st+1
000633r 1  8C rr rr             sty     @st+2
000636r 1  A0 07                ldy     #7
000638r 1  B9 rr rr     @c:     lda     ch_ent,y
00063Br 1  99 FF FF     @st:    sta     $FFFF,y
00063Er 1  88                   dey
00063Fr 1  10 F7                bpl     @c
000641r 1  EE rr rr             inc     nsongs
000644r 1  60           @r:     rts
000645r 1               
000645r 1               ; A/Y = where the 8 byte name of song A is
000645r 1               song_addr:
000645r 1  A0 00                ldy     #0
000647r 1  8C rr rr             sty     tmp2
00064Ar 1  0A                   asl                     ; x 8
00064Br 1  2E rr rr             rol     tmp2
00064Er 1  0A                   asl
00064Fr 1  2E rr rr             rol     tmp2
000652r 1  0A                   asl
000653r 1  2E rr rr             rol     tmp2
000656r 1  18                   clc
000657r 1  69 rr                adc     #<songs
000659r 1  48                   pha
00065Ar 1  AD rr rr             lda     tmp2
00065Dr 1  69 rr                adc     #>songs
00065Fr 1  A8                   tay
000660r 1  68                   pla
000661r 1  60                   rts
000662r 1               
