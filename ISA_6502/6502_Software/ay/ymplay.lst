000BC9r 1  20 rr rr     
000BCCr 1  60                   rts
000BCDr 1  A9 rr A0 rr  @n:     PRINT   spaces_txt
000BD1r 1  20 rr rr     
000BD4r 1  60                   rts
000BD5r 1               
000BD5r 1               ; the time played (secs) as mm:ss
000BD5r 1  AD rr rr     pr_secs:lda     secs
000BD8r 1  8D rr rr             sta     acc
000BDBr 1  AD rr rr             lda     secs+1
000BDEr 1  8D rr rr             sta     acc+1
000BE1r 1  A9 00                lda     #0
000BE3r 1  8D rr rr             sta     acc+2
000BE6r 1  8D rr rr             sta     acc+3
000BE9r 1                       ; (on into pr_mmss)
000BE9r 1               
000BE9r 1               ; print the seconds in acc as mm:ss
000BE9r 1               pr_mmss:
000BE9r 1  A9 3C                lda     #60
000BEBr 1  20 rr rr             jsr     div32
000BEEr 1  48                   pha
000BEFr 1  AD rr rr             lda     acc+1           ; (more than 99 minutes: 99)
000BF2r 1  0D rr rr             ora     acc+2
000BF5r 1  0D rr rr             ora     acc+3
000BF8r 1  D0 07                bne     @99
000BFAr 1  AD rr rr             lda     acc
000BFDr 1  C9 64                cmp     #100
000BFFr 1  90 02                bcc     @m
000C01r 1  A9 63        @99:    lda     #99
000C03r 1  20 rr rr     @m:     jsr     prdec2
000C06r 1  A9 3A                lda     #':'
000C08r 1  20 03 FE             jsr     SBC_CHROUT
000C0Br 1  68                   pla
000C0Cr 1  4C rr rr             jmp     prdec2
000C0Fr 1               
000C0Fr 1               ; title, author, length
000C0Fr 1               show_info:
000C0Fr 1  A9 rr A0 rr          PRINT   title_txt
000C13r 1  20 rr rr     
000C16r 1  A2 10                ldx     #16
000C18r 1  20 rr rr             jsr     pr_field
000C1Br 1  A9 rr A0 rr          PRINT   author_txt
000C1Fr 1  20 rr rr     
000C22r 1  A2 30                ldx     #48
000C24r 1  20 rr rr             jsr     pr_field
000C27r 1  60                   rts
000C28r 1               
000C28r 1               ; print the 32 byte field at hdr+X (to its first 0), then a new line
000C28r 1               pr_field:
000C28r 1  A0 20                ldy     #32
000C2Ar 1  BD rr rr     @l:     lda     hdr,x
000C2Dr 1  F0 0F                beq     @e
000C2Fr 1  C9 20                cmp     #' '
000C31r 1  90 07                bcc     @sk
000C33r 1  C9 7F                cmp     #127
000C35r 1  B0 03                bcs     @sk
000C37r 1  20 03 FE             jsr     SBC_CHROUT
000C3Ar 1  E8           @sk:    inx
000C3Br 1  88                   dey
000C3Cr 1  D0 EC                bne     @l
000C3Er 1  4C rr rr     @e:     jmp     crlf
000C41r 1               
000C41r 1               ; ---- the playing screen ------------------------------------------------------------------
000C41r 1               TIME_ROW        = 3             ; "  mm:ss / mm:ss"
000C41r 1               BAR_TOP         = 5             ; the bars: rows 5-12, a cell 2 levels high
000C41r 1               BAR_ROWS        = 8
000C41r 1               LABEL_ROW       = BAR_TOP + BAR_ROWS        ; "A  TNE" under each
000C41r 1               KEYS_ROW        = 15
000C41r 1               MSG_ROW         = 18            ; where the messages go after a song
000C41r 1               BAR_W           = 10            ; columns: each cell is sent once, repeated
000C41r 1               G_ATTR          = $80 | (BAR_W << 3)        ; block graphics, repeat BAR_W
000C41r 1               
000C41r 1               ; the cursor to column X, row Y (keeps A, X, Y)
000C41r 1  48           goto:   pha
000C42r 1  A9 0E                lda     #$0E
000C44r 1  20 03 FE             jsr     SBC_CHROUT
000C47r 1  8A                   txa
000C48r 1  20 03 FE             jsr     SBC_CHROUT
000C4Br 1  A9 0F                lda     #$0F
000C4Dr 1  20 03 FE             jsr     SBC_CHROUT
000C50r 1  98                   tya
000C51r 1  20 03 FE             jsr     SBC_CHROUT
000C54r 1  68                   pla
000C55r 1  60                   rts
000C56r 1               
000C56r 1               ; the messages after a song go under its screen
000C56r 1  AD rr rr     to_msg: lda     scr_up
000C59r 1  F0 0C                beq     @r
000C5Br 1  A9 00                lda     #0
000C5Dr 1  8D rr rr             sta     scr_up
000C60r 1  A2 00                ldx     #0
000C62r 1  A0 12                ldy     #MSG_ROW
000C64r 1  4C rr rr             jmp     goto
000C67r 1  60           @r:     rts
000C68r 1               
000C68r 1               ; the whole screen afresh: name, title, author, time, keys (and the bars)
000C68r 1               draw_screen:
000C68r 1  A9 0C                lda     #12
000C6Ar 1  20 03 FE             jsr     SBC_CHROUT
000C6Dr 1  A9 01                lda     #1
000C6Fr 1  8D rr rr             sta     scr_up
000C72r 1  A9 rr A0 rr          PRINT   ymp_txt
000C76r 1  20 rr rr     
000C79r 1  A9 rr A0 rr          PRINT   name_buf
000C7Dr 1  20 rr rr     
000C80r 1  20 rr rr             jsr     crlf
000C83r 1  20 rr rr             jsr     show_info       ; (rows 1 and 2)
000C86r 1  20 rr rr             jsr     show_time
000C89r 1  A2 00                ldx     #0
000C8Br 1  A0 0F                ldy     #KEYS_ROW
000C8Dr 1  20 rr rr             jsr     goto
000C90r 1  A9 rr A0 rr          PRINT   keys2_txt
000C94r 1  20 rr rr     
000C97r 1  20 rr rr             jsr     vis_clear
000C9Ar 1  AD rr rr             lda     vis_on
000C9Dr 1  F0 27                beq     @r
000C9Fr 1  A9 rr A0 rr          PRINT   legend_txt
000CA3r 1  20 rr rr     
000CA6r 1  A2 02                ldx     #2              ; the labels
000CA8r 1  BD rr rr     @l:     lda     bar_col,x
000CABr 1  18                   clc
000CACr 1  69 02                adc     #2
000CAEr 1  8E rr rr             stx     tmp
000CB1r 1  AA                   tax
000CB2r 1  A0 0D                ldy     #LABEL_ROW
000CB4r 1  20 rr rr             jsr     goto
000CB7r 1  AE rr rr             ldx     tmp
000CBAr 1  A9 41                lda     #'A'
000CBCr 1  18                   clc
000CBDr 1  6D rr rr             adc     tmp
000CC0r 1  20 03 FE             jsr     SBC_CHROUT
000CC3r 1  CA                   dex
000CC4r 1  10 E2                bpl     @l
000CC6r 1  60           @r:     rts
000CC7r 1               
000CC7r 1  0C 23 3A     bar_col:    .byte   12, 35, 58  ; the left column of each bar
000CCAr 1               
000CCAr 1               ; nothing drawn yet: all the cells blank, the flags to be shown
000CCAr 1               vis_clear:
000CCAr 1  A2 17                ldx     #BAR_ROWS * 3 - 1
000CCCr 1  A9 00                lda     #0
000CCEr 1  9D rr rr     @c:     sta     shown,x
000CD1r 1  CA                   dex
000CD2r 1  10 FA                bpl     @c
000CD4r 1  A2 02                ldx     #2
000CD6r 1  A9 00        @b:     lda     #0
000CD8r 1  9D rr rr             sta     bar,x
000CDBr 1  9D rr rr             sta     peak,x
000CDEr 1  9D rr rr             sta     peak_t,x
000CE1r 1  A9 FF                lda     #$FF
000CE3r 1  9D rr rr             sta     flags_shown,x
000CE6r 1  CA                   dex
000CE7r 1  10 ED                bpl     @b
000CE9r 1  A9 00                lda     #0
000CEBr 1  8D rr rr             sta     draw_i
000CEEr 1  60                   rts
000CEFr 1               
000CEFr 1               ; a song starting: the rates the bars run at, the envelope model reset
000CEFr 1               vis_song:
000CEFr 1  A2 0D                ldx     #13
000CF1r 1  A9 00                lda     #0
000CF3r 1  9D rr rr     @r:     sta     regs,x
000CF6r 1  CA                   dex
000CF7r 1  10 FA                bpl     @r
000CF9r 1  8D rr rr             sta     env_new
000CFCr 1  8D rr rr             sta     env_shape
000CFFr 1  8D rr rr             sta     env_pos
000D02r 1  8D rr rr             sta     env_pos+1
000D05r 1  8D rr rr             sta     env_pos+2
000D08r 1  8D rr rr             sta     env_ep
000D0Br 1  8D rr rr             sta     env_ep+1
000D0Er 1  AD rr rr             lda     hdr+4           ; vis_k = (rate + 49) / 50: the bars every
000D11r 1  18                   clc                     ;  vis_k frames, about 50 times a second
000D12r 1  69 31                adc     #49
000D14r 1  8D rr rr             sta     acc
000D17r 1  A9 00                lda     #0
000D19r 1  69 00                adc     #0
000D1Br 1  8D rr rr             sta     acc+1
000D1Er 1  A9 00                lda     #0
000D20r 1  8D rr rr             sta     acc+2
000D23r 1  8D rr rr             sta     acc+3
000D26r 1  A9 32                lda     #50
000D28r 1  20 rr rr             jsr     div32
000D2Br 1  AD rr rr             lda     acc
000D2Er 1  8D rr rr             sta     vis_k
000D31r 1  8D rr rr             sta     vis_c
000D34r 1                       ; env_k = AY clock x vis_k / rate: the envelope's 1/16 steps in
000D34r 1                       ; vis_k frames is env_k / its period
000D34r 1  A9 00                lda     #0
000D36r 1  8D rr rr             sta     env_k
000D39r 1  8D rr rr             sta     env_k+1
000D3Cr 1  8D rr rr             sta     env_k+2
000D3Fr 1  AE rr rr             ldx     vis_k
000D42r 1  18           @k:     clc
000D43r 1  AD rr rr             lda     env_k
000D46r 1  69 80                adc     #<AY_CLOCK
000D48r 1  8D rr rr             sta     env_k
000D4Br 1  AD rr rr             lda     env_k+1
000D4Er 1  69 84                adc     #>AY_CLOCK
000D50r 1  8D rr rr             sta     env_k+1
000D53r 1  AD rr rr             lda     env_k+2
000D56r 1  69 1E                adc     #^AY_CLOCK
000D58r 1  8D rr rr             sta     env_k+2
000D5Br 1  CA                   dex
000D5Cr 1  D0 E4                bne     @k
000D5Er 1  A2 02                ldx     #2
000D60r 1  BD rr rr     @c:     lda     env_k,x
000D63r 1  9D rr rr             sta     acc,x
000D66r 1  CA                   dex
000D67r 1  10 F7                bpl     @c
000D69r 1  A9 00                lda     #0
000D6Br 1  8D rr rr             sta     acc+3
000D6Er 1  AD rr rr             lda     hdr+4
000D71r 1  20 rr rr             jsr     div32
000D74r 1  A2 02                ldx     #2
000D76r 1  BD rr rr     @c2:    lda     acc,x
000D79r 1  9D rr rr             sta     env_k,x
000D7Cr 1  9D rr rr             sta     env_inc,x       ; (period 0 counts as 1)
000D7Fr 1  CA                   dex
000D80r 1  10 F4                bpl     @c2
000D82r 1                       ; cells_max = 400 / rate (1 to 10): the cells sent in one frame
000D82r 1  A9 90                lda     #<400
000D84r 1  8D rr rr             sta     acc
000D87r 1  A9 01                lda     #>400
000D89r 1  8D rr rr             sta     acc+1
000D8Cr 1  A9 00                lda     #0
000D8Er 1  8D rr rr             sta     acc+2
000D91r 1  8D rr rr             sta     acc+3
000D94r 1  AD rr rr             lda     hdr+4
000D97r 1  20 rr rr             jsr     div32
000D9Ar 1  AD rr rr             lda     acc+1
000D9Dr 1  D0 09                bne     @12
000D9Fr 1  AD rr rr             lda     acc
000DA2r 1  F0 08                beq     @1
000DA4r 1  C9 0A                cmp     #10
000DA6r 1  90 06                bcc     @m
000DA8r 1  A9 0A        @12:    lda     #10
000DAAr 1  D0 02                bne     @m
000DACr 1  A9 01        @1:     lda     #1
000DAEr 1  8D rr rr     @m:     sta     cells_max
000DB1r 1  60                   rts
000DB2r 1               AY_CLOCK        = 2000000
000DB2r 1               
000DB2r 1               ; once a frame (playing or not): the bars every vis_k frames.  At more than
000DB2r 1               ; 100 frames a second (vis_k 3 or more) an update is spread over its frames, so
000DB2r 1               ; no one frame has much more to do: the envelope, then the bars, then sending
000DB2r 1               ; in each of the others.
000DB2r 1               vis_tick:
000DB2r 1  AD rr rr             lda     vis_on
000DB5r 1  D0 01                bne     :+
000DB7r 1  60                   rts
000DB8r 1  CE rr rr     :       dec     vis_c
000DBBr 1  AD rr rr             lda     vis_k
000DBEr 1  C9 03                cmp     #3
000DC0r 1  90 24                bcc     @all
000DC2r 1  AE rr rr             ldx     vis_c           ; (counts vis_k - 1 down to 0)
000DC5r 1  E8                   inx
000DC6r 1  E8                   inx
000DC7r 1  EC rr rr             cpx     vis_k
000DCAr 1  D0 03                bne     :+
000DCCr 1  4C rr rr             jmp     vis_env         ; the first frame
000DCFr 1  CA           :       dex
000DD0r 1  EC rr rr             cpx     vis_k
000DD3r 1  D0 03                bne     :+
000DD5r 1  4C rr rr             jmp     vis_bars        ; the second
000DD8r 1  AD rr rr     :       lda     vis_c           ; the others: sending
000DDBr 1  D0 06                bne     :+
000DDDr 1  AD rr rr             lda     vis_k
000DE0r 1  8D rr rr             sta     vis_c
000DE3r 1  4C rr rr     :       jmp     vis_send
000DE6r 1  AD rr rr     @all:   lda     vis_c
000DE9r 1  D0 0F                bne     @r
000DEBr 1  AD rr rr             lda     vis_k
000DEEr 1  8D rr rr             sta     vis_c
000DF1r 1  20 rr rr             jsr     vis_env
000DF4r 1  20 rr rr             jsr     vis_bars
000DF7r 1  4C rr rr             jmp     vis_send
000DFAr 1  60           @r:     rts
000DFBr 1               
000DFBr 1               ; the envelope: started again, a new period?  Then its level, and on
000DFBr 1               vis_env:
000DFBr 1  EE rr rr             inc     vis_tog
000DFEr 1  AD rr rr             lda     env_new
000E01r 1  F0 16                beq     @ep
000E03r 1  A9 00                lda     #0
000E05r 1  8D rr rr             sta     env_new
000E08r 1  8D rr rr             sta     env_pos
000E0Br 1  8D rr rr             sta     env_pos+1
000E0Er 1  8D rr rr             sta     env_pos+2
000E11r 1  AD rr rr             lda     regs+13
000E14r 1  29 0F                and     #15
000E16r 1  8D rr rr             sta     env_shape
000E19r 1  AD rr rr     @ep:    lda     regs+11
000E1Cr 1  CD rr rr             cmp     env_ep
000E1Fr 1  D0 08                bne     @div
000E21r 1  AD rr rr             lda     regs+12
000E24r 1  CD rr rr             cmp     env_ep+1
000E27r 1  F0 33                beq     @lev
000E29r 1  AD rr rr     @div:   lda     regs+11         ; env_inc = env_k / the period
000E2Cr 1  8D rr rr             sta     env_ep
000E2Fr 1  8D rr rr             sta     dv
000E32r 1  AD rr rr             lda     regs+12
000E35r 1  8D rr rr             sta     env_ep+1
000E38r 1  8D rr rr             sta     dv+1
000E3Br 1  0D rr rr             ora     dv
000E3Er 1  D0 03                bne     @d1
000E40r 1  EE rr rr             inc     dv              ; (0 counts as 1)
000E43r 1  A2 02        @d1:    ldx     #2
000E45r 1  BD rr rr     @q:     lda     env_k,x
000E48r 1  9D rr rr             sta     q,x
000E4Br 1  CA                   dex
000E4Cr 1  10 F7                bpl     @q
000E4Er 1  20 rr rr             jsr     div24
000E51r 1  A2 02                ldx     #2
000E53r 1  BD rr rr     @q2:    lda     q,x
000E56r 1  9D rr rr             sta     env_inc,x
000E59r 1  CA                   dex
000E5Ar 1  10 F7                bpl     @q2
000E5Cr 1  20 rr rr     @lev:   jsr     env_level
000E5Fr 1  8D rr rr             sta     env_lvl
000E62r 1  18                   clc                     ; then on: env_pos += env_inc, kept under
000E63r 1  AD rr rr             lda     env_pos         ; 512 (32 steps) once it is past them, with
000E66r 1  6D rr rr             adc     env_inc         ; 512 added to say so
000E69r 1  8D rr rr             sta     env_pos
000E6Cr 1  AD rr rr             lda     env_pos+1
000E6Fr 1  6D rr rr             adc     env_inc+1
000E72r 1  8D rr rr             sta     env_pos+1
000E75r 1  AD rr rr             lda     env_pos+2
000E78r 1  6D rr rr             adc     env_inc+2
000E7Br 1  8D rr rr             sta     env_pos+2
000E7Er 1  D0 07                bne     @past
000E80r 1  AD rr rr             lda     env_pos+1
000E83r 1  C9 02                cmp     #2
000E85r 1  90 0F                bcc     @chans
000E87r 1  AD rr rr     @past:  lda     env_pos+1
000E8Ar 1  29 01                and     #1
000E8Cr 1  09 02                ora     #2
000E8Er 1  8D rr rr             sta     env_pos+1
000E91r 1  A9 00                lda     #0
000E93r 1  8D rr rr             sta     env_pos+2
000E96r 1  60           @chans: rts
000E97r 1               
000E97r 1               ; each channel: its level now, the bar and the peak; then the cells
000E97r 1               vis_bars:
000E97r 1  A2 02                ldx     #2
000E99r 1  BD rr rr     @ch:    lda     regs+8,x
000E9Cr 1  29 10                and     #$10
000E9Er 1  F0 06                beq     @v
000EA0r 1  AD rr rr             lda     env_lvl
000EA3r 1  4C rr rr             jmp     @g
000EA6r 1  BD rr rr     @v:     lda     regs+8,x
000EA9r 1  29 0F                and     #15
000EABr 1  AC rr rr     @g:     ldy     paused
000EAEr 1  F0 02                beq     @h
000EB0r 1  A9 00                lda     #0
000EB2r 1  DD rr rr     @h:     cmp     bar,x           ; up at once, down a level at a time
000EB5r 1  90 05                bcc     @fall
000EB7r 1  9D rr rr             sta     bar,x
000EBAr 1  B0 03                bcs     @pk
000EBCr 1  DE rr rr     @fall:  dec     bar,x
000EBFr 1  BD rr rr     @pk:    lda     bar,x
000EC2r 1  DD rr rr             cmp     peak,x
000EC5r 1  90 0A                bcc     @pf
000EC7r 1  9D rr rr             sta     peak,x          ; (the peak is reached: hold it)
000ECAr 1  A9 28                lda     #PEAK_HOLD
000ECCr 1  9D rr rr             sta     peak_t,x
000ECFr 1  D0 14                bne     @fl
000ED1r 1  BD rr rr     @pf:    lda     peak_t,x
000ED4r 1  F0 06                beq     @pd
000ED6r 1  DE rr rr             dec     peak_t,x
000ED9r 1  4C rr rr             jmp     @fl
000EDCr 1  AD rr rr     @pd:    lda     vis_tog         ; then down, a level every other time
000EDFr 1  4A                   lsr
000EE0r 1  90 03                bcc     @fl
000EE2r 1  DE rr rr             dec     peak,x
000EE5r 1  A9 00        @fl:    lda     #0              ; the flags: tone, noise, envelope (on = 1)
000EE7r 1  8D rr rr             sta     tmp
000EEAr 1  AD rr rr             lda     regs+7          ; tone on: bit x clear
000EEDr 1  3D rr rr             and     bit_tab,x
000EF0r 1  D0 05                bne     @f1
000EF2r 1  A9 01                lda     #1
000EF4r 1  8D rr rr             sta     tmp
000EF7r 1  AD rr rr     @f1:    lda     regs+7          ; noise on: bit x + 3 clear
000EFAr 1  3D rr rr             and     bit_tab+3,x
000EFDr 1  D0 08                bne     @f2
000EFFr 1  AD rr rr             lda     tmp
000F02r 1  09 02                ora     #2
000F04r 1  8D rr rr             sta     tmp
000F07r 1  BD rr rr     @f2:    lda     regs+8,x
000F0Ar 1  29 10                and     #$10
000F0Cr 1  F0 08                beq     @f3
000F0Er 1  AD rr rr             lda     tmp
000F11r 1  09 04                ora     #4
000F13r 1  8D rr rr             sta     tmp
000F16r 1  AD rr rr     @f3:    lda     tmp
000F19r 1  9D rr rr             sta     flags_now,x
000F1Cr 1  CA                   dex
000F1Dr 1  30 03                bmi     @cells
000F1Fr 1  4C rr rr             jmp     @ch
000F22r 1               
000F22r 1                       ; the cells as they should be: tgt, 8 a channel, the bottom one first
000F22r 1  A2 02        @cells: ldx     #2
000F24r 1  8A           @cc:    txa
000F25r 1  0A                   asl
000F26r 1  0A                   asl
000F27r 1  0A                   asl
000F28r 1  A8                   tay                     ; Y = the channel's first cell
000F29r 1  A9 01                lda     #1              ; the levels of the cell's lower and upper
000F2Br 1  8D rr rr             sta     tmp             ;  halves: 1 and 2, then 3 and 4 ...
000F2Er 1  A9 00        @cl:    lda     #0
000F30r 1  8D rr rr             sta     tmp2
000F33r 1  BD rr rr             lda     bar,x
000F36r 1  CD rr rr             cmp     tmp
000F39r 1  90 12                bcc     @pkc            ; below the lower half: empty
000F3Br 1  A9 C0                lda     #$C0
000F3Dr 1  8D rr rr             sta     tmp2
000F40r 1  BD rr rr             lda     bar,x
000F43r 1  CD rr rr             cmp     tmp
000F46r 1  F0 05                beq     @pkc            ; just the lower half
000F48r 1  A9 CC                lda     #$CC
000F4Ar 1  8D rr rr             sta     tmp2
000F4Dr 1  BD rr rr     @pkc:   lda     peak,x          ; the peak mark, when it is above the bar
000F50r 1  DD rr rr             cmp     bar,x
000F53r 1  F0 21                beq     @st
000F55r 1  90 1F                bcc     @st
000F57r 1  CD rr rr             cmp     tmp
000F5Ar 1  D0 0A                bne     @pk2
000F5Cr 1  AD rr rr             lda     tmp2
000F5Fr 1  09 C0                ora     #$C0
000F61r 1  8D rr rr             sta     tmp2
000F64r 1  D0 10                bne     @st
000F66r 1  38           @pk2:   sec
000F67r 1  E9 01                sbc     #1
000F69r 1  CD rr rr             cmp     tmp
000F6Cr 1  D0 08                bne     @st
000F6Er 1  AD rr rr             lda     tmp2
000F71r 1  09 0C                ora     #$0C
000F73r 1  8D rr rr             sta     tmp2
000F76r 1  AD rr rr     @st:    lda     tmp2
000F79r 1  99 rr rr             sta     tgt,y
000F7Cr 1  C8                   iny
000F7Dr 1  EE rr rr             inc     tmp
000F80r 1  EE rr rr             inc     tmp
000F83r 1  98                   tya
000F84r 1  29 07                and     #7
000F86r 1  D0 A6                bne     @cl
000F88r 1  CA                   dex
000F89r 1  10 99                bpl     @cc
000F8Br 1  60                   rts
000F8Cr 1               
000F8Cr 1               ; send what changed, at most cells_max cells, carrying on next time from
000F8Cr 1               ; where it stopped; then the flags that changed
000F8Cr 1               vis_send:
000F8Cr 1  AD rr rr             lda     cells_max
000F8Fr 1  8D rr rr             sta     n_left
000F92r 1  A9 00                lda     #0
