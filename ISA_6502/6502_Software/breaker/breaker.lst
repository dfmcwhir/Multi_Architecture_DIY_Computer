0007D6r 1  D0 A6                bne     game_loop
0007D8r 1  4C rr rr             jmp     level_done
0007DBr 1               
0007DBr 1               ; wait out the rest of the frame: about (speed - what the frame took) ms:
0007DBr 1               ; the bytes at 115200 baud (87 us each) and the 6502's work (about 4 ms at
0007DBr 1               ; 1 MHz, measured in the emulator)
0007DBr 1               WORK_MS         = 4 / CLOCK_MHZ
0007DBr 1  AD rr rr     pace:   lda     nbytes+1
0007DEr 1  D0 21                bne     @r
0007E0r 1  AD rr rr             lda     nbytes          ; bytes * 0.087 ~ bytes / 16 + bytes / 32
0007E3r 1  4A                   lsr
0007E4r 1  4A                   lsr
0007E5r 1  4A                   lsr
0007E6r 1  4A                   lsr
0007E7r 1  8D rr rr             sta     tmp
0007EAr 1  4A                   lsr
0007EBr 1  6D rr rr             adc     tmp
0007EEr 1  69 02                adc     #WORK_MS
0007F0r 1  8D rr rr             sta     tmp
0007F3r 1  AD rr rr             lda     speed
0007F6r 1  38                   sec
0007F7r 1  ED rr rr             sbc     tmp
0007FAr 1  90 05                bcc     @r
0007FCr 1  F0 03                beq     @r
0007FEr 1  4C rr rr             jmp     delay_ms
000801r 1  60           @r:     rts
