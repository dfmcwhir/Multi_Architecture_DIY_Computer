000BD6r 1  C0 18                cpy     #PAD_WIDE
000BD8r 1  D0 0F                bne     @n
000BDAr 1  A0 00                ldy     #0              ; (wide: A / 3)
000BDCr 1  C9 03        @d3:    cmp     #3
000BDEr 1  90 05                bcc     @z
000BE0r 1  E9 03                sbc     #3
000BE2r 1  C8                   iny
