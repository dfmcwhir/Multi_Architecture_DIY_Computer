0006A7r 1  A0 rr                ldy     #>clip_txt
0006A9r 1  20 rr rr             jsr     print
0006ACr 1  AE rr rr             ldx     level           ; the level's bricks (they go round after
0006AFr 1  CA                   dex                     ; the last one, a little faster)
0006B0r 1  E0 0A        @m:     cpx     #NLEVEL
0006B2r 1  90 07                bcc     @m1
0006B4r 1  8A                   txa
0006B5r 1  E9 0A                sbc     #NLEVEL
0006B7r 1  AA                   tax
0006B8r 1  4C rr rr             jmp     @m
0006BBr 1  BD rr rr     @m1:    lda     lv_lo,x
0006BEr 1  8D rr rr             sta     @rd+1
0006C1r 1  BD rr rr             lda     lv_hi,x
0006C4r 1  8D rr rr             sta     @rd+2
0006C7r 1  A9 00                lda     #0
