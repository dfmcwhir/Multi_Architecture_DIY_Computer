0007C0r 1  20 rr rr             jsr     pace
0007C3r 1  EE rr rr             inc     frame
0007C6r 1  A2 02                ldx     #NBALL-1        ; any ball left?
0007C8r 1  BD rr rr     @b:     lda     b_on,x
0007CBr 1  D0 06                bne     @2
0007CDr 1  CA                   dex
0007CEr 1  10 F8                bpl     @b
