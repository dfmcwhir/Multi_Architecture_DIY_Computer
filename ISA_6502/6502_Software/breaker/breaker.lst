0006D4r 1  F0 07                beq     @cn
0006D6r 1  C9 03                cmp     #3
0006D8r 1  F0 03                beq     @cn
0006DAr 1  EE rr rr             inc     bricks_left
0006DDr 1  CA           @cn:    dex
0006DEr 1  E0 FF                cpx     #$FF
0006E0r 1  D0 EC                bne     @rd
0006E2r 1  20 rr rr             jsr     draw_bricks
0006E5r 1  AD rr rr             lda     level           ; the speed to start with: faster each
0006E8r 1  38                   sec                     ; time round the levels
0006E9r 1  E9 01                sbc     #1
0006EBr 1  4A                   lsr
0006ECr 1  4A                   lsr
0006EDr 1  4A                   lsr
0006EEr 1  C9 04                cmp     #4
0006F0r 1  90 02                bcc     @s
0006F2r 1  A9 04                lda     #4
0006F4r 1  8D rr rr     @s:     sta     base_spd
0006F7r 1  A9 01                lda     #1
0006F9r 1  8D rr rr             sta     hud_dirty
0006FCr 1  20 rr rr             jsr     hud_update
0006FFr 1  20 rr rr             jsr     serve
000702r 1  A9 01                lda     #1
000704r 1  8D rr rr             sta     msg_on
000707r 1  A9 0C                lda     #SND_START
000709r 1  20 rr rr             jsr     sfx_snd
