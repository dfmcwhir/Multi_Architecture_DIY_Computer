000000r 1               ; ============================================================================
000000r 1               ; breaker.s - BYTE BREAKER, a brick breaking game for the 6502 SBC
000000r 1               ;
000000r 1               ; Runs from the monitor at $0500 and draws on the PIC32 terminal in its
000000r 1               ; control code mode (setup item J), with the terminal's sprite layer
000000r 1               ; (control code 1C: the firmware with the sprite layer, VGA).
000000r 1               ;
000000r 1               ;   build:  make.bat  (or make)     needs ../sbc_api.inc (CLOCK_MHZ)
000000r 1               ;   run:    L BREAKER 0500   then   R
000000r 1               ;
000000r 1               ; Header (patchable from the monitor):
000000r 1               ;   $0500  JMP start
000000r 1               ;   $0503  frame time in ms (default 30; real ms at any clock)
000000r 1               ;   $0504  controls at start: 0 keyboard, 1 gamepad
000000r 1               ;   $0505  sound at start: 0 on, 1 off (M switches)
000000r 1               ;
000000r 1               ; Sound: the AY-3-8910 card at $7F22/$7F23, through ../ay/sfx.s (timed by
000000r 1               ; the VIA's timer 2), the sounds in breaker_sound.inc (made by
000000r 1               ; ../ay/tools/game_sounds.py).  Without the card the game is just silent.
000000r 1               ;
000000r 1               ; Keys:    A / D or Left / Right  move      Space  launch / fire
000000r 1               ;          P pause   M sound on / off   Q quit
000000r 1               ; Gamepad: left / right move, A or B launch / fire, Start pause
000000r 1               ;
000000r 1               ; The screen: the status line on row 0, the walls round text rows 1-23, the
000000r 1               ; bricks (19 across, up to 10 rows, each 4 block graphics characters: 8 x 4
000000r 1               ; pixels) in rows 4-13.  Bricks are characters, drawn only when they
000000r 1               ; change.  The paddle, the balls (up to 3), the falling capsules and the
000000r 1               ; laser shots are the terminal's sprites: each frame only what changed is
000000r 1               ; sent, between HOLD and SHOW, then IDENTIFY, whose answer the next frame
000000r 1               ; waits for.  Coordinates are the sprite layer's pixels (160 x 96, 3 x 3
000000r 1               ; screen pixels each); positions and speeds are 8.8 fixed point.  No zero
000000r 1               ; page is used.
000000r 1               ; ============================================================================
000000r 1               
000000r 1                       .setcpu "6502"
000000r 1                       .include "sbc_api.inc"
000000r 2               ; sbc_api.inc - fixed ROM entry points of the SBC (see jumptable.s), and the
000000r 2               ; CPU clock.  Use in your own ca65 programs:  .include "sbc_api.inc"
000000r 2               ; (the games find it one folder up: their make.bat passes  -I ..  to ca65)
000000r 2               SBC_CHRIN       = $FE00         ; carry set + A = char, carry clear = none waiting
000000r 2               SBC_CHROUT      = $FE03         ; print A (A, X, Y preserved)
000000r 2               SBC_MENU        = $FE06         ; boot menu
000000r 2               SBC_COLD        = $FE09         ; BASIC cold start
000000r 2               SBC_WARM        = $FE0C         ; BASIC warm start
000000r 2               SBC_MONITOR     = $FE0F         ; monitor prompt (or JMP $FF00)
000000r 2               SBC_PADSTATE    = $FE12         ; A = gamepad buttons held: bit0 A,1 B,2 Select,3 Start,4 Up,5 Down,6 Left,7 Right
000000r 2               SBC_LOAD        = $FE15         ; load a file: A/Y = parameter block (.word addr, .word max, "NAME.EXT",0)
000000r 2                                               ;   carry clear = loaded, X/Y = length; carry set = failed, A = error code
000000r 2               
000000r 2               ; The CPU clock in MHz (whole numbers, 1 to 8).  Programs size their delay
000000r 2               ; loops from it, so a millisecond stays a millisecond.  To build for another
000000r 2               ; clock, change it here or give it on the command line:  make.bat 1
000000r 2               .ifndef CLOCK_MHZ
000000r 2               CLOCK_MHZ       = 2
000000r 2               .endif
000000r 2               
000000r 1               
000000r 1               SPEED_DEFAULT   = 30            ; ms per frame
000000r 1               
000000r 1               ; ---- terminal --------------------------------------------------------------------
000000r 1               TC_CURSOR       = $02
000000r 1               TC_CLS          = $0C
000000r 1               TC_COL          = $0E
000000r 1               TC_ROW          = $0F
000000r 1               TC_ATTR         = $18
000000r 1               TC_LIT          = $1A
000000r 1               TC_SPR          = $1C
000000r 1               ATTR_TEXT       = $00
000000r 1               ATTR_GFX        = $80
000000r 1               TERM            = $FF
000000r 1               .define RV_ON   $1B, '[', '7', 'm'
000000r 1               .define RV_OFF  $1B, '[', '2', '7', 'm'
000000r 1               SPR_PLACE       = 2
000000r 1               SPR_MOVE        = 3
000000r 1               SPR_PIC         = 4
000000r 1               SPR_HIDE        = 6
000000r 1               
000000r 1               ; ---- the playing field (sprite pixels) ---------------------------------------------
000000r 1               X_MIN           = 2             ; inside the walls: x 2 .. 157
000000r 1               X_MAX           = 158
000000r 1               Y_MIN           = 8             ; below the top wall (text row 1)
000000r 1               BRICK_X         = 4             ; the bricks' top left
000000r 1               BRICK_Y         = 16            ;   (text row 4, column 2)
000000r 1               PAD_Y           = 87            ; the paddle's top row (3 rows)
000000r 1               BALL_TOP        = PAD_Y - 2     ; a ball on the paddle
000000r 1               PAD_NORMAL      = 16            ; widths
000000r 1               PAD_WIDE        = 24
000000r 1               PAD_STEP        = 3             ; pixels a frame
000000r 1               CAP_Y_STEP      = $C0           ; capsules fall 0.75 pixels a frame
000000r 1               SHOT_STEP       = 3
000000r 1               SERVE_FRAMES    = 100           ; a ball on the paddle goes by itself after this
000000r 1               SPEEDUP_HITS    = 12            ; bricks hit between speed-ups
000000r 1               DULL_MAX        = 6             ; paddle bounces without a brick before the angle changes
000000r 1               
000000r 1               NBALL           = 3
000000r 1               NCAP            = 2
000000r 1               NSHOT           = 4
000000r 1               SL_PAD          = 15            ; sprite slots (higher on top)
000000r 1               SL_BALL         = 12            ; 12-14
000000r 1               SL_CAP          = 10            ; 10-11
000000r 1               SL_SHOT         = 6             ; 6-9
000000r 1               NSLOT           = 16
000000r 1               
000000r 1               PW_NONE         = 0             ; paddle powers
000000r 1               PW_WIDE         = 1
000000r 1               PW_LASER        = 2
000000r 1               PW_CATCH        = 3
000000r 1               
000000r 1               ; ============================================================================
