000BE5r 1  98           @z:     tya
000BE6r 1  4C rr rr             jmp     @zz
000BE9r 1  4A           @n:     lsr                     ; (normal: A / 2)
000BEAr 1  C9 08        @zz:    cmp     #8
000BECr 1  90 02                bcc     @ok
000BEEr 1  A9 07                lda     #7
000BF0r 1  C9 04        @ok:    cmp     #4
000BF2r 1  B0 0A                bcs     @rt
000BF4r 1  9D rr rr             sta     b_ang,x         ; 0-3: to the left, 0 flat .. 3 steep
000BF7r 1  A9 01                lda     #1
000BF9r 1  9D rr rr             sta     b_sx,x
000BFCr 1  D0 0A                bne     @up
000BFEr 1  49 07        @rt:    eor     #7              ; 4-7: to the right, 7 flat .. 4 steep
000C00r 1  9D rr rr             sta     b_ang,x
000C03r 1  A9 00                lda     #0
000C05r 1  9D rr rr             sta     b_sx,x
000C08r 1  EE rr rr     @up:    inc     dull            ; no brick hit for a while: another angle,
000C0Br 1  AD rr rr             lda     dull            ; so the ball can't go round the same way
