000000r 1  4C rr rr             jmp     start
000003r 1  1E           speed:  .byte   SPEED_DEFAULT
000004r 1  01           ctrl_def:.byte  1               ; controls at start: 0 keyboard, 1 gamepad
000005r 1  00           mute_def:.byte  0               ; sound at start: 0 on, 1 off
000006r 1  00 00                .byte   0, 0
000008r 1               
000008r 1               SFX_SND         = 1             ; (sfx_snd, sfx_toggle)
000008r 1                       .include "ay/sfx.s"     ; sound on the AY-3-8910 card
000008r 2               ; ============================================================================
000008r 2               ; sfx.s - sound effects and music for games, on the AY-3-8910 card
000008r 2               ;         ($7F22 register number, $7F23 data; 2 MHz chip clock)
000008r 2               ;
000008r 2               ; Include it in a game (it finds its note table one folder up, like
000008r 2               ; sbc_api.inc:  ca65 -I ..):
000008r 2               ;           .include "ay/sfx.s"
000008r 2               ; and then
000008r 2               ;   sfx_init    once at the start (silence, the timer)
000008r 2               ;   sfx_poll    often: at least every 20 ms (the game loop, and the delay
000008r 2               ;               loops).  It runs the sound 50 times a second, timed by the
000008r 2               ;               VIA's timer 2 (polled: its interrupt stays off; timer 1 and
000008r 2               ;               the gamepad aren't touched).  Keeps A, X, Y and the flags.
000008r 2               ;   sfx_play    play script A on voice X (see below); it doesn't if that
000008r 2               ;               voice is busy with a script of higher priority
000008r 2               ;   sfx_stop    stop voice X
000008r 2               ;   sfx_off     stop everything (and silence)
000008r 2               ;   sfx_mute    0 = sound on, 1 = muted (the scripts still run, unheard)
000008r 2               ;   sfx_hush    call before waiting without sfx_poll (a pause): silences the
000008r 2               ;               card until the next tick
000008r 2               ; With SFX_SND defined before the include, also:
000008r 2               ;   sfx_snd     play script A on its own voice (sfx_prio's high 4 bits)
000008r 2               ;   sfx_toggle  sound on / off (for the M key)
000008r 2               ;
000008r 2               ; The voices: 0-2 are the background (music, a saucer's hum ...) on the
000008r 2               ; chip's channels A-C; 3-5 are the foreground on the same channels.  While
000008r 2               ; a foreground voice plays, it is heard instead of the background voice of
000008r 2               ; its channel, which carries on unheard and comes back when it stops.
000008r 2               ;
000008r 2               ; A game lists its scripts in sfx_scripts (.word address) and their
000008r 2               ; priorities in sfx_prio (.byte, higher wins), indexed by script number.
000008r 2               ;
000008r 2               ; A script is bytes, run 50 times a second until it waits:
000008r 2               ;   $80-$FF         wait 1-128 ticks (1/50 s each): $80 + ticks - 1
000008r 2               ;   $20-$7F         note 0-95 (C1 .. B8, A4 = 45): $20 + note; the
000008r 2               ;                   volume goes back to the VOL level, the decay restarts;
000008r 2               ;                   then it waits LEN ticks (if LEN isn't 0)
000008r 2               ;   SX_END          (0) the end: the voice stops
000008r 2               ;   SX_PER  lo, hi  tone period (12 bits): 2 MHz / (16 x period) Hz
000008r 2               ;   SX_VOL  v       volume 0-15 (also the level each note starts at)
000008r 2               ;   SX_NOISE n      noise period 0-31 (for the whole chip)
000008r 2               ;   SX_MIX  m       bit 0 tone on, bit 1 noise on
000008r 2               ;   SX_SWEEP lo, hi add this (signed) to the period every tick (0 = off)
000008r 2               ;   SX_DECAY d      the volume drops by 1 every d ticks (0 = holds)
000008r 2               ;   SX_LOOP c       the start of a part to play c times (0 = for ever)
000008r 2               ;   SX_NEXT         the end of that part
000008r 2               ;   SX_JUMP lo, hi  go on at another script (for music that repeats)
000008r 2               ;   SX_REST         volume 0 until the next note (and wait LEN ticks)
000008r 2               ;   SX_LEN t        notes and rests wait t ticks each from now on (music:
000008r 2               ;                   a byte a note); 0 (the start) = they don't wait
000008r 2               ; ============================================================================
000008r 2               
000008r 2               ; ---- variables (123 bytes): in the BSS, or at SFX_VARS if the game sets it
000008r 2               ;      (SMB puts them at $0100, the bottom of the stack page) ----------------
000008r 2               .ifdef SFX_VARS
000008r 2               sfx_vars        = SFX_VARS
000008r 2               sfx_lo          = sfx_vars
000008r 2               sfx_hi          = sfx_lo + 6
000008r 2               sfx_wait        = sfx_hi + 6
000008r 2               sfx_perl        = sfx_wait + 6
000008r 2               sfx_perh        = sfx_perl + 6
000008r 2               sfx_swl         = sfx_perh + 6
000008r 2               sfx_swh         = sfx_swl + 6
000008r 2               sfx_vol         = sfx_swh + 6
000008r 2               sfx_base        = sfx_vol + 6
000008r 2               sfx_dec         = sfx_base + 6
000008r 2               sfx_decc        = sfx_dec + 6
000008r 2               sfx_mix         = sfx_decc + 6
000008r 2               sfx_noise       = sfx_mix + 6
000008r 2               sfx_lpl         = sfx_noise + 6
000008r 2               sfx_lph         = sfx_lpl + 6
000008r 2               sfx_lcnt        = sfx_lph + 6
000008r 2               sfx_vprio       = sfx_lcnt + 6
000008r 2               sfx_len         = sfx_vprio + 6
000008r 2               sfx_runs        = sfx_len + 6
000008r 2               sfx_mixer       = sfx_runs + 1
000008r 2               sfx_chan        = sfx_mixer + 1
000008r 2               sfx_guard       = sfx_chan + 1
000008r 2               sfx_mute        = sfx_guard + 2
000008r 2               sfx_sa          = sfx_mute + 1
000008r 2               sfx_sx          = sfx_sa + 1
000008r 2               sfx_sy          = sfx_sx + 1
000008r 2               sfx_vars_end    = sfx_sy + 1
000008r 2               .else
000008r 2                       .segment "BSS"
000000r 2               sfx_vars:
000000r 2  xx xx xx xx  sfx_lo:     .res 6              ; script pointer (high byte 0: voice off)
000004r 2  xx xx        
000006r 2  xx xx xx xx  sfx_hi:     .res 6
00000Ar 2  xx xx        
00000Cr 2  xx xx xx xx  sfx_wait:   .res 6
000010r 2  xx xx        
000012r 2  xx xx xx xx  sfx_perl:   .res 6              ; tone period
000016r 2  xx xx        
000018r 2  xx xx xx xx  sfx_perh:   .res 6
00001Cr 2  xx xx        
00001Er 2  xx xx xx xx  sfx_swl:    .res 6              ; sweep
000022r 2  xx xx        
000024r 2  xx xx xx xx  sfx_swh:    .res 6
000028r 2  xx xx        
00002Ar 2  xx xx xx xx  sfx_vol:    .res 6
00002Er 2  xx xx        
000030r 2  xx xx xx xx  sfx_base:   .res 6              ; the volume notes start at
000034r 2  xx xx        
000036r 2  xx xx xx xx  sfx_dec:    .res 6              ; decay: ticks a step
00003Ar 2  xx xx        
00003Cr 2  xx xx xx xx  sfx_decc:   .res 6
000040r 2  xx xx        
000042r 2  xx xx xx xx  sfx_mix:    .res 6
000046r 2  xx xx        
000048r 2  xx xx xx xx  sfx_noise:  .res 6
00004Cr 2  xx xx        
00004Er 2  xx xx xx xx  sfx_lpl:    .res 6              ; loop start
000052r 2  xx xx        
000054r 2  xx xx xx xx  sfx_lph:    .res 6
000058r 2  xx xx        
00005Ar 2  xx xx xx xx  sfx_lcnt:   .res 6
00005Er 2  xx xx        
000060r 2  xx xx xx xx  sfx_vprio:  .res 6
000064r 2  xx xx        
000066r 2  xx xx xx xx  sfx_len:    .res 6              ; LEN
00006Ar 2  xx xx        
00006Cr 2  xx           sfx_runs:   .res 1
00006Dr 2  xx           sfx_mixer:  .res 1
00006Er 2  xx           sfx_chan:   .res 1
00006Fr 2  xx xx        sfx_guard:  .res 2
000071r 2  xx           sfx_mute:   .res 1
000072r 2  xx           sfx_sa:     .res 1              ; (sfx_snd)
000073r 2  xx           sfx_sx:     .res 1
000074r 2  xx           sfx_sy:     .res 1
000075r 2               sfx_vars_end:
000075r 2                       .segment "CODE"
000008r 2               .endif
000008r 2               
000008r 2               SX_END          = 0
000008r 2               SX_PER          = 1
000008r 2               SX_VOL          = 2
000008r 2               SX_NOISE        = 3
000008r 2               SX_MIX          = 4
000008r 2               SX_SWEEP        = 5
000008r 2               SX_DECAY        = 6
000008r 2               SX_LOOP         = 7
000008r 2               SX_NEXT         = 8
000008r 2               SX_JUMP         = 9
000008r 2               SX_REST         = 10
000008r 2               SX_LEN          = 11
000008r 2               .define SX_WAIT(t)  ($80 + (t) - 1)
000008r 2               .define SX_NOTE(n)  ($20 + (n))
000008r 2               
000008r 2               SFX_AY_ADDR     = $7F22
000008r 2               SFX_AY_DATA     = $7F23
000008r 2               SFX_T2CL        = $7F08
000008r 2               SFX_T2CH        = $7F09
000008r 2               SFX_ACR         = $7F0B
000008r 2               SFX_IFR         = $7F0D
000008r 2               SFX_IER         = $7F0E
000008r 2               
000008r 2               ; the timer counts a 50th of a second in SFX_RUNS runs of SFX_COUNT cycles
000008r 2               ; (it holds 16 bits)
000008r 2               SFX_CYCLES      = CLOCK_MHZ * 20000
000008r 2               SFX_RUNS        = (SFX_CYCLES + 65535) / 65536
000008r 2               SFX_COUNT       = SFX_CYCLES / SFX_RUNS - 2
000008r 2               
000008r 2               ; ---- the routines ------------------------------------------------------------------------
000008r 2               sfx_init:
000008r 2  A9 00                lda     #0
00000Ar 2  A2 74                ldx     #sfx_vars_end - sfx_vars - 1
00000Cr 2  9D rr rr     @c:     sta     sfx_vars,x
00000Fr 2  CA                   dex
000010r 2  10 FA                bpl     @c
000012r 2  AD 0B 7F             lda     SFX_ACR         ; timer 2: one shot, its interrupt off
000015r 2  29 DF                and     #$DF
000017r 2  8D 0B 7F             sta     SFX_ACR
00001Ar 2  A9 20                lda     #$20
00001Cr 2  8D 0E 7F             sta     SFX_IER
00001Fr 2  A9 01                lda     #SFX_RUNS
000021r 2  8D rr rr             sta     sfx_runs
000024r 2  A9 3E                lda     #<SFX_COUNT
000026r 2  8D 08 7F             sta     SFX_T2CL
000029r 2  A9 9C                lda     #>SFX_COUNT
00002Br 2  8D 09 7F             sta     SFX_T2CH
00002Er 2                       ; (on into sfx_off)
00002Er 2               
00002Er 2               ; stop every voice, silence
00002Er 2               sfx_off:
00002Er 2  48                   pha
00002Fr 2  8A                   txa
000030r 2  48                   pha
000031r 2  A2 05                ldx     #5
000033r 2  A9 00                lda     #0
000035r 2  9D rr rr     @v:     sta     sfx_hi,x
000038r 2  CA                   dex
000039r 2  10 FA                bpl     @v
00003Br 2  68                   pla
00003Cr 2  AA                   tax
00003Dr 2  68                   pla
00003Er 2                       ; (on into sfx_hush)
00003Er 2               
00003Er 2               ; silence the card (until the next tick).  Keeps A, X, Y.
00003Er 2               sfx_hush:
00003Er 2  48                   pha
00003Fr 2  8A                   txa
000040r 2  48                   pha
000041r 2  A9 07                lda     #7              ; mixer: all off
000043r 2  8D 22 7F             sta     SFX_AY_ADDR
000046r 2  A9 3F                lda     #$3F
000048r 2  8D 23 7F             sta     SFX_AY_DATA
00004Br 2  A2 08                ldx     #8              ; volumes 0
00004Dr 2  A9 00                lda     #0
00004Fr 2  8E 22 7F     @v:     stx     SFX_AY_ADDR
000052r 2  8D 23 7F             sta     SFX_AY_DATA
000055r 2  E8                   inx
000056r 2  E0 0B                cpx     #11
000058r 2  D0 F5                bne     @v
00005Ar 2  68                   pla
00005Br 2  AA                   tax
00005Cr 2  68                   pla
00005Dr 2  60                   rts
00005Er 2               
00005Er 2               ; stop voice X
00005Er 2               sfx_stop:
00005Er 2  48                   pha
00005Fr 2  A9 00                lda     #0
000061r 2  9D rr rr             sta     sfx_hi,x
000064r 2  68                   pla
000065r 2  60                   rts
000066r 2               
000066r 2               ; play script A on voice X (0-5); not if the voice is playing a script of
000066r 2               ; higher priority.  Keeps X.
000066r 2               sfx_play:
000066r 2  A8                   tay
000067r 2  BD rr rr             lda     sfx_hi,x
00006Ar 2  F0 09                beq     @go
00006Cr 2  B9 rr rr             lda     sfx_prio,y
00006Fr 2  DD rr rr             cmp     sfx_vprio,x
000072r 2  B0 01                bcs     @go
000074r 2  60                   rts
000075r 2  B9 rr rr     @go:    lda     sfx_prio,y
000078r 2  9D rr rr             sta     sfx_vprio,x
00007Br 2  98                   tya
00007Cr 2  0A                   asl
00007Dr 2  A8                   tay
00007Er 2  B9 rr rr             lda     sfx_scripts,y
000081r 2  9D rr rr             sta     sfx_lo,x
000084r 2  B9 rr rr             lda     sfx_scripts+1,y
000087r 2  9D rr rr             sta     sfx_hi,x
00008Ar 2  A9 00                lda     #0
00008Cr 2  9D rr rr             sta     sfx_wait,x
00008Fr 2  9D rr rr             sta     sfx_swl,x
000092r 2  9D rr rr             sta     sfx_swh,x
000095r 2  9D rr rr             sta     sfx_dec,x
000098r 2  9D rr rr             sta     sfx_perl,x
00009Br 2  9D rr rr             sta     sfx_perh,x
00009Er 2  9D rr rr             sta     sfx_len,x
0000A1r 2  A9 0F                lda     #15
0000A3r 2  9D rr rr             sta     sfx_base,x
0000A6r 2  9D rr rr             sta     sfx_vol,x
0000A9r 2  A9 01                lda     #1              ; tone on, noise off
0000ABr 2  9D rr rr             sta     sfx_mix,x
0000AEr 2  60                   rts
0000AFr 2               
0000AFr 2               ; run the sound if a tick has come.  Keeps A, X, Y and the flags (so it can
0000AFr 2               ; go anywhere: in putc, in a loop ...)
0000AFr 2               sfx_poll:
0000AFr 2  08                   php
0000B0r 2  48                   pha
0000B1r 2  AD 0D 7F             lda     SFX_IFR
0000B4r 2  29 20                and     #$20
0000B6r 2  D0 03                bne     @t
0000B8r 2  68                   pla
0000B9r 2  28                   plp
0000BAr 2  60                   rts
0000BBr 2  8A           @t:     txa
0000BCr 2  48                   pha
0000BDr 2  98                   tya
0000BEr 2  48                   pha
0000BFr 2                       ; the timer has gone on counting down past 0 ($FFFF, $FFFE ...): how
0000BFr 2                       ; late this call is.  The next run is that much shorter, so the beat
0000BFr 2                       ; keeps time however long the game takes between calls.
0000BFr 2  AE 09 7F     @rd:    ldx     SFX_T2CH
0000C2r 2  AD 08 7F             lda     SFX_T2CL
0000C5r 2  EC 09 7F             cpx     SFX_T2CH        ; (the high byte changed in between: again)
0000C8r 2  D0 F5                bne     @rd
0000CAr 2  38                   sec
0000CBr 2  69 22                adc     #<(SFX_COUNT - SFX_FIX)
0000CDr 2  A8                   tay
0000CEr 2  8A                   txa
0000CFr 2  69 9C                adc     #>(SFX_COUNT - SFX_FIX)
0000D1r 2  B0 04                bcs     @set
0000D3r 2  A0 64                ldy     #100            ; (more than a whole run late: soon)
0000D5r 2  A9 00                lda     #0
0000D7r 2  8C 08 7F     @set:   sty     SFX_T2CL
0000DAr 2  8D 09 7F             sta     SFX_T2CH
0000DDr 2  CE rr rr             dec     sfx_runs
0000E0r 2  D0 08                bne     @r
0000E2r 2  A9 01                lda     #SFX_RUNS
0000E4r 2  8D rr rr             sta     sfx_runs
0000E7r 2  20 rr rr             jsr     sfx_tick
0000EAr 2  68           @r:     pla
0000EBr 2  A8                   tay
0000ECr 2  68                   pla
0000EDr 2  AA                   tax
0000EEr 2  68                   pla
0000EFr 2  28                   plp
0000F0r 2  60                   rts
0000F1r 2               SFX_FIX = 28                    ; cycles from reading the timer to starting it
0000F1r 2               
0000F1r 2               .ifdef SFX_SND
0000F1r 2               ; ---- (with SFX_SND defined) ---------------------------------------------------
0000F1r 2               ; play script A on its own voice: the high 4 bits of its sfx_prio byte (the
0000F1r 2               ; low 4 are its priority).  Keeps A, X and Y.
0000F1r 2               sfx_snd:
0000F1r 2  8D rr rr             sta     sfx_sa
0000F4r 2  8E rr rr             stx     sfx_sx
0000F7r 2  8C rr rr             sty     sfx_sy
0000FAr 2  A8                   tay
0000FBr 2  B9 rr rr             lda     sfx_prio,y
0000FEr 2  4A                   lsr
0000FFr 2  4A                   lsr
000100r 2  4A                   lsr
000101r 2  4A                   lsr
000102r 2  AA                   tax
000103r 2  98                   tya
000104r 2  20 rr rr             jsr     sfx_play
000107r 2  AD rr rr             lda     sfx_sa
00010Ar 2  AE rr rr             ldx     sfx_sx
00010Dr 2  AC rr rr             ldy     sfx_sy
000110r 2  60                   rts
000111r 2               
000111r 2               ; sound on / off (the M key).  Keeps X and Y.
000111r 2               sfx_toggle:
000111r 2  AD rr rr             lda     sfx_mute
000114r 2  49 01                eor     #1
000116r 2  8D rr rr             sta     sfx_mute
000119r 2  4C rr rr             jmp     sfx_hush
00011Cr 2               .endif
00011Cr 2               
00011Cr 2               ; ---- a tick: every voice a step, then the card ---------------------------------------------
00011Cr 2               sfx_tick:
00011Cr 2  A2 05                ldx     #5
00011Er 2  BD rr rr     @v:     lda     sfx_hi,x
000121r 2  F0 03                beq     @n
000123r 2  20 rr rr             jsr     sfx_voice
000126r 2  CA           @n:     dex
000127r 2  10 F5                bpl     @v
000129r 2                       ; the card: each channel hears its foreground voice if that plays,
000129r 2                       ; else its background voice
000129r 2  A9 3F                lda     #$3F
00012Br 2  8D rr rr             sta     sfx_mixer
00012Er 2  A2 02                ldx     #2
000130r 2  8E rr rr     @ch:    stx     sfx_chan
000133r 2  8A                   txa
000134r 2  18                   clc
000135r 2  69 03                adc     #3
000137r 2  A8                   tay                     ; foreground voice
000138r 2  B9 rr rr             lda     sfx_hi,y
00013Br 2  D0 0C                bne     @have
00013Dr 2  AC rr rr             ldy     sfx_chan        ; background voice
000140r 2  B9 rr rr             lda     sfx_hi,y
000143r 2  D0 04                bne     @have
000145r 2  A9 00                lda     #0              ; neither: silent
000147r 2  F0 4E                beq     @vol
000149r 2  8A           @have:  txa                     ; the tone period
00014Ar 2  0A                   asl
00014Br 2  8D 22 7F             sta     SFX_AY_ADDR
00014Er 2  B9 rr rr             lda     sfx_perl,y
000151r 2  8D 23 7F             sta     SFX_AY_DATA
000154r 2  8A                   txa
000155r 2  0A                   asl
000156r 2  09 01                ora     #1
000158r 2  8D 22 7F             sta     SFX_AY_ADDR
00015Br 2  B9 rr rr             lda     sfx_perh,y
00015Er 2  29 0F                and     #$0F
000160r 2  8D 23 7F             sta     SFX_AY_DATA
000163r 2  B9 rr rr             lda     sfx_mix,y       ; the mixer bits (0 = on)
000166r 2  4A                   lsr
000167r 2  90 09                bcc     @nt
000169r 2  BD rr rr             lda     sfx_tone_on,x
00016Cr 2  2D rr rr             and     sfx_mixer
00016Fr 2  8D rr rr             sta     sfx_mixer
000172r 2  B9 rr rr     @nt:    lda     sfx_mix,y
000175r 2  29 02                and     #2
000177r 2  F0 14                beq     @nn
000179r 2  BD rr rr             lda     sfx_noise_on,x
00017Cr 2  2D rr rr             and     sfx_mixer
00017Fr 2  8D rr rr             sta     sfx_mixer
000182r 2  A9 06                lda     #6
000184r 2  8D 22 7F             sta     SFX_AY_ADDR
000187r 2  B9 rr rr             lda     sfx_noise,y
00018Ar 2  8D 23 7F             sta     SFX_AY_DATA
00018Dr 2  B9 rr rr     @nn:    lda     sfx_vol,y
000190r 2  AC rr rr             ldy     sfx_mute
000193r 2  F0 02                beq     @vol
000195r 2  A9 00                lda     #0
000197r 2  AC rr rr     @vol:   ldy     sfx_chan
00019Ar 2  AA                   tax
00019Br 2  98                   tya
00019Cr 2  18                   clc
00019Dr 2  69 08                adc     #8
00019Fr 2  8D 22 7F             sta     SFX_AY_ADDR
0001A2r 2  8E 23 7F             stx     SFX_AY_DATA
0001A5r 2  AE rr rr             ldx     sfx_chan
0001A8r 2  CA                   dex
0001A9r 2  10 85                bpl     @ch
0001ABr 2  A9 07                lda     #7
0001ADr 2  8D 22 7F             sta     SFX_AY_ADDR
0001B0r 2  AD rr rr             lda     sfx_mixer
0001B3r 2  8D 23 7F             sta     SFX_AY_DATA
0001B6r 2  60                   rts
0001B7r 2  3E 3D 3B     sfx_tone_on:    .byte   $3E, $3D, $3B
0001BAr 2  37 2F 1F     sfx_noise_on:   .byte   $37, $2F, $1F
0001BDr 2               
0001BDr 2               ; one voice (X): the sweep and the decay, then the script when its wait
0001BDr 2               ; is over
0001BDr 2               sfx_voice:
0001BDr 2  BD rr rr             lda     sfx_swl,x       ; the sweep
0001C0r 2  1D rr rr             ora     sfx_swh,x
0001C3r 2  F0 13                beq     @ns
0001C5r 2  BD rr rr             lda     sfx_perl,x
0001C8r 2  18                   clc
0001C9r 2  7D rr rr             adc     sfx_swl,x
0001CCr 2  9D rr rr             sta     sfx_perl,x
0001CFr 2  BD rr rr             lda     sfx_perh,x
0001D2r 2  7D rr rr             adc     sfx_swh,x
0001D5r 2  9D rr rr             sta     sfx_perh,x
0001D8r 2  BD rr rr     @ns:    lda     sfx_dec,x       ; the decay
0001DBr 2  F0 10                beq     @nd
0001DDr 2  DE rr rr             dec     sfx_decc,x
0001E0r 2  D0 0B                bne     @nd
0001E2r 2  9D rr rr             sta     sfx_decc,x
0001E5r 2  BD rr rr             lda     sfx_vol,x
0001E8r 2  F0 03                beq     @nd
0001EAr 2  DE rr rr             dec     sfx_vol,x
0001EDr 2  BD rr rr     @nd:    lda     sfx_wait,x
0001F0r 2  F0 06                beq     @run
0001F2r 2  DE rr rr             dec     sfx_wait,x
0001F5r 2  F0 01                beq     @run
0001F7r 2  60                   rts
0001F8r 2  A9 28        @run:   lda     #40             ; (at most 40 commands a tick: a script that
0001FAr 2  8D rr rr             sta     sfx_guard       ;  never waits can't hang the game)
0001FDr 2  CE rr rr     @cmd:   dec     sfx_guard
000200r 2  F0 76                beq     @stop
000202r 2  20 rr rr             jsr     sfx_byte
000205r 2  C9 80                cmp     #$80
000207r 2  90 09                bcc     @nw
000209r 2  29 7F                and     #$7F            ; wait
00020Br 2  9D rr rr             sta     sfx_wait,x
00020Er 2  FE rr rr             inc     sfx_wait,x
000211r 2  60                   rts
000212r 2  C9 20        @nw:    cmp     #$20
000214r 2  90 54                bcc     @op
000216r 2  38                   sec                     ; a note
000217r 2  E9 20                sbc     #$20
000219r 2  C9 60                cmp     #96
00021Br 2  90 02                bcc     @nt
00021Dr 2  A9 5F                lda     #95
00021Fr 2  A0 00        @nt:    ldy     #0              ; octave Y, note A in it
000221r 2  C9 0C        @oc:    cmp     #12
000223r 2  90 05                bcc     @ok
000225r 2  E9 0C                sbc     #12
000227r 2  C8                   iny
000228r 2  D0 F7                bne     @oc
00022Ar 2  8C rr rr     @ok:    sty     sfx_guard+1     ; (as a count)
00022Dr 2  A8                   tay
00022Er 2  B9 rr rr             lda     sfx_c1_lo,y     ; the period in octave 1, halved for each
000231r 2  9D rr rr             sta     sfx_perl,x      ; octave up
000234r 2  B9 rr rr             lda     sfx_c1_hi,y
000237r 2  AC rr rr             ldy     sfx_guard+1
00023Ar 2  F0 16                beq     @p
00023Cr 2  4A           @sh:    lsr
00023Dr 2  7E rr rr             ror     sfx_perl,x
000240r 2  88                   dey
000241r 2  D0 F9                bne     @sh
000243r 2  9D rr rr             sta     sfx_perh,x      ; (rounded: the last bit out was a half)
000246r 2  90 0D                bcc     @r0
000248r 2  FE rr rr             inc     sfx_perl,x
00024Br 2  D0 08                bne     @r0
00024Dr 2  FE rr rr             inc     sfx_perh,x
000250r 2  D0 03                bne     @r0
000252r 2  9D rr rr     @p:     sta     sfx_perh,x
000255r 2               @r0:
000255r 2  BD rr rr             lda     sfx_base,x
000258r 2  9D rr rr             sta     sfx_vol,x
00025Br 2  BD rr rr             lda     sfx_dec,x
00025Er 2  9D rr rr             sta     sfx_decc,x
000261r 2  BD rr rr     @len:   lda     sfx_len,x       ; (LEN: wait that long)
000264r 2  F0 97                beq     @cmd
000266r 2  9D rr rr             sta     sfx_wait,x
000269r 2  60                   rts
00026Ar 2  C9 0C        @op:    cmp     #12
00026Cr 2  B0 0A                bcs     @stop
00026Er 2  A8                   tay
00026Fr 2  B9 rr rr             lda     @hi,y
000272r 2  48                   pha
000273r 2  B9 rr rr             lda     @lo,y
000276r 2  48                   pha
000277r 2  60                   rts                     ; (to the command, which goes back to @cmd)
000278r 2  A9 00        @stop:  lda     #0
00027Ar 2  9D rr rr             sta     sfx_hi,x
00027Dr 2  9D rr rr             sta     sfx_vol,x
000280r 2  60                   rts
000281r 2  rr rr rr rr  @lo:    .lobytes  @stop-1, @per-1, @vl-1, @noi-1, @mix-1, @sw-1, @dc-1, @lp-1, @nx-1, @jp-1, @rest-1, @ln-1
000285r 2  rr rr rr rr  
000289r 2  rr rr rr rr  
00028Dr 2  rr rr rr rr  @hi:    .hibytes  @stop-1, @per-1, @vl-1, @noi-1, @mix-1, @sw-1, @dc-1, @lp-1, @nx-1, @jp-1, @rest-1, @ln-1
000291r 2  rr rr rr rr  
000295r 2  rr rr rr rr  
000299r 2  20 rr rr     @per:   jsr     sfx_byte
00029Cr 2  9D rr rr             sta     sfx_perl,x
00029Fr 2  20 rr rr             jsr     sfx_byte
0002A2r 2  9D rr rr             sta     sfx_perh,x
0002A5r 2  4C rr rr             jmp     @cmd
0002A8r 2  20 rr rr     @vl:    jsr     sfx_byte
0002ABr 2  9D rr rr             sta     sfx_base,x
0002AEr 2  9D rr rr             sta     sfx_vol,x
0002B1r 2  BD rr rr             lda     sfx_dec,x
0002B4r 2  9D rr rr             sta     sfx_decc,x
0002B7r 2  4C rr rr             jmp     @cmd
0002BAr 2  20 rr rr     @noi:   jsr     sfx_byte
0002BDr 2  9D rr rr             sta     sfx_noise,x
0002C0r 2  4C rr rr             jmp     @cmd
0002C3r 2  20 rr rr     @mix:   jsr     sfx_byte
0002C6r 2  9D rr rr             sta     sfx_mix,x
0002C9r 2  4C rr rr             jmp     @cmd
0002CCr 2  20 rr rr     @sw:    jsr     sfx_byte
0002CFr 2  9D rr rr             sta     sfx_swl,x
0002D2r 2  20 rr rr             jsr     sfx_byte
0002D5r 2  9D rr rr             sta     sfx_swh,x
0002D8r 2  4C rr rr             jmp     @cmd
0002DBr 2  20 rr rr     @dc:    jsr     sfx_byte
0002DEr 2  9D rr rr             sta     sfx_dec,x
0002E1r 2  9D rr rr             sta     sfx_decc,x
0002E4r 2  4C rr rr             jmp     @cmd
0002E7r 2  20 rr rr     @lp:    jsr     sfx_byte
0002EAr 2  9D rr rr             sta     sfx_lcnt,x
0002EDr 2  BD rr rr             lda     sfx_lo,x
0002F0r 2  9D rr rr             sta     sfx_lpl,x
0002F3r 2  BD rr rr             lda     sfx_hi,x
0002F6r 2  9D rr rr             sta     sfx_lph,x
0002F9r 2  4C rr rr             jmp     @cmd
0002FCr 2  BD rr rr     @nx:    lda     sfx_lcnt,x
0002FFr 2  F0 05                beq     @back           ; (0: for ever)
000301r 2  DE rr rr             dec     sfx_lcnt,x
000304r 2  F0 0C                beq     @go
000306r 2  BD rr rr     @back:  lda     sfx_lpl,x
000309r 2  9D rr rr             sta     sfx_lo,x
00030Cr 2  BD rr rr             lda     sfx_lph,x
00030Fr 2  9D rr rr             sta     sfx_hi,x
000312r 2  4C rr rr     @go:    jmp     @cmd
000315r 2  20 rr rr     @jp:    jsr     sfx_byte
000318r 2  48                   pha
000319r 2  20 rr rr             jsr     sfx_byte
00031Cr 2  9D rr rr             sta     sfx_hi,x
00031Fr 2  68                   pla
000320r 2  9D rr rr             sta     sfx_lo,x
000323r 2  4C rr rr             jmp     @cmd
000326r 2  A9 00        @rest:  lda     #0
000328r 2  9D rr rr             sta     sfx_vol,x
00032Br 2  4C rr rr             jmp     @len
00032Er 2  20 rr rr     @ln:    jsr     sfx_byte
000331r 2  9D rr rr             sta     sfx_len,x
000334r 2  4C rr rr             jmp     @cmd
000337r 2               
000337r 2               ; the next byte of voice X's script
000337r 2               sfx_byte:
000337r 2  BD rr rr             lda     sfx_lo,x
00033Ar 2  8D rr rr             sta     @ld+1
00033Dr 2  BD rr rr             lda     sfx_hi,x
000340r 2  8D rr rr             sta     @ld+2
000343r 2  AD FF FF     @ld:    lda     $FFFF
000346r 2  FE rr rr             inc     sfx_lo,x
000349r 2  D0 03                bne     @r
00034Br 2  FE rr rr             inc     sfx_hi,x
00034Er 2  60           @r:     rts
00034Fr 2               
00034Fr 2               ; the tone periods of C1 .. B1 for the 2 MHz chip clock: 2 MHz / (16 x
00034Fr 2               ; frequency); each octave up is half (to within a third of a percent)
00034Fr 2  EE 18 4D 8E  sfx_c1_lo:  .lobytes 3822, 3608, 3405, 3214, 3034, 2863, 2703, 2551, 2408, 2273, 2145, 2025
000353r 2  DA 2F 8F F7  
000357r 2  68 E1 61 E9  
00035Br 2  0E 0E 0D 0C  sfx_c1_hi:  .hibytes 3822, 3608, 3405, 3214, 3034, 2863, 2703, 2551, 2408, 2273, 2145, 2025
00035Fr 2  0B 0B 0A 09  
000363r 2  09 08 08 07  
000367r 2               
000367r 2               
000367r 1               
000367r 1               ; ----------------------------------------------------------------------------
000367r 1               ; I/O helpers
000367r 1               ; ----------------------------------------------------------------------------
000367r 1               ; carry set = key in A.  After IDENTIFY (1C 0C) the terminal answers S P 1:
000367r 1               ; those are taken as its answer (rp_got), not as keys, until the 1 comes or
000367r 1               ; the next IDENTIFY.  (Keys come in lower case; any one of the three will do.)
000367r 1  20 00 FE     getc:   jsr     SBC_CHRIN
00036Ar 1  90 24                bcc     @r
00036Cr 1  48                   pha
00036Dr 1  AD rr rr             lda     rp_on
000370r 1  F0 1C                beq     @key
000372r 1  68                   pla
000373r 1  C9 53                cmp     #'S'
000375r 1  F0 0D                beq     @rep
000377r 1  C9 50                cmp     #'P'
000379r 1  F0 09                beq     @rep
00037Br 1  C9 31                cmp     #'1'
00037Dr 1  D0 0D                bne     @k2
00037Fr 1  A9 00                lda     #0
000381r 1  8D rr rr             sta     rp_on
000384r 1  A9 01        @rep:   lda     #1
000386r 1  8D rr rr             sta     rp_got
000389r 1  4C rr rr             jmp     getc
00038Cr 1  38           @k2:    sec
00038Dr 1  60                   rts
00038Er 1  68           @key:   pla
00038Fr 1  38                   sec
000390r 1  60           @r:     rts
000391r 1               
000391r 1               ; send A (counts the bytes, for the frame timing).  Preserves A, X, Y.
000391r 1  EE rr rr     putc:   inc     nbytes
000394r 1  D0 03                bne     @p
000396r 1  EE rr rr             inc     nbytes+1
000399r 1  20 rr rr     @p:     jsr     sfx_poll        ; (the sound goes on while drawing)
00039Cr 1  4C 03 FE             jmp     SBC_CHROUT
00039Fr 1               
00039Fr 1               ; cursor to column X, row Y.  Preserves X and Y.
00039Fr 1  A9 0F        gotoxy: lda     #TC_ROW
0003A1r 1  20 rr rr             jsr     putc
0003A4r 1  98                   tya
0003A5r 1  20 rr rr             jsr     putc
0003A8r 1  A9 0E                lda     #TC_COL
0003AAr 1  20 rr rr             jsr     putc
0003ADr 1  8A                   txa
0003AEr 1  4C rr rr             jmp     putc
0003B1r 1               
0003B1r 1               txt_mode:
0003B1r 1  A9 00                lda     #ATTR_TEXT
0003B3r 1  F0 02                beq     setattr
0003B5r 1               gfx_mode:
0003B5r 1  A9 80                lda     #ATTR_GFX
0003B7r 1  CD rr rr     setattr:cmp     attr
0003BAr 1  F0 0D                beq     @r
0003BCr 1  8D rr rr             sta     attr
0003BFr 1  48                   pha
0003C0r 1  A9 18                lda     #TC_ATTR
0003C2r 1  20 rr rr             jsr     putc
0003C5r 1  68                   pla
0003C6r 1  4C rr rr             jmp     putc
0003C9r 1  60           @r:     rts
0003CAr 1               
0003CAr 1               ; a block graphics character (00-1F and 7F need the 1A prefix)
0003CAr 1  C9 20        putblk: cmp     #$20
0003CCr 1  90 04                bcc     @lit
0003CEr 1  C9 7F                cmp     #$7F
0003D0r 1  D0 07                bne     @out
0003D2r 1  48           @lit:   pha
0003D3r 1  A9 1A                lda     #TC_LIT
0003D5r 1  20 rr rr             jsr     putc
0003D8r 1  68                   pla
0003D9r 1  4C rr rr     @out:   jmp     putc
0003DCr 1               
0003DCr 1               ; print the string at A (lo) / Y (hi), ended by TERM (any length)
0003DCr 1  8D rr rr     print:  sta     @ld+1
0003DFr 1  8C rr rr             sty     @ld+2
0003E2r 1  AD FF FF     @ld:    lda     $FFFF
0003E5r 1  C9 FF                cmp     #TERM
0003E7r 1  F0 0D                beq     @done
0003E9r 1  20 rr rr             jsr     putc
0003ECr 1  EE rr rr             inc     @ld+1
0003EFr 1  D0 F1                bne     @ld
0003F1r 1  EE rr rr             inc     @ld+2
0003F4r 1  D0 EC                bne     @ld
0003F6r 1  A9 FF        @done:  lda     #$FF            ; (strings may change the attribute)
0003F8r 1  8D rr rr             sta     attr
0003FBr 1  60                   rts
0003FCr 1               
0003FCr 1               ; print A as two BCD digits
0003FCr 1  48           prbcd:  pha
0003FDr 1  4A                   lsr
0003FEr 1  4A                   lsr
0003FFr 1  4A                   lsr
000400r 1  4A                   lsr
000401r 1  09 30                ora     #'0'
000403r 1  20 rr rr             jsr     putc
000406r 1  68                   pla
000407r 1  29 0F                and     #$0F
000409r 1  09 30                ora     #'0'
00040Br 1  4C rr rr             jmp     putc
00040Er 1               
00040Er 1               ; print A (0-99) as two decimal digits
00040Er 1  A2 30        prdec2: ldx     #'0'
000410r 1  C9 0A        @t:     cmp     #10
000412r 1  90 05                bcc     @u
000414r 1  E9 0A                sbc     #10
000416r 1  E8                   inx
000417r 1  D0 F7                bne     @t
000419r 1  48           @u:     pha
00041Ar 1  8A                   txa
00041Br 1  20 rr rr             jsr     putc
00041Er 1  68                   pla
00041Fr 1  09 30                ora     #'0'
000421r 1  4C rr rr             jmp     putc
000424r 1               
000424r 1               ; 16 bit Galois LFSR.  A = a random byte.  Preserves X and Y.
000424r 1  AD rr rr     rand:   lda     rng+1
000427r 1  4A                   lsr
000428r 1  6E rr rr             ror     rng
00042Br 1  90 02                bcc     @n
00042Dr 1  49 B4                eor     #$B4
00042Fr 1  8D rr rr     @n:     sta     rng+1
000432r 1  4D rr rr             eor     rng
000435r 1  60                   rts
000436r 1               
000436r 1               ; wait about A ms.  The inner loop is sized for the clock (CLOCK_MHZ in
000436r 1               ; sbc_api.inc): 5 + 4 * (CLOCK_MHZ - 1) cycles a turn, DELAY_N turns a ms.
000436r 1               DELAY_N = (1000 * CLOCK_MHZ - 7) / (5 + 4 * (CLOCK_MHZ - 1))
000436r 1               delay_ms:
000436r 1  AA                   tax
000437r 1  F0 0D                beq     @done
000439r 1  20 rr rr     @o:     jsr     sfx_poll        ; (and while waiting)
00043Cr 1  A0 DD                ldy     #DELAY_N
00043Er 1               @i:
00043Er 1  EA EA        .repeat CLOCK_MHZ - 1
000440r 1                       nop
000440r 1                       nop
000440r 1               .endrepeat
000440r 1  88                   dey
000441r 1  D0 FB                bne     @i
000443r 1  CA                   dex
000444r 1  D0 F3                bne     @o
000446r 1  60           @done:  rts
000447r 1               
000447r 1               ; wait about A x 50 ms, dropping keys pressed meanwhile
000447r 1               delay_long:
000447r 1  8D rr rr             sta     tmp
00044Ar 1  A9 32        @l:     lda     #50
00044Cr 1  20 rr rr             jsr     delay_ms
00044Fr 1  20 rr rr             jsr     flush_in
000452r 1  CE rr rr             dec     tmp
000455r 1  D0 F3                bne     @l
000457r 1  60                   rts
000458r 1               
000458r 1               .macro MENU_IDLE
000458r 1                       jsr     rand            ; (waiting stirs the random numbers)
000458r 1                       jsr     sfx_poll
000458r 1               .endmacro
000458r 1               CTRL_COL        = 19
000458r 1               CTRL_ROW        = 21
000458r 1               
000458r 1               ; ============================================================================
000458r 1               ; gamepad and menu input (shared by the SBC games)
000458r 1               ; ============================================================================
000458r 1               PAD_A           = $01           ; bits returned by SBC_PADSTATE
000458r 1               PAD_B           = $02
000458r 1               PAD_SELECT      = $04
000458r 1               PAD_START       = $08
000458r 1               PAD_UP          = $10
000458r 1               PAD_DOWN        = $20
000458r 1               PAD_LEFT        = $40
000458r 1               PAD_RIGHT       = $80
000458r 1               PAD_GO          = $80           ; menu_key's answer for gamepad A or Start
000458r 1               
000458r 1               ; read the gamepad: pad = buttons held now, padnew = buttons pressed since
000458r 1               ; the last call.  Preserves X and Y (SBC_PADSTATE only changes A).
000458r 1               read_pad:
000458r 1  20 12 FE             jsr     SBC_PADSTATE
00045Br 1  C9 FF                cmp     #$FF            ; every button "pressed" = no pad
00045Dr 1  D0 02                bne     @ok
00045Fr 1  A9 00                lda     #0
000461r 1  8D rr rr     @ok:    sta     pad
000464r 1  AD rr rr             lda     padold
000467r 1  49 FF                eor     #$FF
000469r 1  2D rr rr             and     pad
00046Cr 1  8D rr rr             sta     padnew
00046Fr 1  AD rr rr             lda     pad
000472r 1  8D rr rr             sta     padold
000475r 1  60                   rts
000476r 1               
000476r 1               ; throw away waiting characters
000476r 1               flush_in:
000476r 1  20 rr rr             jsr     getc
000479r 1  B0 FB                bcs     flush_in
00047Br 1  60                   rts
00047Cr 1               
00047Cr 1               ; carry set if A is one of the characters the gamepad driver types for the
00047Cr 1               ; pad (W A S D and space).  Those are ignored in gamepad mode so that one
00047Cr 1               ; press doesn't act twice.  Preserves A.
00047Cr 1               pad_typed:
00047Cr 1  C9 20                cmp     #' '
00047Er 1  F0 12                beq     @y
000480r 1  C9 57                cmp     #'W'
000482r 1  F0 0E                beq     @y
000484r 1  C9 41                cmp     #'A'
000486r 1  F0 0A                beq     @y
000488r 1  C9 53                cmp     #'S'
00048Ar 1  F0 06                beq     @y
00048Cr 1  C9 44                cmp     #'D'
00048Er 1  F0 02                beq     @y
000490r 1  18                   clc
000491r 1  60                   rts
000492r 1  38           @y:     sec
000493r 1  60                   rts
000494r 1               
000494r 1               ; wait for a menu choice.  Returns a key (letters in upper case), or
000494r 1               ; PAD_GO for the gamepad's A or Start button.
000494r 1               menu_key:
000494r 1  20 rr rr 20  @l:     MENU_IDLE
000498r 1  rr rr        
00049Ar 1  20 rr rr             jsr     read_pad
00049Dr 1  AD rr rr             lda     padnew
0004A0r 1  29 09                and     #PAD_A | PAD_START
0004A2r 1  D0 21                bne     @pad
0004A4r 1  20 rr rr             jsr     getc
0004A7r 1  90 EB                bcc     @l
0004A9r 1  C9 20                cmp     #' '            ; a space typed by the pad's A button?
0004ABr 1  D0 0D                bne     @up
0004ADr 1  20 rr rr             jsr     read_pad
0004B0r 1  AD rr rr             lda     pad
0004B3r 1  29 01                and     #PAD_A
0004B5r 1  D0 0E                bne     @pad
0004B7r 1  A9 20                lda     #' '
0004B9r 1  60                   rts
0004BAr 1  C9 61        @up:    cmp     #'a'
0004BCr 1  90 06                bcc     @r
0004BEr 1  C9 7B                cmp     #'z'+1
0004C0r 1  B0 02                bcs     @r
0004C2r 1  29 DF                and     #$DF
0004C4r 1  60           @r:     rts
0004C5r 1  20 rr rr     @pad:   jsr     flush_in        ; the space the driver typed for it
0004C8r 1  A9 80                lda     #PAD_GO
0004CAr 1  60                   rts
0004CBr 1               
0004CBr 1               ; print the controls line (CTRL_COL, CTRL_ROW)
0004CBr 1               show_ctrl:
0004CBr 1  20 rr rr             jsr     txt_mode
0004CEr 1  A2 13                ldx     #CTRL_COL
0004D0r 1  A0 15                ldy     #CTRL_ROW
0004D2r 1  20 rr rr             jsr     gotoxy
0004D5r 1  AD rr rr             lda     ctrl
0004D8r 1  F0 07                beq     @kb
0004DAr 1  A9 rr                lda     #<ctrl_pad_txt
0004DCr 1  A0 rr                ldy     #>ctrl_pad_txt
0004DEr 1  4C rr rr             jmp     print
0004E1r 1  A9 rr        @kb:    lda     #<ctrl_kb_txt
0004E3r 1  A0 rr                ldy     #>ctrl_kb_txt
0004E5r 1  4C rr rr             jmp     print
0004E8r 1               
0004E8r 1               ; ============================================================================
0004E8r 1               ; start, title
0004E8r 1               ; ============================================================================
0004E8r 1  D8           start:  cld
0004E9r 1  A2 FF                ldx     #$FF
0004EBr 1  9A                   txs
0004ECr 1  A9 00                lda     #0              ; clear the variables (RAM is random at power-up)
0004EEr 1  AA                   tax
0004EFr 1  A0 02                ldy     #>(bss_end - bss_start + $FF)
0004F1r 1  9D rr rr     @c1:    sta     bss_start,x
0004F4r 1  E8                   inx
0004F5r 1  D0 FA                bne     @c1
0004F7r 1  EE rr rr             inc     @c1+2
0004FAr 1  88                   dey
0004FBr 1  D0 F4                bne     @c1
0004FDr 1  AD rr rr             lda     ctrl_def
000500r 1  8D rr rr             sta     ctrl
000503r 1  A9 5A                lda     #$5A
000505r 1  8D rr rr             sta     rng
000508r 1  A9 FF                lda     #$FF
00050Ar 1  8D rr rr             sta     attr
00050Dr 1  20 rr rr             jsr     sfx_init
000510r 1  AD rr rr             lda     mute_def
000513r 1  8D rr rr             sta     sfx_mute
000516r 1  20 rr rr             jsr     spr_setup       ; the terminal's sprites (or back to the menu)
000519r 1               
000519r 1  20 rr rr     title:  jsr     sfx_off
00051Cr 1  A9 00                lda     #0
00051Er 1  8D rr rr             sta     rp_on
000521r 1  20 rr rr             jsr     new_screen
000524r 1  A9 rr                lda     #<title_txt
000526r 1  A0 rr                ldy     #>title_txt
000528r 1  20 rr rr             jsr     print
00052Br 1  20 rr rr             jsr     txt_mode        ; the high score
00052Er 1  A2 22                ldx     #34
000530r 1  A0 13                ldy     #19
000532r 1  20 rr rr             jsr     gotoxy
000535r 1  A9 rr                lda     #<hi_txt
000537r 1  A0 rr                ldy     #>hi_txt
000539r 1  20 rr rr             jsr     print
00053Cr 1  AD rr rr             lda     hiscore+2
00053Fr 1  20 rr rr             jsr     prbcd
000542r 1  AD rr rr             lda     hiscore+1
000545r 1  20 rr rr             jsr     prbcd
000548r 1  AD rr rr             lda     hiscore
00054Br 1  20 rr rr             jsr     prbcd
00054Er 1  A2 05                ldx     #NCAPTYPE-1     ; the capsules beside their words
000550r 1  8E rr rr     @cp:    stx     hs_i
000553r 1  8A                   txa
000554r 1  18                   clc
000555r 1  69 05                adc     #PIC_CAP
000557r 1  8D rr rr             sta     des_n
00055Ar 1  BD rr rr             lda     title_cx,x
00055Dr 1  8D rr rr             sta     des_x
000560r 1  BD rr rr             lda     title_cy,x
000563r 1  8D rr rr             sta     des_y
000566r 1  A9 1C                lda     #TC_SPR
000568r 1  20 rr rr             jsr     putc
00056Br 1  A9 02                lda     #SPR_PLACE
00056Dr 1  20 rr rr             jsr     putc
000570r 1  AD rr rr             lda     hs_i
000573r 1  20 rr rr             jsr     putc
000576r 1  AD rr rr             lda     des_n
000579r 1  20 rr rr             jsr     putc
00057Cr 1  AD rr rr             lda     des_x
00057Fr 1  20 rr rr             jsr     putc
000582r 1  AD rr rr             lda     des_y
000585r 1  20 rr rr             jsr     putc
000588r 1  A9 00                lda     #0
00058Ar 1  20 rr rr             jsr     putc
00058Dr 1  AE rr rr             ldx     hs_i
000590r 1  CA                   dex
000591r 1  10 BD                bpl     @cp
000593r 1  20 rr rr             jsr     show_ctrl
000596r 1  20 rr rr             jsr     read_pad
000599r 1  20 rr rr             jsr     flush_in
00059Cr 1  20 rr rr     @wait:  jsr     menu_key
00059Fr 1  C9 51                cmp     #'Q'
0005A1r 1  D0 03                bne     @notq
0005A3r 1  4C rr rr             jmp     exit_game
0005A6r 1  C9 4D        @notq:  cmp     #'M'            ; sound on / off
0005A8r 1  D0 06                bne     @notm
0005AAr 1  20 rr rr             jsr     sfx_toggle
0005ADr 1  4C rr rr             jmp     @wait
0005B0r 1  C9 47        @notm:  cmp     #'G'
0005B2r 1  D0 0E                bne     @notg
0005B4r 1  AD rr rr             lda     ctrl
0005B7r 1  49 01                eor     #1
0005B9r 1  8D rr rr             sta     ctrl
0005BCr 1  20 rr rr             jsr     show_ctrl
0005BFr 1  4C rr rr             jmp     @wait
0005C2r 1  C9 80        @notg:  cmp     #PAD_GO
0005C4r 1  D0 08                bne     @notp
0005C6r 1  A9 01                lda     #1
0005C8r 1  8D rr rr             sta     ctrl
0005CBr 1  4C rr rr             jmp     new_game
0005CEr 1  C9 20        @notp:  cmp     #' '
0005D0r 1  D0 CA                bne     @wait
0005D2r 1  4C rr rr             jmp     new_game
0005D5r 1               
0005D5r 1               exit_game:
0005D5r 1  20 rr rr             jsr     sfx_off
0005D8r 1  A9 rr                lda     #<bye_txt
0005DAr 1  A0 rr                ldy     #>bye_txt
0005DCr 1  20 rr rr             jsr     print
0005DFr 1  4C 06 FE             jmp     SBC_MENU
0005E2r 1               
0005E2r 1               ; clear the screen (which hides the sprites) and forget what it showed
0005E2r 1               new_screen:
0005E2r 1  A9 rr                lda     #<cls_txt
0005E4r 1  A0 rr                ldy     #>cls_txt
0005E6r 1  20 rr rr             jsr     print
0005E9r 1  A2 0F                ldx     #NSLOT-1
0005EBr 1  A9 00                lda     #0
0005EDr 1  9D rr rr     @f:     sta     sl_on,x
0005F0r 1  9D rr rr             sta     des_on,x
0005F3r 1  CA                   dex
0005F4r 1  10 F7                bpl     @f
0005F6r 1  A9 01                lda     #1              ; (nothing to wait for)
0005F8r 1  8D rr rr             sta     rp_got
0005FBr 1  60                   rts
0005FCr 1               
0005FCr 1               ; ============================================================================
0005FCr 1               ; the terminal's sprite layer: IDENTIFY, then the pictures; without it, a
0005FCr 1               ; word and back to the boot menu
0005FCr 1               ; ============================================================================
0005FCr 1               spr_setup:
0005FCr 1  20 rr rr             jsr     flush_in
0005FFr 1  A9 rr                lda     #<ident_txt
000601r 1  A0 rr                ldy     #>ident_txt
000603r 1  20 rr rr             jsr     print
000606r 1  A9 C8                lda     #200            ; up to 200 ms
000608r 1  8D rr rr             sta     rp_t
00060Br 1  20 00 FE     @w:     jsr     SBC_CHRIN
00060Er 1  B0 17                bcs     @c
000610r 1  A9 01        @w1:    lda     #1
000612r 1  20 rr rr             jsr     delay_ms
000615r 1  CE rr rr             dec     rp_t
000618r 1  D0 F1                bne     @w
00061Ar 1  A9 rr                lda     #<nospr_txt     ; no answer
00061Cr 1  A0 rr                ldy     #>nospr_txt
00061Er 1  20 rr rr             jsr     print
000621r 1  20 rr rr             jsr     menu_key
000624r 1  4C 06 FE             jmp     SBC_MENU
000627r 1  C9 53        @c:     cmp     #'S'
000629r 1  F0 08                beq     @yes
00062Br 1  C9 50                cmp     #'P'
00062Dr 1  F0 04                beq     @yes
00062Fr 1  C9 31                cmp     #'1'
000631r 1  D0 DD                bne     @w1
000633r 1  A9 14        @yes:   lda     #20             ; (the rest of the answer)
000635r 1  20 rr rr             jsr     delay_ms
000638r 1  20 rr rr             jsr     flush_in
00063Br 1  A2 00                ldx     #0
00063Dr 1  BD rr rr     @d:     lda     spr_defs,x
000640r 1  20 03 FE             jsr     SBC_CHROUT
000643r 1  E8                   inx
000644r 1  E0 7C                cpx     #SPR_DEFS
000646r 1  D0 F5                bne     @d
000648r 1  60                   rts
000649r 1               
000649r 1               ; ---- pacing: IDENTIFY after each frame; the next waits for the answer ----
000649r 1               ASK_MS          = 60
000649r 1               ask_send:
000649r 1  A9 01                lda     #1
00064Br 1  8D rr rr             sta     rp_on
