000B51r 1  A9 00        @go:    lda     #0
000B53r 1  8D rr rr             sta     serve_t
000B56r 1  A2 02                ldx     #NBALL-1
000B58r 1  BD rr rr     @b:     lda     b_on,x
000B5Br 1  F0 27                beq     @n
