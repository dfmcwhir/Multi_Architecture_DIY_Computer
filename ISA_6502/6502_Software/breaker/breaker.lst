000671r 1  20 rr rr             jsr     delay_ms
000674r 1  CE rr rr             dec     rp_t
000677r 1  F0 05                beq     @r
000679r 1  AD rr rr     @chk:   lda     rp_got
00067Cr 1  F0 E6                beq     @l
