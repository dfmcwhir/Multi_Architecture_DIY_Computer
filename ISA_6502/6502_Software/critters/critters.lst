0007A9r 1               CTRL_COL        = 19
0007A9r 1               CTRL_ROW        = 18
0007A9r 1               
0007A9r 1               ; ============================================================================
0007A9r 1               ; gamepad and menu input (shared by the SBC games)
0007A9r 1               ; ============================================================================
0007A9r 1               PAD_A           = $01           ; bits returned by SBC_PADSTATE
0007A9r 1               PAD_B           = $02
0007A9r 1               PAD_SELECT      = $04
0007A9r 1               PAD_START       = $08
0007A9r 1               PAD_UP          = $10
0007A9r 1               PAD_DOWN        = $20
0007A9r 1               PAD_LEFT        = $40
0007A9r 1               PAD_RIGHT       = $80
0007A9r 1               PAD_GO          = $80           ; menu_key's answer for gamepad A or Start
0007A9r 1               
0007A9r 1               ; read the gamepad: pad = buttons held now, padnew = buttons pressed since
0007A9r 1               ; the last call.  Preserves X and Y (SBC_PADSTATE only changes A).
0007A9r 1               read_pad:
0007A9r 1  20 12 FE             jsr     SBC_PADSTATE
0007ACr 1  C9 FF                cmp     #$FF            ; every button "pressed" = no pad
0007AEr 1  D0 02                bne     @ok
0007B0r 1  A9 00                lda     #0
0007B2r 1  8D rr rr     @ok:    sta     pad
0007B5r 1  AD rr rr             lda     padold
0007B8r 1  49 FF                eor     #$FF
0007BAr 1  2D rr rr             and     pad
0007BDr 1  8D rr rr             sta     padnew
0007C0r 1  AD rr rr             lda     pad
0007C3r 1  8D rr rr             sta     padold
0007C6r 1  60                   rts
0007C7r 1               
0007C7r 1               ; throw away waiting characters
0007C7r 1               flush_in:
0007C7r 1  20 00 FE             jsr     getc
0007CAr 1  B0 FB                bcs     flush_in
0007CCr 1  60                   rts
0007CDr 1               
0007CDr 1               ; carry set if A is one of the characters the gamepad driver types for the
0007CDr 1               ; pad (W A S D and space).  Those are ignored in gamepad mode so that one
0007CDr 1               ; press doesn't act twice.  Preserves A.
0007CDr 1               pad_typed:
0007CDr 1  C9 20                cmp     #' '
0007CFr 1  F0 12                beq     @y
0007D1r 1  C9 57                cmp     #'W'
0007D3r 1  F0 0E                beq     @y
0007D5r 1  C9 41                cmp     #'A'
0007D7r 1  F0 0A                beq     @y
0007D9r 1  C9 53                cmp     #'S'
0007DBr 1  F0 06                beq     @y
0007DDr 1  C9 44                cmp     #'D'
0007DFr 1  F0 02                beq     @y
0007E1r 1  18                   clc
0007E2r 1  60                   rts
