0005FEr 1  8D rr rr             sta     t_mask
000601r 1  AC rr rr             ldy     t_y
000604r 1  60                   rts
000605r 1  AD FF FF     tb_rd:  lda     $FFFF
000608r 1  60                   rts
000609r 1  8D FF FF     tb_wr:  sta     $FFFF
00060Cr 1  60                   rts
00060Dr 1               
00060Dr 1               ; carry set if pixel X, Y is solid.  Off the left/right edges and above the
00060Dr 1               ; top count as solid, below the bottom is empty.  Preserves X and Y.
00060Dr 1  E0 A0        solid:  cpx     #FW
00060Fr 1  B0 13                bcs     @yes
000611r 1  C0 80                cpy     #128
000613r 1  B0 0F                bcs     @yes
000615r 1  C0 58                cpy     #FH
000617r 1  B0 0D                bcs     @no
000619r 1  20 rr rr             jsr     t_ptr
00061Cr 1  20 rr rr             jsr     tb_rd
00061Fr 1  2D rr rr             and     t_mask
000622r 1  F0 02                beq     @no
000624r 1  38           @yes:   sec
000625r 1  60                   rts
000626r 1  18           @no:    clc
000627r 1  60                   rts
