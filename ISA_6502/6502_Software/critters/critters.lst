000521r 1  E8                   inx
000522r 1  D0 CD                bne     @l
000524r 1  A9 FF                lda     #$FF
000526r 1  8D rr rr             sta     cur_y
000529r 1  60                   rts
00052Ar 1               
00052Ar 1               gfx_mode:
00052Ar 1  A9 80                lda     #ATTR_GFX
00052Cr 1  D0 02                bne     setattr
00052Er 1               txt_mode:
00052Er 1  A9 00                lda     #ATTR_TEXT
000530r 1  CD rr rr     setattr:cmp     attr
000533r 1  F0 0D                beq     @done
000535r 1  8D rr rr             sta     attr
000538r 1  48                   pha
000539r 1  A9 18                lda     #TC_ATTR
00053Br 1  20 rr rr             jsr     putc
00053Er 1  68                   pla
00053Fr 1  20 rr rr             jsr     putc
000542r 1  60           @done:  rts
000543r 1               
000543r 1               ; print the string at A (lo) / Y (hi), terminated by $FF.  Assumes the
000543r 1               ; string leaves the terminal in text mode if it changes the attribute.
000543r 1  8D rr rr     print:  sta     @ld+1
000546r 1  8C rr rr             sty     @ld+2
000549r 1  8D rr rr             sta     @cl+1
00054Cr 1  8C rr rr             sty     @cl+2
00054Fr 1  A9 FF                lda     #$FF            ; (the cursor moves)
000551r 1  8D rr rr             sta     cur_y
000554r 1  AD FF FF     @cl:    lda     $FFFF           ; a string that clears the screen?
000557r 1  C9 0C                cmp     #TC_CLS
000559r 1  D0 03                bne     @tm
00055Br 1  20 rr rr             jsr     clear_shadow
00055Er 1  20 rr rr     @tm:    jsr     txt_mode
000561r 1  A0 00                ldy     #0
000563r 1  B9 FF FF     @ld:    lda     $FFFF,y
000566r 1  C9 FF                cmp     #TERM
000568r 1  F0 0C                beq     @done
00056Ar 1  20 rr rr             jsr     putc
00056Dr 1  C8                   iny
00056Er 1  D0 F3                bne     @ld
000570r 1  EE rr rr             inc     @ld+2           ; strings may be longer than 255 bytes
000573r 1  4C rr rr             jmp     @ld
000576r 1  60           @done:  rts
000577r 1               
000577r 1               ; print A (0..99) as two decimal digits.  Preserves Y.
000577r 1  A2 00        pr_dec2:ldx     #0
000579r 1  C9 0A        @t:     cmp     #10
00057Br 1  90 05                bcc     @d
00057Dr 1  E9 0A                sbc     #10
00057Fr 1  E8                   inx
000580r 1  D0 F7                bne     @t
000582r 1  48           @d:     pha
000583r 1  8A                   txa
000584r 1  09 30                ora     #'0'
000586r 1  20 rr rr             jsr     putc
000589r 1  68                   pla
00058Ar 1  09 30                ora     #'0'
00058Cr 1  4C rr rr             jmp     putc
00058Fr 1               
00058Fr 1               ; print the low digit of A
00058Fr 1               pr_digit:
00058Fr 1  29 0F                and     #$0F
000591r 1  09 30                ora     #'0'
000593r 1  4C rr rr             jmp     putc
000596r 1               
000596r 1               ; print A as two BCD digits
000596r 1  48           prbcd:  pha
000597r 1  4A                   lsr
000598r 1  4A                   lsr
000599r 1  4A                   lsr
00059Ar 1  4A                   lsr
00059Br 1  09 30                ora     #'0'
00059Dr 1  20 rr rr             jsr     putc
0005A0r 1  68                   pla
0005A1r 1  4C rr rr             jmp     pr_digit
0005A4r 1               
0005A4r 1               ; wait about A ms.  The inner loop is sized for the clock (CLOCK_MHZ in
0005A4r 1               ; sbc_api.inc): 5 + 4 * (CLOCK_MHZ - 1) cycles a turn, DELAY_N turns a ms.
0005A4r 1               DELAY_N = (1000 * CLOCK_MHZ - 7) / (5 + 4 * (CLOCK_MHZ - 1))
0005A4r 1               delay_ms:
0005A4r 1  48                   pha                     ; (send what was drawn first)
0005A5r 1  20 rr rr             jsr     flush_px
0005A8r 1  68                   pla
0005A9r 1  AA                   tax
0005AAr 1  F0 0D                beq     @done
0005ACr 1  20 rr rr     @o:     jsr     sfx_poll        ; (the sound goes on while waiting)
0005AFr 1  A0 DD                ldy     #DELAY_N
0005B1r 1               @i:
0005B1r 1  EA EA        .repeat CLOCK_MHZ - 1           ; (4 more cycles a turn for each MHz above 1)
0005B3r 1                       nop
0005B3r 1                       nop
0005B3r 1               .endrepeat
0005B3r 1  88                   dey
0005B4r 1  D0 FB                bne     @i
0005B6r 1  CA                   dex
0005B7r 1  D0 F3                bne     @o
0005B9r 1  60           @done:  rts
0005BAr 1               
0005BAr 1               ; wait about A x 50 ms
0005BAr 1               delay_long:
0005BAr 1  8D rr rr             sta     tmp
0005BDr 1  A9 32        @l:     lda     #50
0005BFr 1  20 rr rr             jsr     delay_ms
0005C2r 1  20 rr rr             jsr     flush_in        ; keys pressed meanwhile are dropped (so the
0005C5r 1  CE rr rr             dec     tmp             ; ROM's keyboard buffer never fills up)
0005C8r 1  D0 F3                bne     @l
0005CAr 1  60                   rts
0005CBr 1               
0005CBr 1               ; wait for a key, return it in A (upper case for letters).  The gamepad's
0005CBr 1               ; A or Start button counts as a space.
0005CBr 1  20 rr rr     waitkey:jsr     menu_key
0005CEr 1  C9 80                cmp     #PAD_GO
0005D0r 1  D0 02                bne     @r
0005D2r 1  A9 20                lda     #' '
0005D4r 1  60           @r:     rts
0005D5r 1               
0005D5r 1               ; throw away waiting keys
0005D5r 1  20 00 FE     flush:  jsr     getc
0005D8r 1  B0 FB                bcs     flush
0005DAr 1  60                   rts
