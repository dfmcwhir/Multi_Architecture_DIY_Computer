0003DAr 1  CD rr rr     px_put: cmp     pold
0003DDr 1  F0 2B                beq     @r              ; no change
0003DFr 1  48                   pha
0003E0r 1  AD rr rr             lda     pold            ; already different from the screen: listed
0003E3r 1  20 rr rr             jsr     shown_cmp
0003E6r 1  D0 1E                bne     @w
0003E8r 1  AE rr rr             ldx     dl_n
0003EBr 1  E0 C8                cpx     #DLMAX
