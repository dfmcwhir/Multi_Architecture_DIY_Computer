0003B7r 1               ; ----------------------------------------------------------------------------
0003B7r 1               ; Pixels.  The screen is kept in RAM as block graphics characters: want[]
0003B7r 1               ; is what it should show, shown[] what the terminal shows (80 x 24 each).
0003B7r 1               ; setpix / clrpix change want[] and note the character in a list; flush_px
0003B7r 1               ; sends the characters that differ, one byte each (plus cursor moves), which
0003B7r 1               ; is much less than 3 bytes per pixel when creatures move.
0003B7r 1               ; ----------------------------------------------------------------------------
0003B7r 1               
0003B7r 1               ; set / reset the pixel at X, Y.  Preserves X and Y.
0003B7r 1  20 rr rr     setpix: jsr     px_cell
0003BAr 1  8D rr rr             sta     pmask
0003BDr 1  20 rr rr             jsr     want_rd
0003C0r 1  8D rr rr             sta     pold
0003C3r 1  0D rr rr             ora     pmask
0003C6r 1  4C rr rr             jmp     px_put
0003C9r 1  20 rr rr     clrpix: jsr     px_cell
0003CCr 1  49 FF                eor     #$FF
