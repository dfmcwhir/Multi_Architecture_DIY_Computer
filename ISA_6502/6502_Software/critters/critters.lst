0004B6r 1  E0 50                cpx     #80
0004B8r 1  D0 EC                bne     @ac
0004BAr 1  C8                   iny
0004BBr 1  C0 18                cpy     #24
0004BDr 1  D0 E5                bne     @ar
0004BFr 1  A9 00                lda     #0
