000B57r 1  60                   rts
000B58r 1               
000B58r 1               ; A into rows of column Y: enter at wall_chain + 3 * first row
000B58r 1               wall_chain:
000B58r 1  99 00 56 99  .repeat VROWS, R
000B5Cr 1  50 56 99 A0  
000B60r 1  56 99 F0 56  
000B8Er 1                       sta     FB + R * COLS,y
000B8Er 1               .endrepeat
000B8Er 1  60                   rts
000B8Fr 1               ; for a wall H pixels high: rows y0 = HORIZON - H/2 .. y1 = y0 + H (not included)
000B8Fr 1               ; r0 / t0 = character row and pixel row of y0, r1 / t1 the same for y1
000B8Fr 1               dc_r0:
000B8Fr 1  09 09 08 08  .repeat VH + 1, H
000B93r 1  08 08 08 08  
000B97r 1  08 08 07 07  
000BD8r 1                       .byte   (HORIZON - H / 2) / 4
000BD8r 1               .endrepeat
000BD8r 1               dc_t0:
000BD8r 1  00 00 03 03  .repeat VH + 1, H
000BDCr 1  02 02 01 01  
000BE0r 1  00 00 03 03  
000C21r 1                       .byte   (HORIZON - H / 2) .mod 4
000C21r 1               .endrepeat
000C21r 1               dc_r1:
000C21r 1  09 09 09 09  .repeat VH + 1, H
000C25r 1  09 09 09 0A  
000C29r 1  0A 0A 0A 0A  
000C6Ar 1                       .byte   (HORIZON - H / 2 + H) / 4
000C6Ar 1               .endrepeat
000C6Ar 1               dc_t1:
000C6Ar 1  00 01 01 02  .repeat VH + 1, H
000C6Er 1  02 03 03 00  
000C72r 1  00 01 01 02  
000CB3r 1                       .byte   (HORIZON - H / 2 + H) .mod 4
000CB3r 1               .endrepeat
000CB3r 1               wc_lo:
