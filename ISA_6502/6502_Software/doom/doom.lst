00036Ar 1  4C 03 FE             jmp     SBC_CHROUT      ; preserves A, X, Y
00036Dr 1               getc            = SBC_CHRIN     ; carry set = key in A
00036Dr 1               
00036Dr 1               ; ----------------------------------------------------------------------------
00036Dr 1               ; output helpers
