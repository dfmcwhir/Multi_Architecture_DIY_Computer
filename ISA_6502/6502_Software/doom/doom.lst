ca65 V2.19 - Git a6530f4
Main file   : doom.s
Current file: doom.s

000000r 1               ; ============================================================================
000000r 1               ; doom.s - "6502 DOOM": a small first person shooter for the 6502 SBC
000000r 1               ;
000000r 1               ; A raycasting engine (in the spirit of the 1993 game, nothing taken from
000000r 1               ; it) that runs from the monitor at $0500 and draws on the PIC32 terminal in
000000r 1               ; block graphics.  The engine loads one map at a time from the USB drive
000000r 1               ; (E1M1.LVL, then the next one when you reach the exit) through the ROM's
000000r 1               ; SBC_LOAD entry point.  On a ROM without SBC_LOAD it plays a built in copy
000000r 1               ; of the first map.
000000r 1               ;
000000r 1               ;   build:  make     (runs gen_tables.py and mklevels.py when they change)
000000r 1               ;   run:    L DOOM 0500   then   R           (needs terminal setup item J)
000000r 1               ;
000000r 1               ; Header (patchable from the monitor):
000000r 1               ;   $0500  JMP start
000000r 1               ;   $0503  extra delay per frame in ms (default 0)
000000r 1               ;   $0504  controls at start: 0 keyboard, 1 gamepad
000000r 1               ;   $0505  sound at start: 0 on, 1 off (M switches)
000000r 1               ;
000000r 1               ; Sound: the AY-3-8910 card at $7F22/$7F23, through ../ay/sfx.s (timed by
000000r 1               ; the VIA's timer 2, checked as the view is drawn): a bass line and effects,
000000r 1               ; in doom_sound.inc (made by ../ay/tools/game_sounds.py).  Without the card
000000r 1               ; the game is just silent.
000000r 1               ;
000000r 1               ; The view: 80 columns x 18 text rows of block graphics (160 x 72 pixels).
000000r 1               ; A ray is cast for every other text column (each 2 pixels wide) and followed
000000r 1               ; through the 32 x 32 tile map with a DDA; the columns between are averaged
000000r 1               ; when their neighbours hit the same face of the same block, otherwise cast
000000r 1               ; too.  The distance gives the wall height; the wall style, the side it hit
000000r 1               ; and the distance give the shading pattern.
000000r 1               ; Things (enemies, items) are scaled 8 x 8 bitmaps clipped against the wall
000000r 1               ; distances.  The frame is built in RAM and only the characters that changed
000000r 1               ; since the last frame are sent to the terminal.
000000r 1               ;
000000r 1               ; Angles are 0..1023 for a full turn (0 = east, 256 = south: y grows down).
000000r 1               ;   memory: program and variables $0500-$4BFF, level $5000-$55FF, frame buffers $5600-$61FF
000000r 1               ; Positions are 8.8 fixed point in tiles.  No zero page is used.
000000r 1               ; ============================================================================
000000r 1               
000000r 1                       .setcpu "6502"
000000r 1                       .include "sbc_api.inc"
000000r 2               ; sbc_api.inc - fixed ROM entry points of the SBC (see jumptable.s), and the
000000r 2               ; CPU clock.  Use in your own ca65 programs:  .include "sbc_api.inc"
000000r 2               ; (the games find it one folder up: their make.bat passes  -I ..  to ca65)
000000r 2               SBC_CHRIN       = $FE00         ; carry set + A = char, carry clear = none waiting
000000r 2               SBC_CHROUT      = $FE03         ; print A (A, X, Y preserved)
000000r 2               SBC_MENU        = $FE06         ; boot menu
000000r 2               SBC_COLD        = $FE09         ; BASIC cold start
000000r 2               SBC_WARM        = $FE0C         ; BASIC warm start
000000r 2               SBC_MONITOR     = $FE0F         ; monitor prompt (or JMP $FF00)
000000r 2               SBC_PADSTATE    = $FE12         ; A = gamepad buttons held: bit0 A,1 B,2 Select,3 Start,4 Up,5 Down,6 Left,7 Right
000000r 2               SBC_LOAD        = $FE15         ; load a file: A/Y = parameter block (.word addr, .word max, "NAME.EXT",0)
000000r 2                                               ;   carry clear = loaded, X/Y = length; carry set = failed, A = error code
000000r 2               
000000r 2               ; The CPU clock in MHz (whole numbers, 1 to 8).  Programs size their delay
000000r 2               ; loops from it, so a millisecond stays a millisecond.  To build for another
000000r 2               ; clock, change it here or give it on the command line:  make.bat 1
000000r 2               .ifndef CLOCK_MHZ
000000r 2               CLOCK_MHZ       = 2
000000r 2               .endif
000000r 2               
000000r 1               .ifndef SBC_LOAD
000000r 1               SBC_LOAD        = $FE15         ; load a file (see SBC_LOAD.md)
000000r 1               .endif
000000r 1               
000000r 1               SPEED_DEFAULT   = 0
000000r 1               
000000r 1               ; ---- terminal --------------------------------------------------------------------
000000r 1               TC_CURSOR       = $02
000000r 1               TC_CLS          = $0C
000000r 1               TC_COL          = $0E
000000r 1               TC_ROW          = $0F
000000r 1               TC_ATTR         = $18
000000r 1               TC_LIT          = $1A
000000r 1               ATTR_TEXT       = $00
000000r 1               ATTR_RV         = $04
000000r 1               ATTR_GFX        = $80
000000r 1               TERM            = $FF
000000r 1               
000000r 1               ; ---- memory ----------------------------------------------------------------------
000000r 1               LEVEL_BUF       = $5000         ; the level file is loaded here
000000r 1               LEVEL_MAX       = $0600
000000r 1               MAP             = LEVEL_BUF + 64
000000r 1               THING_SRC       = LEVEL_BUF + 64 + 1024
000000r 1               FB              = $5600         ; the frame being built (18 x 80)
000000r 1               SB              = $5C00         ; what the terminal shows now
000000r 1               
000000r 1               ; ---- game --------------------------------------------------------------------------
000000r 1               MAXT            = 32            ; things per level
000000r 1               HUD_LINE        = 18
000000r 1               HUD_STATS       = 19
000000r 1               HUD_LEVEL       = 20
000000r 1               HUD_MSG         = 21
000000r 1               HUD_HELP        = 23
000000r 1               T_GRUNT         = 1
000000r 1               T_BRUTE         = 2
000000r 1               T_MEDKIT        = 3
000000r 1               T_AMMO          = 4
000000r 1               S_GONE          = 0             ; thing states
000000r 1               S_IDLE          = 1             ; (items use S_IDLE for "lying here")
000000r 1               S_CHASE         = 2
000000r 1               S_ATTACK        = 3
000000r 1               S_DEAD          = 4
000000r 1               TILE_DOOR       = 4
000000r 1               TILE_EXIT       = 5
000000r 1               RADIUS          = $40           ; the player's size, 1/4 tile
000000r 1               
000000r 1               ; ============================================================================
000000r 1                       .segment "RODATA"
000000r 1                       .include "tables.inc"     ; constants and lookup tables (gen_tables.py)
000000r 2               ; generated by gen_tables.py - do not edit
000000r 2               COLS = 80
000000r 2               VROWS = 18
000000r 2               VH = 72
000000r 2               HORIZON = 36
000000r 2               FOCAL = 62
000000r 2               NSTYLE = 5
000000r 2               
