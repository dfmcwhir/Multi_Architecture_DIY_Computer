000A65r 1  8D rr rr             sta     @jp+1
000A68r 1  BD rr rr             lda     wc_hi,x
000A6Br 1  8D rr rr             sta     @jp+2
000A6Er 1  AE rr rr             ldx     r1
000A71r 1  BD rr rr             lda     wc_lo,x
000A74r 1  8D rr rr             sta     @rt+1
000A77r 1  8D rr rr             sta     @un+1
000A7Ar 1  BD rr rr             lda     wc_hi,x
000A7Dr 1  8D rr rr             sta     @rt+2
