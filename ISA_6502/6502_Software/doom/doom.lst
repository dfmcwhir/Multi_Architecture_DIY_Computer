00039Ar 1  F0 0D                beq     @done
00039Cr 1  8D rr rr             sta     attr
00039Fr 1  48                   pha
0003A0r 1  A9 18                lda     #TC_ATTR
0003A2r 1  20 rr rr             jsr     putc
0003A5r 1  68                   pla
0003A6r 1  20 rr rr             jsr     putc
0003A9r 1  60           @done:  rts
0003AAr 1               
0003AAr 1               ; print the string at A (lo) / Y (hi), terminated by $FF (any length)
0003AAr 1  8D rr rr     print:  sta     @ld+1
0003ADr 1  8C rr rr             sty     @ld+2
0003B0r 1  20 rr rr             jsr     txt_mode
0003B3r 1  A0 00                ldy     #0
0003B5r 1  B9 FF FF     @ld:    lda     $FFFF,y
0003B8r 1  C9 FF                cmp     #TERM
0003BAr 1  F0 0C                beq     @done
0003BCr 1  20 rr rr             jsr     putc
0003BFr 1  C8                   iny
0003C0r 1  D0 F3                bne     @ld
0003C2r 1  EE rr rr             inc     @ld+2
0003C5r 1  4C rr rr             jmp     @ld
0003C8r 1  60           @done:  rts
0003C9r 1               
0003C9r 1               ; print a zero terminated string at A / Y (names in the level file)
0003C9r 1  8D rr rr     print0: sta     @ld+1
0003CCr 1  8C rr rr             sty     @ld+2
0003CFr 1  A0 00                ldy     #0
0003D1r 1  B9 FF FF     @ld:    lda     $FFFF,y
0003D4r 1  F0 06                beq     @done
0003D6r 1  20 rr rr             jsr     putc
0003D9r 1  C8                   iny
0003DAr 1  D0 F5                bne     @ld
0003DCr 1  60           @done:  rts
0003DDr 1               
0003DDr 1               ; print A (0-255) in decimal, 3 characters, leading spaces.  pr_dec2: 2 digits
0003DDr 1  A2 20        pr_dec3:ldx     #' '
0003DFr 1  8E rr rr             stx     lead
0003E2r 1  A2 00                ldx     #0
0003E4r 1  C9 64        @h:     cmp     #100
0003E6r 1  90 05                bcc     @hd
0003E8r 1  E9 64                sbc     #100
0003EAr 1  E8                   inx
0003EBr 1  D0 F7                bne     @h
0003EDr 1  48           @hd:    pha
0003EEr 1  8A                   txa
0003EFr 1  F0 0B                beq     @hs
0003F1r 1  09 30                ora     #'0'
0003F3r 1  8D rr rr             sta     lead
0003F6r 1  20 rr rr             jsr     putc
0003F9r 1  4C rr rr             jmp     @t
0003FCr 1  A9 20        @hs:    lda     #' '
0003FEr 1  20 rr rr             jsr     putc
000401r 1  68           @t:     pla
000402r 1  A2 00        pr_dec2:ldx     #0
000404r 1  C9 0A        @l:     cmp     #10
000406r 1  90 05                bcc     @d
000408r 1  E9 0A                sbc     #10
00040Ar 1  E8                   inx
00040Br 1  D0 F7                bne     @l
00040Dr 1  48           @d:     pha
00040Er 1  8A                   txa
00040Fr 1  09 30                ora     #'0'
000411r 1  20 rr rr             jsr     putc
000414r 1  68                   pla
000415r 1  09 30                ora     #'0'
000417r 1  4C rr rr             jmp     putc
00041Ar 1               
00041Ar 1               ; print A as 2 hex digits
00041Ar 1  48           pr_hex: pha
00041Br 1  4A                   lsr
00041Cr 1  4A                   lsr
00041Dr 1  4A                   lsr
00041Er 1  4A                   lsr
00041Fr 1  20 rr rr             jsr     @dig
000422r 1  68                   pla
000423r 1  29 0F                and     #$0F
000425r 1  C9 0A        @dig:   cmp     #10
000427r 1  90 02                bcc     @n
000429r 1  69 06                adc     #6
00042Br 1  69 30        @n:     adc     #'0'
00042Dr 1  4C rr rr             jmp     putc
000430r 1               
000430r 1               ; wait about A ms.  The inner loop is sized for the clock (CLOCK_MHZ in
000430r 1               ; sbc_api.inc): 5 + 4 * (CLOCK_MHZ - 1) cycles a turn, DELAY_N turns a ms.
000430r 1               DELAY_N = (1000 * CLOCK_MHZ - 7) / (5 + 4 * (CLOCK_MHZ - 1))
000430r 1               delay_ms:
000430r 1  AA                   tax
000431r 1  F0 0D                beq     @done
000433r 1  20 rr rr     @o:     jsr     sfx_poll        ; (and while waiting)
000436r 1  A0 DD                ldy     #DELAY_N
000438r 1               @i:
000438r 1  EA EA        .repeat CLOCK_MHZ - 1           ; (4 more cycles a turn for each MHz above 1)
00043Ar 1                       nop
00043Ar 1                       nop
00043Ar 1               .endrepeat
00043Ar 1  88                   dey
00043Br 1  D0 FB                bne     @i
00043Dr 1  CA                   dex
00043Er 1  D0 F3                bne     @o
000440r 1  60           @done:  rts
000441r 1               
000441r 1               ; wait about A x 50 ms
000441r 1               delay_long:
000441r 1  8D rr rr             sta     tmp
000444r 1  A9 32        @l:     lda     #50
000446r 1  20 rr rr             jsr     delay_ms
000449r 1  20 rr rr             jsr     flush_in        ; keys pressed meanwhile are dropped (so the
00044Cr 1  CE rr rr             dec     tmp             ; ROM's keyboard buffer never fills up)
00044Fr 1  D0 F3                bne     @l
000451r 1  60                   rts
000452r 1               
000452r 1               ; 16 bit Galois LFSR.  Returns a random byte in A.  Preserves X and Y.
000452r 1  AD rr rr     rand:   lda     rng+1
000455r 1  4A                   lsr
000456r 1  6E rr rr             ror     rng
000459r 1  90 02                bcc     @n
00045Br 1  49 B4                eor     #$B4
00045Dr 1  8D rr rr     @n:     sta     rng+1
000460r 1  4D rr rr             eor     rng
000463r 1  60                   rts
000464r 1               
000464r 1               .macro MENU_IDLE
000464r 1                       jsr     rand
000464r 1                       jsr     sfx_poll
000464r 1               .endmacro
000464r 1               CTRL_COL        = 19
000464r 1               CTRL_ROW        = 17
000464r 1               ; ============================================================================
000464r 1               ; gamepad and menu input (shared by the SBC games)
000464r 1               ; ============================================================================
000464r 1               PAD_A           = $01           ; bits returned by SBC_PADSTATE
000464r 1               PAD_B           = $02
000464r 1               PAD_SELECT      = $04
000464r 1               PAD_START       = $08
000464r 1               PAD_UP          = $10
000464r 1               PAD_DOWN        = $20
000464r 1               PAD_LEFT        = $40
000464r 1               PAD_RIGHT       = $80
000464r 1               PAD_GO          = $80           ; menu_key's answer for gamepad A or Start
000464r 1               
000464r 1               ; read the gamepad: pad = buttons held now, padnew = buttons pressed since
000464r 1               ; the last call.  Preserves X and Y (SBC_PADSTATE only changes A).
000464r 1               read_pad:
000464r 1  20 12 FE             jsr     SBC_PADSTATE
000467r 1  C9 FF                cmp     #$FF            ; every button "pressed" = no pad
000469r 1  D0 02                bne     @ok
00046Br 1  A9 00                lda     #0
00046Dr 1  8D rr rr     @ok:    sta     pad
000470r 1  AD rr rr             lda     padold
000473r 1  49 FF                eor     #$FF
000475r 1  2D rr rr             and     pad
000478r 1  8D rr rr             sta     padnew
00047Br 1  AD rr rr             lda     pad
00047Er 1  8D rr rr             sta     padold
000481r 1  60                   rts
000482r 1               
000482r 1               ; throw away waiting characters
000482r 1               flush_in:
000482r 1  20 00 FE             jsr     getc
000485r 1  B0 FB                bcs     flush_in
000487r 1  60                   rts
000488r 1               
000488r 1               ; carry set if A is one of the characters the gamepad driver types for the
000488r 1               ; pad (W A S D and space).  Those are ignored in gamepad mode so that one
000488r 1               ; press doesn't act twice.  Preserves A.
000488r 1               pad_typed:
000488r 1  C9 20                cmp     #' '
00048Ar 1  F0 12                beq     @y
00048Cr 1  C9 57                cmp     #'W'
00048Er 1  F0 0E                beq     @y
000490r 1  C9 41                cmp     #'A'
000492r 1  F0 0A                beq     @y
000494r 1  C9 53                cmp     #'S'
000496r 1  F0 06                beq     @y
000498r 1  C9 44                cmp     #'D'
00049Ar 1  F0 02                beq     @y
00049Cr 1  18                   clc
00049Dr 1  60                   rts
00049Er 1  38           @y:     sec
00049Fr 1  60                   rts
0004A0r 1               
0004A0r 1               ; wait for a menu choice.  Returns a key (letters in upper case), or
0004A0r 1               ; PAD_GO for the gamepad's A or Start button.
0004A0r 1               menu_key:
0004A0r 1  20 rr rr 20  @l:     MENU_IDLE
0004A4r 1  rr rr        
0004A6r 1  20 rr rr             jsr     read_pad
0004A9r 1  AD rr rr             lda     padnew
0004ACr 1  29 09                and     #PAD_A | PAD_START
0004AEr 1  D0 21                bne     @pad
0004B0r 1  20 00 FE             jsr     getc
0004B3r 1  90 EB                bcc     @l
0004B5r 1  C9 20                cmp     #' '            ; a space typed by the pad's A button?
0004B7r 1  D0 0D                bne     @up
0004B9r 1  20 rr rr             jsr     read_pad
0004BCr 1  AD rr rr             lda     pad
0004BFr 1  29 01                and     #PAD_A
0004C1r 1  D0 0E                bne     @pad
0004C3r 1  A9 20                lda     #' '
0004C5r 1  60                   rts
0004C6r 1  C9 61        @up:    cmp     #'a'
0004C8r 1  90 06                bcc     @r
0004CAr 1  C9 7B                cmp     #'z'+1
0004CCr 1  B0 02                bcs     @r
0004CEr 1  29 DF                and     #$DF
0004D0r 1  60           @r:     rts
0004D1r 1  20 rr rr     @pad:   jsr     flush_in        ; the space the driver typed for it
0004D4r 1  A9 80                lda     #PAD_GO
0004D6r 1  60                   rts
0004D7r 1               
0004D7r 1               ; print the controls line (CTRL_COL, CTRL_ROW)
0004D7r 1               show_ctrl:
0004D7r 1  20 rr rr             jsr     txt_mode
0004DAr 1  A2 13                ldx     #CTRL_COL
0004DCr 1  A0 11                ldy     #CTRL_ROW
0004DEr 1  20 rr rr             jsr     gotoxy
0004E1r 1  AD rr rr             lda     ctrl
0004E4r 1  F0 07                beq     @kb
0004E6r 1  A9 rr                lda     #<ctrl_pad_txt
0004E8r 1  A0 rr                ldy     #>ctrl_pad_txt
0004EAr 1  4C rr rr             jmp     print
0004EDr 1  A9 rr        @kb:    lda     #<ctrl_kb_txt
0004EFr 1  A0 rr                ldy     #>ctrl_kb_txt
0004F1r 1  4C rr rr             jmp     print
0004F4r 1               
0004F4r 1               ; ============================================================================
0004F4r 1               ; maths
0004F4r 1               ; ============================================================================
0004F4r 1               
0004F4r 1               ; m_lo/m_hi = A * Y (unsigned 8 x 8), with quarter squares:
0004F4r 1               ; a*b = f(a+b) - f(a-b), f(n) = n*n/4.  Changes X.
0004F4r 1  8D rr rr     mul8:   sta     m_a
0004F7r 1  8C rr rr             sty     m_b
0004FAr 1  18                   clc
0004FBr 1  6D rr rr             adc     m_b
0004FEr 1  AA                   tax
0004FFr 1  B0 0F                bcs     @big
000501r 1  BD rr rr             lda     sq_lo,x
000504r 1  8D rr rr             sta     m_lo
000507r 1  BD rr rr             lda     sq_hi,x
00050Ar 1  8D rr rr             sta     m_hi
00050Dr 1  4C rr rr             jmp     @diff
000510r 1  BD rr rr     @big:   lda     sq2_lo,x
000513r 1  8D rr rr             sta     m_lo
000516r 1  BD rr rr             lda     sq2_hi,x
000519r 1  8D rr rr             sta     m_hi
00051Cr 1  AD rr rr     @diff:  lda     m_a
00051Fr 1  38                   sec
000520r 1  ED rr rr             sbc     m_b
000523r 1  B0 04                bcs     @pos
000525r 1  49 FF                eor     #$FF
000527r 1  69 01                adc     #1              ; (carry is clear)
000529r 1  AA           @pos:   tax
00052Ar 1  AD rr rr             lda     m_lo
00052Dr 1  38                   sec
00052Er 1  FD rr rr             sbc     sq_lo,x
000531r 1  8D rr rr             sta     m_lo
000534r 1  AD rr rr             lda     m_hi
000537r 1  FD rr rr             sbc     sq_hi,x
00053Ar 1  8D rr rr             sta     m_hi
00053Dr 1  60                   rts
00053Er 1               
00053Er 1               ; r_lo/r_hi = (A * w) >> 8, w = w_lo/w_hi unsigned 16 bit.
00053Er 1               ; Two quarter-square products: a*b = sq(a+b) - sq(a-b), sq(n) = n*n/4
00053Er 1               ; (sq2 is the table for sums of 256 and more).
00053Er 1  8D rr rr     mul8x16:sta     mf
000541r 1  38                   sec                     ; low product: only its high byte is needed
000542r 1  ED rr rr             sbc     w_lo
000545r 1  B0 04                bcs     @d1
000547r 1  49 FF                eor     #$FF
000549r 1  69 01                adc     #1
00054Br 1  A8           @d1:    tay                     ; |f - w_lo|
00054Cr 1  AD rr rr             lda     mf
00054Fr 1  18                   clc
000550r 1  6D rr rr             adc     w_lo
000553r 1  AA                   tax                     ; f + w_lo
000554r 1  B0 13                bcs     @b1
000556r 1  38                   sec
000557r 1  BD rr rr             lda     sq_lo,x
00055Ar 1  F9 rr rr             sbc     sq_lo,y
00055Dr 1  BD rr rr             lda     sq_hi,x
000560r 1  F9 rr rr             sbc     sq_hi,y
000563r 1  8D rr rr             sta     r_lo
000566r 1  4C rr rr             jmp     @p2
000569r 1  38           @b1:    sec
00056Ar 1  BD rr rr             lda     sq2_lo,x
00056Dr 1  F9 rr rr             sbc     sq_lo,y
000570r 1  BD rr rr             lda     sq2_hi,x
000573r 1  F9 rr rr             sbc     sq_hi,y
000576r 1  8D rr rr             sta     r_lo
000579r 1  AD rr rr     @p2:    lda     mf              ; high product, added in
00057Cr 1  38                   sec
00057Dr 1  ED rr rr             sbc     w_hi
000580r 1  B0 04                bcs     @d2
000582r 1  49 FF                eor     #$FF
000584r 1  69 01                adc     #1
000586r 1  A8           @d2:    tay
000587r 1  AD rr rr             lda     mf
00058Ar 1  18                   clc
00058Br 1  6D rr rr             adc     w_hi
00058Er 1  AA                   tax
00058Fr 1  B0 13                bcs     @b2
000591r 1  38                   sec
000592r 1  BD rr rr             lda     sq_lo,x
