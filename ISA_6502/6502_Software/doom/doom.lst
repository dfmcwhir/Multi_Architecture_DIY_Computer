000376r 1  A9 1A                lda     #TC_LIT
000378r 1  20 rr rr             jsr     putc
00037Br 1  68                   pla
00037Cr 1  4C rr rr     @out:   jmp     putc
00037Fr 1               
00037Fr 1               ; cursor to column X, row Y.  Preserves X and Y.
00037Fr 1  A9 0F        gotoxy: lda     #TC_ROW
000381r 1  20 rr rr             jsr     putc
000384r 1  98                   tya
000385r 1  20 rr rr             jsr     putc
000388r 1  A9 0E        setcol: lda     #TC_COL         ; (column X only)
00038Ar 1  20 rr rr             jsr     putc
