000A30r 1               
000A30r 1               ; draw column col: ceiling (blank), wall (pat) from y0 to y1, floor below.
000A30r 1               ; Character rows r0 .. r1 hold the wall; the first and last may be partly
000A30r 1               ; wall and partly background: (pat & mask) | (floor & ~mask).
000A30r 1               ; The background goes in first (bg_chain), then the whole wall characters
000A30r 1               ; (a run of wall_chain, stopped by a temporary RTS), then the two ends.
000A30r 1               draw_column:
000A30r 1  20 rr rr             jsr     sfx_poll        ; (once a column)
000A33r 1  AE rr rr             ldx     hgt             ; where the wall starts and ends (tables)
000A36r 1  BD rr rr             lda     dc_r0,x
000A39r 1  8D rr rr             sta     r0
000A3Cr 1  BD rr rr             lda     dc_t0,x
000A3Fr 1  8D rr rr             sta     t0
000A42r 1  BD rr rr             lda     dc_r1,x
000A45r 1  8D rr rr             sta     r1
000A48r 1  BD rr rr             lda     dc_t1,x
000A4Br 1  8D rr rr             sta     t1
000A4Er 1  AC rr rr             ldy     col
000A51r 1  20 rr rr             jsr     bg_chain        ; (keeps Y)
000A54r 1  AE rr rr             ldx     r0              ; first whole wall character
000A57r 1  AD rr rr             lda     t0
000A5Ar 1  F0 01                beq     @f0
000A5Cr 1  E8                   inx
000A5Dr 1  EC rr rr     @f0:    cpx     r1
000A60r 1  B0 31                bcs     @ends
