000000r 1               WINCH_Y         = 6
000000r 1               PLAT_X          = 60
000000r 1               PLAT_Y          = 14
000000r 1               PIT_TOP         = 24            ; nothing lies higher than this
000000r 1               
000000r 1               ; ---- the things in the pit ----------------------------------------------------------
000000r 1               NITEM           = 24
000000r 1               K_NONE          = 0
000000r 1               K_GEM           = 1
000000r 1               K_CHEST_S       = 2
000000r 1               K_CHEST_L       = 3
000000r 1               K_ROCK_S        = 4
000000r 1               K_ROCK_L        = 5
000000r 1               K_TNT           = 6
000000r 1               K_GOPHER        = 7
000000r 1               GEM_V           = 250           ; a gem's value
000000r 1               GOPHER_V        = 7
000000r 1               GOPHER_SPD      = $60           ; 0.375 pixels a frame
000000r 1               NEXP            = 6             ; explosions at a time
000000r 1               EXP_T           = 12            ; frames
000000r 1               BLAST_R         = 22            ; TNT reaches this far (pixels, centre to centre)
000000r 1               
000000r 1               ; ---- the grabber ---------------------------------------------------------------------
000000r 1               H_SWING         = 0
000000r 1               H_OUT           = 1
000000r 1               H_BACK          = 2
000000r 1               OUT_SPD         = $0300         ; pixels a frame (8.8)
000000r 1               BACK_SPD        = $0400         ; ... coming back empty
000000r 1               LEVEL_TIME      = 60            ; seconds
000000r 1               
