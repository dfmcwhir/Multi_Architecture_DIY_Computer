0001A2r 2  8E 23 7F             stx     SFX_AY_DATA
0001A5r 2  AE rr rr             ldx     sfx_chan
0001A8r 2  CA                   dex
0001A9r 2  10 85                bpl     @ch
0001ABr 2  A9 07                lda     #7
0001ADr 2  8D 22 7F             sta     SFX_AY_ADDR
0001B0r 2  AD rr rr             lda     sfx_mixer
0001B3r 2  8D 23 7F             sta     SFX_AY_DATA
0001B6r 2  60                   rts
0001B7r 2  3E 3D 3B     sfx_tone_on:    .byte   $3E, $3D, $3B
0001BAr 2  37 2F 1F     sfx_noise_on:   .byte   $37, $2F, $1F
0001BDr 2               
0001BDr 2               ; one voice (X): the sweep and the decay, then the script when its wait
0001BDr 2               ; is over
0001BDr 2               sfx_voice:
0001BDr 2  BD rr rr             lda     sfx_swl,x       ; the sweep
0001C0r 2  1D rr rr             ora     sfx_swh,x
0001C3r 2  F0 13                beq     @ns
0001C5r 2  BD rr rr             lda     sfx_perl,x
0001C8r 2  18                   clc
0001C9r 2  7D rr rr             adc     sfx_swl,x
0001CCr 2  9D rr rr             sta     sfx_perl,x
0001CFr 2  BD rr rr             lda     sfx_perh,x
0001D2r 2  7D rr rr             adc     sfx_swh,x
0001D5r 2  9D rr rr             sta     sfx_perh,x
0001D8r 2  BD rr rr     @ns:    lda     sfx_dec,x       ; the decay
0001DBr 2  F0 10                beq     @nd
0001DDr 2  DE rr rr             dec     sfx_decc,x
0001E0r 2  D0 0B                bne     @nd
0001E2r 2  9D rr rr             sta     sfx_decc,x
0001E5r 2  BD rr rr             lda     sfx_vol,x
0001E8r 2  F0 03                beq     @nd
0001EAr 2  DE rr rr             dec     sfx_vol,x
0001EDr 2  BD rr rr     @nd:    lda     sfx_wait,x
0001F0r 2  F0 06                beq     @run
0001F2r 2  DE rr rr             dec     sfx_wait,x
0001F5r 2  F0 01                beq     @run
0001F7r 2  60                   rts
0001F8r 2  A9 28        @run:   lda     #40             ; (at most 40 commands a tick: a script that
0001FAr 2  8D rr rr             sta     sfx_guard       ;  never waits can't hang the game)
0001FDr 2  CE rr rr     @cmd:   dec     sfx_guard
000200r 2  F0 76                beq     @stop
000202r 2  20 rr rr             jsr     sfx_byte
000205r 2  C9 80                cmp     #$80
000207r 2  90 09                bcc     @nw
000209r 2  29 7F                and     #$7F            ; wait
00020Br 2  9D rr rr             sta     sfx_wait,x
00020Er 2  FE rr rr             inc     sfx_wait,x
000211r 2  60                   rts
000212r 2  C9 20        @nw:    cmp     #$20
000214r 2  90 54                bcc     @op
000216r 2  38                   sec                     ; a note
000217r 2  E9 20                sbc     #$20
000219r 2  C9 60                cmp     #96
00021Br 2  90 02                bcc     @nt
00021Dr 2  A9 5F                lda     #95
00021Fr 2  A0 00        @nt:    ldy     #0              ; octave Y, note A in it
000221r 2  C9 0C        @oc:    cmp     #12
000223r 2  90 05                bcc     @ok
000225r 2  E9 0C                sbc     #12
000227r 2  C8                   iny
000228r 2  D0 F7                bne     @oc
00022Ar 2  8C rr rr     @ok:    sty     sfx_guard+1     ; (as a count)
00022Dr 2  A8                   tay
00022Er 2  B9 rr rr             lda     sfx_c1_lo,y     ; the period in octave 1, halved for each
000231r 2  9D rr rr             sta     sfx_perl,x      ; octave up
000234r 2  B9 rr rr             lda     sfx_c1_hi,y
000237r 2  AC rr rr             ldy     sfx_guard+1
00023Ar 2  F0 16                beq     @p
00023Cr 2  4A           @sh:    lsr
00023Dr 2  7E rr rr             ror     sfx_perl,x
000240r 2  88                   dey
000241r 2  D0 F9                bne     @sh
000243r 2  9D rr rr             sta     sfx_perh,x      ; (rounded: the last bit out was a half)
000246r 2  90 0D                bcc     @r0
000248r 2  FE rr rr             inc     sfx_perl,x
00024Br 2  D0 08                bne     @r0
00024Dr 2  FE rr rr             inc     sfx_perh,x
000250r 2  D0 03                bne     @r0
000252r 2  9D rr rr     @p:     sta     sfx_perh,x
000255r 2               @r0:
000255r 2  BD rr rr             lda     sfx_base,x
000258r 2  9D rr rr             sta     sfx_vol,x
00025Br 2  BD rr rr             lda     sfx_dec,x
00025Er 2  9D rr rr             sta     sfx_decc,x
000261r 2  BD rr rr     @len:   lda     sfx_len,x       ; (LEN: wait that long)
000264r 2  F0 97                beq     @cmd
000266r 2  9D rr rr             sta     sfx_wait,x
000269r 2  60                   rts
00026Ar 2  C9 0C        @op:    cmp     #12
00026Cr 2  B0 0A                bcs     @stop
00026Er 2  A8                   tay
00026Fr 2  B9 rr rr             lda     @hi,y
000272r 2  48                   pha
000273r 2  B9 rr rr             lda     @lo,y
000276r 2  48                   pha
000277r 2  60                   rts                     ; (to the command, which goes back to @cmd)
000278r 2  A9 00        @stop:  lda     #0
00027Ar 2  9D rr rr             sta     sfx_hi,x
00027Dr 2  9D rr rr             sta     sfx_vol,x
000280r 2  60                   rts
000281r 2  rr rr rr rr  @lo:    .lobytes  @stop-1, @per-1, @vl-1, @noi-1, @mix-1, @sw-1, @dc-1, @lp-1, @nx-1, @jp-1, @rest-1, @ln-1
000285r 2  rr rr rr rr  
000289r 2  rr rr rr rr  
00028Dr 2  rr rr rr rr  @hi:    .hibytes  @stop-1, @per-1, @vl-1, @noi-1, @mix-1, @sw-1, @dc-1, @lp-1, @nx-1, @jp-1, @rest-1, @ln-1
000291r 2  rr rr rr rr  
000295r 2  rr rr rr rr  
000299r 2  20 rr rr     @per:   jsr     sfx_byte
00029Cr 2  9D rr rr             sta     sfx_perl,x
00029Fr 2  20 rr rr             jsr     sfx_byte
0002A2r 2  9D rr rr             sta     sfx_perh,x
0002A5r 2  4C rr rr             jmp     @cmd
0002A8r 2  20 rr rr     @vl:    jsr     sfx_byte
0002ABr 2  9D rr rr             sta     sfx_base,x
0002AEr 2  9D rr rr             sta     sfx_vol,x
0002B1r 2  BD rr rr             lda     sfx_dec,x
0002B4r 2  9D rr rr             sta     sfx_decc,x
0002B7r 2  4C rr rr             jmp     @cmd
0002BAr 2  20 rr rr     @noi:   jsr     sfx_byte
0002BDr 2  9D rr rr             sta     sfx_noise,x
0002C0r 2  4C rr rr             jmp     @cmd
0002C3r 2  20 rr rr     @mix:   jsr     sfx_byte
0002C6r 2  9D rr rr             sta     sfx_mix,x
0002C9r 2  4C rr rr             jmp     @cmd
0002CCr 2  20 rr rr     @sw:    jsr     sfx_byte
0002CFr 2  9D rr rr             sta     sfx_swl,x
0002D2r 2  20 rr rr             jsr     sfx_byte
0002D5r 2  9D rr rr             sta     sfx_swh,x
0002D8r 2  4C rr rr             jmp     @cmd
0002DBr 2  20 rr rr     @dc:    jsr     sfx_byte
0002DEr 2  9D rr rr             sta     sfx_dec,x
0002E1r 2  9D rr rr             sta     sfx_decc,x
0002E4r 2  4C rr rr             jmp     @cmd
0002E7r 2  20 rr rr     @lp:    jsr     sfx_byte
0002EAr 2  9D rr rr             sta     sfx_lcnt,x
0002EDr 2  BD rr rr             lda     sfx_lo,x
0002F0r 2  9D rr rr             sta     sfx_lpl,x
0002F3r 2  BD rr rr             lda     sfx_hi,x
0002F6r 2  9D rr rr             sta     sfx_lph,x
0002F9r 2  4C rr rr             jmp     @cmd
0002FCr 2  BD rr rr     @nx:    lda     sfx_lcnt,x
0002FFr 2  F0 05                beq     @back           ; (0: for ever)
000301r 2  DE rr rr             dec     sfx_lcnt,x
000304r 2  F0 0C                beq     @go
000306r 2  BD rr rr     @back:  lda     sfx_lpl,x
000309r 2  9D rr rr             sta     sfx_lo,x
00030Cr 2  BD rr rr             lda     sfx_lph,x
00030Fr 2  9D rr rr             sta     sfx_hi,x
000312r 2  4C rr rr     @go:    jmp     @cmd
000315r 2  20 rr rr     @jp:    jsr     sfx_byte
000318r 2  48                   pha
000319r 2  20 rr rr             jsr     sfx_byte
00031Cr 2  9D rr rr             sta     sfx_hi,x
00031Fr 2  68                   pla
000320r 2  9D rr rr             sta     sfx_lo,x
000323r 2  4C rr rr             jmp     @cmd
000326r 2  A9 00        @rest:  lda     #0
000328r 2  9D rr rr             sta     sfx_vol,x
00032Br 2  4C rr rr             jmp     @len
00032Er 2  20 rr rr     @ln:    jsr     sfx_byte
000331r 2  9D rr rr             sta     sfx_len,x
000334r 2  4C rr rr             jmp     @cmd
000337r 2               
000337r 2               ; the next byte of voice X's script
000337r 2               sfx_byte:
000337r 2  BD rr rr             lda     sfx_lo,x
00033Ar 2  8D rr rr             sta     @ld+1
00033Dr 2  BD rr rr             lda     sfx_hi,x
000340r 2  8D rr rr             sta     @ld+2
000343r 2  AD FF FF     @ld:    lda     $FFFF
000346r 2  FE rr rr             inc     sfx_lo,x
000349r 2  D0 03                bne     @r
00034Br 2  FE rr rr             inc     sfx_hi,x
00034Er 2  60           @r:     rts
00034Fr 2               
00034Fr 2               ; the tone periods of C1 .. B1 for the 2 MHz chip clock: 2 MHz / (16 x
00034Fr 2               ; frequency); each octave up is half (to within a third of a percent)
00034Fr 2  EE 18 4D 8E  sfx_c1_lo:  .lobytes 3822, 3608, 3405, 3214, 3034, 2863, 2703, 2551, 2408, 2273, 2145, 2025
000353r 2  DA 2F 8F F7  
000357r 2  68 E1 61 E9  
00035Br 2  0E 0E 0D 0C  sfx_c1_hi:  .hibytes 3822, 3608, 3405, 3214, 3034, 2863, 2703, 2551, 2408, 2273, 2145, 2025
00035Fr 2  0B 0B 0A 09  
000363r 2  09 08 08 07  
000367r 2               
000367r 2               
000367r 1               
000367r 1               ; ----------------------------------------------------------------------------
000367r 1               ; I/O helpers
000367r 1               ; ----------------------------------------------------------------------------
000367r 1               getc            = SBC_CHRIN     ; carry set = key in A
000367r 1               
000367r 1               ; send A (counts the bytes, for the frame timing).  Preserves A, X, Y.
000367r 1  EE rr rr     putc:   inc     nbytes
00036Ar 1  D0 03                bne     @p
00036Cr 1  EE rr rr             inc     nbytes+1
00036Fr 1  20 rr rr     @p:     jsr     sfx_poll        ; (the sound goes on while drawing)
000372r 1  4C 03 FE             jmp     SBC_CHROUT
000375r 1               
000375r 1               ; cursor to column X, row Y.  Preserves X and Y.
000375r 1  A9 0F        gotoxy: lda     #TC_ROW
000377r 1  20 rr rr             jsr     putc
00037Ar 1  98                   tya
00037Br 1  20 rr rr             jsr     putc
00037Er 1  A9 0E        setcol: lda     #TC_COL
000380r 1  20 rr rr             jsr     putc
000383r 1  8A                   txa
000384r 1  4C rr rr             jmp     putc
000387r 1               
000387r 1               txt_mode:
000387r 1  A9 00                lda     #ATTR_TEXT
000389r 1  F0 02                beq     setattr
00038Br 1               gfx_mode:
00038Br 1  A9 80                lda     #ATTR_GFX
00038Dr 1  CD rr rr     setattr:cmp     attr
000390r 1  F0 0D                beq     @r
000392r 1  8D rr rr             sta     attr
000395r 1  48                   pha
000396r 1  A9 18                lda     #TC_ATTR
000398r 1  20 rr rr             jsr     putc
00039Br 1  68                   pla
00039Cr 1  4C rr rr             jmp     putc
00039Fr 1  60           @r:     rts
0003A0r 1               
0003A0r 1               ; repeat every character A times from now on (1..15), block graphics
0003A0r 1  8D rr rr     set_rep:sta     cur_rep
0003A3r 1  C9 02                cmp     #2
0003A5r 1  90 08                bcc     @one
0003A7r 1  0A                   asl
0003A8r 1  0A                   asl
0003A9r 1  0A                   asl
0003AAr 1  09 80                ora     #ATTR_GFX
0003ACr 1  4C rr rr             jmp     setattr         ; (sends it only if it changes)
0003AFr 1  A9 80        @one:   lda     #ATTR_GFX
0003B1r 1  4C rr rr             jmp     setattr
0003B4r 1               
0003B4r 1               ; a block graphics character (00-1F and 7F need the 1A prefix)
0003B4r 1  C9 20        putblk: cmp     #$20
0003B6r 1  90 04                bcc     @lit
0003B8r 1  C9 7F                cmp     #$7F
0003BAr 1  D0 07                bne     @out
0003BCr 1  48           @lit:   pha
0003BDr 1  A9 1A                lda     #TC_LIT
0003BFr 1  20 rr rr             jsr     putc
0003C2r 1  68                   pla
0003C3r 1  4C rr rr     @out:   jmp     putc
0003C6r 1               
0003C6r 1               ; print the string at A (lo) / Y (hi), ended by TERM (any length)
0003C6r 1  8D rr rr     print:  sta     @ld+1
0003C9r 1  8C rr rr             sty     @ld+2
0003CCr 1  AD FF FF     @ld:    lda     $FFFF
0003CFr 1  C9 FF                cmp     #TERM
0003D1r 1  F0 0D                beq     @done
0003D3r 1  20 rr rr             jsr     putc
0003D6r 1  EE rr rr             inc     @ld+1
0003D9r 1  D0 F1                bne     @ld
0003DBr 1  EE rr rr             inc     @ld+2
0003DEr 1  D0 EC                bne     @ld
0003E0r 1  A9 FF        @done:  lda     #$FF            ; (strings may change the attribute)
0003E2r 1  8D rr rr             sta     attr
0003E5r 1  60                   rts
0003E6r 1               
0003E6r 1               ; print A as two BCD digits
0003E6r 1  48           prbcd:  pha
0003E7r 1  4A                   lsr
0003E8r 1  4A                   lsr
0003E9r 1  4A                   lsr
0003EAr 1  4A                   lsr
0003EBr 1  09 30                ora     #'0'
0003EDr 1  20 rr rr             jsr     putc
0003F0r 1  68                   pla
0003F1r 1  29 0F                and     #$0F
0003F3r 1  09 30                ora     #'0'
0003F5r 1  4C rr rr             jmp     putc
0003F8r 1               
0003F8r 1               ; 16 bit Galois LFSR.  A = a random byte.  Preserves X and Y.
0003F8r 1  AD rr rr     rand:   lda     rng+1
0003FBr 1  4A                   lsr
0003FCr 1  6E rr rr             ror     rng
0003FFr 1  90 02                bcc     @n
000401r 1  49 B4                eor     #$B4
000403r 1  8D rr rr     @n:     sta     rng+1
000406r 1  4D rr rr             eor     rng
000409r 1  60                   rts
00040Ar 1               
00040Ar 1               ; wait about A ms.  The inner loop is sized for the clock (CLOCK_MHZ in
00040Ar 1               ; sbc_api.inc): 5 + 4 * (CLOCK_MHZ - 1) cycles a turn, DELAY_N turns a ms.
00040Ar 1               DELAY_N = (1000 * CLOCK_MHZ - 7) / (5 + 4 * (CLOCK_MHZ - 1))
00040Ar 1               delay_ms:
00040Ar 1  AA                   tax
00040Br 1  F0 0D                beq     @done
00040Dr 1  20 rr rr     @o:     jsr     sfx_poll        ; (and while waiting)
000410r 1  A0 DD                ldy     #DELAY_N
000412r 1               @i:
000412r 1  EA EA        .repeat CLOCK_MHZ - 1
000414r 1                       nop
000414r 1                       nop
000414r 1               .endrepeat
000414r 1  88                   dey
000415r 1  D0 FB                bne     @i
000417r 1  CA                   dex
000418r 1  D0 F3                bne     @o
00041Ar 1  60           @done:  rts
00041Br 1               
00041Br 1               ; wait about A x 50 ms, dropping keys pressed meanwhile
00041Br 1               delay_long:
00041Br 1  8D rr rr             sta     tmp
00041Er 1  A9 32        @l:     lda     #50
000420r 1  20 rr rr             jsr     delay_ms
000423r 1  20 rr rr             jsr     flush_in
000426r 1  CE rr rr             dec     tmp
000429r 1  D0 F3                bne     @l
00042Br 1  60                   rts
00042Cr 1               
00042Cr 1               .macro MENU_IDLE
00042Cr 1                       jsr     rand            ; (waiting stirs the random numbers)
00042Cr 1                       jsr     sfx_poll
00042Cr 1               .endmacro
00042Cr 1               CTRL_COL        = 19
00042Cr 1               CTRL_ROW        = 22
00042Cr 1               
00042Cr 1               ; ============================================================================
00042Cr 1               ; gamepad and menu input (shared by the SBC games)
00042Cr 1               ; ============================================================================
00042Cr 1               PAD_A           = $01           ; bits returned by SBC_PADSTATE
00042Cr 1               PAD_B           = $02
00042Cr 1               PAD_SELECT      = $04
00042Cr 1               PAD_START       = $08
00042Cr 1               PAD_UP          = $10
00042Cr 1               PAD_DOWN        = $20
00042Cr 1               PAD_LEFT        = $40
00042Cr 1               PAD_RIGHT       = $80
00042Cr 1               PAD_GO          = $80           ; menu_key's answer for gamepad A or Start
00042Cr 1               
00042Cr 1               ; read the gamepad: pad = buttons held now, padnew = buttons pressed since
00042Cr 1               ; the last call.  Preserves X and Y (SBC_PADSTATE only changes A).
00042Cr 1               read_pad:
00042Cr 1  20 12 FE             jsr     SBC_PADSTATE
00042Fr 1  C9 FF                cmp     #$FF            ; every button "pressed" = no pad
000431r 1  D0 02                bne     @ok
000433r 1  A9 00                lda     #0
000435r 1  8D rr rr     @ok:    sta     pad
000438r 1  AD rr rr             lda     padold
00043Br 1  49 FF                eor     #$FF
00043Dr 1  2D rr rr             and     pad
000440r 1  8D rr rr             sta     padnew
000443r 1  AD rr rr             lda     pad
000446r 1  8D rr rr             sta     padold
000449r 1  60                   rts
00044Ar 1               
00044Ar 1               ; throw away waiting characters
00044Ar 1               flush_in:
00044Ar 1  20 00 FE             jsr     getc
00044Dr 1  B0 FB                bcs     flush_in
00044Fr 1  60                   rts
000450r 1               
000450r 1               ; carry set if A is one of the characters the gamepad driver types for the
000450r 1               ; pad (W A S D and space).  Those are ignored in gamepad mode so that one
000450r 1               ; press doesn't act twice.  Preserves A.
000450r 1               pad_typed:
000450r 1  C9 20                cmp     #' '
000452r 1  F0 12                beq     @y
000454r 1  C9 57                cmp     #'W'
000456r 1  F0 0E                beq     @y
000458r 1  C9 41                cmp     #'A'
00045Ar 1  F0 0A                beq     @y
00045Cr 1  C9 53                cmp     #'S'
00045Er 1  F0 06                beq     @y
000460r 1  C9 44                cmp     #'D'
000462r 1  F0 02                beq     @y
000464r 1  18                   clc
000465r 1  60                   rts
000466r 1  38           @y:     sec
000467r 1  60                   rts
000468r 1               
000468r 1               ; wait for a menu choice.  Returns a key (letters in upper case), or
000468r 1               ; PAD_GO for the gamepad's A or Start button.
000468r 1               menu_key:
000468r 1  20 rr rr 20  @l:     MENU_IDLE
00046Cr 1  rr rr        
00046Er 1  20 rr rr             jsr     read_pad
000471r 1  AD rr rr             lda     padnew
000474r 1  29 09                and     #PAD_A | PAD_START
000476r 1  D0 21                bne     @pad
000478r 1  20 00 FE             jsr     getc
00047Br 1  90 EB                bcc     @l
00047Dr 1  C9 20                cmp     #' '            ; a space typed by the pad's A button?
00047Fr 1  D0 0D                bne     @up
000481r 1  20 rr rr             jsr     read_pad
000484r 1  AD rr rr             lda     pad
000487r 1  29 01                and     #PAD_A
000489r 1  D0 0E                bne     @pad
00048Br 1  A9 20                lda     #' '
00048Dr 1  60                   rts
00048Er 1  C9 61        @up:    cmp     #'a'
000490r 1  90 06                bcc     @r
000492r 1  C9 7B                cmp     #'z'+1
000494r 1  B0 02                bcs     @r
000496r 1  29 DF                and     #$DF
000498r 1  60           @r:     rts
000499r 1  20 rr rr     @pad:   jsr     flush_in        ; the space the driver typed for it
00049Cr 1  A9 80                lda     #PAD_GO
00049Er 1  60                   rts
00049Fr 1               
00049Fr 1               ; print the controls line (CTRL_COL, CTRL_ROW)
00049Fr 1               show_ctrl:
00049Fr 1  20 rr rr             jsr     txt_mode
0004A2r 1  A2 13                ldx     #CTRL_COL
0004A4r 1  A0 16                ldy     #CTRL_ROW
0004A6r 1  20 rr rr             jsr     gotoxy
0004A9r 1  AD rr rr             lda     ctrl
0004ACr 1  F0 07                beq     @kb
0004AEr 1  A9 rr                lda     #<ctrl_pad_txt
0004B0r 1  A0 rr                ldy     #>ctrl_pad_txt
0004B2r 1  4C rr rr             jmp     print
0004B5r 1  A9 rr        @kb:    lda     #<ctrl_kb_txt
0004B7r 1  A0 rr                ldy     #>ctrl_kb_txt
0004B9r 1  4C rr rr             jmp     print
0004BCr 1               
0004BCr 1               ; ============================================================================
0004BCr 1               ; start, title
0004BCr 1               ; ============================================================================
0004BCr 1  D8           start:  cld
0004BDr 1  A2 FF                ldx     #$FF
0004BFr 1  9A                   txs
0004C0r 1  A9 00                lda     #0              ; clear the variables (RAM is random at power-up)
0004C2r 1  AA                   tax
0004C3r 1  A0 03                ldy     #>(bss_end - bss_start + $FF)
0004C5r 1  9D rr rr     @c1:    sta     bss_start,x
0004C8r 1  E8                   inx
0004C9r 1  D0 FA                bne     @c1
0004CBr 1  EE rr rr             inc     @c1+2
0004CEr 1  88                   dey
0004CFr 1  D0 F4                bne     @c1
0004D1r 1  AD rr rr             lda     ctrl_def
0004D4r 1  8D rr rr             sta     ctrl
0004D7r 1  A9 5A                lda     #$5A
0004D9r 1  8D rr rr             sta     rng
0004DCr 1  A9 FF                lda     #$FF
0004DEr 1  8D rr rr             sta     attr
0004E1r 1  20 rr rr             jsr     sfx_init
0004E4r 1  AD rr rr             lda     mute_def
0004E7r 1  8D rr rr             sta     sfx_mute
0004EAr 1               
0004EAr 1  20 rr rr     title:  jsr     sfx_off
0004EDr 1  20 rr rr             jsr     new_screen
0004F0r 1  A9 rr                lda     #<title_txt
0004F2r 1  A0 rr                ldy     #>title_txt
0004F4r 1  20 rr rr             jsr     print
0004F7r 1  20 rr rr             jsr     hi_title
0004FAr 1  A9 01                lda     #1              ; the pictures for the list of things
0004FCr 1  8D rr rr             sta     pmode
0004FFr 1  A2 00                ldx     #0
000501r 1  8E rr rr     @p:     stx     tmp3
000504r 1  BD rr rr             lda     tp_x,x
000507r 1  8D rr rr             sta     ox
00050Ar 1  BD rr rr             lda     tp_y,x
00050Dr 1  8D rr rr             sta     oy
000510r 1  BD rr rr             lda     tp_spr,x
000513r 1  20 rr rr             jsr     draw_spr
000516r 1  AE rr rr             ldx     tmp3
000519r 1  E8                   inx
00051Ar 1  E0 08                cpx     #NTP
00051Cr 1  D0 E3                bne     @p
00051Er 1  20 rr rr             jsr     show_all
000521r 1  20 rr rr             jsr     show_ctrl
000524r 1  20 rr rr             jsr     read_pad
000527r 1  20 rr rr             jsr     flush_in
00052Ar 1  20 rr rr     @wait:  jsr     menu_key
00052Dr 1  C9 51                cmp     #'Q'
00052Fr 1  D0 03                bne     @notq
000531r 1  4C rr rr             jmp     exit_game
000534r 1  C9 4D        @notq:  cmp     #'M'            ; sound on / off
000536r 1  D0 06                bne     @notm
000538r 1  20 rr rr             jsr     sfx_toggle
00053Br 1  4C rr rr             jmp     @wait
00053Er 1  C9 47        @notm:  cmp     #'G'
000540r 1  D0 0E                bne     @notg
000542r 1  AD rr rr             lda     ctrl
000545r 1  49 01                eor     #1
000547r 1  8D rr rr             sta     ctrl
00054Ar 1  20 rr rr             jsr     show_ctrl
00054Dr 1  4C rr rr             jmp     @wait
000550r 1  C9 80        @notg:  cmp     #PAD_GO
000552r 1  D0 08                bne     @notp
000554r 1  A9 01                lda     #1
000556r 1  8D rr rr             sta     ctrl
000559r 1  4C rr rr             jmp     new_game
00055Cr 1  C9 20        @notp:  cmp     #' '
00055Er 1  D0 CA                bne     @wait
000560r 1  4C rr rr             jmp     new_game
000563r 1               
000563r 1               hi_title:
000563r 1  AD rr rr             lda     hi_money        ; (none yet: nothing)
000566r 1  0D rr rr             ora     hi_money+1
000569r 1  0D rr rr             ora     hi_money+2
00056Cr 1  D0 01                bne     @go
00056Er 1  60                   rts
00056Fr 1  20 rr rr     @go:    jsr     txt_mode
000572r 1  A2 18                ldx     #24
000574r 1  A0 14                ldy     #20
000576r 1  20 rr rr             jsr     gotoxy
000579r 1  A9 rr                lda     #<hi_txt
00057Br 1  A0 rr                ldy     #>hi_txt
00057Dr 1  20 rr rr             jsr     print
000580r 1  A2 02                ldx     #2
000582r 1  BD rr rr     @c:     lda     hi_money,x
000585r 1  9D rr rr             sta     num,x
000588r 1  CA                   dex
000589r 1  10 F7                bpl     @c
00058Br 1  20 rr rr             jsr     prnum
00058Er 1  A9 rr                lda     #<hi2_txt
000590r 1  A0 rr                ldy     #>hi2_txt
000592r 1  20 rr rr             jsr     print
000595r 1  AD rr rr             lda     hi_level
000598r 1  4C rr rr             jmp     pr8
00059Br 1               
00059Br 1               exit_game:
00059Br 1  20 rr rr             jsr     sfx_off
00059Er 1  A9 rr                lda     #<bye_txt
0005A0r 1  A0 rr                ldy     #>bye_txt
0005A2r 1  20 rr rr             jsr     print
0005A5r 1  4C 06 FE             jmp     SBC_MENU
0005A8r 1               
0005A8r 1               ; clear the screen and forget what it showed
0005A8r 1               new_screen:
0005A8r 1  A9 rr                lda     #<cls_txt
0005AAr 1  A0 rr                ldy     #>cls_txt
0005ACr 1  20 rr rr             jsr     print
0005AFr 1  A9 00                lda     #0
0005B1r 1  AA                   tax
0005B2r 1  9D rr rr 9D  @c:     .repeat 8, K
0005B6r 1  rr rr 9D rr  
0005BAr 1  rr 9D rr rr  
0005FAr 1                       sta     fb + K * 256,x
0005FAr 1                       sta     sb + K * 256,x
0005FAr 1                       sta     bg + K * 256,x
0005FAr 1                       .endrepeat
0005FAr 1  E8                   inx
0005FBr 1  D0 B5                bne     @c
0005FDr 1               clear_marks:
0005FDr 1  A9 00                lda     #0
0005FFr 1  A2 16                ldx     #FROWS-1
000601r 1  9D rr rr     @d:     sta     rd_lo,x
000604r 1  9D rr rr             sta     rd_hi,x
000607r 1  9D rr rr             sta     rp_lo,x
00060Ar 1  9D rr rr             sta     rp_hi,x
00060Dr 1  9D rr rr             sta     bd_lo,x
000610r 1  9D rr rr             sta     bd_hi,x
000613r 1  CA                   dex
000614r 1  10 EB                bpl     @d
000616r 1  60                   rts
000617r 1               
000617r 1               ; fb = bg everywhere, and send all of it
000617r 1               show_all:
000617r 1  A2 00                ldx     #0
000619r 1  BD rr rr 9D  @c:     .repeat 8, K
00061Dr 1  rr rr BD rr  
000621r 1  rr 9D rr rr  
000649r 1                       lda     bg + K * 256,x
000649r 1                       sta     fb + K * 256,x
000649r 1                       .endrepeat
000649r 1  E8                   inx
00064Ar 1  D0 CD                bne     @c
00064Cr 1  20 rr rr             jsr     clear_marks
00064Fr 1  A9 01                lda     #1
000651r 1  8D rr rr             sta     force
000654r 1  4C rr rr             jmp     present
000657r 1               
000657r 1               ; ============================================================================
000657r 1               ; a game
000657r 1               ; ============================================================================
000657r 1               new_game:
000657r 1  A9 00                lda     #0
000659r 1  A2 02                ldx     #2
00065Br 1  9D rr rr     @z:     sta     money,x
00065Er 1  9D rr rr             sta     target,x
000661r 1  CA                   dex
000662r 1  10 F7                bpl     @z
000664r 1  8D rr rr             sta     level
000667r 1  8D rr rr             sta     bombs
00066Ar 1  8D rr rr             sta     strong
00066Dr 1  8D rr rr             sta     gx2
000670r 1  8D rr rr             sta     has_laser
000673r 1  8D rr rr             sta     quit
000676r 1               
000676r 1               ; ---- a level: make the pit, raise the goal, show it, play ----------------------------
000676r 1               next_level:
000676r 1  EE rr rr             inc     level
000679r 1  20 rr rr             jsr     gen_level
00067Cr 1  A9 15                lda     #21             ; the goal goes up by 50-70% of what's in the pit
00067Er 1  20 rr rr             jsr     rnd
000681r 1  18                   clc
000682r 1  69 32                adc     #50
000684r 1  8D rr rr             sta     pct
000687r 1  AD rr rr             lda     total           ; num = total * pct / 100
00068Ar 1  AE rr rr             ldx     pct
00068Dr 1  20 rr rr             jsr     mul8
000690r 1  8D rr rr             sta     num
000693r 1  8E rr rr             stx     num+1
000696r 1  AD rr rr             lda     total+1
000699r 1  AE rr rr             ldx     pct
00069Cr 1  20 rr rr             jsr     mul8
00069Fr 1  18                   clc
0006A0r 1  6D rr rr             adc     num+1
0006A3r 1  8D rr rr             sta     num+1
0006A6r 1  8A                   txa
0006A7r 1  69 00                adc     #0
0006A9r 1  8D rr rr             sta     num+2
0006ACr 1  A9 64                lda     #100
0006AEr 1  20 rr rr             jsr     div24
0006B1r 1  18                   clc                     ; target += num
0006B2r 1  A2 00                ldx     #0
0006B4r 1  A0 03                ldy     #3
0006B6r 1  BD rr rr     @t:     lda     target,x
0006B9r 1  7D rr rr             adc     num,x
0006BCr 1  9D rr rr             sta     target,x
0006BFr 1  E8                   inx
0006C0r 1  88                   dey
0006C1r 1  D0 F3                bne     @t
0006C3r 1                       ; "LEVEL n  GOAL $..."
0006C3r 1  20 rr rr             jsr     new_screen
0006C6r 1  A9 rr                lda     #<lvl_txt
0006C8r 1  A0 rr                ldy     #>lvl_txt
0006CAr 1  20 rr rr             jsr     print
0006CDr 1  AD rr rr             lda     level
0006D0r 1  20 rr rr             jsr     pr8
0006D3r 1  A9 rr                lda     #<goal_txt
0006D5r 1  A0 rr                ldy     #>goal_txt
0006D7r 1  20 rr rr             jsr     print
0006DAr 1  A2 02                ldx     #2
0006DCr 1  BD rr rr     @g:     lda     target,x
0006DFr 1  9D rr rr             sta     num,x
0006E2r 1  CA                   dex
0006E3r 1  10 F7                bpl     @g
0006E5r 1  20 rr rr             jsr     prnum
0006E8r 1  A9 rr                lda     #<have_txt
0006EAr 1  A0 rr                ldy     #>have_txt
0006ECr 1  20 rr rr             jsr     print
0006EFr 1  20 rr rr             jsr     prmoney
0006F2r 1  AD rr rr             lda     strong
0006F5r 1  F0 07                beq     @ns
0006F7r 1  A9 rr                lda     #<strong_txt
0006F9r 1  A0 rr                ldy     #>strong_txt
0006FBr 1  20 rr rr             jsr     print
0006FEr 1  AD rr rr     @ns:    lda     gx2
000701r 1  F0 07                beq     @ng
000703r 1  A9 rr                lda     #<gx2_txt
000705r 1  A0 rr                ldy     #>gx2_txt
000707r 1  20 rr rr             jsr     print
00070Ar 1  AD rr rr     @ng:    lda     has_laser
00070Dr 1  F0 07                beq     @nl
00070Fr 1  A9 rr                lda     #<laser_txt
000711r 1  A0 rr                ldy     #>laser_txt
000713r 1  20 rr rr             jsr     print
000716r 1  A9 32        @nl:    lda     #50
000718r 1  20 rr rr             jsr     delay_long
00071Br 1                       ; the field
00071Br 1  20 rr rr             jsr     new_screen
00071Er 1  A9 rr                lda     #<status_txt
000720r 1  A0 rr                ldy     #>status_txt
000722r 1  20 rr rr             jsr     print
000725r 1  20 rr rr             jsr     draw_bg
000728r 1  20 rr rr             jsr     show_all
00072Br 1  A9 00                lda     #H_SWING
00072Dr 1  8D rr rr             sta     hst
000730r 1  A9 00                lda     #0
000732r 1  8D rr rr             sta     ang
000735r 1  8D rr rr             sta     ang+1
000738r 1  8D rr rr             sta     angv
00073Br 1  8D rr rr             sta     angv+1
00073Er 1  8D rr rr             sta     hl
000741r 1  8D rr rr             sta     carry
000744r 1  8D rr rr             sta     pop_t
000747r 1  8D rr rr             sta     fire_req
00074Ar 1  8D rr rr             sta     bomb_req
00074Dr 1  A9 04                lda     #REST
00074Fr 1  8D rr rr             sta     hl+1
000752r 1  A9 00                lda     #0
000754r 1  A2 05                ldx     #NEXP-1
000756r 1  9D rr rr     @e2:    sta     ex_t,x
000759r 1  CA                   dex
00075Ar 1  10 FA                bpl     @e2
00075Cr 1  A9 3C                lda     #LEVEL_TIME
00075Er 1  8D rr rr             sta     tsec
000761r 1  A9 14                lda     #FPS
000763r 1  8D rr rr             sta     tfr
000766r 1  A9 FF                lda     #$FF
000768r 1  8D rr rr             sta     hud_dirty
00076Br 1  20 rr rr             jsr     calc_hook
00076Er 1               
00076Er 1               ; ---- the frame loop --------------------------------------------------------------
00076Er 1               game_loop:
00076Er 1  20 rr rr             jsr     sfx_poll
000771r 1  A9 00                lda     #0
000773r 1  8D rr rr             sta     nbytes
000776r 1  8D rr rr             sta     nbytes+1
000779r 1  8D rr rr             sta     npix
00077Cr 1  8D rr rr             sta     npix+1
00077Fr 1  20 rr rr             jsr     read_input
000782r 1  AD rr rr             lda     quit
000785r 1  F0 03                beq     @1
000787r 1  4C rr rr             jmp     title
00078Ar 1  20 rr rr     @1:     jsr     hook_update
00078Dr 1  AD rr rr             lda     hst             ; reeling in: a click every 4 frames
000790r 1  C9 02                cmp     #H_BACK
000792r 1  D0 0C                bne     @nr
000794r 1  AD rr rr             lda     frame
000797r 1  29 03                and     #3
000799r 1  D0 05                bne     @nr
00079Br 1  A9 01                lda     #SND_REEL
00079Dr 1  20 rr rr             jsr     sfx_snd
0007A0r 1  20 rr rr     @nr:    jsr     gophers
0007A3r 1  20 rr rr             jsr     tnt_update
0007A6r 1  20 rr rr             jsr     clock
0007A9r 1  20 rr rr             jsr     frame_draw
0007ACr 1  20 rr rr             jsr     hud_update
0007AFr 1  20 rr rr             jsr     pace
0007B2r 1  EE rr rr             inc     frame
0007B5r 1  AD rr rr             lda     tsec            ; the end of the level: out of time,
0007B8r 1  F0 14                beq     level_end
0007BAr 1  AD rr rr             lda     hst             ; or nothing left worth having
0007BDr 1  D0 AF                bne     game_loop
0007BFr 1  20 rr rr             jsr     count_left
0007C2r 1  D0 AA                bne     game_loop
0007C4r 1  A2 05                ldx     #NEXP-1         ; (once the bangs are over)
0007C6r 1  BD rr rr     @x:     lda     ex_t,x
0007C9r 1  D0 A3                bne     game_loop
0007CBr 1  CA                   dex
0007CCr 1  10 F8                bpl     @x
0007CEr 1               
0007CEr 1               ; ---- the end of a level: the goal met, or not ----------------------------------------
0007CEr 1               level_end:
0007CEr 1  A9 00                lda     #0              ; strength, double gems and the laser last one level
0007D0r 1  8D rr rr             sta     strong
0007D3r 1  8D rr rr             sta     gx2
0007D6r 1  8D rr rr             sta     has_laser
0007D9r 1  AD rr rr             lda     money+2         ; money >= target?
0007DCr 1  CD rr rr             cmp     target+2
0007DFr 1  D0 0E                bne     @c
0007E1r 1  AD rr rr             lda     money+1
0007E4r 1  CD rr rr             cmp     target+1
0007E7r 1  D0 06                bne     @c
0007E9r 1  AD rr rr             lda     money
0007ECr 1  CD rr rr             cmp     target
0007EFr 1  B0 03        @c:     bcs     @met
0007F1r 1  4C rr rr             jmp     game_over
0007F4r 1  A9 09        @met:   lda     #SND_MET
0007F6r 1  20 rr rr             jsr     sfx_snd
0007F9r 1  A9 rr                lda     #<met_txt
0007FBr 1  A0 rr                ldy     #>met_txt
0007FDr 1  20 rr rr             jsr     print
000800r 1  A9 28                lda     #40
000802r 1  20 rr rr             jsr     delay_long
000805r 1  20 rr rr             jsr     shop
000808r 1  4C rr rr             jmp     next_level
00080Br 1               
00080Br 1               game_over:
00080Br 1  A9 0A                lda     #SND_OVER
00080Dr 1  20 rr rr             jsr     sfx_snd
000810r 1  A9 rr                lda     #<over_txt
000812r 1  A0 rr                ldy     #>over_txt
000814r 1  20 rr rr             jsr     print
000817r 1  20 rr rr             jsr     prmoney
00081Ar 1  A9 rr                lda     #<over2_txt
00081Cr 1  A0 rr                ldy     #>over2_txt
00081Er 1  20 rr rr             jsr     print
000821r 1  A2 02                ldx     #2
000823r 1  BD rr rr     @g:     lda     target,x
000826r 1  9D rr rr             sta     num,x
000829r 1  CA                   dex
00082Ar 1  10 F7                bpl     @g
00082Cr 1  20 rr rr             jsr     prnum
00082Fr 1  A9 rr                lda     #<over3_txt
000831r 1  A0 rr                ldy     #>over3_txt
000833r 1  20 rr rr             jsr     print
000836r 1  AD rr rr             lda     money+2         ; the best so far?
000839r 1  CD rr rr             cmp     hi_money+2
00083Cr 1  D0 0E                bne     @c
00083Er 1  AD rr rr             lda     money+1
000841r 1  CD rr rr             cmp     hi_money+1
000844r 1  D0 06                bne     @c
000846r 1  AD rr rr             lda     money
000849r 1  CD rr rr             cmp     hi_money
00084Cr 1  90 11        @c:     bcc     @nohi
00084Er 1  A2 02                ldx     #2
000850r 1  BD rr rr     @h:     lda     money,x
000853r 1  9D rr rr             sta     hi_money,x
000856r 1  CA                   dex
000857r 1  10 F7                bpl     @h
000859r 1  AD rr rr             lda     level
00085Cr 1  8D rr rr             sta     hi_level
00085Fr 1  A9 14        @nohi:  lda     #20
000861r 1  20 rr rr             jsr     delay_long
000864r 1  20 rr rr     @wait:  jsr     menu_key
000867r 1  C9 51                cmp     #'Q'
000869r 1  D0 03                bne     @nq
00086Br 1  4C rr rr             jmp     title
00086Er 1  C9 4D        @nq:    cmp     #'M'
000870r 1  D0 06                bne     @nm
000872r 1  20 rr rr             jsr     sfx_toggle
000875r 1  4C rr rr             jmp     @wait
000878r 1  C9 20        @nm:    cmp     #' '
00087Ar 1  F0 04                beq     @again
00087Cr 1  C9 80                cmp     #PAD_GO
00087Er 1  D0 E4                bne     @wait
000880r 1  4C rr rr     @again: jmp     new_game
000883r 1               
000883r 1               ; the things left in the pit worth grabbing (not TNT).  Z set if none.
000883r 1               count_left:
000883r 1  A2 17                ldx     #NITEM-1
