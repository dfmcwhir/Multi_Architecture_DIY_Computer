000C5Cr 1  A9 20                lda     #' '
000C5Er 1  20 03 FE             jsr     putc
000C61r 1  AD rr rr             lda     tmp
000C64r 1  38                   sec
000C65r 1  ED rr rr             sbc     dr_n
000C68r 1  8D rr rr             sta     tmp
