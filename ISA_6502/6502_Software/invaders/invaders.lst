000643r 1  A0 rr                ldy     #>init_txt
000645r 1  20 rr rr             jsr     print
000648r 1               ; store the invader pictures in the terminal as tiles: tile k = the 3
000648r 1               ; characters of sprite 3k and a blank gap (4 x 1); tile 6 = 4 blanks
000648r 1               def_tiles:
