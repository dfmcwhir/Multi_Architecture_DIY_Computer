00067Er 1  20 03 FE             jsr     putc
000681r 1  4C rr rr             jmp     @n
000684r 1  A9 00        @blank: lda     #0
000686r 1  20 03 FE             jsr     putc
000689r 1  20 03 FE             jsr     putc
00068Cr 1  20 03 FE             jsr     putc
00068Fr 1  20 03 FE             jsr     putc
000692r 1  E8           @n:     inx
000693r 1  E0 07                cpx     #T_BLANK+1
000695r 1  D0 B3                bne     @t
000697r 1  60                   rts
000698r 1               
000698r 1               ; repeat every character (and tile) A times from now on, block graphics
000698r 1  C9 02        set_rep:cmp     #2
00069Ar 1  90 08                bcc     @one
00069Cr 1  0A                   asl
00069Dr 1  0A                   asl
00069Er 1  0A                   asl
00069Fr 1  09 80                ora     #ATTR_GFX
