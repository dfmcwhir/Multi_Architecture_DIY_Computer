000C32r 1  38                   sec
000C33r 1  ED rr rr             sbc     ext_s0
000C36r 1  0A                   asl
000C37r 1  0A                   asl
000C38r 1  18                   clc
000C39r 1  69 05                adc     #5
000C3Br 1  8D rr rr             sta     tmp
000C3Er 1  20 rr rr             jsr     txt_mode
000C41r 1  BC rr rr             ldy     rowy,x
000C44r 1  AE rr rr             ldx     tmp_col
000C47r 1  20 rr rr             jsr     gotoxy
