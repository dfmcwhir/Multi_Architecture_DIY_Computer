000C4Dr 1  C9 0F                cmp     #15
000C4Fr 1  90 02                bcc     @c
000C51r 1  A9 0F                lda     #15
000C53r 1  8D rr rr     @c:     sta     dr_n
000C56r 1  0A                   asl
000C57r 1  0A                   asl
000C58r 1  0A                   asl
