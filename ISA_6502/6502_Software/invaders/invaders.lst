000B7Cr 1               
000B7Cr 1               ; draw_row is about to overwrite columns dr_c0 .. dr_c1-1 of row dr_row.
000B7Cr 1               ; Any bullet or bomb pixel there is replaced by the invader picture, so it
000B7Cr 1               ; must not be erased later (that would punch a hole in an invader).
000B7Cr 1               mark_over:
000B7Cr 1  AD rr rr             lda     bul_on
000B7Fr 1  F0 0F                beq     @bombs
000B81r 1  AD rr rr             lda     bul_x
000B84r 1  AC rr rr             ldy     bul_y
000B87r 1  20 rr rr             jsr     over_bits
000B8Ar 1  0D rr rr             ora     bul_keep
000B8Dr 1  8D rr rr             sta     bul_keep
000B90r 1  A2 02        @bombs: ldx     #2
000B92r 1  BD rr rr     @b:     lda     bomb_on,x
000B95r 1  F0 34                beq     @nb
000B97r 1  BD rr rr             lda     bomb_x,x
000B9Ar 1  BC rr rr             ldy     bomb_y,x
000B9Dr 1  20 rr rr             jsr     over_bits
000BA0r 1  F0 29                beq     @nb
000BA2r 1  C9 01                cmp     #1
000BA4r 1  F0 1F                beq     @top
000BA6r 1  A9 00                lda     #0              ; the row came down onto the bomb: the
000BA8r 1  9D rr rr             sta     bomb_on,x       ; invader swallows it
000BABr 1  BC rr rr             ldy     bomb_y,x        ; (over_bits changed Y)
000BAEr 1  BD rr rr             lda     bomb_keep,x
000BB1r 1  09 02                ora     #2
000BB3r 1  8E rr rr             stx     bm_i
000BB6r 1  48                   pha
000BB7r 1  BD rr rr             lda     bomb_x,x
000BBAr 1  AA                   tax
000BBBr 1  68                   pla
000BBCr 1  20 rr rr             jsr     erase_shot      ; erase the top pixel if it's outside the row
000BBFr 1  AE rr rr             ldx     bm_i
000BC2r 1  4C rr rr             jmp     @nb
000BC5r 1  1D rr rr     @top:   ora     bomb_keep,x
000BC8r 1  9D rr rr             sta     bomb_keep,x
000BCBr 1  CA           @nb:    dex
000BCCr 1  10 C4                bpl     @b
000BCEr 1  60                   rts
000BCFr 1               
000BCFr 1               ; A = pixel x, Y = top pixel y of a 2 pixel tall shot.  Returns A: bit 0 set
000BCFr 1               ; if pixel (x, y) is in the overwritten span, bit 1 if (x, y+1) is.
000BCFr 1               ; Preserves X.
000BCFr 1               over_bits:
000BCFr 1  4A                   lsr
000BD0r 1  CD rr rr             cmp     dr_c0
000BD3r 1  90 2C                bcc     @none
000BD5r 1  CD rr rr             cmp     dr_c1
