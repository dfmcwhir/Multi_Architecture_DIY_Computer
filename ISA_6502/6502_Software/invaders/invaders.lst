ca65 V2.19 - Git a6530f4
Main file   : invaders.s
Current file: invaders.s

000000r 1               ; ============================================================================
000000r 1               ; invaders.s - a Space Invaders style game for the 6502 SBC
000000r 1               ;
000000r 1               ; Runs from the monitor at $0500 and draws on the PIC32 terminal using its
000000r 1               ; control code mode (terminal setup item J must be ON).
000000r 1               ;
000000r 1               ;   build:  ca65 invaders.s -o invaders.o -l invaders.lst
000000r 1               ;           ld65 -C invaders.cfg invaders.o -o INVADERS.BIN      (or: make)
000000r 1               ;   needs sbc_api.inc (the ROM's fixed entry points at $FE00)
000000r 1               ;
000000r 1               ;   run:    L INVADERS 0500     then   R
000000r 1               ;
000000r 1               ; Header (patchable from the monitor):
000000r 1               ;   $0500  JMP start
000000r 1               ;   $0503  speed      delay per game tick, about 1 ms per unit (default 10)
000000r 1               ;   $0504  controls   at start: 0 keyboard, 1 gamepad (G on the title
000000r 1               ;                     screen switches; A or Start on the pad picks the pad)
000000r 1               ;   $0505  sound      at start: 0 on, 1 off (M switches)
000000r 1               ;
000000r 1               ; Sound: the AY-3-8910 card at $7F22/$7F23, through ../ay/sfx.s (timed by
000000r 1               ; the VIA's timer 2).  Without the card the game is just silent.
000000r 1               ;
000000r 1               ; Keys:  A / D or , / . or the arrow keys  move
000000r 1               ;        SPACE or W                        fire
000000r 1               ;        P                                 pause
000000r 1               ;        M                                 sound on / off
000000r 1               ;        Q                                 quit (back to the boot menu)
000000r 1               ; Gamepad: left / right move, A or B fire, Start pause
000000r 1               ;
000000r 1               ; Graphics: the invaders, the player and the saucer are block graphics
000000r 1               ; characters (attribute $80, 2x4 blocks per character, each block is one
000000r 1               ; graphics pixel).  The invader pictures are terminal tiles (terminal
000000r 1               ; firmware v1.4: 19 SET TILE, 0B SEND TILE), and a row of the formation is
000000r 1               ; sent as runs of one tile with the repeat count (attribute bits 3-6).  Bullets, bombs, the ground line, the title box and the
000000r 1               ; damage to the shields use the set (05 x y) and reset (06 x y) pixel codes.
000000r 1               ;
000000r 1               ; Coordinates: text is 80 x 24, pixels are 160 x 96 (one character cell is
000000r 1               ; 2 x 4 pixels), so a character at column c, row r covers pixels
000000r 1               ; x = 2c..2c+1, y = 4r..4r+3.
000000r 1               ;
000000r 1               ; No zero page is used, so EhBASIC's and the BIOS's zero page are untouched.
000000r 1               ; ============================================================================
000000r 1               
000000r 1                       .setcpu "6502"
000000r 1               
000000r 1                       .include "sbc_api.inc"   ; fixed ROM entry points ($FE00 table)
000000r 2               ; sbc_api.inc - fixed ROM entry points of the SBC (see jumptable.s), and the
000000r 2               ; CPU clock.  Use in your own ca65 programs:  .include "sbc_api.inc"
000000r 2               ; (the games find it one folder up: their make.bat passes  -I ..  to ca65)
000000r 2               SBC_CHRIN       = $FE00         ; carry set + A = char, carry clear = none waiting
000000r 2               SBC_CHROUT      = $FE03         ; print A (A, X, Y preserved)
000000r 2               SBC_MENU        = $FE06         ; boot menu
000000r 2               SBC_COLD        = $FE09         ; BASIC cold start
000000r 2               SBC_WARM        = $FE0C         ; BASIC warm start
000000r 2               SBC_MONITOR     = $FE0F         ; monitor prompt (or JMP $FF00)
000000r 2               SBC_PADSTATE    = $FE12         ; A = gamepad buttons held: bit0 A,1 B,2 Select,3 Start,4 Up,5 Down,6 Left,7 Right
000000r 2               SBC_LOAD        = $FE15         ; load a file: A/Y = parameter block (.word addr, .word max, "NAME.EXT",0)
000000r 2                                               ;   carry clear = loaded, X/Y = length; carry set = failed, A = error code
000000r 2               
000000r 2               ; The CPU clock in MHz (whole numbers, 1 to 8).  Programs size their delay
000000r 2               ; loops from it, so a millisecond stays a millisecond.  To build for another
000000r 2               ; clock, change it here or give it on the command line:  make.bat 1
000000r 2               .ifndef CLOCK_MHZ
000000r 2               CLOCK_MHZ       = 2
000000r 2               .endif
000000r 2               
000000r 1               
000000r 1               SPEED_DEFAULT   = 10
000000r 1               
000000r 1               ; ---- terminal control codes (control code mode) ----------------------------
000000r 1               TC_CURSOR       = $02           ; n   cursor character (0 = off)
000000r 1               TC_SETPIX       = $05           ; x y set a pixel
000000r 1               TC_CLRPIX       = $06           ; x y reset a pixel
000000r 1               TC_CLS          = $0C           ; clear screen
000000r 1               TC_COL          = $0E           ; n   set column
000000r 1               TC_ROW          = $0F           ; n   set row
000000r 1               TC_ATTR         = $18           ; n   attribute ($80 = block graphics)
000000r 1               TC_LIT          = $1A           ; n   draw n as a character
000000r 1               TC_TILE         = $0B           ; n   draw tile n            (terminal v1.4)
000000r 1               TC_DEFTILE      = $19           ; n c r data: define tile n  (terminal v1.4)
000000r 1               T_BLANK         = 6             ; tiles 0-5: the invader frames + a gap (4 x 1)
000000r 1               ATTR_TEXT       = $00
000000r 1               ATTR_GFX        = $80
000000r 1               ATTR_RV         = $04
000000r 1               ; reverse video is an ANSI sequence (in terminal v1.4, attribute bit 2 is the
000000r 1               ; double size font, not reverse)
000000r 1               .define RV_ON   $1B, '[', '7', 'm'
000000r 1               .define RV_OFF  $1B, '[', '2', '7', 'm'
000000r 1               TERM            = $FF           ; string terminator (0 is a valid argument)
000000r 1               
000000r 1               ; ---- screen layout ---------------------------------------------------------
000000r 1               UFO_ROW         = 2
000000r 1               PLAYER_ROW      = 21
000000r 1               PLAYER_Y        = PLAYER_ROW*4  ; 84
000000r 1               SHIELD_ROW      = 18
000000r 1               SHIELD_Y        = SHIELD_ROW*4  ; 72, shields are 8 x 6 pixels
000000r 1               GROUND_Y        = 90
000000r 1               NROWS           = 5
000000r 1               NCOLS           = 8
000000r 1               FORM_X          = 8             ; starting column of the formation
000000r 1               FORM_Y          = 4             ; starting row of the top invader row
000000r 1               
000000r 1               ; ============================================================================
000000r 1                       .segment "CODE"
000000r 1               
000000r 1  4C rr rr             jmp     start
000003r 1  0A           speed:  .byte   SPEED_DEFAULT
000004r 1  00           ctrl_def:.byte  0               ; controls at start: 0 keyboard, 1 gamepad
000005r 1  00           mute_def:.byte  0               ; sound at start: 0 on, 1 off
000006r 1  00 00                .byte   0, 0            ; spare
000008r 1               
000008r 1                       .include "ay/sfx.s"     ; sound effects on the AY-3-8910 card
000008r 2               ; ============================================================================
000008r 2               ; sfx.s - sound effects and music for games, on the AY-3-8910 card
000008r 2               ;         ($7F22 register number, $7F23 data; 2 MHz chip clock)
000008r 2               ;
000008r 2               ; Include it in a game (it finds its note table one folder up, like
000008r 2               ; sbc_api.inc:  ca65 -I ..):
000008r 2               ;           .include "ay/sfx.s"
000008r 2               ; and then
000008r 2               ;   sfx_init    once at the start (silence, the timer)
000008r 2               ;   sfx_poll    often: at least every 20 ms (the game loop, and the delay
000008r 2               ;               loops).  It runs the sound 50 times a second, timed by the
000008r 2               ;               VIA's timer 2 (polled: its interrupt stays off; timer 1 and
000008r 2               ;               the gamepad aren't touched).  Keeps A, X, Y and the flags.
000008r 2               ;   sfx_play    play script A on voice X (see below); it doesn't if that
000008r 2               ;               voice is busy with a script of higher priority
000008r 2               ;   sfx_stop    stop voice X
000008r 2               ;   sfx_off     stop everything (and silence)
000008r 2               ;   sfx_mute    0 = sound on, 1 = muted (the scripts still run, unheard)
000008r 2               ;   sfx_hush    call before waiting without sfx_poll (a pause): silences the
000008r 2               ;               card until the next tick
000008r 2               ; With SFX_SND defined before the include, also:
000008r 2               ;   sfx_snd     play script A on its own voice (sfx_prio's high 4 bits)
000008r 2               ;   sfx_toggle  sound on / off (for the M key)
000008r 2               ;
000008r 2               ; The voices: 0-2 are the background (music, a saucer's hum ...) on the
000008r 2               ; chip's channels A-C; 3-5 are the foreground on the same channels.  While
000008r 2               ; a foreground voice plays, it is heard instead of the background voice of
000008r 2               ; its channel, which carries on unheard and comes back when it stops.
000008r 2               ;
000008r 2               ; A game lists its scripts in sfx_scripts (.word address) and their
000008r 2               ; priorities in sfx_prio (.byte, higher wins), indexed by script number.
000008r 2               ;
000008r 2               ; A script is bytes, run 50 times a second until it waits:
000008r 2               ;   $80-$FF         wait 1-128 ticks (1/50 s each): $80 + ticks - 1
000008r 2               ;   $20-$7F         note 0-95 (C1 .. B8, A4 = 45): $20 + note; the
000008r 2               ;                   volume goes back to the VOL level, the decay restarts;
000008r 2               ;                   then it waits LEN ticks (if LEN isn't 0)
000008r 2               ;   SX_END          (0) the end: the voice stops
000008r 2               ;   SX_PER  lo, hi  tone period (12 bits): 2 MHz / (16 x period) Hz
000008r 2               ;   SX_VOL  v       volume 0-15 (also the level each note starts at)
000008r 2               ;   SX_NOISE n      noise period 0-31 (for the whole chip)
000008r 2               ;   SX_MIX  m       bit 0 tone on, bit 1 noise on
000008r 2               ;   SX_SWEEP lo, hi add this (signed) to the period every tick (0 = off)
000008r 2               ;   SX_DECAY d      the volume drops by 1 every d ticks (0 = holds)
000008r 2               ;   SX_LOOP c       the start of a part to play c times (0 = for ever)
000008r 2               ;   SX_NEXT         the end of that part
000008r 2               ;   SX_JUMP lo, hi  go on at another script (for music that repeats)
000008r 2               ;   SX_REST         volume 0 until the next note (and wait LEN ticks)
000008r 2               ;   SX_LEN t        notes and rests wait t ticks each from now on (music:
000008r 2               ;                   a byte a note); 0 (the start) = they don't wait
000008r 2               ; ============================================================================
000008r 2               
000008r 2               ; ---- variables (123 bytes): in the BSS, or at SFX_VARS if the game sets it
000008r 2               ;      (SMB puts them at $0100, the bottom of the stack page) ----------------
000008r 2               .ifdef SFX_VARS
000008r 2               sfx_vars        = SFX_VARS
000008r 2               sfx_lo          = sfx_vars
000008r 2               sfx_hi          = sfx_lo + 6
000008r 2               sfx_wait        = sfx_hi + 6
000008r 2               sfx_perl        = sfx_wait + 6
000008r 2               sfx_perh        = sfx_perl + 6
000008r 2               sfx_swl         = sfx_perh + 6
000008r 2               sfx_swh         = sfx_swl + 6
000008r 2               sfx_vol         = sfx_swh + 6
000008r 2               sfx_base        = sfx_vol + 6
000008r 2               sfx_dec         = sfx_base + 6
000008r 2               sfx_decc        = sfx_dec + 6
000008r 2               sfx_mix         = sfx_decc + 6
000008r 2               sfx_noise       = sfx_mix + 6
000008r 2               sfx_lpl         = sfx_noise + 6
000008r 2               sfx_lph         = sfx_lpl + 6
000008r 2               sfx_lcnt        = sfx_lph + 6
000008r 2               sfx_vprio       = sfx_lcnt + 6
000008r 2               sfx_len         = sfx_vprio + 6
000008r 2               sfx_runs        = sfx_len + 6
000008r 2               sfx_mixer       = sfx_runs + 1
000008r 2               sfx_chan        = sfx_mixer + 1
000008r 2               sfx_guard       = sfx_chan + 1
000008r 2               sfx_mute        = sfx_guard + 2
000008r 2               sfx_sa          = sfx_mute + 1
000008r 2               sfx_sx          = sfx_sa + 1
000008r 2               sfx_sy          = sfx_sx + 1
000008r 2               sfx_vars_end    = sfx_sy + 1
000008r 2               .else
000008r 2                       .segment "BSS"
000000r 2               sfx_vars:
000000r 2  xx xx xx xx  sfx_lo:     .res 6              ; script pointer (high byte 0: voice off)
000004r 2  xx xx        
000006r 2  xx xx xx xx  sfx_hi:     .res 6
00000Ar 2  xx xx        
00000Cr 2  xx xx xx xx  sfx_wait:   .res 6
000010r 2  xx xx        
000012r 2  xx xx xx xx  sfx_perl:   .res 6              ; tone period
000016r 2  xx xx        
000018r 2  xx xx xx xx  sfx_perh:   .res 6
00001Cr 2  xx xx        
00001Er 2  xx xx xx xx  sfx_swl:    .res 6              ; sweep
000022r 2  xx xx        
000024r 2  xx xx xx xx  sfx_swh:    .res 6
000028r 2  xx xx        
00002Ar 2  xx xx xx xx  sfx_vol:    .res 6
00002Er 2  xx xx        
000030r 2  xx xx xx xx  sfx_base:   .res 6              ; the volume notes start at
000034r 2  xx xx        
000036r 2  xx xx xx xx  sfx_dec:    .res 6              ; decay: ticks a step
00003Ar 2  xx xx        
00003Cr 2  xx xx xx xx  sfx_decc:   .res 6
000040r 2  xx xx        
000042r 2  xx xx xx xx  sfx_mix:    .res 6
000046r 2  xx xx        
000048r 2  xx xx xx xx  sfx_noise:  .res 6
00004Cr 2  xx xx        
00004Er 2  xx xx xx xx  sfx_lpl:    .res 6              ; loop start
000052r 2  xx xx        
000054r 2  xx xx xx xx  sfx_lph:    .res 6
000058r 2  xx xx        
00005Ar 2  xx xx xx xx  sfx_lcnt:   .res 6
00005Er 2  xx xx        
000060r 2  xx xx xx xx  sfx_vprio:  .res 6
000064r 2  xx xx        
000066r 2  xx xx xx xx  sfx_len:    .res 6              ; LEN
00006Ar 2  xx xx        
00006Cr 2  xx           sfx_runs:   .res 1
00006Dr 2  xx           sfx_mixer:  .res 1
00006Er 2  xx           sfx_chan:   .res 1
00006Fr 2  xx xx        sfx_guard:  .res 2
000071r 2  xx           sfx_mute:   .res 1
000072r 2  xx           sfx_sa:     .res 1              ; (sfx_snd)
000073r 2  xx           sfx_sx:     .res 1
000074r 2  xx           sfx_sy:     .res 1
000075r 2               sfx_vars_end:
000075r 2                       .segment "CODE"
000008r 2               .endif
000008r 2               
000008r 2               SX_END          = 0
000008r 2               SX_PER          = 1
000008r 2               SX_VOL          = 2
000008r 2               SX_NOISE        = 3
000008r 2               SX_MIX          = 4
000008r 2               SX_SWEEP        = 5
000008r 2               SX_DECAY        = 6
000008r 2               SX_LOOP         = 7
000008r 2               SX_NEXT         = 8
000008r 2               SX_JUMP         = 9
000008r 2               SX_REST         = 10
000008r 2               SX_LEN          = 11
000008r 2               .define SX_WAIT(t)  ($80 + (t) - 1)
000008r 2               .define SX_NOTE(n)  ($20 + (n))
000008r 2               
000008r 2               SFX_AY_ADDR     = $7F22
000008r 2               SFX_AY_DATA     = $7F23
000008r 2               SFX_T2CL        = $7F08
000008r 2               SFX_T2CH        = $7F09
000008r 2               SFX_ACR         = $7F0B
000008r 2               SFX_IFR         = $7F0D
000008r 2               SFX_IER         = $7F0E
000008r 2               
000008r 2               ; the timer counts a 50th of a second in SFX_RUNS runs of SFX_COUNT cycles
000008r 2               ; (it holds 16 bits)
000008r 2               SFX_CYCLES      = CLOCK_MHZ * 20000
000008r 2               SFX_RUNS        = (SFX_CYCLES + 65535) / 65536
000008r 2               SFX_COUNT       = SFX_CYCLES / SFX_RUNS - 2
000008r 2               
000008r 2               ; ---- the routines ------------------------------------------------------------------------
000008r 2               sfx_init:
000008r 2  A9 00                lda     #0
00000Ar 2  A2 74                ldx     #sfx_vars_end - sfx_vars - 1
00000Cr 2  9D rr rr     @c:     sta     sfx_vars,x
00000Fr 2  CA                   dex
000010r 2  10 FA                bpl     @c
000012r 2  AD 0B 7F             lda     SFX_ACR         ; timer 2: one shot, its interrupt off
000015r 2  29 DF                and     #$DF
000017r 2  8D 0B 7F             sta     SFX_ACR
00001Ar 2  A9 20                lda     #$20
00001Cr 2  8D 0E 7F             sta     SFX_IER
00001Fr 2  A9 01                lda     #SFX_RUNS
000021r 2  8D rr rr             sta     sfx_runs
000024r 2  A9 3E                lda     #<SFX_COUNT
000026r 2  8D 08 7F             sta     SFX_T2CL
000029r 2  A9 9C                lda     #>SFX_COUNT
00002Br 2  8D 09 7F             sta     SFX_T2CH
00002Er 2                       ; (on into sfx_off)
00002Er 2               
00002Er 2               ; stop every voice, silence
00002Er 2               sfx_off:
00002Er 2  48                   pha
00002Fr 2  8A                   txa
000030r 2  48                   pha
000031r 2  A2 05                ldx     #5
000033r 2  A9 00                lda     #0
000035r 2  9D rr rr     @v:     sta     sfx_hi,x
000038r 2  CA                   dex
000039r 2  10 FA                bpl     @v
00003Br 2  68                   pla
00003Cr 2  AA                   tax
00003Dr 2  68                   pla
00003Er 2                       ; (on into sfx_hush)
00003Er 2               
00003Er 2               ; silence the card (until the next tick).  Keeps A, X, Y.
00003Er 2               sfx_hush:
00003Er 2  48                   pha
00003Fr 2  8A                   txa
000040r 2  48                   pha
000041r 2  A9 07                lda     #7              ; mixer: all off
000043r 2  8D 22 7F             sta     SFX_AY_ADDR
000046r 2  A9 3F                lda     #$3F
000048r 2  8D 23 7F             sta     SFX_AY_DATA
00004Br 2  A2 08                ldx     #8              ; volumes 0
00004Dr 2  A9 00                lda     #0
00004Fr 2  8E 22 7F     @v:     stx     SFX_AY_ADDR
000052r 2  8D 23 7F             sta     SFX_AY_DATA
000055r 2  E8                   inx
000056r 2  E0 0B                cpx     #11
000058r 2  D0 F5                bne     @v
00005Ar 2  68                   pla
00005Br 2  AA                   tax
00005Cr 2  68                   pla
00005Dr 2  60                   rts
00005Er 2               
00005Er 2               ; stop voice X
00005Er 2               sfx_stop:
00005Er 2  48                   pha
00005Fr 2  A9 00                lda     #0
000061r 2  9D rr rr             sta     sfx_hi,x
000064r 2  68                   pla
000065r 2  60                   rts
000066r 2               
000066r 2               ; play script A on voice X (0-5); not if the voice is playing a script of
000066r 2               ; higher priority.  Keeps X.
000066r 2               sfx_play:
000066r 2  A8                   tay
000067r 2  BD rr rr             lda     sfx_hi,x
00006Ar 2  F0 09                beq     @go
00006Cr 2  B9 rr rr             lda     sfx_prio,y
00006Fr 2  DD rr rr             cmp     sfx_vprio,x
000072r 2  B0 01                bcs     @go
000074r 2  60                   rts
000075r 2  B9 rr rr     @go:    lda     sfx_prio,y
000078r 2  9D rr rr             sta     sfx_vprio,x
00007Br 2  98                   tya
00007Cr 2  0A                   asl
00007Dr 2  A8                   tay
00007Er 2  B9 rr rr             lda     sfx_scripts,y
000081r 2  9D rr rr             sta     sfx_lo,x
000084r 2  B9 rr rr             lda     sfx_scripts+1,y
000087r 2  9D rr rr             sta     sfx_hi,x
00008Ar 2  A9 00                lda     #0
00008Cr 2  9D rr rr             sta     sfx_wait,x
00008Fr 2  9D rr rr             sta     sfx_swl,x
000092r 2  9D rr rr             sta     sfx_swh,x
000095r 2  9D rr rr             sta     sfx_dec,x
000098r 2  9D rr rr             sta     sfx_perl,x
00009Br 2  9D rr rr             sta     sfx_perh,x
00009Er 2  9D rr rr             sta     sfx_len,x
0000A1r 2  A9 0F                lda     #15
0000A3r 2  9D rr rr             sta     sfx_base,x
0000A6r 2  9D rr rr             sta     sfx_vol,x
0000A9r 2  A9 01                lda     #1              ; tone on, noise off
0000ABr 2  9D rr rr             sta     sfx_mix,x
0000AEr 2  60                   rts
0000AFr 2               
0000AFr 2               ; run the sound if a tick has come.  Keeps A, X, Y and the flags (so it can
0000AFr 2               ; go anywhere: in putc, in a loop ...)
0000AFr 2               sfx_poll:
0000AFr 2  08                   php
0000B0r 2  48                   pha
0000B1r 2  AD 0D 7F             lda     SFX_IFR
0000B4r 2  29 20                and     #$20
0000B6r 2  D0 03                bne     @t
0000B8r 2  68                   pla
0000B9r 2  28                   plp
0000BAr 2  60                   rts
0000BBr 2  8A           @t:     txa
0000BCr 2  48                   pha
0000BDr 2  98                   tya
0000BEr 2  48                   pha
0000BFr 2                       ; the timer has gone on counting down past 0 ($FFFF, $FFFE ...): how
0000BFr 2                       ; late this call is.  The next run is that much shorter, so the beat
0000BFr 2                       ; keeps time however long the game takes between calls.
0000BFr 2  AE 09 7F     @rd:    ldx     SFX_T2CH
0000C2r 2  AD 08 7F             lda     SFX_T2CL
0000C5r 2  EC 09 7F             cpx     SFX_T2CH        ; (the high byte changed in between: again)
0000C8r 2  D0 F5                bne     @rd
0000CAr 2  38                   sec
0000CBr 2  69 22                adc     #<(SFX_COUNT - SFX_FIX)
0000CDr 2  A8                   tay
0000CEr 2  8A                   txa
0000CFr 2  69 9C                adc     #>(SFX_COUNT - SFX_FIX)
0000D1r 2  B0 04                bcs     @set
0000D3r 2  A0 64                ldy     #100            ; (more than a whole run late: soon)
0000D5r 2  A9 00                lda     #0
0000D7r 2  8C 08 7F     @set:   sty     SFX_T2CL
0000DAr 2  8D 09 7F             sta     SFX_T2CH
0000DDr 2  CE rr rr             dec     sfx_runs
0000E0r 2  D0 08                bne     @r
0000E2r 2  A9 01                lda     #SFX_RUNS
0000E4r 2  8D rr rr             sta     sfx_runs
0000E7r 2  20 rr rr             jsr     sfx_tick
0000EAr 2  68           @r:     pla
0000EBr 2  A8                   tay
0000ECr 2  68                   pla
0000EDr 2  AA                   tax
0000EEr 2  68                   pla
0000EFr 2  28                   plp
0000F0r 2  60                   rts
0000F1r 2               SFX_FIX = 28                    ; cycles from reading the timer to starting it
0000F1r 2               
0000F1r 2               .ifdef SFX_SND
0000F1r 2               ; ---- (with SFX_SND defined) ---------------------------------------------------
0000F1r 2               ; play script A on its own voice: the high 4 bits of its sfx_prio byte (the
0000F1r 2               ; low 4 are its priority).  Keeps A, X and Y.
0000F1r 2               sfx_snd:
0000F1r 2                       sta     sfx_sa
0000F1r 2                       stx     sfx_sx
0000F1r 2                       sty     sfx_sy
0000F1r 2                       tay
0000F1r 2                       lda     sfx_prio,y
0000F1r 2                       lsr
0000F1r 2                       lsr
0000F1r 2                       lsr
0000F1r 2                       lsr
0000F1r 2                       tax
0000F1r 2                       tya
0000F1r 2                       jsr     sfx_play
0000F1r 2                       lda     sfx_sa
0000F1r 2                       ldx     sfx_sx
0000F1r 2                       ldy     sfx_sy
0000F1r 2                       rts
0000F1r 2               
0000F1r 2               ; sound on / off (the M key).  Keeps X and Y.
0000F1r 2               sfx_toggle:
0000F1r 2                       lda     sfx_mute
0000F1r 2                       eor     #1
0000F1r 2                       sta     sfx_mute
0000F1r 2                       jmp     sfx_hush
0000F1r 2               .endif
0000F1r 2               
0000F1r 2               ; ---- a tick: every voice a step, then the card ---------------------------------------------
0000F1r 2               sfx_tick:
0000F1r 2  A2 05                ldx     #5
0000F3r 2  BD rr rr     @v:     lda     sfx_hi,x
0000F6r 2  F0 03                beq     @n
0000F8r 2  20 rr rr             jsr     sfx_voice
0000FBr 2  CA           @n:     dex
0000FCr 2  10 F5                bpl     @v
0000FEr 2                       ; the card: each channel hears its foreground voice if that plays,
0000FEr 2                       ; else its background voice
0000FEr 2  A9 3F                lda     #$3F
000100r 2  8D rr rr             sta     sfx_mixer
000103r 2  A2 02                ldx     #2
000105r 2  8E rr rr     @ch:    stx     sfx_chan
000108r 2  8A                   txa
000109r 2  18                   clc
00010Ar 2  69 03                adc     #3
00010Cr 2  A8                   tay                     ; foreground voice
00010Dr 2  B9 rr rr             lda     sfx_hi,y
000110r 2  D0 0C                bne     @have
000112r 2  AC rr rr             ldy     sfx_chan        ; background voice
000115r 2  B9 rr rr             lda     sfx_hi,y
000118r 2  D0 04                bne     @have
00011Ar 2  A9 00                lda     #0              ; neither: silent
00011Cr 2  F0 4E                beq     @vol
00011Er 2  8A           @have:  txa                     ; the tone period
00011Fr 2  0A                   asl
000120r 2  8D 22 7F             sta     SFX_AY_ADDR
000123r 2  B9 rr rr             lda     sfx_perl,y
000126r 2  8D 23 7F             sta     SFX_AY_DATA
000129r 2  8A                   txa
00012Ar 2  0A                   asl
00012Br 2  09 01                ora     #1
00012Dr 2  8D 22 7F             sta     SFX_AY_ADDR
000130r 2  B9 rr rr             lda     sfx_perh,y
000133r 2  29 0F                and     #$0F
000135r 2  8D 23 7F             sta     SFX_AY_DATA
000138r 2  B9 rr rr             lda     sfx_mix,y       ; the mixer bits (0 = on)
00013Br 2  4A                   lsr
00013Cr 2  90 09                bcc     @nt
00013Er 2  BD rr rr             lda     sfx_tone_on,x
000141r 2  2D rr rr             and     sfx_mixer
000144r 2  8D rr rr             sta     sfx_mixer
000147r 2  B9 rr rr     @nt:    lda     sfx_mix,y
00014Ar 2  29 02                and     #2
00014Cr 2  F0 14                beq     @nn
00014Er 2  BD rr rr             lda     sfx_noise_on,x
000151r 2  2D rr rr             and     sfx_mixer
000154r 2  8D rr rr             sta     sfx_mixer
000157r 2  A9 06                lda     #6
000159r 2  8D 22 7F             sta     SFX_AY_ADDR
00015Cr 2  B9 rr rr             lda     sfx_noise,y
00015Fr 2  8D 23 7F             sta     SFX_AY_DATA
000162r 2  B9 rr rr     @nn:    lda     sfx_vol,y
000165r 2  AC rr rr             ldy     sfx_mute
000168r 2  F0 02                beq     @vol
00016Ar 2  A9 00                lda     #0
00016Cr 2  AC rr rr     @vol:   ldy     sfx_chan
00016Fr 2  AA                   tax
000170r 2  98                   tya
000171r 2  18                   clc
000172r 2  69 08                adc     #8
000174r 2  8D 22 7F             sta     SFX_AY_ADDR
000177r 2  8E 23 7F             stx     SFX_AY_DATA
00017Ar 2  AE rr rr             ldx     sfx_chan
00017Dr 2  CA                   dex
00017Er 2  10 85                bpl     @ch
000180r 2  A9 07                lda     #7
000182r 2  8D 22 7F             sta     SFX_AY_ADDR
000185r 2  AD rr rr             lda     sfx_mixer
000188r 2  8D 23 7F             sta     SFX_AY_DATA
00018Br 2  60                   rts
00018Cr 2  3E 3D 3B     sfx_tone_on:    .byte   $3E, $3D, $3B
00018Fr 2  37 2F 1F     sfx_noise_on:   .byte   $37, $2F, $1F
000192r 2               
000192r 2               ; one voice (X): the sweep and the decay, then the script when its wait
000192r 2               ; is over
000192r 2               sfx_voice:
000192r 2  BD rr rr             lda     sfx_swl,x       ; the sweep
000195r 2  1D rr rr             ora     sfx_swh,x
000198r 2  F0 13                beq     @ns
00019Ar 2  BD rr rr             lda     sfx_perl,x
00019Dr 2  18                   clc
00019Er 2  7D rr rr             adc     sfx_swl,x
0001A1r 2  9D rr rr             sta     sfx_perl,x
0001A4r 2  BD rr rr             lda     sfx_perh,x
0001A7r 2  7D rr rr             adc     sfx_swh,x
0001AAr 2  9D rr rr             sta     sfx_perh,x
0001ADr 2  BD rr rr     @ns:    lda     sfx_dec,x       ; the decay
0001B0r 2  F0 10                beq     @nd
0001B2r 2  DE rr rr             dec     sfx_decc,x
0001B5r 2  D0 0B                bne     @nd
0001B7r 2  9D rr rr             sta     sfx_decc,x
0001BAr 2  BD rr rr             lda     sfx_vol,x
0001BDr 2  F0 03                beq     @nd
0001BFr 2  DE rr rr             dec     sfx_vol,x
0001C2r 2  BD rr rr     @nd:    lda     sfx_wait,x
0001C5r 2  F0 06                beq     @run
0001C7r 2  DE rr rr             dec     sfx_wait,x
0001CAr 2  F0 01                beq     @run
0001CCr 2  60                   rts
0001CDr 2  A9 28        @run:   lda     #40             ; (at most 40 commands a tick: a script that
0001CFr 2  8D rr rr             sta     sfx_guard       ;  never waits can't hang the game)
0001D2r 2  CE rr rr     @cmd:   dec     sfx_guard
0001D5r 2  F0 76                beq     @stop
0001D7r 2  20 rr rr             jsr     sfx_byte
0001DAr 2  C9 80                cmp     #$80
0001DCr 2  90 09                bcc     @nw
0001DEr 2  29 7F                and     #$7F            ; wait
0001E0r 2  9D rr rr             sta     sfx_wait,x
0001E3r 2  FE rr rr             inc     sfx_wait,x
0001E6r 2  60                   rts
0001E7r 2  C9 20        @nw:    cmp     #$20
0001E9r 2  90 54                bcc     @op
0001EBr 2  38                   sec                     ; a note
0001ECr 2  E9 20                sbc     #$20
0001EEr 2  C9 60                cmp     #96
0001F0r 2  90 02                bcc     @nt
0001F2r 2  A9 5F                lda     #95
0001F4r 2  A0 00        @nt:    ldy     #0              ; octave Y, note A in it
0001F6r 2  C9 0C        @oc:    cmp     #12
0001F8r 2  90 05                bcc     @ok
0001FAr 2  E9 0C                sbc     #12
0001FCr 2  C8                   iny
0001FDr 2  D0 F7                bne     @oc
0001FFr 2  8C rr rr     @ok:    sty     sfx_guard+1     ; (as a count)
000202r 2  A8                   tay
000203r 2  B9 rr rr             lda     sfx_c1_lo,y     ; the period in octave 1, halved for each
000206r 2  9D rr rr             sta     sfx_perl,x      ; octave up
000209r 2  B9 rr rr             lda     sfx_c1_hi,y
00020Cr 2  AC rr rr             ldy     sfx_guard+1
00020Fr 2  F0 16                beq     @p
000211r 2  4A           @sh:    lsr
000212r 2  7E rr rr             ror     sfx_perl,x
000215r 2  88                   dey
000216r 2  D0 F9                bne     @sh
000218r 2  9D rr rr             sta     sfx_perh,x      ; (rounded: the last bit out was a half)
00021Br 2  90 0D                bcc     @r0
00021Dr 2  FE rr rr             inc     sfx_perl,x
000220r 2  D0 08                bne     @r0
000222r 2  FE rr rr             inc     sfx_perh,x
000225r 2  D0 03                bne     @r0
000227r 2  9D rr rr     @p:     sta     sfx_perh,x
00022Ar 2               @r0:
00022Ar 2  BD rr rr             lda     sfx_base,x
00022Dr 2  9D rr rr             sta     sfx_vol,x
000230r 2  BD rr rr             lda     sfx_dec,x
000233r 2  9D rr rr             sta     sfx_decc,x
000236r 2  BD rr rr     @len:   lda     sfx_len,x       ; (LEN: wait that long)
000239r 2  F0 97                beq     @cmd
00023Br 2  9D rr rr             sta     sfx_wait,x
00023Er 2  60                   rts
00023Fr 2  C9 0C        @op:    cmp     #12
000241r 2  B0 0A                bcs     @stop
000243r 2  A8                   tay
000244r 2  B9 rr rr             lda     @hi,y
000247r 2  48                   pha
000248r 2  B9 rr rr             lda     @lo,y
00024Br 2  48                   pha
00024Cr 2  60                   rts                     ; (to the command, which goes back to @cmd)
00024Dr 2  A9 00        @stop:  lda     #0
00024Fr 2  9D rr rr             sta     sfx_hi,x
000252r 2  9D rr rr             sta     sfx_vol,x
000255r 2  60                   rts
000256r 2  rr rr rr rr  @lo:    .lobytes  @stop-1, @per-1, @vl-1, @noi-1, @mix-1, @sw-1, @dc-1, @lp-1, @nx-1, @jp-1, @rest-1, @ln-1
00025Ar 2  rr rr rr rr  
00025Er 2  rr rr rr rr  
000262r 2  rr rr rr rr  @hi:    .hibytes  @stop-1, @per-1, @vl-1, @noi-1, @mix-1, @sw-1, @dc-1, @lp-1, @nx-1, @jp-1, @rest-1, @ln-1
000266r 2  rr rr rr rr  
00026Ar 2  rr rr rr rr  
00026Er 2  20 rr rr     @per:   jsr     sfx_byte
000271r 2  9D rr rr             sta     sfx_perl,x
000274r 2  20 rr rr             jsr     sfx_byte
000277r 2  9D rr rr             sta     sfx_perh,x
00027Ar 2  4C rr rr             jmp     @cmd
00027Dr 2  20 rr rr     @vl:    jsr     sfx_byte
000280r 2  9D rr rr             sta     sfx_base,x
000283r 2  9D rr rr             sta     sfx_vol,x
000286r 2  BD rr rr             lda     sfx_dec,x
000289r 2  9D rr rr             sta     sfx_decc,x
00028Cr 2  4C rr rr             jmp     @cmd
00028Fr 2  20 rr rr     @noi:   jsr     sfx_byte
000292r 2  9D rr rr             sta     sfx_noise,x
000295r 2  4C rr rr             jmp     @cmd
000298r 2  20 rr rr     @mix:   jsr     sfx_byte
00029Br 2  9D rr rr             sta     sfx_mix,x
00029Er 2  4C rr rr             jmp     @cmd
0002A1r 2  20 rr rr     @sw:    jsr     sfx_byte
0002A4r 2  9D rr rr             sta     sfx_swl,x
0002A7r 2  20 rr rr             jsr     sfx_byte
0002AAr 2  9D rr rr             sta     sfx_swh,x
0002ADr 2  4C rr rr             jmp     @cmd
0002B0r 2  20 rr rr     @dc:    jsr     sfx_byte
0002B3r 2  9D rr rr             sta     sfx_dec,x
0002B6r 2  9D rr rr             sta     sfx_decc,x
0002B9r 2  4C rr rr             jmp     @cmd
0002BCr 2  20 rr rr     @lp:    jsr     sfx_byte
0002BFr 2  9D rr rr             sta     sfx_lcnt,x
0002C2r 2  BD rr rr             lda     sfx_lo,x
0002C5r 2  9D rr rr             sta     sfx_lpl,x
0002C8r 2  BD rr rr             lda     sfx_hi,x
0002CBr 2  9D rr rr             sta     sfx_lph,x
0002CEr 2  4C rr rr             jmp     @cmd
0002D1r 2  BD rr rr     @nx:    lda     sfx_lcnt,x
0002D4r 2  F0 05                beq     @back           ; (0: for ever)
0002D6r 2  DE rr rr             dec     sfx_lcnt,x
0002D9r 2  F0 0C                beq     @go
0002DBr 2  BD rr rr     @back:  lda     sfx_lpl,x
0002DEr 2  9D rr rr             sta     sfx_lo,x
0002E1r 2  BD rr rr             lda     sfx_lph,x
0002E4r 2  9D rr rr             sta     sfx_hi,x
0002E7r 2  4C rr rr     @go:    jmp     @cmd
0002EAr 2  20 rr rr     @jp:    jsr     sfx_byte
0002EDr 2  48                   pha
0002EEr 2  20 rr rr             jsr     sfx_byte
0002F1r 2  9D rr rr             sta     sfx_hi,x
0002F4r 2  68                   pla
0002F5r 2  9D rr rr             sta     sfx_lo,x
0002F8r 2  4C rr rr             jmp     @cmd
0002FBr 2  A9 00        @rest:  lda     #0
0002FDr 2  9D rr rr             sta     sfx_vol,x
000300r 2  4C rr rr             jmp     @len
000303r 2  20 rr rr     @ln:    jsr     sfx_byte
000306r 2  9D rr rr             sta     sfx_len,x
000309r 2  4C rr rr             jmp     @cmd
00030Cr 2               
00030Cr 2               ; the next byte of voice X's script
00030Cr 2               sfx_byte:
00030Cr 2  BD rr rr             lda     sfx_lo,x
00030Fr 2  8D rr rr             sta     @ld+1
000312r 2  BD rr rr             lda     sfx_hi,x
000315r 2  8D rr rr             sta     @ld+2
000318r 2  AD FF FF     @ld:    lda     $FFFF
00031Br 2  FE rr rr             inc     sfx_lo,x
00031Er 2  D0 03                bne     @r
000320r 2  FE rr rr             inc     sfx_hi,x
000323r 2  60           @r:     rts
000324r 2               
000324r 2               ; the tone periods of C1 .. B1 for the 2 MHz chip clock: 2 MHz / (16 x
000324r 2               ; frequency); each octave up is half (to within a third of a percent)
000324r 2  EE 18 4D 8E  sfx_c1_lo:  .lobytes 3822, 3608, 3405, 3214, 3034, 2863, 2703, 2551, 2408, 2273, 2145, 2025
000328r 2  DA 2F 8F F7  
00032Cr 2  68 E1 61 E9  
000330r 2  0E 0E 0D 0C  sfx_c1_hi:  .hibytes 3822, 3608, 3405, 3214, 3034, 2863, 2703, 2551, 2408, 2273, 2145, 2025
000334r 2  0B 0B 0A 09  
000338r 2  09 08 08 07  
00033Cr 2               
00033Cr 2               
00033Cr 1               
00033Cr 1               ; ----------------------------------------------------------------------------
00033Cr 1               ; I/O.  putc preserves A, X and Y (as the BIOS CHROUT does).  getc returns
00033Cr 1               ; carry set and the key in A, or carry clear.  X and Y are preserved.
00033Cr 1               ; ----------------------------------------------------------------------------
00033Cr 1               putc            = SBC_CHROUT    ; preserves A, X, Y
00033Cr 1               getc            = SBC_CHRIN     ; carry set = key in A
00033Cr 1               
00033Cr 1               ; output A as a block graphics pattern (codes 00-1F and 7F need a 1A first)
00033Cr 1  C9 20        putblk: cmp     #$20
00033Er 1  90 04                bcc     @lit
000340r 1  C9 7F                cmp     #$7F
000342r 1  D0 07                bne     @out
000344r 1  48           @lit:   pha
000345r 1  A9 1A                lda     #TC_LIT
000347r 1  20 03 FE             jsr     putc
00034Ar 1  68                   pla
00034Br 1  4C 03 FE     @out:   jmp     putc
00034Er 1               
00034Er 1               ; blank block graphics cell
00034Er 1               putblank:
00034Er 1  A9 1A                lda     #TC_LIT
000350r 1  20 03 FE             jsr     putc
000353r 1  A9 00                lda     #0
000355r 1  4C 03 FE             jmp     putc
000358r 1               
000358r 1               ; move the cursor to column X, row Y.  Preserves X and Y.
000358r 1  A9 0F        gotoxy: lda     #TC_ROW
00035Ar 1  20 03 FE             jsr     putc
00035Dr 1  98                   tya
00035Er 1  20 03 FE             jsr     putc
000361r 1  A9 0E                lda     #TC_COL
000363r 1  20 03 FE             jsr     putc
000366r 1  8A                   txa
000367r 1  4C 03 FE             jmp     putc
00036Ar 1               
00036Ar 1               ; set / reset the pixel at X, Y.  Preserves X and Y.
00036Ar 1  A9 05        setpix: lda     #TC_SETPIX
00036Cr 1  D0 02                bne     pix
00036Er 1  A9 06        clrpix: lda     #TC_CLRPIX
000370r 1  20 03 FE     pix:    jsr     putc
000373r 1  8A                   txa
000374r 1  20 03 FE             jsr     putc
000377r 1  98                   tya
000378r 1  4C 03 FE             jmp     putc
00037Br 1               
00037Br 1               ; select block graphics / plain text (only sends the code when it changes)
00037Br 1               gfx_mode:
00037Br 1  A9 80                lda     #ATTR_GFX
00037Dr 1  D0 02                bne     setattr
00037Fr 1               txt_mode:
00037Fr 1  A9 00                lda     #ATTR_TEXT
000381r 1  CD rr rr     setattr:cmp     attr
000384r 1  F0 0D                beq     @done
000386r 1  8D rr rr             sta     attr
000389r 1  48                   pha
00038Ar 1  A9 18                lda     #TC_ATTR
00038Cr 1  20 03 FE             jsr     putc
00038Fr 1  68                   pla
000390r 1  20 03 FE             jsr     putc
000393r 1  60           @done:  rts
000394r 1               
000394r 1               ; print the string at A (lo) / Y (hi), terminated by $FF.  It may contain
000394r 1               ; control codes and their arguments.  Self-modifying, so no zero page needed.
000394r 1  8D rr rr     print:  sta     @ld+1
000397r 1  8C rr rr             sty     @ld+2
00039Ar 1  A0 00                ldy     #0
00039Cr 1  B9 FF FF     @ld:    lda     $FFFF,y
00039Fr 1  C9 FF                cmp     #TERM
0003A1r 1  F0 06                beq     @done
0003A3r 1  20 03 FE             jsr     putc
0003A6r 1  C8                   iny
0003A7r 1  D0 F3                bne     @ld
0003A9r 1  60           @done:  rts
0003AAr 1               
0003AAr 1               ; print A as two BCD digits
0003AAr 1  48           prbcd:  pha
0003ABr 1  4A                   lsr
0003ACr 1  4A                   lsr
0003ADr 1  4A                   lsr
0003AEr 1  4A                   lsr
0003AFr 1  09 30                ora     #'0'
0003B1r 1  20 03 FE             jsr     putc
0003B4r 1  68                   pla
0003B5r 1  29 0F                and     #$0F
0003B7r 1  09 30                ora     #'0'
0003B9r 1  4C 03 FE             jmp     putc
0003BCr 1               
0003BCr 1               ; 16 bit Galois LFSR.  Returns a random byte in A.  Preserves X and Y.
0003BCr 1  AD rr rr     rand:   lda     rng+1
0003BFr 1  4A                   lsr
0003C0r 1  6E rr rr             ror     rng
0003C3r 1  90 02                bcc     @n
0003C5r 1  49 B4                eor     #$B4
0003C7r 1  8D rr rr     @n:     sta     rng+1
0003CAr 1  4D rr rr             eor     rng
0003CDr 1  60                   rts
0003CEr 1               
0003CEr 1               ; wait about speed ms (one game tick)
0003CEr 1               tick_delay:
0003CEr 1  AD rr rr             lda     speed
0003D1r 1               ; wait about A ms.  The inner loop is sized for the clock (CLOCK_MHZ in
0003D1r 1               ; sbc_api.inc): 5 + 4 * (CLOCK_MHZ - 1) cycles a turn, DELAY_N turns a ms.
0003D1r 1               DELAY_N = (1000 * CLOCK_MHZ - 7) / (5 + 4 * (CLOCK_MHZ - 1))
0003D1r 1               delay_ms:
0003D1r 1  AA                   tax
0003D2r 1  F0 0D                beq     @done
0003D4r 1  20 rr rr     @o:     jsr     sfx_poll        ; (the sound goes on while waiting)
0003D7r 1  A0 DD                ldy     #DELAY_N
0003D9r 1               @i:
0003D9r 1  EA EA        .repeat CLOCK_MHZ - 1           ; (4 more cycles a turn for each MHz above 1)
0003DBr 1                       nop
0003DBr 1                       nop
0003DBr 1               .endrepeat
0003DBr 1  88                   dey
0003DCr 1  D0 FB                bne     @i
0003DEr 1  CA                   dex
0003DFr 1  D0 F3                bne     @o
0003E1r 1  60           @done:  rts
0003E2r 1               
0003E2r 1               ; wait about A x 50 ms
0003E2r 1               delay_long:
0003E2r 1  8D rr rr             sta     tmp
0003E5r 1  A9 32        @l:     lda     #50
0003E7r 1  20 rr rr             jsr     delay_ms
0003EAr 1  20 rr rr             jsr     flush_in        ; keys pressed meanwhile are dropped (so the
0003EDr 1  CE rr rr             dec     tmp             ; ROM's keyboard buffer never fills up)
0003F0r 1  D0 F3                bne     @l
0003F2r 1  60                   rts
0003F3r 1               
0003F3r 1               ; horizontal line of pixels: X = x0, Y = y, A = length
0003F3r 1  8D rr rr     hline:  sta     tmp
0003F6r 1  20 rr rr     @l:     jsr     setpix
0003F9r 1  E8                   inx
0003FAr 1  CE rr rr             dec     tmp
0003FDr 1  D0 F7                bne     @l
0003FFr 1  60                   rts
000400r 1               
000400r 1               ; vertical line of pixels: X = x, Y = y0, A = length
000400r 1  8D rr rr     vline:  sta     tmp
000403r 1  20 rr rr     @l:     jsr     setpix
000406r 1  C8                   iny
000407r 1  CE rr rr             dec     tmp
00040Ar 1  D0 F7                bne     @l
00040Cr 1  60                   rts
00040Dr 1               
00040Dr 1               .macro MENU_IDLE
00040Dr 1                       jsr     rand            ; stir the random numbers while waiting
00040Dr 1                       jsr     sfx_poll
00040Dr 1               .endmacro
00040Dr 1               CTRL_COL        = 19
00040Dr 1               CTRL_ROW        = 20
00040Dr 1               
00040Dr 1               ; ============================================================================
00040Dr 1               ; gamepad and menu input (shared by the SBC games)
00040Dr 1               ; ============================================================================
00040Dr 1               PAD_A           = $01           ; bits returned by SBC_PADSTATE
00040Dr 1               PAD_B           = $02
00040Dr 1               PAD_SELECT      = $04
00040Dr 1               PAD_START       = $08
00040Dr 1               PAD_UP          = $10
00040Dr 1               PAD_DOWN        = $20
00040Dr 1               PAD_LEFT        = $40
00040Dr 1               PAD_RIGHT       = $80
00040Dr 1               PAD_GO          = $80           ; menu_key's answer for gamepad A or Start
00040Dr 1               
00040Dr 1               ; read the gamepad: pad = buttons held now, padnew = buttons pressed since
00040Dr 1               ; the last call.  Preserves X and Y (SBC_PADSTATE only changes A).
00040Dr 1               read_pad:
00040Dr 1  20 12 FE             jsr     SBC_PADSTATE
000410r 1  C9 FF                cmp     #$FF            ; every button "pressed" = no pad
000412r 1  D0 02                bne     @ok
000414r 1  A9 00                lda     #0
000416r 1  8D rr rr     @ok:    sta     pad
000419r 1  AD rr rr             lda     padold
00041Cr 1  49 FF                eor     #$FF
00041Er 1  2D rr rr             and     pad
000421r 1  8D rr rr             sta     padnew
000424r 1  AD rr rr             lda     pad
000427r 1  8D rr rr             sta     padold
00042Ar 1  60                   rts
00042Br 1               
00042Br 1               ; throw away waiting characters
00042Br 1               flush_in:
00042Br 1  20 00 FE             jsr     getc
00042Er 1  B0 FB                bcs     flush_in
000430r 1  60                   rts
000431r 1               
000431r 1               ; carry set if A is one of the characters the gamepad driver types for the
000431r 1               ; pad (W A S D and space).  Those are ignored in gamepad mode so that one
000431r 1               ; press doesn't act twice.  Preserves A.
000431r 1               pad_typed:
000431r 1  C9 20                cmp     #' '
000433r 1  F0 12                beq     @y
000435r 1  C9 57                cmp     #'W'
000437r 1  F0 0E                beq     @y
000439r 1  C9 41                cmp     #'A'
00043Br 1  F0 0A                beq     @y
00043Dr 1  C9 53                cmp     #'S'
00043Fr 1  F0 06                beq     @y
000441r 1  C9 44                cmp     #'D'
000443r 1  F0 02                beq     @y
000445r 1  18                   clc
000446r 1  60                   rts
000447r 1  38           @y:     sec
000448r 1  60                   rts
000449r 1               
000449r 1               ; wait for a menu choice.  Returns a key (letters in upper case), or
000449r 1               ; PAD_GO for the gamepad's A or Start button.
000449r 1               menu_key:
000449r 1  20 rr rr 20  @l:     MENU_IDLE
00044Dr 1  rr rr        
00044Fr 1  20 rr rr             jsr     read_pad
000452r 1  AD rr rr             lda     padnew
000455r 1  29 09                and     #PAD_A | PAD_START
000457r 1  D0 21                bne     @pad
000459r 1  20 00 FE             jsr     getc
00045Cr 1  90 EB                bcc     @l
00045Er 1  C9 20                cmp     #' '            ; a space typed by the pad's A button?
000460r 1  D0 0D                bne     @up
000462r 1  20 rr rr             jsr     read_pad
000465r 1  AD rr rr             lda     pad
000468r 1  29 01                and     #PAD_A
00046Ar 1  D0 0E                bne     @pad
00046Cr 1  A9 20                lda     #' '
00046Er 1  60                   rts
00046Fr 1  C9 61        @up:    cmp     #'a'
000471r 1  90 06                bcc     @r
000473r 1  C9 7B                cmp     #'z'+1
000475r 1  B0 02                bcs     @r
000477r 1  29 DF                and     #$DF
000479r 1  60           @r:     rts
00047Ar 1  20 rr rr     @pad:   jsr     flush_in        ; the space the driver typed for it
00047Dr 1  A9 80                lda     #PAD_GO
00047Fr 1  60                   rts
000480r 1               
000480r 1               ; print the controls line (CTRL_COL, CTRL_ROW)
000480r 1               show_ctrl:
000480r 1  20 rr rr             jsr     txt_mode
000483r 1  A2 13                ldx     #CTRL_COL
000485r 1  A0 14                ldy     #CTRL_ROW
000487r 1  20 rr rr             jsr     gotoxy
00048Ar 1  AD rr rr             lda     ctrl
00048Dr 1  F0 07                beq     @kb
00048Fr 1  A9 rr                lda     #<ctrl_pad_txt
000491r 1  A0 rr                ldy     #>ctrl_pad_txt
000493r 1  4C rr rr             jmp     print
000496r 1  A9 rr        @kb:    lda     #<ctrl_kb_txt
000498r 1  A0 rr                ldy     #>ctrl_kb_txt
00049Ar 1  4C rr rr             jmp     print
00049Dr 1               
00049Dr 1               ; ============================================================================
00049Dr 1               ; start
00049Dr 1               ; ============================================================================
00049Dr 1  D8           start:  cld
00049Er 1  A2 FF                ldx     #$FF
0004A0r 1  9A                   txs
0004A1r 1               
0004A1r 1               
0004A1r 1  A9 00                lda     #0              ; clear all variables
0004A3r 1  AA                   tax
0004A4r 1  9D rr rr     @clr:   sta     vars_start,x
0004A7r 1  E8                   inx
0004A8r 1  E0 7B                cpx     #vars_end-vars_start
0004AAr 1  D0 F8                bne     @clr
0004ACr 1  A9 A5                lda     #$A5            ; any non-zero seed (the title screen stirs it)
0004AEr 1  8D rr rr             sta     rng
0004B1r 1  AD rr rr             lda     ctrl_def
0004B4r 1  8D rr rr             sta     ctrl
0004B7r 1  A9 FF                lda     #$FF
0004B9r 1  8D rr rr             sta     attr            ; unknown, so the first mode change is sent
0004BCr 1  20 rr rr             jsr     sfx_init
0004BFr 1  AD rr rr             lda     mute_def
0004C2r 1  8D rr rr             sta     sfx_mute
0004C5r 1               
0004C5r 1               ; ---- title screen ----------------------------------------------------------
0004C5r 1  20 rr rr     title:  jsr     screen_init
0004C8r 1  A9 rr                lda     #<title_txt
0004CAr 1  A0 rr                ldy     #>title_txt
0004CCr 1  20 rr rr             jsr     print
0004CFr 1                       ; draw the invaders next to their point values
0004CFr 1  20 rr rr             jsr     gfx_mode
0004D2r 1  A2 1E                ldx     #30
0004D4r 1  A0 0A                ldy     #10
0004D6r 1  20 rr rr             jsr     gotoxy
0004D9r 1  A2 00                ldx     #0              ; squid
0004DBr 1  20 rr rr             jsr     put_sprite3
0004DEr 1  A2 1E                ldx     #30
0004E0r 1  A0 0C                ldy     #12
0004E2r 1  20 rr rr             jsr     gotoxy
0004E5r 1  A2 06                ldx     #6              ; crab
0004E7r 1  20 rr rr             jsr     put_sprite3
0004EAr 1  A2 1E                ldx     #30
0004ECr 1  A0 0E                ldy     #14
0004EEr 1  20 rr rr             jsr     gotoxy
0004F1r 1  A2 0C                ldx     #12             ; octopus
0004F3r 1  20 rr rr             jsr     put_sprite3
0004F6r 1  A2 1D                ldx     #29
0004F8r 1  A0 08                ldy     #8
0004FAr 1  20 rr rr             jsr     gotoxy
0004FDr 1  20 rr rr             jsr     put_ufo_sprite
000500r 1                       ; a box around the title, drawn with pixels
000500r 1  A2 2C                ldx     #44
000502r 1  A0 04                ldy     #4
000504r 1  A9 48                lda     #72
000506r 1  20 rr rr             jsr     hline           ; top    (44..115, 4)
000509r 1  A2 2C                ldx     #44
00050Br 1  A0 0F                ldy     #15
00050Dr 1  A9 48                lda     #72
00050Fr 1  20 rr rr             jsr     hline           ; bottom
000512r 1  A2 2C                ldx     #44
000514r 1  A0 05                ldy     #5
000516r 1  A9 0A                lda     #10
000518r 1  20 rr rr             jsr     vline           ; left
00051Br 1  A2 73                ldx     #115
00051Dr 1  A0 05                ldy     #5
00051Fr 1  A9 0A                lda     #10
000521r 1  20 rr rr             jsr     vline           ; right
000524r 1               
000524r 1  20 rr rr             jsr     show_ctrl
000527r 1  20 rr rr             jsr     read_pad
00052Ar 1  20 rr rr     @wait:  jsr     menu_key
00052Dr 1  C9 51                cmp     #'Q'
00052Fr 1  D0 03                bne     @notq
000531r 1  4C rr rr             jmp     exit_game
000534r 1  C9 4D        @notq:  cmp     #'M'            ; sound on / off
000536r 1  D0 06                bne     @notm
000538r 1  20 rr rr             jsr     toggle_sound
00053Br 1  4C rr rr             jmp     @wait
00053Er 1  C9 47        @notm:  cmp     #'G'            ; switch keyboard / gamepad
000540r 1  D0 0E                bne     @notg
000542r 1  AD rr rr             lda     ctrl
000545r 1  49 01                eor     #1
000547r 1  8D rr rr             sta     ctrl
00054Ar 1  20 rr rr             jsr     show_ctrl
00054Dr 1  4C rr rr             jmp     @wait
000550r 1  C9 80        @notg:  cmp     #PAD_GO         ; A or Start on the pad: play with the pad
000552r 1  D0 07                bne     @notp
000554r 1  A9 01                lda     #1
000556r 1  8D rr rr             sta     ctrl
000559r 1  D0 04                bne     new_game
00055Br 1  C9 20        @notp:  cmp     #' '
00055Dr 1  D0 CB                bne     @wait
00055Fr 1               
00055Fr 1               ; ---- new game ----------------------------------------------------------------
00055Fr 1               new_game:
00055Fr 1  A9 00                lda     #0
000561r 1  8D rr rr             sta     score
000564r 1  8D rr rr             sta     score+1
000567r 1  8D rr rr             sta     wave
00056Ar 1  A9 03                lda     #3
00056Cr 1  8D rr rr             sta     lives
00056Fr 1               
00056Fr 1               new_wave:
00056Fr 1  20 rr rr             jsr     sfx_off
000572r 1  20 rr rr             jsr     init_wave
000575r 1  20 rr rr             jsr     draw_all
000578r 1               
000578r 1               ; ---- main loop ---------------------------------------------------------------
000578r 1               game_loop:
000578r 1  20 rr rr             jsr     sfx_poll
00057Br 1  20 rr rr             jsr     read_keys
00057Er 1  AD rr rr             lda     quit
000581r 1  F0 03                beq     @noquit
000583r 1  4C rr rr             jmp     exit_game
000586r 1               @noquit:
000586r 1  20 rr rr             jsr     move_player
000589r 1  20 rr rr             jsr     move_bullet
00058Cr 1  20 rr rr             jsr     fire
00058Fr 1  20 rr rr             jsr     move_bombs
000592r 1  AD rr rr             lda     dead
000595r 1  F0 08                beq     @alive
000597r 1  20 rr rr             jsr     player_died
00059Ar 1  AD rr rr             lda     lives
00059Dr 1  F0 31                beq     game_over
00059Fr 1  20 rr rr     @alive: jsr     spawn_bomb
0005A2r 1  20 rr rr             jsr     ufo_tick
0005A5r 1  20 rr rr             jsr     inv_tick
0005A8r 1  20 rr rr             jsr     expl_tick
0005ABr 1  AD rr rr             lda     invaded
0005AEr 1  D0 20                bne     game_over
0005B0r 1  AD rr rr             lda     alive_count
0005B3r 1  D0 15                bne     @more
0005B5r 1  EE rr rr             inc     wave
0005B8r 1  20 rr rr             jsr     sfx_off
0005BBr 1  A9 0A                lda     #SND_WAVE
0005BDr 1  A2 03                ldx     #3
0005BFr 1  20 rr rr             jsr     sfx_play
0005C2r 1  A9 14                lda     #20
0005C4r 1  20 rr rr             jsr     delay_long      ; 1 s pause between waves
0005C7r 1  4C rr rr             jmp     new_wave
0005CAr 1  20 rr rr     @more:  jsr     tick_delay
0005CDr 1  4C rr rr             jmp     game_loop
0005D0r 1               
0005D0r 1               ; ---- game over ----------------------------------------------------------------
0005D0r 1               game_over:
0005D0r 1  AD rr rr             lda     score+1         ; new high score?
0005D3r 1  CD rr rr             cmp     hiscore+1
0005D6r 1  90 19                bcc     @nohi
0005D8r 1  D0 08                bne     @hi
0005DAr 1  AD rr rr             lda     score
0005DDr 1  CD rr rr             cmp     hiscore
0005E0r 1  90 0F                bcc     @nohi
0005E2r 1  AD rr rr     @hi:    lda     score
0005E5r 1  8D rr rr             sta     hiscore
0005E8r 1  AD rr rr             lda     score+1
0005EBr 1  8D rr rr             sta     hiscore+1
0005EEr 1  20 rr rr             jsr     show_score
0005F1r 1  20 rr rr     @nohi:  jsr     sfx_off
0005F4r 1  A9 0B                lda     #SND_OVER
0005F6r 1  A2 03                ldx     #3
0005F8r 1  20 rr rr             jsr     sfx_play
0005FBr 1  20 rr rr             jsr     txt_mode
0005FEr 1  A9 rr                lda     #<over_txt
000600r 1  A0 rr                ldy     #>over_txt
000602r 1  20 rr rr             jsr     print
000605r 1  A9 14                lda     #20
000607r 1  20 rr rr             jsr     delay_long      ; ignore keys for a second
00060Ar 1  20 rr rr             jsr     flush_in
00060Dr 1  20 rr rr     @wait:  jsr     menu_key
000610r 1  C9 51                cmp     #'Q'
000612r 1  F0 15                beq     exit_game
000614r 1  C9 4D                cmp     #'M'
000616r 1  D0 06                bne     @nm
000618r 1  20 rr rr             jsr     toggle_sound
00061Br 1  4C rr rr             jmp     @wait
00061Er 1  C9 20        @nm:    cmp     #' '            ; space or the pad's A / Start: play again
000620r 1  F0 04                beq     @again
000622r 1  C9 80                cmp     #PAD_GO
000624r 1  D0 E7                bne     @wait
000626r 1  4C rr rr     @again: jmp     new_game
000629r 1               
000629r 1               ; ---- quit ------------------------------------------------------------------
000629r 1               exit_game:
000629r 1  20 rr rr             jsr     sfx_off
00062Cr 1  20 rr rr             jsr     txt_mode
00062Fr 1  A9 rr                lda     #<bye_txt
000631r 1  A0 rr                ldy     #>bye_txt
000633r 1  20 rr rr             jsr     print
000636r 1               exit_menu:
000636r 1  4C 06 FE             jmp     SBC_MENU        ; back to the boot menu
000639r 1               
000639r 1               ; ============================================================================
