00065Er 1  8D rr rr             sta     tmp
000661r 1  0A                   asl
000662r 1  6D rr rr             adc     tmp
000665r 1  A8                   tay
000666r 1  E0 06                cpx     #T_BLANK
000668r 1  F0 1A                beq     @blank
