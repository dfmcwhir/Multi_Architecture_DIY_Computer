000794r 1  20 rr rr             jsr     gotoxy
000797r 1  AD rr rr             lda     score+1
00079Ar 1  20 rr rr             jsr     prbcd
00079Dr 1  AD rr rr             lda     score
0007A0r 1  20 rr rr             jsr     prbcd
0007A3r 1  A2 26                ldx     #38
0007A5r 1  A0 00                ldy     #0
0007A7r 1  20 rr rr             jsr     gotoxy
