000CB7r 1  18                   clc
000CB8r 1  6D rr rr             adc     dir
000CBBr 1  9D rr rr             sta     rowx,x
000CBEr 1  20 rr rr     @draw:  jsr     draw_row
000CC1r 1  CE rr rr             dec     cur_row
000CC4r 1  60                   rts
