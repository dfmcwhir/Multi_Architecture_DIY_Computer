000BE0r 1  4A                   lsr
000BE1r 1  4A                   lsr
000BE2r 1  CD rr rr             cmp     dr_row
000BE5r 1  D0 05                bne     @1
000BE7r 1  A9 01                lda     #1
000BE9r 1  8D rr rr             sta     tmp
000BECr 1  C8           @1:     iny
000BEDr 1  98                   tya
000BEEr 1  4A                   lsr
000BEFr 1  4A                   lsr
000BF0r 1  CD rr rr             cmp     dr_row
000BF3r 1  D0 08                bne     @2
000BF5r 1  AD rr rr             lda     tmp
000BF8r 1  09 02                ora     #2
000BFAr 1  8D rr rr             sta     tmp
000BFDr 1  AD rr rr     @2:     lda     tmp
000C00r 1  60                   rts
000C01r 1  A9 00        @none:  lda     #0
000C03r 1  60                   rts
000C04r 1               
000C04r 1               ; erase a 2 pixel shot at X, Y unless keep (in A) says it was drawn over
000C04r 1               erase_shot:
000C04r 1  8D rr rr             sta     tmp
000C07r 1  4E rr rr             lsr     tmp
000C0Ar 1  B0 03                bcs     @1
000C0Cr 1  20 rr rr             jsr     clrpix
000C0Fr 1  C8           @1:     iny
000C10r 1  4E rr rr             lsr     tmp
000C13r 1  B0 03                bcs     @2
000C15r 1  20 rr rr             jsr     clrpix
000C18r 1  88           @2:     dey
000C19r 1  60                   rts
000C1Ar 1               
000C1Ar 1               ; blank row X where it is now (before it moves down a line).  Preserves X.
