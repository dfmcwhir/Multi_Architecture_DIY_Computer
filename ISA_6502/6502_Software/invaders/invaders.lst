0006BBr 1  0A                   asl
0006BCr 1  18                   clc
0006BDr 1  69 04                adc     #FORM_Y
0006BFr 1  9D rr rr             sta     rowy,x
0006C2r 1  AD rr rr             lda     wave
0006C5r 1  C9 04                cmp     #4
0006C7r 1  90 02                bcc     @w
0006C9r 1  A9 04                lda     #4
