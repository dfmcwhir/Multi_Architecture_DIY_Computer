000C80r 1  18                   clc
000C81r 1  69 01                adc     #1
000C83r 1  8D rr rr             sta     inv_t
000C86r 1  AE rr rr     @find:  ldx     cur_row
000C89r 1  30 3A                bmi     @sweep_end
000C8Br 1  BD rr rr             lda     alive,x
000C8Er 1  D0 06                bne     @do
