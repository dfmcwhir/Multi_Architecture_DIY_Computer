00174Br 2  C9 2E                cmp     #'.'
00174Dr 2  D0 20                bne     @norm
00174Fr 2  AE rr rr             ldx     mon_x               ; ".."  drop the last part
001752r 2  F0 0C                beq     @popd
001754r 2  CA           @pl:    dex
001755r 2  BD rr rr             lda     ch_name,x
001758r 2  C9 2F                cmp     #'/'
00175Ar 2  F0 04                beq     @popd
00175Cr 2  E0 00                cpx     #0
00175Er 2  D0 F4                bne     @pl
001760r 2  8E rr rr     @popd:  stx     mon_x
001763r 2  A9 00                lda     #0
