001602r 2               
001602r 2               
001602r 2               ; ---------------------------------------------------------------------------
001602r 2               ; Current directory and path helpers
001602r 2               ; ---------------------------------------------------------------------------
001602r 2               .segment "BIOSVARS"
000045r 2  xx xx xx xx  mon_cwd:    .res 32                 ; current directory: "" (root) or "/A/B" (max 31)
000049r 2  xx xx xx xx  
00004Dr 2  xx xx xx xx  
000065r 2               .segment "CHVARS"
000071r 2  xx           mon_x:      .res 1                  ; length of the path in ch_name
000072r 2  xx           mon_y:      .res 1                  ; read position in the input line
000073r 2  xx           mon_cl:     .res 1                  ; length of the path part being read
000074r 2  xx           mon_kind:   .res 1                  ; 1 = path ends in a directory ("..", ".", "/")
000075r 2  xx           mon_end:    .res 1                  ; end of the directory part of ch_name
000076r 2  xx           mon_t:      .res 1
000077r 2  xx           mon_flag:   .res 1                  ; 1 = last part contains a "."
000078r 2               mon_comp    = ch_ent                ; scratch: the path part being read (ch_ent is free here)
000078r 2               .segment "BIOS"
001602r 2               
001602r 2               ERR_OPEN_DIR     = $41              ; CH376: FILE_OPEN found a directory
001602r 2               
001602r 2               ; mon_enter - open the directories of the path in ch_name[0..mon_end) one level
001602r 2               ; at a time ("/A" first, then "B" relative to it).  The CH376 keeps the last
001602r 2               ; directory it opened as the current one.
001602r 2               ;   out: A = status of the last open (ERR_OPEN_DIR = all went well)
001602r 2               mon_enter:
001602r 2  A0 00                ldy     #0
001604r 2  CC rr rr     @next:  cpy     mon_end
001607r 2  B0 38                bcs     @done
001609r 2  A2 00                ldx     #0
00160Br 2  B9 rr rr             lda     ch_name,y           ; the '/'
00160Er 2  C0 00                cpy     #0
001610r 2  D0 04                bne     @skip               ; only the first name starts with '/'
001612r 2  9D rr rr             sta     mon_comp,x
001615r 2  E8                   inx
001616r 2  C8           @skip:  iny
001617r 2  CC rr rr     @cp:    cpy     mon_end
00161Ar 2  B0 0E                bcs     @end
00161Cr 2  B9 rr rr             lda     ch_name,y
00161Fr 2  C9 2F                cmp     #'/'
001621r 2  F0 07                beq     @end
001623r 2  9D rr rr             sta     mon_comp,x
001626r 2  E8                   inx
001627r 2  C8                   iny
001628r 2  D0 ED                bne     @cp
00162Ar 2  A9 00        @end:   lda     #0
00162Cr 2  9D rr rr             sta     mon_comp,x
00162Fr 2  8C rr rr             sty     mon_t
001632r 2  A9 rr                lda     #<mon_comp
001634r 2  A2 rr                ldx     #>mon_comp
001636r 2  20 rr rr             jsr     ch_file_open
001639r 2  AC rr rr             ldy     mon_t
00163Cr 2  C9 41                cmp     #ERR_OPEN_DIR
00163Er 2  F0 C4                beq     @next
001640r 2  60                   rts
001641r 2  A9 41        @done:  lda     #ERR_OPEN_DIR
001643r 2  60                   rts
001644r 2               
001644r 2               ; mon_open - FILE_OPEN the full path in ch_name ("/NAME.EXT" or "/A/B/NAME.EXT")
001644r 2               ;   out: A = status.  Directories are entered one level at a time first.
001644r 2               mon_open:
001644r 2  A2 00                ldx     #0
001646r 2  8E rr rr             stx     mon_end             ; position of the last '/'
001649r 2  BD rr rr     @f:     lda     ch_name,x
00164Cr 2  F0 0A                beq     @e
00164Er 2  C9 2F                cmp     #'/'
001650r 2  D0 03                bne     @n
001652r 2  8E rr rr             stx     mon_end
001655r 2  E8           @n:     inx
001656r 2  D0 F1                bne     @f
001658r 2  AD rr rr     @e:     lda     mon_end
00165Br 2  F0 20                beq     @root               ; file in the root directory
00165Dr 2  20 rr rr             jsr     mon_enter
001660r 2  C9 41                cmp     #ERR_OPEN_DIR
001662r 2  D0 20                bne     @r
001664r 2  AE rr rr             ldx     mon_end             ; the last part, now relative
001667r 2  E8                   inx
001668r 2  A0 00                ldy     #0
00166Ar 2  BD rr rr     @m:     lda     ch_name,x
00166Dr 2  99 rr rr             sta     mon_comp,y
001670r 2  F0 04                beq     @go
001672r 2  E8                   inx
001673r 2  C8                   iny
001674r 2  D0 F4                bne     @m
001676r 2  A9 rr        @go:    lda     #<mon_comp
001678r 2  A2 rr                ldx     #>mon_comp
00167Ar 2  4C rr rr             jmp     ch_file_open
00167Dr 2  A9 rr        @root:  lda     #<ch_name
00167Fr 2  A2 rr                ldx     #>ch_name
001681r 2  4C rr rr             jmp     ch_file_open
001684r 2  60           @r:     rts
001685r 2               
001685r 2               ; mon_copy_cwd - ch_name = mon_cwd, mon_x = X = its length
001685r 2               mon_copy_cwd:
001685r 2  A2 00                ldx     #0
001687r 2  BD rr rr     @l:     lda     mon_cwd,x
00168Ar 2  9D rr rr             sta     ch_name,x
00168Dr 2  F0 03                beq     @d
00168Fr 2  E8                   inx
001690r 2  D0 F5                bne     @l
001692r 2  8E rr rr     @d:     stx     mon_x
001695r 2  60                   rts
001696r 2               
001696r 2               ; mon_showcwd - CR LF and the current directory ("/" for the root)
001696r 2               mon_showcwd:
001696r 2  A9 rr                lda     #<mon_crlf
001698r 2  A0 rr                ldy     #>mon_crlf
00169Ar 2  20 rr rr             jsr     mon_puts
00169Dr 2  AD rr rr             lda     mon_cwd
0016A0r 2  D0 05                bne     @p
0016A2r 2  A9 2F                lda     #'/'
0016A4r 2  4C rr rr             jmp     CHROUT
0016A7r 2  A9 rr        @p:     lda     #<mon_cwd
0016A9r 2  A0 rr                ldy     #>mon_cwd
0016ABr 2  4C rr rr             jmp     mon_puts
0016AEr 2               
0016AEr 2               mon_badpath:
0016AEr 2  A9 rr                lda     #<mon_badp
0016B0r 2  A0 rr                ldy     #>mon_badp
0016B2r 2  20 rr rr             jsr     mon_puts
0016B5r 2  38                   sec
0016B6r 2  60                   rts
0016B7r 2               
0016B7r 2               ; mon_path - turn the text at IN+mon_y into a full path in ch_name (starting at
0016B7r 2               ; the current directory unless the text begins with "/" or "\").
0016B7r 2               ;   out: carry clear: ch_name = path ("" = root), mon_x = its length,
0016B7r 2               ;        mon_kind = 1 if it ends in ".." "." or "/", mon_flag = last part has a ".",
0016B7r 2               ;        mon_y = index of the character after the path (blank or CR)
0016B7r 2               ;        carry set: path too long / part too long
0016B7r 2               mon_path:
0016B7r 2  20 rr rr             jsr     mon_copy_cwd
0016BAr 2  A9 00                lda     #0
0016BCr 2  8D rr rr             sta     mon_kind
0016BFr 2  8D rr rr             sta     mon_flag
0016C2r 2  AC rr rr             ldy     mon_y
0016C5r 2  B9 00 02             lda     IN,y
0016C8r 2  C9 2F                cmp     #'/'
0016CAr 2  F0 04                beq     @abs
0016CCr 2  C9 5C                cmp     #'\'
0016CEr 2  D0 0E                bne     @comp
0016D0r 2  C8           @abs:   iny                         ; absolute: start again at the root
0016D1r 2  A9 00                lda     #0
0016D3r 2  8D rr rr             sta     mon_x
0016D6r 2  8D rr rr             sta     ch_name
0016D9r 2  A9 01                lda     #1
0016DBr 2  8D rr rr             sta     mon_kind
0016DEr 2  B9 00 02     @comp:  lda     IN,y
0016E1r 2  C9 0D                cmp     #$0D
0016E3r 2  F0 06                beq     @fin
0016E5r 2  C9 20                cmp     #' '
0016E7r 2  F0 02                beq     @fin
0016E9r 2  D0 03                bne     @nfin
