001732r 2  C9 2E                cmp     #'.'
001734r 2  D0 39                bne     @norm
001736r 2  A9 01                lda     #1                  ; "."  stay where we are
001738r 2  8D rr rr             sta     mon_kind
00173Br 2  D0 6F                bne     @next
00173Dr 2  E0 02        @n2:    cpx     #2
00173Fr 2  D0 2E                bne     @norm
001741r 2  AD rr rr             lda     mon_comp
001744r 2  C9 2E                cmp     #'.'
001746r 2  D0 27                bne     @norm
