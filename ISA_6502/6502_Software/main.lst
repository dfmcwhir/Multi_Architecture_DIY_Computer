0028DFr 2               
0028DFr 2               AA_end_basic
0028DFr 2               
0028DFr 1               .include "bios.s"               ; hardware, boot menu, IRQ  (BIOS, vars, RESETVEC)
0028DFr 2               ; ============================================================================
0028DFr 2               ; bios.s - hardware layer for the custom 6502 SBC, EhBASIC build
0028DFr 2               ;
0028DFr 2               ; Based on the msbasic bios.s.  What changed:
0028DFr 2               ;   * CHRIN no longer echoes.  EhBASIC echoes what it reads, and wozmon.s
0028DFr 2               ;     echoes for itself, so echoing here would double every character.
0028DFr 2               ;   * RESET now does all hardware init, copies EhBASIC's I/O vectors into
0028DFr 2               ;     RAM, and shows a boot menu: [C]old start, [W]arm start, [M]onitor.
0028DFr 2               ;   * Variables are real linker segments (no more .org tricks).
0028DFr 2               ;   * Unused IRQ lines can flag EhBASIC's "ON IRQ" (see IRQ_BASIC below).
0028DFr 2               ;   * NMI goes through EhBASIC's RAM NMI handler (NMI_vec) so "ON NMI" works.
0028DFr 2               ;
0028DFr 2               ; This file must be included AFTER basic.s (it uses basic.s's zero page
0028DFr 2               ; symbols IrqBase/NmiBase and RAM symbols VEC_IN/NMI_vec).
0028DFr 2               ; ============================================================================
0028DFr 2               
0028DFr 2               ; ----------------------------------------------------------------------------
0028DFr 2               ; Zero page (placed by sbc.cfg in the free area $E2-$EE of EhBASIC's zero page)
0028DFr 2               ; ----------------------------------------------------------------------------
0028DFr 2               .zeropage
000000r 2  xx           READ_PTR:       .res 1
000001r 2  xx           WRITE_PTR:      .res 1
000002r 2  xx xx        TEMP_IRQ_ADDR:  .res 2
000004r 2               
000004r 2               ; ----------------------------------------------------------------------------
000004r 2               ; RAM variables (sbc.cfg: BIOSVARS at $0380)
000004r 2               ; ----------------------------------------------------------------------------
000004r 2               .segment "BIOSVARS"
000000r 2  xx           LAST_CHAR:      .res 1
000001r 2  xx           DEVSTAT:        .res 1
000002r 2  xx           UI_DATA_OFF:    .res 1
000003r 2  xx           UI_STATUS_OFF:  .res 1
000004r 2  xx           UI_CMD_OFF:     .res 1
000005r 2  xx           UI_CTRL_OFF:    .res 1
000006r 2               
000006r 2               ; ----------------------------------------------------------------------------
000006r 2               ; Serial / keyboard receive buffer, 256 bytes (sbc.cfg: INPUT_BUFFER at $0400)
000006r 2               ; ----------------------------------------------------------------------------
000006r 2               .segment "INPUT_BUFFER"
000000r 2  xx xx xx xx  INPUT_BUFFER:   .res $100
000004r 2  xx xx xx xx  
000008r 2  xx xx xx xx  
000100r 2               
000100r 2               
000100r 2               .segment "BIOS"
000000r 2               
000000r 2               ;IO address offsets from IO_BASE
000000r 2               IO_BASE         = $7f00
000000r 2  14           ACIA_DATA_OFF:      .byte $14
000001r 2  15           ACIA_STATUS_OFF:    .byte $15
000002r 2  16           ACIA_CMD_OFF:       .byte $16
000003r 2  17           ACIA_CTRL_OFF:      .byte $17
000004r 2  18           KEYBDISP_DATA_OFF:  .byte $18
000005r 2  19           KEYBDISP_STATUS_OFF:    .byte $19
000006r 2  1A           KEYBDISP_CMD_OFF:   .byte $1a
000007r 2  1B           KEYBDISP_CTRL_OFF:  .byte $1b
000008r 2  00           PORTB_OFF:          .byte $00
000009r 2  01           PORTA_OFF:          .byte $01
00000Ar 2  02           DDRB_OFF:           .byte $02
00000Br 2  03           DDRA_OFF:           .byte $03
00000Cr 2  0D           IFR_OFF:            .byte $0d
00000Dr 2  0E           IER_OFF:            .byte $0e
00000Er 2  FF           IRQPORT_OFF:        .byte $ff
00000Fr 2               
00000Fr 2               ;ACIA_DATA       = $7f14
00000Fr 2               ;ACIA_STATUS     = $7f15
00000Fr 2               ;ACIA_CMD        = $7f16
00000Fr 2               ;ACIA_CTRL       = $7f17
00000Fr 2               ;KEYBDISP_DATA   = $7f18
00000Fr 2               ;KEYBDISP_STATUS = $7f19
00000Fr 2               ;KEYBDISP_CMD    = $7f1a
00000Fr 2               ;KEYBDISP_CTRL   = $7f1b
00000Fr 2               PORTB           = $7f00
00000Fr 2               PORTA           = $7f01
00000Fr 2               DDRB            = $7f02
00000Fr 2               DDRA            = $7f03
00000Fr 2               IFR             = $7f0d
00000Fr 2               IER             = $7f0e
00000Fr 2               IRQPORT         = $7fff
00000Fr 2               
00000Fr 2               
00000Fr 2               ; ============================================================================
00000Fr 2               ; RESET - entry point from the reset vector
00000Fr 2               ; ============================================================================
00000Fr 2               RESET:
00000Fr 2  D8                   cld
000010r 2  78                   sei
000011r 2  A2 FF                ldx     #$ff
000013r 2  9A                   txs                     ; empty the stack
000014r 2  A9 00                lda #0
000016r 2  8D rr rr             sta mon_cwd          	; "" = the top folder
000019r 2               
000019r 2  A9 00                lda     #0
00001Br 2  8D rr rr             sta     DEVSTAT         ; clear device status flags
00001Er 2  20 rr rr             jsr     CH_BOOT         ; CH376 is initialised lazily on first LOAD/SAVE
000021r 2  20 rr rr     		jsr     I2C_BOOT        ; PCF8584 and LCD are initialised on first use
000024r 2  20 rr rr             jsr     INIT_BUFFER
000027r 2  20 rr rr             jsr     INIT_IO
00002Ar 2  20 rr rr             jsr     PAD_INIT        ; gamepad on VIA port A (gamepad.s)
00002Dr 2  20 rr rr             jsr     INIT_SERIAL
000030r 2  20 rr rr             jsr     INIT_DISPLAY
000033r 2  20 rr rr             jsr     SET_UI_DEVICE   ; if init display initialised a device, output goes
000036r 2                                               ; there, otherwise to the serial port
000036r 2  20 rr rr             jsr     COPY_VECTORS    ; EhBASIC I/O vectors + NMI code into RAM
000039r 2                                               ; (falls into MENU)
000039r 2               
000039r 2               ; ----------------------------------------------------------------------------
000039r 2               ; MENU - boot menu.  Also reachable with CTRL-C from the monitor.
000039r 2               ; ----------------------------------------------------------------------------
000039r 2               MENU:
000039r 2  D8                   cld
00003Ar 2  A2 FF                ldx     #$ff
00003Cr 2  9A                   txs
00003Dr 2  58                   cli
00003Er 2  A0 00                ldy     #0
000040r 2  B9 rr rr     @print: lda     MENU_MSG,y
000043r 2  F0 06                beq     @wait
000045r 2  20 rr rr             jsr     CHROUT
000048r 2  C8                   iny
000049r 2  D0 F5                bne     @print
00004Br 2  20 rr rr     @wait:  jsr     CHRIN
00004Er 2  90 FB                bcc     @wait
000050r 2  29 DF                and     #$DF            ; force upper case
000052r 2  C9 43                cmp     #'C'
000054r 2  F0 0A                beq     @cold
000056r 2  C9 57                cmp     #'W'
000058r 2  F0 09                beq     @warm
00005Ar 2  C9 4D                cmp     #'M'
00005Cr 2  F0 08                beq     @mon
00005Er 2  D0 EB                bne     @wait           ; anything else: keep waiting
000060r 2  4C rr rr     @cold:  jmp     LAB_COLD        ; EhBASIC cold start
000063r 2  4C 00 00     @warm:  jmp     LAB_WARM        ; EhBASIC warm start (program in RAM is kept)
000066r 2  4C rr rr     @mon:   jmp     WOZ_ENTRY       ; wozmon
000069r 2               
000069r 2               MENU_MSG:
000069r 2  0D 0A 36 35          .byte   $0D,$0A,"6502 SBC - EhBASIC 2.22",$0D,$0A
00006Dr 2  30 32 20 53  
000071r 2  42 43 20 2D  
000084r 2  5B 43 5D 6F          .byte   "[C]old start, [W]arm start, [M]onitor? ",$00
000088r 2  6C 64 20 73  
00008Cr 2  74 61 72 74  
0000ACr 2               
0000ACr 2               
0000ACr 2               ; ----------------------------------------------------------------------------
0000ACr 2               ; COPY_VECTORS - copy VEC_BLOCK to RAM, starting at VEC_IN:
0000ACr 2               ;   VEC_IN, VEC_OUT, VEC_LD, VEC_SV   EhBASIC's I/O vectors
0000ACr 2               ;   IRQ_vec: 10 bytes                 EhBASIC's RAM IRQ code (not used here: the
0000ACr 2               ;                                     real IRQ vector points at "irq" below)
0000ACr 2               ;   NMI_vec: 10 bytes                 EhBASIC's RAM NMI code (NMI vector -> here)
0000ACr 2               ; modifies A, Y, flags
0000ACr 2               ; ----------------------------------------------------------------------------
0000ACr 2               COPY_VECTORS:
0000ACr 2  A0 1C                ldy     #VEC_BLOCK_END-VEC_BLOCK
0000AEr 2  B9 rr rr     @loop:  lda     VEC_BLOCK-1,y
0000B1r 2  99 04 03             sta     VEC_IN-1,y
0000B4r 2  88                   dey
0000B5r 2  D0 F7                bne     @loop
0000B7r 2  60                   rts
0000B8r 2               
0000B8r 2               VEC_BLOCK:
0000B8r 2  rr rr                .word   CHRIN           ; VEC_IN  - byte in from keyboard/serial
0000BAr 2  rr rr                .word   CHROUT          ; VEC_OUT - byte out to screen/serial
0000BCr 2  rr rr                .word   CH_LOAD         ; VEC_LD  - LOAD (ch376_loadsave.s)
0000BEr 2  rr rr                .word   CH_SAVE         ; VEC_SV  - SAVE (ch376_loadsave.s)
0000C0r 2               IRQ_CODE:                       ; EhBASIC IRQ support (10 bytes, copied to IRQ_vec)
0000C0r 2  48                   pha
0000C1r 2  A5 DF                lda     IrqBase         ; get the IRQ flag byte
0000C3r 2  4A                   lsr                     ; shift the set b7 to b6, and on down ...
0000C4r 2  05 DF                ora     IrqBase         ; OR the original back in
0000C6r 2  85 DF                sta     IrqBase         ; save the new IRQ flag byte
0000C8r 2  68                   pla
0000C9r 2  40                   rti
0000CAr 2               NMI_CODE:                       ; EhBASIC NMI support (10 bytes, copied to NMI_vec)
0000CAr 2  48                   pha
0000CBr 2  A5 DC                lda     NmiBase         ; get the NMI flag byte
0000CDr 2  4A                   lsr                     ; shift the set b7 to b6, and on down ...
0000CEr 2  05 DC                ora     NmiBase         ; OR the original back in
0000D0r 2  85 DC                sta     NmiBase         ; save the new NMI flag byte
0000D2r 2  68                   pla
0000D3r 2  40                   rti
0000D4r 2               VEC_BLOCK_END:
0000D4r 2               
0000D4r 2               
0000D4r 2               ; Initialize the IO port
0000D4r 2               ; modifies A, Y, flags
0000D4r 2               INIT_IO:
0000D4r 2  AC rr rr             ldy     IER_OFF
0000D7r 2  A9 7F                lda     #$7f
0000D9r 2  99 00 7F             sta     IO_BASE,Y
0000DCr 2  59 00 7F             eor     IO_BASE,Y       ;check if IER was set to value as a check to see if device is present
0000DFr 2  D0 20                bne     IO_INIT_DONE    ;device not present
0000E1r 2  A9 01                lda     #1
0000E3r 2  0D rr rr             ora     DEVSTAT
0000E6r 2  8D rr rr             sta     DEVSTAT         ; set bit 0 of device status indicator
0000E9r 2  AC rr rr             ldy     IFR_OFF
0000ECr 2  A9 80                lda     #$80
0000EEr 2  99 00 7F             sta     IO_BASE,Y
0000F1r 2  AC rr rr             ldy     DDRB_OFF
0000F4r 2  A9 FF                lda     #$ff
0000F6r 2  99 00 7F             sta     IO_BASE,Y
0000F9r 2  A9 01                lda     #$1
0000FBr 2  AC rr rr             ldy     PORTB_OFF
0000FEr 2  99 00 7F             sta     IO_BASE,y
000101r 2               IO_INIT_DONE:
000101r 2  60                   rts
000102r 2               
000102r 2               
000102r 2               ;Initializes the serial port
000102r 2               ; modifies A, Y, flags
000102r 2               INIT_SERIAL:
000102r 2  AC rr rr             ldy     ACIA_STATUS_OFF
000105r 2  A9 00                lda     #$00
000107r 2  99 00 7F             sta     IO_BASE,Y
00010Ar 2  AC rr rr             ldy     ACIA_CTRL_OFF
00010Dr 2  A9 1A                lda     #$1a            ; N-8-1 2400 BAUD
00010Fr 2  99 00 7F             sta     IO_BASE,Y
000112r 2  59 00 7F             eor     IO_BASE,Y       ;check if serial control register was set to value as a check to see if device is present
000115r 2  D0 10                bne     SERIAL_INIT_DONE ;device not present
000117r 2  A9 02                lda     #2
000119r 2  0D rr rr             ora     DEVSTAT
00011Cr 2  8D rr rr             sta     DEVSTAT         ; set bit 1 of device status indicator
00011Fr 2  AC rr rr             ldy     ACIA_CMD_OFF
000122r 2  A9 89                lda     #$89            ; no parity, no echo, interrupts
000124r 2  99 00 7F             sta     IO_BASE,Y
000127r 2               
000127r 2               SERIAL_INIT_DONE:
000127r 2  AD rr rr             lda     DEVSTAT
00012Ar 2  AC rr rr             ldy     PORTB_OFF
00012Dr 2  99 00 7F             sta     IO_BASE,y
000130r 2  60                   rts
000131r 2               
000131r 2               ;Initializes the KB_MONITOR_TERMINAL Card
000131r 2               ; modifies A, Y, flags
000131r 2               INIT_DISPLAY:
000131r 2  AC rr rr             ldy     KEYBDISP_STATUS_OFF
000134r 2  A9 00                lda     #$00
000136r 2  99 00 7F             sta     IO_BASE,Y
000139r 2  AC rr rr             ldy     KEYBDISP_CTRL_OFF
00013Cr 2  A9 10                lda     #$10            ; N-8-1 115.2K BAUD
00013Er 2  99 00 7F             sta     IO_BASE,Y
000141r 2  59 00 7F             eor     IO_BASE,Y       ;check if kb display control register was set to value as a check to see if device is present
000144r 2  D0 10                bne     KEYBDISP_INIT_DONE ;device not present
000146r 2  A9 04                lda     #4
000148r 2  0D rr rr             ora     DEVSTAT
00014Br 2  8D rr rr             sta     DEVSTAT         ; set bit 2 of device status indicator
00014Er 2  AC rr rr             ldy     KEYBDISP_CMD_OFF
000151r 2  A9 89                lda     #$89            ; no parity, no echo, interrupts
000153r 2  99 00 7F             sta     IO_BASE,Y
000156r 2               
000156r 2               KEYBDISP_INIT_DONE:
000156r 2  AD rr rr             lda     DEVSTAT
000159r 2  AC rr rr             ldy     PORTB_OFF
00015Cr 2  99 00 7F             sta     IO_BASE,y
00015Fr 2  60                   rts
000160r 2               
000160r 2               ; modifies A,X,Y flags
000160r 2               SET_UI_DEVICE:
000160r 2               
000160r 2  A9 04                lda     #4
000162r 2  2D rr rr             and     DEVSTAT
000165r 2  F0 19                beq     SET_SERIAL_UI
000167r 2  AD rr rr             lda     KEYBDISP_CMD_OFF
00016Ar 2  8D rr rr             sta     UI_CMD_OFF
00016Dr 2  AD rr rr             lda     KEYBDISP_CTRL_OFF
000170r 2  8D rr rr             sta     UI_CTRL_OFF
000173r 2  AD rr rr             lda     KEYBDISP_DATA_OFF
000176r 2  8D rr rr             sta     UI_DATA_OFF
000179r 2  AD rr rr             lda     KEYBDISP_STATUS_OFF
00017Cr 2  8D rr rr             sta     UI_STATUS_OFF
00017Fr 2  60                   rts
000180r 2               SET_SERIAL_UI:
000180r 2  AD rr rr             lda     ACIA_CMD_OFF
000183r 2  8D rr rr             sta     UI_CMD_OFF
000186r 2  AD rr rr             lda     ACIA_CTRL_OFF
000189r 2  8D rr rr             sta     UI_CTRL_OFF
00018Cr 2  AD rr rr             lda     ACIA_DATA_OFF
00018Fr 2  8D rr rr             sta     UI_DATA_OFF
000192r 2  AD rr rr             lda     ACIA_STATUS_OFF
000195r 2  8D rr rr             sta     UI_STATUS_OFF
000198r 2  60                   rts
000199r 2               
000199r 2               
000199r 2               ; ============================================================================
000199r 2               ; CHRIN - input a character (non-blocking, NO echo).
000199r 2               ;   Used as EhBASIC's input vector (VEC_IN) and by the monitor.
000199r 2               ;   On return the carry flag indicates whether a key was available.
000199r 2               ;   If carry is set the key is in A (and Z reflects it, which EhBASIC relies on).
000199r 2               ;   If carry is clear A = 0.
000199r 2               ;   Preserves X and Y.
000199r 2               ;
000199r 2               ; Modifies: flags, A
000199r 2               ; ============================================================================
000199r 2               MONRDKEY:
000199r 2               CHRIN:
000199r 2  8A                   txa                     ; save X
00019Ar 2  48                   pha
00019Br 2               
00019Br 2  20 rr rr             jsr     BUFFER_SIZE
00019Er 2  F0 0A                beq     @no_keypressed
0001A0r 2               
0001A0r 2  20 rr rr             jsr     READ_BUFFER     ; returns character in A (and LAST_CHAR)
0001A3r 2               
0001A3r 2  68                   pla                     ; restore X
0001A4r 2  AA                   tax
0001A5r 2               
0001A5r 2  AD rr rr             lda     LAST_CHAR       ; the character (sets Z/N for the caller)
0001A8r 2  38                   sec                     ; success
0001A9r 2  60                   rts
0001AAr 2               
0001AAr 2               @no_keypressed:
0001AAr 2  68                   pla
0001ABr 2  AA                   tax
0001ACr 2  A9 00                lda     #0
0001AEr 2  18                   clc                     ; no character
0001AFr 2  60                   rts
0001B0r 2               
0001B0r 2               
0001B0r 2               ; ============================================================================
0001B0r 2               ; CHROUT - output a character (from the A register) to the UI interface.
0001B0r 2               ;   Used as EhBASIC's output vector (VEC_OUT) and by the monitor.
0001B0r 2               ;   Preserves A, X and Y.
0001B0r 2               ;
0001B0r 2               ; Modifies: flags
0001B0r 2               ; ============================================================================
0001B0r 2               MONCOUT:
0001B0r 2               CHROUT:
0001B0r 2  8D rr rr             sta     LAST_CHAR
0001B3r 2  48                   pha
0001B4r 2  98                   tya
0001B5r 2  48                   pha
0001B6r 2  AC rr rr             ldy     UI_DATA_OFF
0001B9r 2  AD rr rr             lda     LAST_CHAR
0001BCr 2  99 00 7F             sta     IO_BASE,Y
0001BFr 2               tx_wait:
0001BFr 2  AC rr rr             ldy     UI_STATUS_OFF
0001C2r 2  B9 00 7F             lda     IO_BASE,Y
0001C5r 2  29 10                and     #$10
0001C7r 2  F0 F6                beq     tx_wait
0001C9r 2  68                   pla
0001CAr 2  A8                   tay
0001CBr 2  68                   pla
0001CCr 2  60                   rts
0001CDr 2               
0001CDr 2               ; Initialize the circular input buffer
0001CDr 2               ; Modifies: flags, A
0001CDr 2               INIT_BUFFER:
0001CDr 2  A9 00                lda     #0
0001CFr 2  85 rr                sta     READ_PTR
0001D1r 2  85 rr                sta     WRITE_PTR
0001D3r 2  60                   rts
0001D4r 2               
0001D4r 2               ; Write a character (from the A register) to the circular input buffer
0001D4r 2               ; Modifies: flags, X
0001D4r 2               WRITE_BUFFER:
0001D4r 2  A6 rr                ldx     WRITE_PTR
0001D6r 2  9D rr rr             sta     INPUT_BUFFER,x
0001D9r 2  E6 rr                inc     WRITE_PTR
0001DBr 2  60                   rts
0001DCr 2               
0001DCr 2               ; Read a character from the circular input buffer and put it in the A register
0001DCr 2               ; Modifies: flags, A, X
0001DCr 2               READ_BUFFER:
0001DCr 2  A6 rr                ldx     READ_PTR
0001DEr 2  BD rr rr             lda     INPUT_BUFFER,x
0001E1r 2  8D rr rr             sta     LAST_CHAR
0001E4r 2  E6 rr                inc     READ_PTR
0001E6r 2  60                   rts
0001E7r 2               
0001E7r 2               ; Return (in A) the number of unread bytes in the circular input buffer
0001E7r 2               ; Modifies: flags, A
0001E7r 2               BUFFER_SIZE:
0001E7r 2  A5 rr                lda     WRITE_PTR
0001E9r 2  38                   sec
0001EAr 2  E5 rr                sbc     READ_PTR
0001ECr 2  60                   rts
0001EDr 2               
0001EDr 2               
0001EDr 2               ; ============================================================================
0001EDr 2               ; Interrupts
0001EDr 2               ; ============================================================================
0001EDr 2               irq: ; reads the IRQ priority register and jmps to the appropriate interrupt routine
0001EDr 2  78                   sei
0001EEr 2  48                   PHA
0001EFr 2  8A                   TXA
0001F0r 2  48                   PHA
0001F1r 2  98                   TYA
0001F2r 2  48                   PHA
0001F3r 2  AE FF 7F             LDX     IRQPORT
0001F6r 2  BD rr rr             LDA     IRQTABLE,X
0001F9r 2  85 rr                STA     TEMP_IRQ_ADDR
0001FBr 2  E8                   INX
0001FCr 2  BD rr rr             LDA     IRQTABLE,X
0001FFr 2  85 rr                STA     TEMP_IRQ_ADDR+1
000201r 2  6C rr rr             JMP     (TEMP_IRQ_ADDR)
000204r 2               
000204r 2               
000204r 2               
000204r 2               IRQTABLE:   ; Order of the IRQ subroutines is reversed in the IRQ table due to a schematic error (?). The physical IRQ0 line reads 14
000204r 2                           ;on the IRQ port which is 2x7 and correct. It may not be an actual wiring defect, but a feature becuase it makes it so
000204r 2                           ; IRQ0 has the highest priority and IRQ7 has the lowest. either way, this IRQ table should work.
000204r 2  rr rr                .word IRQ7
000206r 2  rr rr                .word IRQ6
000208r 2  rr rr                .word IRQ5
00020Ar 2  rr rr                .word IRQ4
00020Cr 2  rr rr                .word IRQ3
00020Er 2  rr rr                .word IRQ2
000210r 2  rr rr                .word IRQ1
000212r 2  rr rr                .word IRQ0
000214r 2               
000214r 2               ; Lines the BIOS does not use itself:
000214r 2               ;   IRQ0, IRQ1 not used   IRQ2 IO Card VIA   IRQ4 IO Card I2C   IRQ6, IRQ7 spare
000214r 2               ; They all share this code, which feeds EhBASIC's "ON IRQ" feature: if the BASIC
000214r 2               ; program has enabled IRQ handling, the "interrupt happened" flag gets set and
000214r 2               ; the BASIC handler routine runs at the end of the current statement.  (That
000214r 2               ; handler must clear the interrupt source itself.)  If BASIC has not enabled
000214r 2               ; IRQ handling, IrqBase is 0 and this does nothing, exactly like a plain RTI.
000214r 2               IRQ0:
000214r 2               IRQ1:
000214r 2               IRQ4:
000214r 2               IRQ6:
000214r 2               IRQ7:
000214r 2               IRQ_BASIC:
000214r 2  A5 DF                lda     IrqBase
000216r 2  4A                   lsr
000217r 2  05 DF                ora     IrqBase
000219r 2  85 DF                sta     IrqBase
00021Br 2               IRQ_EXIT:
00021Br 2  68                   PLA
00021Cr 2  A8                   TAY
00021Dr 2  68                   PLA
00021Er 2  AA                   TAX
00021Fr 2  68                   PLA
000220r 2  58                   cli
000221r 2  40                   rti
000222r 2               
000222r 2               IRQ2:      ; IO card VIA: timer 1 = gamepad poll (gamepad.s); anything else is
000222r 2                          ; passed on to BASIC's ON IRQ like the unused lines
000222r 2  AD 0D 7F             lda     IFR
000225r 2  29 40                and     #$40                ; timer 1 timeout?
000227r 2  F0 06                beq     @other
000229r 2  AD 04 7F             lda     VIA_T1CL            ; reading the low counter clears the flag
00022Cr 2  20 rr rr             jsr     PAD_POLL
00022Fr 2  AD 0D 7F     @other: lda     IFR
000232r 2  2D 0E 7F             and     IER
000235r 2  29 3F                and     #$3F                ; another enabled VIA source?
000237r 2  F0 03                beq     @done
000239r 2  4C rr rr             jmp     IRQ_BASIC
00023Cr 2  4C rr rr     @done:  jmp     IRQ_EXIT
00023Fr 2               
00023Fr 2               IRQ3:      ;SERIAL in interrupt
00023Fr 2  AC rr rr             ldy     ACIA_STATUS_OFF
000242r 2  B9 00 7F             lda     IO_BASE,Y
000245r 2  AC rr rr             ldy     ACIA_DATA_OFF
000248r 2  B9 00 7F             lda     IO_BASE,Y
00024Br 2  20 rr rr             jsr     WRITE_BUFFER
00024Er 2  4C rr rr             jmp     IRQ_EXIT
000251r 2               
000251r 2               IRQ5:   ; Keyboard/Display Card
000251r 2  AC rr rr             ldy     KEYBDISP_STATUS_OFF
000254r 2  B9 00 7F             lda     IO_BASE,Y
000257r 2  AC rr rr             ldy     KEYBDISP_DATA_OFF
00025Ar 2  B9 00 7F             lda     IO_BASE,Y
00025Dr 2  20 rr rr             jsr     WRITE_BUFFER
000260r 2  4C rr rr             jmp     IRQ_EXIT
000263r 2               
000263r 2               
000263r 2               ; ============================================================================
000263r 2               ; Vectors  (segment RESETVEC is placed at $FFFA by sbc.cfg)
000263r 2               ; ============================================================================
000263r 2               .segment "RESETVEC"
000000r 2  17 03                .word   NMI_vec         ; NMI vector   -> EhBASIC's RAM NMI handler
000002r 2  rr rr                .word   RESET           ; RESET vector
000004r 2  rr rr                .word   irq             ; IRQ vector
000006r 2               
000006r 1               .include "ch376_abs.s"          ; CH376 USB/SD driver       (CHVARS, BIOS)
000006r 2               ; ============================================================================
000006r 2               ; CH376 USB/SD file driver for 6502 - 8-bit PARALLEL interface   (ca65 syntax)
000006r 2               ; ============================================================================
000006r 2               ; HARDWARE
000006r 2               ;   CH376 D0-D7 -> 6502 D0-D7
000006r 2               ;   CH376 A0    -> 6502 A0          (A0=0: data port, A0=1: command/status port)
000006r 2               ;   CH376 CS#   -> your address decode (active low), e.g. $7F20-$7F21
000006r 2               ;   CH376 RD#   -> NAND(PHI2, R/W)          (low during a read cycle)
000006r 2               ;   CH376 WR#   -> NAND(PHI2, NOT R/W)      (low during a write cycle)
000006r 2               ;   CH376 INT#  -> optional (this code polls bit 7 of the status port instead)
000006r 2               ;   CH376 RST   -> reset circuit (or tie low->high at power-up)
000006r 2               ;   Many cheap CH376 modules only break out UART/SPI. Make sure your module
000006r 2               ;   exposes D0-D7/A0/CS/RD/WR and has the parallel interface selected.
000006r 2               ;
000006r 2               ; PORTS
000006r 2               ;   CH_DATA ($7F20) read/write data bytes
000006r 2               ;   CH_CMD  ($7F21) write = command code, read = status
000006r 2               ;       bit 7 (INTB): 0 = interrupt active (operation finished)
000006r 2               ;       bit 4 (BUSY): 1 = chip busy, don't access yet
000006r 2               ;
000006r 2               ; CONVENTIONS
000006r 2               ;   Routines that return a CH376 status in A: $14 = success, anything else
000006r 2               ;   is an error (or a "need data" code for read/write, handled internally).
000006r 2               ;   ch_init / ch_mount return carry set on failure.
000006r 2               ;   File names: 8.3, UPPERCASE, null terminated, root dir = "/NAME.EXT"
000006r 2               ; ============================================================================
000006r 2               
000006r 2               CH_BASE   = $7F20
000006r 2               CH_DATA   = CH_BASE
000006r 2               CH_CMD    = CH_BASE + 1
000006r 2               
000006r 2               CPU_KHZ   = CPU_MHZ * 1000             ; CPU clock in kHz (CPU_MHZ is set in main.s)
000006r 2               ; one delay "tick" = ~1285 cycles
000006r 2               DELAY_40MS = (CPU_KHZ * 40) / 1285 + 1
000006r 2               .assert DELAY_40MS < 256, error, "CPU_MHZ too high for the 8 bit delay counter"
000006r 2               
000006r 2               .zeropage
000004r 2  xx xx        zp_ptr:   .res 2    ; 2 bytes of zero page used for (pointer),Y while a transfer runs
000006r 2  xx xx        strptr:   .res 2    ; string pointer (LCD routines, monitor and CH376 messages); declared here
000008r 2                                   ; so it is known before first use (zero page addressing)
000008r 2               
000008r 2               ; --- variables -------------------------------------------------------------
000008r 2               ; All CH376 variables live in segment CHVARS (placed at $0280 by sbc.cfg).
000008r 2               ; Layout is identical to the old VARS+n block (90 bytes total).
000008r 2               .segment "CHVARS"
000000r 2  xx xx        ch_ptr:     .res 2   ; buffer pointer (caller sets, advanced by read/write)
000002r 2  xx xx        ch_len:     .res 2   ; bytes requested
000004r 2  xx xx        ch_got:     .res 2   ; bytes actually read (output of ch_read)
000006r 2  xx           ch_cnt:     .res 1   ; chunk counter
000007r 2  xx           ch_tmp:     .res 1   ; timeout counter
000008r 2  xx           ch_retry:   .res 1   ; mount retry counter
000009r 2  xx xx xx xx  ch_off:     .res 4   ; file offset for ch_seek (little endian)
00000Dr 2               ; --- used by ch376_loadsave.s
00000Dr 2  xx xx xx xx  ch_name:    .res 48  ; "/NAME.BAS",0 (a path such as "/GAMES/DEEP/X.BIN" for the monitor)
000011r 2  xx xx xx xx  
000015r 2  xx xx xx xx  
00003Dr 2  xx           ch_ready:   .res 1   ; 0 = CH376 not initialised / mounted
00003Er 2  xx           ch_dot:     .res 1   ; non-zero if the name contained a "."
00003Fr 2  xx           ch_dir:     .res 1   ; non-zero: LOAD "$..." (directory listing)
000040r 2  xx xx xx xx  ch_ent:     .res 32  ; directory entry from the chip
000044r 2  xx xx xx xx  
000048r 2  xx xx xx xx  
000060r 2  xx xx xx xx  ch_num:     .res 4   ; number being printed
000064r 2  xx           ch_col:     .res 1   ; column counter while printing a name
000065r 2  xx           ch_started: .res 1   ; leading-zero suppression flag
000066r 2  xx xx        ch_nfiles:  .res 2   ; files listed
000068r 2  xx           ch_sx:      .res 1   ; saved X / Y around the output routine
000069r 2  xx           ch_sy:      .res 1
00006Ar 2  xx           ch_lastcmd: .res 1   ; last command byte sent to the chip (diagnostics)
00006Br 2  xx           ch_laststs: .res 1   ; raw status port value when a wait timed out
00006Cr 2  xx           ch_mon:     .res 1   ; non-zero while a monitor command is using the CH376 code
00006Dr 2  xx           ch_raw:     .res 1   ; 0 = LOAD/SAVE (.BAS), 1 = LOADRAW/SAVERAW (.DAT)
00006Er 2  xx xx        ch_a0:      .res 2   ; LOADRAW/SAVERAW start address
000070r 2  xx           ch_stat:    .res 1   ; last CH376 status code that caused a ?DISK ERROR
000071r 2               
000071r 2               ; The 6502 can only do (pointer),Y indirection through ZERO PAGE, so two
000071r 2               ; zero-page bytes (zp_ptr, reserved above) are used while a transfer runs.
000071r 2               ; ZP_ENTER/ZP_LEAVE still save/restore them, which is harmless.
000071r 2               
000071r 2               
000071r 2               
000071r 2               .macro ZP_ENTER                      ; save zp pair, load it with ch_ptr
000071r 2                       lda zp_ptr
000071r 2                       pha
000071r 2                       lda zp_ptr+1
000071r 2                       pha
000071r 2                       lda ch_ptr
000071r 2                       sta zp_ptr
000071r 2                       lda ch_ptr+1
000071r 2                       sta zp_ptr+1
000071r 2               .endmacro
000071r 2               
000071r 2               .macro ZP_LEAVE                      ; store advanced pointer back, restore zp
000071r 2                       lda zp_ptr
000071r 2                       sta ch_ptr
000071r 2                       lda zp_ptr+1
000071r 2                       sta ch_ptr+1
000071r 2                       pla
000071r 2                       sta zp_ptr+1
000071r 2                       pla
000071r 2                       sta zp_ptr
000071r 2               .endmacro
000071r 2               
000071r 2               .segment "BIOS"
000263r 2               ; --- commands --------------------------------------------------------------
000263r 2               CMD_GET_IC_VER    = $01
000263r 2               CMD_RESET_ALL     = $05
000263r 2               CMD_CHECK_EXIST   = $06
000263r 2               CMD_SET_USB_MODE  = $15
000263r 2               CMD_GET_STATUS    = $22
000263r 2               CMD_RD_USB_DATA0  = $27
000263r 2               CMD_WR_REQ_DATA   = $2D
000263r 2               CMD_SET_FILE_NAME = $2F
000263r 2               CMD_DISK_CONNECT  = $30
000263r 2               CMD_DISK_MOUNT    = $31
000263r 2               CMD_FILE_OPEN     = $32
000263r 2               CMD_FILE_CREATE   = $34
000263r 2               CMD_FILE_ERASE    = $35
000263r 2               CMD_FILE_CLOSE    = $36
000263r 2               CMD_BYTE_LOCATE   = $39
000263r 2               CMD_BYTE_READ     = $3A
000263r 2               CMD_BYTE_RD_GO    = $3B
000263r 2               CMD_BYTE_WRITE    = $3C
000263r 2               CMD_BYTE_WR_GO    = $3D
000263r 2               
000263r 2               ; --- status / result codes -------------------------------------------------
000263r 2               CMD_RET_SUCCESS   = $51
000263r 2               USB_INT_SUCCESS   = $14
000263r 2               USB_INT_CONNECT   = $15
000263r 2               USB_INT_DISCONNECT= $16
000263r 2               USB_INT_DISK_READ = $1D
000263r 2               USB_INT_DISK_WRITE= $1E
000263r 2               USB_INT_DISK_ERR  = $1F
000263r 2               ERR_MISS_FILE     = $42      ; file not found
000263r 2               ERR_DISK_DISCON   = $82
000263r 2               ERR_DISK_FULL     = $B1
000263r 2               
000263r 2               USB_MODE_HOST     = $06      ; host mode, auto SOF
000263r 2               
000263r 2               
000263r 2               
000263r 2               ; ----------------------------------------------------------------------------
000263r 2               ; Low level
000263r 2               ; ----------------------------------------------------------------------------
000263r 2               ch_wait_busy:                        ; spin until BUSY (bit 4) clears
000263r 2  AD 21 7F             lda CH_CMD
000266r 2  29 10                and #$10
000268r 2  D0 F9                bne ch_wait_busy
00026Ar 2  60                   rts
00026Br 2               
00026Br 2               ch_cmd:                              ; A = command code
00026Br 2  48                   pha
00026Cr 2  20 rr rr             jsr ch_wait_busy
00026Fr 2  68                   pla
000270r 2  8D rr rr             sta ch_lastcmd
000273r 2  8D 21 7F             sta CH_CMD
000276r 2  EA                   nop                          ; chip needs ~1.5us before next access;
000277r 2  EA                   nop                          ; add more NOPs if your CPU is fast
000278r 2  EA                   nop
000279r 2  EA                   nop
00027Ar 2  60                   rts
00027Br 2               
00027Br 2               ch_wr:                               ; A = data byte to send
00027Br 2  48                   pha
00027Cr 2  20 rr rr             jsr ch_wait_busy
00027Fr 2  68                   pla
000280r 2  8D 20 7F             sta CH_DATA
000283r 2  60                   rts
000284r 2               
000284r 2               ch_rd:                               ; returns data byte in A
000284r 2  20 rr rr             jsr ch_wait_busy
000287r 2  AD 20 7F             lda CH_DATA
00028Ar 2  60                   rts
00028Br 2               
00028Br 2               ch_delay:                            ; X = ticks (~1285 cycles each)
00028Br 2  A0 00        @outer: ldy #0
00028Dr 2  88           @inner: dey
00028Er 2  D0 FD                bne @inner
000290r 2  CA                   dex
000291r 2  D0 F8                bne @outer
000293r 2  60                   rts
000294r 2               
000294r 2               CH_INT_WAIT = CPU_MHZ * 6           ; (was 4: 3 s at 1 MHz, but only 1.5 s at 2 MHz)
000294r 2               .assert CH_INT_WAIT < 256, error, "CPU_MHZ too high for the time-out counter"
000294r 2               
000294r 2               ch_wait_int:                         ; wait for INT (status bit 7 = 0)
000294r 2  A9 0C                lda #CH_INT_WAIT             ; ~5 s at any clock (13 cycles a turn,
000296r 2  8D rr rr             sta ch_tmp                   ;  65536 turns per count)
000299r 2  A0 00                ldy #0
00029Br 2  A2 00                ldx #0
00029Dr 2  AD 21 7F     @loop:  lda CH_CMD
0002A0r 2  10 0D                bpl @got
0002A2r 2  E8                   inx
0002A3r 2  D0 F8                bne @loop
0002A5r 2  C8                   iny
0002A6r 2  D0 F5                bne @loop
0002A8r 2  CE rr rr             dec ch_tmp
0002ABr 2  D0 F0                bne @loop
0002ADr 2  38                   sec                          ; timeout
0002AEr 2  60                   rts
0002AFr 2  18           @got:   clc
0002B0r 2  60                   rts
0002B1r 2               
0002B1r 2               ch_get_status:                       ; returns result code in A, releases INT
0002B1r 2  A9 22                lda #CMD_GET_STATUS
0002B3r 2  20 rr rr             jsr ch_cmd
0002B6r 2  4C rr rr             jmp ch_rd
0002B9r 2               
0002B9r 2               ch_wait_status:                      ; wait for INT then read status
0002B9r 2  20 rr rr             jsr ch_wait_int              ; carry set = timeout (A = $FF)
0002BCr 2  B0 03                bcs @timeout
0002BEr 2  4C rr rr             jmp ch_get_status
0002C1r 2               @timeout:
0002C1r 2  AD 21 7F             lda CH_CMD
0002C4r 2  8D rr rr             sta ch_laststs
0002C7r 2  A9 FF                lda #$FF
0002C9r 2  38                   sec
0002CAr 2  60                   rts
0002CBr 2               
0002CBr 2               ; ----------------------------------------------------------------------------
0002CBr 2               ; ch_init - reset chip, check it exists, switch to USB host mode
0002CBr 2               ;   out: carry clear = ok, set = failed
0002CBr 2               ; ----------------------------------------------------------------------------
0002CBr 2               ch_init:
0002CBr 2  A9 05                lda #CMD_RESET_ALL
0002CDr 2  8D 21 7F             sta CH_CMD                   ; raw write: no busy check during reset
0002D0r 2  A2 3F                ldx #DELAY_40MS
0002D2r 2  20 rr rr             jsr ch_delay
0002D5r 2               
0002D5r 2  A9 06                lda #CMD_CHECK_EXIST
0002D7r 2  20 rr rr             jsr ch_cmd
0002DAr 2  A9 57                lda #$57
0002DCr 2  20 rr rr             jsr ch_wr
0002DFr 2  20 rr rr             jsr ch_rd
0002E2r 2  C9 A8                cmp #$A8                     ; chip returns bitwise NOT of $57
0002E4r 2  D0 18                bne @fail
0002E6r 2               
0002E6r 2  A9 15                lda #CMD_SET_USB_MODE
0002E8r 2  20 rr rr             jsr ch_cmd
0002EBr 2  A9 06                lda #USB_MODE_HOST
0002EDr 2  20 rr rr             jsr ch_wr
0002F0r 2  A2 01                ldx #1                       ; >= 20us
0002F2r 2  20 rr rr             jsr ch_delay
0002F5r 2  20 rr rr             jsr ch_rd
0002F8r 2  C9 51                cmp #CMD_RET_SUCCESS
0002FAr 2  D0 02                bne @fail
0002FCr 2  18                   clc
0002FDr 2  60                   rts
0002FEr 2  38           @fail:  sec
0002FFr 2  60                   rts
000300r 2               
000300r 2               ; ----------------------------------------------------------------------------
000300r 2               ; ch_mount - wait for USB drive, connect + mount the filesystem
000300r 2               ;   out: carry clear = ok, set = no drive / unreadable filesystem
000300r 2               ; ----------------------------------------------------------------------------
000300r 2               ch_mount:
000300r 2  20 rr rr             jsr ch_wait_status           ; expect "device connected"
000303r 2  C9 15                cmp #USB_INT_CONNECT
000305r 2  D0 27                bne @fail
000307r 2               
000307r 2  A9 30                lda #CMD_DISK_CONNECT
000309r 2  20 rr rr             jsr ch_cmd
00030Cr 2  20 rr rr             jsr ch_wait_status
00030Fr 2  C9 14                cmp #USB_INT_SUCCESS
000311r 2  D0 1B                bne @fail
000313r 2               
000313r 2  A9 05                lda #5
000315r 2  8D rr rr             sta ch_retry
000318r 2  A9 31        @try:   lda #CMD_DISK_MOUNT          ; some drives need a few tries
00031Ar 2  20 rr rr             jsr ch_cmd
00031Dr 2  20 rr rr             jsr ch_wait_status
000320r 2  C9 14                cmp #USB_INT_SUCCESS
000322r 2  F0 0C                beq @ok
000324r 2  A2 3F                ldx #DELAY_40MS
000326r 2  20 rr rr             jsr ch_delay
000329r 2  CE rr rr             dec ch_retry
00032Cr 2  D0 EA                bne @try
00032Er 2  38           @fail:  sec
00032Fr 2  60                   rts
000330r 2  A9 05        @ok:    lda #5                       ; mounted: give the drive ~200 ms to settle
000332r 2  8D rr rr             sta ch_retry                 ;  before the first file command (a listing
000335r 2  A2 3F        @set:   ldx #DELAY_40MS              ;  straight after mounting timed out on
000337r 2  20 rr rr             jsr ch_delay                 ;  some drives)
00033Ar 2  CE rr rr             dec ch_retry
00033Dr 2  D0 F6                bne @set
00033Fr 2  18                   clc
000340r 2  60                   rts
000341r 2               
000341r 2               ; ----------------------------------------------------------------------------
000341r 2               ; File name / open / create / close
000341r 2               ; ----------------------------------------------------------------------------
000341r 2               ch_set_name:                         ; A = name lo, X = name hi
000341r 2  8D rr rr             sta ch_ptr
000344r 2  8E rr rr             stx ch_ptr+1
000347r 2  A5 rr 48 A5          ZP_ENTER
00034Br 2  rr 48 AD rr  
00034Fr 2  rr 85 rr AD  
000357r 2  A9 2F                lda #CMD_SET_FILE_NAME
000359r 2  20 rr rr             jsr ch_cmd
00035Cr 2  A0 00                ldy #0
00035Er 2  B1 rr        @l:     lda (zp_ptr),y
000360r 2  20 rr rr             jsr ch_wr
000363r 2  B1 rr                lda (zp_ptr),y
000365r 2  F0 03                beq @done                    ; terminator was sent too
000367r 2  C8                   iny
000368r 2  D0 F4                bne @l
00036Ar 2  A5 rr 8D rr  @done:  ZP_LEAVE
00036Er 2  rr A5 rr 8D  
000372r 2  rr rr 68 85  
00037Ar 2  60                   rts
00037Br 2               
00037Br 2               ch_file_open:                        ; A/X = name. returns status in A
00037Br 2  20 rr rr             jsr ch_set_name
00037Er 2  A9 32                lda #CMD_FILE_OPEN
000380r 2  20 rr rr             jsr ch_cmd
000383r 2  4C rr rr             jmp ch_wait_status
000386r 2               
000386r 2               ch_file_create:                      ; A/X = name. creates/truncates file
000386r 2  20 rr rr             jsr ch_set_name
000389r 2  A9 34                lda #CMD_FILE_CREATE
00038Br 2  20 rr rr             jsr ch_cmd
00038Er 2  4C rr rr             jmp ch_wait_status
000391r 2               
000391r 2               ch_file_erase:                       ; A/X = name. deletes file
000391r 2  20 rr rr             jsr ch_set_name
000394r 2  A9 35                lda #CMD_FILE_ERASE
000396r 2  20 rr rr             jsr ch_cmd
000399r 2  4C rr rr             jmp ch_wait_status
00039Cr 2               
00039Cr 2               ch_file_close:                       ; A = 1 update file length (after writing)
00039Cr 2  48                   pha                          ;     0 = no update (after reading)
00039Dr 2  A9 36                lda #CMD_FILE_CLOSE
00039Fr 2  20 rr rr             jsr ch_cmd
0003A2r 2  68                   pla
0003A3r 2  20 rr rr             jsr ch_wr
0003A6r 2  4C rr rr             jmp ch_wait_status
0003A9r 2               
0003A9r 2               ; ch_seek - move file pointer to 32-bit offset in ch_off (little endian)
0003A9r 2               ;   Set ch_off = $FFFFFFFF to seek to end (for appending).
0003A9r 2               ch_seek:
0003A9r 2  A9 39                lda #CMD_BYTE_LOCATE
0003ABr 2  20 rr rr             jsr ch_cmd
0003AEr 2  A2 00                ldx #0
0003B0r 2  BD rr rr     @l:     lda ch_off,x
0003B3r 2  20 rr rr             jsr ch_wr
0003B6r 2  E8                   inx
0003B7r 2  E0 04                cpx #4
0003B9r 2  D0 F5                bne @l
0003BBr 2  4C rr rr             jmp ch_wait_status
0003BEr 2               
0003BEr 2               ; ----------------------------------------------------------------------------
0003BEr 2               ; ch_read - read ch_len bytes from the open file into (ch_ptr)
0003BEr 2               ;   in : ch_ptr = destination, ch_len = max bytes
0003BEr 2               ;   out: A = $14 on success, ch_got = bytes actually read (less at EOF),
0003BEr 2               ;        ch_ptr advanced past the data
0003BEr 2               ; ----------------------------------------------------------------------------
0003BEr 2               ch_read:
0003BEr 2  A5 rr 48 A5          ZP_ENTER
0003C2r 2  rr 48 AD rr  
0003C6r 2  rr 85 rr AD  
0003CEr 2  A9 00                lda #0
0003D0r 2  8D rr rr             sta ch_got
0003D3r 2  8D rr rr             sta ch_got+1
0003D6r 2  A9 3A                lda #CMD_BYTE_READ
0003D8r 2  20 rr rr             jsr ch_cmd
0003DBr 2  AD rr rr             lda ch_len
0003DEr 2  20 rr rr             jsr ch_wr
0003E1r 2  AD rr rr             lda ch_len+1
0003E4r 2  20 rr rr             jsr ch_wr
0003E7r 2  20 rr rr     @next:  jsr ch_wait_status
0003EAr 2  C9 1D                cmp #USB_INT_DISK_READ       ; $1D = a chunk (<=64 bytes) is ready
0003ECr 2  D0 3D                bne @done                    ; $14 = finished, else error
0003EEr 2  A9 27                lda #CMD_RD_USB_DATA0
0003F0r 2  20 rr rr             jsr ch_cmd
0003F3r 2  20 rr rr             jsr ch_rd                    ; first byte = chunk length
0003F6r 2  8D rr rr             sta ch_cnt
0003F9r 2  F0 28                beq @go
0003FBr 2  A0 00                ldy #0
0003FDr 2  20 rr rr     @copy:  jsr ch_rd
000400r 2  91 rr                sta (zp_ptr),y
000402r 2  C8                   iny
000403r 2  CC rr rr             cpy ch_cnt
000406r 2  D0 F5                bne @copy
000408r 2  18                   clc                          ; zp_ptr += ch_cnt
000409r 2  A5 rr                lda zp_ptr
00040Br 2  6D rr rr             adc ch_cnt
00040Er 2  85 rr                sta zp_ptr
000410r 2  90 02                bcc :+
000412r 2  E6 rr                inc zp_ptr+1
000414r 2  18           :       clc                          ; ch_got += ch_cnt
000415r 2  AD rr rr             lda ch_got
000418r 2  6D rr rr             adc ch_cnt
00041Br 2  8D rr rr             sta ch_got
00041Er 2  90 03                bcc @go
000420r 2  EE rr rr             inc ch_got+1
000423r 2  A9 3B        @go:    lda #CMD_BYTE_RD_GO          ; ask for next chunk
000425r 2  20 rr rr             jsr ch_cmd
000428r 2  4C rr rr             jmp @next
00042Br 2  AA           @done:  tax                          ; keep status while restoring zp
00042Cr 2  A5 rr 8D rr          ZP_LEAVE
000430r 2  rr A5 rr 8D  
000434r 2  rr rr 68 85  
00043Cr 2  8A                   txa
00043Dr 2  60                   rts
00043Er 2               
00043Er 2               ; ----------------------------------------------------------------------------
00043Er 2               ; ch_write - write ch_len bytes from (ch_ptr) to the open file
00043Er 2               ;   in : ch_ptr = source, ch_len = byte count
00043Er 2               ;   out: A = $14 on success, ch_ptr advanced
00043Er 2               ;   Call ch_file_close with A=1 afterwards so the file length is saved.
00043Er 2               ; ----------------------------------------------------------------------------
00043Er 2               ch_write:
00043Er 2  A5 rr 48 A5          ZP_ENTER
000442r 2  rr 48 AD rr  
000446r 2  rr 85 rr AD  
00044Er 2  A9 3C                lda #CMD_BYTE_WRITE
000450r 2  20 rr rr             jsr ch_cmd
000453r 2  AD rr rr             lda ch_len
000456r 2  20 rr rr             jsr ch_wr
000459r 2  AD rr rr             lda ch_len+1
00045Cr 2  20 rr rr             jsr ch_wr
00045Fr 2  20 rr rr     @next:  jsr ch_wait_status
000462r 2  C9 1E                cmp #USB_INT_DISK_WRITE      ; $1E = chip wants more data
000464r 2  D0 2E                bne @done                    ; $14 = finished, else error
000466r 2  A9 2D                lda #CMD_WR_REQ_DATA
000468r 2  20 rr rr             jsr ch_cmd
00046Br 2  20 rr rr             jsr ch_rd                    ; how many bytes it wants (<=64)
00046Er 2  8D rr rr             sta ch_cnt
000471r 2  F0 19                beq @go
000473r 2  A0 00                ldy #0
000475r 2  B1 rr        @copy:  lda (zp_ptr),y
000477r 2  20 rr rr             jsr ch_wr
00047Ar 2  C8                   iny
00047Br 2  CC rr rr             cpy ch_cnt
00047Er 2  D0 F5                bne @copy
000480r 2  18                   clc
000481r 2  A5 rr                lda zp_ptr
000483r 2  6D rr rr             adc ch_cnt
000486r 2  85 rr                sta zp_ptr
000488r 2  90 02                bcc @go
00048Ar 2  E6 rr                inc zp_ptr+1
00048Cr 2  A9 3D        @go:    lda #CMD_BYTE_WR_GO
00048Er 2  20 rr rr             jsr ch_cmd
000491r 2  4C rr rr             jmp @next
000494r 2  AA           @done:  tax
000495r 2  A5 rr 8D rr          ZP_LEAVE
000499r 2  rr A5 rr 8D  
00049Dr 2  rr rr 68 85  
0004A5r 2  8A                   txa
0004A6r 2  60                   rts
0004A7r 2               
0004A7r 2               
0004A7r 1               .include "ch376_loadsave.s"     ; LOAD / SAVE / LOAD "$"    (BIOS)
0004A7r 2               ; ============================================================================
0004A7r 2               ; ch376_loadsave.s - EhBASIC "LOAD" and "SAVE" using the CH376 driver in
0004A7r 2               ; ch376_abs.s (ch_init, ch_mount, ch_file_open, ch_file_create, ch_file_close,
0004A7r 2               ; ch_read, ch_write ...).
0004A7r 2               ;
0004A7r 2               ;   LOAD "NAME"      -> reads /NAME.BAS into the BASIC program area
0004A7r 2               ;   SAVE "NAME"      -> writes the current program to /NAME.BAS
0004A7r 2               ;   LOAD "$"         -> lists the files in the root directory (the program in
0004A7r 2               ;                       memory is NOT touched)
0004A7r 2               ;   LOAD "$T*"       -> lists only matching files (the CH376's own wildcard
0004A7r 2               ;                       matching, e.g. "$*.BAS" or "$GAME*")
0004A7r 2               ;
0004A7r 2               ;   - The name is any string expression, converted to UPPERCASE.
0004A7r 2               ;   - ".BAS" is appended if the name contains no ".".
0004A7r 2               ;   - A leading "/" is added for you (root directory). "DIR/NAME" works too.
0004A7r 2               ;   - File format = BASIC's in-memory tokenised program (Smeml..Svarl-1).
0004A7r 2               ;     Line links are rebuilt after loading, so files don't depend on where
0004A7r 2               ;     the program was saved from.
0004A7r 2               ;
0004A7r 2               ; HOW EhBASIC CALLS US
0004A7r 2               ;   basic.s dispatches the LOAD/SAVE tokens through V_LOAD/V_SAVE, which do
0004A7r 2               ;   JMP (VEC_LD) / JMP (VEC_SV).  bios.s copies the addresses of CH_LOAD and
0004A7r 2               ;   CH_SAVE into those RAM vectors at reset.  On entry the BASIC execute pointer
0004A7r 2               ;   (Bpntrl/h) is just past the keyword, so we evaluate the argument with
0004A7r 2               ;   LAB_EVEX/LAB_EVST.  SAVE finishes with RTS (back to the interpreter);
0004A7r 2               ;   LOAD re-links the program and exits through LAB_1319 to the prompt.
0004A7r 2               ;
0004A7r 2               ; Variables (ch_name, ch_ready, ...) are declared in ch376_abs.s (CHVARS).
0004A7r 2               ; ============================================================================
0004A7r 2               
0004A7r 2               .segment "BIOS"
0004A7r 2               
0004A7r 2               CH_NAME_MAX = 26                    ; longest name typed by the user
0004A7r 2               
0004A7r 2               ; EhBASIC error codes (offsets into LAB_BAER) used for argument errors
0004A7r 2               EH_ERR_FC    = $08                  ; ?Function call error
0004A7r 2               EH_ERR_TM    = $18                  ; ?Type mismatch   (raised by LAB_EVST)
0004A7r 2               EH_ERR_LS    = $1A                  ; ?String too long
0004A7r 2               
0004A7r 2               CMD_FILE_ENUM_GO = $33              ; next directory entry
0004A7r 2               
0004A7r 2               ; --- private failure codes (CH376 codes are all < $F0)
0004A7r 2               CH_E_TOOBIG  = $F0
0004A7r 2               CH_E_BADFILE = $F1
0004A7r 2               CH_E_NODISK  = $F2
0004A7r 2               
0004A7r 2               ; continue if A = USB_INT_SUCCESS, otherwise jump to "target" with A intact
0004A7r 2               .macro CH_OK target
0004A7r 2                       .local ok
0004A7r 2                       cmp #USB_INT_SUCCESS
0004A7r 2                       beq ok
0004A7r 2                       jmp target
0004A7r 2               ok:
0004A7r 2               .endmacro
0004A7r 2               
0004A7r 2               ; ----------------------------------------------------------------------------
0004A7r 2               ; CH_BOOT - call once at power-up/reset
0004A7r 2               ; ----------------------------------------------------------------------------
0004A7r 2               CH_BOOT:
0004A7r 2  A9 00                lda #0
0004A9r 2  8D rr rr             sta ch_ready
0004ACr 2  8D rr rr             sta ch_mon
0004AFr 2  60                   rts
0004B0r 2               
0004B0r 2               ; ----------------------------------------------------------------------------
0004B0r 2               ; CH_LOAD  - BASIC LOAD "name"
0004B0r 2               ; ----------------------------------------------------------------------------
0004B0r 2               CH_LOAD:
0004B0r 2  A9 00                lda #0
0004B2r 2  8D rr rr             sta ch_raw
0004B5r 2  20 rr rr             jsr ch_get_filename
0004B8r 2  AD rr rr             lda ch_dir                  ; LOAD "$..." -> directory listing
0004BBr 2  F0 03                beq @file
0004BDr 2  4C rr rr             jmp ch_dirlist
0004C0r 2  20 rr rr     @file:  jsr ch_prepare
0004C3r 2  90 05                bcc @ready
0004C5r 2  A9 F2                lda #CH_E_NODISK
0004C7r 2  4C rr rr             jmp ch_fail
0004CAr 2  A9 rr        @ready: lda #<ch_name
0004CCr 2  A2 rr                ldx #>ch_name
0004CEr 2  20 rr rr             jsr ch_file_open            ; $42 = file not found
0004D1r 2  C9 14 F0 03          CH_OK ch_fail
0004D5r 2  4C rr rr     
0004D8r 2               
0004D8r 2  38                   sec                         ; ch_len = Ememl - Smeml (room available)
0004D9r 2  A5 85                lda Ememl
0004DBr 2  E5 79                sbc Smeml
0004DDr 2  8D rr rr             sta ch_len
0004E0r 2  A5 86                lda Ememh
0004E2r 2  E5 7A                sbc Smemh
0004E4r 2  8D rr rr             sta ch_len+1
0004E7r 2  A5 79                lda Smeml                   ; destination = start of program
0004E9r 2  8D rr rr             sta ch_ptr
0004ECr 2  A5 7A                lda Smemh
0004EEr 2  8D rr rr             sta ch_ptr+1
0004F1r 2  20 rr rr             jsr ch_read
0004F4r 2  C9 14 F0 03          CH_OK ch_fail_close
0004F8r 2  4C rr rr     
0004FBr 2               
0004FBr 2  AD rr rr             lda ch_got+1                ; got >= room?  -> file did not fit
0004FEr 2  CD rr rr             cmp ch_len+1
000501r 2  90 0F                bcc @fits
000503r 2  D0 08                bne @toobig
000505r 2  AD rr rr             lda ch_got
000508r 2  CD rr rr             cmp ch_len
00050Br 2  90 05                bcc @fits
00050Dr 2               @toobig:
00050Dr 2  A9 F0                lda #CH_E_TOOBIG
00050Fr 2  4C rr rr             jmp ch_fail_close
000512r 2  AD rr rr     @fits:  lda ch_got+1                ; a program is at least 2 bytes ($00 $00)
000515r 2  D0 0C                bne @sizeok
000517r 2  AD rr rr             lda ch_got
00051Ar 2  C9 02                cmp #2
00051Cr 2  B0 05                bcs @sizeok
00051Er 2  A9 F1                lda #CH_E_BADFILE
000520r 2  4C rr rr             jmp ch_fail_close
000523r 2               @sizeok:
000523r 2  A9 00                lda #0
000525r 2  20 rr rr             jsr ch_file_close
000528r 2  AD rr rr             lda ch_ptr                  ; ch_read advanced ch_ptr to end of data
00052Br 2  85 7B                sta Svarl                   ; = new end of program / start of variables
00052Dr 2  AD rr rr             lda ch_ptr+1
000530r 2  85 7C                sta Svarh
000532r 2  A9 00                lda #0                      ; same as the warm start entry: clear any
000534r 2  85 DF                sta IrqBase                 ; ON IRQ / ON NMI set-up
000536r 2  85 DC                sta NmiBase
000538r 2  A9 rr                lda #<LAB_RMSG              ; print CR,LF,"Ready",CR,LF
00053Ar 2  A0 rr                ldy #>LAB_RMSG
00053Cr 2  20 rr rr             jsr ch_puts
00053Fr 2  4C rr rr             jmp LAB_1319                ; flush stack, CLEAR, rebuild line links, then
000542r 2                                                   ; wait for a command (we are not returning)
000542r 2               
000542r 2               ; ----------------------------------------------------------------------------
000542r 2               ; CH_SAVE  - BASIC SAVE "name"
000542r 2               ; ----------------------------------------------------------------------------
000542r 2               CH_SAVE:
000542r 2  A9 00                lda #0
000544r 2  8D rr rr             sta ch_raw
000547r 2  20 rr rr             jsr ch_get_filename
00054Ar 2  AD rr rr             lda ch_dir                  ; SAVE "$..." makes no sense
00054Dr 2  F0 05                beq @ok1
00054Fr 2  A2 08                ldx #EH_ERR_FC
000551r 2  4C rr rr             jmp LAB_XERR
000554r 2  20 rr rr     @ok1:   jsr ch_prepare
000557r 2  90 05                bcc @ready
000559r 2  A9 F2                lda #CH_E_NODISK
00055Br 2  4C rr rr             jmp ch_fail
00055Er 2  A9 rr        @ready: lda #<ch_name
000560r 2  A2 rr                ldx #>ch_name
000562r 2  20 rr rr             jsr ch_file_create          ; creates / replaces the file
000565r 2  C9 14 F0 03          CH_OK ch_fail
000569r 2  4C rr rr     
00056Cr 2               
00056Cr 2  38                   sec                         ; ch_len = Svarl - Smeml
00056Dr 2  A5 7B                lda Svarl
00056Fr 2  E5 79                sbc Smeml
000571r 2  8D rr rr             sta ch_len
000574r 2  A5 7C                lda Svarh
000576r 2  E5 7A                sbc Smemh
000578r 2  8D rr rr             sta ch_len+1
00057Br 2  A5 79                lda Smeml                   ; source = start of program
00057Dr 2  8D rr rr             sta ch_ptr
000580r 2  A5 7A                lda Smemh
000582r 2  8D rr rr             sta ch_ptr+1
000585r 2  20 rr rr             jsr ch_write
000588r 2  C9 14 F0 03          CH_OK ch_fail_close
00058Cr 2  4C rr rr     
00058Fr 2               
00058Fr 2  A9 01                lda #1                      ; close AND update the file length
000591r 2  20 rr rr             jsr ch_file_close
000594r 2  C9 14 F0 03          CH_OK ch_fail
000598r 2  4C rr rr     
00059Br 2  60                   rts                         ; back to BASIC
00059Cr 2               
00059Cr 2               ; ----------------------------------------------------------------------------
00059Cr 2               ; ch_get_filename - evaluate the string argument, build "/NAME.BAS",0 in
00059Cr 2               ;                   ch_name. Raises normal BASIC errors for bad arguments.
00059Cr 2               ; ----------------------------------------------------------------------------
00059Cr 2               ch_get_filename:
00059Cr 2  20 rr rr             jsr LAB_EVEX                ; evaluate the expression at the BASIC pointer
00059Fr 2  20 rr rr             jsr LAB_EVST                ; must be a string (else ?Type mismatch);
0005A2r 2                                                   ; A = length, (ut1_pl) -> characters
0005A2r 2  8D rr rr             sta ch_cnt
0005A5r 2  F0 09                beq @bad
0005A7r 2  C9 1B                cmp #CH_NAME_MAX+1
0005A9r 2  90 0A                bcc @ok
0005ABr 2  A2 1A                ldx #EH_ERR_LS              ; ?String too long
0005ADr 2  4C rr rr             jmp LAB_XERR
0005B0r 2  A2 08        @bad:   ldx #EH_ERR_FC              ; empty name -> ?Function call error
0005B2r 2  4C rr rr             jmp LAB_XERR
0005B5r 2  A9 00        @ok:    lda #0
0005B7r 2  8D rr rr             sta ch_dot
0005BAr 2  8D rr rr             sta ch_dir
0005BDr 2  A9 2F                lda #'/'
0005BFr 2  8D rr rr             sta ch_name
0005C2r 2  A2 01                ldx #1                      ; X = index into ch_name
0005C4r 2  A0 00                ldy #0                      ; Y = index into the BASIC string
0005C6r 2  B1 71                lda (ut1_pl),y
0005C8r 2  C9 24                cmp #'$'
0005CAr 2  D0 16                bne @copy
0005CCr 2  A9 01                lda #1                      ; "$..." = directory request
0005CEr 2  8D rr rr             sta ch_dir
0005D1r 2  8D rr rr             sta ch_dot                  ; (so no ".BAS" is appended)
0005D4r 2  C8                   iny                         ; skip the "$"
0005D5r 2  CC rr rr             cpy ch_cnt
0005D8r 2  D0 08                bne @copy                   ; "$pattern": copy the pattern
0005DAr 2  A9 2A                lda #'*'                    ; plain "$": match everything
0005DCr 2  9D rr rr             sta ch_name,x
0005DFr 2  E8                   inx
0005E0r 2  D0 41                bne @term                   ; always taken
0005E2r 2  B1 71        @copy:  lda (ut1_pl),y
0005E4r 2  C9 2E                cmp #'.'
0005E6r 2  D0 09                bne @upper
0005E8r 2  A9 01                lda #1
0005EAr 2  8D rr rr             sta ch_dot
0005EDr 2  A9 2E                lda #'.'
0005EFr 2  D0 0A                bne @store                  ; always taken
0005F1r 2  C9 61        @upper: cmp #'a'
0005F3r 2  90 06                bcc @store
0005F5r 2  C9 7B                cmp #'z'+1
0005F7r 2  B0 02                bcs @store
0005F9r 2  29 DF                and #$DF                    ; to uppercase
0005FBr 2  9D rr rr     @store: sta ch_name,x
0005FEr 2  E8                   inx
0005FFr 2  C8                   iny
000600r 2  CC rr rr             cpy ch_cnt
000603r 2  D0 DD                bne @copy
000605r 2  AD rr rr             lda ch_dot
000608r 2  D0 19                bne @term
00060Ar 2  AD rr rr             lda ch_raw                  ; no "." typed: append ".BAS" (LOAD/SAVE),
00060Dr 2  0A                   asl                         ; ".DAT" (LOADRAW/SAVERAW) or ".ARR"
00060Er 2  0A                   asl                         ; (LOADARR/SAVEARR), 4 characters each
00060Fr 2  A8                   tay
000610r 2  18                   clc
000611r 2  69 04                adc #4
000613r 2  8D rr rr             sta ch_dot                  ; (flag no longer needed) = end index
000616r 2  B9 rr rr     @ext:   lda ch_ext,y
000619r 2  9D rr rr             sta ch_name,x
00061Cr 2  E8                   inx
00061Dr 2  C8                   iny
00061Er 2  CC rr rr             cpy ch_dot
000621r 2  D0 F3                bne @ext
000623r 2  A9 00        @term:  lda #0
000625r 2  9D rr rr             sta ch_name,x
000628r 2  60                   rts
000629r 2               
000629r 2  2E 42 41 53  ch_ext: .byte ".BAS"
00062Dr 2  2E 44 41 54          .byte ".DAT"
000631r 2  2E 41 52 52          .byte ".ARR"
000635r 2               
000635r 2               ; ----------------------------------------------------------------------------
000635r 2               ; ch_prepare - make sure the CH376 is initialised and the disk is mounted
000635r 2               ;   out: carry clear = ready, set = no disk
000635r 2               ; ----------------------------------------------------------------------------
000635r 2               ch_prepare:
000635r 2  AD rr rr             lda ch_ready
000638r 2  D0 0F                bne @ok
00063Ar 2  20 rr rr             jsr ch_init
00063Dr 2  B0 0C                bcs @fail
00063Fr 2  20 rr rr             jsr ch_mount
000642r 2  B0 07                bcs @fail
000644r 2  A9 01                lda #1
000646r 2  8D rr rr             sta ch_ready
000649r 2  18           @ok:    clc
00064Ar 2  60                   rts
00064Br 2  38           @fail:  sec
00064Cr 2  60                   rts
00064Dr 2               
00064Dr 2               ; ----------------------------------------------------------------------------
00064Dr 2               ; ch_dirlist - LOAD "$" : list the directory named by ch_name ("/*" etc.)
00064Dr 2               ;
00064Dr 2               ; CH376 enumeration: SET_FILE_NAME "/*", FILE_OPEN. For every match the chip
00064Dr 2               ; interrupts with USB_INT_DISK_READ and the 32-byte FAT directory entry can
00064Dr 2               ; be read with RD_USB_DATA0.  FILE_ENUM_GO fetches the next one; ERR_MISS_FILE
00064Dr 2               ; ($42) means there are no more.
00064Dr 2               ;
00064Dr 2               ; Entry layout: 0-7 name, 8-10 extension (space padded), 11 attributes,
00064Dr 2               ;               28-31 file size (little endian)
00064Dr 2               ; ----------------------------------------------------------------------------
00064Dr 2               ch_dirlist:
00064Dr 2  20 rr rr             jsr ch_prepare
000650r 2  90 05                bcc @ready
000652r 2  A9 F2                lda #CH_E_NODISK
000654r 2  4C rr rr             jmp ch_fail
000657r 2  A9 00        @ready: lda #0
000659r 2  8D rr rr             sta ch_nfiles
00065Cr 2  8D rr rr             sta ch_nfiles+1
00065Fr 2  A9 rr                lda #<ch_name
000661r 2  A2 rr                ldx #>ch_name
000663r 2  20 rr rr             jsr ch_set_name
000666r 2  A9 32                lda #CMD_FILE_OPEN
000668r 2  20 rr rr             jsr ch_cmd
00066Br 2  20 rr rr     @next:  jsr ch_wait_status
00066Er 2  C9 1D                cmp #USB_INT_DISK_READ      ; $1D = an entry is available
000670r 2  D0 31                bne @end
000672r 2  A9 27                lda #CMD_RD_USB_DATA0
000674r 2  20 rr rr             jsr ch_cmd
000677r 2  20 rr rr             jsr ch_rd                   ; length (normally 32)
00067Ar 2  8D rr rr             sta ch_cnt
00067Dr 2  A0 00                ldy #0
00067Fr 2  CC rr rr     @rd:    cpy ch_cnt
000682r 2  B0 0D                bcs @got
000684r 2  20 rr rr             jsr ch_rd
000687r 2  C0 20                cpy #32
000689r 2  B0 03                bcs @skip                   ; never overflow ch_ent
00068Br 2  99 rr rr             sta ch_ent,y
00068Er 2  C8           @skip:  iny
00068Fr 2  D0 EE                bne @rd
000691r 2  AD rr rr     @got:   lda ch_cnt
000694r 2  C9 20                cmp #32
000696r 2  90 03                bcc @more                   ; short entry: ignore it
000698r 2  20 rr rr             jsr ch_print_entry
00069Br 2  A9 33        @more:  lda #CMD_FILE_ENUM_GO
00069Dr 2  20 rr rr             jsr ch_cmd
0006A0r 2  4C rr rr             jmp @next
0006A3r 2  C9 42        @end:   cmp #ERR_MISS_FILE          ; $42 = end of directory
0006A5r 2  F0 03                beq @done
0006A7r 2  4C rr rr             jmp ch_fail                 ; anything else is a real error
0006AAr 2  AD rr rr     @done:  lda ch_nfiles
0006ADr 2  0D rr rr             ora ch_nfiles+1
0006B0r 2  D0 07                bne @ret
0006B2r 2  A9 rr                lda #<msg_nofiles
0006B4r 2  A0 rr                ldy #>msg_nofiles
0006B6r 2  20 rr rr             jsr ch_puts                ; print null terminated string (A=lo, Y=hi)
0006B9r 2  60           @ret:   rts                         ; back to BASIC ("OK")
0006BAr 2               
0006BAr 2               ; ch_print_entry - print one line for the entry in ch_ent, or nothing if it is
0006BAr 2               ; a volume label / hidden / system entry
0006BAr 2               ch_print_entry:
0006BAr 2  AD rr rr             lda ch_ent+11
0006BDr 2  29 0E                and #$0E                    ; volume label, hidden, system
0006BFr 2  F0 01                beq @show
0006C1r 2  60                   rts
0006C2r 2  EE rr rr     @show:  inc ch_nfiles
0006C5r 2  D0 03                bne @c1
0006C7r 2  EE rr rr             inc ch_nfiles+1
0006CAr 2  A0 00        @c1:    ldy #0
0006CCr 2  B9 rr rr     @name:  lda ch_ent,y
0006CFr 2  C9 20                cmp #' '
0006D1r 2  F0 08                beq @namedone
0006D3r 2  20 rr rr             jsr ch_putc
0006D6r 2  C8                   iny
0006D7r 2  C0 08                cpy #8
0006D9r 2  90 F1                bcc @name
0006DBr 2               @namedone:
0006DBr 2  8C rr rr             sty ch_col                  ; characters printed so far
0006DEr 2  AD rr rr             lda ch_ent+8
0006E1r 2  C9 20                cmp #' '
0006E3r 2  F0 1C                beq @pad                    ; no extension
0006E5r 2  A9 2E                lda #'.'
0006E7r 2  20 rr rr             jsr ch_putc
0006EAr 2  EE rr rr             inc ch_col
0006EDr 2  A0 08                ldy #8
0006EFr 2  B9 rr rr     @ext:   lda ch_ent,y
0006F2r 2  C9 20                cmp #' '
0006F4r 2  F0 0B                beq @pad
0006F6r 2  20 rr rr             jsr ch_putc
0006F9r 2  EE rr rr             inc ch_col
0006FCr 2  C8                   iny
0006FDr 2  C0 0B                cpy #11
0006FFr 2  90 EE                bcc @ext
000701r 2  A9 20        @pad:   lda #' '                    ; pad the name field to 13 columns
000703r 2  20 rr rr             jsr ch_putc
000706r 2  EE rr rr             inc ch_col
000709r 2  AD rr rr             lda ch_col
00070Cr 2  C9 0D                cmp #13
00070Er 2  90 F1                bcc @pad
000710r 2  AD rr rr             lda ch_ent+11
000713r 2  29 10                and #$10                    ; directory?
000715r 2  F0 0A                beq @size
000717r 2  A9 rr                lda #<msg_dir
000719r 2  A0 rr                ldy #>msg_dir
00071Br 2  20 rr rr             jsr ch_puts
00071Er 2  4C rr rr             jmp @eol
000721r 2  A2 03        @size:  ldx #3                      ; size -> ch_num
000723r 2  BD rr rr     @cp:    lda ch_ent+28,x
000726r 2  9D rr rr             sta ch_num,x
000729r 2  CA                   dex
00072Ar 2  10 F7                bpl @cp
00072Cr 2  20 rr rr             jsr ch_print_num
00072Fr 2  4C rr rr     @eol:   jmp ch_crlf                 ; end of line (tail call)
000732r 2               
000732r 2               ; ch_print_num - print the 32-bit number in ch_num right-aligned in 10 columns
000732r 2               ch_print_num:
000732r 2  A9 00                lda #0
000734r 2  8D rr rr             sta ch_started
000737r 2  A0 00                ldy #0                      ; Y = 4 * index into ch_pow10
000739r 2  A2 00        @digit: ldx #0                      ; X = this digit
00073Br 2  38           @sub:   sec
00073Cr 2  AD rr rr             lda ch_num
00073Fr 2  F9 rr rr             sbc ch_pow10,y
000742r 2  8D rr rr             sta ch_num
000745r 2  AD rr rr             lda ch_num+1
000748r 2  F9 rr rr             sbc ch_pow10+1,y
00074Br 2  8D rr rr             sta ch_num+1
00074Er 2  AD rr rr             lda ch_num+2
000751r 2  F9 rr rr             sbc ch_pow10+2,y
000754r 2  8D rr rr             sta ch_num+2
000757r 2  AD rr rr             lda ch_num+3
00075Ar 2  F9 rr rr             sbc ch_pow10+3,y
00075Dr 2  8D rr rr             sta ch_num+3
000760r 2  90 04                bcc @undo                   ; went negative: digit is complete
000762r 2  E8                   inx
000763r 2  4C rr rr             jmp @sub
000766r 2  18           @undo:  clc                         ; add the power back
000767r 2  AD rr rr             lda ch_num
00076Ar 2  79 rr rr             adc ch_pow10,y
00076Dr 2  8D rr rr             sta ch_num
000770r 2  AD rr rr             lda ch_num+1
000773r 2  79 rr rr             adc ch_pow10+1,y
000776r 2  8D rr rr             sta ch_num+1
000779r 2  AD rr rr             lda ch_num+2
00077Cr 2  79 rr rr             adc ch_pow10+2,y
00077Fr 2  8D rr rr             sta ch_num+2
000782r 2  AD rr rr             lda ch_num+3
000785r 2  79 rr rr             adc ch_pow10+3,y
000788r 2  8D rr rr             sta ch_num+3
00078Br 2  AD rr rr             lda ch_started
00078Er 2  D0 0C                bne @pr
000790r 2  8A                   txa
000791r 2  D0 09                bne @pr
000793r 2  C0 24                cpy #36                     ; last digit is always printed
000795r 2  F0 05                beq @pr
000797r 2  A9 20                lda #' '                    ; leading zero -> space
000799r 2  4C rr rr             jmp @out
00079Cr 2  A9 01        @pr:    lda #1
00079Er 2  8D rr rr             sta ch_started
0007A1r 2  8A                   txa
0007A2r 2  18                   clc
0007A3r 2  69 30                adc #'0'
0007A5r 2  20 rr rr     @out:   jsr ch_putc
0007A8r 2  98                   tya
0007A9r 2  18                   clc
0007AAr 2  69 04                adc #4
0007ACr 2  A8                   tay
0007ADr 2  C0 28                cpy #40
0007AFr 2  F0 03                beq @fin
0007B1r 2  4C rr rr             jmp @digit
0007B4r 2  60           @fin:   rts
0007B5r 2               
0007B5r 2               ch_pow10:
0007B5r 2  00 CA 9A 3B          .dword 1000000000, 100000000, 10000000, 1000000, 100000
0007B9r 2  00 E1 F5 05  
0007BDr 2  80 96 98 00  
0007C9r 2  10 27 00 00          .dword 10000, 1000, 100, 10, 1
0007CDr 2  E8 03 00 00  
0007D1r 2  64 00 00 00  
0007DDr 2               
0007DDr 2               ; ch_putc - ch_prna (print char in A) that preserves X and Y
0007DDr 2               ch_putc:
0007DDr 2  8E rr rr             stx ch_sx
0007E0r 2  8C rr rr             sty ch_sy
0007E3r 2  20 rr rr             jsr ch_prna
0007E6r 2  AE rr rr             ldx ch_sx
0007E9r 2  AC rr rr             ldy ch_sy
0007ECr 2  60                   rts
0007EDr 2               
0007EDr 2  20 20 20 20  msg_dir:     .byte "     <DIR>",0
0007F1r 2  20 3C 44 49  
0007F5r 2  52 3E 00     
0007F8r 2  4E 4F 20 46  msg_nofiles: .byte "NO FILES",13,10,0
0007FCr 2  49 4C 45 53  
000800r 2  0D 0A 00     
000803r 2               
000803r 2               ; ----------------------------------------------------------------------------
000803r 2               ; Error exits.  A = CH376 status or one of the CH_E_ codes.
000803r 2               ; Prints a message, resets the stack and returns to the BASIC prompt.
000803r 2               ; ----------------------------------------------------------------------------
000803r 2               ch_fail_close:                      ; same, but close the open file first
000803r 2  48                   pha
000804r 2  A9 00                lda #0
000806r 2  20 rr rr             jsr ch_file_close
000809r 2  68                   pla
00080Ar 2               ch_fail:
00080Ar 2  C9 42                cmp #ERR_MISS_FILE
00080Cr 2  F0 64                beq @nofile
00080Er 2  C9 B1                cmp #ERR_DISK_FULL
000810r 2  F0 67                beq @full
000812r 2  C9 F0                cmp #CH_E_TOOBIG
000814r 2  F0 6A                beq @toobig
000816r 2  C9 F1                cmp #CH_E_BADFILE
000818r 2  F0 6D                beq @badfile
00081Ar 2  C9 F2                cmp #CH_E_NODISK
00081Cr 2  F0 70                beq @nodisk
00081Er 2  8D rr rr             sta ch_stat                 ; anything else: remember the code,
000821r 2  A9 00                lda #0                      ; re-initialise next time
000823r 2  8D rr rr             sta ch_ready
000826r 2  A9 rr                lda #<msg_io
000828r 2  A0 rr                ldy #>msg_io
00082Ar 2  20 rr rr             jsr ch_puts                ; "?DISK ERROR"
00082Dr 2  A9 20                lda #' '                    ; then the CH376 status code in hex, e.g.
00082Fr 2  20 rr rr             jsr ch_prna                ; ?DISK ERROR $FF  ($FF = chip never answered)
000832r 2  A9 24                lda #'$'
000834r 2  20 rr rr             jsr ch_prna
000837r 2  AD rr rr             lda ch_stat
00083Ar 2  4A                   lsr
00083Br 2  4A                   lsr
00083Cr 2  4A                   lsr
00083Dr 2  4A                   lsr
00083Er 2  20 rr rr             jsr ch_hexdig
000841r 2  AD rr rr             lda ch_stat
000844r 2  29 0F                and #$0F
000846r 2  20 rr rr             jsr ch_hexdig
000849r 2  AD rr rr             lda ch_stat
00084Cr 2  C9 FF                cmp #$FF
00084Er 2  D0 1F                bne @nodiag
000850r 2  A9 rr                lda #<msg_diag1
000852r 2  A0 rr                ldy #>msg_diag1
000854r 2  20 rr rr             jsr ch_puts
000857r 2  AD rr rr             lda ch_lastcmd
00085Ar 2  20 rr rr             jsr ch_hex2
00085Dr 2  A9 rr                lda #<msg_diag2
00085Fr 2  A0 rr                ldy #>msg_diag2
000861r 2  20 rr rr             jsr ch_puts
000864r 2  AD rr rr             lda ch_laststs
000867r 2  20 rr rr             jsr ch_hex2
00086Ar 2  A9 29                lda #')'
00086Cr 2  20 rr rr             jsr ch_prna
00086Fr 2               @nodiag:
00086Fr 2  4C rr rr             jmp @after
000872r 2  A9 rr        @nofile:  lda #<msg_nofile
000874r 2  A0 rr                  ldy #>msg_nofile
000876r 2  4C rr rr               jmp @print
000879r 2  A9 rr        @full:    lda #<msg_full
00087Br 2  A0 rr                  ldy #>msg_full
00087Dr 2  4C rr rr               jmp @print
000880r 2  A9 rr        @toobig:  lda #<msg_toobig
000882r 2  A0 rr                  ldy #>msg_toobig
000884r 2  4C rr rr               jmp @print
000887r 2  A9 rr        @badfile: lda #<msg_badfile
000889r 2  A0 rr                  ldy #>msg_badfile
00088Br 2  4C rr rr               jmp @print
00088Er 2  A9 rr        @nodisk:  lda #<msg_nodisk
000890r 2  A0 rr                  ldy #>msg_nodisk
000892r 2  20 rr rr     @print: jsr ch_puts                ; print string at (Y,A)
000895r 2  AD rr rr     @after: lda ch_mon                  ; called from the monitor?
000898r 2  F0 0B                beq @basic
00089Ar 2  20 rr rr             jsr ch_crlf                 ; (still in monitor mode: plain CR/LF)
00089Dr 2  A9 00                lda #0
00089Fr 2  8D rr rr             sta ch_mon
0008A2r 2  4C rr rr             jmp WOZ_ENTRY               ; yes: back to the monitor prompt
0008A5r 2  20 rr rr     @basic: jsr LAB_1491                ; flush stack, clear continue flag
0008A8r 2  4C rr rr             jmp LAB_1274                ; BASIC warm start: "Ready" prompt
0008ABr 2               
0008ABr 2               ; ---- output wrappers: BASIC's print routines when called from BASIC, plain
0008ABr 2               ;      CHROUT when called from the monitor (BASIC may never have been started)
0008ABr 2               ch_puts:                            ; print zero terminated string, A=lo Y=hi
0008ABr 2  AE rr rr             ldx ch_mon
0008AEr 2  D0 03                bne @mon
0008B0r 2  4C rr rr             jmp LAB_18C3
0008B3r 2  85 rr        @mon:   sta strptr
0008B5r 2  84 rr                sty strptr+1
0008B7r 2  A0 00                ldy #0
0008B9r 2  B1 rr        @l:     lda (strptr),y
0008BBr 2  F0 06                beq @d
0008BDr 2  20 rr rr             jsr CHROUT
0008C0r 2  C8                   iny
0008C1r 2  D0 F6                bne @l
0008C3r 2  60           @d:     rts
0008C4r 2               
0008C4r 2               ch_prna:                            ; print character in A
0008C4r 2  48                   pha
0008C5r 2  AD rr rr             lda ch_mon
0008C8r 2  D0 04                bne @mon
0008CAr 2  68                   pla
0008CBr 2  4C rr rr             jmp LAB_PRNA
0008CEr 2  68           @mon:   pla
0008CFr 2  4C rr rr             jmp CHROUT
0008D2r 2               
0008D2r 2               ch_crlf:
0008D2r 2  AD rr rr             lda ch_mon
0008D5r 2  D0 03                bne @mon
0008D7r 2  4C rr rr             jmp LAB_CRLF
0008DAr 2  A9 0D        @mon:   lda #13
0008DCr 2  20 rr rr             jsr CHROUT
0008DFr 2  A9 0A                lda #10
0008E1r 2  4C rr rr             jmp CHROUT
0008E4r 2               
0008E4r 2               ; print the low nibble of A as a hex digit
0008E4r 2               ch_hex2:
0008E4r 2  48                   pha
0008E5r 2  4A                   lsr
0008E6r 2  4A                   lsr
0008E7r 2  4A                   lsr
0008E8r 2  4A                   lsr
0008E9r 2  20 rr rr             jsr ch_hexdig
0008ECr 2  68                   pla
0008EDr 2  29 0F                and #$0F
0008EFr 2               ch_hexdig:
0008EFr 2  C9 0A                cmp #10
0008F1r 2  90 05                bcc @dig
0008F3r 2  69 36                adc #'A'-11                 ; carry is set here, so this adds 'A'-10
0008F5r 2  4C rr rr             jmp ch_prna
0008F8r 2  69 30        @dig:   adc #'0'
0008FAr 2  4C rr rr             jmp ch_prna
0008FDr 2               
0008FDr 2  0D 0A 3F 46  msg_nofile:  .byte 13,10,"?FILE NOT FOUND",0
000901r 2  49 4C 45 20  
000905r 2  4E 4F 54 20  
00090Fr 2  0D 0A 3F 44  msg_full:    .byte 13,10,"?DISK FULL",0
000913r 2  49 53 4B 20  
000917r 2  46 55 4C 4C  
00091Cr 2  0D 0A 3F 46  msg_toobig:  .byte 13,10,"?FILE TOO LARGE",0
000920r 2  49 4C 45 20  
000924r 2  54 4F 4F 20  
00092Er 2  0D 0A 3F 42  msg_badfile: .byte 13,10,"?BAD FILE",0
000932r 2  41 44 20 46  
000936r 2  49 4C 45 00  
00093Ar 2  0D 0A 3F 4E  msg_nodisk:  .byte 13,10,"?NO DISK",0
00093Er 2  4F 20 44 49  
000942r 2  53 4B 00     
000945r 2  20 28 43 4D  msg_diag1:   .byte " (CMD $",0
000949r 2  44 20 24 00  
00094Dr 2  2C 20 50 4F  msg_diag2:   .byte ", PORT $",0
000951r 2  52 54 20 24  
000955r 2  00           
000956r 2  0D 0A 3F 44  msg_io:      .byte 13,10,"?DISK ERROR",0
00095Ar 2  49 53 4B 20  
00095Er 2  45 52 52 4F  
000964r 2               
000964r 2               ; ============================================================================
000964r 2               ; LOADRAW "name" [, start]     SAVERAW "name", start, end
000964r 2               ;
000964r 2               ;   Raw memory block files (".DAT" is added when the name has no extension).
000964r 2               ;   SAVERAW writes the bytes start .. end-1.   (end is NOT included)
000964r 2               ;   LOADRAW reads the whole file to "start".  Without a start address the file
000964r 2               ;   goes to the first byte above BASIC's memory (Ememl), i.e. into the area you
000964r 2               ;   reserved with the "Memory size?" question at cold start.
000964r 2               ;   LOADRAW only accepts targets from Ememl up to Ram_top-1, so it can never
000964r 2               ;   overwrite the program, variables, strings or system RAM.  Anything else
000964r 2               ;   (or a file that does not fit) is a ?FUNCTION CALL ERROR / ?FILE TOO BIG.
000964r 2               ; ============================================================================
000964r 2               
000964r 2               ; ch_getaddr - evaluate a numeric expression as an address 0..65535
000964r 2               ;   out: Itempl/Itemph = value.  ?Function call error if negative or > 65535
000964r 2               ch_getaddr:
000964r 2  20 rr rr             jsr LAB_EVNM                ; evaluate, must be numeric
000967r 2  A5 B0                lda FAC1_s
000969r 2  30 09                bmi ch_fc
00096Br 2  A5 AC                lda FAC1_e
00096Dr 2  C9 91                cmp #$91                    ; >= 65536 ?
00096Fr 2  B0 03                bcs ch_fc
000971r 2  4C rr rr             jmp LAB_F2FX                ; to Itempl/Itemph
000974r 2               
000974r 2  A2 08        ch_fc:  ldx #EH_ERR_FC
000976r 2  4C rr rr             jmp LAB_XERR
000979r 2               
000979r 2               ; ch_rawname - filename for the RAW commands (no directory listing)
000979r 2               ch_rawname:                         ; A = 1 (.DAT) or 2 (.ARR)
000979r 2  8D rr rr             sta ch_raw
00097Cr 2  20 rr rr             jsr ch_get_filename
00097Fr 2  AD rr rr             lda ch_dir
000982r 2  D0 F0                bne ch_fc
000984r 2  60                   rts
000985r 2               
000985r 2               BI_SAVERAW:
000985r 2  A9 01                lda #1
000987r 2  20 rr rr             jsr ch_rawname
00098Ar 2  20 rr rr             jsr LAB_1C01                ; ","
00098Dr 2  20 rr rr             jsr ch_getaddr
000990r 2  A5 11                lda Itempl
000992r 2  8D rr rr             sta ch_a0
000995r 2  A5 12                lda Itemph
000997r 2  8D rr rr             sta ch_a0+1
00099Ar 2  20 rr rr             jsr LAB_1C01                ; ","
00099Dr 2  20 rr rr             jsr ch_getaddr
0009A0r 2  38                   sec                         ; ch_len = end - start
0009A1r 2  A5 11                lda Itempl
0009A3r 2  ED rr rr             sbc ch_a0
0009A6r 2  8D rr rr             sta ch_len
0009A9r 2  A5 12                lda Itemph
0009ABr 2  ED rr rr             sbc ch_a0+1
0009AEr 2  8D rr rr             sta ch_len+1
0009B1r 2  90 C1                bcc ch_fc                   ; end < start
0009B3r 2  0D rr rr             ora ch_len
0009B6r 2  F0 BC                beq ch_fc                   ; empty block
0009B8r 2  20 rr rr             jsr ch_prepare
0009BBr 2  90 05                bcc @ready
0009BDr 2  A9 F2                lda #CH_E_NODISK
0009BFr 2  4C rr rr             jmp ch_fail
0009C2r 2  A9 rr        @ready: lda #<ch_name
0009C4r 2  A2 rr                ldx #>ch_name
0009C6r 2  20 rr rr             jsr ch_file_create
0009C9r 2  C9 14 F0 03          CH_OK ch_fail
0009CDr 2  4C rr rr     
0009D0r 2  AD rr rr             lda ch_a0
0009D3r 2  8D rr rr             sta ch_ptr
0009D6r 2  AD rr rr             lda ch_a0+1
0009D9r 2  8D rr rr             sta ch_ptr+1
0009DCr 2  20 rr rr             jsr ch_write
0009DFr 2  C9 14 F0 03          CH_OK ch_fail_close
0009E3r 2  4C rr rr     
0009E6r 2  A9 01                lda #1                      ; close AND update the file length
0009E8r 2  20 rr rr             jsr ch_file_close
0009EBr 2  C9 14 F0 03          CH_OK ch_fail
0009EFr 2  4C rr rr     
0009F2r 2  60                   rts
0009F3r 2               
0009F3r 2               BI_LOADRAW:
0009F3r 2  A9 01                lda #1
0009F5r 2  20 rr rr             jsr ch_rawname
0009F8r 2  20 C2 00             jsr LAB_GBYT                ; optional ", start"
0009FBr 2  D0 0D                bne @addr
0009FDr 2  A5 85                lda Ememl                   ; default: first byte above BASIC memory
0009FFr 2  8D rr rr             sta ch_a0
000A02r 2  A5 86                lda Ememh
000A04r 2  8D rr rr             sta ch_a0+1
000A07r 2  4C rr rr             jmp @check
000A0Ar 2  20 rr rr     @addr:  jsr LAB_1C01
000A0Dr 2  20 rr rr             jsr ch_getaddr
000A10r 2  A5 11                lda Itempl
000A12r 2  8D rr rr             sta ch_a0
000A15r 2  A5 12                lda Itemph
000A17r 2  8D rr rr             sta ch_a0+1
000A1Ar 2  AD rr rr     @check: lda ch_a0+1                 ; start >= Ememl ?
000A1Dr 2  C5 86                cmp Ememh
000A1Fr 2  90 73                bcc lr_fc
000A21r 2  D0 07                bne @hiok
000A23r 2  AD rr rr             lda ch_a0
000A26r 2  C5 85                cmp Ememl
000A28r 2  90 6A                bcc lr_fc
000A2Ar 2  AD rr rr     @hiok:  lda ch_a0+1                 ; start < Ram_top ?
000A2Dr 2  C9 7F                cmp #>Ram_top
000A2Fr 2  B0 63                bcs lr_fc
000A31r 2  38                   sec                         ; room = Ram_top - start
000A32r 2  A9 00                lda #<Ram_top
000A34r 2  ED rr rr             sbc ch_a0
000A37r 2  8D rr rr             sta ch_len
000A3Ar 2  A9 7F                lda #>Ram_top
000A3Cr 2  ED rr rr             sbc ch_a0+1
000A3Fr 2  8D rr rr             sta ch_len+1
000A42r 2  20 rr rr             jsr ch_prepare
000A45r 2  90 05                bcc @ready
000A47r 2  A9 F2                lda #CH_E_NODISK
000A49r 2  4C rr rr             jmp ch_fail
000A4Cr 2  A9 rr        @ready: lda #<ch_name
000A4Er 2  A2 rr                ldx #>ch_name
000A50r 2  20 rr rr             jsr ch_file_open
000A53r 2  C9 14 F0 03          CH_OK ch_fail
000A57r 2  4C rr rr     
000A5Ar 2  AD rr rr             lda ch_a0
000A5Dr 2  8D rr rr             sta ch_ptr
000A60r 2  AD rr rr             lda ch_a0+1
000A63r 2  8D rr rr             sta ch_ptr+1
000A66r 2  20 rr rr             jsr ch_read
000A69r 2  C9 14 F0 03          CH_OK ch_fail_close
000A6Dr 2  4C rr rr     
000A70r 2  AD rr rr             lda ch_got+1                ; got >= room?  -> file did not fit
000A73r 2  CD rr rr             cmp ch_len+1
000A76r 2  90 0F                bcc @fits
000A78r 2  D0 08                bne @toobig
000A7Ar 2  AD rr rr             lda ch_got
000A7Dr 2  CD rr rr             cmp ch_len
000A80r 2  90 05                bcc @fits
000A82r 2               @toobig:
000A82r 2  A9 F0                lda #CH_E_TOOBIG
000A84r 2  4C rr rr             jmp ch_fail_close
000A87r 2  A9 00        @fits:  lda #0
000A89r 2  20 rr rr             jsr ch_file_close
000A8Cr 2  C9 14 F0 03          CH_OK ch_fail
000A90r 2  4C rr rr     
000A93r 2  60                   rts
000A94r 2  4C rr rr     lr_fc:    jmp ch_fc
000A97r 2               
000A97r 2               ; ============================================================================
000A97r 2               ; SAVEARR "name", A()      LOADARR "name", A()
000A97r 2               ;
000A97r 2               ;   Saves / restores a whole numeric array (".ARR" is added when the name has
000A97r 2               ;   no extension).  The file holds the array's dimension header followed by its
000A97r 2               ;   data.  LOADARR needs the array to exist already (DIM it first) with exactly
000A97r 2               ;   the same dimensions, so it can only ever overwrite that array's own data.
000A97r 2               ;   String arrays (A$()) are not supported (?Type mismatch).
000A97r 2               ; ============================================================================
000A97r 2               
000A97r 2               ; ch_findarr - parse  NAME()  at the BASIC pointer and locate the array
000A97r 2               ;   out: (Astrtl) = start of the array entry:
000A97r 2               ;        +0,+1 name, +2,+3 size of whole entry, +4 dimensions, +5.. sizes, data
000A97r 2               ch_findarr:
000A97r 2  20 C2 00             jsr LAB_GBYT
000A9Ar 2  85 93                sta Varnm1
000A9Cr 2  20 rr rr             jsr LAB_CASC                ; must start with a letter
000A9Fr 2  B0 03                bcs @l1
000AA1r 2  4C rr rr             jmp LAB_SNER
000AA4r 2  A2 00        @l1:    ldx #0
000AA6r 2  86 5F                stx Dtypef
000AA8r 2  20 BC 00             jsr LAB_IGBY                ; 2nd character
000AABr 2  90 05                bcc @two                    ; digit
000AADr 2  20 rr rr             jsr LAB_CASC
000AB0r 2  90 0B                bcc @suffix                 ; not a letter
000AB2r 2  AA           @two:   tax
000AB3r 2  20 BC 00     @skip:  jsr LAB_IGBY                ; ignore further name characters
000AB6r 2  90 FB                bcc @skip
000AB8r 2  20 rr rr             jsr LAB_CASC
000ABBr 2  B0 F6                bcs @skip
000ABDr 2               @suffix:
000ABDr 2  C9 24                cmp #'$'
000ABFr 2  D0 05                bne @nostr
000AC1r 2  A2 18                ldx #EH_ERR_TM              ; string arrays are not supported
000AC3r 2  4C rr rr             jmp LAB_XERR
000AC6r 2  86 94        @nostr: stx Varnm2
000AC8r 2  C9 28                cmp #'('
000ACAr 2  F0 03                beq @paren
000ACCr 2  4C rr rr             jmp LAB_SNER
000ACFr 2  20 BC 00     @paren: jsr LAB_IGBY
000AD2r 2  20 rr rr             jsr LAB_1BFB                ; ")"
000AD5r 2               
000AD5r 2  A6 7D                ldx Sarryl                  ; search the array area (as LAB_1E17 does)
000AD7r 2  A5 7E                lda Sarryh
000AD9r 2  86 AA        @next:  stx Astrtl
000ADBr 2  85 AB                sta Astrth
000ADDr 2  C5 80                cmp Earryh
000ADFr 2  D0 04                bne @chk
000AE1r 2  E4 7F                cpx Earryl
000AE3r 2  F0 1E                beq @none
000AE5r 2  A0 00        @chk:   ldy #0
000AE7r 2  B1 AA                lda (Astrtl),y
000AE9r 2  C5 93                cmp Varnm1
000AEBr 2  D0 07                bne @skp
000AEDr 2  C8                   iny
000AEEr 2  B1 AA                lda (Astrtl),y
000AF0r 2  C5 94                cmp Varnm2
000AF2r 2  F0 12                beq @found
000AF4r 2  A0 02        @skp:   ldy #2
000AF6r 2  B1 AA                lda (Astrtl),y
000AF8r 2  18                   clc
000AF9r 2  65 AA                adc Astrtl
000AFBr 2  AA                   tax
000AFCr 2  C8                   iny
000AFDr 2  B1 AA                lda (Astrtl),y
000AFFr 2  65 AB                adc Astrth
000B01r 2  90 D6                bcc @next
000B03r 2  4C rr rr     @none:  jmp ch_fc                   ; no such array: ?Function call error
000B06r 2  A0 04        @found: ldy #4
000B08r 2  B1 AA                lda (Astrtl),y              ; dimensions
000B0Ar 2  C9 10                cmp #16
000B0Cr 2  B0 F5                bcs @none                   ; header must fit in ch_ent
000B0Er 2  60                   rts
000B0Fr 2               
000B0Fr 2               BI_SAVEARR:
000B0Fr 2  A9 02                lda #2
000B11r 2  20 rr rr             jsr ch_rawname
000B14r 2  20 rr rr             jsr LAB_1C01                ; ","
000B17r 2  20 rr rr             jsr ch_findarr
000B1Ar 2  20 rr rr             jsr ch_prepare
000B1Dr 2  90 05                bcc @ready
000B1Fr 2  A9 F2                lda #CH_E_NODISK
000B21r 2  4C rr rr             jmp ch_fail
000B24r 2  A9 rr        @ready: lda #<ch_name
000B26r 2  A2 rr                ldx #>ch_name
000B28r 2  20 rr rr             jsr ch_file_create
000B2Br 2  C9 14 F0 03          CH_OK ch_fail
000B2Fr 2  4C rr rr     
000B32r 2  A0 02                ldy #2                      ; ch_len = size - 4
000B34r 2  38                   sec
000B35r 2  B1 AA                lda (Astrtl),y
000B37r 2  E9 04                sbc #4
000B39r 2  8D rr rr             sta ch_len
000B3Cr 2  C8                   iny
000B3Dr 2  B1 AA                lda (Astrtl),y
000B3Fr 2  E9 00                sbc #0
000B41r 2  8D rr rr             sta ch_len+1
000B44r 2  18                   clc                         ; ch_ptr = entry + 4
000B45r 2  A5 AA                lda Astrtl
000B47r 2  69 04                adc #4
000B49r 2  8D rr rr             sta ch_ptr
000B4Cr 2  A5 AB                lda Astrth
000B4Er 2  69 00                adc #0
000B50r 2  8D rr rr             sta ch_ptr+1
000B53r 2  20 rr rr             jsr ch_write
000B56r 2  C9 14 F0 03          CH_OK ch_fail_close
000B5Ar 2  4C rr rr     
000B5Dr 2  A9 01                lda #1
000B5Fr 2  20 rr rr             jsr ch_file_close
000B62r 2  C9 14 F0 03          CH_OK ch_fail
000B66r 2  4C rr rr     
000B69r 2  60                   rts
000B6Ar 2               
000B6Ar 2               BI_LOADARR:
000B6Ar 2  A9 02                lda #2
000B6Cr 2  20 rr rr             jsr ch_rawname
000B6Fr 2  20 rr rr             jsr LAB_1C01                ; ","
000B72r 2  20 rr rr             jsr ch_findarr
000B75r 2  20 rr rr             jsr ch_prepare
000B78r 2  90 05                bcc @ready
000B7Ar 2  A9 F2                lda #CH_E_NODISK
000B7Cr 2  4C rr rr             jmp ch_fail
000B7Fr 2  A9 rr        @ready: lda #<ch_name
000B81r 2  A2 rr                ldx #>ch_name
000B83r 2  20 rr rr             jsr ch_file_open
000B86r 2  C9 14 F0 03          CH_OK ch_fail
000B8Ar 2  4C rr rr     
000B8Dr 2  A0 04                ldy #4                      ; header = 1 + 2*dimensions bytes
000B8Fr 2  B1 AA                lda (Astrtl),y
000B91r 2  0A                   asl
000B92r 2  18                   clc
000B93r 2  69 01                adc #1
000B95r 2  8D rr rr             sta ch_len
000B98r 2  A9 00                lda #0
000B9Ar 2  8D rr rr             sta ch_len+1
000B9Dr 2  A9 rr                lda #<ch_ent
000B9Fr 2  8D rr rr             sta ch_ptr
000BA2r 2  A9 rr                lda #>ch_ent
000BA4r 2  8D rr rr             sta ch_ptr+1
000BA7r 2  20 rr rr             jsr ch_read
000BAAr 2  C9 14 F0 03          CH_OK ch_fail_close
000BAEr 2  4C rr rr     
000BB1r 2  AD rr rr             lda ch_got+1
000BB4r 2  D0 6D                bne la_bad
000BB6r 2  AD rr rr             lda ch_got
000BB9r 2  CD rr rr             cmp ch_len
000BBCr 2  D0 65                bne la_bad                    ; file shorter than a header
000BBEr 2  A2 00                ldx #0                      ; header must match the array exactly
000BC0r 2  A0 04                ldy #4
000BC2r 2  BD rr rr     @cmp:   lda ch_ent,x
000BC5r 2  D1 AA                cmp (Astrtl),y
000BC7r 2  D0 5A                bne la_bad
000BC9r 2  E8                   inx
000BCAr 2  C8                   iny
000BCBr 2  EC rr rr             cpx ch_len
000BCEr 2  D0 F2                bne @cmp
000BD0r 2  AD rr rr             lda ch_len                  ; data offset = 4 + header
000BD3r 2  18                   clc
000BD4r 2  69 04                adc #4
000BD6r 2  8D rr rr             sta ch_cnt
000BD9r 2  A0 02                ldy #2                      ; ch_len = size - offset
000BDBr 2  38                   sec
000BDCr 2  B1 AA                lda (Astrtl),y
000BDEr 2  ED rr rr             sbc ch_cnt
000BE1r 2  8D rr rr             sta ch_len
000BE4r 2  C8                   iny
000BE5r 2  B1 AA                lda (Astrtl),y
000BE7r 2  E9 00                sbc #0
000BE9r 2  8D rr rr             sta ch_len+1
000BECr 2  18                   clc                         ; ch_ptr = entry + offset
000BEDr 2  A5 AA                lda Astrtl
000BEFr 2  6D rr rr             adc ch_cnt
000BF2r 2  8D rr rr             sta ch_ptr
000BF5r 2  A5 AB                lda Astrth
000BF7r 2  69 00                adc #0
000BF9r 2  8D rr rr             sta ch_ptr+1
000BFCr 2  20 rr rr             jsr ch_read
000BFFr 2  C9 14 F0 03          CH_OK ch_fail_close
000C03r 2  4C rr rr     
000C06r 2  AD rr rr             lda ch_got                  ; must have got everything
000C09r 2  CD rr rr             cmp ch_len
000C0Cr 2  D0 15                bne la_bad
000C0Er 2  AD rr rr             lda ch_got+1
000C11r 2  CD rr rr             cmp ch_len+1
000C14r 2  D0 0D                bne la_bad
000C16r 2  A9 00                lda #0
000C18r 2  20 rr rr             jsr ch_file_close
000C1Br 2  C9 14 F0 03          CH_OK ch_fail
000C1Fr 2  4C rr rr     
000C22r 2  60                   rts
000C23r 2  A9 F1        la_bad:   lda #CH_E_BADFILE
000C25r 2  4C rr rr             jmp ch_fail_close
000C28r 2               
000C28r 1               .include "pcf8584.s"            ; PCF8584 I2C bridge driver (BIOS, BIOSVARS)
000C28r 2               ; ============================================================================
000C28r 2               ; pcf8584.s - PCF8584 parallel-bus to I2C bridge driver (master mode, polled)
000C28r 2               ;
000C28r 2               ; Ported from pcf8584_lcd_test.s (vasm) to ca65.  Contains only the bus layer:
000C28r 2               ;   pcf_init       initialise the chip                    C=1 on failure
000C28r 2               ;   i2c_start      START + address byte (i2c_addr)        C=1 on NACK / timeout
000C28r 2               ;   i2c_send       send byte in A                         C=1 on NACK / timeout
000C28r 2               ;   i2c_read1      START + read ONE byte, then STOP       C=1 on failure, A=byte
000C28r 2               ;   i2c_stop       STOP
000C28r 2               ;   delay_ms       delay A milliseconds
000C28r 2               ;
000C28r 2               ; Transfers are polled.  The chip's INT output (your IRQ4) stays silent because
000C28r 2               ; the ENI bit is never set in the control register.  The BIOS routes IRQ4 to
000C28r 2               ; EhBASIC's "ON IRQ" flag, so nothing happens there unless you add interrupt
000C28r 2               ; driven transfers later.
000C28r 2               ;
000C28r 2               ; Included from main.s after basic.s.  Code is in segment BIOS, variables in
000C28r 2               ; BIOSVARS (both placed by sbc.cfg).
000C28r 2               ; ============================================================================
000C28r 2               
000C28r 2               ; ---------------- user configuration ----------------------------------------
000C28r 2               ; CPU_MHZ (CPU clock in whole MHz) is set once, at the top of main.s
000C28r 2               
000C28r 2               PCF_S0      = $7F10         ; A0=0 : S0 data / S0' own addr / S2 clock (selected via S1)
000C28r 2               PCF_S1      = $7F11         ; A0=1 : S1 control (write) / status (read)
000C28r 2               
000C28r 2               PCF_OWN     = $55           ; PCF8584's own I2C address (must not clash with your devices)
000C28r 2               
000C28r 2               ; S2 clock register = (PCF CLK pin frequency) + (SCL frequency)
000C28r 2               ;   CLK pin freq: $00 = 3 MHz, $10 = 4.43 MHz, $14 = 6 MHz, $18 = 8 MHz, $1C = 12 MHz
000C28r 2               ;   SCL freq    : +0 = 90 kHz, +1 = 45 kHz, +2 = 11 kHz, +3 = 1.5 kHz
000C28r 2               ; NOTE: the original test file said "$00 = 8 MHz clock" but by the table above
000C28r 2               ; $00 means a 3 MHz clock on the CLK pin.  Set this for YOUR oscillator.
000C28r 2               PCF_CLOCK   = $00
000C28r 2               
000C28r 2               ; ---------------- PCF8584 bits ------------------------------------------------
000C28r 2               ; Control register (write)
000C28r 2               PCF_PIN     = $80
000C28r 2               PCF_ESO     = $40
000C28r 2               PCF_ES1     = $20
000C28r 2               PCF_STA     = $04
000C28r 2               PCF_STO     = $02
000C28r 2               PCF_ACK     = $01
000C28r 2               ; Status register (read)
000C28r 2               PCF_ST_LRB  = $08           ; last received bit: 0 = ACK, 1 = NACK
000C28r 2               PCF_ST_BB   = $01           ; bus busy (inverted: 1 = bus FREE)
000C28r 2               
000C28r 2               CTRL_IDLE   = PCF_PIN+PCF_ESO+PCF_ACK              ; $C1
000C28r 2               CTRL_START  = PCF_PIN+PCF_ESO+PCF_STA+PCF_ACK      ; $C5
000C28r 2               CTRL_STOP   = PCF_PIN+PCF_ESO+PCF_STO+PCF_ACK      ; $C3
000C28r 2               CTRL_NOACK  = PCF_PIN+PCF_ESO                      ; $C0 (receive last byte)
000C28r 2               
000C28r 2               ; ---------------- variables ---------------------------------------------------
000C28r 2               .segment "BIOSVARS"
000006r 2  xx           i2c_dly:    .res 1          ; delay_ms counter
000007r 2  xx           i2c_addr:   .res 1          ; slave address byte (incl. R/W bit) for i2c_start
000008r 2  xx           pcf_stat:   .res 1          ; last PCF status (for debugging)
000009r 2  xx           pcf_ready:  .res 1          ; non-zero once pcf_init has succeeded
00000Ar 2               
00000Ar 2               .segment "BIOS"
000C28r 2               
000C28r 2               ; ============================================================================
000C28r 2               ; PCF8584 initialisation (datasheet sequence)
000C28r 2               ; Returns C=0 on success, C=1 on failure (raw status in pcf_stat)
000C28r 2               ; ============================================================================
000C28r 2               pcf_init:
000C28r 2  A9 80                lda     #PCF_PIN            ; $80: ESO=0 -> next A0=0 access is S0' (own address)
000C2Ar 2  8D 11 7F             sta     PCF_S1
000C2Dr 2  A9 55                lda     #PCF_OWN
000C2Fr 2  8D 10 7F             sta     PCF_S0              ; write own address
000C32r 2  A9 A0                lda     #PCF_PIN+PCF_ES1    ; $A0: next A0=0 access is S2 (clock)
000C34r 2  8D 11 7F             sta     PCF_S1
000C37r 2  A9 00                lda     #PCF_CLOCK
000C39r 2  8D 10 7F             sta     PCF_S0              ; write clock register
000C3Cr 2  A9 01                lda     #1
000C3Er 2  20 rr rr             jsr     delay_ms            ; let the internal clock settle
000C41r 2  A9 C1                lda     #CTRL_IDLE          ; $C1: serial interface on, ACK enabled
000C43r 2  8D 11 7F             sta     PCF_S1
000C46r 2  A9 01                lda     #1
000C48r 2  20 rr rr             jsr     delay_ms
000C4Br 2  AD 11 7F             lda     PCF_S1              ; expect PIN=1 and BB=1 (bus free) -> $81
000C4Er 2  8D rr rr             sta     pcf_stat
000C51r 2  29 81                and     #PCF_PIN+PCF_ST_BB
000C53r 2  C9 81                cmp     #PCF_PIN+PCF_ST_BB
000C55r 2  D0 02                bne     @fail
000C57r 2  18                   clc
000C58r 2  60                   rts
000C59r 2  38           @fail:  sec
000C5Ar 2  60                   rts
000C5Br 2               
000C5Br 2               ; ============================================================================
000C5Br 2               ; Wait for PIN to go low (byte transfer finished)
000C5Br 2               ; Returns C=0 and A=status, or C=1 on timeout.  Clobbers X, Y.
000C5Br 2               ; ============================================================================
000C5Br 2               pcf_wait_pin:
000C5Br 2  A2 10                ldx     #16
000C5Dr 2  A0 00                ldy     #0
000C5Fr 2  AD 11 7F     @loop:  lda     PCF_S1
000C62r 2  10 08                bpl     @ok                 ; bit7 (PIN) = 0 -> done
000C64r 2  88                   dey
000C65r 2  D0 F8                bne     @loop
000C67r 2  CA                   dex
000C68r 2  D0 F5                bne     @loop
000C6Ar 2  38                   sec
000C6Br 2  60                   rts
000C6Cr 2  8D rr rr     @ok:    sta     pcf_stat
000C6Fr 2  18                   clc
000C70r 2  60                   rts
000C71r 2               
000C71r 2               ; ============================================================================
000C71r 2               ; I2C: START + address.  i2c_addr = 8-bit address byte (incl. R/W)
000C71r 2               ; Returns C=0 if slave ACKed, C=1 on timeout/NACK.  Clobbers A, X, Y.
000C71r 2               ; ============================================================================
000C71r 2               i2c_start:
000C71r 2  A2 10                ldx     #16                 ; wait for bus free (BB=1)
000C73r 2  A0 00                ldy     #0
000C75r 2  AD 11 7F     @bb:    lda     PCF_S1
000C78r 2  29 01                and     #PCF_ST_BB
000C7Ar 2  D0 08                bne     @go
000C7Cr 2  88                   dey
000C7Dr 2  D0 F6                bne     @bb
000C7Fr 2  CA                   dex
000C80r 2  D0 F3                bne     @bb
000C82r 2  38                   sec
000C83r 2  60                   rts
000C84r 2  AD rr rr     @go:    lda     i2c_addr
000C87r 2  8D 10 7F             sta     PCF_S0              ; address goes into S0 first
000C8Ar 2  A9 C5                lda     #CTRL_START
000C8Cr 2  8D 11 7F             sta     PCF_S1              ; then START
000C8Fr 2  20 rr rr             jsr     pcf_wait_pin
000C92r 2  B0 04                bcs     @rts                ; timeout (C already set)
000C94r 2  29 08                and     #PCF_ST_LRB         ; 0 = ACK
000C96r 2  C9 01                cmp     #1                  ; A=0 -> C=0 ; A=8 -> C=1
000C98r 2  60           @rts:   rts
000C99r 2               
000C99r 2               ; ============================================================================
000C99r 2               ; I2C: send byte in A.  Returns C=0 if ACKed, C=1 on timeout/NACK
000C99r 2               ; ============================================================================
000C99r 2               i2c_send:
000C99r 2  8D 10 7F             sta     PCF_S0
000C9Cr 2  20 rr rr             jsr     pcf_wait_pin
000C9Fr 2  B0 04                bcs     @rts
000CA1r 2  29 08                and     #PCF_ST_LRB
000CA3r 2  C9 01                cmp     #1
000CA5r 2  60           @rts:   rts
000CA6r 2               
000CA6r 2               ; ============================================================================
000CA6r 2               ; I2C: STOP
000CA6r 2               ; ============================================================================
000CA6r 2               i2c_stop:
000CA6r 2  A9 C3                lda     #CTRL_STOP
000CA8r 2  8D 11 7F             sta     PCF_S1
000CABr 2  60                   rts
000CACr 2               
000CACr 2               ; ============================================================================
000CACr 2               ; I2C: read ONE byte.  i2c_addr must hold the address byte with R/W = 1.
000CACr 2               ; Sends START + address, receives a single byte with NACK, then STOP.
000CACr 2               ; Returns C=0 and A = byte, or C=1 on NACK / timeout (bus is released).
000CACr 2               ; Follows the sequence used by the Linux i2c-algo-pcf driver.
000CACr 2               ; ============================================================================
000CACr 2               i2c_read1:
000CACr 2  20 rr rr             jsr     i2c_start           ; START + address (R)
000CAFr 2  B0 17                bcs     @fail
000CB1r 2  A9 C0                lda     #CTRL_NOACK         ; this is the last byte: do not ACK it
000CB3r 2  8D 11 7F             sta     PCF_S1
000CB6r 2  AD 10 7F             lda     PCF_S0              ; dummy read of S0 starts the byte clocking in
000CB9r 2  20 rr rr             jsr     pcf_wait_pin
000CBCr 2  B0 0A                bcs     @fail
000CBEr 2  A9 C3                lda     #CTRL_STOP          ; STOP, then fetch the received byte
000CC0r 2  8D 11 7F             sta     PCF_S1
000CC3r 2  AD 10 7F             lda     PCF_S0
000CC6r 2  18                   clc
000CC7r 2  60                   rts
000CC8r 2  20 rr rr     @fail:  jsr     i2c_stop
000CCBr 2  38                   sec
000CCCr 2  60                   rts
000CCDr 2               
000CCDr 2               ; ============================================================================
000CCDr 2               ; Delay A milliseconds (approximate, errs on the long side)
000CCDr 2               ; ============================================================================
000CCDr 2               delay_ms:
000CCDr 2  8D rr rr             sta     i2c_dly
000CD0r 2  A2 02        @ms:    ldx     #CPU_MHZ
000CD2r 2  A0 C8        @outer: ldy     #200                ; 200 * 5 cycles = 1000 cycles = 1 ms @ 1 MHz
000CD4r 2  88           @inner: dey
000CD5r 2  D0 FD                bne     @inner
000CD7r 2  CA                   dex
000CD8r 2  D0 F8                bne     @outer
000CDAr 2  CE rr rr             dec     i2c_dly
000CDDr 2  D0 F1                bne     @ms
000CDFr 2  60                   rts
000CE0r 2               
000CE0r 1               .include "lcd_i2c.s"            ; I2C LCD via MCP23008      (BIOS, BIOSVARS, ZEROPAGE)
000CE0r 2               ; ============================================================================
000CE0r 2               ; lcd_i2c.s - HD44780 LCD (4-bit) behind an MCP23008 I2C port expander
000CE0r 2               ;
000CE0r 2               ; Ported from pcf8584_lcd_test.s.  Uses the bus layer in pcf8584.s.
000CE0r 2               ;
000CE0r 2               ;   mcp_write      A = MCP register, Y = value
000CE0r 2               ;   lcd_init       full HD44780 power-up sequence (also sets lcd_ready)
000CE0r 2               ;   lcd_cmd        send command byte in A
000CE0r 2               ;   lcd_data       send character in A
000CE0r 2               ;   lcd_clear      clear display (includes the 1.6 ms wait)
000CE0r 2               ;   lcd_putbuf     send lcd_len characters from (strptr)
000CE0r 2               ;   lcd_puts       send zero terminated string at (strptr)  (kept from the test)
000CE0r 2               ;
000CE0r 2               ; ERRORS: any failed I2C access sets i2c_err non-zero and is "latched": while
000CE0r 2               ; i2c_err is set, mcp_write returns immediately, so a missing LCD costs one
000CE0r 2               ; timeout instead of dozens.  The caller clears i2c_err before a command and
000CE0r 2               ; looks at it afterwards (basic_i2c.s does that and raises "I2C Error").
000CE0r 2               ; ============================================================================
000CE0r 2               
000CE0r 2               ; ---------------- user configuration ----------------------------------------
000CE0r 2               MCP_ADDR_W  = $40           ; DEFAULT address: 0x20 << 1, R/W = 0 (write).  LCDINIT addr overrides it.
000CE0r 2               
000CE0r 2               ; ---------------- MCP23008 ------------------------------------------------------
000CE0r 2               MCP_IODIR   = $00
000CE0r 2               MCP_GPIO    = $09
000CE0r 2               
000CE0r 2               LCD_RS      = $80           ; GPIO7
000CE0r 2               LCD_E       = $40           ; GPIO6
000CE0r 2               LCD_BL      = $02           ; GPIO1
000CE0r 2               
000CE0r 2               ; ---------------- PCF8574 backpack (LCDINIT addr, 1) ----------------------------
000CE0r 2               LCP_RS      = $01           ; P0
000CE0r 2               LCP_E       = $04           ; P2   (P1 = RW, kept low)
000CE0r 2               LCP_BL      = $08           ; P3   P4-P7 = D4-D7
000CE0r 2               
000CE0r 2               ; ---------------- variables ---------------------------------------------------
000CE0r 2               .zeropage
000008r 2               ; strptr (zero page, 2 bytes) is declared in ch376_abs.s
000008r 2               
000008r 2               .segment "BIOSVARS"
00000Ar 2  xx           i2c_err:    .res 1          ; non-zero if any I2C error occurred (latched)
00000Br 2  xx           lcd_rs:     .res 1          ; current RS bit ($00 or LCD_RS)
00000Cr 2  xx           lcd_val:    .res 1          ; GPIO value being sent
00000Dr 2  xx           mcp_reg:    .res 1          ; MCP register for mcp_write
00000Er 2  xx           mcp_data:   .res 1          ; MCP data for mcp_write
00000Fr 2  xx           lcd_ready:  .res 1          ; non-zero once lcd_init has run
000010r 2  xx           lcd_addr:   .res 1          ; I2C address byte (7 bit address << 1, R/W = 0) of the LCD
000011r 2  xx           lcd_type:   .res 1          ; 0 = MCP23008 backpack, 1 = PCF8574 backpack
000012r 2  xx           lcd_len:    .res 1          ; characters left for lcd_putbuf
000013r 2               
000013r 2               .segment "BIOS"
000CE0r 2               
000CE0r 2               ; ============================================================================
000CE0r 2               ; MCP23008 register write.  A = register, Y = value
000CE0r 2               ; Sets i2c_err on failure.  Does nothing while i2c_err is already set.
000CE0r 2               ; Clobbers A, X, Y.
000CE0r 2               ; ============================================================================
000CE0r 2               mcp_write:
000CE0r 2  AE rr rr             ldx     i2c_err
000CE3r 2  D0 24                bne     @rts                ; earlier error: don't touch the bus
000CE5r 2  8D rr rr             sta     mcp_reg
000CE8r 2  8C rr rr             sty     mcp_data
000CEBr 2  AD rr rr             lda     lcd_addr            ; default MCP_ADDR_W, changed by LCDINIT addr
000CEEr 2  8D rr rr             sta     i2c_addr
000CF1r 2  20 rr rr             jsr     i2c_start
000CF4r 2  B0 14                bcs     @fail
000CF6r 2  AD rr rr             lda     mcp_reg
000CF9r 2  20 rr rr             jsr     i2c_send
000CFCr 2  B0 0C                bcs     @fail
000CFEr 2  AD rr rr             lda     mcp_data
000D01r 2  20 rr rr             jsr     i2c_send
000D04r 2  B0 04                bcs     @fail
000D06r 2  20 rr rr             jsr     i2c_stop
000D09r 2  60           @rts:   rts
000D0Ar 2  20 rr rr     @fail:  jsr     i2c_stop
000D0Dr 2  A9 FF                lda     #$FF
000D0Fr 2  8D rr rr             sta     i2c_err
000D12r 2  60                   rts
000D13r 2               
000D13r 2               ; ============================================================================
000D13r 2               ; LCD (HD44780, 4-bit, via MCP23008)
000D13r 2               ; ============================================================================
000D13r 2               lcd_init:
000D13r 2  AD rr rr             lda     lcd_type
000D16r 2  D0 11                bne     @pcf
000D18r 2  A9 00                lda     #MCP_IODIR          ; all GPIO = outputs
000D1Ar 2  A0 00                ldy     #$00
000D1Cr 2  20 rr rr             jsr     mcp_write
000D1Fr 2  A9 09                lda     #MCP_GPIO           ; backlight on, E=0, RS=0
000D21r 2  A0 02                ldy     #LCD_BL
000D23r 2  20 rr rr             jsr     mcp_write
000D26r 2  4C rr rr             jmp     @common
000D29r 2  A9 08        @pcf:   lda     #LCP_BL             ; PCF8574 has no registers: backlight on, E=0
000D2Br 2  20 rr rr             jsr     lcp_write
000D2Er 2               @common:
000D2Er 2  A9 00                lda     #0
000D30r 2  8D rr rr             sta     lcd_rs
000D33r 2               
000D33r 2  A9 32                lda     #50                 ; >40 ms after power up
000D35r 2  20 rr rr             jsr     delay_ms
000D38r 2  A9 03                lda     #$03
000D3Ar 2  20 rr rr             jsr     lcd_nibble
000D3Dr 2  A9 05                lda     #5                  ; >4.1 ms
000D3Fr 2  20 rr rr             jsr     delay_ms
000D42r 2  A9 03                lda     #$03
000D44r 2  20 rr rr             jsr     lcd_nibble
000D47r 2  A9 01                lda     #1                  ; >100 us
000D49r 2  20 rr rr             jsr     delay_ms
000D4Cr 2  A9 03                lda     #$03
000D4Er 2  20 rr rr             jsr     lcd_nibble
000D51r 2  A9 01                lda     #1
000D53r 2  20 rr rr             jsr     delay_ms
000D56r 2  A9 02                lda     #$02                ; switch to 4-bit mode
000D58r 2  20 rr rr             jsr     lcd_nibble
000D5Br 2  A9 01                lda     #1
000D5Dr 2  20 rr rr             jsr     delay_ms
000D60r 2               
000D60r 2  A9 28                lda     #$28                ; function set: 4-bit, 2 lines, 5x8
000D62r 2  20 rr rr             jsr     lcd_cmd
000D65r 2  A9 08                lda     #$08                ; display off
000D67r 2  20 rr rr             jsr     lcd_cmd
000D6Ar 2  20 rr rr             jsr     lcd_clear           ; clear display (+ wait)
000D6Dr 2  A9 06                lda     #$06                ; entry mode: increment, no shift
000D6Fr 2  20 rr rr             jsr     lcd_cmd
000D72r 2  A9 0C                lda     #$0C                ; display on, cursor off, blink off
000D74r 2  20 rr rr             jsr     lcd_cmd
000D77r 2  A9 01                lda     #1
000D79r 2  8D rr rr             sta     lcd_ready
000D7Cr 2  60                   rts
000D7Dr 2               
000D7Dr 2               ; Clear display and wait for it to finish (needs ~1.6 ms)
000D7Dr 2               lcd_clear:
000D7Dr 2  A9 01                lda     #$01
000D7Fr 2  20 rr rr             jsr     lcd_cmd
000D82r 2  A9 03                lda     #3
000D84r 2  4C rr rr             jmp     delay_ms
000D87r 2               
000D87r 2               ; Send command in A
000D87r 2               lcd_cmd:
000D87r 2  A0 00                ldy     #$00
000D89r 2  8C rr rr             sty     lcd_rs
000D8Cr 2  4C rr rr             jmp     lcd_byte
000D8Fr 2               
000D8Fr 2               ; Send data (character) in A
000D8Fr 2               lcd_data:
000D8Fr 2  A0 80                ldy     #LCD_RS
000D91r 2  8C rr rr             sty     lcd_rs
000D94r 2                       ; fall through
000D94r 2               
000D94r 2               ; Send full byte in A (RS already in lcd_rs), high nibble first
000D94r 2               lcd_byte:
000D94r 2  48                   pha
000D95r 2  4A                   lsr
000D96r 2  4A                   lsr
000D97r 2  4A                   lsr
000D98r 2  4A                   lsr
000D99r 2  20 rr rr             jsr     lcd_nibble
000D9Cr 2  68                   pla
000D9Dr 2                       ; fall through, lcd_nibble masks to low nibble
000D9Dr 2               
000D9Dr 2               ; Send low nibble of A to LCD D4-D7 with an E pulse
000D9Dr 2               lcd_nibble:
000D9Dr 2  AE rr rr             ldx     lcd_type
000DA0r 2  D0 29                bne     lcd_nibble_pcf
000DA2r 2  29 0F                and     #$0F
000DA4r 2  AA                   tax
000DA5r 2  BD rr rr             lda     nibble_tab,x
000DA8r 2  09 02                ora     #LCD_BL
000DAAr 2  0D rr rr             ora     lcd_rs
000DADr 2  8D rr rr             sta     lcd_val
000DB0r 2               
000DB0r 2  A9 09                lda     #MCP_GPIO           ; data + RS valid, E low
000DB2r 2  AC rr rr             ldy     lcd_val
000DB5r 2  20 rr rr             jsr     mcp_write
000DB8r 2               
000DB8r 2  AD rr rr             lda     lcd_val             ; E high
000DBBr 2  09 40                ora     #LCD_E
000DBDr 2  A8                   tay
000DBEr 2  A9 09                lda     #MCP_GPIO
000DC0r 2  20 rr rr             jsr     mcp_write
000DC3r 2               
000DC3r 2  A9 09                lda     #MCP_GPIO           ; E low (latches data)
000DC5r 2  AC rr rr             ldy     lcd_val
000DC8r 2  4C rr rr             jmp     mcp_write
000DCBr 2               
000DCBr 2               ; PCF8574 variant of lcd_nibble.  Pins: P0=RS P1=RW(0) P2=E P3=BL P4-P7=D4-D7
000DCBr 2               lcd_nibble_pcf:
000DCBr 2  0A                   asl
000DCCr 2  0A                   asl
000DCDr 2  0A                   asl
000DCEr 2  0A                   asl                         ; nibble -> P7..P4
000DCFr 2  09 08                ora     #LCP_BL
000DD1r 2  AE rr rr             ldx     lcd_rs
000DD4r 2  F0 02                beq     @nors
000DD6r 2  09 01                ora     #LCP_RS
000DD8r 2  8D rr rr     @nors:  sta     lcd_val
000DDBr 2  20 rr rr             jsr     lcp_write           ; data + RS valid, E low
000DDEr 2  AD rr rr             lda     lcd_val
000DE1r 2  09 04                ora     #LCP_E
000DE3r 2  20 rr rr             jsr     lcp_write           ; E high
000DE6r 2  AD rr rr             lda     lcd_val
000DE9r 2  4C rr rr             jmp     lcp_write           ; E low (latches data)
000DECr 2               
000DECr 2               ; PCF8574 write: A = port value (a single byte, no register).
000DECr 2               lcp_write:
000DECr 2  AE rr rr             ldx     i2c_err
000DEFr 2  D0 19                bne     @rts
000DF1r 2  8D rr rr             sta     mcp_data
000DF4r 2  AD rr rr             lda     lcd_addr
000DF7r 2  8D rr rr             sta     i2c_addr
000DFAr 2  20 rr rr             jsr     i2c_start
000DFDr 2  B0 0C                bcs     @fail
000DFFr 2  AD rr rr             lda     mcp_data
000E02r 2  20 rr rr             jsr     i2c_send
000E05r 2  B0 04                bcs     @fail
000E07r 2  4C rr rr             jmp     i2c_stop
000E0Ar 2  60           @rts:   rts
000E0Br 2  20 rr rr     @fail:  jsr     i2c_stop
000E0Er 2  A9 FF                lda     #$FF
000E10r 2  8D rr rr             sta     i2c_err
000E13r 2  60                   rts
000E14r 2               
000E14r 2               ; Send lcd_len characters from (strptr).  Stops early on an I2C error.
000E14r 2               lcd_putbuf:
000E14r 2  AD rr rr     @next:  lda     lcd_len
000E17r 2  F0 18                beq     @done
000E19r 2  AD rr rr             lda     i2c_err
000E1Cr 2  D0 13                bne     @done
000E1Er 2  A0 00                ldy     #0
000E20r 2  B1 rr                lda     (strptr),y
000E22r 2  20 rr rr             jsr     lcd_data
000E25r 2  E6 rr                inc     strptr
000E27r 2  D0 02                bne     @nc
000E29r 2  E6 rr                inc     strptr+1
000E2Br 2  CE rr rr     @nc:    dec     lcd_len
000E2Er 2  4C rr rr             jmp     @next
000E31r 2  60           @done:  rts
000E32r 2               
000E32r 2               ; Print zero-terminated string at (strptr)
000E32r 2               lcd_puts:
000E32r 2  A0 00                ldy     #0
000E34r 2  B1 rr                lda     (strptr),y
000E36r 2  F0 0C                beq     @done
000E38r 2  20 rr rr             jsr     lcd_data
000E3Br 2  E6 rr                inc     strptr
000E3Dr 2  D0 F3                bne     lcd_puts
000E3Fr 2  E6 rr                inc     strptr+1
000E41r 2  4C rr rr             jmp     lcd_puts
000E44r 2  60           @done:  rts
000E45r 2               
000E45r 2               ; ============================================================================
000E45r 2               ; Data
000E45r 2               ; ============================================================================
000E45r 2               ; LCD nibble (D7..D4 = bits 3..0) -> MCP GPIO bits.
000E45r 2               ; Wiring assumed literally as stated: GPIO5=D4, GPIO4=D5, GPIO3=D6, GPIO2=D7.
000E45r 2               ; If your wiring is actually GPIO2=D4 ... GPIO5=D7, replace this table with
000E45r 2               ; $00,$04,$08,$0C,$10,$14,$18,$1C,$20,$24,$28,$2C,$30,$34,$38,$3C
000E45r 2               nibble_tab:
000E45r 2  00 20 10 30          .byte   $00,$20,$10,$30,$08,$28,$18,$38
000E49r 2  08 28 18 38  
000E4Dr 2  04 24 14 34          .byte   $04,$24,$14,$34,$0C,$2C,$1C,$3C
000E51r 2  0C 2C 1C 3C  
000E55r 2               
000E55r 1               .include "basic_i2c.s"          ; I2CINIT/I2CWRITE/I2CREAD(), LCDINIT/PRINT/POS/CLS/CMD
000E55r 2               ; ============================================================================
000E55r 2               ; basic_i2c.s - EhBASIC statements and function for the PCF8584 I2C bridge and
000E55r 2               ;               the I2C LCD.  Glue between basic.s and pcf8584.s / lcd_i2c.s.
000E55r 2               ;
000E55r 2               ; NEW BASIC KEYWORDS (tokens are defined in basic.s, tokenized by EhBASIC):
000E55r 2               ;
000E55r 2               ;   I2CINIT                     initialise the PCF8584 (optional: done on first use)
000E55r 2               ;   I2CWRITE addr, b1 [,b2...]  write bytes to the device at 7-bit address "addr"
000E55r 2               ;                               (0-127, i.e. the datasheet address, NOT shifted).
000E55r 2               ;                               Up to 32 data bytes; none is allowed (address probe).
000E55r 2               ;                               A device that doesn't ACK gives "I2C Error".
000E55r 2               ;   x = I2CREAD(addr)           read ONE byte from 7-bit address "addr" (0-255).
000E55r 2               ;                               Returns -1 if the device doesn't answer, so it can
000E55r 2               ;                               be used to scan the bus without raising an error.
000E55r 2               ;
000E55r 2               ;   LCDINIT [addr]              (re)initialise the LCD (optional: done on first use).
000E55r 2               ;                               With addr (0-127) the LCD at that 7-bit I2C address is
000E55r 2               ;                               used from now on; plain LCDINIT goes back to the default
000E55r 2               ;                               address (MCP_ADDR_W in lcd_i2c.s, 0x20).
000E55r 2               ;   LCDPRINT s$                 write a string at the cursor
000E55r 2               ;   LCDPOS col, row             move the cursor (col 0-39, row 0-3)
000E55r 2               ;   LCDCLS                      clear the display
000E55r 2               ;   LCDCMD n                    send raw HD44780 command byte n (e.g. LCDCMD 12 =
000E55r 2               ;                               display on, cursor off; LCDCMD 15 = blinking cursor)
000E55r 2               ;
000E55r 2               ; Both the PCF8584 and the LCD are initialised automatically the first time they
000E55r 2               ; are needed.  Arguments are fully evaluated BEFORE the bus is touched, so a
000E55r 2               ; syntax error in a line never leaves the bus in the middle of a transfer.
000E55r 2               ; ============================================================================
000E55r 2               
000E55r 2               I2C_BUF_MAX = 32                    ; most data bytes in one I2CWRITE
000E55r 2               EH_ERR_I2C  = $24                   ; error code: "I2C Error" (see LAB_BAER in basic.s)
000E55r 2               
000E55r 2               .segment "BIOSVARS"
000013r 2  xx           i2c_n:      .res 1                  ; data bytes collected for I2CWRITE
000014r 2  xx           i2c_idx:    .res 1                  ; index while sending them
000015r 2  xx xx xx xx  i2c_buf:    .res I2C_BUF_MAX        ; the data bytes
000019r 2  xx xx xx xx  
00001Dr 2  xx xx xx xx  
000035r 2  xx           lcd_tmp:    .res 1                  ; argument scratch (LCDCMD / LCDPOS)
000036r 2  xx           lcd_row:    .res 1
000037r 2               
000037r 2               .segment "BIOS"
000E55r 2               
000E55r 2               ; ----------------------------------------------------------------------------
000E55r 2               ; I2C_BOOT - called from RESET: nothing is initialised yet
000E55r 2               ; ----------------------------------------------------------------------------
000E55r 2               I2C_BOOT:
000E55r 2  A9 00                lda     #0
000E57r 2  8D rr rr             sta     pcf_ready
000E5Ar 2  8D rr rr             sta     lcd_ready
000E5Dr 2  8D rr rr             sta     i2c_err
000E60r 2  A9 40                lda     #MCP_ADDR_W
000E62r 2  8D rr rr             sta     lcd_addr            ; default LCD address
000E65r 2  A9 00                lda     #0
000E67r 2  8D rr rr             sta     lcd_type            ; MCP23008
000E6Ar 2  60                   rts
000E6Br 2               
000E6Br 2               ; ----------------------------------------------------------------------------
000E6Br 2               ; common helpers
000E6Br 2               ; ----------------------------------------------------------------------------
000E6Br 2               BI_ERR:                             ; raise "I2C Error" (never returns)
000E6Br 2  A2 24                ldx     #EH_ERR_I2C
000E6Dr 2  4C rr rr             jmp     LAB_XERR
000E70r 2               
000E70r 2               BI_FC:                              ; raise "Function call Error" (never returns)
000E70r 2  4C rr rr             jmp     LAB_FCER
000E73r 2               
000E73r 2               BI_CHK:                             ; error if the last operation failed
000E73r 2  AD rr rr             lda     i2c_err
000E76r 2  D0 F3                bne     BI_ERR
000E78r 2  60                   rts
000E79r 2               
000E79r 2               pcf_ensure:                         ; make sure the PCF8584 is initialised
000E79r 2  AD rr rr             lda     pcf_ready
000E7Cr 2  D0 0A                bne     @ok
000E7Er 2  20 rr rr             jsr     pcf_init
000E81r 2  B0 E8                bcs     BI_ERR
000E83r 2  A9 01                lda     #1
000E85r 2  8D rr rr             sta     pcf_ready
000E88r 2  60           @ok:    rts
000E89r 2               
000E89r 2               lcd_ensure:                         ; make sure PCF8584 and LCD are initialised
000E89r 2  20 rr rr             jsr     pcf_ensure
000E8Cr 2  AD rr rr             lda     lcd_ready
000E8Fr 2  D0 14                bne     @ok
000E91r 2  A9 00                lda     #0
000E93r 2  8D rr rr             sta     i2c_err
000E96r 2  20 rr rr             jsr     lcd_init
000E99r 2  AD rr rr             lda     i2c_err
000E9Cr 2  F0 07                beq     @ok
000E9Er 2  A9 00                lda     #0
000EA0r 2  8D rr rr             sta     lcd_ready           ; failed: try the whole thing again next time
000EA3r 2  F0 C6                beq     BI_ERR              ; (always)
000EA5r 2  A9 00        @ok:    lda     #0
000EA7r 2  8D rr rr             sta     i2c_err             ; start the caller's operation with no error
000EAAr 2  60                   rts
000EABr 2               
000EABr 2               ; ----------------------------------------------------------------------------
000EABr 2               ; I2CINIT
000EABr 2               ; ----------------------------------------------------------------------------
000EABr 2               BI_I2CINIT:
000EABr 2  A9 00                lda     #0
000EADr 2  8D rr rr             sta     pcf_ready
000EB0r 2  4C rr rr             jmp     pcf_ensure
000EB3r 2               
000EB3r 2               ; ----------------------------------------------------------------------------
000EB3r 2               ; I2CWRITE addr, b1 [, b2 ...]
000EB3r 2               ; ----------------------------------------------------------------------------
000EB3r 2               BI_I2CWRITE:
000EB3r 2  20 rr rr             jsr     LAB_GTBY            ; X = 7 bit address
000EB6r 2  E0 80                cpx     #$80
000EB8r 2  B0 B6                bcs     BI_FC
000EBAr 2  8A                   txa
000EBBr 2  0A                   asl
000EBCr 2  8D rr rr             sta     i2c_addr            ; address byte, R/W = 0
000EBFr 2  A9 00                lda     #0
000EC1r 2  8D rr rr             sta     i2c_n
000EC4r 2  20 C2 00     @more:  jsr     LAB_GBYT            ; next character
000EC7r 2  C9 2C                cmp     #','
000EC9r 2  D0 17                bne     @send
000ECBr 2  20 rr rr             jsr     LAB_1C01            ; step over ","
000ECEr 2  20 rr rr             jsr     LAB_GTBY            ; X = data byte
000ED1r 2  AC rr rr             ldy     i2c_n
000ED4r 2  C0 20                cpy     #I2C_BUF_MAX
000ED6r 2  B0 98                bcs     BI_FC               ; too many bytes
000ED8r 2  8A                   txa
000ED9r 2  99 rr rr             sta     i2c_buf,y
000EDCr 2  EE rr rr             inc     i2c_n
000EDFr 2  4C rr rr             jmp     @more
000EE2r 2  20 rr rr     @send:  jsr     pcf_ensure
000EE5r 2  20 rr rr             jsr     i2c_start
000EE8r 2  B0 20                bcs     @fail
000EEAr 2  A9 00                lda     #0
000EECr 2  8D rr rr             sta     i2c_idx
000EEFr 2  AD rr rr     @loop:  lda     i2c_idx
000EF2r 2  CD rr rr             cmp     i2c_n
000EF5r 2  F0 0F                beq     @done
000EF7r 2  AA                   tax
000EF8r 2  BD rr rr             lda     i2c_buf,x
000EFBr 2  20 rr rr             jsr     i2c_send
000EFEr 2  B0 0A                bcs     @fail
000F00r 2  EE rr rr             inc     i2c_idx
000F03r 2  4C rr rr             jmp     @loop
000F06r 2  20 rr rr     @done:  jsr     i2c_stop
000F09r 2  60                   rts
000F0Ar 2  20 rr rr     @fail:  jsr     i2c_stop
000F0Dr 2  4C rr rr             jmp     BI_ERR
000F10r 2               
000F10r 2               ; ----------------------------------------------------------------------------
000F10r 2               ; I2CREAD(addr) - function, FAC1 = address on entry (numeric pre-processing is
000F10r 2               ; done by the interpreter, see LAB_FTPL); result in FAC1
000F10r 2               ; ----------------------------------------------------------------------------
000F10r 2               BI_I2CRD:
000F10r 2  20 rr rr             jsr     LAB_F2FX            ; integer part of FAC1 -> Itempl/Itemph
000F13r 2  A5 12                lda     Itemph
000F15r 2  D0 1D                bne     @fc
000F17r 2  A5 11                lda     Itempl
000F19r 2  C9 80                cmp     #$80
000F1Br 2  B0 17                bcs     @fc
000F1Dr 2  0A                   asl
000F1Er 2  09 01                ora     #1                  ; address byte, R/W = 1
000F20r 2  8D rr rr             sta     i2c_addr
000F23r 2  20 rr rr             jsr     pcf_ensure
000F26r 2  20 rr rr             jsr     i2c_read1
000F29r 2  B0 04                bcs     @none
000F2Br 2  A8                   tay                         ; byte -> Y
000F2Cr 2  4C rr rr             jmp     LAB_1FD0            ; convert Y to a number in FAC1 and return
000F2Fr 2  A9 FF        @none:  lda     #$FF
000F31r 2  4C rr rr             jmp     LAB_27DB            ; save A as signed integer byte: -1
000F34r 2  4C rr rr     @fc:    jmp     LAB_FCER
000F37r 2               
000F37r 2               ; ----------------------------------------------------------------------------
000F37r 2               ; LCDINIT
000F37r 2               ; ----------------------------------------------------------------------------
000F37r 2               BI_LCDINIT:
000F37r 2  A9 00                lda     #0
000F39r 2  8D rr rr             sta     lcd_type            ; default: MCP23008
000F3Cr 2  20 C2 00             jsr     LAB_GBYT            ; anything after the keyword?
000F3Fr 2  F0 20                beq     @default            ; no: use the default address
000F41r 2  20 rr rr             jsr     LAB_GTBY            ; X = 7 bit I2C address
000F44r 2  E0 80                cpx     #$80
000F46r 2  B0 27                bcs     @fc
000F48r 2  8A                   txa
000F49r 2  0A                   asl
000F4Ar 2  48                   pha                         ; keep the address byte
000F4Br 2  20 C2 00             jsr     LAB_GBYT            ; optional ", type"
000F4Er 2  F0 0D                beq     @notype
000F50r 2  20 rr rr             jsr     LAB_1C01            ; scan for ","
000F53r 2  20 rr rr             jsr     LAB_GTBY            ; X = 0 (MCP23008) or 1 (PCF8574)
000F56r 2  E0 02                cpx     #2
000F58r 2  B0 14                bcs     @fc2
000F5Ar 2  8E rr rr             stx     lcd_type
000F5Dr 2               @notype:
000F5Dr 2  68                   pla
000F5Er 2  4C rr rr             jmp     @set
000F61r 2               @default:
000F61r 2  A9 40                lda     #MCP_ADDR_W
000F63r 2  8D rr rr     @set:   sta     lcd_addr
000F66r 2  A9 00                lda     #0
000F68r 2  8D rr rr             sta     lcd_ready
000F6Br 2  4C rr rr             jmp     lcd_ensure
000F6Er 2  68           @fc2:   pla
000F6Fr 2  4C rr rr     @fc:    jmp     LAB_FCER
000F72r 2               
000F72r 2               ; ----------------------------------------------------------------------------
000F72r 2               ; LCDPRINT s$
000F72r 2               ; ----------------------------------------------------------------------------
000F72r 2               BI_LCDPRINT:
000F72r 2  20 rr rr             jsr     LAB_EVEX            ; evaluate expression at the BASIC pointer
000F75r 2  20 rr rr             jsr     LAB_EVST            ; must be a string (else ?Type mismatch);
000F78r 2                                                   ; A = length, (ut1_pl) -> characters
000F78r 2  8D rr rr             sta     lcd_len
000F7Br 2  A5 71                lda     ut1_pl
000F7Dr 2  85 rr                sta     strptr
000F7Fr 2  A5 72                lda     ut1_ph
000F81r 2  85 rr                sta     strptr+1
000F83r 2  20 rr rr             jsr     lcd_ensure
000F86r 2  20 rr rr             jsr     lcd_putbuf
000F89r 2  4C rr rr             jmp     BI_CHK
000F8Cr 2               
000F8Cr 2               ; ----------------------------------------------------------------------------
000F8Cr 2               ; LCDPOS col, row
000F8Cr 2               ; ----------------------------------------------------------------------------
000F8Cr 2               BI_LCDPOS:
000F8Cr 2  20 rr rr             jsr     LAB_GTBY            ; X = column
000F8Fr 2  E0 28                cpx     #40
000F91r 2  B0 25                bcs     @fc
000F93r 2  8E rr rr             stx     lcd_tmp
000F96r 2  20 rr rr             jsr     LAB_1C01            ; scan for ","
000F99r 2  20 rr rr             jsr     LAB_GTBY            ; X = row
000F9Cr 2  E0 04                cpx     #4
000F9Er 2  B0 18                bcs     @fc
000FA0r 2  BD rr rr             lda     row_tab,x
000FA3r 2  18                   clc
000FA4r 2  6D rr rr             adc     lcd_tmp
000FA7r 2  09 80                ora     #$80                ; "set DDRAM address" command
000FA9r 2  8D rr rr             sta     lcd_tmp
000FACr 2  20 rr rr             jsr     lcd_ensure
000FAFr 2  AD rr rr             lda     lcd_tmp
000FB2r 2  20 rr rr             jsr     lcd_cmd
000FB5r 2  4C rr rr             jmp     BI_CHK
000FB8r 2  4C rr rr     @fc:    jmp     LAB_FCER
000FBBr 2               
000FBBr 2               row_tab:
000FBBr 2  00 40 14 54          .byte   $00,$40,$14,$54     ; DDRAM start of rows 0-3 (16x2 uses the first two)
000FBFr 2               
000FBFr 2               ; ----------------------------------------------------------------------------
000FBFr 2               ; LCDCLS
000FBFr 2               ; ----------------------------------------------------------------------------
000FBFr 2               BI_LCDCLS:
000FBFr 2  20 rr rr             jsr     lcd_ensure
000FC2r 2  20 rr rr             jsr     lcd_clear
000FC5r 2  4C rr rr             jmp     BI_CHK
000FC8r 2               
000FC8r 2               ; ----------------------------------------------------------------------------
000FC8r 2               ; LCDCMD n
000FC8r 2               ; ----------------------------------------------------------------------------
000FC8r 2               BI_LCDCMD:
000FC8r 2  20 rr rr             jsr     LAB_GTBY            ; X = command byte
000FCBr 2  8E rr rr             stx     lcd_tmp
000FCEr 2  20 rr rr             jsr     lcd_ensure
000FD1r 2  AD rr rr             lda     lcd_tmp
000FD4r 2  20 rr rr             jsr     lcd_cmd
000FD7r 2  AD rr rr             lda     lcd_tmp
000FDAr 2  C9 04                cmp     #4                  ; clear / home need ~1.6 ms
000FDCr 2  B0 05                bcs     @nodly
000FDEr 2  A9 03                lda     #3
000FE0r 2  20 rr rr             jsr     delay_ms
000FE3r 2  4C rr rr     @nodly: jmp     BI_CHK
000FE6r 2               
000FE6r 1               .include "gamepad.s"            ; NES gamepad on the VIA    (BIOS, BIOSVARS)
000FE6r 2               ; ============================================================================
000FE6r 2               ; gamepad.s - NES style gamepad on the 65C22 VIA, typed into the input buffer
000FE6r 2               ;
000FE6r 2               ; The pad is read 60 times a second from the VIA's timer 1 interrupt (IRQ2).
000FE6r 2               ; Every new button press puts the character assigned to that button into the
000FE6r 2               ; same input buffer the keyboard and serial port use, so BASIC (GET, INPUT)
000FE6r 2               ; and the monitor see it as if it had been typed.  A held button repeats like
000FE6r 2               ; a keyboard key.
000FE6r 2               ;
000FE6r 2               ; WIRING (VIA port A; change the three PAD_..._BIT masks below if you wire it
000FE6r 2               ; differently).  The pad's +5V and GND go to the supply:
000FE6r 2               ;       PA0  <-  DATA   (pad pin "Data", needs a pull-up resistor, 10k to +5V)
000FE6r 2               ;       PA1  ->  LATCH
000FE6r 2               ;       PA2  ->  CLOCK
000FE6r 2               ; The other port A pins are left alone.
000FE6r 2               ;
000FE6r 2               ; BUTTON NUMBERS (the order the pad shifts them out):
000FE6r 2               ;       0 = A        1 = B        2 = Select    3 = Start
000FE6r 2               ;       4 = Up       5 = Down     6 = Left      7 = Right
000FE6r 2               ;
000FE6r 2               ; DEFAULT CHARACTERS:  Up W, Down S, Left A, Right D (upper case), A = space; B, Select and
000FE6r 2               ; Start are not assigned (0).  Change them from BASIC with
000FE6r 2               ;       PADKEY button, char        e.g.  PADKEY 1, 13    (B = Enter)
000FE6r 2               ;                                        PADKEY 4, ASC("W")
000FE6r 2               ;       PADKEY                     restore the defaults
000FE6r 2               ; char 0 switches a button off.  Or edit pad_defaults below.
000FE6r 2               ; ============================================================================
000FE6r 2               
000FE6r 2               PAD_ENABLE       = 1                ; 0 = leave the VIA alone, no pad support
000FE6r 2               PAD_DATA_BIT     = $01              ; PA0
000FE6r 2               PAD_LATCH_BIT    = $02              ; PA1
000FE6r 2               PAD_CLOCK_BIT    = $04              ; PA2
000FE6r 2               PAD_HZ           = 60               ; polls per second
000FE6r 2               PAD_REPEAT_DELAY = 20               ; polls (1/60 s) before a held button repeats
000FE6r 2               PAD_REPEAT_RATE  = 6                ; polls between repeats (0 = no repeat)
000FE6r 2               PAD_T1           = (CPU_MHZ * 1000000) / PAD_HZ - 2
000FE6r 2               .assert PAD_T1 > 0 .and PAD_T1 < 65536, error, "CPU_MHZ too high for the 16 bit VIA timer at 60 Hz"
000FE6r 2               
000FE6r 2               VIA_T1CL         = $7F04            ; timer 1 counter low  (reading clears its flag)
000FE6r 2               VIA_T1CH         = $7F05            ; timer 1 counter high (writing starts it)
000FE6r 2               VIA_T1LL         = $7F06            ; timer 1 latch low
000FE6r 2               VIA_ACR          = $7F0B            ; auxiliary control register
000FE6r 2               
000FE6r 2               .segment "BIOSVARS"
000037r 2  xx xx xx xx  pad_map:    .res 8                  ; character for each button (0 = none)
00003Br 2  xx xx xx xx  
00003Fr 2  xx           pad_prev:   .res 1                  ; buttons down at the previous poll
000040r 2  xx           pad_now:    .res 1                  ; buttons down now (bit n = button n)
000041r 2  xx           pad_last:   .res 1                  ; buttons that are auto-repeating
000042r 2  xx           pad_cnt:    .res 1                  ; polls until the next repeat
000043r 2  xx           pad_new:    .res 1
000044r 2  xx           pad_tmp:    .res 1
000045r 2               
000045r 2               .segment "BIOS"
000FE6r 2               
000FE6r 2               ; ----------------------------------------------------------------------------
000FE6r 2               ; PAD_INIT - called from RESET after INIT_IO.  Clobbers A.
000FE6r 2               ; ----------------------------------------------------------------------------
000FE6r 2               PAD_INIT:
000FE6r 2  20 rr rr             jsr     PAD_DEFAULTS
000FE9r 2  A9 00                lda     #0
000FEBr 2  8D rr rr             sta     pad_prev
000FEEr 2  8D rr rr             sta     pad_last
000FF1r 2  8D rr rr             sta     pad_cnt
000FF4r 2  A9 01                lda     #PAD_ENABLE         ; 0 = no gamepad support: leave the VIA alone
000FF6r 2  F0 2B                beq     @off
000FF8r 2  AD 01 7F             lda     PORTA               ; latch and clock idle low
000FFBr 2  29 F9                and     #($FF ^ (PAD_LATCH_BIT | PAD_CLOCK_BIT))
000FFDr 2  8D 01 7F             sta     PORTA
001000r 2  AD 03 7F             lda     DDRA                ; latch + clock are outputs, data an input
001003r 2  09 06                ora     #(PAD_LATCH_BIT | PAD_CLOCK_BIT)
001005r 2  29 FE                and     #($FF ^ PAD_DATA_BIT)
001007r 2  8D 03 7F             sta     DDRA
00100Ar 2  AD 0B 7F             lda     VIA_ACR             ; timer 1 free running, interrupt on timeout
00100Dr 2  29 3F                and     #$3F
00100Fr 2  09 40                ora     #$40
001011r 2  8D 0B 7F             sta     VIA_ACR
001014r 2  A9 33                lda     #<PAD_T1
001016r 2  8D 06 7F             sta     VIA_T1LL
001019r 2  A9 82                lda     #>PAD_T1
00101Br 2  8D 05 7F             sta     VIA_T1CH            ; loads the counter and starts it
00101Er 2  A9 C0                lda     #$C0                ; enable the timer 1 interrupt
001020r 2  8D 0E 7F             sta     IER
001023r 2  60           @off:   rts
001024r 2               
001024r 2               ; PAD_STATE - for the fixed jump table: A = buttons held right now
001024r 2               PAD_STATE:
001024r 2  AD rr rr             lda     pad_now
001027r 2  60                   rts
001028r 2               
001028r 2               ; Restore the default button characters
001028r 2               PAD_DEFAULTS:
001028r 2  A2 07                ldx     #7
00102Ar 2  BD rr rr     @l:     lda     pad_defaults,x
00102Dr 2  9D rr rr             sta     pad_map,x
001030r 2  CA                   dex
001031r 2  10 F7                bpl     @l
001033r 2  60                   rts
001034r 2               
001034r 2               pad_defaults:
001034r 2  20                   .byte   ' '                 ; 0 A
001035r 2  00                   .byte   0                   ; 1 B
001036r 2  00                   .byte   0                   ; 2 Select
001037r 2  00                   .byte   0                   ; 3 Start
001038r 2  57                   .byte   'W'                 ; 4 Up
001039r 2  53                   .byte   'S'                 ; 5 Down
00103Ar 2  41                   .byte   'A'                 ; 6 Left
00103Br 2  44                   .byte   'D'                 ; 7 Right
00103Cr 2               
00103Cr 2               ; ----------------------------------------------------------------------------
00103Cr 2               ; PAD_POLL - read the pad and queue characters.  Called from the IRQ handler
00103Cr 2               ; (registers are already saved there).
00103Cr 2               ; ----------------------------------------------------------------------------
00103Cr 2               PAD_POLL:
00103Cr 2  AD 01 7F             lda     PORTA               ; latch pulse: the pad's shift register
00103Fr 2  09 02                ora     #PAD_LATCH_BIT      ; loads the 8 button states
001041r 2  8D 01 7F             sta     PORTA
001044r 2  20 rr rr             jsr     pad_wait
001047r 2  AD 01 7F             lda     PORTA
00104Ar 2  29 FD                and     #($FF ^ PAD_LATCH_BIT)
00104Cr 2  8D 01 7F             sta     PORTA
00104Fr 2  A2 08                ldx     #8
001051r 2  AD 01 7F     @bit:   lda     PORTA               ; data line is LOW while a button is down
001054r 2  29 01                and     #PAD_DATA_BIT
001056r 2  C9 01                cmp     #1                  ; carry = 1 when the line is high (not pressed)
001058r 2  6E rr rr             ror     pad_now             ; first button ends up in bit 0
00105Br 2  AD 01 7F             lda     PORTA
00105Er 2  09 04                ora     #PAD_CLOCK_BIT      ; clock pulse: shift to the next button
001060r 2  8D 01 7F             sta     PORTA
001063r 2  20 rr rr             jsr     pad_wait
001066r 2  AD 01 7F             lda     PORTA
001069r 2  29 FB                and     #($FF ^ PAD_CLOCK_BIT)
00106Br 2  8D 01 7F             sta     PORTA
00106Er 2  20 rr rr             jsr     pad_wait
001071r 2  CA                   dex
001072r 2  D0 DD                bne     @bit
001074r 2  AD rr rr             lda     pad_now
001077r 2  49 FF                eor     #$FF                ; now bit = 1 when the button is down
001079r 2  C9 FF                cmp     #$FF
00107Br 2  D0 02                bne     @ok
00107Dr 2  A9 00                lda     #0                  ; all 8 down = nothing plugged in
00107Fr 2  8D rr rr     @ok:    sta     pad_now
001082r 2               
001082r 2  AD rr rr             lda     pad_prev            ; buttons newly pressed
001085r 2  49 FF                eor     #$FF
001087r 2  2D rr rr             and     pad_now
00108Ar 2  8D rr rr             sta     pad_new
00108Dr 2  F0 11                beq     @held
00108Fr 2  8D rr rr             sta     pad_last            ; they are the ones that repeat
001092r 2  A9 14                lda     #PAD_REPEAT_DELAY
001094r 2  8D rr rr             sta     pad_cnt
001097r 2  AD rr rr             lda     pad_new
00109Ar 2  20 rr rr             jsr     pad_emit
00109Dr 2  4C rr rr             jmp     @done
0010A0r 2  AD rr rr     @held:  lda     pad_last
0010A3r 2  F0 24                beq     @done               ; nothing to repeat
0010A5r 2  2D rr rr             and     pad_now
0010A8r 2  8D rr rr             sta     pad_last            ; drop released buttons
0010ABr 2  F0 1C                beq     @done
0010ADr 2  A9 06                lda     #PAD_REPEAT_RATE    ; 0 = no auto repeat
0010AFr 2  F0 13                beq     @norep
0010B1r 2  CE rr rr             dec     pad_cnt
0010B4r 2  D0 13                bne     @done
0010B6r 2  A9 06                lda     #PAD_REPEAT_RATE
0010B8r 2  8D rr rr             sta     pad_cnt
0010BBr 2  AD rr rr             lda     pad_last
0010BEr 2  20 rr rr             jsr     pad_emit
0010C1r 2  4C rr rr             jmp     @done
0010C4r 2  A9 00        @norep: lda     #0
0010C6r 2  8D rr rr             sta     pad_last
0010C9r 2  AD rr rr     @done:  lda     pad_now
0010CCr 2  8D rr rr             sta     pad_prev
0010CFr 2  60                   rts
0010D0r 2               
0010D0r 2               ; short delay for the pad's slow shift register (about 5 us at any clock)
0010D0r 2               pad_wait:
0010D0r 2  A0 02                ldy     #CPU_MHZ
0010D2r 2  88           @l:     dey
0010D3r 2  D0 FD                bne     @l
0010D5r 2  60                   rts
0010D6r 2               
0010D6r 2               ; pad_emit - A = mask of buttons: queue the character of each one
0010D6r 2               pad_emit:
0010D6r 2  8D rr rr             sta     pad_tmp
0010D9r 2  A0 00                ldy     #0
0010DBr 2  4E rr rr     @l:     lsr     pad_tmp
0010DEr 2  90 17                bcc     @next
0010E0r 2  B9 rr rr             lda     pad_map,y
0010E3r 2  F0 12                beq     @next               ; button not assigned
0010E5r 2  48                   pha
0010E6r 2  A5 rr                lda     WRITE_PTR           ; keep clear of a full buffer
0010E8r 2  38                   sec
0010E9r 2  E5 rr                sbc     READ_PTR
0010EBr 2  C9 F0                cmp     #$F0
0010EDr 2  B0 07                bcs     @drop
0010EFr 2  68                   pla
0010F0r 2  20 rr rr             jsr     WRITE_BUFFER        ; (uses X, not Y)
0010F3r 2  4C rr rr             jmp     @next
0010F6r 2  68           @drop:  pla
0010F7r 2  C8           @next:  iny
0010F8r 2  C0 08                cpy     #8
0010FAr 2  D0 DF                bne     @l
0010FCr 2  60                   rts
0010FDr 2               
0010FDr 2               ; ----------------------------------------------------------------------------
0010FDr 2               ; PADKEY button, char   (BASIC statement)      PADKEY alone = defaults
0010FDr 2               ; ----------------------------------------------------------------------------
0010FDr 2               BI_PADKEY:
0010FDr 2  20 C2 00             jsr     LAB_GBYT
001100r 2  D0 03                bne     @set
001102r 2  4C rr rr             jmp     PAD_DEFAULTS
001105r 2  20 rr rr     @set:   jsr     LAB_GTBY            ; X = button 0-7
001108r 2  E0 08                cpx     #8
00110Ar 2  B0 0F                bcs     @fc
00110Cr 2  8A                   txa
00110Dr 2  48                   pha
00110Er 2  20 rr rr             jsr     LAB_1C01            ; ","
001111r 2  20 rr rr             jsr     LAB_GTBY            ; X = character code 0-255
001114r 2  68                   pla
001115r 2  A8                   tay
001116r 2  8A                   txa
001117r 2  99 rr rr             sta     pad_map,y
00111Ar 2  60                   rts
00111Br 2  4C rr rr     @fc:    jmp     LAB_FCER
00111Er 2               
00111Er 1               .include "jumptable.s"          ; fixed entry points for your programs (JUMPTAB)
00111Er 2               ; ============================================================================
00111Er 2               ; jumptable.s - FIXED entry points for programs you load with the monitor
00111Er 2               ;
00111Er 2               ; The addresses of the BIOS routines move every time the ROM is rebuilt, so a
00111Er 2               ; program that you assemble separately (and load with  L NAME ADDR  or
00111Er 2               ; LOADRAW) must not call them directly.  This table is always at $FE00 and
00111Er 2               ; every entry is a 3 byte JMP, so  JSR $FE03  always means "print a character".
00111Er 2               ; sbc_api.inc has the same addresses as ca65 equates for your own programs.
00111Er 2               ;
00111Er 2               ;   $FE00  JT_CHRIN      get a character: carry set + A = character, or carry
00111Er 2               ;                        clear if nothing is waiting (keyboard, serial, gamepad)
00111Er 2               ;   $FE03  JT_CHROUT     print the character in A (A, X and Y are preserved)
00111Er 2               ;   $FE06  JT_MENU       back to the boot menu ([C]old [W]arm [M]onitor)
00111Er 2               ;   $FE09  JT_COLD       EhBASIC cold start
00111Er 2               ;   $FE0C  JT_WARM       EhBASIC warm start
00111Er 2               ;   $FE0F  JT_MONITOR    the monitor prompt (same as JMP $FF00)
00111Er 2               ;   $FE12  JT_PADSTATE   A = gamepad buttons held right now, bit n = button n
00111Er 2               ;                        (0=A 1=B 2=Select 3=Start 4=Up 5=Down 6=Left 7=Right)
00111Er 2               ;                        Only registers A and flags are changed.
00111Er 2               ;   $FE15  JT_LOAD       load a whole file from the USB drive into RAM, silently
00111Er 2               ;                        (A/Y = parameter block, see SBC_LOAD in monitor_cmds.s)
00111Er 2               ; Add new entries at the END so the old addresses never change.
00111Er 2               ; ============================================================================
00111Er 2               .segment "JUMPTAB"
000000r 2  4C rr rr     JT_CHRIN:       jmp     CHRIN
000003r 2  4C rr rr     JT_CHROUT:      jmp     CHROUT
000006r 2  4C rr rr     JT_MENU:        jmp     MENU
000009r 2  4C rr rr     JT_COLD:        jmp     LAB_COLD
00000Cr 2  4C 00 00     JT_WARM:        jmp     LAB_WARM
00000Fr 2  4C rr rr     JT_MONITOR:     jmp     WOZ_ENTRY
000012r 2  4C rr rr     JT_PADSTATE:    jmp     PAD_STATE
000015r 2  4C rr rr     JT_LOAD:        jmp     SBC_LOAD
000018r 2  4C rr rr     JT_CWD:         jmp     sbc_cwd         ; $FE18  (new, always last)
00001Br 2               
00001Br 2  A9 rr        sbc_cwd:        lda     #<mon_cwd       ; A/Y = the current folder
00001Dr 2  A0 rr                        ldy     #>mon_cwd
00001Fr 2  60                           rts
000020r 2               
000020r 1               .include "wozmon.s"             ; monitor                   (WOZMON)
000020r 2               ; ============================================================================
000020r 2               ; wozmon.s - Woz monitor, adapted for this SBC (segment WOZMON = $FF00 in sbc.cfg)
000020r 2               ;
000020r 2               ; Entered from the boot menu ([M]) or from BASIC with  CALL 65280  ($FF00).
000020r 2               ; CTRL-C at the monitor prompt returns to the boot menu.
000020r 2               ; Typing lower case is fine: letters are converted to upper case on input.
000020r 2               ;
000020r 2               ;   XXXX            examine address          XXXX.YYYY   examine a range
000020r 2               ;   XXXX: AA BB ..  store bytes              XXXXR       run program at XXXX
000020r 2               ;   ?               list commands            L NAME [XXXX]  load NAME.BIN (monitor_cmds.s)
000020r 2               ; ============================================================================
000020r 2               .segment "WOZMON"
000000r 2               
000000r 2               XAML            = $24                   ; Last "opened" location Low
000000r 2               XAMH            = $25                   ; Last "opened" location High
000000r 2               STL             = $26                   ; Store address Low
000000r 2               STH             = $27                   ; Store address High
000000r 2               L               = $28                   ; Hex value parsing Low
000000r 2               H               = $29                   ; Hex value parsing High
000000r 2               YSAV            = $2A                   ; Used to see if hex value is given
000000r 2               MODE            = $2B                   ; $00=XAM, $7F=STOR, $AE=BLOCK XAM
000000r 2               
000000r 2               IN              = $0200                 ; Input buffer (128 bytes, $0200-$027F)
000000r 2               
000000r 2               ; WOZ_ENTRY must stay the first thing in this segment: it is at $FF00.
000000r 2               WOZ_ENTRY:
000000r 2  D8                           CLD                     ; Clear decimal arithmetic mode.
000001r 2  58                           CLI
000002r 2  A2 FF                        LDX     #$FF
000004r 2  9A                           TXS                     ; Empty the stack
000005r 2  4C rr rr                     JMP     ESCAPE          ; print the backslash prompt, start a new line
000008r 2               
000008r 2               
000008r 2               NOTCR:
000008r 2  C9 08                        CMP     #$08            ; Backspace key?
00000Ar 2  F0 18                        BEQ     BACKSPACE       ; Yes.
00000Cr 2  C9 1B                        CMP     #$1B            ; ESC?
00000Er 2  F0 03                        BEQ     ESCAPE          ; Yes.
000010r 2  C8                           INY                     ; Advance text index.
000011r 2  10 14                        BPL     NEXTCHAR        ; Auto ESC if line longer than 127.
000013r 2               
000013r 2               ESCAPE:
000013r 2  A9 5C                        LDA     #$5C            ; "\".
000015r 2  20 rr rr                     JSR     ECHO            ; Output it.
000018r 2               
000018r 2               GETLINE:
000018r 2  A9 0D                        LDA     #$0D            ; Send CR
00001Ar 2  20 rr rr                     JSR     ECHO
00001Dr 2  A9 0A                        LDA     #$0A            ; Send LF
00001Fr 2  20 rr rr                     JSR     ECHO
000022r 2               
000022r 2  A0 01                        LDY     #$01            ; Initialize text index.
000024r 2  88           BACKSPACE:      DEY                     ; Back up text index.
000025r 2  30 F1                        BMI     GETLINE         ; Beyond start of line, reinitialize.
000027r 2               
000027r 2               NEXTCHAR:
000027r 2  20 rr rr                     JSR     WOZ_GETC        ; Wait for a key (upper-cased, CTRL-C -> menu)
00002Ar 2  99 00 02                     STA     IN,Y            ; Add to text buffer.
00002Dr 2  20 rr rr                     JSR     ECHO            ; Echo it (CHRIN doesn't echo).
000030r 2  C9 0D                        CMP     #$0D            ; CR?
000032r 2  D0 D4                        BNE     NOTCR           ; No.
000034r 2               
000034r 2  20 rr rr                     JSR     MON_HOOK        ; extra commands (monitor_cmds.s)
000037r 2  B0 DF                        BCS     GETLINE         ; carry set: it was one of ours
000039r 2               
000039r 2  A0 FF                        LDY     #$FF            ; Reset text index.
00003Br 2  A9 00                        LDA     #$00            ; For XAM mode.
00003Dr 2  AA                           TAX                     ; X=0.
00003Er 2               SETBLOCK:
00003Er 2  0A                           ASL
00003Fr 2               SETSTOR:
00003Fr 2  0A                           ASL                     ; Leaves $7B if setting STOR mode.
000040r 2               SETMODE:
000040r 2  85 2B                        STA     MODE            ; $00 = XAM, $74 = STOR, $B8 = BLOK XAM.
000042r 2               BLSKIP:
000042r 2  C8                           INY                     ; Advance text index.
000043r 2               NEXTITEM:
000043r 2  B9 00 02                     LDA     IN,Y            ; Get character.
000046r 2  C9 0D                        CMP     #$0D            ; CR?
000048r 2  F0 CE                        BEQ     GETLINE         ; Yes, done this line.
00004Ar 2  C9 2E                        CMP     #$2E            ; "."?
00004Cr 2  90 F4                        BCC     BLSKIP          ; Skip delimiter.
00004Er 2  F0 EE                        BEQ     SETBLOCK        ; Set BLOCK XAM mode.
000050r 2  C9 3A                        CMP     #$3A            ; ":"?
000052r 2  F0 EB                        BEQ     SETSTOR         ; Yes, set STOR mode.
000054r 2  C9 52                        CMP     #$52            ; "R"?
000056r 2  F0 3B                        BEQ     RUNPROG         ; Yes, run user program.
000058r 2  86 28                        STX     L               ; $00 -> L.
00005Ar 2  86 29                        STX     H               ;    and H.
00005Cr 2  84 2A                        STY     YSAV            ; Save Y for comparison
00005Er 2               
00005Er 2               NEXTHEX:
00005Er 2  B9 00 02                     LDA     IN,Y            ; Get character for hex test.
000061r 2  49 30                        EOR     #$30            ; Map digits to $0-9.
000063r 2  C9 0A                        CMP     #$0A            ; Digit?
000065r 2  90 06                        BCC     DIG             ; Yes.
000067r 2  69 88                        ADC     #$88            ; Map letter "A"-"F" to $FA-FF.
000069r 2  C9 FA                        CMP     #$FA            ; Hex letter?
00006Br 2  90 11                        BCC     NOTHEX          ; No, character not hex.
00006Dr 2               DIG:
00006Dr 2  0A                           ASL
00006Er 2  0A                           ASL                     ; Hex digit to MSD of A.
00006Fr 2  0A                           ASL
000070r 2  0A                           ASL
000071r 2               
000071r 2  A2 04                        LDX     #$04            ; Shift count.
000073r 2               HEXSHIFT:
000073r 2  0A                           ASL                     ; Hex digit left, MSB to carry.
000074r 2  26 28                        ROL     L               ; Rotate into LSD.
000076r 2  26 29                        ROL     H               ; Rotate into MSD's.
000078r 2  CA                           DEX                     ; Done 4 shifts?
000079r 2  D0 F8                        BNE     HEXSHIFT        ; No, loop.
00007Br 2  C8                           INY                     ; Advance text index.
00007Cr 2  D0 E0                        BNE     NEXTHEX         ; Always taken. Check next character for hex.
00007Er 2               
00007Er 2               NOTHEX:
00007Er 2  C4 2A                        CPY     YSAV            ; Check if L, H empty (no hex digits).
000080r 2  F0 91                        BEQ     ESCAPE          ; Yes, generate ESC sequence.
000082r 2               
000082r 2  24 2B                        BIT     MODE            ; Test MODE byte.
000084r 2  50 10                        BVC     NOTSTOR         ; B6=0 is STOR, 1 is XAM and BLOCK XAM.
000086r 2               
000086r 2  A5 28                        LDA     L               ; LSD's of hex data.
000088r 2  81 26                        STA     (STL,X)         ; Store current 'store index'.
00008Ar 2  E6 26                        INC     STL             ; Increment store index.
00008Cr 2  D0 B5                        BNE     NEXTITEM        ; Get next item (no carry).
00008Er 2  E6 27                        INC     STH             ; Add carry to 'store index' high order.
000090r 2  4C rr rr     TONEXTITEM:     JMP     NEXTITEM        ; Get next command item.
000093r 2               
000093r 2               RUNPROG:
000093r 2  6C 24 00                     JMP     (XAML)          ; Run at current XAM index.
000096r 2               
000096r 2               NOTSTOR:
000096r 2  30 30                        BMI     XAMNEXT         ; B7 = 0 for XAM, 1 for BLOCK XAM.
000098r 2               
000098r 2  A2 02                        LDX     #$02            ; Byte count.
00009Ar 2  B5 27        SETADR:         LDA     L-1,X           ; Copy hex data to
00009Cr 2  95 25                        STA     STL-1,X         ;  'store index'.
00009Er 2  95 23                        STA     XAML-1,X        ; And to 'XAM index'.
0000A0r 2  CA                           DEX                     ; Next of 2 bytes.
0000A1r 2  D0 F7                        BNE     SETADR          ; Loop unless X = 0.
0000A3r 2               
0000A3r 2               NXTPRNT:
0000A3r 2  D0 19                        BNE     PRDATA          ; NE means no address to print.
0000A5r 2  A9 0D                        LDA     #$0D            ; CR.
0000A7r 2  20 rr rr                     JSR     ECHO            ; Output it.
0000AAr 2  A9 0A                        LDA     #$0A            ; LF.
0000ACr 2  20 rr rr                     JSR     ECHO            ; Output it.
0000AFr 2  A5 25                        LDA     XAMH            ; 'Examine index' high-order byte.
0000B1r 2  20 rr rr                     JSR     PRBYTE          ; Output it in hex format.
0000B4r 2  A5 24                        LDA     XAML            ; Low-order 'examine index' byte.
0000B6r 2  20 rr rr                     JSR     PRBYTE          ; Output it in hex format.
0000B9r 2  A9 3A                        LDA     #$3A            ; ":".
0000BBr 2  20 rr rr                     JSR     ECHO            ; Output it.
0000BEr 2               
0000BEr 2               PRDATA:
0000BEr 2  A9 20                        LDA     #$20            ; Blank.
0000C0r 2  20 rr rr                     JSR     ECHO            ; Output it.
0000C3r 2  A1 24                        LDA     (XAML,X)        ; Get data byte at 'examine index'.
0000C5r 2  20 rr rr                     JSR     PRBYTE          ; Output it in hex format.
0000C8r 2  86 2B        XAMNEXT:        STX     MODE            ; 0 -> MODE (XAM mode).
0000CAr 2  A5 24                        LDA     XAML
0000CCr 2  C5 28                        CMP     L               ; Compare 'examine index' to hex data.
0000CEr 2  A5 25                        LDA     XAMH
0000D0r 2  E5 29                        SBC     H
0000D2r 2  B0 BC                        BCS     TONEXTITEM      ; Not less, so no more data to output.
0000D4r 2               
0000D4r 2  E6 24                        INC     XAML
0000D6r 2  D0 02                        BNE     MOD8CHK         ; Increment 'examine index'.
0000D8r 2  E6 25                        INC     XAMH
0000DAr 2               
0000DAr 2               MOD8CHK:
0000DAr 2  A5 24                        LDA     XAML            ; Check low-order 'examine index' byte
0000DCr 2  29 07                        AND     #$07            ; For MOD 8 = 0
0000DEr 2  10 C3                        BPL     NXTPRNT         ; Always taken.
0000E0r 2               
0000E0r 2               PRBYTE:
0000E0r 2  48                           PHA                     ; Save A for LSD.
0000E1r 2  4A                           LSR
0000E2r 2  4A                           LSR
0000E3r 2  4A                           LSR                     ; MSD to LSD position.
0000E4r 2  4A                           LSR
0000E5r 2  20 rr rr                     JSR     PRHEX           ; Output hex digit.
0000E8r 2  68                           PLA                     ; Restore A.
0000E9r 2               
0000E9r 2               PRHEX:
0000E9r 2  29 0F                        AND     #$0F            ; Mask LSD for hex print.
0000EBr 2  09 30                        ORA     #$30            ; Add "0".
0000EDr 2  C9 3A                        CMP     #$3A            ; Digit?
0000EFr 2  90 02                        BCC     ECHO            ; Yes, output it.
0000F1r 2  69 06                        ADC     #$06            ; Add offset for letter.
0000F3r 2               
0000F3r 2               ECHO:
0000F3r 2  4C rr rr                     JMP     CHROUT          ; Output it (CHROUT preserves A, X and Y).
0000F6r 2               
0000F6r 2               ; ----------------------------------------------------------------------------
0000F6r 2               ; WOZ_GETC lives in the BIOS segment: the WOZMON segment only has the 250 bytes
0000F6r 2               ; between $FF00 and the vectors at $FFFA.
0000F6r 2               ; ----------------------------------------------------------------------------
0000F6r 2               .segment "BIOS"
00111Er 2               ; Wait for a character.  Letters are converted to upper case (the monitor only
00111Er 2               ; understands upper case hex and "R").  CTRL-C goes back to the boot menu.
00111Er 2               ; Preserves X and Y.
00111Er 2               WOZ_GETC:
00111Er 2  20 rr rr                     JSR     CHRIN
001121r 2  90 FB                        BCC     WOZ_GETC
001123r 2  C9 03                        CMP     #$03            ; CTRL-C?
001125r 2  D0 03                        BNE     @notcc
001127r 2  4C rr rr                     JMP     MENU            ; Yes: back to the boot menu.
00112Ar 2  C9 61        @notcc:         CMP     #'a'
00112Cr 2  90 06                        BCC     @done
00112Er 2  C9 7B                        CMP     #'z'+1
001130r 2  B0 02                        BCS     @done
001132r 2  29 DF                        AND     #$DF            ; "a".."z" -> "A".."Z"
001134r 2  60           @done:          RTS
001135r 2               
001135r 1               .include "monitor_cmds.s"       ; monitor commands ? and L  (BIOS)
001135r 2               ; ============================================================================
001135r 2               ; monitor_cmds.s - extra wozmon commands
001135r 2               ;
001135r 2               ; wozmon.s calls MON_HOOK when Enter is pressed, before it parses the line.
001135r 2               ; MON_HOOK looks at the start of the line in the input buffer IN ($0200):
001135r 2               ;
001135r 2               ;   ?                   list the commands
001135r 2               ;   L                   list the files in the current directory of the USB drive
001135r 2               ;   L DIR               change into directory DIR     L ..  up one level
001135r 2               ;   L \  or  L /        back to the root directory     L A/B  several levels
001135r 2               ;   L NAME [XXXX]       load NAME.BIN (from the current directory) into RAM at XXXX.
001135r 2               ;                       Without XXXX the file goes to the last address used in
001135r 2               ;                       the monitor (type the address, Enter, then L NAME).
001135r 2               ;                       ".BIN" is added if NAME has no extension.
001135r 2               ;                       Allowed targets: $0500-$7EFF.  Afterwards the monitor's
001135r 2               ;                       current address is the load address, so  R  runs it.
001135r 2               ;
001135r 2               ; Returns carry set = line was a command and is finished, clear = not ours.
001135r 2               ; "L" and "?" are not hex digits so they never clash with wozmon's own syntax.
001135r 2               ; ============================================================================
001135r 2               .segment "BIOS"
001135r 2               
001135r 2               MON_LOAD_MIN = $0500
001135r 2               MON_LOAD_TOP = $7F00                ; first address that is NOT loadable (I/O)
001135r 2               
001135r 2               MON_HOOK:
001135r 2  AD 00 02             lda     IN
001138r 2  C9 3F                cmp     #'?'
00113Ar 2  D0 09                bne     @notq
00113Cr 2  A9 rr                lda     #<mon_help
00113Er 2  A0 rr                ldy     #>mon_help
001140r 2  20 rr rr             jsr     mon_puts
001143r 2  38                   sec
001144r 2  60                   rts
001145r 2  C9 4C        @notq:  cmp     #'L'
001147r 2  D0 0B                bne     @not
001149r 2  AC 01 02             ldy     IN+1
00114Cr 2  C0 0D                cpy     #$0D
00114Er 2  F0 06                beq     @dir
001150r 2  C0 20                cpy     #' '
001152r 2  F0 4E                beq     @load
001154r 2  18           @not:   clc
001155r 2  60                   rts
001156r 2               
001156r 2               ; ---- L : list the current directory -------------------------------------------
001156r 2  A9 01        @dir:   lda     #1
001158r 2  8D rr rr             sta     ch_mon
00115Br 2  20 rr rr             jsr     ch_prepare
00115Er 2  90 05                bcc     @lp
001160r 2  A9 F2                lda     #CH_E_NODISK
001162r 2  4C rr rr             jmp     ch_fail
001165r 2  20 rr rr     @lp:    jsr     mon_copy_cwd        ; X = length of the current directory
001168r 2  8E rr rr             stx     mon_end
00116Br 2  E0 00                cpx     #0
00116Dr 2  F0 0E                beq     @lroot
00116Fr 2  20 rr rr             jsr     mon_enter           ; open it, step by step (name "*" is then relative)
001172r 2  C9 41                cmp     #ERR_OPEN_DIR
001174r 2  F0 03                beq     @lrel
001176r 2  4C rr rr             jmp     ch_fail
001179r 2  A2 00        @lrel:  ldx     #0                  ; ch_name = "*"
00117Br 2  F0 07                beq     @lset
00117Dr 2  A2 01        @lroot: ldx     #1                  ; ch_name = "/*"
00117Fr 2  A9 2F                lda     #'/'
001181r 2  8D rr rr             sta     ch_name
001184r 2  A9 2A        @lset:  lda     #'*'
001186r 2  9D rr rr             sta     ch_name,x
001189r 2  A9 00                lda     #0
00118Br 2  9D rr rr             sta     ch_name+1,x
00118Er 2  20 rr rr             jsr     mon_showcwd         ; CR LF, "/GAMES"
001191r 2  A9 rr                lda     #<mon_crlf
001193r 2  A0 rr                ldy     #>mon_crlf
001195r 2  20 rr rr             jsr     mon_puts
001198r 2  20 rr rr             jsr     ch_dirlist
00119Br 2  A9 00                lda     #0
00119Dr 2  8D rr rr             sta     ch_mon
0011A0r 2  38                   sec
0011A1r 2  60                   rts
0011A2r 2               
0011A2r 2               ; ---- L PATH [XXXX] : change directory, or load a file ---------------------------
0011A2r 2               ; PATH is relative to the current directory; "..", ".", a leading "/" or "\"
0011A2r 2               ; and several parts ("GAMES/DEEP") are understood.  A PATH that names a directory
0011A2r 2               ; changes into it, anything else is a file (".BIN" is added when it has no ".").
0011A2r 2  A0 01        @load:  ldy     #1
0011A4r 2  B9 00 02     @sp1:   lda     IN,y                ; skip blanks
0011A7r 2  C9 20                cmp     #' '
0011A9r 2  D0 03                bne     @a1
0011ABr 2  C8                   iny
0011ACr 2  D0 F6                bne     @sp1
0011AEr 2  C9 0D        @a1:    cmp     #$0D
0011B0r 2  F0 A4                beq     @dir                ; "L   " = list
0011B2r 2  8C rr rr             sty     mon_y
0011B5r 2  20 rr rr             jsr     mon_path            ; ch_name = new path
0011B8r 2  90 03                bcc     @pok
0011BAr 2  4C rr rr             jmp     mon_badpath
0011BDr 2  AD rr rr     @pok:   lda     mon_kind
0011C0r 2  D0 5C                bne     @cd                 ; ends in "..", "." or "/": a directory
0011C2r 2  AD rr rr             lda     mon_x
0011C5r 2  F0 57                beq     @cd                 ; the root
0011C7r 2  AD rr rr             lda     mon_flag
0011CAr 2  D0 4C                bne     @tail               ; has a ".": a file
0011CCr 2  A9 01                lda     #1                  ; no ".": ask the drive what it is
0011CEr 2  8D rr rr             sta     ch_mon
0011D1r 2  20 rr rr             jsr     ch_prepare
0011D4r 2  90 05                bcc     @pr1
0011D6r 2  A9 F2                lda     #CH_E_NODISK
0011D8r 2  4C rr rr             jmp     ch_fail
0011DBr 2  20 rr rr     @pr1:   jsr     mon_open
0011DEr 2  C9 41                cmp     #ERR_OPEN_DIR
0011E0r 2  F0 0B                beq     @isdir
0011E2r 2  C9 14                cmp     #USB_INT_SUCCESS
0011E4r 2  F0 14                beq     @isfile
0011E6r 2  C9 42                cmp     #ERR_MISS_FILE
0011E8r 2  F0 18                beq     @addext
0011EAr 2  4C rr rr             jmp     ch_fail
0011EDr 2  A9 00        @isdir: lda     #0
0011EFr 2  20 rr rr             jsr     ch_file_close
0011F2r 2  A9 00                lda     #0
0011F4r 2  8D rr rr             sta     ch_mon
0011F7r 2  4C rr rr             jmp     @cd
0011FAr 2               @isfile:
0011FAr 2  A9 00                lda     #0
0011FCr 2  20 rr rr             jsr     ch_file_close
0011FFr 2  4C rr rr             jmp     @tail
001202r 2               @addext:
001202r 2  AE rr rr             ldx     mon_x               ; not found as typed: try  NAME.BIN
001205r 2  A0 00                ldy     #0
001207r 2  B9 rr rr     @e:     lda     mon_bin,y
00120Ar 2  9D rr rr             sta     ch_name,x
00120Dr 2  E8                   inx
00120Er 2  C8                   iny
00120Fr 2  C0 04                cpy     #4
001211r 2  D0 F4                bne     @e
001213r 2  A9 00                lda     #0
001215r 2  9D rr rr             sta     ch_name,x
001218r 2  AC rr rr     @tail:  ldy     mon_y               ; continue with the optional address
00121Br 2  4C rr rr             jmp     @addr
00121Er 2               
00121Er 2  AD rr rr     @cd:    lda     mon_x               ; the new directory is ch_name
001221r 2  C9 20                cmp     #32
001223r 2  B0 12                bcs     @cdbad              ; longer than 31 characters: cannot keep it
001225r 2  A2 00                ldx     #0
001227r 2  BD rr rr     @cc:    lda     ch_name,x
00122Ar 2  9D rr rr             sta     mon_cwd,x
00122Dr 2  F0 03                beq     @cdd
00122Fr 2  E8                   inx
001230r 2  D0 F5                bne     @cc
001232r 2  20 rr rr     @cdd:   jsr     mon_showcwd
001235r 2  38                   sec
001236r 2  60                   rts
001237r 2  4C rr rr     @cdbad: jmp     mon_badpath
00123Ar 2               
00123Ar 2  A5 24        @addr:  lda     XAML                ; default address = monitor's current one
00123Cr 2  8D rr rr             sta     ch_a0
00123Fr 2  A5 25                lda     XAMH
001241r 2  8D rr rr             sta     ch_a0+1
001244r 2  B9 00 02     @sp2:   lda     IN,y
001247r 2  C9 20                cmp     #' '
001249r 2  D0 03                bne     @a0
00124Br 2  C8                   iny
00124Cr 2  D0 F6                bne     @sp2
00124Er 2  C9 0D        @a0:    cmp     #$0D
001250r 2  F0 53                beq     @check              ; no address typed: use the default
001252r 2  A9 00                lda     #0
001254r 2  8D rr rr             sta     ch_a0
001257r 2  8D rr rr             sta     ch_a0+1
00125Ar 2  A2 00                ldx     #0                  ; digit count
00125Cr 2  B9 00 02     @hex:   lda     IN,y
00125Fr 2  C9 0D                cmp     #$0D
001261r 2  F0 3E                beq     @hexend
001263r 2  C9 20                cmp     #' '
001265r 2  F0 3A                beq     @hexend
001267r 2  38                   sec
001268r 2  E9 30                sbc     #'0'
00126Ar 2  90 32                bcc     @hbad
00126Cr 2  C9 0A                cmp     #10
00126Er 2  90 0A                bcc     @dig
001270r 2  E9 07                sbc     #7                  ; "A".."F"
001272r 2  C9 0A                cmp     #10
001274r 2  90 28                bcc     @hbad
001276r 2  C9 10                cmp     #16
001278r 2  B0 24                bcs     @hbad
00127Ar 2  0E rr rr     @dig:   asl     ch_a0
00127Dr 2  2E rr rr             rol     ch_a0+1
001280r 2  0E rr rr             asl     ch_a0
001283r 2  2E rr rr             rol     ch_a0+1
001286r 2  0E rr rr             asl     ch_a0
001289r 2  2E rr rr             rol     ch_a0+1
00128Cr 2  0E rr rr             asl     ch_a0
00128Fr 2  2E rr rr             rol     ch_a0+1
001292r 2  0D rr rr             ora     ch_a0
001295r 2  8D rr rr             sta     ch_a0
001298r 2  E8                   inx
001299r 2  C8                   iny
00129Ar 2  E0 05                cpx     #5
00129Cr 2  90 BE                bcc     @hex
00129Er 2  4C rr rr     @hbad:  jmp     mon_syntax          ; bad digit, or more than 4 digits
0012A1r 2               @hexend:
0012A1r 2  E0 00                cpx     #0
0012A3r 2  F0 F9                beq     @hbad
0012A5r 2  AD rr rr     @check: lda     ch_a0+1             ; MON_LOAD_MIN <= address < MON_LOAD_TOP
0012A8r 2  C9 05                cmp     #>MON_LOAD_MIN
0012AAr 2  90 F2                bcc     @hbad
0012ACr 2  C9 7F                cmp     #>MON_LOAD_TOP
0012AEr 2  B0 EE                bcs     @hbad
0012B0r 2  38                   sec                         ; room = top - address
0012B1r 2  A9 00                lda     #<MON_LOAD_TOP
0012B3r 2  ED rr rr             sbc     ch_a0
0012B6r 2  8D rr rr             sta     ch_len
0012B9r 2  A9 7F                lda     #>MON_LOAD_TOP
0012BBr 2  ED rr rr             sbc     ch_a0+1
0012BEr 2  8D rr rr             sta     ch_len+1
0012C1r 2               
0012C1r 2  A9 01                lda     #1
0012C3r 2  8D rr rr             sta     ch_mon
0012C6r 2  A9 rr                lda     #<mon_crlf
0012C8r 2  A0 rr                ldy     #>mon_crlf
0012CAr 2  20 rr rr             jsr     mon_puts
0012CDr 2  20 rr rr             jsr     ch_prepare
0012D0r 2  90 05                bcc     @ready
0012D2r 2  A9 F2                lda     #CH_E_NODISK
0012D4r 2  4C rr rr             jmp     ch_fail
0012D7r 2  20 rr rr     @ready: jsr     mon_open
0012DAr 2  C9 14 F0 03          CH_OK   ch_fail
0012DEr 2  4C rr rr     
0012E1r 2  AD rr rr             lda     ch_a0
0012E4r 2  8D rr rr             sta     ch_ptr
0012E7r 2  AD rr rr             lda     ch_a0+1
0012EAr 2  8D rr rr             sta     ch_ptr+1
0012EDr 2  20 rr rr             jsr     ch_read
0012F0r 2  C9 14 F0 03          CH_OK   ch_fail_close
0012F4r 2  4C rr rr     
0012F7r 2  AD rr rr             lda     ch_got+1            ; got >= room -> did not fit
0012FAr 2  CD rr rr             cmp     ch_len+1
0012FDr 2  90 0F                bcc     @fits
0012FFr 2  D0 08                bne     @big
001301r 2  AD rr rr             lda     ch_got
001304r 2  CD rr rr             cmp     ch_len
001307r 2  90 05                bcc     @fits
001309r 2  A9 F0        @big:   lda     #CH_E_TOOBIG
00130Br 2  4C rr rr             jmp     ch_fail_close
00130Er 2  A9 00        @fits:  lda     #0
001310r 2  20 rr rr             jsr     ch_file_close
001313r 2  C9 14 F0 03          CH_OK   ch_fail
001317r 2  4C rr rr     
00131Ar 2  A9 00                lda     #0
00131Cr 2  8D rr rr             sta     ch_mon
00131Fr 2  AD rr rr             lda     ch_a0               ; monitor's current address = load address
001322r 2  85 24                sta     XAML
001324r 2  AD rr rr             lda     ch_a0+1
001327r 2  85 25                sta     XAMH
001329r 2  A9 rr                lda     #<mon_loaded        ; "LOADED xxxx-yyyy"
00132Br 2  A0 rr                ldy     #>mon_loaded
00132Dr 2  20 rr rr             jsr     mon_puts
001330r 2  AD rr rr             lda     ch_a0+1
001333r 2  20 rr rr             jsr     PRBYTE
001336r 2  AD rr rr             lda     ch_a0
001339r 2  20 rr rr             jsr     PRBYTE
00133Cr 2  AD rr rr             lda     ch_got              ; empty file: nothing loaded
00133Fr 2  0D rr rr             ora     ch_got+1
001342r 2  F0 1A                beq     @empty
001344r 2  A9 2D                lda     #'-'
001346r 2  20 rr rr             jsr     CHROUT
001349r 2  AD rr rr             lda     ch_ptr              ; ch_read left ch_ptr after the data
00134Cr 2  38                   sec
00134Dr 2  E9 01                sbc     #1
00134Fr 2  AA                   tax
001350r 2  AD rr rr             lda     ch_ptr+1
001353r 2  E9 00                sbc     #0
001355r 2  20 rr rr             jsr     PRBYTE
001358r 2  8A                   txa
001359r 2  20 rr rr             jsr     PRBYTE
00135Cr 2  38                   sec
00135Dr 2  60                   rts
00135Er 2  A9 rr        @empty: lda     #<mon_empty
001360r 2  A0 rr                ldy     #>mon_empty
001362r 2  20 rr rr             jsr     mon_puts
001365r 2  38                   sec
001366r 2  60                   rts
001367r 2               mon_syntax:
001367r 2  A9 rr                lda     #<mon_bad
001369r 2  A0 rr                ldy     #>mon_bad
00136Br 2  20 rr rr             jsr     mon_puts
00136Er 2  38                   sec
00136Fr 2  60                   rts
001370r 2               
001370r 2               ; print zero terminated string, A = lo, Y = hi
001370r 2               mon_puts:
001370r 2  85 rr                sta     strptr
001372r 2  84 rr                sty     strptr+1
001374r 2  A0 00                ldy     #0
001376r 2  B1 rr        @l:     lda     (strptr),y
001378r 2  F0 0A                beq     @d
00137Ar 2  20 rr rr             jsr     CHROUT
00137Dr 2  C8                   iny
00137Er 2  D0 F6                bne     @l
001380r 2  E6 rr                inc     strptr+1            ; strings may be longer than 256 bytes
001382r 2  D0 F2                bne     @l
001384r 2  60           @d:     rts
001385r 2               
001385r 2  2E 42 49 4E  mon_bin:     .byte ".BIN"
001389r 2  0D 0A 00     mon_crlf:    .byte 13,10,0
00138Cr 2  0D 0A 4C 4F  mon_loaded:  .byte 13,10,"LOADED ",0
001390r 2  41 44 45 44  
001394r 2  20 00        
001396r 2  20 28 45 4D  mon_empty:   .byte " (EMPTY FILE)",0
00139Ar 2  50 54 59 20  
00139Er 2  46 49 4C 45  
0013A4r 2  0D 0A 3F 53  mon_bad:     .byte 13,10,"?SYNTAX  (L NAME [XXXX], XXXX = $0500-$7EFF)",0
0013A8r 2  59 4E 54 41  
0013ACr 2  58 20 20 28  
0013D3r 2  0D 0A 3F 42  mon_badp:    .byte 13,10,"?BAD PATH",0
0013D7r 2  41 44 20 50  
0013DBr 2  41 54 48 00  
0013DFr 2               mon_help:
0013DFr 2  0D 0A                .byte 13,10
0013E1r 2  3F 20 20 20          .byte "?             this list",13,10
0013E5r 2  20 20 20 20  
0013E9r 2  20 20 20 20  
0013FAr 2  58 58 58 58          .byte "XXXX          show the byte at address XXXX",13,10
0013FEr 2  20 20 20 20  
001402r 2  20 20 20 20  
001427r 2  58 58 58 58          .byte "XXXX.YYYY     show a range of memory",13,10
00142Br 2  2E 59 59 59  
00142Fr 2  59 20 20 20  
00144Dr 2  58 58 58 58          .byte "XXXX: AA BB   store bytes starting at XXXX",13,10
001451r 2  3A 20 41 41  
001455r 2  20 42 42 20  
001479r 2  52 20 20 20          .byte "R             run the program at the last address (XXXXR)",13,10
00147Dr 2  20 20 20 20  
001481r 2  20 20 20 20  
0014B4r 2  4C 20 20 20          .byte "L             list the files in the current USB directory",13,10
0014B8r 2  20 20 20 20  
0014BCr 2  20 20 20 20  
0014EFr 2  4C 20 44 49          .byte "L DIR         change into directory DIR",13,10
0014F3r 2  52 20 20 20  
0014F7r 2  20 20 20 20  
001518r 2  4C 20 2E 2E          .byte "L ..          up one level      L \ or L /   back to the root",13,10
00151Cr 2  20 20 20 20  
001520r 2  20 20 20 20  
001557r 2  4C 20 4E 41          .byte "L NAME [XXXX] load NAME.BIN from the current directory into RAM at",13,10
00155Br 2  4D 45 20 5B  
00155Fr 2  58 58 58 58  
00159Br 2  20 20 20 20          .byte "              XXXX (default: the last address; range $0500-$7EFF)",13,10
00159Fr 2  20 20 20 20  
