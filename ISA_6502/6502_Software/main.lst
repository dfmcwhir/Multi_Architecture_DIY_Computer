0017B6r 2  60                   rts
0017B7r 2               
0017B7r 2               ; ============================================================================
0017B7r 2               ; SBC_LOAD - load a whole file into RAM, for programs (jump table entry $FE15)
0017B7r 2               ;
0017B7r 2               ;   In : A = low, Y = high byte of a parameter block anywhere in RAM:
0017B7r 2               ;           +0 .word  address to load to
0017B7r 2               ;           +2 .word  most bytes to write (a longer file is cut off, still OK)
0017B7r 2               ;           +4 .byte  file name, 8.3, root directory, ends with a 0 byte
0017B7r 2               ;   Out: carry clear = loaded, X = length low, Y = length high
0017B7r 2               ;        carry set   = failed, A = error code: the CH376 status ($42 = file not
0017B7r 2               ;                      found), $FF = timeout / no drive, $FE = bad parameter block
0017B7r 2               ;   Prints nothing, never jumps to the monitor, closes the file before it
0017B7r 2               ;   returns.  Changes A, X, Y and flags (and strptr, the firmware's own zero
0017B7r 2               ;   page bytes).  Never writes beyond address + max - 1.
0017B7r 2               ; ============================================================================
0017B7r 2               SBC_LOAD_USES_CWD = 1               ; 1 = names are relative to the monitor's current
0017B7r 2                                                   ; directory (L DIR), 0 = always the root directory
0017B7r 2               SBC_LOAD:
0017B7r 2  85 rr                sta     strptr
0017B9r 2  84 rr                sty     strptr+1
0017BBr 2  20 rr rr             jsr     mon_copy_cwd        ; build "<current dir>/NAME.EXT",0 in ch_name
0017BEr 2  A9 01                lda     #SBC_LOAD_USES_CWD
0017C0r 2  D0 02                bne     @cw
0017C2r 2  A2 00                ldx     #0                  ; root only
0017C4r 2  A9 2F        @cw:    lda     #'/'
0017C6r 2  9D rr rr             sta     ch_name,x
0017C9r 2  E8                   inx
0017CAr 2  8E rr rr             stx     mon_x               ; start of the file name part
0017CDr 2  8A                   txa
0017CEr 2  18                   clc
0017CFr 2  69 0C                adc     #12                 ; at most 12 characters
0017D1r 2  8D rr rr             sta     mon_cl
0017D4r 2  A0 04                ldy     #4
0017D6r 2  B1 rr        @cp:    lda     (strptr),y
0017D8r 2  F0 1A                beq     @term
0017DAr 2  EC rr rr             cpx     mon_cl
0017DDr 2  B0 11                bcs     @bad
0017DFr 2  C9 61                cmp     #'a'                ; lower case -> upper case
0017E1r 2  90 06                bcc     @st
0017E3r 2  C9 7B                cmp     #'z'+1
0017E5r 2  B0 02                bcs     @st
0017E7r 2  29 DF                and     #$DF
0017E9r 2  9D rr rr     @st:    sta     ch_name,x
0017ECr 2  E8                   inx
0017EDr 2  C8                   iny
0017EEr 2  D0 E6                bne     @cp
0017F0r 2  A9 FE        @bad:   lda     #$FE                ; bad parameter block
0017F2r 2  38                   sec
0017F3r 2  60                   rts
0017F4r 2  A9 00        @term:  lda     #0
0017F6r 2  9D rr rr             sta     ch_name,x
0017F9r 2  EC rr rr             cpx     mon_x
0017FCr 2  F0 F2                beq     @bad                ; empty name
0017FEr 2  A0 00                ldy     #0                  ; address and limit from the block
001800r 2  B1 rr                lda     (strptr),y
001802r 2  8D rr rr             sta     ch_a0
001805r 2  C8                   iny
001806r 2  B1 rr                lda     (strptr),y
001808r 2  8D rr rr             sta     ch_a0+1
00180Br 2  C8                   iny
00180Cr 2  B1 rr                lda     (strptr),y
00180Er 2  8D rr rr             sta     ch_len
001811r 2  C8                   iny
001812r 2  B1 rr                lda     (strptr),y
001814r 2  8D rr rr             sta     ch_len+1
001817r 2  20 rr rr             jsr     ch_prepare          ; initialise the CH376 / mount if needed
00181Ar 2  B0 55                bcs     sl_nodisk
00181Cr 2  20 rr rr                     jsr     mon_open
00181Fr 2  C9 14                cmp     #USB_INT_SUCCESS
001821r 2  D0 41                bne     sl_err              ; (nothing is open: no close needed)
001823r 2  AD rr rr             lda     ch_len
001826r 2  0D rr rr             ora     ch_len+1
001829r 2  F0 20                beq     sl_zero             ; room for 0 bytes: just report the file exists
00182Br 2  AD rr rr             lda     ch_a0
00182Er 2  8D rr rr             sta     ch_ptr
001831r 2  AD rr rr             lda     ch_a0+1
001834r 2  8D rr rr             sta     ch_ptr+1
001837r 2  20 rr rr             jsr     ch_read             ; reads at most ch_len bytes
00183Ar 2  C9 14                cmp     #USB_INT_SUCCESS
00183Cr 2  D0 18                bne     sl_rderr
00183Er 2  A9 00                lda     #0
001840r 2  20 rr rr             jsr     ch_file_close
001843r 2  AE rr rr             ldx     ch_got
001846r 2  AC rr rr             ldy     ch_got+1
001849r 2  18                   clc
00184Ar 2  60                   rts
00184Br 2               sl_zero:
00184Br 2  A9 00                lda     #0
00184Dr 2  20 rr rr             jsr     ch_file_close
001850r 2  A2 00                ldx     #0
001852r 2  A0 00                ldy     #0
001854r 2  18                   clc
001855r 2  60                   rts
001856r 2               sl_rderr:
001856r 2  48                   pha                         ; read failed: close, start afresh next time
001857r 2  A9 00                lda     #0
001859r 2  8D rr rr             sta     ch_ready
00185Cr 2  A9 00                lda     #0
00185Er 2  20 rr rr             jsr     ch_file_close
001861r 2  68                   pla
001862r 2  38                   sec
001863r 2  60                   rts
001864r 2  C9 42        sl_err: cmp     #ERR_MISS_FILE      ; "file not found" is a normal answer
001866r 2  F0 07                beq     @ret
001868r 2  48                   pha
001869r 2  A9 00                lda     #0
00186Br 2  8D rr rr             sta     ch_ready            ; anything else: re-initialise next time
00186Er 2  68                   pla
00186Fr 2  38           @ret:   sec
001870r 2  60                   rts
001871r 2               sl_nodisk:
001871r 2  A9 00                lda     #0
001873r 2  8D rr rr             sta     ch_ready
001876r 2  A9 FF                lda     #$FF
001878r 2  38                   sec
001879r 2  60                   rts
00187Ar 2               
00187Ar 1               
