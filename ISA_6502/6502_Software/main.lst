001768r 2  A9 01                lda     #1
00176Ar 2  8D rr rr             sta     mon_kind
00176Dr 2  D0 3D                bne     @next
00176Fr 2  AD rr rr     @norm:  lda     mon_x               ; room for "/" + part?  (max 40 characters)
001772r 2  18                   clc
001773r 2  6D rr rr             adc     mon_cl
001776r 2  69 01                adc     #1
001778r 2  C9 29                cmp     #41
00177Ar 2  B0 A2                bcs     @err
00177Cr 2  AE rr rr             ldx     mon_x
00177Fr 2  A9 2F                lda     #'/'
001781r 2  9D rr rr             sta     ch_name,x
001784r 2  E8                   inx
001785r 2  A0 00                ldy     #0
