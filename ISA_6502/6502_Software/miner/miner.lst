000367r 2               
000367r 2               
000367r 1               
000367r 1               ; ----------------------------------------------------------------------------
000367r 1               ; I/O helpers
000367r 1               ; ----------------------------------------------------------------------------
000367r 1               ; carry set = key in A.  After IDENTIFY (1C 0C) the terminal answers S P 1:
000367r 1               ; those are taken as its answer (rp_got), not as keys, until the 1 comes or
000367r 1               ; the next IDENTIFY.  (Keys come in lower case; any one of the three will do.)
000367r 1  20 00 FE     getc:   jsr     SBC_CHRIN
00036Ar 1  90 24                bcc     @r
00036Cr 1  48                   pha
00036Dr 1  AD rr rr             lda     rp_on
000370r 1  F0 1C                beq     @key
000372r 1  68                   pla
000373r 1  C9 53                cmp     #'S'
000375r 1  F0 0D                beq     @rep
000377r 1  C9 50                cmp     #'P'
000379r 1  F0 09                beq     @rep
00037Br 1  C9 31                cmp     #'1'
00037Dr 1  D0 0D                bne     @k2
00037Fr 1  A9 00                lda     #0
000381r 1  8D rr rr             sta     rp_on
000384r 1  A9 01        @rep:   lda     #1
000386r 1  8D rr rr             sta     rp_got
000389r 1  4C rr rr             jmp     getc
00038Cr 1  38           @k2:    sec
00038Dr 1  60                   rts
00038Er 1  68           @key:   pla
00038Fr 1  38                   sec
000390r 1  60           @r:     rts
000391r 1               
000391r 1               ; send A (counts the bytes, for the frame timing).  Preserves A, X, Y.
000391r 1  EE rr rr     putc:   inc     nbytes
000394r 1  D0 03                bne     @p
000396r 1  EE rr rr             inc     nbytes+1
000399r 1  20 rr rr     @p:     jsr     sfx_poll        ; (the sound goes on while drawing)
00039Cr 1  4C 03 FE             jmp     SBC_CHROUT
00039Fr 1               
00039Fr 1               ; cursor to column X, row Y.  Preserves X and Y.
00039Fr 1  A9 0F        gotoxy: lda     #TC_ROW
0003A1r 1  20 rr rr             jsr     putc
0003A4r 1  98                   tya
0003A5r 1  20 rr rr             jsr     putc
0003A8r 1  A9 0E                lda     #TC_COL
0003AAr 1  20 rr rr             jsr     putc
0003ADr 1  8A                   txa
0003AEr 1  4C rr rr             jmp     putc
0003B1r 1               
0003B1r 1               txt_mode:
0003B1r 1  A9 00                lda     #ATTR_TEXT
0003B3r 1  F0 02                beq     setattr
0003B5r 1               gfx_mode:
0003B5r 1  A9 80                lda     #ATTR_GFX
0003B7r 1  CD rr rr     setattr:cmp     attr
0003BAr 1  F0 0D                beq     @r
0003BCr 1  8D rr rr             sta     attr
0003BFr 1  48                   pha
0003C0r 1  A9 18                lda     #TC_ATTR
0003C2r 1  20 rr rr             jsr     putc
0003C5r 1  68                   pla
0003C6r 1  4C rr rr             jmp     putc
0003C9r 1  60           @r:     rts
0003CAr 1               
0003CAr 1               ; a block graphics character (00-1F and 7F need the 1A prefix)
0003CAr 1  C9 20        putblk: cmp     #$20
0003CCr 1  90 04                bcc     @lit
0003CEr 1  C9 7F                cmp     #$7F
0003D0r 1  D0 07                bne     @out
0003D2r 1  48           @lit:   pha
0003D3r 1  A9 1A                lda     #TC_LIT
0003D5r 1  20 rr rr             jsr     putc
0003D8r 1  68                   pla
0003D9r 1  4C rr rr     @out:   jmp     putc
0003DCr 1               
0003DCr 1               ; print the string at A (lo) / Y (hi), ended by TERM (any length)
0003DCr 1  8D rr rr     print:  sta     @ld+1
0003DFr 1  8C rr rr             sty     @ld+2
0003E2r 1  AD FF FF     @ld:    lda     $FFFF
0003E5r 1  C9 FF                cmp     #TERM
0003E7r 1  F0 0D                beq     @done
0003E9r 1  20 rr rr             jsr     putc
0003ECr 1  EE rr rr             inc     @ld+1
0003EFr 1  D0 F1                bne     @ld
0003F1r 1  EE rr rr             inc     @ld+2
0003F4r 1  D0 EC                bne     @ld
0003F6r 1  A9 FF        @done:  lda     #$FF            ; (strings may change the attribute)
0003F8r 1  8D rr rr             sta     attr
0003FBr 1  60                   rts
0003FCr 1               
0003FCr 1               ; print A as two BCD digits
0003FCr 1  48           prbcd:  pha
0003FDr 1  4A                   lsr
0003FEr 1  4A                   lsr
0003FFr 1  4A                   lsr
000400r 1  4A                   lsr
000401r 1  09 30                ora     #'0'
000403r 1  20 rr rr             jsr     putc
000406r 1  68                   pla
000407r 1  29 0F                and     #$0F
000409r 1  09 30                ora     #'0'
00040Br 1  4C rr rr             jmp     putc
00040Er 1               
00040Er 1               ; print A (0-99) as two decimal digits
00040Er 1  A2 30        prdec2: ldx     #'0'
000410r 1  C9 0A        @t:     cmp     #10
000412r 1  90 05                bcc     @u
000414r 1  E9 0A                sbc     #10
000416r 1  E8                   inx
000417r 1  D0 F7                bne     @t
000419r 1  48           @u:     pha
00041Ar 1  8A                   txa
00041Br 1  20 rr rr             jsr     putc
00041Er 1  68                   pla
00041Fr 1  09 30                ora     #'0'
000421r 1  4C rr rr             jmp     putc
000424r 1               
000424r 1               ; 16 bit Galois LFSR.  A = a random byte.  Preserves X and Y.
000424r 1  AD rr rr     rand:   lda     rng+1
000427r 1  4A                   lsr
000428r 1  6E rr rr             ror     rng
00042Br 1  90 02                bcc     @n
00042Dr 1  49 B4                eor     #$B4
00042Fr 1  8D rr rr     @n:     sta     rng+1
000432r 1  4D rr rr             eor     rng
000435r 1  60                   rts
000436r 1               
000436r 1               ; wait about A ms.  The inner loop is sized for the clock (CLOCK_MHZ in
000436r 1               ; sbc_api.inc): 5 + 4 * (CLOCK_MHZ - 1) cycles a turn, DELAY_N turns a ms.
000436r 1               DELAY_N = (1000 * CLOCK_MHZ - 7) / (5 + 4 * (CLOCK_MHZ - 1))
000436r 1               delay_ms:
000436r 1  AA                   tax
000437r 1  F0 0D                beq     @done
000439r 1  20 rr rr     @o:     jsr     sfx_poll        ; (and while waiting)
00043Cr 1  A0 DD                ldy     #DELAY_N
00043Er 1               @i:
00043Er 1  EA EA        .repeat CLOCK_MHZ - 1
000440r 1                       nop
000440r 1                       nop
000440r 1               .endrepeat
000440r 1  88                   dey
000441r 1  D0 FB                bne     @i
000443r 1  CA                   dex
000444r 1  D0 F3                bne     @o
000446r 1  60           @done:  rts
000447r 1               
000447r 1               ; wait about A x 50 ms, dropping keys pressed meanwhile
000447r 1               delay_long:
000447r 1  8D rr rr             sta     tmp
00044Ar 1  A9 32        @l:     lda     #50
00044Cr 1  20 rr rr             jsr     delay_ms
00044Fr 1  20 rr rr             jsr     flush_in
000452r 1  CE rr rr             dec     tmp
000455r 1  D0 F3                bne     @l
000457r 1  60                   rts
000458r 1               
000458r 1               .macro MENU_IDLE
000458r 1                       jsr     rand            ; (waiting stirs the random numbers)
000458r 1                       jsr     sfx_poll
000458r 1               .endmacro
000458r 1               CTRL_COL        = 19
000458r 1               CTRL_ROW        = 20
000458r 1               
000458r 1               ; ============================================================================
000458r 1               ; gamepad and menu input (shared by the SBC games)
000458r 1               ; ============================================================================
000458r 1               PAD_A           = $01           ; bits returned by SBC_PADSTATE
000458r 1               PAD_B           = $02
000458r 1               PAD_SELECT      = $04
000458r 1               PAD_START       = $08
000458r 1               PAD_UP          = $10
000458r 1               PAD_DOWN        = $20
000458r 1               PAD_LEFT        = $40
000458r 1               PAD_RIGHT       = $80
000458r 1               PAD_GO          = $80           ; menu_key's answer for gamepad A or Start
000458r 1               
000458r 1               ; read the gamepad: pad = buttons held now, padnew = buttons pressed since
000458r 1               ; the last call.  Preserves X and Y (SBC_PADSTATE only changes A).
000458r 1               read_pad:
000458r 1  20 12 FE             jsr     SBC_PADSTATE
00045Br 1  C9 FF                cmp     #$FF            ; every button "pressed" = no pad
00045Dr 1  D0 02                bne     @ok
00045Fr 1  A9 00                lda     #0
000461r 1  8D rr rr     @ok:    sta     pad
000464r 1  AD rr rr             lda     padold
000467r 1  49 FF                eor     #$FF
000469r 1  2D rr rr             and     pad
00046Cr 1  8D rr rr             sta     padnew
00046Fr 1  AD rr rr             lda     pad
000472r 1  8D rr rr             sta     padold
000475r 1  60                   rts
000476r 1               
000476r 1               ; throw away waiting characters
000476r 1               flush_in:
000476r 1  20 rr rr             jsr     getc
000479r 1  B0 FB                bcs     flush_in
00047Br 1  60                   rts
00047Cr 1               
00047Cr 1               ; carry set if A is one of the characters the gamepad driver types for the
00047Cr 1               ; pad (W A S D and space).  Those are ignored in gamepad mode so that one
00047Cr 1               ; press doesn't act twice.  Preserves A.
00047Cr 1               pad_typed:
00047Cr 1  C9 20                cmp     #' '
00047Er 1  F0 12                beq     @y
000480r 1  C9 57                cmp     #'W'
000482r 1  F0 0E                beq     @y
000484r 1  C9 41                cmp     #'A'
000486r 1  F0 0A                beq     @y
000488r 1  C9 53                cmp     #'S'
00048Ar 1  F0 06                beq     @y
00048Cr 1  C9 44                cmp     #'D'
00048Er 1  F0 02                beq     @y
000490r 1  18                   clc
000491r 1  60                   rts
000492r 1  38           @y:     sec
000493r 1  60                   rts
000494r 1               
000494r 1               ; wait for a menu choice.  Returns a key (letters in upper case), or
000494r 1               ; PAD_GO for the gamepad's A or Start button.
000494r 1               menu_key:
000494r 1  20 rr rr 20  @l:     MENU_IDLE
000498r 1  rr rr        
00049Ar 1  20 rr rr             jsr     read_pad
00049Dr 1  AD rr rr             lda     padnew
0004A0r 1  29 09                and     #PAD_A | PAD_START
0004A2r 1  D0 21                bne     @pad
0004A4r 1  20 rr rr             jsr     getc
0004A7r 1  90 EB                bcc     @l
0004A9r 1  C9 20                cmp     #' '            ; a space typed by the pad's A button?
0004ABr 1  D0 0D                bne     @up
0004ADr 1  20 rr rr             jsr     read_pad
0004B0r 1  AD rr rr             lda     pad
0004B3r 1  29 01                and     #PAD_A
0004B5r 1  D0 0E                bne     @pad
0004B7r 1  A9 20                lda     #' '
0004B9r 1  60                   rts
0004BAr 1  C9 61        @up:    cmp     #'a'
0004BCr 1  90 06                bcc     @r
0004BEr 1  C9 7B                cmp     #'z'+1
0004C0r 1  B0 02                bcs     @r
0004C2r 1  29 DF                and     #$DF
0004C4r 1  60           @r:     rts
0004C5r 1  20 rr rr     @pad:   jsr     flush_in        ; the space the driver typed for it
0004C8r 1  A9 80                lda     #PAD_GO
0004CAr 1  60                   rts
0004CBr 1               
0004CBr 1               ; print the controls line (CTRL_COL, CTRL_ROW)
0004CBr 1               show_ctrl:
0004CBr 1  20 rr rr             jsr     txt_mode
0004CEr 1  A2 13                ldx     #CTRL_COL
0004D0r 1  A0 14                ldy     #CTRL_ROW
0004D2r 1  20 rr rr             jsr     gotoxy
0004D5r 1  AD rr rr             lda     ctrl
0004D8r 1  F0 07                beq     @kb
0004DAr 1  A9 rr                lda     #<ctrl_pad_txt
0004DCr 1  A0 rr                ldy     #>ctrl_pad_txt
0004DEr 1  4C rr rr             jmp     print
0004E1r 1  A9 rr        @kb:    lda     #<ctrl_kb_txt
0004E3r 1  A0 rr                ldy     #>ctrl_kb_txt
0004E5r 1  4C rr rr             jmp     print
0004E8r 1               
0004E8r 1               ; ============================================================================
0004E8r 1               ; start, title
0004E8r 1               ; ============================================================================
0004E8r 1  D8           start:  cld
0004E9r 1  A2 FF                ldx     #$FF
0004EBr 1  9A                   txs
0004ECr 1  A9 00                lda     #0              ; clear the variables (RAM is random at power-up)
0004EEr 1  AA                   tax
0004EFr 1  A0 05                ldy     #>(bss_end - bss_start + $FF)
0004F1r 1  9D rr rr     @c1:    sta     bss_start,x
0004F4r 1  E8                   inx
0004F5r 1  D0 FA                bne     @c1
0004F7r 1  EE rr rr             inc     @c1+2
0004FAr 1  88                   dey
0004FBr 1  D0 F4                bne     @c1
0004FDr 1  AD rr rr             lda     ctrl_def
000500r 1  8D rr rr             sta     ctrl
000503r 1  A9 5A                lda     #$5A
000505r 1  8D rr rr             sta     rng
000508r 1  A9 FF                lda     #$FF
00050Ar 1  8D rr rr             sta     attr
00050Dr 1  20 rr rr             jsr     sfx_init
000510r 1  AD rr rr             lda     mute_def
000513r 1  8D rr rr             sta     sfx_mute
000516r 1  20 rr rr             jsr     spr_setup       ; the terminal's sprites (or back to the menu)
000519r 1               
000519r 1  20 rr rr     title:  jsr     sfx_off
00051Cr 1  A9 00                lda     #0
00051Er 1  8D rr rr             sta     rp_on
000521r 1  20 rr rr             jsr     new_screen
000524r 1  A9 rr                lda     #<title_txt
000526r 1  A0 rr                ldy     #>title_txt
000528r 1  20 rr rr             jsr     print
00052Br 1  20 rr rr             jsr     txt_mode        ; the high score
00052Er 1  A2 22                ldx     #34
000530r 1  A0 12                ldy     #18
000532r 1  20 rr rr             jsr     gotoxy
000535r 1  A9 rr                lda     #<hi_txt
000537r 1  A0 rr                ldy     #>hi_txt
000539r 1  20 rr rr             jsr     print
00053Cr 1  AD rr rr             lda     hiscore+2
00053Fr 1  20 rr rr             jsr     prbcd
000542r 1  AD rr rr             lda     hiscore+1
000545r 1  20 rr rr             jsr     prbcd
000548r 1  AD rr rr             lda     hiscore
00054Br 1  20 rr rr             jsr     prbcd
00054Er 1  A2 06                ldx     #NTSPR-1        ; Willy and the guardians, for show
000550r 1  BD rr rr     @ts:    lda     tspr_n,x
000553r 1  8D rr rr             sta     des_n
000556r 1  BD rr rr             lda     tspr_x,x
000559r 1  8D rr rr             sta     des_x
00055Cr 1  A9 4C                lda     #32 + 44
00055Er 1  8D rr rr             sta     des_y
000561r 1  A9 1C                lda     #TC_SPR
000563r 1  20 rr rr             jsr     putc
000566r 1  A9 02                lda     #SPR_PLACE
000568r 1  20 rr rr             jsr     putc
00056Br 1  8A                   txa
00056Cr 1  20 rr rr             jsr     putc
00056Fr 1  AD rr rr             lda     des_n
000572r 1  20 rr rr             jsr     putc
000575r 1  AD rr rr             lda     des_x
000578r 1  20 rr rr             jsr     putc
00057Br 1  AD rr rr             lda     des_y
00057Er 1  20 rr rr             jsr     putc
000581r 1  A9 00                lda     #0
000583r 1  20 rr rr             jsr     putc
000586r 1  CA                   dex
000587r 1  10 C7                bpl     @ts
000589r 1  20 rr rr             jsr     show_ctrl
00058Cr 1  A9 rr                lda     #<start_txt
00058Er 1  A0 rr                ldy     #>start_txt
000590r 1  20 rr rr             jsr     print
000593r 1  20 rr rr             jsr     read_pad
000596r 1  20 rr rr             jsr     flush_in
000599r 1  20 rr rr     @wait:  jsr     menu_key
00059Cr 1  C9 51                cmp     #'Q'
00059Er 1  D0 03                bne     @notq
0005A0r 1  4C rr rr             jmp     exit_game
0005A3r 1  C9 4D        @notq:  cmp     #'M'            ; sound on / off
0005A5r 1  D0 06                bne     @notm
0005A7r 1  20 rr rr             jsr     sfx_toggle
0005AAr 1  4C rr rr             jmp     @wait
0005ADr 1  C9 47        @notm:  cmp     #'G'
0005AFr 1  D0 0E                bne     @notg
0005B1r 1  AD rr rr             lda     ctrl
0005B4r 1  49 01                eor     #1
0005B6r 1  8D rr rr             sta     ctrl
0005B9r 1  20 rr rr             jsr     show_ctrl
0005BCr 1  4C rr rr             jmp     @wait
0005BFr 1  C9 80        @notg:  cmp     #PAD_GO
0005C1r 1  D0 08                bne     @notp
0005C3r 1  A9 01                lda     #1
0005C5r 1  8D rr rr             sta     ctrl
0005C8r 1  4C rr rr             jmp     new_game
0005CBr 1  C9 20        @notp:  cmp     #' '
0005CDr 1  D0 CA                bne     @wait
0005CFr 1  4C rr rr             jmp     new_game
0005D2r 1               
0005D2r 1               exit_game:
0005D2r 1  20 rr rr             jsr     sfx_off
0005D5r 1  A9 rr                lda     #<bye_txt
0005D7r 1  A0 rr                ldy     #>bye_txt
0005D9r 1  20 rr rr             jsr     print
0005DCr 1  4C 06 FE             jmp     SBC_MENU
0005DFr 1               
0005DFr 1               ; clear the screen (which hides the sprites) and forget what it showed
0005DFr 1               new_screen:
0005DFr 1  A9 rr                lda     #<cls_txt
0005E1r 1  A0 rr                ldy     #>cls_txt
0005E3r 1  20 rr rr             jsr     print
0005E6r 1  A2 0F                ldx     #NSLOT-1
0005E8r 1  A9 00                lda     #0
0005EAr 1  9D rr rr     @f:     sta     sl_on,x
0005EDr 1  9D rr rr             sta     des_on,x
0005F0r 1  CA                   dex
0005F1r 1  10 F7                bpl     @f
0005F3r 1  A9 01                lda     #1              ; (nothing to wait for)
0005F5r 1  8D rr rr             sta     rp_got
0005F8r 1  60                   rts
0005F9r 1               
0005F9r 1               ; ============================================================================
0005F9r 1               ; the terminal's sprite layer: IDENTIFY, then the pictures; without it, a
0005F9r 1               ; word and back to the boot menu
0005F9r 1               ; ============================================================================
0005F9r 1               spr_setup:
0005F9r 1  20 rr rr             jsr     flush_in
0005FCr 1  A9 rr                lda     #<ident_txt
0005FEr 1  A0 rr                ldy     #>ident_txt
000600r 1  20 rr rr             jsr     print
000603r 1  A9 C8                lda     #200            ; up to 200 ms
000605r 1  8D rr rr             sta     rp_t
000608r 1  20 00 FE     @w:     jsr     SBC_CHRIN
00060Br 1  B0 17                bcs     @c
00060Dr 1  A9 01        @w1:    lda     #1
00060Fr 1  20 rr rr             jsr     delay_ms
000612r 1  CE rr rr             dec     rp_t
000615r 1  D0 F1                bne     @w
000617r 1  A9 rr                lda     #<nospr_txt     ; no answer
000619r 1  A0 rr                ldy     #>nospr_txt
00061Br 1  20 rr rr             jsr     print
00061Er 1  20 rr rr             jsr     menu_key
000621r 1  4C 06 FE             jmp     SBC_MENU
000624r 1  C9 53        @c:     cmp     #'S'
000626r 1  F0 08                beq     @yes
000628r 1  C9 50                cmp     #'P'
00062Ar 1  F0 04                beq     @yes
00062Cr 1  C9 31                cmp     #'1'
00062Er 1  D0 DD                bne     @w1
000630r 1  A9 14        @yes:   lda     #20             ; (the rest of the answer)
000632r 1  20 rr rr             jsr     delay_ms
000635r 1  20 rr rr             jsr     flush_in
000638r 1  A9 rr                lda     #<spr_defs      ; the pictures (SPR_DEFS bytes)
00063Ar 1  8D rr rr             sta     @ld+1
00063Dr 1  A9 rr                lda     #>spr_defs
00063Fr 1  8D rr rr             sta     @ld+2
000642r 1  A9 A4                lda     #<SPR_DEFS
000644r 1  8D rr rr             sta     tmp
000647r 1  A9 01                lda     #>SPR_DEFS
000649r 1  8D rr rr             sta     tmp+1
00064Cr 1  AD FF FF     @ld:    lda     $FFFF
00064Fr 1  20 03 FE             jsr     SBC_CHROUT
000652r 1  EE rr rr             inc     @ld+1
000655r 1  D0 03                bne     @n
000657r 1  EE rr rr             inc     @ld+2
00065Ar 1  AD rr rr     @n:     lda     tmp
00065Dr 1  D0 03                bne     @dd
00065Fr 1  CE rr rr             dec     tmp+1
000662r 1  CE rr rr     @dd:    dec     tmp
000665r 1  AD rr rr             lda     tmp
000668r 1  0D rr rr             ora     tmp+1
00066Br 1  D0 DF                bne     @ld
00066Dr 1  60                   rts
00066Er 1               
00066Er 1               ; ---- pacing: IDENTIFY after each frame; the next waits for the answer ----
00066Er 1               ASK_MS          = 60
00066Er 1               ask_send:
00066Er 1  A9 01                lda     #1
000670r 1  8D rr rr             sta     rp_on
000673r 1  A9 00                lda     #0
000675r 1  8D rr rr             sta     rp_got
000678r 1  A9 rr                lda     #<ident_txt
00067Ar 1  A0 rr                ldy     #>ident_txt
00067Cr 1  4C rr rr             jmp     print
00067Fr 1               
00067Fr 1               ask_wait:
00067Fr 1  AD rr rr             lda     rp_got
000682r 1  D0 1F                bne     @r
000684r 1  A9 3C                lda     #ASK_MS
000686r 1  8D rr rr             sta     rp_t
000689r 1  20 rr rr     @l:     jsr     getc
00068Cr 1  90 06                bcc     @none
00068Er 1  20 rr rr             jsr     handle_key      ; (a key meanwhile)
000691r 1  4C rr rr             jmp     @chk
000694r 1  A9 01        @none:  lda     #1
000696r 1  20 rr rr             jsr     delay_ms
000699r 1  CE rr rr             dec     rp_t
00069Cr 1  F0 05                beq     @r
00069Er 1  AD rr rr     @chk:   lda     rp_got
0006A1r 1  F0 E6                beq     @l
0006A3r 1  60           @r:     rts
0006A4r 1               
0006A4r 1               ; ============================================================================
0006A4r 1               ; a game
0006A4r 1               ; ============================================================================
0006A4r 1               new_game:
0006A4r 1  A9 00                lda     #0
0006A6r 1  8D rr rr             sta     score
0006A9r 1  8D rr rr             sta     score+1
0006ACr 1  8D rr rr             sta     score+2
0006AFr 1  8D rr rr             sta     room
0006B2r 1  8D rr rr             sta     quit
0006B5r 1  A9 03                lda     #3
0006B7r 1  8D rr rr             sta     lives
0006BAr 1               start_room:
0006BAr 1  20 rr rr             jsr     load_room
0006BDr 1  20 rr rr             jsr     new_screen
0006C0r 1  20 rr rr             jsr     draw_room
0006C3r 1  A9 rr                lda     #<clip_txt      ; sprites only in the room
0006C5r 1  A0 rr                ldy     #>clip_txt
0006C7r 1  20 rr rr             jsr     print
0006CAr 1  A9 01                lda     #1
0006CCr 1  8D rr rr             sta     hud_dirty
0006CFr 1  20 rr rr             jsr     hud_update
0006D2r 1  A9 00                lda     #0
0006D4r 1  8D rr rr             sta     frame
0006D7r 1  8D rr rr             sta     air_t
0006DAr 1  8D rr rr             sta     jhold
0006DDr 1  8D rr rr             sta     mv_hold
0006E0r 1  20 rr rr             jsr     sfx_off         ; the tune, from its start
0006E3r 1  A9 00                lda     #MUS_HALL
0006E5r 1  20 rr rr             jsr     sfx_snd
0006E8r 1  A9 01                lda     #MUS_HALL+1
0006EAr 1  20 rr rr             jsr     sfx_snd
0006EDr 1               
0006EDr 1               ; ---- the frame loop --------------------------------------------------------------
0006EDr 1               game_loop:
0006EDr 1  20 rr rr             jsr     sfx_poll
0006F0r 1  A9 00                lda     #0
0006F2r 1  8D rr rr             sta     nbytes
0006F5r 1  8D rr rr             sta     nbytes+1
0006F8r 1  20 rr rr             jsr     read_input
0006FBr 1  AD rr rr             lda     quit
0006FEr 1  F0 03                beq     @1
000700r 1  4C rr rr             jmp     title
000703r 1  20 rr rr     @1:     jsr     ask_wait        ; the terminal has drawn the last frame
000706r 1  A9 rr                lda     #<hold_txt
000708r 1  A0 rr                ldy     #>hold_txt
00070Ar 1  20 rr rr             jsr     print
00070Dr 1  20 rr rr             jsr     guards_move
000710r 1  AD rr rr             lda     in_d
000713r 1  AE rr rr             ldx     in_j
000716r 1  20 rr rr             jsr     willy_step
000719r 1  20 rr rr             jsr     willy_touch     ; hazards, keys
00071Cr 1  20 rr rr             jsr     guards_hit
00071Fr 1  20 rr rr             jsr     air_tick
000722r 1  20 rr rr             jsr     set_sprites
000725r 1  20 rr rr             jsr     spr_send
000728r 1  A9 rr                lda     #<show_txt
00072Ar 1  A0 rr                ldy     #>show_txt
00072Cr 1  20 rr rr             jsr     print
00072Fr 1  20 rr rr             jsr     ask_send
000732r 1  20 rr rr             jsr     hud_update
000735r 1  20 rr rr             jsr     pace
000738r 1  EE rr rr             inc     frame
00073Br 1  AD rr rr             lda     w_dead
00073Er 1  F0 03                beq     @2
000740r 1  4C rr rr             jmp     life_lost
000743r 1  AD rr rr     @2:     lda     keys_left       ; all the keys, and in the portal?
000746r 1  D0 A5                bne     game_loop
000748r 1  20 rr rr             jsr     in_portal
00074Br 1  90 A0                bcc     game_loop
00074Dr 1  4C rr rr             jmp     room_done
000750r 1               
000750r 1               ; wait out the rest of the frame: about (speed - what the frame took) ms:
000750r 1               ; the bytes at 115200 baud (87 us each) and the 6502's work (about 4 ms at
000750r 1               ; 1 MHz, measured in the emulator)
000750r 1               WORK_MS         = 4 / CLOCK_MHZ
000750r 1  AD rr rr     pace:   lda     nbytes+1
000753r 1  D0 21                bne     @r
000755r 1  AD rr rr             lda     nbytes          ; bytes * 0.087 ~ bytes / 16 + bytes / 32
000758r 1  4A                   lsr
000759r 1  4A                   lsr
00075Ar 1  4A                   lsr
00075Br 1  4A                   lsr
00075Cr 1  8D rr rr             sta     tmp
00075Fr 1  4A                   lsr
000760r 1  6D rr rr             adc     tmp
000763r 1  69 02                adc     #WORK_MS
000765r 1  8D rr rr             sta     tmp
000768r 1  AD rr rr             lda     speed
00076Br 1  38                   sec
00076Cr 1  ED rr rr             sbc     tmp
00076Fr 1  90 05                bcc     @r
000771r 1  F0 03                beq     @r
000773r 1  4C rr rr             jmp     delay_ms
000776r 1  60           @r:     rts
000777r 1               
000777r 1               ; Willy is gone: he blinks, a life goes, and the room starts again
000777r 1               life_lost:
000777r 1  20 rr rr             jsr     sfx_off         ; the tune stops
00077Ar 1  A9 06                lda     #SND_DIEA
00077Cr 1  20 rr rr             jsr     sfx_snd
00077Fr 1  A9 07                lda     #SND_DIEC
000781r 1  20 rr rr             jsr     sfx_snd
000784r 1  A2 08                ldx     #8
000786r 1  8E rr rr     @b:     stx     tmp3
000789r 1  8A                   txa
00078Ar 1  29 01                and     #1
00078Cr 1  F0 06                beq     @hd
00078Er 1  20 rr rr             jsr     set_sprites     ; (shown)
000791r 1  4C rr rr             jmp     @sd
000794r 1  A9 00        @hd:    lda     #0              ; (hidden)
000796r 1  8D rr rr             sta     des_on+SL_WILLY
000799r 1  20 rr rr     @sd:    jsr     spr_send
00079Cr 1  A9 50                lda     #80
00079Er 1  20 rr rr             jsr     delay_ms
0007A1r 1  AE rr rr             ldx     tmp3
0007A4r 1  CA                   dex
0007A5r 1  D0 DF                bne     @b
0007A7r 1  CE rr rr             dec     lives
0007AAr 1  A9 01                lda     #1
0007ACr 1  8D rr rr             sta     hud_dirty
0007AFr 1  20 rr rr             jsr     hud_update
0007B2r 1  AD rr rr             lda     lives
0007B5r 1  D0 03                bne     @more
0007B7r 1  4C rr rr             jmp     game_over
0007BAr 1  4C rr rr     @more:  jmp     start_room
0007BDr 1               
0007BDr 1               ; through the portal: the air left goes to the score, then the next room
0007BDr 1               room_done:
0007BDr 1  A9 rr                lda     #<hideall_txt
0007BFr 1  A0 rr                ldy     #>hideall_txt
0007C1r 1  20 rr rr             jsr     print
0007C4r 1  A2 0F                ldx     #NSLOT-1
0007C6r 1  A9 00                lda     #0
0007C8r 1  9D rr rr     @f:     sta     sl_on,x
0007CBr 1  CA                   dex
0007CCr 1  10 FA                bpl     @f
0007CEr 1  20 rr rr             jsr     sfx_off
0007D1r 1  A9 08                lda     #SND_ROOM
0007D3r 1  20 rr rr             jsr     sfx_snd
0007D6r 1  A9 0A                lda     #10
0007D8r 1  20 rr rr             jsr     delay_long
0007DBr 1  AD rr rr     @a:     lda     air             ; 10 points a unit of air
0007DEr 1  F0 1E                beq     @next
0007E0r 1  29 03                and     #3              ; (a tick every 4)
0007E2r 1  D0 05                bne     @nt
0007E4r 1  A9 05                lda     #SND_AIRTICK
0007E6r 1  20 rr rr             jsr     sfx_snd
0007E9r 1  20 rr rr     @nt:    jsr     air_down
0007ECr 1  A9 10                lda     #$10
0007EEr 1  A0 00                ldy     #0
0007F0r 1  20 rr rr             jsr     add_score
0007F3r 1  20 rr rr             jsr     hud_update
0007F6r 1  A9 08                lda     #8
0007F8r 1  20 rr rr             jsr     delay_ms
0007FBr 1  4C rr rr             jmp     @a
0007FEr 1  A9 0A        @next:  lda     #10
000800r 1  20 rr rr             jsr     delay_long
000803r 1  EE rr rr             inc     room
000806r 1  AD rr rr             lda     room
000809r 1  C9 08                cmp     #NROOM
00080Br 1  90 1B                bcc     @r
00080Dr 1  A9 00                lda     #0              ; all of them: round again
00080Fr 1  8D rr rr             sta     room
000812r 1  A9 09                lda     #SND_ALLA
000814r 1  20 rr rr             jsr     sfx_snd
000817r 1  A9 0A                lda     #SND_ALLB
000819r 1  20 rr rr             jsr     sfx_snd
00081Cr 1  A9 rr                lda     #<allclear_txt
00081Er 1  A0 rr                ldy     #>allclear_txt
000820r 1  20 rr rr             jsr     print
000823r 1  A9 28                lda     #40
000825r 1  20 rr rr             jsr     delay_long
000828r 1  4C rr rr     @r:     jmp     start_room
00082Br 1               
00082Br 1               game_over:
00082Br 1  A2 02                ldx     #2              ; new high score?
00082Dr 1  BD rr rr     @hc:    lda     score,x
000830r 1  DD rr rr             cmp     hiscore,x
000833r 1  90 1A                bcc     @nohi
000835r 1  D0 05                bne     @hi
000837r 1  CA                   dex
000838r 1  10 F3                bpl     @hc
00083Ar 1  30 13                bmi     @nohi
00083Cr 1  A2 02        @hi:    ldx     #2
00083Er 1  BD rr rr     @hs:    lda     score,x
000841r 1  9D rr rr             sta     hiscore,x
000844r 1  CA                   dex
000845r 1  10 F7                bpl     @hs
000847r 1  A9 01                lda     #1
000849r 1  8D rr rr             sta     hud_dirty
00084Cr 1  20 rr rr             jsr     hud_update
00084Fr 1  A9 0B        @nohi:  lda     #SND_OVER
000851r 1  20 rr rr             jsr     sfx_snd
000854r 1  A9 rr                lda     #<hideall_txt
000856r 1  A0 rr                ldy     #>hideall_txt
000858r 1  20 rr rr             jsr     print
00085Br 1  A9 rr                lda     #<over_txt
00085Dr 1  A0 rr                ldy     #>over_txt
00085Fr 1  20 rr rr             jsr     print
000862r 1  A9 14                lda     #20
000864r 1  20 rr rr             jsr     delay_long
000867r 1  20 rr rr     @wait:  jsr     menu_key
00086Ar 1  C9 51                cmp     #'Q'
00086Cr 1  D0 03                bne     @nq
00086Er 1  4C rr rr             jmp     title
000871r 1  C9 4D        @nq:    cmp     #'M'
000873r 1  D0 06                bne     @nm
000875r 1  20 rr rr             jsr     sfx_toggle
000878r 1  4C rr rr             jmp     @wait
00087Br 1  C9 20        @nm:    cmp     #' '
00087Dr 1  F0 04                beq     @again
00087Fr 1  C9 80                cmp     #PAD_GO
000881r 1  D0 E4                bne     @wait
000883r 1  4C rr rr     @again: jmp     new_game
000886r 1               
000886r 1               ; ============================================================================
000886r 1               ; the room
000886r 1               ; ============================================================================
000886r 1               ; the room's data (room_lo / hi, room) into its variables and map
000886r 1               load_room:
000886r 1  AE rr rr             ldx     room
000889r 1  BD rr rr             lda     room_lo,x
00088Cr 1  8D rr rr             sta     src
00088Fr 1  BD rr rr             lda     room_hi,x
000892r 1  8D rr rr             sta     src+1
000895r 1  A9 20                lda     #32             ; (the name is drawn from there)
000897r 1  20 rr rr             jsr     src_add
00089Ar 1  20 rr rr             jsr     src_get         ; air
00089Dr 1  8D rr rr             sta     air
0008A0r 1  20 rr rr             jsr     src_get         ; Willy
0008A3r 1  8D rr rr             sta     w_x
0008A6r 1  20 rr rr             jsr     src_get
0008A9r 1  8D rr rr             sta     w_y
0008ACr 1  20 rr rr             jsr     src_get         ; the portal
0008AFr 1  8D rr rr             sta     p_x
0008B2r 1  20 rr rr             jsr     src_get
0008B5r 1  8D rr rr             sta     p_y
0008B8r 1  20 rr rr             jsr     src_get         ; the guardians
0008BBr 1  8D rr rr             sta     ng
0008BEr 1  A2 00                ldx     #0
0008C0r 1  EC rr rr     @g:     cpx     ng
0008C3r 1  F0 37                beq     @gd
