ca65 V2.19 - Git a6530f4
Main file   : miner.s
Current file: miner.s

000000r 1               ; ============================================================================
000000r 1               ; miner.s - MINER MOS, a single screen platform game for the 6502 SBC, in the
000000r 1               ; style of the 1983 classic: collect the keys in each room, then get to the
000000r 1               ; portal before the air runs out
000000r 1               ;
000000r 1               ; Runs from the monitor at $0500 and draws on the PIC32 terminal in its
000000r 1               ; control code mode (setup item J), with the terminal's sprite layer
000000r 1               ; (control code 1C: the firmware with the sprite layer, VGA).
000000r 1               ;
000000r 1               ;   build:  make.bat  (or make)     needs ../sbc_api.inc (CLOCK_MHZ)
000000r 1               ;   run:    L MINER 0500   then   R
000000r 1               ;
000000r 1               ; Header (patchable from the monitor):
000000r 1               ;   $0500  JMP start
000000r 1               ;   $0503  frame time in ms (default 40; real ms at any clock)
000000r 1               ;   $0504  controls at start: 0 keyboard, 1 gamepad
000000r 1               ;   $0505  sound at start: 0 on, 1 off (M switches)
000000r 1               ;
000000r 1               ; Sound: the AY-3-8910 card at $7F22/$7F23, through ../ay/sfx.s (timed by
000000r 1               ; the VIA's timer 2): "In the Hall of the Mountain King" (Grieg; public
000000r 1               ; domain) and effects, in miner_sound.inc (made by ../ay/tools/
000000r 1               ; game_sounds.py).  Without the card the game is just silent.
000000r 1               ;
000000r 1               ; Keys:    A / D or Left / Right  walk      Space, W or Up  jump
000000r 1               ;          P pause   M sound on / off   Q quit
000000r 1               ; Gamepad: left / right walk, A, B or up jump, Start pause
000000r 1               ;
000000r 1               ; The screen: the room on text rows 0-19 (40 x 20 tiles of 4 x 4 pixels,
000000r 1               ; each 2 block graphics characters), its name on row 20, the air on row 21,
000000r 1               ; the score on row 23.  The tiles are characters, drawn when the room
000000r 1               ; starts and again only when one changes (a key taken, a crumbling floor).
000000r 1               ; Willy, the guardians and the portal are the terminal's sprites: each frame
000000r 1               ; only what changed goes, between HOLD and SHOW, then IDENTIFY, whose answer
000000r 1               ; the next frame waits for.  Coordinates are the sprite layer's pixels (160
000000r 1               ; x 96, 3 x 3 screen pixels each).  The rules of movement are in phys.py
000000r 1               ; too (the same, step by step), for the room checks and the tests.  No zero
000000r 1               ; page is used.
000000r 1               ; ============================================================================
000000r 1               
000000r 1                       .setcpu "6502"
000000r 1                       .include "sbc_api.inc"
000000r 2               ; sbc_api.inc - fixed ROM entry points of the SBC (see jumptable.s), and the
000000r 2               ; CPU clock.  Use in your own ca65 programs:  .include "sbc_api.inc"
000000r 2               ; (the games find it one folder up: their make.bat passes  -I ..  to ca65)
000000r 2               SBC_CHRIN       = $FE00         ; carry set + A = char, carry clear = none waiting
000000r 2               SBC_CHROUT      = $FE03         ; print A (A, X, Y preserved)
000000r 2               SBC_MENU        = $FE06         ; boot menu
000000r 2               SBC_COLD        = $FE09         ; BASIC cold start
000000r 2               SBC_WARM        = $FE0C         ; BASIC warm start
000000r 2               SBC_MONITOR     = $FE0F         ; monitor prompt (or JMP $FF00)
000000r 2               SBC_PADSTATE    = $FE12         ; A = gamepad buttons held: bit0 A,1 B,2 Select,3 Start,4 Up,5 Down,6 Left,7 Right
000000r 2               SBC_LOAD        = $FE15         ; load a file: A/Y = parameter block (.word addr, .word max, "NAME.EXT",0)
000000r 2                                               ;   carry clear = loaded, X/Y = length; carry set = failed, A = error code
000000r 2               
000000r 2               ; The CPU clock in MHz (whole numbers, 1 to 8).  Programs size their delay
000000r 2               ; loops from it, so a millisecond stays a millisecond.  To build for another
000000r 2               ; clock, change it here or give it on the command line:  make.bat 1
000000r 2               .ifndef CLOCK_MHZ
000000r 2               CLOCK_MHZ       = 2
000000r 2               .endif
000000r 2               
000000r 1               
000000r 1               SPEED_DEFAULT   = 40            ; ms per frame
000000r 1               
000000r 1               ; ---- terminal --------------------------------------------------------------------
000000r 1               TC_CURSOR       = $02
000000r 1               TC_CLS          = $0C
000000r 1               TC_COL          = $0E
000000r 1               TC_ROW          = $0F
000000r 1               TC_ATTR         = $18
000000r 1               TC_LIT          = $1A
000000r 1               TC_SPR          = $1C
000000r 1               ATTR_TEXT       = $00
000000r 1               ATTR_GFX        = $80
000000r 1               TERM            = $FF
000000r 1               .define RV_ON   $1B, '[', '7', 'm'
000000r 1               .define RV_OFF  $1B, '[', '2', '7', 'm'
000000r 1               SPR_PLACE       = 2
000000r 1               SPR_MOVE        = 3
000000r 1               SPR_PIC         = 4
000000r 1               SPR_HIDE        = 6
000000r 1               
000000r 1               ; ---- the room ----------------------------------------------------------------------
000000r 1               COLS            = 40            ; tiles
000000r 1               ROWS            = 20
000000r 1               NTILE           = COLS * ROWS
000000r 1               EMPTY           = 0             ; tiles
000000r 1               FLOOR           = 1
000000r 1               WALL            = 2
000000r 1               CONV_L          = 3
000000r 1               CONV_R          = 4
000000r 1               CR0             = 5             ; crumbling floor, 3 stages
000000r 1               CR2             = 7
000000r 1               HAZARD          = 8
000000r 1               KEY             = 9
000000r 1               NAME_ROW        = 20
000000r 1               AIR_ROW         = 21
000000r 1               AIR_COL         = 4
000000r 1               AIR_RATE        = 12            ; frames a unit of air lasts
000000r 1               
000000r 1               ; ---- Willy -------------------------------------------------------------------------
000000r 1               W_W             = 6             ; his box
000000r 1               W_H             = 8
000000r 1               FALL_MAX        = 24            ; a fall longer than this kills
000000r 1               CRUMBLE_T       = 6             ; frames on a crumbling floor per stage
000000r 1               ST_STAND        = 0
000000r 1               ST_JUMP         = 1
000000r 1               ST_FALL         = 2
000000r 1               
000000r 1               ; ---- sprite slots (higher on top) -----------------------------------------------------
000000r 1               NSLOT           = 16
000000r 1               SL_WILLY        = 15
000000r 1               SL_GUARD        = 8             ; 8-14
000000r 1               MAXG            = 7
000000r 1               SL_PORTAL       = 0
000000r 1               
000000r 1               ; ============================================================================
