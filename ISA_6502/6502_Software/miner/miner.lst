0002F6r 2  9D rr rr             sta     sfx_lph,x
0002F9r 2  4C rr rr             jmp     @cmd
0002FCr 2  BD rr rr     @nx:    lda     sfx_lcnt,x
0002FFr 2  F0 05                beq     @back           ; (0: for ever)
000301r 2  DE rr rr             dec     sfx_lcnt,x
