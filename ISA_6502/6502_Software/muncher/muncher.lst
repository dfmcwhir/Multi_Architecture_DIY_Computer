000468r 1               
000468r 1               ; wait about A ms.  The inner loop is sized for the clock (CLOCK_MHZ in
000468r 1               ; sbc_api.inc): 5 + 4 * (CLOCK_MHZ - 1) cycles a turn, DELAY_N turns a ms.
000468r 1               DELAY_N = (1000 * CLOCK_MHZ - 7) / (5 + 4 * (CLOCK_MHZ - 1))
000468r 1               delay_ms:
000468r 1  AA                   tax
000469r 1  F0 0D                beq     @done
00046Br 1  20 rr rr     @o:     jsr     sfx_poll        ; (the sound goes on while waiting)
00046Er 1  A0 DD                ldy     #DELAY_N
000470r 1               @i:
000470r 1  EA EA        .repeat CLOCK_MHZ - 1           ; (4 more cycles a turn for each MHz above 1)
000472r 1                       nop
000472r 1                       nop
000472r 1               .endrepeat
000472r 1  88                   dey
000473r 1  D0 FB                bne     @i
000475r 1  CA                   dex
000476r 1  D0 F3                bne     @o
000478r 1  60           @done:  rts
000479r 1               
000479r 1               ; wait about A x 50 ms
000479r 1               delay_long:
000479r 1  8D rr rr             sta     tmp
00047Cr 1  A9 32        @l:     lda     #50
00047Er 1  20 rr rr             jsr     delay_ms
000481r 1  20 rr rr             jsr     flush_in        ; keys pressed meanwhile are dropped (so the
000484r 1  CE rr rr             dec     tmp             ; ROM's keyboard buffer never fills up)
000487r 1  D0 F3                bne     @l
000489r 1  60                   rts
00048Ar 1               
00048Ar 1               ; 16 bit Galois LFSR.  Returns a random byte in A.  Preserves X and Y.
00048Ar 1  AD rr rr     rand:   lda     rng+1
00048Dr 1  4A                   lsr
00048Er 1  6E rr rr             ror     rng
000491r 1  90 02                bcc     @n
000493r 1  49 B4                eor     #$B4
000495r 1  8D rr rr     @n:     sta     rng+1
000498r 1  4D rr rr             eor     rng
00049Br 1  60                   rts
00049Cr 1               
00049Cr 1               .macro MENU_IDLE
00049Cr 1                       jsr     rand            ; stir the random numbers while waiting
00049Cr 1                       jsr     sfx_poll
00049Cr 1               .endmacro
00049Cr 1               CTRL_COL        = 19
00049Cr 1               CTRL_ROW        = 18
00049Cr 1               
00049Cr 1               ; ============================================================================
00049Cr 1               ; gamepad and menu input (shared by the SBC games)
00049Cr 1               ; ============================================================================
00049Cr 1               PAD_A           = $01           ; bits returned by SBC_PADSTATE
00049Cr 1               PAD_B           = $02
00049Cr 1               PAD_SELECT      = $04
00049Cr 1               PAD_START       = $08
00049Cr 1               PAD_UP          = $10
00049Cr 1               PAD_DOWN        = $20
00049Cr 1               PAD_LEFT        = $40
00049Cr 1               PAD_RIGHT       = $80
00049Cr 1               PAD_GO          = $80           ; menu_key's answer for gamepad A or Start
00049Cr 1               
00049Cr 1               ; read the gamepad: pad = buttons held now, padnew = buttons pressed since
00049Cr 1               ; the last call.  Preserves X and Y (SBC_PADSTATE only changes A).
00049Cr 1               read_pad:
00049Cr 1  20 12 FE             jsr     SBC_PADSTATE
00049Fr 1  C9 FF                cmp     #$FF            ; every button "pressed" = no pad
0004A1r 1  D0 02                bne     @ok
0004A3r 1  A9 00                lda     #0
0004A5r 1  8D rr rr     @ok:    sta     pad
0004A8r 1  AD rr rr             lda     padold
0004ABr 1  49 FF                eor     #$FF
0004ADr 1  2D rr rr             and     pad
0004B0r 1  8D rr rr             sta     padnew
0004B3r 1  AD rr rr             lda     pad
0004B6r 1  8D rr rr             sta     padold
0004B9r 1  60                   rts
0004BAr 1               
0004BAr 1               ; throw away waiting characters
0004BAr 1               flush_in:
0004BAr 1  20 00 FE             jsr     getc
0004BDr 1  B0 FB                bcs     flush_in
0004BFr 1  60                   rts
0004C0r 1               
0004C0r 1               ; carry set if A is one of the characters the gamepad driver types for the
0004C0r 1               ; pad (W A S D and space).  Those are ignored in gamepad mode so that one
0004C0r 1               ; press doesn't act twice.  Preserves A.
0004C0r 1               pad_typed:
0004C0r 1  C9 20                cmp     #' '
0004C2r 1  F0 12                beq     @y
0004C4r 1  C9 57                cmp     #'W'
0004C6r 1  F0 0E                beq     @y
0004C8r 1  C9 41                cmp     #'A'
0004CAr 1  F0 0A                beq     @y
0004CCr 1  C9 53                cmp     #'S'
0004CEr 1  F0 06                beq     @y
0004D0r 1  C9 44                cmp     #'D'
0004D2r 1  F0 02                beq     @y
0004D4r 1  18                   clc
0004D5r 1  60                   rts
0004D6r 1  38           @y:     sec
0004D7r 1  60                   rts
0004D8r 1               
0004D8r 1               ; wait for a menu choice.  Returns a key (letters in upper case), or
0004D8r 1               ; PAD_GO for the gamepad's A or Start button.
0004D8r 1               menu_key:
0004D8r 1  20 rr rr 20  @l:     MENU_IDLE
0004DCr 1  rr rr        
0004DEr 1  20 rr rr             jsr     read_pad
0004E1r 1  AD rr rr             lda     padnew
0004E4r 1  29 09                and     #PAD_A | PAD_START
0004E6r 1  D0 21                bne     @pad
0004E8r 1  20 00 FE             jsr     getc
0004EBr 1  90 EB                bcc     @l
0004EDr 1  C9 20                cmp     #' '            ; a space typed by the pad's A button?
0004EFr 1  D0 0D                bne     @up
0004F1r 1  20 rr rr             jsr     read_pad
0004F4r 1  AD rr rr             lda     pad
0004F7r 1  29 01                and     #PAD_A
0004F9r 1  D0 0E                bne     @pad
0004FBr 1  A9 20                lda     #' '
0004FDr 1  60                   rts
0004FEr 1  C9 61        @up:    cmp     #'a'
000500r 1  90 06                bcc     @r
000502r 1  C9 7B                cmp     #'z'+1
000504r 1  B0 02                bcs     @r
000506r 1  29 DF                and     #$DF
000508r 1  60           @r:     rts
000509r 1  20 rr rr     @pad:   jsr     flush_in        ; the space the driver typed for it
00050Cr 1  A9 80                lda     #PAD_GO
00050Er 1  60                   rts
00050Fr 1               
00050Fr 1               ; print the controls line (CTRL_COL, CTRL_ROW)
00050Fr 1               show_ctrl:
00050Fr 1  20 rr rr             jsr     txt_mode
000512r 1  A2 13                ldx     #CTRL_COL
000514r 1  A0 12                ldy     #CTRL_ROW
000516r 1  20 rr rr             jsr     gotoxy
000519r 1  AD rr rr             lda     ctrl
00051Cr 1  F0 07                beq     @kb
00051Er 1  A9 rr                lda     #<ctrl_pad_txt
000520r 1  A0 rr                ldy     #>ctrl_pad_txt
000522r 1  4C rr rr             jmp     print
000525r 1  A9 rr        @kb:    lda     #<ctrl_kb_txt
000527r 1  A0 rr                ldy     #>ctrl_kb_txt
000529r 1  4C rr rr             jmp     print
00052Cr 1               
00052Cr 1               
00052Cr 1               ; ============================================================================
00052Cr 1               ; the maze in RAM
00052Cr 1               ; ============================================================================
00052Cr 1               
00052Cr 1               ; point mz_rd / mz_wr at tile X, Y.  Preserves X and Y.
00052Cr 1  8A           mz_at:  txa
00052Dr 1  18                   clc
00052Er 1  79 rr rr             adc     mrow_lo,y
000531r 1  8D rr rr             sta     mz_rd+1
000534r 1  8D rr rr             sta     mz_wr+1
000537r 1  B9 rr rr             lda     mrow_hi,y
00053Ar 1  69 00                adc     #0
00053Cr 1  8D rr rr             sta     mz_rd+2
00053Fr 1  8D rr rr             sta     mz_wr+2
000542r 1  60                   rts
000543r 1  AD FF FF     mz_rd:  lda     $FFFF
000546r 1  60                   rts
000547r 1  8D FF FF     mz_wr:  sta     $FFFF
00054Ar 1  60                   rts
00054Br 1               
00054Br 1               ; A = tile at X, Y.  Preserves X and Y.
00054Br 1               tile_get:
00054Br 1  20 rr rr             jsr     mz_at
00054Er 1  4C rr rr             jmp     mz_rd
000551r 1               
000551r 1               ; copy the maze from ROM (4 pages; the maze is 21 x 40 = 840 bytes)
000551r 1               copy_maze:
000551r 1  A9 rr                lda     #<maze_src
000553r 1  8D rr rr             sta     @rd+1
000556r 1  A9 rr                lda     #>maze_src
000558r 1  8D rr rr             sta     @rd+2
00055Br 1  A9 rr                lda     #>maze
00055Dr 1  8D rr rr             sta     @wr+2
000560r 1  A2 04                ldx     #4
000562r 1  A0 00                ldy     #0
000564r 1  B9 FF FF     @rd:    lda     $FFFF,y
000567r 1  99 rr rr     @wr:    sta     maze,y
00056Ar 1  C8                   iny
00056Br 1  D0 F7                bne     @rd
00056Dr 1  EE rr rr             inc     @rd+2
000570r 1  EE rr rr             inc     @wr+2
000573r 1  CA                   dex
000574r 1  D0 EE                bne     @rd
000576r 1  A9 82                lda     #<DOTS_TOTAL
000578r 1  8D rr rr             sta     dots
00057Br 1  A9 01                lda     #>DOTS_TOTAL
00057Dr 1  8D rr rr             sta     dots+1
000580r 1  60                   rts
000581r 1               
000581r 1               ; carry set if tile X, Y counts as open for drawing wall outlines (anything
000581r 1               ; but a wall or the door; outside the maze is open too).  Preserves X, Y.
000581r 1  E0 27        is_open:cpx     #MAZE_W
000583r 1  B0 0F                bcs     @yes
000585r 1  C0 15                cpy     #MAZE_H
000587r 1  B0 0B                bcs     @yes
000589r 1  20 rr rr             jsr     tile_get
00058Cr 1  C9 03                cmp     #T_WALL
00058Er 1  F0 06                beq     @no
000590r 1  C9 04                cmp     #T_DOOR
000592r 1  F0 02                beq     @no
000594r 1  38           @yes:   sec
000595r 1  60                   rts
000596r 1  18           @no:    clc
000597r 1  60                   rts
000598r 1               
000598r 1               ; the two characters for tile dt_x, dt_y -> g0, g1
000598r 1               tile_gfx_at:
000598r 1  AE rr rr             ldx     dt_x
00059Br 1  AC rr rr             ldy     dt_y
00059Er 1  20 rr rr             jsr     tile_get
0005A1r 1  8D rr rr             sta     dt_t
0005A4r 1  C9 03                cmp     #T_WALL
0005A6r 1  F0 0F                beq     @wall
0005A8r 1  0A                   asl
0005A9r 1  AA                   tax
0005AAr 1  BD rr rr             lda     tile_gfx,x
0005ADr 1  8D rr rr             sta     g0
0005B0r 1  BD rr rr             lda     tile_gfx+1,x
0005B3r 1  8D rr rr             sta     g1
0005B6r 1  60                   rts
0005B7r 1  A9 00        @wall:  lda     #0              ; a line on every side that faces an open tile
0005B9r 1  8D rr rr             sta     g0
0005BCr 1  8D rr rr             sta     g1
0005BFr 1  A9 07                lda     #7
0005C1r 1  8D rr rr             sta     nbi
0005C4r 1  AC rr rr     @nb:    ldy     nbi
0005C7r 1  AD rr rr             lda     dt_x
0005CAr 1  18                   clc
0005CBr 1  79 rr rr             adc     nb_dx,y
0005CEr 1  AA                   tax
0005CFr 1  AD rr rr             lda     dt_y
0005D2r 1  18                   clc
0005D3r 1  79 rr rr             adc     nb_dy,y
0005D6r 1  A8                   tay
0005D7r 1  20 rr rr             jsr     is_open
0005DAr 1  90 15                bcc     @next
0005DCr 1  AC rr rr             ldy     nbi
0005DFr 1  AD rr rr             lda     g0
0005E2r 1  19 rr rr             ora     nb_ml,y
0005E5r 1  8D rr rr             sta     g0
0005E8r 1  AD rr rr             lda     g1
0005EBr 1  19 rr rr             ora     nb_mr,y
0005EEr 1  8D rr rr             sta     g1
0005F1r 1  CE rr rr     @next:  dec     nbi
0005F4r 1  10 CE                bpl     @nb
0005F6r 1  60                   rts
0005F7r 1               
0005F7r 1               ; draw tile X, Y
0005F7r 1               draw_tile:
0005F7r 1  8E rr rr             stx     dt_x
0005FAr 1  8C rr rr             sty     dt_y
0005FDr 1  20 rr rr             jsr     gfx_mode
000600r 1  A9 01                lda     #1
000602r 1  20 rr rr             jsr     set_rep
000605r 1  20 rr rr             jsr     tile_gfx_at
000608r 1  AD rr rr             lda     dt_x
00060Br 1  0A                   asl
00060Cr 1  AA                   tax
00060Dr 1  AC rr rr             ldy     dt_y
000610r 1  20 rr rr             jsr     goto_cell
000613r 1  AD rr rr             lda     dt_t
000616r 1  C9 03                cmp     #T_WALL
000618r 1  F0 06                beq     @wall
00061Ar 1  18                   clc
00061Br 1  69 0E                adc     #T_TILE0
00061Dr 1  4C rr rr             jmp     send_tile
000620r 1  AD rr rr     @wall:  lda     g0
000623r 1  20 rr rr             jsr     putblk
000626r 1  AD rr rr             lda     g1
000629r 1  4C rr rr             jmp     putblk
00062Cr 1               
00062Cr 1               ; draw the whole maze, skipping empty tiles.  A run of the same tile (dots
00062Cr 1               ; mostly) is one tile sent with the repeat count.
00062Cr 1               draw_maze:
00062Cr 1  20 rr rr             jsr     gfx_mode
00062Fr 1  20 rr rr             jsr     lose_cursor
000632r 1  A9 00                lda     #0
000634r 1  8D rr rr             sta     dt_y
000637r 1  A9 00        @row:   lda     #0
000639r 1  8D rr rr             sta     dt_x
00063Cr 1  20 rr rr     @col:   jsr     tile_gfx_at
00063Fr 1  AD rr rr             lda     g0
000642r 1  0D rr rr             ora     g1
000645r 1  F0 6B                beq     @next           ; empty
000647r 1  AD rr rr             lda     dt_x
00064Ar 1  0A                   asl
00064Br 1  AA                   tax
00064Cr 1  AC rr rr             ldy     dt_y
00064Fr 1  20 rr rr             jsr     goto_cell
000652r 1  AD rr rr             lda     dt_t
000655r 1  C9 03                cmp     #T_WALL
000657r 1  D0 14                bne     @run
000659r 1  A9 01                lda     #1
00065Br 1  20 rr rr             jsr     set_rep
00065Er 1  AD rr rr             lda     g0
000661r 1  20 rr rr             jsr     putblk
000664r 1  AD rr rr             lda     g1
000667r 1  20 rr rr             jsr     putblk
00066Ar 1  4C rr rr             jmp     @next
00066Dr 1  8D rr rr     @run:   sta     mz_t            ; how many of this tile in a row (up to 15)
000670r 1  A9 01                lda     #1
000672r 1  8D rr rr             sta     mz_n
000675r 1  AD rr rr     @rl:    lda     dt_x
000678r 1  18                   clc
000679r 1  6D rr rr             adc     mz_n
00067Cr 1  C9 27                cmp     #MAZE_W
00067Er 1  B0 16                bcs     @rend
000680r 1  AA                   tax
000681r 1  AC rr rr             ldy     dt_y
000684r 1  20 rr rr             jsr     tile_get
000687r 1  CD rr rr             cmp     mz_t
00068Ar 1  D0 0A                bne     @rend
00068Cr 1  EE rr rr             inc     mz_n
00068Fr 1  AD rr rr             lda     mz_n
000692r 1  C9 0F                cmp     #15
000694r 1  90 DF                bcc     @rl
000696r 1  AD rr rr     @rend:  lda     mz_n
000699r 1  20 rr rr             jsr     set_rep
00069Cr 1  AD rr rr             lda     mz_t
00069Fr 1  18                   clc
0006A0r 1  69 0E                adc     #T_TILE0
0006A2r 1  20 rr rr             jsr     send_tile
0006A5r 1  AD rr rr             lda     dt_x
0006A8r 1  18                   clc
0006A9r 1  6D rr rr             adc     mz_n
0006ACr 1  8D rr rr             sta     dt_x
0006AFr 1  CE rr rr             dec     dt_x            ; (the loop steps on one)
0006B2r 1  EE rr rr     @next:  inc     dt_x
0006B5r 1  AD rr rr             lda     dt_x
0006B8r 1  C9 27                cmp     #MAZE_W
0006BAr 1  D0 80                bne     @col
0006BCr 1  EE rr rr             inc     dt_y
0006BFr 1  AD rr rr             lda     dt_y
0006C2r 1  C9 15                cmp     #MAZE_H
0006C4r 1  F0 03                beq     *+5
0006C6r 1  4C rr rr             jmp     @row
0006C9r 1  A9 01                lda     #1
0006CBr 1  4C rr rr             jmp     set_rep
0006CEr 1               
0006CEr 1               ; ============================================================================
0006CEr 1               ; start / title
0006CEr 1               ; ============================================================================
0006CEr 1  D8           start:  cld
0006CFr 1  A2 FF                ldx     #$FF
0006D1r 1  9A                   txs
0006D2r 1  A9 00                lda     #0              ; clear every variable: RAM is random at power-up
0006D4r 1  A2 80                ldx     #bss_end - bss_start
0006D6r 1  9D rr rr     @clr:   sta     bss_start-1,x
0006D9r 1  CA                   dex
0006DAr 1  D0 FA                bne     @clr
0006DCr 1  AD rr rr             lda     ctrl_def
0006DFr 1  8D rr rr             sta     ctrl
0006E2r 1  A9 00                lda     #0
0006E4r 1  8D rr rr             sta     hiscore
0006E7r 1  8D rr rr             sta     hiscore+1
0006EAr 1  8D rr rr             sta     hiscore+2
0006EDr 1  A9 C3                lda     #$C3
0006EFr 1  8D rr rr             sta     rng
0006F2r 1  A9 FF                lda     #$FF
0006F4r 1  8D rr rr             sta     attr
0006F7r 1  20 rr rr             jsr     read_pad
0006FAr 1  20 rr rr             jsr     sfx_init
0006FDr 1  AD rr rr             lda     mute_def
000700r 1  8D rr rr             sta     sfx_mute
000703r 1               
000703r 1  20 rr rr     title:  jsr     sfx_off
000706r 1  A9 FF                lda     #$FF
000708r 1  8D rr rr             sta     attr
00070Br 1  A9 rr                lda     #<title_txt
00070Dr 1  A0 rr                ldy     #>title_txt
00070Fr 1  20 rr rr             jsr     print
000712r 1  20 rr rr             jsr     def_tiles
000715r 1  20 rr rr             jsr     gfx_mode        ; the cast
000718r 1  A2 1C                ldx     #28
00071Ar 1  A0 08                ldy     #8
00071Cr 1  20 rr rr             jsr     gotoxy
00071Fr 1  A2 08                ldx     #SP_RIGHT
000721r 1  20 rr rr             jsr     put_sprite
000724r 1  A2 1C                ldx     #28
000726r 1  A0 0A                ldy     #10
000728r 1  20 rr rr             jsr     gotoxy
00072Br 1  A2 12                ldx     #SP_GHOST1
00072Dr 1  20 rr rr             jsr     put_sprite
000730r 1  A2 1C                ldx     #28
000732r 1  A0 0C                ldy     #12
000734r 1  20 rr rr             jsr     gotoxy
000737r 1  A2 16                ldx     #SP_SCARED1
000739r 1  20 rr rr             jsr     put_sprite
00073Cr 1  A2 1C                ldx     #28
00073Er 1  A0 0E                ldy     #14
000740r 1  20 rr rr             jsr     gotoxy
000743r 1  A9 0F                lda     #T_TILE0+T_DOT
000745r 1  20 rr rr             jsr     send_tile
000748r 1  A2 1C                ldx     #28
00074Ar 1  A0 0F                ldy     #15
00074Cr 1  20 rr rr             jsr     gotoxy
00074Fr 1  A9 10                lda     #T_TILE0+T_PILL
000751r 1  20 rr rr             jsr     send_tile
000754r 1  20 rr rr             jsr     show_ctrl
000757r 1  20 rr rr             jsr     read_pad
00075Ar 1  20 rr rr     @wait:  jsr     menu_key
00075Dr 1  C9 51                cmp     #'Q'
00075Fr 1  D0 03                bne     @notq
000761r 1  4C rr rr             jmp     exit_game
000764r 1  C9 4D        @notq:  cmp     #'M'            ; sound on / off
000766r 1  D0 06                bne     @notm
000768r 1  20 rr rr             jsr     sfx_toggle
00076Br 1  4C rr rr             jmp     @wait
00076Er 1  C9 47        @notm:  cmp     #'G'            ; switch keyboard / gamepad
000770r 1  D0 0E                bne     @notg
000772r 1  AD rr rr             lda     ctrl
000775r 1  49 01                eor     #1
000777r 1  8D rr rr             sta     ctrl
00077Ar 1  20 rr rr             jsr     show_ctrl
00077Dr 1  4C rr rr             jmp     @wait
000780r 1  C9 80        @notg:  cmp     #PAD_GO         ; A or Start on the pad: play with the pad
000782r 1  D0 07                bne     @notp
000784r 1  A9 01                lda     #1
000786r 1  8D rr rr             sta     ctrl
000789r 1  D0 04                bne     new_game
00078Br 1  C9 20        @notp:  cmp     #' '
00078Dr 1  D0 CB                bne     @wait
00078Fr 1               
00078Fr 1               ; ---- a new game ------------------------------------------------------------------
00078Fr 1               new_game:
00078Fr 1  A9 00                lda     #0
000791r 1  8D rr rr             sta     score
000794r 1  8D rr rr             sta     score+1
000797r 1  8D rr rr             sta     score+2
00079Ar 1  8D rr rr             sta     level
00079Dr 1  A9 03                lda     #3
00079Fr 1  8D rr rr             sta     lives
0007A2r 1  A9 01                lda     #1              ; (the tune before the first READY)
0007A4r 1  8D rr rr             sta     fresh
0007A7r 1               new_level:
0007A7r 1  20 rr rr             jsr     copy_maze
0007AAr 1  20 rr rr             jsr     level_speeds
0007ADr 1  A9 FF                lda     #$FF
0007AFr 1  8D rr rr             sta     attr
0007B2r 1  A9 rr                lda     #<cls_txt
0007B4r 1  A0 rr                ldy     #>cls_txt
0007B6r 1  20 rr rr             jsr     print
0007B9r 1  20 rr rr             jsr     draw_maze
0007BCr 1  A9 rr                lda     #<hud_txt
0007BEr 1  A0 rr                ldy     #>hud_txt
0007C0r 1  20 rr rr             jsr     print
0007C3r 1  20 rr rr             jsr     show_score
0007C6r 1  20 rr rr             jsr     show_lives
0007C9r 1  20 rr rr             jsr     show_level
0007CCr 1               new_life:
0007CCr 1  20 rr rr             jsr     reset_actors
0007CFr 1  20 rr rr             jsr     redraw_actors
0007D2r 1  20 rr rr             jsr     ready           ; "READY!" for a moment
0007D5r 1               
0007D5r 1               ; ---- the game loop -----------------------------------------------------------------
0007D5r 1               game_loop:
0007D5r 1  20 rr rr             jsr     sfx_poll
0007D8r 1  20 rr rr             jsr     read_input
0007DBr 1  AD rr rr             lda     quit
0007DEr 1  F0 03                beq     @play
0007E0r 1  4C rr rr             jmp     title
0007E3r 1  EE rr rr     @play:  inc     tick
0007E6r 1  20 rr rr             jsr     move_player
0007E9r 1  20 rr rr             jsr     check_hits
0007ECr 1  20 rr rr             jsr     timers
0007EFr 1  A2 01                ldx     #1
0007F1r 1  8E rr rr     @g:     stx     gi
0007F4r 1  20 rr rr             jsr     move_ghost
0007F7r 1  AE rr rr             ldx     gi
