000BF9r 1  8D rr rr             sta     mode_t
000BFCr 1  A2 04                ldx     #NACT-1
000BFEr 1  BD rr rr     @rv:    lda     gst,x
000C01r 1  C9 02                cmp     #G_ACTIVE
000C03r 1  D0 05                bne     @rn
000C05r 1  A9 01                lda     #1
000C07r 1  9D rr rr             sta     grev,x
000C0Ar 1  CA           @rn:    dex
000C0Br 1  D0 F1                bne     @rv
000C0Dr 1  A2 04        @house: ldx     #NACT-1         ; ghosts waiting to come out
000C0Fr 1  BD rr rr     @hl:    lda     gst,x
000C12r 1  D0 10                bne     @hn
000C14r 1  BD rr rr             lda     grel,x
000C17r 1  F0 06                beq     @out
000C19r 1  DE rr rr             dec     grel,x
000C1Cr 1  4C rr rr             jmp     @hn
