000367r 1               ; ----------------------------------------------------------------------------
000367r 1               ; I/O helpers
000367r 1               ; ----------------------------------------------------------------------------
000367r 1               ; carry set = key in A.  After IDENTIFY (1C 0C) the terminal answers S P 1:
000367r 1               ; while IDENTIFYs are unanswered (rp_out) those are taken as answers, not
000367r 1               ; keys (nor ever, with this terminal: keys come in lower case, and an answer
000367r 1               ; coming late must not be taken as P = pause or S = hyperspace).  Each answer
000367r 1               ; counts once, at the first of its characters that comes
000367r 1               ; (the 6502 can miss some of the three, back to back at 115200): an S always
000367r 1               ; starts one; a P or 1 does if no S came; the 1 ends it.
000367r 1  20 00 FE     getc:   jsr     SBC_CHRIN
00036Ar 1  90 37                bcc     @r
00036Cr 1  48                   pha
00036Dr 1  AD rr rr             lda     hwspr           ; (with the sprite terminal capital S P 1 are
000370r 1  F0 2F                beq     @key            ;  never keys: a late answer isn't a pause)
000372r 1  68                   pla
000373r 1  C9 53                cmp     #'S'
000375r 1  F0 1D                beq     @new
000377r 1  C9 50                cmp     #'P'
000379r 1  F0 14                beq     @p
00037Br 1  C9 31                cmp     #'1'
00037Dr 1  D0 20                bne     @k2
00037Fr 1  AD rr rr             lda     rp_in           ; 1: the end (an answer, if nothing else of it came)
000382r 1  D0 03                bne     @e
000384r 1  20 rr rr             jsr     rp_one
000387r 1  A9 00        @e:     lda     #0
000389r 1  8D rr rr             sta     rp_in
00038Cr 1  4C rr rr             jmp     getc
00038Fr 1  AD rr rr     @p:     lda     rp_in
000392r 1  D0 D3                bne     getc
000394r 1  20 rr rr     @new:   jsr     rp_one
000397r 1  A9 01                lda     #1
000399r 1  8D rr rr             sta     rp_in
00039Cr 1  4C rr rr             jmp     getc
00039Fr 1  38           @k2:    sec
0003A0r 1  60                   rts
0003A1r 1  68           @key:   pla
0003A2r 1  38                   sec
0003A3r 1  60           @r:     rts
0003A4r 1               
0003A4r 1               ; an answer came: one fewer to wait for
0003A4r 1  AD rr rr     rp_one: lda     rp_out
0003A7r 1  F0 03                beq     @r
0003A9r 1  CE rr rr             dec     rp_out
0003ACr 1  60           @r:     rts
0003ADr 1               
0003ADr 1               ; send A (counts the bytes, for the frame timing).  Preserves A, X, Y.
0003ADr 1  EE rr rr     putc:   inc     nbytes
0003B0r 1  D0 03                bne     @p
0003B2r 1  EE rr rr             inc     nbytes+1
0003B5r 1  20 rr rr     @p:     jsr     sfx_poll        ; (the sound goes on while drawing)
0003B8r 1  4C 03 FE             jmp     SBC_CHROUT
0003BBr 1               
0003BBr 1               ; cursor to column X, row Y.  Preserves X and Y.
0003BBr 1  A9 0F        gotoxy: lda     #TC_ROW
0003BDr 1  20 rr rr             jsr     putc
0003C0r 1  98                   tya
0003C1r 1  20 rr rr             jsr     putc
0003C4r 1  A9 0E        setcol: lda     #TC_COL
0003C6r 1  20 rr rr             jsr     putc
0003C9r 1  8A                   txa
0003CAr 1  4C rr rr             jmp     putc
0003CDr 1               
0003CDr 1               txt_mode:
0003CDr 1  A9 00                lda     #ATTR_TEXT
0003CFr 1  F0 02                beq     setattr
0003D1r 1               gfx_mode:
0003D1r 1  A9 80                lda     #ATTR_GFX
0003D3r 1  CD rr rr     setattr:cmp     attr
0003D6r 1  F0 0D                beq     @r
0003D8r 1  8D rr rr             sta     attr
0003DBr 1  48                   pha
0003DCr 1  A9 18                lda     #TC_ATTR
0003DEr 1  20 rr rr             jsr     putc
0003E1r 1  68                   pla
0003E2r 1  4C rr rr             jmp     putc
0003E5r 1  60           @r:     rts
0003E6r 1               
0003E6r 1               ; repeat every character A times from now on (1..15), block graphics
0003E6r 1  8D rr rr     set_rep:sta     cur_rep
0003E9r 1  C9 02                cmp     #2
0003EBr 1  90 08                bcc     @one
0003EDr 1  0A                   asl
0003EEr 1  0A                   asl
0003EFr 1  0A                   asl
0003F0r 1  09 80                ora     #ATTR_GFX
0003F2r 1  4C rr rr             jmp     setattr         ; (sends it only if it changes)
0003F5r 1  A9 80        @one:   lda     #ATTR_GFX
0003F7r 1  4C rr rr             jmp     setattr
0003FAr 1               
0003FAr 1               ; a block graphics character (00-1F and 7F need the 1A prefix)
0003FAr 1  C9 20        putblk: cmp     #$20
0003FCr 1  90 04                bcc     @lit
0003FEr 1  C9 7F                cmp     #$7F
000400r 1  D0 07                bne     @out
000402r 1  48           @lit:   pha
000403r 1  A9 1A                lda     #TC_LIT
000405r 1  20 rr rr             jsr     putc
000408r 1  68                   pla
000409r 1  4C rr rr     @out:   jmp     putc
00040Cr 1               
00040Cr 1               ; print the string at A (lo) / Y (hi), ended by TERM (any length)
00040Cr 1  8D rr rr     print:  sta     @ld+1
00040Fr 1  8C rr rr             sty     @ld+2
000412r 1  AD FF FF     @ld:    lda     $FFFF
000415r 1  C9 FF                cmp     #TERM
000417r 1  F0 0D                beq     @done
000419r 1  20 rr rr             jsr     putc
00041Cr 1  EE rr rr             inc     @ld+1
00041Fr 1  D0 F1                bne     @ld
000421r 1  EE rr rr             inc     @ld+2
000424r 1  D0 EC                bne     @ld
000426r 1  A9 FF        @done:  lda     #$FF            ; (strings may change the attribute)
000428r 1  8D rr rr             sta     attr
00042Br 1  60                   rts
00042Cr 1               
00042Cr 1               ; print A as two BCD digits
00042Cr 1  48           prbcd:  pha
00042Dr 1  4A                   lsr
00042Er 1  4A                   lsr
00042Fr 1  4A                   lsr
000430r 1  4A                   lsr
000431r 1  09 30                ora     #'0'
000433r 1  20 rr rr             jsr     putc
000436r 1  68                   pla
000437r 1  29 0F                and     #$0F
000439r 1  09 30                ora     #'0'
00043Br 1  4C rr rr             jmp     putc
00043Er 1               
00043Er 1               ; 16 bit Galois LFSR.  A = a random byte.  Preserves X and Y.
00043Er 1  AD rr rr     rand:   lda     rng+1
000441r 1  4A                   lsr
000442r 1  6E rr rr             ror     rng
000445r 1  90 02                bcc     @n
000447r 1  49 B4                eor     #$B4
000449r 1  8D rr rr     @n:     sta     rng+1
00044Cr 1  4D rr rr             eor     rng
00044Fr 1  60                   rts
000450r 1               
000450r 1               ; wait about A ms.  The inner loop is sized for the clock (CLOCK_MHZ in
000450r 1               ; sbc_api.inc): 5 + 4 * (CLOCK_MHZ - 1) cycles a turn, DELAY_N turns a ms.
000450r 1               DELAY_N = (1000 * CLOCK_MHZ - 7) / (5 + 4 * (CLOCK_MHZ - 1))
000450r 1               delay_ms:
000450r 1  AA                   tax
000451r 1  F0 0D                beq     @done
000453r 1  20 rr rr     @o:     jsr     sfx_poll        ; (and while waiting)
000456r 1  A0 DD                ldy     #DELAY_N
000458r 1               @i:
000458r 1  EA EA        .repeat CLOCK_MHZ - 1
00045Ar 1                       nop
00045Ar 1                       nop
00045Ar 1               .endrepeat
00045Ar 1  88                   dey
00045Br 1  D0 FB                bne     @i
00045Dr 1  CA                   dex
00045Er 1  D0 F3                bne     @o
000460r 1  60           @done:  rts
000461r 1               
000461r 1               ; wait about A x 50 ms, dropping keys pressed meanwhile
000461r 1               delay_long:
000461r 1  8D rr rr             sta     tmp
000464r 1  A9 32        @l:     lda     #50
000466r 1  20 rr rr             jsr     delay_ms
000469r 1  20 rr rr             jsr     flush_in
00046Cr 1  CE rr rr             dec     tmp
00046Fr 1  D0 F3                bne     @l
000471r 1  60                   rts
000472r 1               
000472r 1               .macro MENU_IDLE
000472r 1                       jsr     rand            ; (waiting stirs the random numbers)
000472r 1                       jsr     sfx_poll
000472r 1               .endmacro
000472r 1               CTRL_COL        = 19
000472r 1               CTRL_ROW        = 18
000472r 1               
000472r 1               ; ============================================================================
000472r 1               ; gamepad and menu input (shared by the SBC games)
000472r 1               ; ============================================================================
000472r 1               PAD_A           = $01           ; bits returned by SBC_PADSTATE
000472r 1               PAD_B           = $02
000472r 1               PAD_SELECT      = $04
000472r 1               PAD_START       = $08
000472r 1               PAD_UP          = $10
000472r 1               PAD_DOWN        = $20
000472r 1               PAD_LEFT        = $40
000472r 1               PAD_RIGHT       = $80
000472r 1               PAD_GO          = $80           ; menu_key's answer for gamepad A or Start
000472r 1               
000472r 1               ; read the gamepad: pad = buttons held now, padnew = buttons pressed since
000472r 1               ; the last call.  Preserves X and Y (SBC_PADSTATE only changes A).
000472r 1               read_pad:
000472r 1  20 12 FE             jsr     SBC_PADSTATE
000475r 1  C9 FF                cmp     #$FF            ; every button "pressed" = no pad
000477r 1  D0 02                bne     @ok
000479r 1  A9 00                lda     #0
00047Br 1  8D rr rr     @ok:    sta     pad
00047Er 1  AD rr rr             lda     padold
000481r 1  49 FF                eor     #$FF
000483r 1  2D rr rr             and     pad
000486r 1  8D rr rr             sta     padnew
000489r 1  AD rr rr             lda     pad
00048Cr 1  8D rr rr             sta     padold
00048Fr 1  60                   rts
000490r 1               
000490r 1               ; throw away waiting characters
000490r 1               flush_in:
000490r 1  20 rr rr             jsr     getc
000493r 1  B0 FB                bcs     flush_in
000495r 1  60                   rts
000496r 1               
000496r 1               ; carry set if A is one of the characters the gamepad driver types for the
000496r 1               ; pad (W A S D and space).  Those are ignored in gamepad mode so that one
000496r 1               ; press doesn't act twice.  Preserves A.
000496r 1               pad_typed:
000496r 1  C9 20                cmp     #' '
000498r 1  F0 12                beq     @y
00049Ar 1  C9 57                cmp     #'W'
00049Cr 1  F0 0E                beq     @y
00049Er 1  C9 41                cmp     #'A'
0004A0r 1  F0 0A                beq     @y
0004A2r 1  C9 53                cmp     #'S'
0004A4r 1  F0 06                beq     @y
0004A6r 1  C9 44                cmp     #'D'
0004A8r 1  F0 02                beq     @y
0004AAr 1  18                   clc
0004ABr 1  60                   rts
0004ACr 1  38           @y:     sec
0004ADr 1  60                   rts
0004AEr 1               
0004AEr 1               ; wait for a menu choice.  Returns a key (letters in upper case), or
0004AEr 1               ; PAD_GO for the gamepad's A or Start button.
0004AEr 1               menu_key:
0004AEr 1  20 rr rr 20  @l:     MENU_IDLE
0004B2r 1  rr rr        
0004B4r 1  20 rr rr             jsr     read_pad
0004B7r 1  AD rr rr             lda     padnew
0004BAr 1  29 09                and     #PAD_A | PAD_START
0004BCr 1  D0 21                bne     @pad
0004BEr 1  20 rr rr             jsr     getc
0004C1r 1  90 EB                bcc     @l
0004C3r 1  C9 20                cmp     #' '            ; a space typed by the pad's A button?
0004C5r 1  D0 0D                bne     @up
0004C7r 1  20 rr rr             jsr     read_pad
0004CAr 1  AD rr rr             lda     pad
0004CDr 1  29 01                and     #PAD_A
0004CFr 1  D0 0E                bne     @pad
0004D1r 1  A9 20                lda     #' '
0004D3r 1  60                   rts
0004D4r 1  C9 61        @up:    cmp     #'a'
0004D6r 1  90 06                bcc     @r
0004D8r 1  C9 7B                cmp     #'z'+1
0004DAr 1  B0 02                bcs     @r
0004DCr 1  29 DF                and     #$DF
0004DEr 1  60           @r:     rts
0004DFr 1  20 rr rr     @pad:   jsr     flush_in        ; the space the driver typed for it
0004E2r 1  A9 80                lda     #PAD_GO
0004E4r 1  60                   rts
0004E5r 1               
0004E5r 1               ; print the controls line (CTRL_COL, CTRL_ROW)
0004E5r 1               show_ctrl:
0004E5r 1  20 rr rr             jsr     txt_mode
0004E8r 1  A2 13                ldx     #CTRL_COL
0004EAr 1  A0 12                ldy     #CTRL_ROW
0004ECr 1  20 rr rr             jsr     gotoxy
0004EFr 1  AD rr rr             lda     ctrl
0004F2r 1  F0 07                beq     @kb
0004F4r 1  A9 rr                lda     #<ctrl_pad_txt
0004F6r 1  A0 rr                ldy     #>ctrl_pad_txt
0004F8r 1  4C rr rr             jmp     print
0004FBr 1  A9 rr        @kb:    lda     #<ctrl_kb_txt
0004FDr 1  A0 rr                ldy     #>ctrl_kb_txt
0004FFr 1  4C rr rr             jmp     print
000502r 1               
000502r 1               ; ============================================================================
000502r 1               ; start, title
000502r 1               ; ============================================================================
000502r 1  D8           start:  cld
000503r 1  A2 FF                ldx     #$FF
000505r 1  9A                   txs
000506r 1  A9 00                lda     #0              ; clear the variables (RAM is random at power-up)
000508r 1  AA                   tax
000509r 1  A0 05                ldy     #>(bss_end - bss_start + $FF)
00050Br 1  9D rr rr     @c1:    sta     bss_start,x
00050Er 1  E8                   inx
00050Fr 1  D0 FA                bne     @c1
000511r 1  EE rr rr             inc     @c1+2
000514r 1  88                   dey
000515r 1  D0 F4                bne     @c1
000517r 1  AD rr rr             lda     ctrl_def
00051Ar 1  8D rr rr             sta     ctrl
00051Dr 1  A9 5A                lda     #$5A
00051Fr 1  8D rr rr             sta     rng
000522r 1  A9 FF                lda     #$FF
000524r 1  8D rr rr             sta     attr
000527r 1  20 rr rr             jsr     sfx_init
00052Ar 1  AD rr rr             lda     mute_def
00052Dr 1  8D rr rr             sta     sfx_mute
000530r 1  20 rr rr             jsr     spr_setup       ; the terminal's sprites, if it has them
000533r 1               
000533r 1  20 rr rr     title:  jsr     sfx_off
000536r 1  20 rr rr             jsr     new_screen
000539r 1  A9 rr                lda     #<title_txt
00053Br 1  A0 rr                ldy     #>title_txt
00053Dr 1  20 rr rr             jsr     print
000540r 1  20 rr rr             jsr     hi_title
000543r 1                       ; a few rocks for decoration
000543r 1  20 rr rr             jsr     clear_objects
000546r 1  A2 00                ldx     #0
000548r 1  8E rr rr     @r:     stx     tmp2
00054Br 1  BD rr rr             lda     deco_x,x
00054Er 1  8D rr rr             sta     tmp3
000551r 1  BD rr rr             lda     deco_y,x
000554r 1  A8                   tay
000555r 1  BD rr rr             lda     deco_s,x
000558r 1  AE rr rr             ldx     tmp3
00055Br 1  20 rr rr             jsr     add_rock_at
00055Er 1  AE rr rr             ldx     tmp2
000561r 1  E8                   inx
000562r 1  E0 05                cpx     #NDECO
000564r 1  D0 E2                bne     @r
000566r 1  20 rr rr             jsr     frame_draw
000569r 1  20 rr rr             jsr     show_ctrl
00056Cr 1  20 rr rr             jsr     read_pad
00056Fr 1  20 rr rr             jsr     flush_in
000572r 1  20 rr rr     @wait:  jsr     menu_key
000575r 1  C9 51                cmp     #'Q'
000577r 1  D0 03                bne     @notq
000579r 1  4C rr rr             jmp     exit_game
00057Cr 1  C9 4D        @notq:  cmp     #'M'            ; sound on / off
00057Er 1  D0 06                bne     @notm
000580r 1  20 rr rr             jsr     sfx_toggle
000583r 1  4C rr rr             jmp     @wait
000586r 1  C9 47        @notm:  cmp     #'G'
000588r 1  D0 0E                bne     @notg
00058Ar 1  AD rr rr             lda     ctrl
00058Dr 1  49 01                eor     #1
00058Fr 1  8D rr rr             sta     ctrl
000592r 1  20 rr rr             jsr     show_ctrl
000595r 1  4C rr rr             jmp     @wait
000598r 1  C9 80        @notg:  cmp     #PAD_GO
00059Ar 1  D0 08                bne     @notp
00059Cr 1  A9 01                lda     #1
00059Er 1  8D rr rr             sta     ctrl
0005A1r 1  4C rr rr             jmp     new_game
0005A4r 1  C9 20        @notp:  cmp     #' '
0005A6r 1  D0 CA                bne     @wait
0005A8r 1  4C rr rr             jmp     new_game
0005ABr 1               
0005ABr 1               hi_title:
0005ABr 1  20 rr rr             jsr     txt_mode
0005AEr 1  A2 22                ldx     #34
0005B0r 1  A0 15                ldy     #21
0005B2r 1  20 rr rr             jsr     gotoxy
0005B5r 1  A9 rr                lda     #<hi_txt
0005B7r 1  A0 rr                ldy     #>hi_txt
0005B9r 1  20 rr rr             jsr     print
0005BCr 1  AD rr rr             lda     hiscore+2
0005BFr 1  20 rr rr             jsr     prbcd
0005C2r 1  AD rr rr             lda     hiscore+1
0005C5r 1  20 rr rr             jsr     prbcd
0005C8r 1  AD rr rr             lda     hiscore
0005CBr 1  4C rr rr             jmp     prbcd
0005CEr 1               
0005CEr 1               exit_game:
0005CEr 1  20 rr rr             jsr     sfx_off
0005D1r 1  A9 rr                lda     #<bye_txt
0005D3r 1  A0 rr                ldy     #>bye_txt
0005D5r 1  20 rr rr             jsr     print
0005D8r 1  4C 06 FE             jmp     SBC_MENU
0005DBr 1               
0005DBr 1               ; clear the screen and forget what it showed
0005DBr 1               new_screen:
0005DBr 1  A9 rr                lda     #<cls_txt
0005DDr 1  A0 rr                ldy     #>cls_txt
0005DFr 1  20 rr rr             jsr     print
0005E2r 1  A9 00                lda     #0
0005E4r 1  AA                   tax
0005E5r 1  9D rr rr 9D  @c:     .repeat 8, K
0005E9r 1  rr rr 9D rr  
0005EDr 1  rr 9D rr rr  
000615r 1                       sta     fb + K * 256,x
000615r 1                       sta     sb + K * 256,x
000615r 1                       .endrepeat
000615r 1  E8                   inx
000616r 1  D0 CD                bne     @c
000618r 1  A2 16                ldx     #FROWS-1
00061Ar 1  9D rr rr     @d:     sta     rd_lo,x
00061Dr 1  9D rr rr             sta     rd_hi,x
000620r 1  9D rr rr             sta     rp_lo,x
000623r 1  9D rr rr             sta     rp_hi,x
000626r 1  CA                   dex
000627r 1  10 F1                bpl     @d
000629r 1  AD rr rr             lda     hwspr           ; (the clear hid the sprites)
00062Cr 1  F0 0A                beq     @r
00062Er 1  A9 rr                lda     #<clip_txt
000630r 1  A0 rr                ldy     #>clip_txt
000632r 1  20 rr rr             jsr     print
000635r 1  4C rr rr             jmp     spr_forget
000638r 1  60           @r:     rts
000639r 1               
000639r 1               ; ============================================================================
000639r 1               ; a game
000639r 1               ; ============================================================================
000639r 1               new_game:
000639r 1  A9 00                lda     #0
00063Br 1  8D rr rr             sta     score
00063Er 1  8D rr rr             sta     score+1
000641r 1  8D rr rr             sta     score+2
000644r 1  8D rr rr             sta     wave
000647r 1  8D rr rr             sta     quit
00064Ar 1  A9 03                lda     #3
00064Cr 1  8D rr rr             sta     lives
00064Fr 1  A9 00                lda     #0
000651r 1  8D rr rr             sta     ufo_wait
000654r 1  A9 5A                lda     #90             ; the first saucer comes after a while
000656r 1  8D rr rr             sta     ufo_next
000659r 1  20 rr rr             jsr     new_screen
00065Cr 1  A9 rr                lda     #<status_txt
00065Er 1  A0 rr                ldy     #>status_txt
000660r 1  20 rr rr             jsr     print
000663r 1  20 rr rr             jsr     clear_objects
000666r 1  20 rr rr             jsr     spawn_ship
000669r 1               new_wave:
000669r 1  EE rr rr             inc     wave
00066Cr 1  AD rr rr             lda     wave            ; 3 + wave big rocks, up to 8
00066Fr 1  18                   clc
000670r 1  69 03                adc     #3
000672r 1  C9 09                cmp     #9
000674r 1  90 02                bcc     @n
000676r 1  A9 08                lda     #8
000678r 1  8D rr rr     @n:     sta     tmp2
00067Br 1  20 rr rr     @r:     jsr     rand            ; along the left or top edge, away from the ship
00067Er 1  29 01                and     #1
000680r 1  F0 0D                beq     @left
000682r 1  20 rr rr             jsr     rand
000685r 1  C9 A0                cmp     #FW
000687r 1  B0 F2                bcs     @r
000689r 1  AA                   tax
00068Ar 1  A0 00                ldy     #0
00068Cr 1  4C rr rr             jmp     @add
00068Fr 1  20 rr rr     @left:  jsr     rand
000692r 1  29 7F                and     #$7F
000694r 1  C9 5C                cmp     #FH
000696r 1  B0 F7                bcs     @left
000698r 1  A8                   tay
000699r 1  A2 00                ldx     #0
00069Br 1  A9 00        @add:   lda     #0              ; big
00069Dr 1  20 rr rr             jsr     add_rock_at
0006A0r 1  CE rr rr             dec     tmp2
0006A3r 1  D0 D6                bne     @r
0006A5r 1  A9 01                lda     #1
0006A7r 1  8D rr rr             sta     hud_dirty
0006AAr 1  8D rr rr             sta     beat_t          ; the heartbeat: slow again
0006ADr 1  A9 12                lda     #BEAT_SLOW
0006AFr 1  8D rr rr             sta     beat_gap
0006B2r 1  A9 00                lda     #0
0006B4r 1  8D rr rr             sta     wave_t
0006B7r 1  AD rr rr             lda     o_kind+O_SHIP   ; (the ship gets a moment to see them)
0006BAr 1  F0 05                beq     game_loop
0006BCr 1  A9 1E                lda     #30
0006BEr 1  8D rr rr             sta     inv_t
0006C1r 1               
0006C1r 1               ; ---- the frame loop --------------------------------------------------------------
0006C1r 1               game_loop:
0006C1r 1  20 rr rr             jsr     sfx_poll
0006C4r 1  A9 00                lda     #0
0006C6r 1  8D rr rr             sta     nbytes
0006C9r 1  8D rr rr             sta     nbytes+1
0006CCr 1  8D rr rr             sta     npix
0006CFr 1  8D rr rr             sta     npix+1
0006D2r 1  20 rr rr             jsr     read_input
0006D5r 1  AD rr rr             lda     quit
0006D8r 1  F0 03                beq     @1
0006DAr 1  4C rr rr             jmp     title
0006DDr 1  20 rr rr     @1:     jsr     ship_control
0006E0r 1  20 rr rr             jsr     ufo_update
0006E3r 1  20 rr rr             jsr     move_all
0006E6r 1  20 rr rr             jsr     collide
0006E9r 1  20 rr rr             jsr     ship_life
0006ECr 1  20 rr rr             jsr     frame_draw
0006EFr 1  20 rr rr             jsr     hud_update
0006F2r 1  AD rr rr             lda     dead_t          ; game over?
0006F5r 1  C9 01                cmp     #1
0006F7r 1  D0 08                bne     @2
0006F9r 1  AD rr rr             lda     lives
0006FCr 1  D0 03                bne     @2
0006FEr 1  4C rr rr             jmp     game_over
000701r 1  20 rr rr     @2:     jsr     snd_frame
000704r 1  20 rr rr             jsr     wave_check
000707r 1  20 rr rr             jsr     pace
00070Ar 1  EE rr rr             inc     frame
00070Dr 1  4C rr rr             jmp     game_loop
000710r 1               
000710r 1               ; ---- the sounds that go on: the engine, the saucer's hum, the heartbeat ----
000710r 1               snd_frame:
000710r 1  AD rr rr             lda     flame           ; thrust: its rumble, every frame
000713r 1  F0 05                beq     @nt
000715r 1  A9 06                lda     #SND_THRUST
000717r 1  20 rr rr             jsr     sfx_snd
00071Ar 1  AD rr rr     @nt:    lda     o_kind+O_UFO    ; a saucer: its hum (big or small)
00071Dr 1  C9 05                cmp     #K_UFO
00071Fr 1  D0 14                bne     @nu
000721r 1  AD rr rr             lda     ufo_hum
000724r 1  D0 1E                bne     @beat
000726r 1  EE rr rr             inc     ufo_hum
000729r 1  AD rr rr             lda     o_size+O_UFO
00072Cr 1  18                   clc
00072Dr 1  69 02                adc     #SND_UFOBIG
00072Fr 1  20 rr rr             jsr     sfx_snd
000732r 1  4C rr rr             jmp     @beat
000735r 1  AD rr rr     @nu:    lda     ufo_hum
000738r 1  F0 0A                beq     @beat
00073Ar 1  A9 00                lda     #0
00073Cr 1  8D rr rr             sta     ufo_hum
00073Fr 1  A2 01                ldx     #1
000741r 1  20 rr rr             jsr     sfx_stop
000744r 1  AD rr rr     @beat:  lda     wave_t          ; the heartbeat, while there are rocks: it
000747r 1  D0 20                bne     @r              ; gets faster as the wave goes on
000749r 1  CE rr rr             dec     beat_t
00074Cr 1  D0 1B                bne     @r
00074Er 1  AD rr rr             lda     beat_gap
000751r 1  8D rr rr             sta     beat_t
000754r 1  C9 07                cmp     #BEAT_FAST+1
000756r 1  90 03                bcc     @b
000758r 1  CE rr rr             dec     beat_gap
00075Br 1  AD rr rr     @b:     lda     beat_n
00075Er 1  49 01                eor     #1
000760r 1  8D rr rr             sta     beat_n
000763r 1  18                   clc
000764r 1  69 00                adc     #SND_BEAT1
000766r 1  4C rr rr             jmp     sfx_snd
000769r 1  60           @r:     rts
00076Ar 1               BEAT_SLOW       = 18            ; frames between beats at the start of a wave
00076Ar 1               BEAT_FAST       = 6             ; ... at the quickest
00076Ar 1               
00076Ar 1               ; wait out the rest of the frame: about (speed - what the frame took) ms.
00076Ar 1               ; The frame took roughly: the bytes sent at 115200 baud (87 us each) plus
00076Ar 1               ; the 6502's work (counted in pixels drawn and rows compared) / CLOCK_MHZ.
00076Ar 1  AD rr rr     pace:   lda     nbytes          ; tmp = bytes / 8 (at most 255)
00076Dr 1  8D rr rr             sta     tmp
000770r 1  AD rr rr             lda     nbytes+1
000773r 1  8D rr rr             sta     tmp+1
000776r 1  A2 03                ldx     #3
000778r 1  4E rr rr     @s:     lsr     tmp+1
00077Br 1  6E rr rr             ror     tmp
00077Er 1  CA                   dex
00077Fr 1  D0 F7                bne     @s
000781r 1  AD rr rr             lda     tmp+1
000784r 1  F0 03                beq     *+5
000786r 1  4C rr rr             jmp     @none
000789r 1  AD rr rr             lda     hwspr
00078Cr 1  F0 11                beq     @fb
00078Er 1                       ; with the terminal's sprites (fit.py): about 16 ms + 1.5 ms per
00078Er 1                       ; row compared + 0.11 ms per byte, at 1 MHz
00078Er 1  AD rr rr             lda     nrows_seen
000791r 1  4A                   lsr
000792r 1  6D rr rr             adc     nrows_seen
000795r 1  69 10                adc     #16
000797r 1  6D rr rr             adc     tmp
00079Ar 1  B0 6F                bcs     @none
00079Cr 1  4C rr rr             jmp     @cp
00079Fr 1               @fb:
00079Fr 1                       ; the 6502's work, measured in the emulator (test/fit.py): about
00079Fr 1                       ; 0.39 ms per thing drawn + 1.3 ms per row compared + 0.12 ms per
00079Fr 1                       ; byte - 13 ms, at 1 MHz
00079Fr 1  AD rr rr             lda     npix            ; things drawn * 3 / 8
0007A2r 1  8D rr rr             sta     tmp2
0007A5r 1  AD rr rr             lda     npix+1
0007A8r 1  4A                   lsr
0007A9r 1  6E rr rr             ror     tmp2
0007ACr 1  4A                   lsr
0007ADr 1  6E rr rr             ror     tmp2
0007B0r 1  4A                   lsr
0007B1r 1  6E rr rr             ror     tmp2
0007B4r 1  AD rr rr             lda     tmp2
0007B7r 1  0A                   asl
0007B8r 1  B0 51                bcs     @none
0007BAr 1  6D rr rr             adc     tmp2
0007BDr 1  B0 4C                bcs     @none
0007BFr 1  6D rr rr             adc     tmp             ; + bytes / 8
0007C2r 1  B0 47                bcs     @none
0007C4r 1  6D rr rr             adc     nrows_seen      ; + rows * 1.3
0007C7r 1  B0 42                bcs     @none
0007C9r 1  8D rr rr             sta     used
0007CCr 1  AD rr rr             lda     nrows_seen
0007CFr 1  4A                   lsr
0007D0r 1  4A                   lsr
0007D1r 1  6D rr rr             adc     used
0007D4r 1  B0 35                bcs     @none
0007D6r 1  38                   sec
0007D7r 1  E9 0D                sbc     #13
0007D9r 1  B0 02                bcs     @cp
0007DBr 1  A9 00                lda     #0
0007DDr 1               @cp:
0007DDr 1               .if CLOCK_MHZ > 1
0007DDr 1  A2 02                ldx     #CLOCK_MHZ
0007DFr 1  20 rr rr             jsr     div_ax          ; / the clock
0007E2r 1               .endif
0007E2r 1  8D rr rr             sta     used
0007E5r 1  AD rr rr             lda     tmp             ; serial: bytes * 87 us = bytes / 8 * 0.7
0007E8r 1  4A                   lsr                     ;   ~ bytes / 8 * (1/2 + 1/4)
0007E9r 1  8D rr rr             sta     tmp2
0007ECr 1  4A                   lsr
0007EDr 1  6D rr rr             adc     tmp2
0007F0r 1  6D rr rr             adc     used
0007F3r 1  B0 16                bcs     @none
0007F5r 1  8D rr rr             sta     used
0007F8r 1  AD rr rr             lda     hwspr
0007FBr 1  D0 1C                bne     pace_hw
0007FDr 1  AD rr rr             lda     speed           ; the rest of the frame time
000800r 1  38                   sec
000801r 1  ED rr rr             sbc     used
000804r 1  90 05                bcc     @none
000806r 1  F0 03                beq     @none
000808r 1  4C rr rr             jmp     delay_ms
00080Br 1  AD rr rr     @none:  lda     hwspr
00080Er 1  F0 08                beq     @r
000810r 1  A9 FF                lda     #255
000812r 1  8D rr rr             sta     used
000815r 1  4C rr rr             jmp     pace_hw
000818r 1  60           @r:     rts
000819r 1               
000819r 1               ; with the terminal's sprites: half a frame time after this frame's SHOW
000819r 1               ; (which came near the end of the work) the sprites move on by half their
000819r 1               ; speed (mid_frame), so the ship, the saucer, the rocks and bullets the
000819r 1               ; terminal draws move twice a frame, evenly.  used = ms taken so far.
000819r 1               pace_hw:
000819r 1  AD rr rr             lda     speed           ; first wait: half the frame time less the
00081Cr 1  4A                   lsr                     ; work after the SHOW and before the next
00081Dr 1  38                   sec                     ; (the HUD, the half-way frame's own), but
00081Er 1  E9 05                sbc     #MID_MS + 2     ; no more than leaves room for the rest
000820r 1  8D rr rr             sta     tmp3
000823r 1  AD rr rr             lda     speed
000826r 1  38                   sec
000827r 1  ED rr rr             sbc     used
00082Ar 1  90 04                bcc     @w0
00082Cr 1  E9 03                sbc     #MID_MS
00082Er 1  B0 02                bcs     @w1
000830r 1  A9 00        @w0:    lda     #0
000832r 1  CD rr rr     @w1:    cmp     tmp3
000835r 1  90 03                bcc     @w2
000837r 1  AD rr rr             lda     tmp3
00083Ar 1  8D rr rr     @w2:    sta     tmp3
00083Dr 1  20 rr rr             jsr     delay_ms        ; (0: none)
000840r 1  AD rr rr             lda     used
000843r 1  18                   clc
000844r 1  6D rr rr             adc     tmp3
000847r 1  B0 36                bcs     @r
000849r 1  8D rr rr             sta     used
00084Cr 1  AD rr rr             lda     nbytes          ; the half-way frame (bytes: serial time)
00084Fr 1  8D rr rr             sta     tmp4
000852r 1  20 rr rr             jsr     mid_frame
000855r 1  AD rr rr             lda     nbytes
000858r 1  38                   sec
000859r 1  ED rr rr             sbc     tmp4
00085Cr 1  4A                   lsr                     ; bytes * 87 us ~ bytes / 16 + bytes / 32
00085Dr 1  4A                   lsr
00085Er 1  4A                   lsr
00085Fr 1  4A                   lsr
000860r 1  8D rr rr             sta     tmp4
000863r 1  4A                   lsr
000864r 1  6D rr rr             adc     tmp4
000867r 1  69 03                adc     #MID_MS         ; + its work
000869r 1  6D rr rr             adc     used
00086Cr 1  B0 11                bcs     @r
00086Er 1  8D rr rr             sta     used
000871r 1  AD rr rr             lda     speed           ; and the rest
000874r 1  38                   sec
000875r 1  ED rr rr             sbc     used
000878r 1  90 05                bcc     @r
00087Ar 1  F0 03                beq     @r
00087Cr 1  4C rr rr             jmp     delay_ms
00087Fr 1  60           @r:     rts
000880r 1               
000880r 1               
000880r 1               ; A = A / X (unsigned)
000880r 1  8E rr rr     div_ax: stx     tmp4
000883r 1  A2 00                ldx     #0
000885r 1  CD rr rr     @l:     cmp     tmp4
000888r 1  90 06                bcc     @d
00088Ar 1  ED rr rr             sbc     tmp4
00088Dr 1  E8                   inx
00088Er 1  D0 F5                bne     @l
000890r 1  8A           @d:     txa
000891r 1  60                   rts
000892r 1               
