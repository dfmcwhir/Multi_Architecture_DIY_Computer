000DCCr 1  A9 00        @b:     lda     #0              ; ma * ml, shift and add
000DCEr 1  A2 08                ldx     #8
000DD0r 1  4E rr rr             lsr     ml
000DD3r 1  90 04        @l:     bcc     @n
000DD5r 1  18                   clc
