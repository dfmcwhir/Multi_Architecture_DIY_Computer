000C16r 1  8D rr rr             sta     ufo_fire
000C19r 1  BD rr rr             lda     ufo_spd,x       ; speed (fraction of a pixel a frame, or 1)
000C1Cr 1  8D rr rr             sta     tmp2
000C1Fr 1  A9 00                lda     #0
000C21r 1  8D rr rr             sta     o_x_lo+O_UFO
000C24r 1  8D rr rr             sta     o_y_lo+O_UFO
000C27r 1  8D rr rr             sta     o_vy_lo+O_UFO
000C2Ar 1  8D rr rr             sta     o_vy_hi+O_UFO
000C2Dr 1  20 rr rr             jsr     rand            ; which side
000C30r 1  29 01                and     #1
000C32r 1  F0 1D                beq     @left
000C34r 1  A9 9F                lda     #FW-1           ; from the right, going left
000C36r 1  8D rr rr             sta     o_x_hi+O_UFO
000C39r 1  A9 00                lda     #0
000C3Br 1  38                   sec
000C3Cr 1  ED rr rr             sbc     tmp2
000C3Fr 1  8D rr rr             sta     o_vx_lo+O_UFO
000C42r 1  A9 FF                lda     #$FF
000C44r 1  AE rr rr             ldx     tmp2
000C47r 1  D0 02                bne     @vh
000C49r 1  A9 FF                lda     #$FF            ; (speed 1: -1.0)
000C4Br 1  8D rr rr     @vh:    sta     o_vx_hi+O_UFO
000C4Er 1  4C rr rr             jmp     @y
000C51r 1  A9 00        @left:  lda     #0
000C53r 1  8D rr rr             sta     o_x_hi+O_UFO
000C56r 1  AD rr rr             lda     tmp2
000C59r 1  8D rr rr             sta     o_vx_lo+O_UFO
000C5Cr 1  A9 00                lda     #0
000C5Er 1  AE rr rr             ldx     tmp2
000C61r 1  D0 02                bne     @vl
000C63r 1  A9 01                lda     #1              ; (speed 1: +1.0)
000C65r 1  8D rr rr     @vl:    sta     o_vx_hi+O_UFO
000C68r 1  20 rr rr     @y:     jsr     rand            ; a height away from the very edges
000C6Br 1  29 7F                and     #$7F
000C6Dr 1  C9 4C                cmp     #FH-16
000C6Fr 1  B0 F7                bcs     @y
000C71r 1  69 08                adc     #8
000C73r 1  8D rr rr             sta     o_y_hi+O_UFO
000C76r 1  60                   rts
000C77r 1               
000C77r 1               ; the saucer fires a bullet: 2 pixels a frame for 30 frames
000C77r 1               ufo_shoot:
000C77r 1  A2 2E                ldx     #O_EB
000C79r 1  BD rr rr     @f:     lda     o_kind,x
