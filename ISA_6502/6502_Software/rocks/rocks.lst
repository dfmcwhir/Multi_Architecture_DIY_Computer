000B8Dr 1               ; ---- the saucer -------------------------------------------------------------------
000B8Dr 1               ; Now and then (while the ship is out) a saucer crosses the field from one
000B8Dr 1               ; side, drifting up and down, and shoots: the big one anywhere, the small one
000B8Dr 1               ; (from wave 3, or 10000 points) at the ship.
000B8Dr 1               ufo_update:
000B8Dr 1  AD rr rr             lda     o_kind+O_UFO
000B90r 1  C9 05                cmp     #K_UFO
000B92r 1  F0 1B                beq     @on
000B94r 1  AD rr rr             lda     o_kind+O_SHIP   ; none: count towards the next one
000B97r 1  F0 15                beq     @r
000B99r 1  AD rr rr             lda     frame
000B9Cr 1  29 03                and     #3
000B9Er 1  D0 0E                bne     @r
000BA0r 1  EE rr rr             inc     ufo_wait
000BA3r 1  AD rr rr             lda     ufo_wait
000BA6r 1  CD rr rr             cmp     ufo_next
000BA9r 1  90 03                bcc     @r
000BABr 1  4C rr rr             jmp     ufo_start
000BAEr 1  60           @r:     rts
000BAFr 1  AD rr rr     @on:    lda     frame           ; a new up / down drift now and then
000BB2r 1  29 1F                and     #31
000BB4r 1  D0 12                bne     @f
000BB6r 1  20 rr rr             jsr     rand
000BB9r 1  29 03                and     #3
000BBBr 1  AA                   tax
000BBCr 1  BD rr rr             lda     drift_lo,x
000BBFr 1  8D rr rr             sta     o_vy_lo+O_UFO
000BC2r 1  BD rr rr             lda     drift_hi,x
000BC5r 1  8D rr rr             sta     o_vy_hi+O_UFO
000BC8r 1  CE rr rr     @f:     dec     ufo_fire
000BCBr 1  D0 E1                bne     @r
000BCDr 1  AE rr rr             ldx     o_size+O_UFO
000BD0r 1  BD rr rr             lda     ufo_gap,x
000BD3r 1  8D rr rr             sta     ufo_fire
000BD6r 1  4C rr rr             jmp     ufo_shoot
000BD9r 1               
000BD9r 1               ufo_start:
000BD9r 1  A9 00                lda     #0
000BDBr 1  8D rr rr             sta     ufo_wait
