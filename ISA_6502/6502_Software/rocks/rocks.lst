0015DAr 1  38                   sec
0015DBr 1  E9 08                sbc     #8
0015DDr 1  B0 05                bcs     @y1
0015DFr 1  69 5C                adc     #FH
0015E1r 1  4C rr rr             jmp     @yok
0015E4r 1  C9 5C        @y1:    cmp     #FH
0015E6r 1  90 02                bcc     @yok
0015E8r 1  E9 5C                sbc     #FH
0015EAr 1  8D rr rr     @yok:   sta     py
0015EDr 1  8C rr rr             sty     shp_i
0015F0r 1  20 rr rr             jsr     plot
0015F3r 1  AC rr rr             ldy     shp_i
0015F6r 1  C8                   iny
0015F7r 1  D0 BC                bne     @l
0015F9r 1  60           @done:  rts
0015FAr 1               
0015FAr 1               ; set pixel px, py of the field in fb, and note its row
0015FAr 1  EE rr rr     plot:   inc     npix
0015FDr 1  D0 03                bne     @c
0015FFr 1  EE rr rr             inc     npix+1
001602r 1  AD rr rr     @c:     lda     py
001605r 1  4A                   lsr
001606r 1  4A                   lsr
001607r 1  A8                   tay
001608r 1  AD rr rr             lda     px              ; mark its block of 8 columns (16 pixels)
00160Br 1  4A                   lsr
00160Cr 1  4A                   lsr
00160Dr 1  4A                   lsr
00160Er 1  4A                   lsr
00160Fr 1  AA                   tax
001610r 1  BD rr rr             lda     blkbit,x
001613r 1  E0 08                cpx     #8
001615r 1  B0 09                bcs     @bh
001617r 1  19 rr rr             ora     rd_lo,y
00161Ar 1  99 rr rr             sta     rd_lo,y
00161Dr 1  4C rr rr             jmp     @bd
001620r 1  19 rr rr     @bh:    ora     rd_hi,y
001623r 1  99 rr rr             sta     rd_hi,y
001626r 1  AD rr rr     @bd:    lda     px
001629r 1  4A                   lsr
00162Ar 1  18                   clc
00162Br 1  79 rr rr             adc     fbrow_lo,y
00162Er 1  8D rr rr             sta     @rd+1
001631r 1  8D rr rr             sta     @wr+1
001634r 1  B9 rr rr             lda     fbrow_hi,y
001637r 1  69 00                adc     #0
001639r 1  8D rr rr             sta     @rd+2
00163Cr 1  8D rr rr             sta     @wr+2
00163Fr 1  AD rr rr             lda     py
001642r 1  29 03                and     #3
001644r 1  0A                   asl
001645r 1  8D rr rr             sta     tmp4
001648r 1  AD rr rr             lda     px
00164Br 1  29 01                and     #1
00164Dr 1  0D rr rr             ora     tmp4
001650r 1  A8                   tay
001651r 1  B9 rr rr             lda     bitmask,y
001654r 1  0D FF FF     @rd:    ora     $FFFF
001657r 1  8D FF FF     @wr:    sta     $FFFF
00165Ar 1  60                   rts
00165Br 1               
00165Br 1               
00165Br 1               ; ============================================================================
00165Br 1               ; the terminal's sprite layer (control code 1C), when it has one
00165Br 1               ; ============================================================================
00165Br 1               ; The ship (slot 15, on top), the saucer (14) and up to 14 rocks (0-13, the
00165Br 1               ; big ones first) are the terminal's sprites, as long as they are wholly in
00165Br 1               ; the field; the rest (bullets, debris, the flame, more rocks, and anything
00165Br 1               ; going over an edge, which wraps round) is drawn in fb as before.  Each
00165Br 1               ; frame spr_assign chooses them (o_sl: slot + 1) and sets where each slot
00165Br 1               ; should be (des_*); spr_send sends only what changed (MOVE, PICTURE, PLACE,
00165Br 1               ; HIDE) between HOLD and SHOW.  Half way through the frame time mid_frame
00165Br 1               ; moves them on by half their speed, so they move twice a frame.  After each
00165Br 1               ; of these IDENTIFY goes out, and the next waits for its answer (pacing).
00165Br 1               NSLOT           = 16
00165Br 1               SL_SHIP         = 15
00165Br 1               SL_UFO          = 14
00165Br 1               NRSL            = 14            ; slots for rocks
00165Br 1               ASK_MS          = 150           ; (the most to wait for the terminal: then go on)
00165Br 1               MID_MS          = 5 / CLOCK_MHZ + 1     ; the half-way frame's work, ms
00165Br 1               
00165Br 1               ; at start: IDENTIFY, and if it answers, the pictures (SPR_DEFS bytes)
00165Br 1               spr_setup:
00165Br 1  20 rr rr             jsr     flush_in
00165Er 1  A9 rr                lda     #<ident_txt
001660r 1  A0 rr                ldy     #>ident_txt
001662r 1  20 rr rr             jsr     print
001665r 1  A9 C8                lda     #200            ; up to 200 ms
001667r 1  8D rr rr             sta     rp_t
00166Ar 1  20 00 FE     @w:     jsr     SBC_CHRIN
00166Dr 1  B0 0B                bcs     @c
00166Fr 1  A9 01        @w1:    lda     #1
001671r 1  20 rr rr             jsr     delay_ms
001674r 1  CE rr rr             dec     rp_t
001677r 1  D0 F1                bne     @w
001679r 1  60                   rts                     ; no answer: the game draws everything
00167Ar 1  C9 53        @c:     cmp     #'S'
00167Cr 1  F0 08                beq     @yes
00167Er 1  C9 50                cmp     #'P'
001680r 1  F0 04                beq     @yes
001682r 1  C9 31                cmp     #'1'
001684r 1  D0 E9                bne     @w1
001686r 1  A9 01        @yes:   lda     #1
001688r 1  8D rr rr             sta     hwspr
00168Br 1  A9 14                lda     #20             ; (the rest of the answer)
00168Dr 1  20 rr rr             jsr     delay_ms
001690r 1  20 rr rr             jsr     flush_in
001693r 1  A9 rr                lda     #<spr_defs
001695r 1  8D rr rr             sta     @ld+1
001698r 1  A9 rr                lda     #>spr_defs
00169Ar 1  8D rr rr             sta     @ld+2
00169Dr 1  A9 91                lda     #<SPR_DEFS
00169Fr 1  8D rr rr             sta     rp_cnt
0016A2r 1  A9 02                lda     #>SPR_DEFS
0016A4r 1  8D rr rr             sta     rp_cnt+1
0016A7r 1  AD FF FF     @ld:    lda     $FFFF
0016AAr 1  20 03 FE             jsr     SBC_CHROUT
0016ADr 1  EE rr rr             inc     @ld+1
0016B0r 1  D0 03                bne     @n
0016B2r 1  EE rr rr             inc     @ld+2
0016B5r 1  AD rr rr     @n:     lda     rp_cnt
0016B8r 1  D0 03                bne     @d
0016BAr 1  CE rr rr             dec     rp_cnt+1
0016BDr 1  CE rr rr     @d:     dec     rp_cnt
0016C0r 1  AD rr rr             lda     rp_cnt
0016C3r 1  0D rr rr             ora     rp_cnt+1
0016C6r 1  D0 DF                bne     @ld
0016C8r 1  60                   rts
0016C9r 1               
0016C9r 1               ; the screen was cleared (that hid the sprites): none show
0016C9r 1               spr_forget:
0016C9r 1  A9 00                lda     #0              ; (nothing to wait for)
0016CBr 1  8D rr rr             sta     rp_out
0016CEr 1  8D rr rr             sta     rp_in
0016D1r 1  A2 0F                ldx     #NSLOT-1
0016D3r 1  A9 00                lda     #0
0016D5r 1  9D rr rr     @f:     sta     sl_on,x
0016D8r 1  9D rr rr             sta     sl_obj,x
0016DBr 1  9D rr rr             sta     des_on,x
0016DEr 1  CA                   dex
0016DFr 1  10 F4                bpl     @f
0016E1r 1  A2 2F                ldx     #NOBJ-1
0016E3r 1  9D rr rr     @o:     sta     o_sl,x
0016E6r 1  CA                   dex
0016E7r 1  10 FA                bpl     @o
0016E9r 1  60                   rts
0016EAr 1               
0016EAr 1               ; ---- pacing: IDENTIFY after each update; the next waits for the answer ----
0016EAr 1               ask_send:
0016EAr 1  EE rr rr             inc     rp_out
0016EDr 1  A9 rr                lda     #<ident_txt
0016EFr 1  A0 rr                ldy     #>ident_txt
0016F1r 1  4C rr rr             jmp     print
0016F4r 1               
0016F4r 1               ask_wait:
0016F4r 1  A9 96                lda     #ASK_MS
0016F6r 1  8D rr rr             sta     rp_t
0016F9r 1  AD rr rr     @chk:   lda     rp_out          ; all answered?
0016FCr 1  F0 1D                beq     @r
0016FEr 1  20 rr rr             jsr     getc
001701r 1  90 06                bcc     @none
001703r 1  20 rr rr             jsr     handle_key      ; (a key meanwhile)
001706r 1  4C rr rr             jmp     @chk
001709r 1  A9 01        @none:  lda     #1
00170Br 1  20 rr rr             jsr     delay_ms
00170Er 1  CE rr rr             dec     rp_t
001711r 1  D0 E6                bne     @chk
001713r 1  A9 00                lda     #0              ; no answer: lost; go on, counting afresh
001715r 1  8D rr rr             sta     rp_out
001718r 1  8D rr rr             sta     rp_in
00171Br 1  60           @r:     rts
00171Cr 1               
00171Cr 1               ; any answers (or keys) waiting now, without waiting for more
00171Cr 1               ask_poll:
00171Cr 1  20 rr rr             jsr     getc
00171Fr 1  90 06                bcc     @r
001721r 1  20 rr rr             jsr     handle_key
001724r 1  4C rr rr             jmp     ask_poll
001727r 1  60           @r:     rts
001728r 1               
001728r 1               ; pos_x, pos_y = where object X will be half a frame on (not wrapped round)
001728r 1               half_pos:
001728r 1  BD rr rr             lda     o_vx_hi,x       ; speed / 2
00172Br 1  C9 80                cmp     #$80
00172Dr 1  6A                   ror
00172Er 1  8D rr rr             sta     hv_hi
001731r 1  BD rr rr             lda     o_vx_lo,x
001734r 1  6A                   ror
001735r 1  18                   clc
001736r 1  7D rr rr             adc     o_x_lo,x
001739r 1  BD rr rr             lda     o_x_hi,x
00173Cr 1  6D rr rr             adc     hv_hi
00173Fr 1  8D rr rr             sta     pos_x
001742r 1  BD rr rr             lda     o_vy_hi,x
001745r 1  C9 80                cmp     #$80
001747r 1  6A                   ror
001748r 1  8D rr rr             sta     hv_hi
00174Br 1  BD rr rr             lda     o_vy_lo,x
00174Er 1  6A                   ror
00174Fr 1  18                   clc
001750r 1  7D rr rr             adc     o_y_lo,x
001753r 1  BD rr rr             lda     o_y_hi,x
001756r 1  6D rr rr             adc     hv_hi
001759r 1  8D rr rr             sta     pos_y
00175Cr 1  60                   rts
00175Dr 1               
00175Dr 1               ; slot Y should show picture hp_n at hp_x, hp_y
00175Dr 1               set_des:
00175Dr 1  A9 01                lda     #1
00175Fr 1  99 rr rr             sta     des_on,y
001762r 1  AD rr rr             lda     hp_n
001765r 1  99 rr rr             sta     des_n,y
001768r 1  AD rr rr             lda     hp_x
00176Br 1  99 rr rr             sta     des_x,y
00176Er 1  AD rr rr             lda     hp_y
001771r 1  99 rr rr             sta     des_y,y
001774r 1  60                   rts
001775r 1               
001775r 1               ; Object X with picture hp_n: where its sprite goes, on the wire (+ 32; the
001775r 1               ; field starts at sprite row 4): hp_x, hp_y.  A (and cl_need) = how many slots
001775r 1               ; it needs: 1 wholly in the field; 2 over one edge (the second, cp_x, cp_y,
001775r 1               ; is the part that wraps round to the other side); 0 over two edges (a
001775r 1               ; corner: drawn in fb).  Preserves X.
001775r 1               classify:
001775r 1  AC rr rr             ldy     hp_n
001778r 1  BD rr rr             lda     o_x_hi,x        ; x - ox + 32: 26 .. 191
00177Br 1  38                   sec
00177Cr 1  F9 rr rr             sbc     pic_ox,y
00177Fr 1  18                   clc
001780r 1  69 20                adc     #32
001782r 1  8D rr rr             sta     hp_x
001785r 1  8D rr rr             sta     cp_x
001788r 1  BD rr rr             lda     o_y_hi,x        ; y - oy + 36: 30 .. 127
00178Br 1  38                   sec
00178Cr 1  F9 rr rr             sbc     pic_oy,y
00178Fr 1  18                   clc
001790r 1  69 24                adc     #36
001792r 1  8D rr rr             sta     hp_y
001795r 1  8D rr rr             sta     cp_y
001798r 1  A9 01                lda     #1
00179Ar 1  8D rr rr             sta     cl_need
00179Dr 1  AD rr rr             lda     hp_x            ; over the left edge?
0017A0r 1  C9 20                cmp     #32
0017A2r 1  B0 0A                bcs     @xr
0017A4r 1  69 A0                adc     #FW
0017A6r 1  8D rr rr             sta     cp_x
0017A9r 1  EE rr rr             inc     cl_need
0017ACr 1  D0 13                bne     @y
0017AEr 1  18           @xr:    clc                     ; ... or the right?
0017AFr 1  79 rr rr             adc     pic_w,y
0017B2r 1  C9 C1                cmp     #32+FW+1
0017B4r 1  90 0B                bcc     @y
0017B6r 1  AD rr rr             lda     hp_x
0017B9r 1  E9 A0                sbc     #FW             ; (carry set)
0017BBr 1  8D rr rr             sta     cp_x
0017BEr 1  EE rr rr             inc     cl_need
0017C1r 1  AD rr rr     @y:     lda     hp_y            ; over the top?
0017C4r 1  C9 24                cmp     #36
0017C6r 1  B0 0A                bcs     @yb
0017C8r 1  69 5C                adc     #FH
0017CAr 1  8D rr rr             sta     cp_y
0017CDr 1  EE rr rr             inc     cl_need
0017D0r 1  D0 13                bne     @e
0017D2r 1  18           @yb:    clc                     ; ... or the bottom?
0017D3r 1  79 rr rr             adc     pic_h,y
0017D6r 1  C9 81                cmp     #36+FH+1
0017D8r 1  90 0B                bcc     @e
0017DAr 1  AD rr rr             lda     hp_y
0017DDr 1  E9 5C                sbc     #FH
0017DFr 1  8D rr rr             sta     cp_y
0017E2r 1  EE rr rr             inc     cl_need
0017E5r 1  AD rr rr     @e:     lda     cl_need
0017E8r 1  C9 03                cmp     #3
0017EAr 1  90 05                bcc     @r
0017ECr 1  A9 00                lda     #0              ; (a corner)
0017EEr 1  8D rr rr             sta     cl_need
0017F1r 1  60           @r:     rts
0017F2r 1               
0017F2r 1               ; the picture of object X (a rock, the saucer or a bullet) -> hp_n
0017F2r 1               obj_pic:
0017F2r 1  BD rr rr             lda     o_kind,x
0017F5r 1  C9 02                cmp     #K_BUL
0017F7r 1  F0 0E                beq     @dot
0017F9r 1  C9 06                cmp     #K_EBUL
0017FBr 1  F0 0A                beq     @dot
0017FDr 1  BD rr rr             lda     o_shape,x       ; rocks and the saucer
001800r 1  38                   sec
001801r 1  E9 20                sbc     #SH_ROCK0_0 - PIC_ROCK
001803r 1  8D rr rr             sta     hp_n
001806r 1  60                   rts
001807r 1  A9 2B        @dot:   lda     #PIC_DOT
001809r 1  8D rr rr             sta     hp_n
00180Cr 1  60                   rts
00180Dr 1               
00180Dr 1               ; which objects are sprites this frame (o_sl), and where the slots should be
00180Dr 1               ; (des_*).  The ship has slot 15 and the saucer 14 while they are wholly in
00180Dr 1               ; the field.  Slots 0-13 go to the rocks (big ones first) and then the
00180Dr 1               ; bullets; a rock over an edge has two (sl_part 1: the part round the other
00180Dr 1               ; side).  A thing keeps its slots while it can.
00180Dr 1               spr_assign:
00180Dr 1  A2 2F                ldx     #NOBJ-1
00180Fr 1  A9 00                lda     #0
001811r 1  9D rr rr     @c:     sta     o_sl,x
001814r 1  9D rr rr             sta     o_have,x
001817r 1  CA                   dex
001818r 1  10 F7                bpl     @c
00181Ar 1  A2 0F                ldx     #NSLOT-1
00181Cr 1  9D rr rr     @d:     sta     des_on,x
00181Fr 1  CA                   dex
001820r 1  10 FA                bpl     @d
001822r 1  A2 00                ldx     #O_SHIP         ; the ship
001824r 1  BD rr rr             lda     o_kind,x
001827r 1  C9 01                cmp     #K_SHIP
001829r 1  D0 21                bne     @nship
00182Br 1  AD rr rr             lda     sdir
00182Er 1  4A                   lsr
00182Fr 1  4A                   lsr
001830r 1  4A                   lsr
001831r 1  8D rr rr             sta     hp_n
001834r 1  20 rr rr             jsr     classify
001837r 1  C9 01                cmp     #1
001839r 1  D0 11                bne     @nship
00183Br 1  A9 01                lda     #1
00183Dr 1  8D rr rr             sta     o_sl+O_SHIP
001840r 1  AD rr rr             lda     inv_t           ; (blinking: not this frame)
001843r 1  29 04                and     #4
001845r 1  D0 05                bne     @nship
001847r 1  A0 0F                ldy     #SL_SHIP
001849r 1  20 rr rr             jsr     set_des
00184Cr 1  A2 2D        @nship: ldx     #O_UFO          ; the saucer
00184Er 1  BD rr rr             lda     o_kind,x
001851r 1  C9 05                cmp     #K_UFO
001853r 1  D0 14                bne     @nufo
001855r 1  20 rr rr             jsr     obj_pic
001858r 1  20 rr rr             jsr     classify
00185Br 1  C9 01                cmp     #1
00185Dr 1  D0 0A                bne     @nufo
00185Fr 1  A9 01                lda     #1
001861r 1  8D rr rr             sta     o_sl+O_UFO
001864r 1  A0 0E                ldy     #SL_UFO
001866r 1  20 rr rr             jsr     set_des
001869r 1  A0 0D        @nufo:  ldy     #NRSL-1         ; slots kept by what still needs them
00186Br 1  8C rr rr     @k:     sty     hs_i
00186Er 1  B9 rr rr             lda     sl_obj,y
001871r 1  F0 46                beq     @kn
001873r 1  AA                   tax
001874r 1  CA                   dex
001875r 1  BD rr rr             lda     o_kind,x
001878r 1  C9 03                cmp     #K_ROCK
00187Ar 1  F0 08                beq     @kr
00187Cr 1  C9 02                cmp     #K_BUL
00187Er 1  F0 04                beq     @kr
001880r 1  C9 06                cmp     #K_EBUL
001882r 1  D0 2D                bne     @kfree
001884r 1  20 rr rr     @kr:    jsr     obj_pic
001887r 1  20 rr rr             jsr     classify
00188Ar 1  AC rr rr             ldy     hs_i
00188Dr 1  B9 rr rr             lda     sl_part,y       ; the main part: needs 1 or 2; the other: 2
001890r 1  18                   clc
001891r 1  69 01                adc     #1
001893r 1  CD rr rr             cmp     cl_need
001896r 1  F0 09                beq     @keep
001898r 1  B0 17                bcs     @kfree
00189Ar 1  B9 rr rr             lda     sl_part,y
00189Dr 1  F0 02                beq     @keep
00189Fr 1  D0 10                bne     @kfree
0018A1r 1  B9 rr rr     @keep:  lda     sl_part,y       ; (o_have bit 0: the main part, bit 1: the other)
0018A4r 1  A8                   tay
0018A5r 1  B9 rr rr             lda     bit01,y
0018A8r 1  1D rr rr             ora     o_have,x
0018ABr 1  9D rr rr             sta     o_have,x
0018AEr 1  4C rr rr             jmp     @kn
0018B1r 1  AC rr rr     @kfree: ldy     hs_i
0018B4r 1  A9 00                lda     #0
0018B6r 1  99 rr rr             sta     sl_obj,y
0018B9r 1  AC rr rr     @kn:    ldy     hs_i
0018BCr 1  88                   dey
0018BDr 1  10 AC                bpl     @k
0018BFr 1  A9 00                lda     #0              ; then the free slots: rocks big first, bullets
0018C1r 1  8D rr rr             sta     hp_sz
0018C4r 1  A2 05        @sz:    ldx     #O_ROCK
0018C6r 1  AD rr rr             lda     hp_sz
0018C9r 1  C9 03                cmp     #3
0018CBr 1  90 02                bcc     @r
0018CDr 1  A2 01                ldx     #O_BUL
0018CFr 1  BD rr rr     @r:     lda     o_kind,x
0018D2r 1  C9 03                cmp     #K_ROCK
0018D4r 1  D0 0A                bne     @nr
0018D6r 1  BD rr rr             lda     o_size,x
0018D9r 1  CD rr rr             cmp     hp_sz
0018DCr 1  F0 11                beq     @go
0018DEr 1  D0 79                bne     @rn
0018E0r 1  AC rr rr     @nr:    ldy     hp_sz           ; (bullets in the last round)
0018E3r 1  C0 03                cpy     #3
0018E5r 1  D0 72                bne     @rn
0018E7r 1  C9 02                cmp     #K_BUL
0018E9r 1  F0 04                beq     @go
0018EBr 1  C9 06                cmp     #K_EBUL
0018EDr 1  D0 6A                bne     @rn
0018EFr 1  20 rr rr     @go:    jsr     obj_pic
0018F2r 1  20 rr rr             jsr     classify
0018F5r 1  AD rr rr             lda     cl_need
0018F8r 1  F0 5C                beq     @drop           ; (a corner: fb)
0018FAr 1  BD rr rr             lda     o_have,x        ; slots still wanted: need - have
0018FDr 1  A8                   tay
0018FEr 1  AD rr rr             lda     cl_need
001901r 1  38                   sec
001902r 1  F9 rr rr             sbc     have_n,y
001905r 1  F0 52                beq     @rn             ; (it has them)
001907r 1  8D rr rr             sta     tmp3
00190Ar 1  A0 0D                ldy     #NRSL-1         ; free slots enough?
00190Cr 1  A9 00                lda     #0
00190Er 1  8D rr rr             sta     tmp2
001911r 1  B9 rr rr     @cf:    lda     sl_obj,y
001914r 1  D0 03                bne     @cn
001916r 1  EE rr rr             inc     tmp2
001919r 1  88           @cn:    dey
00191Ar 1  10 F5                bpl     @cf
00191Cr 1  AD rr rr             lda     tmp2
00191Fr 1  CD rr rr             cmp     tmp3
001922r 1  90 32                bcc     @drop           ; no: fb (and the slots it has go)
001924r 1  A0 0D                ldy     #NRSL-1         ; take them
001926r 1  B9 rr rr     @tk:    lda     sl_obj,y
001929r 1  D0 26                bne     @tn
00192Br 1  BD rr rr             lda     o_have,x        ; the main part first, then the other
00192Er 1  29 01                and     #1
001930r 1  99 rr rr             sta     sl_part,y
001933r 1  BD rr rr             lda     o_have,x
001936r 1  4A                   lsr
001937r 1  BD rr rr             lda     o_have,x
