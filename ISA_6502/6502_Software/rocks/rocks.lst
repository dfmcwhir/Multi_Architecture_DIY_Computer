000D2Br 1  38                   sec
000D2Cr 1  ED rr rr             sbc     o_y_hi+O_UFO
000D2Fr 1  B0 02                bcs     @y1
000D31r 1  69 5C                adc     #FH
000D33r 1  C9 2E        @y1:    cmp     #FH/2
000D35r 1  90 02                bcc     @y2
000D37r 1  E9 5C                sbc     #FH
000D39r 1  8D rr rr     @y2:    sta     ady
000D3Cr 1  A9 00                lda     #0
000D3Er 1  8D rr rr             sta     abest
000D41r 1  A9 80                lda     #$80            ; best so far: the most negative
000D43r 1  8D rr rr             sta     abv_hi
000D46r 1  A9 00                lda     #0
000D48r 1  8D rr rr             sta     abv_lo
000D4Br 1  A0 1F                ldy     #NDIR-1
000D4Dr 1  B9 rr rr     @d:     lda     sin_tab+8,y     ; dx * cos
000D50r 1  AE rr rr             ldx     adx
000D53r 1  20 rr rr             jsr     smul8
000D56r 1  AD rr rr             lda     ml
000D59r 1  8D rr rr             sta     adot_lo
000D5Cr 1  AD rr rr             lda     mh
000D5Fr 1  8D rr rr             sta     adot_hi
000D62r 1  B9 rr rr             lda     sin_tab,y       ; + dy * sin
000D65r 1  AE rr rr             ldx     ady
000D68r 1  20 rr rr             jsr     smul8
000D6Br 1  AD rr rr             lda     ml
000D6Er 1  18                   clc
000D6Fr 1  6D rr rr             adc     adot_lo
000D72r 1  8D rr rr             sta     adot_lo
000D75r 1  AD rr rr             lda     mh
000D78r 1  6D rr rr             adc     adot_hi
000D7Br 1  8D rr rr             sta     adot_hi
000D7Er 1  AD rr rr             lda     adot_lo         ; bigger than the best? (signed)
000D81r 1  CD rr rr             cmp     abv_lo
000D84r 1  AD rr rr             lda     adot_hi
000D87r 1  ED rr rr             sbc     abv_hi
000D8Ar 1  50 02                bvc     @nv
000D8Cr 1  49 80                eor     #$80
000D8Er 1  30 0F        @nv:    bmi     @nb
000D90r 1  AD rr rr             lda     adot_lo
000D93r 1  8D rr rr             sta     abv_lo
