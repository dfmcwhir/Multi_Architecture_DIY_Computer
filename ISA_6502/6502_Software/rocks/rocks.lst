0008E7r 1  4A                   lsr
0008E8r 1  4A                   lsr
0008E9r 1  4A                   lsr
0008EAr 1  A8                   tay
0008EBr 1  B9 rr rr             lda     sin_tab+8,y
0008EEr 1  20 rr rr             jsr     sext8
0008F1r 1  20 rr rr             jsr     sar3
