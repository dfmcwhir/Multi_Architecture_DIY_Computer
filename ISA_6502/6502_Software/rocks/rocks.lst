000961r 1  60                   rts
000962r 1               ; w = w / 8 (arithmetic)
000962r 1  A2 03        sar3:   ldx     #3
000964r 1  AD rr rr     @l:     lda     w_hi
000967r 1  C9 80                cmp     #$80
000969r 1  6E rr rr             ror     w_hi
