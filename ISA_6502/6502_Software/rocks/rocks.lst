ca65 V2.19 - Git 52727a5
Main file   : rocks.s
Current file: rocks.s

000000r 1               ; ============================================================================
000000r 1               ; rocks.s - SPACE ROCKS, a game in the style of the arcade rock shooter,
000000r 1               ; for the 6502 SBC
000000r 1               ;
000000r 1               ; Runs from the monitor at $0500 and draws on the PIC32 terminal in its
000000r 1               ; control code mode (setup item J), terminal firmware v1.4 or later.
000000r 1               ;
000000r 1               ;   build:  make.bat  (or make)     needs ../sbc_api.inc (CLOCK_MHZ)
000000r 1               ;   run:    L ROCKS 0500   then   R
000000r 1               ;
000000r 1               ; Header (patchable from the monitor):
000000r 1               ;   $0500  JMP start
000000r 1               ;   $0503  frame time in ms (default 55; real ms at any clock)
000000r 1               ;   $0504  controls at start: 0 keyboard, 1 gamepad
000000r 1               ;   $0505  sound at start: 0 on, 1 off (M switches)
000000r 1               ;
000000r 1               ; Sound: the AY-3-8910 card at $7F22/$7F23, through ../ay/sfx.s (timed by
000000r 1               ; the VIA's timer 2), the sounds in rocks_sound.inc (made by
000000r 1               ; ../ay/tools/game_sounds.py).  Without the card the game is just silent.
000000r 1               ;
000000r 1               ; Keys:   A / D or Left / Right  turn      W or Up   thrust
000000r 1               ;         Space                  fire      S or Down hyperspace
000000r 1               ;         P pause   M sound on / off   Q quit
000000r 1               ; Gamepad: left / right turn, up thrust, A fire, B hyperspace, Start pause
000000r 1               ;
000000r 1               ; The playfield is text rows 1-23: 160 x 92 pixels.  Every frame it is drawn
000000r 1               ; in RAM (fb, one byte per character cell, 2 x 4 pixels each) and compared
000000r 1               ; with what the terminal shows (sb); only the characters that changed are
000000r 1               ; sent, runs of the same character with the terminal's repeat count.  Only
000000r 1               ; rows that had something drawn on them this frame or the last are looked at.
000000r 1               ;
000000r 1               ; Everything that moves is an "object": the ship (0), 4 bullets, 24 rocks,
000000r 1               ; 16 bits of debris, a flying saucer and its 2 bullets.  Positions and speeds are 8.8 fixed point pixels;
000000r 1               ; the field wraps round at the edges.  No zero page is used.
000000r 1               ; ============================================================================
000000r 1               
000000r 1                       .setcpu "6502"
000000r 1                       .include "sbc_api.inc"
000000r 2               ; sbc_api.inc - fixed ROM entry points of the SBC (see jumptable.s), and the
000000r 2               ; CPU clock.  Use in your own ca65 programs:  .include "sbc_api.inc"
000000r 2               ; (the games find it one folder up: their make.bat passes  -I ..  to ca65)
000000r 2               SBC_CHRIN       = $FE00         ; carry set + A = char, carry clear = none waiting
000000r 2               SBC_CHROUT      = $FE03         ; print A (A, X, Y preserved)
000000r 2               SBC_MENU        = $FE06         ; boot menu
000000r 2               SBC_COLD        = $FE09         ; BASIC cold start
000000r 2               SBC_WARM        = $FE0C         ; BASIC warm start
000000r 2               SBC_MONITOR     = $FE0F         ; monitor prompt (or JMP $FF00)
000000r 2               SBC_PADSTATE    = $FE12         ; A = gamepad buttons held: bit0 A,1 B,2 Select,3 Start,4 Up,5 Down,6 Left,7 Right
000000r 2               SBC_LOAD        = $FE15         ; load a file: A/Y = parameter block (.word addr, .word max, "NAME.EXT",0)
000000r 2                                               ;   carry clear = loaded, X/Y = length; carry set = failed, A = error code
000000r 2               SBC_CWD         = $FE18         ; A/Y = the monitor's current folder: 0-ended, "" (the top) or "/A/B"
000000r 2                                               ;   (newer ROMs: check for a JMP ($4C) at $FE18 first)
000000r 2               
000000r 2               ; The CPU clock in MHz (whole numbers, 1 to 8).  Programs size their delay
000000r 2               ; loops from it, so a millisecond stays a millisecond.  To build for another
000000r 2               ; clock, change it here or give it on the command line:  make.bat 1
000000r 2               .ifndef CLOCK_MHZ
000000r 2               CLOCK_MHZ       = 2
000000r 2               .endif
000000r 2               
000000r 1               
000000r 1               SPEED_DEFAULT   = 55            ; ms per frame
000000r 1               
000000r 1               ; ---- terminal --------------------------------------------------------------------
000000r 1               TC_CURSOR       = $02
000000r 1               TC_CLS          = $0C
000000r 1               TC_COL          = $0E
000000r 1               TC_ROW          = $0F
000000r 1               TC_ATTR         = $18
000000r 1               TC_LIT          = $1A
000000r 1               ATTR_TEXT       = $00
000000r 1               ATTR_GFX        = $80
000000r 1               TERM            = $FF
000000r 1               .define RV_ON   $1B, '[', '7', 'm'
000000r 1               .define RV_OFF  $1B, '[', '2', '7', 'm'
000000r 1               
000000r 1               ; ---- the field ---------------------------------------------------------------------
000000r 1               FW              = 160           ; pixels
000000r 1               FH              = 92
000000r 1               FROWS           = 23            ; text rows 1-23
000000r 1               COLS            = 80
000000r 1               
000000r 1               ; ---- objects -----------------------------------------------------------------------
000000r 1               NOBJ            = 48
000000r 1               O_SHIP          = 0
000000r 1               O_BUL           = 1             ; 1-4
000000r 1               NBUL            = 4
000000r 1               O_ROCK          = 5             ; 5-28
000000r 1               NROCK           = 24
000000r 1               O_PART          = 29            ; 29-44
000000r 1               NPART           = 16
000000r 1               O_UFO           = 45            ; the saucer
000000r 1               O_EB            = 46            ; 46-47: its bullets
000000r 1               NEB             = 2
000000r 1               K_NONE          = 0             ; o_kind
000000r 1               K_SHIP          = 1
000000r 1               K_BUL           = 2
000000r 1               K_ROCK          = 3
000000r 1               K_PART          = 4
000000r 1               K_UFO           = 5
000000r 1               K_EBUL          = 6
000000r 1               
000000r 1               BUL_LIFE        = 28            ; frames
000000r 1               FIRE_GAP        = 3
000000r 1               INVULN          = 50            ; frames after (re)appearing
000000r 1               RESPAWN_WAIT    = 40
000000r 1               
000000r 1               ; ============================================================================
