000B0Cr 1  90 04                bcc     @hi
000B0Er 1  18                   clc
000B0Fr 1  69 A0                adc     #FW
000B11r 1  60                   rts
000B12r 1  38           @hi:    sec
000B13r 1  E9 A0                sbc     #FW
000B15r 1  60           @r:     rts
000B16r 1  C9 5C        wrap_y: cmp     #FH
000B18r 1  90 0B                bcc     @r
000B1Ar 1  C9 8C                cmp     #FH + 48
000B1Cr 1  90 04                bcc     @hi
000B1Er 1  18                   clc
000B1Fr 1  69 5C                adc     #FH
000B21r 1  60                   rts
