000CFAr 1  AD rr rr             lda     w_hi
000CFDr 1  9D rr rr             sta     o_vy_hi,x
000D00r 1  60                   rts
000D01r 1               ; A = s.7 -> A (lo), w_hi = A * 4 (sign extended).  Preserves X, Y.
000D01r 1  20 rr rr     times4: jsr     sext8
000D04r 1  0E rr rr             asl     w_lo
000D07r 1  2E rr rr             rol     w_hi
000D0Ar 1  0E rr rr             asl     w_lo
000D0Dr 1  2E rr rr             rol     w_hi
000D10r 1  AD rr rr             lda     w_lo
000D13r 1  60                   rts
000D14r 1               
000D14r 1               ; A = the heading (0-31) from the saucer that points nearest the ship: the
000D14r 1               ; one with the biggest dx * cos + dy * sin
000D14r 1  AD rr rr     aim:    lda     o_x_hi+O_SHIP   ; dx round the wrap, -80 .. 79
000D17r 1  38                   sec
000D18r 1  ED rr rr             sbc     o_x_hi+O_UFO
000D1Br 1  B0 02                bcs     @x1
000D1Dr 1  69 A0                adc     #FW
