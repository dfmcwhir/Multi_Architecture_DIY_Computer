000BE1r 1  29 3F                and     #63
000BE3r 1  09 40                ora     #64
000BE5r 1  8D rr rr             sta     ufo_next
000BE8r 1  A2 00                ldx     #0              ; big, or small?
000BEAr 1  AD rr rr             lda     score+2
000BEDr 1  D0 07                bne     @maybe          ; 10000 points or more
000BEFr 1  AD rr rr             lda     wave
000BF2r 1  C9 03                cmp     #3
000BF4r 1  90 08                bcc     @size
000BF6r 1  20 rr rr     @maybe: jsr     rand
000BF9r 1  C9 6E                cmp     #110
000BFBr 1  B0 01                bcs     @size
000BFDr 1  E8                   inx
000BFEr 1  8E rr rr     @size:  stx     o_size+O_UFO
000C01r 1  A9 05                lda     #K_UFO
000C03r 1  8D rr rr             sta     o_kind+O_UFO
000C06r 1  8A                   txa
000C07r 1  18                   clc
000C08r 1  69 49                adc     #SH_UFO_BIG
000C0Ar 1  8D rr rr             sta     o_shape+O_UFO
