00094Fr 1  20 rr rr             jsr     friction
000952r 1  60                   rts
000953r 1               
000953r 1               ; w = A sign extended
000953r 1  8D rr rr     sext8:  sta     w_lo            ; (preserves X and Y)
000956r 1  C9 80                cmp     #$80
000958r 1  A9 00                lda     #0
