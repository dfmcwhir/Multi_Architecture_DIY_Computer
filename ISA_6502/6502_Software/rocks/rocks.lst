000C9Ar 1  C9 06                cmp     #6
000C9Cr 1  B0 1F                bcs     @dir
000C9Er 1  20 rr rr             jsr     rand
000CA1r 1  29 03                and     #3
000CA3r 1  38                   sec
000CA4r 1  E9 01                sbc     #1              ; -1 .. 2 -> mostly -1 .. 1
000CA6r 1  C9 02                cmp     #2
000CA8r 1  D0 02                bne     @j
000CAAr 1  A9 00                lda     #0
000CACr 1  18           @j:     clc
000CADr 1  6D rr rr             adc     tmp2
000CB0r 1  29 1F                and     #NDIR-1
000CB2r 1  4C rr rr             jmp     @dir2
000CB5r 1  20 rr rr     @rnd:   jsr     rand
000CB8r 1  29 1F                and     #NDIR-1
000CBAr 1  4C rr rr             jmp     @dir2
000CBDr 1  AD rr rr     @dir:   lda     tmp2
000CC0r 1  A8           @dir2:  tay
000CC1r 1  AE rr rr             ldx     ebx
000CC4r 1  A9 06                lda     #K_EBUL
000CC6r 1  9D rr rr             sta     o_kind,x
000CC9r 1  A9 1E                lda     #30
000CCBr 1  9D rr rr             sta     o_t,x
000CCEr 1  AD rr rr             lda     o_x_hi+O_UFO
000CD1r 1  9D rr rr             sta     o_x_hi,x
000CD4r 1  AD rr rr             lda     o_y_hi+O_UFO
000CD7r 1  9D rr rr             sta     o_y_hi,x
000CDAr 1  A9 80                lda     #$80
000CDCr 1  9D rr rr             sta     o_x_lo,x
000CDFr 1  9D rr rr             sta     o_y_lo,x
000CE2r 1  B9 rr rr             lda     sin_tab+8,y     ; v = (cos, sin) * 4 / 256 * 128 ~ 2 pixels
000CE5r 1  20 rr rr             jsr     times4
000CE8r 1  9D rr rr             sta     o_vx_lo,x
000CEBr 1  AD rr rr             lda     w_hi
000CEEr 1  9D rr rr             sta     o_vx_hi,x
000CF1r 1  B9 rr rr             lda     sin_tab,y
