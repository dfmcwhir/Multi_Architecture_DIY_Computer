000B26r 1               ; the ship blinks while it can't be hit; after a crash it comes back
000B26r 1               ship_life:
000B26r 1  AD rr rr             lda     inv_t
000B29r 1  F0 03                beq     @d
000B2Br 1  CE rr rr             dec     inv_t
000B2Er 1  AD rr rr     @d:     lda     o_kind+O_SHIP
000B31r 1  D0 25                bne     @r
000B33r 1  AD rr rr             lda     dead_t          ; waiting to come back
000B36r 1  F0 20                beq     @r
000B38r 1  C9 01                cmp     #1
000B3Ar 1  F0 1C                beq     @r              ; (1: stays, the game is over)
000B3Cr 1  CE rr rr             dec     dead_t
000B3Fr 1  AD rr rr             lda     dead_t
000B42r 1  C9 01                cmp     #1
000B44r 1  D0 12                bne     @r
000B46r 1  AD rr rr             lda     lives
000B49r 1  F0 0D                beq     @r
