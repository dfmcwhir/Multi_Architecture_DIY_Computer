000B59r 1               ; carry clear if no rock is near the middle
000B59r 1               centre_clear:
000B59r 1  A2 05                ldx     #O_ROCK
000B5Br 1  BD rr rr     @l:     lda     o_kind,x
000B5Er 1  C9 03                cmp     #K_ROCK
000B60r 1  D0 1C                bne     @n
000B62r 1  BD rr rr             lda     o_x_hi,x
