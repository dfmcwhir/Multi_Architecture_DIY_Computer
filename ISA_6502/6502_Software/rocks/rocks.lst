000ABFr 1               ; A = s.7 sine -> A = sine * 4 / 128 rounded (about -4..4)
000ABFr 1               nose_ofs:
000ABFr 1  18                   clc
000AC0r 1  69 80                adc     #$80            ; 0..255 offset by 128
000AC2r 1  4A                   lsr
000AC3r 1  4A                   lsr
000AC4r 1  4A                   lsr
000AC5r 1  4A                   lsr
000AC6r 1  4A                   lsr                     ; 0..7
000AC7r 1  38                   sec
000AC8r 1  E9 04                sbc     #4
000ACAr 1  60                   rts
000ACBr 1               ; w = A (s.7) * 5 / 2  (a 2.5 pixels a frame speed component, 8.8)
000ACBr 1  8E rr rr     times5: stx     t5x
000ACEr 1  20 rr rr             jsr     sext8
000AD1r 1  AD rr rr             lda     w_lo            ; w * 5
000AD4r 1  8D rr rr             sta     tmp
000AD7r 1  AD rr rr             lda     w_hi
000ADAr 1  8D rr rr             sta     tmp+1
000ADDr 1  0E rr rr             asl     w_lo
000AE0r 1  2E rr rr             rol     w_hi
000AE3r 1  0E rr rr             asl     w_lo
000AE6r 1  2E rr rr             rol     w_hi
000AE9r 1  AD rr rr             lda     w_lo
000AECr 1  18                   clc
000AEDr 1  6D rr rr             adc     tmp
000AF0r 1  8D rr rr             sta     w_lo
000AF3r 1  AD rr rr             lda     w_hi
000AF6r 1  6D rr rr             adc     tmp+1
000AF9r 1  8D rr rr             sta     w_hi
000AFCr 1  0E rr rr             asl     w_lo            ; * 2: s.7 * 10 / 256 * 256 ... = 2.5 px at 127
000AFFr 1  2E rr rr             rol     w_hi
000B02r 1  AE rr rr             ldx     t5x
000B05r 1  60                   rts
