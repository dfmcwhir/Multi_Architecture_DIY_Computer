0008F9r 1  B9 rr rr             lda     sin_tab,y
0008FCr 1  20 rr rr             jsr     sext8
0008FFr 1  20 rr rr             jsr     sar3
000902r 1  A2 00                ldx     #O_SHIP
000904r 1  20 rr rr             jsr     add_vy
000907r 1  20 rr rr             jsr     clamp_ship
