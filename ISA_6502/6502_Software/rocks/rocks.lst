000D99r 1  8D rr rr             sta     abv_hi
000D9Cr 1  8C rr rr             sty     abest
000D9Fr 1  88           @nb:    dey
000DA0r 1  10 AB                bpl     @d
000DA2r 1  AD rr rr             lda     abest
000DA5r 1  60                   rts
000DA6r 1               
000DA6r 1               ; mh:ml = A * X, both signed.  Preserves Y.
