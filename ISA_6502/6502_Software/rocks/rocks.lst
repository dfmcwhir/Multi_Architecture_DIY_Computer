000B4Er 1  B0 03                bcs     @wait
000B50r 1  4C rr rr             jmp     spawn_ship
000B53r 1  A9 02        @wait:  lda     #2
000B55r 1  8D rr rr             sta     dead_t
000B58r 1  60           @r:     rts
