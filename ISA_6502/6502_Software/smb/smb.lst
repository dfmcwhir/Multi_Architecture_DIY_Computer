000338r 1  xx           bits:       .res 1              ; bits picked up (8: a byte)
000339r 1  xx           in_room:    .res 1              ; 1: in the bonus room
00033Ar 1  xx           oc_t:       .res 1              ; overclocked: frames left
00033Br 1  xx           sw_t:       .res 1              ; swimming: frames of the kick's picture left
00033Cr 1  xx           lv_wsave:   .res 1              ; (the level outside the bonus room)
00033Dr 1  xx xx        sc_save:    .res 2
00033Fr 1  xx xx        max_save:   .res 2
000341r 1  xx           dr_spd:     .res 1              ; KIL, this world: pacing speed
000342r 1  xx           dr_jb:      .res 1              ; ... jump wait
000343r 1  xx           dr_bb:      .res 1              ; ... fire wait
000344r 1  xx           dr_jv:      .res 1              ; ... jump speed (high byte, up)
000345r 1  xx           bytes:      .res 1              ; bytes ($0C: a life)
000346r 1  xx           pbase:      .res 1
000347r 1  xx xx xx xx  svmin:      .res PROWS
00034Br 1  xx xx xx xx  
00034Fr 1  xx xx xx xx  
00035Dr 1  xx xx xx xx  svmax:      .res PROWS
000361r 1  xx xx xx xx  
000365r 1  xx xx xx xx  
000373r 1  xx           duck:       .res 1              ; MOS is ducking
000374r 1  xx           in_down:    .res 1
000375r 1  xx           kduck:      .res 1
000376r 1               bss_end:
000376r 1               
000376r 1                       .segment "BUFS"
000000r 1  xx xx xx xx  map:        .res MAPROWS * 256  ; the level: a page a row, tile number * 4
000004r 1  xx xx xx xx  
000008r 1  xx xx xx xx  
000B00r 1  xx xx xx xx  wc:         .res PROWS * 256    ; the view as it should be (a page a row, by world column)
000B04r 1  xx xx xx xx  
000B08r 1  xx xx xx xx  
002100r 1  xx xx xx xx  sh:         .res PROWS * 256    ; the view as the terminal shows it (by world column too)
002104r 1  xx xx xx xx  
002108r 1  xx xx xx xx  
002100r 1               
