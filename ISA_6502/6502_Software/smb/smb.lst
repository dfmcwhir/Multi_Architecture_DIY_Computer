0007D4r 1  AD rr rr             lda     lvl
0007D7r 1  18                   clc
0007D8r 1  69 01                adc     #1
0007DAr 1  4C rr rr             jmp     prdec
0007DDr 1               
0007DDr 1               ; clear the screen and forget what it showed
0007DDr 1               new_screen:
0007DDr 1  A9 rr                lda     #<cls_txt
0007DFr 1  A0 rr                ldy     #>cls_txt
0007E1r 1  20 rr rr             jsr     print
0007E4r 1  A2 00                ldx     #0
0007E6r 1  A9 00                lda     #0
0007E8r 1  9D rr rr 9D  @c:     .repeat PROWS, K
0007ECr 1  rr rr 9D rr  
0007F0r 1  rr 9D rr rr  
00082Ar 1                       sta     sh + K * 256,x
00082Ar 1                       .endrepeat
00082Ar 1  E8                   inx
00082Br 1  D0 BB                bne     @c
00082Dr 1  A2 15                ldx     #PROWS-1
00082Fr 1  A9 FF        @d:     lda     #$FF
000831r 1  9D rr rr             sta     dmin,x
000834r 1  A9 01                lda     #1
000836r 1  9D rr rr             sta     sh_empty,x
000839r 1  A9 00                lda     #0
00083Br 1  9D rr rr             sta     dmax,x
00083Er 1  CA                   dex
00083Fr 1  10 EE                bpl     @d
000841r 1  8D rr rr             sta     nrect
000844r 1  A9 rr                lda     #<region_txt    ; the view (text rows 3-24) scrolls by itself
000846r 1  A0 rr                ldy     #>region_txt
000848r 1               .if SOFT_SPRITES
000848r 1                       jmp     print
000848r 1               .else
000848r 1  20 rr rr             jsr     print
