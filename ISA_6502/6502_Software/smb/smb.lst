0003E5r 1               
0003E5r 1               ; print A as two BCD digits
0003E5r 1  48           prbcd:  pha
0003E6r 1  4A                   lsr
0003E7r 1  4A                   lsr
0003E8r 1  4A                   lsr
0003E9r 1  4A                   lsr
0003EAr 1  09 30                ora     #'0'
0003ECr 1  20 rr rr             jsr     putc
0003EFr 1  68                   pla
0003F0r 1  29 0F                and     #$0F
0003F2r 1  09 30                ora     #'0'
0003F4r 1  4C rr rr             jmp     putc
0003F7r 1               
0003F7r 1               ; print A as two hex digits
0003F7r 1  48           prhex:  pha
0003F8r 1  4A                   lsr
0003F9r 1  4A                   lsr
0003FAr 1  4A                   lsr
0003FBr 1  4A                   lsr
0003FCr 1  20 rr rr             jsr     @d
0003FFr 1  68                   pla
000400r 1  29 0F                and     #$0F
000402r 1  C9 0A        @d:     cmp     #10
000404r 1  90 02                bcc     @n
000406r 1  69 06                adc     #'A' - '0' - 10 - 1
000408r 1  69 30        @n:     adc     #'0'
00040Ar 1  4C rr rr             jmp     putc
00040Dr 1               
00040Dr 1               ; print A (0-99) in decimal, without a leading zero
00040Dr 1  A2 30        prdec:  ldx     #'0'
00040Fr 1  C9 0A        @t:     cmp     #10
000411r 1  90 05                bcc     @u
000413r 1  E9 0A                sbc     #10
000415r 1  E8                   inx
000416r 1  D0 F7                bne     @t
000418r 1  48           @u:     pha
000419r 1  E0 30                cpx     #'0'
00041Br 1  F0 04                beq     @one
00041Dr 1  8A                   txa
00041Er 1  20 rr rr             jsr     putc
000421r 1  68           @one:   pla
000422r 1  09 30                ora     #'0'
000424r 1  4C rr rr             jmp     putc
000427r 1               
000427r 1               ; 16 bit Galois LFSR.  A = a random byte.  Preserves X and Y.
000427r 1  AD rr rr     rand:   lda     rng+1
00042Ar 1  4A                   lsr
00042Br 1  6E rr rr             ror     rng
00042Er 1  90 02                bcc     @n
000430r 1  49 B4                eor     #$B4
000432r 1  8D rr rr     @n:     sta     rng+1
000435r 1  4D rr rr             eor     rng
000438r 1  60                   rts
000439r 1               
000439r 1               ; wait about A ms.  The inner loop is sized for the clock (CLOCK_MHZ in
000439r 1               ; sbc_api.inc): 5 + 4 * (CLOCK_MHZ - 1) cycles a turn, DELAY_N turns a ms.
000439r 1               DELAY_N = (1000 * CLOCK_MHZ - 7) / (5 + 4 * (CLOCK_MHZ - 1))
000439r 1               delay_ms:
000439r 1  AA                   tax
00043Ar 1  F0 0D                beq     @done
00043Cr 1               @o:
00043Cr 1               .if SOUND
00043Cr 1  20 rr rr             jsr     sfx_poll        ; (and while waiting)
00043Fr 1               .endif
00043Fr 1  A0 DD                ldy     #DELAY_N
000441r 1               @i:
000441r 1  EA EA        .repeat CLOCK_MHZ - 1
000443r 1                       nop
000443r 1                       nop
000443r 1               .endrepeat
000443r 1  88                   dey
000444r 1  D0 FB                bne     @i
000446r 1  CA                   dex
000447r 1  D0 F3                bne     @o
000449r 1  60           @done:  rts
00044Ar 1               
00044Ar 1               ; wait about A x 50 ms, dropping keys pressed meanwhile
00044Ar 1               delay_long:
00044Ar 1  8D rr rr             sta     tmp
00044Dr 1  A9 32        @l:     lda     #50
00044Fr 1  20 rr rr             jsr     delay_ms
000452r 1  20 rr rr             jsr     flush_in
000455r 1  CE rr rr             dec     tmp
000458r 1  D0 F3                bne     @l
00045Ar 1  60                   rts
00045Br 1               
00045Br 1               .macro MENU_IDLE
00045Br 1                       jsr     rand            ; (waiting stirs the random numbers)
00045Br 1               .if SOUND
00045Br 1                       jsr     sfx_poll
00045Br 1               .endif
00045Br 1               .endmacro
00045Br 1               CTRL_COL        = 19
00045Br 1               CTRL_ROW        = 20
00045Br 1               
00045Br 1               ; ============================================================================
00045Br 1               ; gamepad and menu input (shared by the SBC games)
00045Br 1               ; ============================================================================
00045Br 1               PAD_A           = $01           ; bits returned by SBC_PADSTATE
00045Br 1               PAD_B           = $02
00045Br 1               PAD_SELECT      = $04
00045Br 1               PAD_START       = $08
00045Br 1               PAD_UP          = $10
00045Br 1               PAD_DOWN        = $20
00045Br 1               PAD_LEFT        = $40
00045Br 1               PAD_RIGHT       = $80
00045Br 1               PAD_GO          = $80           ; menu_key's answer for gamepad A or Start
00045Br 1               
00045Br 1               ; read the gamepad: pad = buttons held now, padnew = buttons pressed since
00045Br 1               ; the last call.  Preserves X and Y (SBC_PADSTATE only changes A).
00045Br 1               read_pad:
00045Br 1  20 12 FE             jsr     SBC_PADSTATE
00045Er 1  C9 FF                cmp     #$FF            ; every button "pressed" = no pad
000460r 1  D0 02                bne     @ok
000462r 1  A9 00                lda     #0
000464r 1  8D rr rr     @ok:    sta     pad
000467r 1  AD rr rr             lda     padold
00046Ar 1  49 FF                eor     #$FF
00046Cr 1  2D rr rr             and     pad
00046Fr 1  8D rr rr             sta     padnew
000472r 1  AD rr rr             lda     pad
000475r 1  8D rr rr             sta     padold
000478r 1  60                   rts
000479r 1               
000479r 1               ; throw away waiting characters
000479r 1               flush_in:
000479r 1  20 rr rr             jsr     getc
00047Cr 1  B0 FB                bcs     flush_in
00047Er 1  60                   rts
00047Fr 1               
00047Fr 1               ; carry set if A is one of the characters the gamepad driver types for the
00047Fr 1               ; pad (W A S D and space).  Those are ignored in gamepad mode so that one
00047Fr 1               ; press doesn't act twice.  Preserves A.
00047Fr 1               pad_typed:
00047Fr 1  C9 20                cmp     #' '
000481r 1  F0 12                beq     @y
000483r 1  C9 57                cmp     #'W'
000485r 1  F0 0E                beq     @y
000487r 1  C9 41                cmp     #'A'
000489r 1  F0 0A                beq     @y
00048Br 1  C9 53                cmp     #'S'
00048Dr 1  F0 06                beq     @y
00048Fr 1  C9 44                cmp     #'D'
000491r 1  F0 02                beq     @y
000493r 1  18                   clc
000494r 1  60                   rts
000495r 1  38           @y:     sec
000496r 1  60                   rts
000497r 1               
000497r 1               ; wait for a menu choice.  Returns a key (letters in upper case), or
000497r 1               ; PAD_GO for the gamepad's A or Start button.
000497r 1               menu_key:
000497r 1  20 rr rr 20  @l:     MENU_IDLE
00049Br 1  rr rr        
00049Dr 1  20 rr rr             jsr     read_pad
0004A0r 1  AD rr rr             lda     padnew
0004A3r 1  29 09                and     #PAD_A | PAD_START
0004A5r 1  D0 21                bne     @pad
0004A7r 1  20 rr rr             jsr     getc
0004AAr 1  90 EB                bcc     @l
0004ACr 1  C9 20                cmp     #' '            ; a space typed by the pad's A button?
0004AEr 1  D0 0D                bne     @up
0004B0r 1  20 rr rr             jsr     read_pad
0004B3r 1  AD rr rr             lda     pad
0004B6r 1  29 01                and     #PAD_A
0004B8r 1  D0 0E                bne     @pad
0004BAr 1  A9 20                lda     #' '
0004BCr 1  60                   rts
0004BDr 1  C9 61        @up:    cmp     #'a'
0004BFr 1  90 06                bcc     @r
0004C1r 1  C9 7B                cmp     #'z'+1
0004C3r 1  B0 02                bcs     @r
0004C5r 1  29 DF                and     #$DF
0004C7r 1  60           @r:     rts
0004C8r 1  20 rr rr     @pad:   jsr     flush_in        ; the space the driver typed for it
0004CBr 1  A9 80                lda     #PAD_GO
0004CDr 1  60                   rts
0004CEr 1               
0004CEr 1               ; print the controls line (CTRL_COL, CTRL_ROW)
0004CEr 1               show_ctrl:
0004CEr 1  20 rr rr             jsr     txt_mode
0004D1r 1  A2 13                ldx     #CTRL_COL
0004D3r 1  A0 14                ldy     #CTRL_ROW
0004D5r 1  20 rr rr             jsr     gotoxy
0004D8r 1  AD rr rr             lda     ctrl
0004DBr 1  F0 07                beq     @kb
0004DDr 1  A9 rr                lda     #<ctrl_pad_txt
0004DFr 1  A0 rr                ldy     #>ctrl_pad_txt
0004E1r 1  4C rr rr             jmp     print
0004E4r 1  A9 rr        @kb:    lda     #<ctrl_kb_txt
0004E6r 1  A0 rr                ldy     #>ctrl_kb_txt
0004E8r 1  4C rr rr             jmp     print
0004EBr 1               
0004EBr 1               ; ============================================================================
0004EBr 1               ; start, title
0004EBr 1               ; ============================================================================
0004EBr 1  D8           start:  cld
0004ECr 1  A2 FF                ldx     #$FF
0004EEr 1  9A                   txs
0004EFr 1  A9 00                lda     #0              ; clear the variables (RAM is random at power-up)
0004F1r 1  AA                   tax
0004F2r 1  A0 04                ldy     #>(bss_end - bss_start + $FF)
0004F4r 1  9D rr rr     @c1:    sta     bss_start,x
0004F7r 1  E8                   inx
0004F8r 1  D0 FA                bne     @c1
0004FAr 1  EE rr rr             inc     @c1+2
0004FDr 1  88                   dey
0004FEr 1  D0 F4                bne     @c1
000500r 1  AD rr rr             lda     ctrl_def
000503r 1  8D rr rr             sta     ctrl
000506r 1  A9 5A                lda     #$5A
000508r 1  8D rr rr             sta     rng
00050Br 1  A9 FF                lda     #$FF
00050Dr 1  8D rr rr             sta     attr
000510r 1               .if SOUND
000510r 1  20 rr rr             jsr     sfx_init
000513r 1  AD rr rr             lda     mute_def
000516r 1  8D 71 01             sta     sfx_mute
000519r 1               .endif
000519r 1               .if !SOFT_SPRITES
000519r 1  20 rr rr             jsr     spr_setup
00051Cr 1               .endif
00051Cr 1               
00051Cr 1               title:
00051Cr 1               .if SOUND
00051Cr 1  20 rr rr             jsr     sfx_off
00051Fr 1               .endif
00051Fr 1               .if !SOFT_SPRITES
00051Fr 1  A9 00                lda     #0              ; (S P 1 are keys again)
000521r 1  8D rr rr             sta     rp_on
000524r 1               .endif
000524r 1  A9 rr                lda     #<cls_txt
000526r 1  A0 rr                ldy     #>cls_txt
000528r 1  20 rr rr             jsr     print
00052Br 1               .if SOFT_SPRITES
00052Br 1                       jsr     gfx_mode        ; the banner
00052Br 1                       lda     #<banner
00052Br 1                       sta     @b+1
00052Br 1                       lda     #>banner
00052Br 1                       sta     @b+2
00052Br 1               @line:  jsr     @next           ; text row (0: the end)
00052Br 1                       beq     @txt
00052Br 1                       tay
00052Br 1                       jsr     @next           ; first column
00052Br 1                       tax
00052Br 1                       jsr     gotoxy
00052Br 1                       jsr     @next           ; how many
00052Br 1                       sta     tmp
00052Br 1               @ch:    jsr     @next
00052Br 1                       jsr     putblk
00052Br 1                       dec     tmp
00052Br 1                       bne     @ch
00052Br 1                       beq     @line
00052Br 1               @next:
00052Br 1               @b:     lda     $FFFF
00052Br 1                       inc     @b+1
00052Br 1                       bne     @nr
00052Br 1                       inc     @b+2
00052Br 1               @nr:    cmp     #0
00052Br 1                       rts
00052Br 1               .else
00052Br 1  20 rr rr             jsr     gfx_mode        ; the banner: two terminal tiles (SMBSPR.SMB
00052Er 1  A2 1A                ldx     #BAN0_COL       ; defined them)
000530r 1  A0 02                ldy     #BAN0_ROW
000532r 1  20 rr rr             jsr     gotoxy
000535r 1  A9 0B                lda     #TC_TILE
000537r 1  20 rr rr             jsr     putc
00053Ar 1  A9 00                lda     #BAN0_SLOT
00053Cr 1  20 rr rr             jsr     putc
00053Fr 1  A2 0E                ldx     #BAN1_COL
000541r 1  A0 07                ldy     #BAN1_ROW
000543r 1  20 rr rr             jsr     gotoxy
000546r 1  A9 0B                lda     #TC_TILE
000548r 1  20 rr rr             jsr     putc
00054Br 1  A9 01                lda     #BAN1_SLOT
00054Dr 1  20 rr rr             jsr     putc
000550r 1               .endif
000550r 1  A9 rr        @txt:   lda     #<title_txt
000552r 1  A0 rr                ldy     #>title_txt
000554r 1  20 rr rr             jsr     print
000557r 1  20 rr rr             jsr     txt_mode
00055Ar 1  A2 21                ldx     #33
00055Cr 1  A0 12                ldy     #18
00055Er 1  20 rr rr             jsr     gotoxy
000561r 1  A9 rr                lda     #<hi_txt
000563r 1  A0 rr                ldy     #>hi_txt
000565r 1  20 rr rr             jsr     print
000568r 1  AD rr rr             lda     hiscore+2
00056Br 1  20 rr rr             jsr     prhex
00056Er 1  AD rr rr             lda     hiscore+1
000571r 1  20 rr rr             jsr     prhex
000574r 1  AD rr rr             lda     hiscore
000577r 1  20 rr rr             jsr     prhex
00057Ar 1  20 rr rr             jsr     show_ctrl
00057Dr 1  20 rr rr             jsr     read_pad
000580r 1  20 rr rr             jsr     flush_in
000583r 1  20 rr rr     @wait:  jsr     menu_key
000586r 1  C9 51                cmp     #'Q'
000588r 1  D0 03                bne     @notq
00058Ar 1  4C rr rr             jmp     exit_game
00058Dr 1               @notq:
00058Dr 1               .if SOUND
00058Dr 1  C9 4D                cmp     #'M'            ; sound on / off
00058Fr 1  D0 06                bne     @notm
000591r 1  20 rr rr             jsr     toggle_sound
000594r 1  4C rr rr             jmp     @wait
000597r 1               @notm:
000597r 1               .endif
000597r 1  C9 47                cmp     #'G'
000599r 1  D0 0E                bne     @notg
00059Br 1  AD rr rr             lda     ctrl
00059Er 1  49 01                eor     #1
0005A0r 1  8D rr rr             sta     ctrl
0005A3r 1  20 rr rr             jsr     show_ctrl
0005A6r 1  4C rr rr             jmp     @wait
0005A9r 1  C9 80        @notg:  cmp     #PAD_GO
0005ABr 1  D0 08                bne     @notp
0005ADr 1  A9 01                lda     #1
0005AFr 1  8D rr rr             sta     ctrl
0005B2r 1  4C rr rr             jmp     new_game
0005B5r 1  C9 20        @notp:  cmp     #' '
0005B7r 1  D0 CA                bne     @wait
0005B9r 1  4C rr rr             jmp     new_game
0005BCr 1               
0005BCr 1               exit_game:
0005BCr 1               .if SOUND
0005BCr 1  20 rr rr             jsr     sfx_off
0005BFr 1               .endif
0005BFr 1  A9 rr                lda     #<bye_txt
0005C1r 1  A0 rr                ldy     #>bye_txt
0005C3r 1  20 rr rr             jsr     print
0005C6r 1  4C 06 FE             jmp     SBC_MENU
0005C9r 1               
0005C9r 1               ; ============================================================================
0005C9r 1               ; a game
0005C9r 1               ; ============================================================================
0005C9r 1               new_game:
0005C9r 1  A9 00                lda     #0
0005CBr 1               .if !SOFT_SPRITES
0005CBr 1  8D rr rr             sta     rp_miss
0005CEr 1               .endif
0005CEr 1  8D rr rr             sta     score
0005D1r 1  8D rr rr             sta     score+1
0005D4r 1  8D rr rr             sta     score+2
0005D7r 1  8D rr rr             sta     bits
0005DAr 1  8D rr rr             sta     bytes
0005DDr 1  8D rr rr             sta     lvl
0005E0r 1  8D rr rr             sta     big
0005E3r 1  8D rr rr             sta     fire
0005E6r 1  A9 01                lda     #1
0005E8r 1  8D rr rr             sta     world
0005EBr 1  8D rr rr             sta     wsrc
0005EEr 1  A9 03                lda     #3
0005F0r 1  8D rr rr             sta     lives
0005F3r 1               
0005F3r 1               ; ---- a level: "WORLD 1-1  x 3" for a moment, then play -------------------------------
0005F3r 1               start_level:
0005F3r 1  20 rr rr             jsr     get_world       ; (worlds 2 and up: from the USB drive)
0005F6r 1  90 43                bcc     @ok
0005F8r 1  AD rr rr             lda     wsrc            ; (no 1-1 at all: a word, and back to the title)
0005FBr 1  C9 01                cmp     #1
0005FDr 1  D0 14                bne     @nd
0005FFr 1  AD rr rr             lda     lvl
000602r 1  D0 0F                bne     @nd
000604r 1  A9 rr                lda     #<noworld_txt
000606r 1  A0 rr                ldy     #>noworld_txt
000608r 1  20 rr rr             jsr     print
00060Br 1  A9 64                lda     #100
00060Dr 1  20 rr rr             jsr     delay_long
000610r 1  4C rr rr             jmp     title
000613r 1  A9 rr        @nd:    lda     #<nodisk_txt    ; no more worlds: around again
000615r 1  A0 rr                ldy     #>nodisk_txt
000617r 1  20 rr rr             jsr     print
00061Ar 1  AD rr rr             lda     wsrc
00061Dr 1  09 30                ora     #'0'
00061Fr 1  20 rr rr             jsr     putc
000622r 1  A9 rr                lda     #<nodisk2_txt
000624r 1  A0 rr                ldy     #>nodisk2_txt
000626r 1  20 rr rr             jsr     print
000629r 1  A9 3C                lda     #60
00062Br 1  20 rr rr             jsr     delay_long
00062Er 1  A9 01                lda     #1
000630r 1  8D rr rr             sta     wsrc
000633r 1  A9 00                lda     #0
000635r 1  8D rr rr             sta     lvl
000638r 1  4C rr rr             jmp     start_level
00063Br 1  A9 rr        @ok:    lda     #<cls_txt
00063Dr 1  A0 rr                ldy     #>cls_txt
00063Fr 1  20 rr rr             jsr     print
000642r 1  A2 23                ldx     #35
000644r 1  A0 09                ldy     #9
000646r 1  20 rr rr             jsr     gotoxy
000649r 1  A9 rr                lda     #<world_txt
00064Br 1  A0 rr                ldy     #>world_txt
00064Dr 1  20 rr rr             jsr     print
000650r 1  20 rr rr             jsr     pr_world
000653r 1  A2 24                ldx     #36
000655r 1  A0 0C                ldy     #12
000657r 1  20 rr rr             jsr     gotoxy
00065Ar 1  A9 rr                lda     #<lives_txt
00065Cr 1  A0 rr                ldy     #>lives_txt
00065Er 1  20 rr rr             jsr     print
000661r 1  AD rr rr             lda     lives
000664r 1  20 rr rr             jsr     prdec
000667r 1  20 rr rr             jsr     load_level
00066Ar 1  A9 1E                lda     #30
00066Cr 1  20 rr rr             jsr     delay_long
00066Fr 1  20 rr rr             jsr     new_screen
000672r 1  A9 rr                lda     #<status_txt
000674r 1  A0 rr                ldy     #>status_txt
000676r 1  20 rr rr             jsr     print
000679r 1  AD rr rr             lda     lv_flags        ; a castle: a word about KIL
00067Cr 1  29 01                and     #1
00067Er 1  F0 07                beq     @nk
000680r 1  A9 rr                lda     #<kil_txt
000682r 1  A0 rr                ldy     #>kil_txt
000684r 1  20 rr rr             jsr     print
000687r 1  A9 01        @nk:    lda     #1
000689r 1  8D rr rr             sta     hud_dirty
00068Cr 1  8D rr rr             sta     full
00068Fr 1               .if SOUND
00068Fr 1  20 rr rr             jsr     sfx_off
000692r 1  20 rr rr             jsr     music_level
000695r 1               .endif
000695r 1               
000695r 1               ; ---- the frame loop --------------------------------------------------------------
000695r 1               game_loop:
000695r 1  A9 00                lda     #0
000697r 1  8D rr rr             sta     nbytes
00069Ar 1  8D rr rr             sta     nbytes+1
00069Dr 1  8D rr rr             sta     ncells
0006A0r 1  8D rr rr             sta     ncmp
0006A3r 1  8D rr rr             sta     ncmp+1
0006A6r 1  8D rr rr             sta     nrows_seen
0006A9r 1  8D rr rr             sta     scrolled
0006ACr 1  20 rr rr             jsr     read_input
0006AFr 1  AD rr rr             lda     quit
0006B2r 1  F0 03                beq     @1
0006B4r 1  4C rr rr             jmp     title
0006B7r 1               @1:
0006B7r 1               .if !SOFT_SPRITES
0006B7r 1  20 rr rr             jsr     heal_tick       ; tiles changed a while ago: send them again
0006BAr 1               .endif
0006BAr 1  20 rr rr             jsr     mos_update
0006BDr 1  20 rr rr             jsr     obj_update
0006C0r 1  20 rr rr             jsr     fire_update
0006C3r 1  20 rr rr             jsr     obj_collide
0006C6r 1  20 rr rr             jsr     camera
0006C9r 1  20 rr rr             jsr     spawn_enemies
0006CCr 1  20 rr rr             jsr     clock
0006CFr 1  20 rr rr             jsr     render
0006D2r 1  20 rr rr             jsr     hud_update
0006D5r 1               .if !SOFT_SPRITES
0006D5r 1  20 rr rr             jsr     ask_send        ; the terminal answers when it has drawn it all
0006D8r 1               .endif
0006D8r 1  20 rr rr             jsr     pace
0006DBr 1  EE rr rr             inc     frame
0006DEr 1  AD rr rr             lda     mstate          ; the end of a life, or of the level?
0006E1r 1  C9 04                cmp     #MS_DEAD
0006E3r 1  D0 0A                bne     @2
0006E5r 1  AD rr rr             lda     mtimer
0006E8r 1  C9 4B                cmp     #75
0006EAr 1  90 A9                bcc     game_loop
0006ECr 1  4C rr rr             jmp     life_lost
0006EFr 1  C9 07        @2:     cmp     #MS_RESCUE
0006F1r 1  D0 0D                bne     @3
0006F3r 1  AD rr rr             lda     mtimer
0006F6r 1  C9 1E                cmp     #30
0006F8r 1  B0 03                bcs     *+5
0006FAr 1  4C rr rr             jmp     game_loop
0006FDr 1  4C rr rr             jmp     the_end
000700r 1  C9 03        @3:     cmp     #MS_IN
000702r 1  F0 03                beq     *+5
000704r 1  4C rr rr             jmp     game_loop
000707r 1  AD rr rr             lda     mtimer
00070Ar 1  C9 14                cmp     #20
00070Cr 1  B0 03                bcs     *+5
00070Er 1  4C rr rr             jmp     game_loop
000711r 1  4C rr rr             jmp     level_done
000714r 1               
000714r 1               ; Princess Graphics Card: the end of the game
