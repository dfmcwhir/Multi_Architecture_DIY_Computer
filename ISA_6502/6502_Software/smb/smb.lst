00033Cr 1               ; ----------------------------------------------------------------------------
00033Cr 1               ; I/O helpers
00033Cr 1               ; ----------------------------------------------------------------------------
00033Cr 1               .if SOFT_SPRITES
00033Cr 1               getc            = SBC_CHRIN     ; carry set = key in A
00033Cr 1               .else
00033Cr 1               ; carry set = key in A.  After IDENTIFY (1C 0C) the terminal answers S P 1:
00033Cr 1               ; those are taken as its reply (rp_got), not as keys, until the 1 comes or
00033Cr 1               ; the next IDENTIFY.  (A reply character can be missed: any one will do.)
00033Cr 1  20 00 FE     getc:   jsr     SBC_CHRIN
00033Fr 1  90 24                bcc     @r
000341r 1  48                   pha
000342r 1  AD rr rr             lda     rp_on
000345r 1  F0 1C                beq     @key
000347r 1  68                   pla
000348r 1  C9 53                cmp     #'S'
00034Ar 1  F0 0D                beq     @rep
00034Cr 1  C9 50                cmp     #'P'
00034Er 1  F0 09                beq     @rep
000350r 1  C9 31                cmp     #'1'
000352r 1  D0 0D                bne     @k2
000354r 1  A9 00                lda     #0
