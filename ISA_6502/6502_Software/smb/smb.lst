0007A7r 1  20 rr rr             jsr     delay_long
0007AAr 1  20 rr rr     @wait:  jsr     menu_key
0007ADr 1  C9 51                cmp     #'Q'
0007AFr 1  D0 03                bne     @nq
0007B1r 1  4C rr rr             jmp     title
0007B4r 1               @nq:
0007B4r 1               .if SOUND
0007B4r 1  C9 4D                cmp     #'M'
0007B6r 1  D0 06                bne     @nm
0007B8r 1  20 rr rr             jsr     toggle_sound
0007BBr 1  4C rr rr             jmp     @wait
0007BEr 1               @nm:
0007BEr 1               .endif
0007BEr 1  C9 20                cmp     #' '
0007C0r 1  F0 04                beq     @again
