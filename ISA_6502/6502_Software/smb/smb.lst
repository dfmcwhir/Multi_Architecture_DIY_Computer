000000r 1               ; ============================================================================
000000r 1               ; smb.s - SUPER MOS BROS., a side-scrolling platform game for the 6502 SBC
000000r 1               ;
000000r 1               ; Runs from the monitor at $0500 and draws on the PIC32 terminal in its
000000r 1               ; control code mode (setup item J), terminal firmware v1.4 or later.
000000r 1               ;
000000r 1               ;   build:  make.bat  (or make)     needs ../sbc_api.inc (CLOCK_MHZ)
000000r 1               ;   run:    L SMB 0500   then   R
000000r 1               ;
000000r 1               ; Header (patchable from the monitor):
000000r 1               ;   $0500  JMP start
000000r 1               ;   $0503  frame time in ms (default 50; real ms at any clock)
000000r 1               ;   $0504  controls at start: 0 keyboard, 1 gamepad (default)
000000r 1               ;   $0505  0: the terminal scrolls the view (code 16 in a scroll region,
000000r 1               ;          firmware 1.4 with sideways scrolling); 1: redraw it instead
000000r 1               ;   $0506  sound at start: 0 on, 1 off (M switches)
000000r 1               ;
000000r 1               ; Sound (SMB.BIN; SMBSW.BIN has no room for it): music and effects on the
000000r 1               ; AY-3-8910 card at $7F22/$7F23, through ../ay/sfx.s, timed by the VIA's
000000r 1               ; timer 2.  The tunes and effects are in sound.py (-> smb_sound.inc).
000000r 1               ; Without the card the game is just silent.
000000r 1               ;
000000r 1               ; Keys:    D / A or Right / Left   walk that way (press again: run)
000000r 1               ;          S or Down  stop    W, Space or Up  jump    P pause   Q quit
000000r 1               ;          M  sound on / off
000000r 1               ; Gamepad: left / right walk, B (held) run, A jump (hold it to jump higher),
000000r 1               ;          Start pause
000000r 1               ;
000000r 1               ; The world is a map of 8 x 8 pixel tiles, 11 high, up to 255 wide.  A tile
000000r 1               ; is 4 x 2 block graphics characters.  The view is text rows 2-23 (80 x 22
000000r 1               ; characters, 160 x 88 pixels); row 0 is the status line.
000000r 1               ;
000000r 1               ; The view is kept in RAM (wc: a page a text row, indexed by the world
000000r 1               ; column & 255, so scrolling only fills in the columns coming into view),
000000r 1               ; and so is what the terminal shows (sh, indexed the same way).  They are
000000r 1               ; compared and only the characters that differ are sent, runs of the same
000000r 1               ; character with the terminal's repeat count.  The view scrolls a character
000000r 1               ; at a time: the terminal moves it (code 16, in the scroll region of text
000000r 1               ; rows 3-24), so only the new column on the right, the cells under the
000000r 1               ; sprites (this frame and the last) and tiles that changed are compared.
000000r 1               ; Sprites are stored for both pixel positions across a cell and shifted
000000r 1               ; down and mirrored as they are drawn, with a mask (gen.py).
000000r 1               ;
000000r 1               ; Positions are 16.8 fixed point pixels (x) and signed 8.8 (y), speeds 8.8.
000000r 1               ; No zero page is used.
000000r 1               ; ============================================================================
000000r 1               
000000r 1                       .setcpu "6502"
000000r 1                       .include "sbc_api.inc"
000000r 2               ; sbc_api.inc - fixed ROM entry points of the SBC (see jumptable.s), and the
000000r 2               ; CPU clock.  Use in your own ca65 programs:  .include "sbc_api.inc"
000000r 2               ; (the games find it one folder up: their make.bat passes  -I ..  to ca65)
000000r 2               SBC_CHRIN       = $FE00         ; carry set + A = char, carry clear = none waiting
000000r 2               SBC_CHROUT      = $FE03         ; print A (A, X, Y preserved)
000000r 2               SBC_MENU        = $FE06         ; boot menu
000000r 2               SBC_COLD        = $FE09         ; BASIC cold start
000000r 2               SBC_WARM        = $FE0C         ; BASIC warm start
000000r 2               SBC_MONITOR     = $FE0F         ; monitor prompt (or JMP $FF00)
000000r 2               SBC_PADSTATE    = $FE12         ; A = gamepad buttons held: bit0 A,1 B,2 Select,3 Start,4 Up,5 Down,6 Left,7 Right
000000r 2               SBC_LOAD        = $FE15         ; load a file: A/Y = parameter block (.word addr, .word max, "NAME.EXT",0)
000000r 2                                               ;   carry clear = loaded, X/Y = length; carry set = failed, A = error code
000000r 2               SBC_CWD         = $FE18         ; A/Y = the monitor's current folder: 0-ended, "" (the top) or "/A/B"
000000r 2                                               ;   (newer ROMs: check for a JMP ($4C) at $FE18 first)
000000r 2               
000000r 2               ; The CPU clock in MHz (whole numbers, 1 to 8).  Programs size their delay
000000r 2               ; loops from it, so a millisecond stays a millisecond.  To build for another
000000r 2               ; clock, change it here or give it on the command line:  make.bat 1
000000r 2               .ifndef CLOCK_MHZ
000000r 2               CLOCK_MHZ       = 2
000000r 2               .endif
000000r 2               
000000r 1               
000000r 1               SPEED_DEFAULT   = 50            ; ms per frame
000000r 1               
000000r 1               ; ---- terminal --------------------------------------------------------------------
000000r 1               TC_CURSOR       = $02
000000r 1               TC_CLS          = $0C
000000r 1               TC_COL          = $0E
000000r 1               TC_ROW          = $0F
000000r 1               TC_ATTR         = $18
000000r 1               TC_LIT          = $1A
000000r 1               TC_SCROLL       = $16           ; scroll left (a character; the scroll region)
000000r 1               TC_TILE         = $0B           ; n: draw terminal tile n (19 SET TILE: SMBSPR.SMB)
000000r 1               ATTR_TEXT       = $00
000000r 1               ATTR_GFX        = $80
000000r 1               TERM            = $FF
000000r 1               .define RV_ON   $1B, '[', '7', 'm'
000000r 1               .define RV_OFF  $1B, '[', '2', '7', 'm'
000000r 1               
000000r 1               ; ---- the view ----------------------------------------------------------------------
000000r 1               COLS            = 80
000000r 1               PROWS           = 22            ; text rows of the view
000000r 1               PF_ROW          = 2             ; ... starting on this text row
000000r 1               MAPROWS         = 11
000000r 1               VIEW_H          = 88            ; pixels
000000r 1               
000000r 1               ; ---- objects -----------------------------------------------------------------------
000000r 1               NOBJ            = 10
000000r 1               O_MOS           = 0
000000r 1               O_FIRST         = 1             ; 1-6: enemies, shells, mushrooms, the dragon, its fire
000000r 1               O_LAST          = 6
000000r 1               O_COIN          = 7             ; a coin popping out of a block
000000r 1               O_FIRE          = 8             ; 8-9: MOS's electrons
000000r 1               K_NONE          = 0
000000r 1               K_MOS           = 1
000000r 1               K_BUG           = 2             ; an AND gate
000000r 1               K_FLAT          = 3             ; a squashed one (for a moment)
000000r 1               K_SHELLY        = 4             ; an OR gate
000000r 1               K_SHELL         = 5             ; ... pulled in
000000r 1               K_MUSH          = 6
000000r 1               K_COIN          = 7
000000r 1               K_ONEUP         = 8             ; the mushroom from a hidden block
000000r 1               K_FLOWER        = 9
000000r 1               K_FIRE          = 10            ; an electron
000000r 1               K_DRAGON        = 11            ; KIL
000000r 1               K_BREATH        = 12            ; its fire
000000r 1               K_OC            = 13            ; the overclock device
000000r 1               K_FISH          = 14            ; a gate swimming on its side (liquid cooling)
000000r 1               K_FAN           = 15            ; a flying fan
000000r 1               K_CLOUD         = 16            ; the cloud: it throws gates down
000000r 1               K_PRINCESS      = 17            ; Princess Graphics Card
000000r 1               REVIVE          = 160           ; frames before a still shell walks again
000000r 1               FAN_TOP         = 12            ; how high the high fans fly
000000r 1               FISH_V          = $0100         ; how fast the fish swim
000000r 1               
000000r 1               ; MOS's states
000000r 1               MS_PLAY         = 0
000000r 1               MS_FLAG         = 1             ; sliding down the pole
000000r 1               MS_WALK         = 2             ; walking to the castle
000000r 1               MS_IN           = 3             ; in the castle: time bonus
000000r 1               MS_DEAD         = 4
000000r 1               MS_RESET        = 5             ; pressed RESET: the bridge falls
000000r 1               MS_PIPE         = 6             ; going down a pipe
000000r 1               MS_RESCUE       = 7             ; found the princess
000000r 1               
000000r 1               ; ---- physics (8.8 pixels per frame) -------------------------------------------------
000000r 1               WALK_MAX        = $01C0
000000r 1               RUN_MAX         = $0300
000000r 1               ACCEL           = $0020
000000r 1               DECEL           = $0020
000000r 1               SKID            = $0048
000000r 1               JUMP_V          = $0600         ; + speed / 8
000000r 1               GRAV_HOLD       = $0080         ; rising with jump held
000000r 1               GRAV            = $0180
000000r 1               MAX_FALL        = $0600
000000r 1               STOMP_V         = $0480
000000r 1               BUG_V           = $00A0
000000r 1               SHELL_V         = $0300
000000r 1               MUSH_V          = $00C0
000000r 1               OBJ_GRAV        = $0100
000000r 1               INVULN          = 60            ; frames after shrinking
000000r 1               FIRE_V          = $0380         ; electrons: across
000000r 1               FIRE_BOUNCE     = $0280         ; ... up, when they bounce
000000r 1               FIRE_GRAV       = $0060
000000r 1               DRAGON_HP       = 5
000000r 1               OC_TIME         = 200           ; frames of overclock (10 s)
000000r 1               SWIM_V          = $0180         ; under the coolant: a stroke
000000r 1               GRAV_W          = $0018
000000r 1               MAX_FALL_W      = $0100
000000r 1               WATER_MAX       = $0100         ; ... and the most speed across
000000r 1               TIME_TICK       = 9             ; frames per unit of the timer (about 0.4 s)
000000r 1               
000000r 1               ; SOFT_SPRITES = 1 builds SMBSW.BIN: the 6502 draws the sprites itself, for a
000000r 1               ; terminal without the sprite layer.  The default (0) builds SMB.BIN: the
000000r 1               ; pictures are sent to the terminal from SMBSPR.SMB at start and the terminal
000000r 1               ; draws them (control code 1C), which frees about 3.6 KB here.
000000r 1               .ifndef SOFT_SPRITES
000000r 1               SOFT_SPRITES    = 0
000000r 1               .endif
000000r 1               ; SOUND = 0 builds without the sound (SMBSW.BIN has no room for it)
000000r 1               .ifndef SOUND
000000r 1               SOUND           = !SOFT_SPRITES
000000r 1               .endif
000000r 1               ; UNC_TILE = 1 (ca65 -D): hide the terminal's sprites over a tile before it changes
000000r 1               ; (for terminal firmware that left old pixels under a sprite; each HIDE
000000r 1               ; outside HOLD waits for the vertical blank on the newer firmware, so 0)
000000r 1               .ifndef UNC_TILE
000000r 1               UNC_TILE        = 0
000000r 1               .endif
000000r 1               UNC_TILES       = UNC_TILE .and (.not SOFT_SPRITES)
000000r 1               TC_SPR          = $1C           ; the terminal's sprite layer: 1C command args
000000r 1               SPR_PLACE       = 2
000000r 1               SPR_MOVE        = 3
000000r 1               SPR_PIC         = 4
000000r 1               SPR_FLAGS       = 5
000000r 1               SPR_HIDE        = 6
000000r 1               SPR_HIDEALL     = 7
000000r 1               SPR_HOLD        = 9
000000r 1               SPR_SHOW        = 10
000000r 1               SPR_CLIP        = 11
000000r 1               SPR_IDENT       = 12
000000r 1               SPR_STATUS      = 13            ; (newer firmware: lost bytes, buffer peak)
000000r 1               
