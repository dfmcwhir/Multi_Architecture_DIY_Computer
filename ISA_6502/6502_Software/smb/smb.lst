0000E0r 2  D0 08                bne     @r
0000E2r 2  A9 01                lda     #SFX_RUNS
0000E4r 2  8D 6C 01             sta     sfx_runs
0000E7r 2  20 rr rr             jsr     sfx_tick
0000EAr 2  68           @r:     pla
0000EBr 2  A8                   tay
0000ECr 2  68                   pla
0000EDr 2  AA                   tax
0000EEr 2  68                   pla
