00075Ar 1  A9 00                lda     #0
00075Cr 1  8D rr rr             sta     lvl
00075Fr 1  EE rr rr             inc     world
000762r 1  EE rr rr             inc     wsrc
000765r 1  4C rr rr     @n:     jmp     start_level
000768r 1               
000768r 1               game_over:
