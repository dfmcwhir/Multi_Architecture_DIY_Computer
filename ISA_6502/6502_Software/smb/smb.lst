000359r 1  A9 01        @rep:   lda     #1
00035Br 1  8D rr rr             sta     rp_got
00035Er 1  4C rr rr             jmp     getc
000361r 1  38           @k2:    sec
000362r 1  60                   rts
000363r 1  68           @key:   pla
000364r 1  38                   sec
000365r 1  60           @r:     rts
000366r 1               .endif
