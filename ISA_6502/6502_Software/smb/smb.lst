00086Cr 1               
00086Cr 1               ; ---- the levels -------------------------------------------------------------------
00086Cr 1               ; every world is a file, WORLDn.SMB (n: wsrc), loaded with SBC_LOAD into wc
00086Cr 1               ; (free until the level starts) each time one of its levels starts.
00086Cr 1               ; Carry set if it can't be had (no SBC_LOAD in the ROM, no file, not a world,
00086Cr 1               ; no level lvl in it).
00086Cr 1               get_world:
00086Cr 1  AD rr rr             lda     wsrc
00086Fr 1  C9 0A                cmp     #10
000871r 1  B0 36                bcs     @fail
000873r 1  AD 15 FE             lda     SBC_LOAD        ; a JMP there: the ROM has SBC_LOAD
000876r 1  C9 4C                cmp     #$4C
000878r 1  D0 2F                bne     @fail
00087Ar 1  AD rr rr             lda     wsrc
00087Dr 1  09 30                ora     #'0'
00087Fr 1  8D rr rr             sta     load_name+5
000882r 1  A9 rr                lda     #<load_blk
000884r 1  A0 rr                ldy     #>load_blk
000886r 1  20 15 FE             jsr     SBC_LOAD
000889r 1  B0 1E                bcs     @fail
00088Br 1  AD rr rr             lda     wc              ; "SM", version 2
00088Er 1  C9 53                cmp     #'S'
000890r 1  D0 17                bne     @fail
000892r 1  AD rr rr             lda     wc+1
000895r 1  C9 4D                cmp     #'M'
000897r 1  D0 10                bne     @fail
000899r 1  AD rr rr             lda     wc+2
00089Cr 1  C9 02                cmp     #2
00089Er 1  D0 09                bne     @fail
0008A0r 1  AD rr rr             lda     lvl             ; (levels in it: wc+3)
0008A3r 1  CD rr rr             cmp     wc+3
0008A6r 1  B0 01                bcs     @fail
0008A8r 1  60                   rts
0008A9r 1  38           @fail:  sec
0008AAr 1  60                   rts
0008ABr 1               
0008ABr 1               ; ---- load the level (in wc): the map, MOS, the timer, no objects ---------------------
0008ABr 1               load_level:
0008ABr 1  A2 00                ldx     #0              ; an empty map
0008ADr 1  8A                   txa
0008AEr 1  9D rr rr 9D  @clr:   .repeat MAPROWS, K
0008B2r 1  rr rr 9D rr  
0008B6r 1  rr 9D rr rr  
0008CFr 1                       sta     map + K * 256,x
0008CFr 1                       .endrepeat
0008CFr 1  E8                   inx
0008D0r 1  D0 DC                bne     @clr
0008D2r 1  AD rr rr             lda     lvl             ; the level: at wc + its offset (wc+4 + lvl * 2)
0008D5r 1  0A                   asl
0008D6r 1  A8                   tay
0008D7r 1  18                   clc
0008D8r 1  B9 rr rr             lda     wc+4,y
0008DBr 1  69 rr                adc     #<wc
0008DDr 1  8D rr rr             sta     @rd+1
0008E0r 1  B9 rr rr             lda     wc+5,y
0008E3r 1  69 rr                adc     #>wc
0008E5r 1  8D rr rr             sta     @rd+2
0008E8r 1  A2 00                ldx     #0              ; width, start, time, flags, room, exit pipe
0008EAr 1  20 rr rr     @in:    jsr     @get
0008EDr 1  9D rr rr             sta     lv_w,x
0008F0r 1  E8                   inx
0008F1r 1  E0 08                cpx     #8
0008F3r 1  D0 F5                bne     @in
0008F5r 1  A9 00                lda     #0
0008F7r 1  8D rr rr             sta     tmp3            ; the rows, unpacked: (count, tile) ... 0
0008FAr 1  AD rr rr     @row:   lda     tmp3
0008FDr 1  18                   clc
0008FEr 1  69 rr                adc     #>map
000900r 1  8D rr rr             sta     @wr+2
000903r 1  A2 00                ldx     #0              ; map column
000905r 1  20 rr rr     @run:   jsr     @get
000908r 1  F0 0D                beq     @nrow
00090Ar 1  A8                   tay                     ; count
00090Br 1  20 rr rr             jsr     @get            ; tile
00090Er 1  9D rr rr     @wr:    sta     map,x
000911r 1  E8                   inx
000912r 1  88                   dey
000913r 1  D0 F9                bne     @wr
000915r 1  F0 EE                beq     @run
000917r 1  EE rr rr     @nrow:  inc     tmp3
00091Ar 1  AD rr rr             lda     tmp3
00091Dr 1  C9 0B                cmp     #MAPROWS
00091Fr 1  D0 D9                bne     @row
000921r 1  A2 00                ldx     #0              ; then the enemies: copied out (a world from
000923r 1  20 rr rr     @en:    jsr     @get            ; the disk is in wc, which the view will use)
000926r 1  9D rr rr             sta     en_buf,x
000929r 1  C9 FF                cmp     #$FF
00092Br 1  F0 09                beq     @ene
00092Dr 1  E8                   inx
00092Er 1  D0 F3                bne     @en
000930r 1  CA                   dex
000931r 1  A9 FF                lda     #$FF
000933r 1  9D rr rr             sta     en_buf,x
000936r 1  A9 00        @ene:   lda     #0
000938r 1  8D rr rr             sta     en_i
00093Br 1                       ; the furthest the view goes: width * 4 - 80 characters
00093Br 1  A9 00                lda     #0
00093Dr 1  8D rr rr             sta     max_sc+1
000940r 1  AD rr rr             lda     lv_w
000943r 1  0A                   asl
000944r 1  2E rr rr             rol     max_sc+1
000947r 1  0A                   asl
000948r 1  2E rr rr             rol     max_sc+1
00094Br 1  38                   sec
00094Cr 1  E9 50                sbc     #COLS
00094Er 1  8D rr rr             sta     max_sc
000951r 1  AD rr rr             lda     max_sc+1
000954r 1  E9 00                sbc     #0
000956r 1  8D rr rr             sta     max_sc+1
000959r 1  A9 00                lda     #0
00095Br 1  8D rr rr             sta     scroll
00095Er 1  8D rr rr             sta     scroll+1
000961r 1  8D rr rr             sta     sc2
000964r 1  8D rr rr             sta     sc2+1
000967r 1  8D rr rr             sta     time_div
00096Ar 1  8D rr rr             sta     inv_t
00096Dr 1  8D rr rr             sta     mstate
000970r 1  8D rr rr             sta     mtimer
000973r 1  8D rr rr             sta     facing
000976r 1  8D rr rr             sta     kdir
000979r 1  8D rr rr             sta     krun
00097Cr 1  8D rr rr             sta     khold
00097Fr 1  8D rr rr             sta     jump_buf
000982r 1  8D rr rr             sta     fire_req
000985r 1  8D rr rr             sta     quit
000988r 1  8D rr rr             sta     dr_flash
00098Br 1  8D rr rr             sta     in_room
00098Er 1  8D rr rr             sta     oc_t
000991r 1  8D rr rr             sta     sw_t
000994r 1  8D rr rr             sta     duck
000997r 1  8D rr rr             sta     br_w
00099Ar 1  A2 09                ldx     #NOBJ-1
00099Cr 1  9D rr rr     @o:     sta     o_kind,x
00099Fr 1  CA                   dex
0009A0r 1  10 FA                bpl     @o
0009A2r 1  20 rr rr             jsr     clear_obj0
0009A5r 1  A9 01                lda     #K_MOS
0009A7r 1  8D rr rr             sta     o_kind
0009AAr 1  AD rr rr             lda     lv_sx           ; start: tile x * 8, tile y * 8 (bottom row of MOS)
0009ADr 1  8D rr rr             sta     o_xl
0009B0r 1  A9 00                lda     #0
0009B2r 1  0E rr rr             asl     o_xl
0009B5r 1  2A                   rol
0009B6r 1  0E rr rr             asl     o_xl
0009B9r 1  2A                   rol
0009BAr 1  0E rr rr             asl     o_xl
0009BDr 1  2A                   rol
0009BEr 1  8D rr rr             sta     o_xh
0009C1r 1  AD rr rr             lda     lv_sy
0009C4r 1  0A                   asl
0009C5r 1  0A                   asl
0009C6r 1  0A                   asl
0009C7r 1  AE rr rr             ldx     big
0009CAr 1  F0 03                beq     @sm
0009CCr 1  38                   sec
0009CDr 1  E9 08                sbc     #8
0009CFr 1  8D rr rr     @sm:    sta     o_y
0009D2r 1  AD rr rr             lda     lv_time
0009D5r 1  8D rr rr             sta     time
0009D8r 1  AD rr rr             lda     lv_time+1
0009DBr 1  8D rr rr             sta     time+1
0009DEr 1  A9 01                lda     #1
0009E0r 1  8D rr rr             sta     onground
0009E3r 1  60                   rts
0009E4r 1               @get:
0009E4r 1  AD FF FF     @rd:    lda     $FFFF
0009E7r 1  EE rr rr             inc     @rd+1
0009EAr 1  D0 03                bne     @g
0009ECr 1  EE rr rr             inc     @rd+2
0009EFr 1  C9 00        @g:     cmp     #0
0009F1r 1  60                   rts
0009F2r 1               
0009F2r 1               ; clear object X's position and speed (keeps its kind)
0009F2r 1               clear_obj0:
0009F2r 1  A2 00                ldx     #0
0009F4r 1               clear_obj:
0009F4r 1  A9 00                lda     #0
0009F6r 1  9D rr rr             sta     o_xf,x
0009F9r 1  9D rr rr             sta     o_xl,x
0009FCr 1  9D rr rr             sta     o_xh,x
0009FFr 1  9D rr rr             sta     o_yf,x
000A02r 1  9D rr rr             sta     o_y,x
000A05r 1  9D rr rr             sta     o_vxl,x
000A08r 1  9D rr rr             sta     o_vxh,x
000A0Br 1  9D rr rr             sta     o_vyl,x
000A0Er 1  9D rr rr             sta     o_vyh,x
000A11r 1  9D rr rr             sta     o_t,x
000A14r 1  9D rr rr             sta     o_r,x
000A17r 1  60                   rts
000A18r 1               
000A18r 1               ; wait out the rest of the frame: about (speed - what the frame took) ms.
000A18r 1               ; The frame took roughly: the bytes sent at 115200 baud (87 us each) plus
000A18r 1               ; the 6502's work / CLOCK_MHZ.  The work, measured in the emulator
000A18r 1               ; (test/fit.py), in ms at 1 MHz: about 6 + 0.093 a byte sent + 0.03 a
000A18r 1               ; character compared + 0.48 a sprite cell + 5 if the view scrolled (16 when
000A18r 1               ; it is redrawn instead of scrolled by the terminal).
000A18r 1  AD rr rr     pace:   lda     nbytes          ; tmp = bytes / 8 (at most 255)
000A1Br 1  8D rr rr             sta     tmp
000A1Er 1  AD rr rr             lda     nbytes+1
000A21r 1  8D rr rr             sta     tmp+1
000A24r 1  A2 03                ldx     #3
000A26r 1  4E rr rr     @s:     lsr     tmp+1
000A29r 1  6E rr rr             ror     tmp
000A2Cr 1  CA                   dex
000A2Dr 1  D0 F7                bne     @s
000A2Fr 1  AD rr rr             lda     tmp+1
000A32r 1  D0 78                bne     @none
000A34r 1  AD rr rr             lda     tmp             ; bytes / 8 * 0.75
000A37r 1  4A                   lsr
000A38r 1  8D rr rr             sta     used
000A3Br 1  4A                   lsr
000A3Cr 1  18                   clc
000A3Dr 1  6D rr rr             adc     used
000A40r 1  8D rr rr             sta     used
000A43r 1  AD rr rr             lda     ncmp+1          ; + compared / 32 (/ 16 for SMB.BIN)
000A46r 1  8D rr rr             sta     tmp2
000A49r 1  AD rr rr             lda     ncmp
000A4Cr 1  A2 04                ldx     #PACE_CMP
000A4Er 1  4E rr rr     @c:     lsr     tmp2
000A51r 1  6A                   ror
000A52r 1  CA                   dex
000A53r 1  D0 F9                bne     @c
000A55r 1  AE rr rr             ldx     tmp2
000A58r 1  D0 52                bne     @none
000A5Ar 1  18                   clc
000A5Br 1  6D rr rr             adc     used
000A5Er 1  B0 4C                bcs     @none
000A60r 1  8D rr rr             sta     used
000A63r 1  AD rr rr             lda     ncells          ; + cells * 0.5
000A66r 1  4A                   lsr
000A67r 1  18                   clc
000A68r 1  6D rr rr             adc     used
000A6Br 1  B0 3F                bcs     @none
000A6Dr 1  AE rr rr             ldx     scrolled        ; + a scroll: 5 (16 redrawing), + 6
000A70r 1  F0 0D                beq     @b
000A72r 1  AE rr rr             ldx     noscroll
000A75r 1  F0 04                beq     @hw
000A77r 1  69 0B                adc     #11
000A79r 1  B0 31                bcs     @none
000A7Br 1  69 0A        @hw:    adc     #PACE_SCROLL
000A7Dr 1  B0 2D                bcs     @none
000A7Fr 1  69 04        @b:     adc     #PACE_BASE
000A81r 1  B0 29                bcs     @none
000A83r 1               .if CLOCK_MHZ > 1
000A83r 1  A2 02                ldx     #CLOCK_MHZ
000A85r 1  20 rr rr             jsr     div_ax          ; / the clock
000A88r 1               .endif
000A88r 1  8D rr rr             sta     used
000A8Br 1  AD rr rr             lda     tmp             ; serial: bytes * 87 us = bytes / 8 * 0.7
000A8Er 1  4A                   lsr                     ;   ~ bytes / 8 * (1/2 + 1/4)
000A8Fr 1  8D rr rr             sta     tmp2
000A92r 1  4A                   lsr
000A93r 1  6D rr rr             adc     tmp2
000A96r 1  6D rr rr             adc     used
000A99r 1  B0 11                bcs     @none
000A9Br 1  8D rr rr             sta     used
000A9Er 1  AD rr rr             lda     speed           ; the rest of the frame time
000AA1r 1  38                   sec
000AA2r 1  ED rr rr             sbc     used
000AA5r 1  90 05                bcc     @none
000AA7r 1  F0 03                beq     @none
000AA9r 1  4C rr rr             jmp     delay_ms
000AACr 1  60           @none:  rts
000AADr 1               
000AADr 1               ; the timing model's figures (test/fit.py), at 1 MHz
000AADr 1               .if SOFT_SPRITES
000AADr 1               PACE_CMP        = 5             ; compared characters: / 32
000AADr 1               PACE_SCROLL     = 5             ; a scroll: ms
000AADr 1               PACE_BASE       = 6             ; ms
000AADr 1               .else
000AADr 1               PACE_CMP        = 4             ; (the terminal draws the sprites: less to do
000AADr 1               PACE_SCROLL     = 10            ;  each frame, but more per character compared)
000AADr 1               PACE_BASE       = 4
000AADr 1               .endif
000AADr 1               
000AADr 1               ; A = A / X (unsigned)
000AADr 1  8E rr rr     div_ax: stx     tmp4
000AB0r 1  A2 00                ldx     #0
000AB2r 1  CD rr rr     @l:     cmp     tmp4
000AB5r 1  90 06                bcc     @d
000AB7r 1  ED rr rr             sbc     tmp4
000ABAr 1  E8                   inx
000ABBr 1  D0 F5                bne     @l
000ABDr 1  8A           @d:     txa
000ABEr 1  60                   rts
000ABFr 1               
000ABFr 1               ; ============================================================================
000ABFr 1               ; input
000ABFr 1               ; ============================================================================
000ABFr 1               ; in_dir: -1 / 0 / 1, in_run, hold (jump held), jump_buf (frames a jump
000ABFr 1               ; press waits for MOS to be on the ground)
000ABFr 1               read_input:
000ABFr 1  AD rr rr             lda     ctrl
000AC2r 1  F0 54                beq     @keys
000AC4r 1  20 rr rr             jsr     read_pad
000AC7r 1  A9 00                lda     #0
000AC9r 1  8D rr rr             sta     in_dir
