000852r 1               spr_forget:
000852r 1  A9 01                lda     #1              ; (nothing to wait for before the first frame)
000854r 1  8D rr rr             sta     rp_got
000857r 1  A2 05                ldx     #HEAL_N-1
000859r 1  A9 00                lda     #0
00085Br 1  9D rr rr     @hl:    sta     hl_t,x
00085Er 1  CA                   dex
