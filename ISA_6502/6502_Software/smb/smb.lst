002B0Er 1  C9 50                cmp     #COLS
002B10r 1  90 02                bcc     @c1
002B12r 1  A9 4F                lda     #COLS-1
002B14r 1  8D rr rr     @c1:    sta     s_c1
002B17r 1  AD rr rr             lda     s_col
002B1Ar 1  10 02                bpl     @c0
002B1Cr 1  A9 00                lda     #0
002B1Er 1  C9 50        @c0:    cmp     #COLS
002B20r 1  B0 05                bcs     @none
002B22r 1  8D rr rr             sta     s_c0
002B25r 1  18                   clc
002B26r 1  60                   rts
002B27r 1  38           @none:  sec
002B28r 1  60                   rts
002B29r 1               
002B29r 1               .if SOFT_SPRITES
002B29r 1               ; put the map back where last frame's sprites were (the part still in view)
002B29r 1               restore_rects:
002B29r 1                       ldx     #0
002B29r 1               @l:     cpx     nrect
002B29r 1                       bne     @go
002B29r 1                       rts
002B29r 1               @go:    stx     ri
002B29r 1                       sec                     ; screen column = world column - scroll
002B29r 1                       lda     rc_cl,x
002B29r 1                       sbc     scroll
002B29r 1                       sta     s_col
002B29r 1                       lda     rc_ch,x
002B29r 1                       sbc     scroll+1
002B29r 1                       beq     @p
002B29r 1                       cmp     #$FF
002B29r 1                       bne     @n
002B29r 1                       lda     s_col
002B29r 1                       bmi     @v
002B29r 1                       bpl     @n
002B29r 1               @p:     lda     s_col
002B29r 1                       bmi     @n
002B29r 1               @v:     lda     rc_w,x
002B29r 1                       sta     s_w
002B29r 1                       jsr     clip_cols
002B29r 1                       bcs     @n
002B29r 1                       ldx     ri
002B29r 1                       lda     rc_r,x
002B29r 1                       sta     s_r
002B29r 1                       lda     rc_h,x
002B29r 1                       sta     s_hn
002B29r 1               @row:   lda     s_r
002B29r 1                       cmp     #PROWS
002B29r 1                       bcs     @nr
002B29r 1                       jsr     bg_span
002B29r 1                       ldy     s_r
002B29r 1                       lda     s_c0
002B29r 1                       jsr     mark1
002B29r 1                       lda     s_c1
002B29r 1                       jsr     mark1
002B29r 1               @nr:    inc     s_r
002B29r 1                       dec     s_hn
002B29r 1                       bne     @row
002B29r 1               @n:     ldx     ri
002B29r 1                       inx
002B29r 1                       bne     @l
002B29r 1               
002B29r 1               ; ---- sprites -----------------------------------------------------------------
002B29r 1               draw_objs:
002B29r 1                       lda     #0
002B29r 1                       sta     nrect
002B29r 1                       ldx     #O_FIRST
002B29r 1               @l:     stx     dobj
002B29r 1                       lda     o_kind,x
002B29r 1                       beq     @n
002B29r 1                       jsr     obj_frame
002B29r 1                       bcs     @n
002B29r 1                       jsr     draw_obj
002B29r 1               @n:     ldx     dobj
002B29r 1                       inx
002B29r 1                       cpx     #NOBJ
002B29r 1                       bne     @l
002B29r 1                       ldx     #O_MOS          ; MOS last, on top
002B29r 1                       lda     o_kind
002B29r 1                       beq     @r
002B29r 1                       jsr     mos_frame
002B29r 1                       bcs     @r
002B29r 1                       jsr     draw_obj
002B29r 1               @r:     rts
002B29r 1               
002B29r 1               ; object X with picture A, mirrored if smir.  The pictures are stored for
002B29r 1               ; x & 1 with their top on a cell row; they are shifted down 0-3 pixel rows
002B29r 1               ; (2 bits a row) and mirrored here, cell by cell, column by column.
002B29r 1               draw_obj:
002B29r 1                       sta     spf
002B29r 1                       sec                     ; on the screen: x - scroll * 2
002B29r 1                       lda     o_xl,x
002B29r 1                       sbc     sc2
002B29r 1                       sta     sxl
002B29r 1                       lda     o_xh,x
002B29r 1                       sbc     sc2+1
002B29r 1                       sta     sxh
002B29r 1                       lda     o_xh,x          ; in the world: column x / 2
002B29r 1                       lsr
002B29r 1                       sta     swh
002B29r 1                       lda     o_xl,x
002B29r 1                       ror
002B29r 1                       sta     swl
002B29r 1                       lda     o_y,x
002B29r 1                       sta     sy
002B29r 1                       lda     sxh             ; on the screen?  x -32..159, y -16..87
002B29r 1                       beq     @x0
002B29r 1                       cmp     #$FF
002B29r 1                       bne     @no
002B29r 1                       lda     sxl
002B29r 1                       cmp     #$E0
002B29r 1                       bcc     @no
002B29r 1                       bcs     @y
002B29r 1               @x0:    lda     sxl
002B29r 1                       cmp     #160
002B29r 1                       bcs     @no
002B29r 1               @y:     lda     sy
002B29r 1                       bpl     @y0
002B29r 1                       cmp     #$F0
002B29r 1                       bcc     @no
002B29r 1                       bcs     @go
002B29r 1               @y0:    cmp     #VIEW_H
002B29r 1                       bcc     @go
002B29r 1               @no:    rts
002B29r 1               @go:    lda     spf             ; the picture for x & 1
002B29r 1                       asl
002B29r 1                       sta     tmp
002B29r 1                       lda     sxl
002B29r 1                       and     #1
002B29r 1                       ora     tmp
002B29r 1                       tay
002B29r 1                       lda     spr_lo,y
002B29r 1                       sta     @d0+1
002B29r 1                       sta     @d1+1
002B29r 1                       sta     @dm+1
002B29r 1                       sta     @db+1
002B29r 1                       lda     spr_hi,y
002B29r 1                       sta     @d0+2
002B29r 1                       sta     @d1+2
002B29r 1                       sta     @dm+2
002B29r 1                       sta     @db+2
002B29r 1                       lda     sxh             ; screen column = x / 2, row = y / 4 (signed)
002B29r 1                       cmp     #$80
002B29r 1                       lda     sxl
002B29r 1                       ror
002B29r 1                       sta     s_col
002B29r 1                       lda     sy
002B29r 1                       and     #3              ; shifted down 0-3 pixel rows: 0-6 bits
002B29r 1                       asl
002B29r 1                       sta     s_sh
002B29r 1                       lda     sy
002B29r 1                       cmp     #$80
002B29r 1                       ror
002B29r 1                       cmp     #$80
002B29r 1                       ror
002B29r 1                       sta     s_r
002B29r 1                       ldy     #0
002B29r 1               @d0:    lda     $FFFF,y
002B29r 1                       sta     s_w
002B29r 1                       iny
002B29r 1               @d1:    lda     $FFFF,y
002B29r 1                       sta     s_h0
002B29r 1                       ldx     s_sh            ; (one more row when shifted)
002B29r 1                       beq     @h
002B29r 1                       clc
002B29r 1                       adc     #1
002B29r 1               @h:     sta     s_hn
002B29r 1                       ldx     nrect           ; remember where, to clear it next frame
002B29r 1                       lda     swl
002B29r 1                       sta     rc_cl,x
002B29r 1                       lda     swh
002B29r 1                       sta     rc_ch,x
002B29r 1                       lda     s_r
002B29r 1                       sta     rc_r,x
002B29r 1                       lda     s_w
002B29r 1                       sta     rc_w,x
002B29r 1                       lda     s_hn
002B29r 1                       sta     rc_h,x
002B29r 1                       inc     nrect
002B29r 1                       jsr     clip_cols
002B29r 1                       bcc     *+5
002B29r 1                       jmp     @no
002B29r 1                       lda     #2              ; the cells, column by column
002B29r 1                       sta     s_di
002B29r 1                       lda     #0
002B29r 1                       sta     s_cc
002B29r 1               @col:   lda     s_cc            ; which column of the sprite on the screen
002B29r 1                       ldx     smir
002B29r 1                       beq     @nm
002B29r 1                       lda     s_w
002B29r 1                       clc
002B29r 1                       sbc     s_cc            ; (w - 1 - cc)
002B29r 1               @nm:    sta     tmp
002B29r 1                       clc
002B29r 1                       adc     s_col
002B29r 1                       cmp     #COLS
002B29r 1                       bcc     @on
002B29r 1                       lda     s_h0            ; off the screen: skip its cells
002B29r 1                       asl
002B29r 1                       adc     s_di
002B29r 1                       sta     s_di
002B29r 1                       jmp     @ncol
002B29r 1               @on:    lda     tmp
002B29r 1                       clc
002B29r 1                       adc     swl
002B29r 1                       sta     s_wx
002B29r 1                       lda     #0
002B29r 1                       sta     s_pm
002B29r 1                       sta     s_pb
002B29r 1                       sta     s_rr
002B29r 1               @cell:  lda     s_rr
002B29r 1                       cmp     s_h0
002B29r 1                       bcs     @zero
002B29r 1                       ldy     s_di
002B29r 1               @dm:    lda     $FFFF,y
002B29r 1                       ldx     smir
002B29r 1                       beq     @m1
002B29r 1                       tax
002B29r 1                       lda     mirror,x
002B29r 1               @m1:    sta     s_cm
002B29r 1                       iny
002B29r 1               @db:    lda     $FFFF,y
002B29r 1                       ldx     smir
002B29r 1                       beq     @m2
002B29r 1                       tax
002B29r 1                       lda     mirror,x
002B29r 1               @m2:    sta     s_cb
002B29r 1                       iny
002B29r 1                       sty     s_di
002B29r 1                       jmp     @sh
002B29r 1               @zero:  lda     #0
002B29r 1                       sta     s_cm
002B29r 1                       sta     s_cb
002B29r 1               @sh:    lda     s_pm            ; (this cell : the one above) << shift
002B29r 1                       sta     tlo
002B29r 1                       lda     s_cm
002B29r 1                       ldx     s_sh
002B29r 1                       beq     @s1
002B29r 1               @l1:    asl     tlo
002B29r 1                       rol
002B29r 1                       dex
002B29r 1                       bne     @l1
002B29r 1               @s1:    eor     #$FF
002B29r 1                       sta     s_om
002B29r 1                       lda     s_pb
002B29r 1                       sta     tlo
002B29r 1                       lda     s_cb
002B29r 1                       ldx     s_sh
002B29r 1                       beq     @s2
002B29r 1               @l2:    asl     tlo
002B29r 1                       rol
002B29r 1                       dex
002B29r 1                       bne     @l2
002B29r 1               @s2:    sta     s_ob
002B29r 1                       lda     s_cm
002B29r 1                       sta     s_pm
002B29r 1                       lda     s_cb
002B29r 1                       sta     s_pb
002B29r 1                       lda     s_r
002B29r 1                       clc
002B29r 1                       adc     s_rr
002B29r 1                       cmp     #PROWS
002B29r 1                       bcs     @skip
002B29r 1                       adc     #>wc
002B29r 1                       sta     @a+2
002B29r 1                       sta     @w+2
002B29r 1                       ldx     s_wx
002B29r 1               @a:     lda     wc,x
002B29r 1                       and     s_om
002B29r 1                       ora     s_ob
002B29r 1               @w:     sta     wc,x
002B29r 1                       inc     ncells
002B29r 1               @skip:  inc     s_rr
002B29r 1                       lda     s_rr
002B29r 1                       cmp     s_hn
002B29r 1                       bcs     *+5
002B29r 1                       jmp     @cell
002B29r 1               @ncol:  inc     s_cc
002B29r 1                       lda     s_cc
002B29r 1                       cmp     s_w
002B29r 1                       bcs     @mark
002B29r 1                       jmp     @col
002B29r 1               @mark:  lda     #0              ; mark the rows for comparing
002B29r 1                       sta     s_rr
002B29r 1               @mr:    lda     s_r
002B29r 1                       clc
002B29r 1                       adc     s_rr
002B29r 1                       cmp     #PROWS
002B29r 1                       bcs     @mn
002B29r 1                       tay
002B29r 1                       lda     s_c0
002B29r 1                       jsr     mark1
002B29r 1                       lda     s_c1
002B29r 1                       jsr     mark1
002B29r 1               @mn:    inc     s_rr
002B29r 1                       lda     s_rr
002B29r 1                       cmp     s_hn
002B29r 1                       bcc     @mr
002B29r 1                       rts
002B29r 1               
002B29r 1               .else
002B29r 1               ; ---- the sprites, drawn by the terminal --------------------------------------------
002B29r 1               ; Each object has a slot in the terminal's sprite layer (MOS: 15, on top;
002B29r 1               ; object X: X).  Each frame only what changed is sent: MOVE (5 bytes) when
002B29r 1               ; only the place did, PICTURE or FLAGS when only that did, else PLACE; HIDE
002B29r 1               ; when it went.  sl_* hold what the terminal was last told.
002B29r 1               hw_sprites:
002B29r 1  A2 09                ldx     #NOBJ-1
002B2Br 1  8E rr rr     @l:     stx     hw_i
002B2Er 1  BD rr rr             lda     o_kind,x
002B31r 1  D0 03                bne     *+5
002B33r 1  4C rr rr             jmp     @off
002B36r 1  E0 00                cpx     #O_MOS
002B38r 1  D0 06                bne     @ob
002B3Ar 1  20 rr rr             jsr     mos_frame
002B3Dr 1  4C rr rr             jmp     @fr
002B40r 1  20 rr rr     @ob:    jsr     obj_frame
002B43r 1  90 03        @fr:    bcc     *+5
002B45r 1  4C rr rr             jmp     @off
002B48r 1  8D rr rr             sta     hw_n
002B4Br 1  AE rr rr             ldx     hw_i
002B4Er 1  38                   sec                     ; x on the wire: x - scroll * 2 + 32 (0 .. 255)
002B4Fr 1  BD rr rr             lda     o_xl,x
002B52r 1  ED rr rr             sbc     sc2
002B55r 1  8D rr rr             sta     tmp
002B58r 1  BD rr rr             lda     o_xh,x
002B5Br 1  ED rr rr             sbc     sc2+1
002B5Er 1  8D rr rr             sta     tmp+1
002B61r 1  18                   clc
002B62r 1  AD rr rr             lda     tmp
002B65r 1  69 20                adc     #32
002B67r 1  8D rr rr             sta     hw_x
002B6Ar 1  AD rr rr             lda     tmp+1
002B6Dr 1  69 00                adc     #0
002B6Fr 1  F0 03                beq     *+5
002B71r 1  4C rr rr             jmp     @off
002B74r 1  BD rr rr             lda     o_y,x           ; y: the view starts at screen pixel 8, + 32
002B77r 1  10 07                bpl     @y
002B79r 1  C9 D8                cmp     #$D8            ; (above the view by more than 40: off)
002B7Br 1  B0 03                bcs     *+5
002B7Dr 1  4C rr rr             jmp     @off
002B80r 1  18           @y:     clc
002B81r 1  69 28                adc     #40
002B83r 1  8D rr rr             sta     hw_y
002B86r 1  AD rr rr             lda     smir
002B89r 1  29 01                and     #1
002B8Br 1  8D rr rr             sta     hw_f
002B8Er 1  BD rr rr             lda     sl_on,x         ; showing already?
002B91r 1  F0 59                beq     @place
002B93r 1  AD rr rr             lda     hw_n
002B96r 1  DD rr rr             cmp     sl_n,x
002B99r 1  D0 1B                bne     @pic
002B9Br 1  AD rr rr             lda     hw_f
002B9Er 1  DD rr rr             cmp     sl_f,x
002BA1r 1  D0 2E                bne     @flags
002BA3r 1  AD rr rr             lda     hw_x            ; the same picture: moved?
002BA6r 1  DD rr rr             cmp     sl_x,x
002BA9r 1  D0 39                bne     @move
002BABr 1  AD rr rr             lda     hw_y
002BAEr 1  DD rr rr             cmp     sl_y,x
002BB1r 1  D0 31                bne     @move
002BB3r 1  4C rr rr             jmp     @n
002BB6r 1  AD rr rr     @pic:   lda     hw_f            ; a new picture (only)?
002BB9r 1  DD rr rr             cmp     sl_f,x
002BBCr 1  D0 2E                bne     @place
002BBEr 1  20 rr rr             jsr     @same_xy
002BC1r 1  D0 29                bne     @place
002BC3r 1  A9 04                lda     #SPR_PIC
002BC5r 1  20 rr rr             jsr     spr_cmd
002BC8r 1  AD rr rr             lda     hw_n
002BCBr 1  20 rr rr             jsr     putc
002BCEr 1  4C rr rr             jmp     @keep
002BD1r 1  20 rr rr     @flags: jsr     @same_xy        ; turned round (only)?
002BD4r 1  D0 16                bne     @place
002BD6r 1  A9 05                lda     #SPR_FLAGS
002BD8r 1  20 rr rr             jsr     spr_cmd
002BDBr 1  AD rr rr             lda     hw_f
002BDEr 1  20 rr rr             jsr     putc
002BE1r 1  4C rr rr             jmp     @keep
002BE4r 1  A9 03        @move:  lda     #SPR_MOVE
002BE6r 1  20 rr rr             jsr     spr_cmd
002BE9r 1  4C rr rr             jmp     @xy
002BECr 1  A9 02        @place: lda     #SPR_PLACE
002BEEr 1  20 rr rr             jsr     spr_cmd
002BF1r 1  AD rr rr             lda     hw_n
002BF4r 1  20 rr rr             jsr     putc
002BF7r 1  AD rr rr             lda     hw_x
002BFAr 1  20 rr rr             jsr     putc
002BFDr 1  AD rr rr             lda     hw_y
002C00r 1  20 rr rr             jsr     putc
002C03r 1  AD rr rr             lda     hw_f
002C06r 1  20 rr rr             jsr     putc
002C09r 1  4C rr rr             jmp     @keep
002C0Cr 1  AD rr rr     @xy:    lda     hw_x
002C0Fr 1  20 rr rr             jsr     putc
002C12r 1  AD rr rr             lda     hw_y
002C15r 1  20 rr rr             jsr     putc
002C18r 1  AE rr rr     @keep:  ldx     hw_i            ; what the terminal shows now
002C1Br 1  A9 01                lda     #1
002C1Dr 1  9D rr rr             sta     sl_on,x
002C20r 1  AD rr rr             lda     hw_n
002C23r 1  9D rr rr             sta     sl_n,x
002C26r 1  AD rr rr             lda     hw_x
002C29r 1  9D rr rr             sta     sl_x,x
002C2Cr 1  AD rr rr             lda     hw_y
002C2Fr 1  9D rr rr             sta     sl_y,x
002C32r 1  AD rr rr             lda     hw_f
002C35r 1  9D rr rr             sta     sl_f,x
002C38r 1  4C rr rr             jmp     @n
002C3Br 1  AE rr rr     @off:   ldx     hw_i            ; not drawn: hide it if it shows
002C3Er 1  BD rr rr             lda     sl_on,x
002C41r 1  F0 0A                beq     @n
002C43r 1  A9 00                lda     #0
002C45r 1  9D rr rr             sta     sl_on,x
002C48r 1  A9 06                lda     #SPR_HIDE
002C4Ar 1  20 rr rr             jsr     spr_cmd
002C4Dr 1  AE rr rr     @n:     ldx     hw_i
002C50r 1  CA                   dex
002C51r 1  30 03                bmi     @r
002C53r 1  4C rr rr             jmp     @l
002C56r 1  60           @r:     rts
002C57r 1               @same_xy:                       ; Z set if object hw_i's place is unchanged
002C57r 1  AE rr rr             ldx     hw_i
002C5Ar 1  AD rr rr             lda     hw_x
002C5Dr 1  DD rr rr             cmp     sl_x,x
002C60r 1  D0 06                bne     @s
002C62r 1  AD rr rr             lda     hw_y
002C65r 1  DD rr rr             cmp     sl_y,x
002C68r 1  60           @s:     rts
002C69r 1               
002C69r 1               ; A tile in view changed (screen column tc_c, -3..79; htr): note it, on the
002C69r 1               ; wire (x tc_c * 2 + 32, y htr * 8 + 40), up to TCH_MAX a frame (more: $FF).
002C69r 1               ; The terminal keeps the background under a sprite by itself, and a tile
002C69r 1               ; drawn under one could leave its old pixels behind there when the sprite
002C69r 1               ; moves off; so the sprites over it are hidden (at once, not held) before
002C69r 1               ; the tile is drawn, and placed again in the same frame.
002C69r 1               .if UNC_TILES
002C69r 1               TCH_MAX         = 4
002C69r 1               note_tile:
002C69r 1                       ldx     tch_n
002C69r 1                       cpx     #TCH_MAX
002C69r 1                       bcs     @full
002C69r 1                       lda     tc_c
002C69r 1                       asl
002C69r 1                       clc
002C69r 1                       adc     #32
002C69r 1                       sta     tch_x,x
002C69r 1                       lda     htr
002C69r 1                       asl
002C69r 1                       asl
002C69r 1                       asl
002C69r 1                       adc     #40
002C69r 1                       sta     tch_y,x
002C69r 1                       inc     tch_n
002C69r 1                       rts
002C69r 1               @full:  lda     #$FF
002C69r 1                       sta     tch_n
002C69r 1                       rts
002C69r 1               
002C69r 1               ; before the frame: hide each shown sprite (16 x 16 at most) near a changed
002C69r 1               ; tile (8 x 8; x with 4 pixels to spare each side for this frame's scroll),
002C69r 1               ; and when the view scrolls, those over the columns that come in on the right
002C69r 1               ; (up to 3: screen x 139-159), or all of them if the view is redrawn instead
002C69r 1               unc_tiles:
002C69r 1                       lda     scrolled
002C69r 1                       beq     @sc
002C69r 1                       lda     noscroll
002C69r 1                       beq     @sc
002C69r 1                       lda     #$FF
002C69r 1                       sta     tch_n
002C69r 1               @sc:    lda     tch_n
002C69r 1                       ora     scrolled
002C69r 1                       bne     *+3
002C69r 1                       rts
002C69r 1                       ldx     #NOBJ-1
002C69r 1               @o:     stx     hw_i
002C69r 1                       lda     sl_on,x
002C69r 1                       beq     @n
002C69r 1                       lda     scrolled
002C69r 1                       beq     @nosc
002C69r 1                       lda     sl_x,x
002C69r 1                       cmp     #139+32
002C69r 1                       bcc     @nosc
002C69r 1                       cmp     #160+32
002C69r 1                       bcc     @hide
002C69r 1               @nosc:  ldy     tch_n
002C69r 1                       beq     @n
002C69r 1                       bmi     @hide           ; (too many: all of them)
002C69r 1                       dey
002C69r 1               @t:     lda     tch_x,y         ; tile x - 19 <= sprite x <= tile x + 11
002C69r 1                       sec
002C69r 1                       sbc     #19
002C69r 1                       cmp     sl_x,x
002C69r 1                       beq     @x1
002C69r 1                       bcs     @nt
002C69r 1               @x1:    lda     tch_x,y
002C69r 1                       clc
002C69r 1                       adc     #11
002C69r 1                       cmp     sl_x,x
002C69r 1                       bcc     @nt
002C69r 1                       lda     tch_y,y         ; tile y - 15 <= sprite y <= tile y + 7
002C69r 1                       sec
002C69r 1                       sbc     #15
002C69r 1                       cmp     sl_y,x
002C69r 1                       beq     @y1
002C69r 1                       bcs     @nt
002C69r 1               @y1:    lda     tch_y,y
002C69r 1                       clc
002C69r 1                       adc     #7
002C69r 1                       cmp     sl_y,x
002C69r 1                       bcs     @hide
002C69r 1               @nt:    dey
002C69r 1                       bpl     @t
002C69r 1                       bmi     @n
002C69r 1               @hide:  lda     #0
002C69r 1                       sta     sl_on,x
002C69r 1                       lda     #SPR_HIDE
002C69r 1                       jsr     spr_cmd
002C69r 1               @n:     ldx     hw_i
002C69r 1                       dex
002C69r 1                       bpl     @o
002C69r 1                       lda     #0
002C69r 1                       sta     tch_n
002C69r 1                       rts
002C69r 1               .endif
002C69r 1               
002C69r 1               ; ---- pacing: one frame at a time --------------------------------------------
002C69r 1               ; After each frame IDENTIFY (1C 0C) goes out; the terminal answers S P 1 when
002C69r 1               ; it has worked through everything before it.  The next frame waits for that
002C69r 1               ; (any one of the three characters; up to ASK_MS ms), so the terminal never
002C69r 1               ; falls behind and its receive buffer never fills.  The 6502 works out the
002C69r 1               ; next frame meanwhile, so usually there is nothing left to wait for.
002C69r 1               ASK_MS          = 150
002C69r 1               ask_send:
002C69r 1  A9 01                lda     #1
002C6Br 1  8D rr rr             sta     rp_on
002C6Er 1  A9 00                lda     #0
002C70r 1  8D rr rr             sta     rp_got
002C73r 1  A9 rr                lda     #<ident_txt
002C75r 1  A0 rr                ldy     #>ident_txt
002C77r 1  4C rr rr             jmp     print
002C7Ar 1               
002C7Ar 1               ask_wait:
002C7Ar 1  AD rr rr             lda     rp_got
002C7Dr 1  D0 1F                bne     @r
002C7Fr 1  A9 96                lda     #ASK_MS
002C81r 1  8D rr rr             sta     rp_t
002C84r 1  20 rr rr     @l:     jsr     getc
002C87r 1  90 06                bcc     @none
002C89r 1  20 rr rr             jsr     handle_key      ; (a key meanwhile)
002C8Cr 1  4C rr rr             jmp     @chk
002C8Fr 1  A9 01        @none:  lda     #1
002C91r 1  20 rr rr             jsr     delay_ms
002C94r 1  CE rr rr             dec     rp_t
002C97r 1  F0 06                beq     @miss
002C99r 1  AD rr rr     @chk:   lda     rp_got
002C9Cr 1  F0 E6                beq     @l
002C9Er 1  60           @r:     rts
002C9Fr 1  EE rr rr     @miss:  inc     rp_miss         ; (shown at GAME OVER)
002CA2r 1  60                   rts
002CA3r 1               
002CA3r 1               ; ---- GAME OVER: the terminal's STATUS (1C 0D; the reply is "ST", then the
002CA3r 1               ; bytes lost and the receive buffer's peak since the last STATUS, in hex:
002CA3r 1               ; 2 and 4 digits), and the replies to IDENTIFY that didn't come in time.
002CA3r 1               ; A terminal without STATUS doesn't answer: then nothing is shown.
002CA3r 1               st_show:
002CA3r 1  A9 00                lda     #0
002CA5r 1  8D rr rr             sta     rp_on
002CA8r 1  A9 rr                lda     #<stq_txt
002CAAr 1  A0 rr                ldy     #>stq_txt
002CACr 1  20 rr rr             jsr     print
002CAFr 1  A9 FA                lda     #250            ; wait for the T (it may have work to finish)
002CB1r 1  8D rr rr             sta     rp_t
002CB4r 1  20 rr rr     @w:     jsr     getc
002CB7r 1  B0 0B                bcs     @c
002CB9r 1  A9 01        @w1:    lda     #1
002CBBr 1  20 rr rr             jsr     delay_ms
002CBEr 1  CE rr rr             dec     rp_t
002CC1r 1  D0 F1                bne     @w
002CC3r 1  60                   rts
002CC4r 1  C9 54        @c:     cmp     #'T'
002CC6r 1  D0 F1                bne     @w1
002CC8r 1  A2 00                ldx     #0
002CCAr 1  8E rr rr     @d:     stx     hl_x
002CCDr 1  A9 32                lda     #50
002CCFr 1  8D rr rr             sta     rp_t
002CD2r 1  20 rr rr     @g:     jsr     getc
002CD5r 1  B0 0B                bcs     @s
002CD7r 1  A9 01                lda     #1
002CD9r 1  20 rr rr             jsr     delay_ms
002CDCr 1  CE rr rr             dec     rp_t
002CDFr 1  D0 F1                bne     @g
002CE1r 1  60                   rts
002CE2r 1  AE rr rr     @s:     ldx     hl_x
002CE5r 1  9D rr rr             sta     st_dig,x
002CE8r 1  E8                   inx
002CE9r 1  E0 06                cpx     #6
002CEBr 1  D0 DD                bne     @d
002CEDr 1  A9 rr                lda     #<st1_txt
002CEFr 1  A0 rr                ldy     #>st1_txt
002CF1r 1  20 rr rr             jsr     print
002CF4r 1  AD rr rr             lda     st_dig
002CF7r 1  20 rr rr             jsr     putc
002CFAr 1  AD rr rr             lda     st_dig+1
002CFDr 1  20 rr rr             jsr     putc
002D00r 1  A9 rr                lda     #<st2_txt
002D02r 1  A0 rr                ldy     #>st2_txt
002D04r 1  20 rr rr             jsr     print
002D07r 1  A2 02                ldx     #2
002D09r 1  BD rr rr     @p:     lda     st_dig,x
002D0Cr 1  20 rr rr             jsr     putc
002D0Fr 1  E8                   inx
002D10r 1  E0 06                cpx     #6
002D12r 1  D0 F5                bne     @p
002D14r 1  A9 rr                lda     #<st3_txt
002D16r 1  A0 rr                ldy     #>st3_txt
002D18r 1  20 rr rr             jsr     print
002D1Br 1  AD rr rr             lda     rp_miss
002D1Er 1  4C rr rr             jmp     prhex
002D21r 1               
002D21r 1               ; ---- healing: changed tiles are sent again ------------------------------------
002D21r 1               ; The terminal keeps the background under a sprite itself.  If a byte is lost
002D21r 1               ; or the terminal gets a cell under a sprite wrong, a changed tile (a bit
002D21r 1               ; taken under MOS, a block bumped) could keep old pixels.  So HEAL_T frames
002D21r 1               ; after a tile changes, once no sprite covers it, its 8 characters are sent
002D21r 1               ; again (about 20 bytes).
002D21r 1               HEAL_N          = 6
002D21r 1               HEAL_T          = 10
002D21r 1               heal_add:                       ; tile htc, htr changed (A, X, Y kept)
002D21r 1  48                   pha
002D22r 1  8A                   txa
002D23r 1  48                   pha
002D24r 1  A2 05                ldx     #HEAL_N-1
002D26r 1  BD rr rr     @f:     lda     hl_t,x
002D29r 1  F0 15                beq     @put
002D2Br 1  BD rr rr             lda     hl_c,x          ; (the same tile again: start again)
002D2Er 1  CD rr rr             cmp     htc
002D31r 1  D0 08                bne     @nx
002D33r 1  BD rr rr             lda     hl_r,x
002D36r 1  CD rr rr             cmp     htr
002D39r 1  F0 05                beq     @put
002D3Br 1  CA           @nx:    dex
002D3Cr 1  10 E8                bpl     @f
002D3Er 1  30 11                bmi     @r              ; (full: never mind)
002D40r 1  AD rr rr     @put:   lda     htc
002D43r 1  9D rr rr             sta     hl_c,x
002D46r 1  AD rr rr             lda     htr
002D49r 1  9D rr rr             sta     hl_r,x
002D4Cr 1  A9 0A                lda     #HEAL_T
002D4Er 1  9D rr rr             sta     hl_t,x
002D51r 1  68           @r:     pla
002D52r 1  AA                   tax
002D53r 1  68                   pla
002D54r 1  60                   rts
002D55r 1               
002D55r 1               heal_tick:
002D55r 1  A2 05                ldx     #HEAL_N-1
002D57r 1  BD rr rr     @l:     lda     hl_t,x
002D5Ar 1  F0 0E                beq     @n
002D5Cr 1  DE rr rr             dec     hl_t,x
002D5Fr 1  D0 09                bne     @n
002D61r 1  8E rr rr             stx     hw_i
002D64r 1  20 rr rr             jsr     heal_one
002D67r 1  AE rr rr             ldx     hw_i
002D6Ar 1  CA           @n:     dex
002D6Br 1  10 EA                bpl     @l
002D6Dr 1  60                   rts
002D6Er 1               
002D6Er 1               ; tile hl_*,X is due: if it is in view and no sprite shows over it, mark its
002D6Er 1               ; characters as unknown on the screen (sh) and compare them again
002D6Er 1               heal_one:
002D6Er 1  BD rr rr             lda     hl_c,x          ; on the wire: x = column * 8 - scroll * 2 + 32
002D71r 1  8D rr rr             sta     hl_x
002D74r 1  A9 00                lda     #0
002D76r 1  8D rr rr             sta     hl_x+1
002D79r 1  0E rr rr             asl     hl_x
002D7Cr 1  2E rr rr             rol     hl_x+1
002D7Fr 1  0E rr rr             asl     hl_x
002D82r 1  2E rr rr             rol     hl_x+1
002D85r 1  0E rr rr             asl     hl_x
002D88r 1  2E rr rr             rol     hl_x+1
002D8Br 1  38                   sec
002D8Cr 1  AD rr rr             lda     hl_x
002D8Fr 1  ED rr rr             sbc     sc2
002D92r 1  8D rr rr             sta     hl_x
002D95r 1  AD rr rr             lda     hl_x+1
002D98r 1  ED rr rr             sbc     sc2+1
002D9Br 1  F0 03                beq     *+5              ; (out of view, or partly: never mind)
002D9Dr 1  4C rr rr             jmp     @r
002DA0r 1  AD rr rr             lda     hl_x
002DA3r 1  C9 99                cmp     #160 - 7
002DA5r 1  90 03                bcc     *+5
002DA7r 1  4C rr rr             jmp     @r
002DAAr 1  69 20                adc     #32
002DACr 1  8D rr rr             sta     hl_x
002DAFr 1  BD rr rr             lda     hl_r,x          ; y = row * 8 + 40
002DB2r 1  0A                   asl
002DB3r 1  0A                   asl
002DB4r 1  0A                   asl
002DB5r 1  69 28                adc     #40
002DB7r 1  8D rr rr             sta     hl_x+1
002DBAr 1  A0 09                ldy     #NOBJ-1         ; a sprite over it (16 x 16 at most, 2 to spare)?
002DBCr 1  B9 rr rr     @s:     lda     sl_on,y
002DBFr 1  F0 30                beq     @ns
002DC1r 1  AD rr rr             lda     hl_x
002DC4r 1  38                   sec
002DC5r 1  E9 11                sbc     #17
002DC7r 1  D9 rr rr             cmp     sl_x,y
002DCAr 1  F0 02                beq     @x1
002DCCr 1  B0 23                bcs     @ns
002DCEr 1  AD rr rr     @x1:    lda     hl_x
002DD1r 1  18                   clc
002DD2r 1  69 09                adc     #9
002DD4r 1  D9 rr rr             cmp     sl_x,y
002DD7r 1  90 18                bcc     @ns
002DD9r 1  AD rr rr             lda     hl_x+1
002DDCr 1  38                   sec
002DDDr 1  E9 11                sbc     #17
002DDFr 1  D9 rr rr             cmp     sl_y,y
002DE2r 1  F0 02                beq     @y1
002DE4r 1  B0 0B                bcs     @ns
002DE6r 1  AD rr rr     @y1:    lda     hl_x+1
002DE9r 1  18                   clc
002DEAr 1  69 09                adc     #9
002DECr 1  D9 rr rr             cmp     sl_y,y
002DEFr 1  B0 48                bcs     @later
002DF1r 1  88           @ns:    dey
002DF2r 1  10 C8                bpl     @s
002DF4r 1  BD rr rr             lda     hl_r,x          ; the two rows of sh: the characters not known
002DF7r 1  0A                   asl
002DF8r 1  18                   clc
002DF9r 1  69 rr                adc     #>sh
002DFBr 1  8D rr rr             sta     @a+2
002DFEr 1  8D rr rr             sta     @b+2
002E01r 1  69 01                adc     #1
002E03r 1  8D rr rr             sta     @c+2
002E06r 1  8D rr rr             sta     @d+2
002E09r 1  BD rr rr             lda     hl_c,x
002E0Cr 1  0A                   asl
002E0Dr 1  0A                   asl
002E0Er 1  A8                   tay
002E0Fr 1  A9 04                lda     #4
002E11r 1  8D rr rr             sta     hl_x
002E14r 1  B9 rr rr     @a:     lda     sh,y
002E17r 1  49 FF                eor     #$FF
002E19r 1  99 rr rr     @b:     sta     sh,y
002E1Cr 1  B9 rr rr     @c:     lda     sh,y
002E1Fr 1  49 FF                eor     #$FF
002E21r 1  99 rr rr     @d:     sta     sh,y
002E24r 1  C8                   iny
002E25r 1  CE rr rr             dec     hl_x
002E28r 1  D0 EA                bne     @a
002E2Ar 1  BD rr rr             lda     hl_c,x          ; and compared (sent) again
002E2Dr 1  8D rr rr             sta     htc
002E30r 1  BD rr rr             lda     hl_r,x
002E33r 1  8D rr rr             sta     htr
002E36r 1  4C rr rr             jmp     tile_changed
002E39r 1  A9 03        @later: lda     #3              ; covered: try again a little later
002E3Br 1  9D rr rr             sta     hl_t,x
002E3Er 1  60           @r:     rts
002E3Fr 1               
002E3Fr 1               ; send 1C, command A and the slot of object hw_i (MOS: 15)
002E3Fr 1  48           spr_cmd:pha
002E40r 1  A9 1C                lda     #TC_SPR
002E42r 1  20 rr rr             jsr     putc
002E45r 1  68                   pla
002E46r 1  20 rr rr             jsr     putc
002E49r 1  AD rr rr             lda     hw_i
002E4Cr 1  D0 02                bne     @s
002E4Er 1  A9 0F                lda     #15
002E50r 1  4C rr rr     @s:     jmp     putc
002E53r 1               
002E53r 1               
002E53r 1               ; at start: is the sprite layer there?  Then send it the pictures (SMBSPR.SMB,
002E53r 1               ; loaded into wc and sent as it is: DEFINE commands).  Without it, a word,
002E53r 1               ; and back to the boot menu.
002E53r 1               spr_setup:
002E53r 1  20 rr rr             jsr     flush_in
002E56r 1  A9 rr                lda     #<ident_txt     ; IDENTIFY: the terminal answers S P 1
002E58r 1  A0 rr                ldy     #>ident_txt
002E5Ar 1  20 rr rr             jsr     print
002E5Dr 1  A2 00                ldx     #0              ; wait up to about 200 ms
002E5Fr 1  8E rr rr     @w:     stx     tmp4
002E62r 1  A9 01                lda     #1
002E64r 1  20 rr rr             jsr     delay_ms
002E67r 1  20 rr rr             jsr     getc
002E6Ar 1  B0 0B                bcs     @got
002E6Cr 1  AE rr rr             ldx     tmp4
002E6Fr 1  E8                   inx
002E70r 1  E0 C8                cpx     #200
002E72r 1  D0 EB                bne     @w
002E74r 1  4C rr rr             jmp     @none
002E77r 1  C9 53        @got:   cmp     #'S'
002E79r 1  D0 72                bne     @none
002E7Br 1  20 rr rr             jsr     @next
002E7Er 1  C9 50                cmp     #'P'
002E80r 1  D0 6B                bne     @none
002E82r 1  20 rr rr             jsr     @next
002E85r 1  C9 31                cmp     #'1'
002E87r 1  D0 64                bne     @none
002E89r 1  AD 15 FE             lda     SBC_LOAD        ; the pictures from the disk
002E8Cr 1  C9 4C                cmp     #$4C
002E8Er 1  D0 56                bne     @nofile
002E90r 1  A9 rr                lda     #<spr_blk
002E92r 1  A0 rr                ldy     #>spr_blk
002E94r 1  20 15 FE             jsr     SBC_LOAD
002E97r 1  B0 4D                bcs     @nofile
002E99r 1  8E rr rr             stx     tmp             ; X/Y: its length
002E9Cr 1  8C rr rr             sty     tmp+1
002E9Fr 1  A9 rr                lda     #<wc
002EA1r 1  8D rr rr             sta     @rd+1
002EA4r 1  A9 rr                lda     #>wc
002EA6r 1  8D rr rr             sta     @rd+2
002EA9r 1  AD rr rr     @s:     lda     tmp
002EACr 1  0D rr rr             ora     tmp+1
002EAFr 1  F0 1C                beq     @done
002EB1r 1  AD FF FF     @rd:    lda     $FFFF
002EB4r 1  20 03 FE             jsr     SBC_CHROUT
002EB7r 1  EE rr rr             inc     @rd+1
002EBAr 1  D0 03                bne     @c
002EBCr 1  EE rr rr             inc     @rd+2
002EBFr 1  AD rr rr     @c:     lda     tmp
002EC2r 1  D0 03                bne     @d
002EC4r 1  CE rr rr             dec     tmp+1
002EC7r 1  CE rr rr     @d:     dec     tmp
002ECAr 1  4C rr rr             jmp     @s
002ECDr 1  60           @done:  rts
002ECEr 1  A2 32        @next:  ldx     #50             ; the next character, within about 50 ms
002ED0r 1  8E rr rr     @nw:    stx     tmp4
002ED3r 1  20 rr rr             jsr     getc
002ED6r 1  B0 0D                bcs     @nr
002ED8r 1  A9 01                lda     #1
002EDAr 1  20 rr rr             jsr     delay_ms
002EDDr 1  AE rr rr             ldx     tmp4
002EE0r 1  CA                   dex
002EE1r 1  D0 ED                bne     @nw
002EE3r 1  A9 00                lda     #0
002EE5r 1  60           @nr:    rts
002EE6r 1  A9 rr        @nofile:lda     #<nospr2_txt
002EE8r 1  A0 rr                ldy     #>nospr2_txt
002EEAr 1  4C rr rr             jmp     @say
002EEDr 1  A9 rr        @none:  lda     #<nospr_txt
002EEFr 1  A0 rr                ldy     #>nospr_txt
002EF1r 1  48           @say:   pha
002EF2r 1  98                   tya
002EF3r 1  48                   pha
002EF4r 1  A9 rr                lda     #<cls_txt
002EF6r 1  A0 rr                ldy     #>cls_txt
002EF8r 1  20 rr rr             jsr     print
002EFBr 1  68                   pla
002EFCr 1  A8                   tay
002EFDr 1  68                   pla
002EFEr 1  20 rr rr             jsr     print
002F01r 1  A9 rr                lda     #<anykey_txt
002F03r 1  A0 rr                ldy     #>anykey_txt
002F05r 1  20 rr rr             jsr     print
002F08r 1  20 rr rr     @k:     jsr     menu_key
002F0Br 1  4C rr rr             jmp     exit_game
002F0Er 1               .endif
002F0Er 1               
002F0Er 1               ; A = MOS's picture (smir: mirrored); carry set if he isn't drawn
002F0Er 1               mos_frame:
002F0Er 1  AD rr rr             lda     facing
002F11r 1  8D rr rr             sta     smir
002F14r 1  AD rr rr             lda     mstate
002F17r 1  C9 03                cmp     #MS_IN
002F19r 1  D0 03                bne     *+5
002F1Br 1  4C rr rr             jmp     @hide
002F1Er 1  C9 04                cmp     #MS_DEAD
002F20r 1  D0 09                bne     @a
002F22r 1  A9 00                lda     #0
002F24r 1  8D rr rr             sta     smir
002F27r 1  A9 04                lda     #SP_MOS_DEAD
002F29r 1  18                   clc
002F2Ar 1  60                   rts
002F2Br 1  AD rr rr     @a:     lda     inv_t           ; blinking
002F2Er 1  29 02                and     #2
002F30r 1  F0 03                beq     *+5
002F32r 1  4C rr rr             jmp     @hide
