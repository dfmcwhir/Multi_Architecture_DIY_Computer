002F38r 1  F0 0F                beq     @a2
002F3Ar 1  C9 28                cmp     #40             ; (slower at the end: a warning)
002F3Cr 1  AD rr rr             lda     frame
002F3Fr 1  B0 01                bcs     @a1
002F41r 1  4A                   lsr
002F42r 1  29 02        @a1:    and     #2
002F44r 1  F0 03                beq     *+5
002F46r 1  4C rr rr             jmp     @hide
002F49r 1               @a2:
002F49r 1  A0 00                ldy     #SP_MOS_STAND
002F4Br 1  AD rr rr             lda     big
002F4Er 1  F0 09                beq     @s
002F50r 1  A0 05                ldy     #SP_BIG_STAND
002F52r 1  AD rr rr             lda     fire
002F55r 1  F0 02                beq     @s
002F57r 1  A0 09                ldy     #SP_FIRE_STAND
002F59r 1  AD rr rr     @s:     lda     duck            ; ducking: the next picture along
002F5Cr 1  F0 05                beq     @s2
002F5Er 1  B9 rr rr             lda     mduck_pic,y
002F61r 1  18                   clc
002F62r 1  60                   rts
002F63r 1  8C rr rr     @s2:    sty     tmp
002F66r 1  AD rr rr             lda     mstate
002F69r 1  C9 01                cmp     #MS_FLAG
002F6Br 1  F0 6D                beq     @st
002F6Dr 1  C9 05                cmp     #MS_RESET
002F6Fr 1  F0 69                beq     @st
002F71r 1  AD rr rr             lda     onground
002F74r 1  F0 3F                beq     @jump
002F76r 1  AD rr rr             lda     o_vxh           ; walking: the legs change every 4 pixels
002F79r 1  10 0F                bpl     @p
002F7Br 1  38                   sec
002F7Cr 1  A9 00                lda     #0
002F7Er 1  ED rr rr             sbc     o_vxl
002F81r 1  A8                   tay
002F82r 1  A9 00                lda     #0
002F84r 1  ED rr rr             sbc     o_vxh
002F87r 1  4C rr rr             jmp     @add
002F8Ar 1  AC rr rr     @p:     ldy     o_vxl
002F8Dr 1  C0 00                cpy     #0
002F8Fr 1  D0 04                bne     @add
002F91r 1  C9 00                cmp     #0
002F93r 1  F0 45                beq     @st
002F95r 1  8D rr rr     @add:   sta     tmp2
002F98r 1  98                   tya
002F99r 1  18                   clc
002F9Ar 1  6D rr rr             adc     anim
002F9Dr 1  8D rr rr             sta     anim
002FA0r 1  AD rr rr             lda     anim+1
002FA3r 1  6D rr rr             adc     tmp2
002FA6r 1  8D rr rr             sta     anim+1
002FA9r 1  29 04                and     #4
002FABr 1  4A                   lsr
002FACr 1  4A                   lsr
002FADr 1  18                   clc
