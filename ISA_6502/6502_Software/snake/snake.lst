000145r 2  A9 00                lda     #0              ; neither: silent
000147r 2  F0 4E                beq     @vol
000149r 2  8A           @have:  txa                     ; the tone period
00014Ar 2  0A                   asl
00014Br 2  8D 22 7F             sta     SFX_AY_ADDR
00014Er 2  B9 rr rr             lda     sfx_perl,y
