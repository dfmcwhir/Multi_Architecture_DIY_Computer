000331r 2  9D rr rr             sta     sfx_len,x
000334r 2  4C rr rr             jmp     @cmd
000337r 2               
000337r 2               ; the next byte of voice X's script
000337r 2               sfx_byte:
000337r 2  BD rr rr             lda     sfx_lo,x
00033Ar 2  8D rr rr             sta     @ld+1
00033Dr 2  BD rr rr             lda     sfx_hi,x
000340r 2  8D rr rr             sta     @ld+2
000343r 2  AD FF FF     @ld:    lda     $FFFF
000346r 2  FE rr rr             inc     sfx_lo,x
000349r 2  D0 03                bne     @r
00034Br 2  FE rr rr             inc     sfx_hi,x
00034Er 2  60           @r:     rts
00034Fr 2               
00034Fr 2               ; the tone periods of C1 .. B1 for the 2 MHz chip clock: 2 MHz / (16 x
00034Fr 2               ; frequency); each octave up is half (to within a third of a percent)
00034Fr 2  EE 18 4D 8E  sfx_c1_lo:  .lobytes 3822, 3608, 3405, 3214, 3034, 2863, 2703, 2551, 2408, 2273, 2145, 2025
000353r 2  DA 2F 8F F7  
000357r 2  68 E1 61 E9  
00035Br 2  0E 0E 0D 0C  sfx_c1_hi:  .hibytes 3822, 3608, 3405, 3214, 3034, 2863, 2703, 2551, 2408, 2273, 2145, 2025
00035Fr 2  0B 0B 0A 09  
000363r 2  09 08 08 07  
000367r 2               
000367r 2               
000367r 1               
000367r 1               ; ----------------------------------------------------------------------------
000367r 1               ; I/O and helpers (as in INVADERS)
000367r 1               ; ----------------------------------------------------------------------------
000367r 1               putc            = SBC_CHROUT    ; preserves A, X, Y
000367r 1               getc            = SBC_CHRIN     ; carry set = key in A
000367r 1               
000367r 1               ; move the cursor to column X, row Y.  Preserves X and Y.
000367r 1  A9 0F        gotoxy: lda     #TC_ROW
000369r 1  20 03 FE             jsr     putc
00036Cr 1  98                   tya
00036Dr 1  20 03 FE             jsr     putc
000370r 1  A9 0E                lda     #TC_COL
000372r 1  20 03 FE             jsr     putc
000375r 1  8A                   txa
000376r 1  4C 03 FE             jmp     putc
000379r 1               
000379r 1               ; set / reset the pixel at X, Y.  Preserves X and Y.
000379r 1  A9 05        setpix: lda     #TC_SETPIX
00037Br 1  D0 02                bne     pix
00037Dr 1  A9 06        clrpix: lda     #TC_CLRPIX
00037Fr 1  20 03 FE     pix:    jsr     putc
000382r 1  8A                   txa
000383r 1  20 03 FE             jsr     putc
000386r 1  98                   tya
000387r 1  4C 03 FE             jmp     putc
00038Ar 1               
00038Ar 1               ; print the string at A (lo) / Y (hi), terminated by $FF
00038Ar 1  8D rr rr     print:  sta     @ld+1
00038Dr 1  8C rr rr             sty     @ld+2
000390r 1  A0 00                ldy     #0
000392r 1  B9 FF FF     @ld:    lda     $FFFF,y
000395r 1  C9 FF                cmp     #TERM
000397r 1  F0 06                beq     @done
000399r 1  20 03 FE             jsr     putc
00039Cr 1  C8                   iny
00039Dr 1  D0 F3                bne     @ld
00039Fr 1  60           @done:  rts
0003A0r 1               
0003A0r 1               ; print A as two BCD digits
0003A0r 1  48           prbcd:  pha
0003A1r 1  4A                   lsr
0003A2r 1  4A                   lsr
0003A3r 1  4A                   lsr
0003A4r 1  4A                   lsr
0003A5r 1  09 30                ora     #'0'
0003A7r 1  20 03 FE             jsr     putc
0003AAr 1  68                   pla
0003ABr 1  29 0F                and     #$0F
0003ADr 1  09 30                ora     #'0'
0003AFr 1  4C 03 FE             jmp     putc
0003B2r 1               
0003B2r 1               ; 16 bit Galois LFSR.  Returns a random byte in A.  Preserves X and Y.
0003B2r 1  AD rr rr     rand:   lda     rng+1
0003B5r 1  4A                   lsr
0003B6r 1  6E rr rr             ror     rng
0003B9r 1  90 02                bcc     @n
0003BBr 1  49 B4                eor     #$B4
0003BDr 1  8D rr rr     @n:     sta     rng+1
0003C0r 1  4D rr rr             eor     rng
0003C3r 1  60                   rts
0003C4r 1               
0003C4r 1               ; wait about A ms.  The inner loop is sized for the clock (CLOCK_MHZ in
0003C4r 1               ; sbc_api.inc): 5 + 4 * (CLOCK_MHZ - 1) cycles a turn, DELAY_N turns a ms.
0003C4r 1               DELAY_N = (1000 * CLOCK_MHZ - 7) / (5 + 4 * (CLOCK_MHZ - 1))
0003C4r 1               delay_ms:
0003C4r 1  AA                   tax
0003C5r 1  F0 0D                beq     @done
0003C7r 1  20 rr rr     @o:     jsr     sfx_poll        ; (the sound goes on while waiting)
0003CAr 1  A0 DD                ldy     #DELAY_N
0003CCr 1               @i:
0003CCr 1  EA EA        .repeat CLOCK_MHZ - 1           ; (4 more cycles a turn for each MHz above 1)
0003CEr 1                       nop
0003CEr 1                       nop
0003CEr 1               .endrepeat
0003CEr 1  88                   dey
0003CFr 1  D0 FB                bne     @i
0003D1r 1  CA                   dex
0003D2r 1  D0 F3                bne     @o
0003D4r 1  60           @done:  rts
0003D5r 1               
0003D5r 1               ; wait about A x 50 ms
0003D5r 1               delay_long:
0003D5r 1  8D rr rr             sta     tmp
0003D8r 1  A9 32        @l:     lda     #50
0003DAr 1  20 rr rr             jsr     delay_ms
0003DDr 1  20 rr rr             jsr     flush_in        ; keys pressed meanwhile are dropped (so the
0003E0r 1  CE rr rr             dec     tmp             ; ROM's keyboard buffer never fills up)
0003E3r 1  D0 F3                bne     @l
0003E5r 1  60                   rts
0003E6r 1               
0003E6r 1               ; horizontal line of pixels: X = x0, Y = y, A = length
0003E6r 1  8D rr rr     hline:  sta     tmp
0003E9r 1  20 rr rr     @l:     jsr     setpix
0003ECr 1  E8                   inx
0003EDr 1  CE rr rr             dec     tmp
0003F0r 1  D0 F7                bne     @l
0003F2r 1  60                   rts
0003F3r 1               
0003F3r 1               ; vertical line of pixels: X = x, Y = y0, A = length
0003F3r 1  8D rr rr     vline:  sta     tmp
0003F6r 1  20 rr rr     @l:     jsr     setpix
0003F9r 1  C8                   iny
0003FAr 1  CE rr rr             dec     tmp
0003FDr 1  D0 F7                bne     @l
0003FFr 1  60                   rts
000400r 1               
000400r 1               ; ----------------------------------------------------------------------------
000400r 1               ; grid access.  cell_at points grid_rd / grid_wr at cell X, Y.
000400r 1               ; Preserves X and Y.
000400r 1               ; ----------------------------------------------------------------------------
000400r 1               cell_at:
000400r 1  8A                   txa
000401r 1  18                   clc
000402r 1  79 rr rr             adc     row_lo,y
000405r 1  8D rr rr             sta     grid_rd+1
000408r 1  8D rr rr             sta     grid_wr+1
00040Br 1  B9 rr rr             lda     row_hi,y
00040Er 1  69 00                adc     #0
000410r 1  8D rr rr             sta     grid_rd+2
000413r 1  8D rr rr             sta     grid_wr+2
000416r 1  60                   rts
000417r 1  AD FF FF     grid_rd:lda     $FFFF           ; operand set by cell_at
00041Ar 1  60                   rts
00041Br 1  8D FF FF     grid_wr:sta     $FFFF
00041Er 1  60                   rts
00041Fr 1               
00041Fr 1               ; draw / erase cell X, Y (2 x 2 pixels).  Preserves nothing.
00041Fr 1               cell_pixels:                    ; X, Y -> pixel X, Y of the cell's top left
00041Fr 1  8A                   txa
000420r 1  0A                   asl
000421r 1  69 01                adc     #PX0            ; (carry is clear: gx*2 < 256)
000423r 1  AA                   tax
000424r 1  98                   tya
000425r 1  0A                   asl
000426r 1  69 05                adc     #PY0
000428r 1  A8                   tay
000429r 1  60                   rts
00042Ar 1               
00042Ar 1               draw_cell:
00042Ar 1  20 rr rr             jsr     cell_pixels
00042Dr 1  20 rr rr             jsr     setpix
000430r 1  E8                   inx
000431r 1  20 rr rr             jsr     setpix
000434r 1  C8                   iny
000435r 1  20 rr rr             jsr     setpix
000438r 1  CA                   dex
000439r 1  4C rr rr             jmp     setpix
00043Cr 1               
00043Cr 1               erase_cell:
00043Cr 1  20 rr rr             jsr     cell_pixels
00043Fr 1  20 rr rr             jsr     clrpix
000442r 1  E8                   inx
000443r 1  20 rr rr             jsr     clrpix
000446r 1  C8                   iny
000447r 1  20 rr rr             jsr     clrpix
00044Ar 1  CA                   dex
00044Br 1  4C rr rr             jmp     clrpix
00044Er 1               
00044Er 1               ; food is the two pixels on one diagonal of its cell
00044Er 1               draw_food:
00044Er 1  AE rr rr             ldx     food_x
000451r 1  AC rr rr             ldy     food_y
000454r 1  20 rr rr             jsr     cell_pixels
000457r 1  20 rr rr             jsr     setpix
00045Ar 1  E8                   inx
00045Br 1  C8                   iny
00045Cr 1  4C rr rr             jmp     setpix
00045Fr 1               
00045Fr 1               .macro MENU_IDLE
00045Fr 1                       jsr     rand            ; stir the random numbers while waiting
00045Fr 1                       jsr     sfx_poll
00045Fr 1               .endmacro
00045Fr 1               CTRL_COL        = 19
00045Fr 1               CTRL_ROW        = 18
00045Fr 1               
00045Fr 1               ; ============================================================================
00045Fr 1               ; gamepad and menu input (shared by the SBC games)
00045Fr 1               ; ============================================================================
00045Fr 1               PAD_A           = $01           ; bits returned by SBC_PADSTATE
00045Fr 1               PAD_B           = $02
00045Fr 1               PAD_SELECT      = $04
00045Fr 1               PAD_START       = $08
00045Fr 1               PAD_UP          = $10
00045Fr 1               PAD_DOWN        = $20
00045Fr 1               PAD_LEFT        = $40
00045Fr 1               PAD_RIGHT       = $80
00045Fr 1               PAD_GO          = $80           ; menu_key's answer for gamepad A or Start
00045Fr 1               
00045Fr 1               ; read the gamepad: pad = buttons held now, padnew = buttons pressed since
00045Fr 1               ; the last call.  Preserves X and Y (SBC_PADSTATE only changes A).
00045Fr 1               read_pad:
00045Fr 1  20 12 FE             jsr     SBC_PADSTATE
000462r 1  C9 FF                cmp     #$FF            ; every button "pressed" = no pad
000464r 1  D0 02                bne     @ok
000466r 1  A9 00                lda     #0
000468r 1  8D rr rr     @ok:    sta     pad
00046Br 1  AD rr rr             lda     padold
00046Er 1  49 FF                eor     #$FF
000470r 1  2D rr rr             and     pad
000473r 1  8D rr rr             sta     padnew
000476r 1  AD rr rr             lda     pad
000479r 1  8D rr rr             sta     padold
00047Cr 1  60                   rts
00047Dr 1               
00047Dr 1               ; throw away waiting characters
00047Dr 1               flush_in:
00047Dr 1  20 00 FE             jsr     getc
000480r 1  B0 FB                bcs     flush_in
000482r 1  60                   rts
000483r 1               
000483r 1               ; carry set if A is one of the characters the gamepad driver types for the
000483r 1               ; pad (W A S D and space).  Those are ignored in gamepad mode so that one
000483r 1               ; press doesn't act twice.  Preserves A.
000483r 1               pad_typed:
000483r 1  C9 20                cmp     #' '
000485r 1  F0 12                beq     @y
000487r 1  C9 57                cmp     #'W'
000489r 1  F0 0E                beq     @y
00048Br 1  C9 41                cmp     #'A'
00048Dr 1  F0 0A                beq     @y
00048Fr 1  C9 53                cmp     #'S'
000491r 1  F0 06                beq     @y
000493r 1  C9 44                cmp     #'D'
000495r 1  F0 02                beq     @y
000497r 1  18                   clc
000498r 1  60                   rts
000499r 1  38           @y:     sec
00049Ar 1  60                   rts
00049Br 1               
00049Br 1               ; wait for a menu choice.  Returns a key (letters in upper case), or
00049Br 1               ; PAD_GO for the gamepad's A or Start button.
00049Br 1               menu_key:
00049Br 1  20 rr rr 20  @l:     MENU_IDLE
00049Fr 1  rr rr        
0004A1r 1  20 rr rr             jsr     read_pad
0004A4r 1  AD rr rr             lda     padnew
0004A7r 1  29 09                and     #PAD_A | PAD_START
0004A9r 1  D0 21                bne     @pad
0004ABr 1  20 00 FE             jsr     getc
0004AEr 1  90 EB                bcc     @l
0004B0r 1  C9 20                cmp     #' '            ; a space typed by the pad's A button?
0004B2r 1  D0 0D                bne     @up
0004B4r 1  20 rr rr             jsr     read_pad
0004B7r 1  AD rr rr             lda     pad
0004BAr 1  29 01                and     #PAD_A
0004BCr 1  D0 0E                bne     @pad
0004BEr 1  A9 20                lda     #' '
0004C0r 1  60                   rts
0004C1r 1  C9 61        @up:    cmp     #'a'
0004C3r 1  90 06                bcc     @r
0004C5r 1  C9 7B                cmp     #'z'+1
0004C7r 1  B0 02                bcs     @r
0004C9r 1  29 DF                and     #$DF
0004CBr 1  60           @r:     rts
0004CCr 1  20 rr rr     @pad:   jsr     flush_in        ; the space the driver typed for it
0004CFr 1  A9 80                lda     #PAD_GO
0004D1r 1  60                   rts
0004D2r 1               
0004D2r 1               ; print the controls line (CTRL_COL, CTRL_ROW)
0004D2r 1               show_ctrl:
0004D2r 1  20 rr rr             jsr     txt_mode
0004D5r 1  A2 13                ldx     #CTRL_COL
0004D7r 1  A0 12                ldy     #CTRL_ROW
0004D9r 1  20 rr rr             jsr     gotoxy
0004DCr 1  AD rr rr             lda     ctrl
0004DFr 1  F0 07                beq     @kb
0004E1r 1  A9 rr                lda     #<ctrl_pad_txt
0004E3r 1  A0 rr                ldy     #>ctrl_pad_txt
0004E5r 1  4C rr rr             jmp     print
0004E8r 1  A9 rr        @kb:    lda     #<ctrl_kb_txt
0004EAr 1  A0 rr                ldy     #>ctrl_kb_txt
0004ECr 1  4C rr rr             jmp     print
0004EFr 1               
0004EFr 1               ; ============================================================================
0004EFr 1               ; start
0004EFr 1               ; ============================================================================
0004EFr 1  D8           start:  cld
0004F0r 1  A2 FF                ldx     #$FF
0004F2r 1  9A                   txs
0004F3r 1  A9 00          lda     #0              ; clear the variables
0004F5r 1  AA                   tax
0004F6r 1  9D rr rr     @clr:   sta     vars_start,x
0004F9r 1  E8                   inx
0004FAr 1  E0 1F                cpx     #vars_end-vars_start
0004FCr 1  D0 F8                bne     @clr
0004FEr 1  A9 5A                lda     #$5A
000500r 1  8D rr rr             sta     rng
000503r 1  AD rr rr             lda     ctrl_def
000506r 1  8D rr rr             sta     ctrl
000509r 1  A9 FF                lda     #$FF
00050Br 1  8D rr rr             sta     attr
00050Er 1  20 rr rr             jsr     sfx_init
000511r 1  AD rr rr             lda     mute_def
000514r 1  8D rr rr             sta     sfx_mute
000517r 1               
000517r 1               ; ---- title screen ----------------------------------------------------------
000517r 1  20 rr rr     title:  jsr     screen_init
00051Ar 1  A9 rr                lda     #<title_txt
00051Cr 1  A0 rr                ldy     #>title_txt
00051Er 1  20 rr rr             jsr     print
000521r 1                       ; a box around the title and a little snake under it, with pixels
000521r 1  A2 38                ldx     #56
000523r 1  A0 04                ldy     #4
000525r 1  A9 30                lda     #48
000527r 1  20 rr rr             jsr     hline
00052Ar 1  A2 38                ldx     #56
00052Cr 1  A0 0F                ldy     #15
00052Er 1  A9 30                lda     #48
000530r 1  20 rr rr             jsr     hline
000533r 1  A2 38                ldx     #56
000535r 1  A0 05                ldy     #5
000537r 1  A9 0A                lda     #10
000539r 1  20 rr rr             jsr     vline
00053Cr 1  A2 67                ldx     #103
00053Er 1  A0 05                ldy     #5
000540r 1  A9 0A                lda     #10
000542r 1  20 rr rr             jsr     vline
000545r 1  A2 00                ldx     #0
000547r 1  8E rr rr     @demo:  stx     tmp2            ; demo snake: cells along a zigzag
00054Ar 1  BD rr rr             lda     demo_x,x
00054Dr 1  BC rr rr             ldy     demo_y,x
000550r 1  AA                   tax
000551r 1  20 rr rr             jsr     draw_cell
000554r 1  AE rr rr             ldx     tmp2
000557r 1  E8                   inx
000558r 1  E0 18                cpx     #DEMO_LEN
00055Ar 1  D0 EB                bne     @demo
00055Cr 1  A2 2C                ldx     #DEMO_FOOD_X
00055Er 1  8E rr rr             stx     food_x
000561r 1  A0 12                ldy     #DEMO_FOOD_Y
000563r 1  8C rr rr             sty     food_y
000566r 1  20 rr rr             jsr     draw_food
000569r 1               
000569r 1  20 rr rr             jsr     show_ctrl
00056Cr 1  20 rr rr             jsr     read_pad
00056Fr 1  20 rr rr     @wait:  jsr     menu_key
000572r 1  C9 51                cmp     #'Q'
000574r 1  D0 03                bne     @notq
000576r 1  4C rr rr             jmp     exit_game
000579r 1  C9 4D        @notq:  cmp     #'M'            ; sound on / off
00057Br 1  D0 06                bne     @notm
00057Dr 1  20 rr rr             jsr     sfx_toggle
000580r 1  4C rr rr             jmp     @wait
000583r 1  C9 47        @notm:  cmp     #'G'            ; switch keyboard / gamepad
000585r 1  D0 0E                bne     @notg
000587r 1  AD rr rr             lda     ctrl
00058Ar 1  49 01                eor     #1
00058Cr 1  8D rr rr             sta     ctrl
00058Fr 1  20 rr rr             jsr     show_ctrl
000592r 1  4C rr rr             jmp     @wait
000595r 1  C9 80        @notg:  cmp     #PAD_GO         ; A or Start on the pad: play with the pad
000597r 1  D0 07                bne     @notp
000599r 1  A9 01                lda     #1
00059Br 1  8D rr rr             sta     ctrl
00059Er 1  D0 04                bne     new_game
0005A0r 1  C9 20        @notp:  cmp     #' '
0005A2r 1  D0 CB                bne     @wait
0005A4r 1               
0005A4r 1               ; ---- new game ----------------------------------------------------------------
0005A4r 1               new_game:
0005A4r 1  20 rr rr             jsr     init_game
0005A7r 1  20 rr rr             jsr     draw_all
0005AAr 1  A9 00                lda     #SND_START
0005ACr 1  20 rr rr             jsr     sfx_snd
0005AFr 1               
0005AFr 1               ; ---- main loop ---------------------------------------------------------------
0005AFr 1               game_loop:
0005AFr 1  20 rr rr             jsr     sfx_poll
0005B2r 1  20 rr rr             jsr     read_keys
0005B5r 1  AD rr rr             lda     quit
0005B8r 1  F0 03                beq     @noquit
0005BAr 1  4C rr rr             jmp     exit_game
0005BDr 1  20 rr rr     @noquit:jsr     step
0005C0r 1  AD rr rr             lda     dead
0005C3r 1  D0 09                bne     game_over
0005C5r 1  AD rr rr             lda     move_delay
0005C8r 1  20 rr rr             jsr     delay_ms
0005CBr 1  4C rr rr             jmp     game_loop
0005CEr 1               
0005CEr 1               ; ---- game over ---------------------------------------------------------------
0005CEr 1               game_over:
0005CEr 1  A9 02                lda     #SND_CRASH
0005D0r 1  20 rr rr             jsr     sfx_snd
0005D3r 1  A9 03                lda     #SND_CRASH2
0005D5r 1  20 rr rr             jsr     sfx_snd
0005D8r 1  A9 06                lda     #6              ; flash the head
0005DAr 1  8D rr rr             sta     tmp3
0005DDr 1  AE rr rr     @flash: ldx     head_x
0005E0r 1  AC rr rr             ldy     head_y
0005E3r 1  AD rr rr             lda     tmp3
0005E6r 1  29 01                and     #1
0005E8r 1  F0 06                beq     @on
0005EAr 1  20 rr rr             jsr     erase_cell
0005EDr 1  4C rr rr             jmp     @w
0005F0r 1  20 rr rr     @on:    jsr     draw_cell
0005F3r 1  A9 78        @w:     lda     #120
0005F5r 1  20 rr rr             jsr     delay_ms
0005F8r 1  CE rr rr             dec     tmp3
0005FBr 1  D0 E0                bne     @flash
0005FDr 1  AD rr rr             lda     score+1         ; new high score?
000600r 1  CD rr rr             cmp     hiscore+1
000603r 1  90 1D                bcc     @nohi
000605r 1  D0 08                bne     @hi
000607r 1  AD rr rr             lda     score
00060Ar 1  CD rr rr             cmp     hiscore
00060Dr 1  90 13                bcc     @nohi
00060Fr 1  AD rr rr     @hi:    lda     score
000612r 1  8D rr rr             sta     hiscore
000615r 1  AD rr rr             lda     score+1
000618r 1  8D rr rr             sta     hiscore+1
00061Br 1  20 rr rr             jsr     show_score
00061Er 1  A9 05                lda     #SND_HI         ; (a new high score: a fanfare)
000620r 1  D0 02                bne     @snd
000622r 1  A9 04        @nohi:  lda     #SND_OVER
000624r 1  20 rr rr     @snd:   jsr     sfx_snd
000627r 1  A9 rr                lda     #<over_txt
000629r 1  A0 rr                ldy     #>over_txt
00062Br 1  20 rr rr             jsr     print
00062Er 1  A9 0A                lda     #10
000630r 1  20 rr rr             jsr     delay_long      ; ignore keys for half a second
000633r 1  20 rr rr             jsr     flush_in
000636r 1  20 rr rr     @wait:  jsr     menu_key
000639r 1  C9 51                cmp     #'Q'
00063Br 1  F0 15                beq     exit_game
00063Dr 1  C9 4D                cmp     #'M'
00063Fr 1  D0 06                bne     @nm
000641r 1  20 rr rr             jsr     sfx_toggle
000644r 1  4C rr rr             jmp     @wait
000647r 1  C9 20        @nm:    cmp     #' '            ; space or the pad's A / Start: play again
000649r 1  F0 04                beq     @again
00064Br 1  C9 80                cmp     #PAD_GO
00064Dr 1  D0 E7                bne     @wait
00064Fr 1  4C rr rr     @again: jmp     new_game
000652r 1               
000652r 1               ; ---- quit ------------------------------------------------------------------
000652r 1               exit_game:
000652r 1  20 rr rr             jsr     sfx_off
000655r 1  A9 rr                lda     #<bye_txt
000657r 1  A0 rr                ldy     #>bye_txt
000659r 1  20 rr rr             jsr     print
00065Cr 1               exit_menu:
00065Cr 1  4C 06 FE             jmp     SBC_MENU        ; back to the boot menu
00065Fr 1               
00065Fr 1               ; ============================================================================
00065Fr 1               ; setup
00065Fr 1               ; ============================================================================
00065Fr 1               screen_init:
00065Fr 1  A9 rr                lda     #<init_txt
000661r 1  A0 rr                ldy     #>init_txt
000663r 1  4C rr rr             jmp     print
000666r 1               
000666r 1               init_game:
000666r 1  A9 00                lda     #0              ; empty grid (14 pages covers 79 x 45)
000668r 1  A0 rr                ldy     #>grid
00066Ar 1  8C rr rr             sty     @st+2
00066Dr 1  AA                   tax
00066Er 1  A0 00        @pg:    ldy     #0
000670r 1  9D rr rr     @st:    sta     grid,x          ; high byte patched for each page
000673r 1  E8                   inx
000674r 1  D0 FA                bne     @st
000676r 1  EE rr rr             inc     @st+2
000679r 1  AD rr rr             lda     @st+2
00067Cr 1  C9 rr                cmp     #>grid + GRID_PAGES
00067Er 1  A9 00                lda     #0
000680r 1  90 EC                bcc     @pg
000682r 1  8D rr rr             sta     score
000685r 1  8D rr rr             sta     score+1
000688r 1  8D rr rr             sta     dead
00068Br 1  8D rr rr             sta     quit
00068Er 1  8D rr rr             sta     kq_n
000691r 1  8D rr rr             sta     esc_st
000694r 1  AD rr rr             lda     speed
000697r 1  8D rr rr             sta     move_delay
00069Ar 1  A9 02                lda     #RIGHT
00069Cr 1  8D rr rr             sta     dir
00069Fr 1                       ; a snake of 4 cells in the middle, heading right
00069Fr 1  A9 25                lda     #37
0006A1r 1  8D rr rr             sta     tail_x
0006A4r 1  A9 16                lda     #22
0006A6r 1  8D rr rr             sta     tail_y
0006A9r 1  8D rr rr             sta     head_y
0006ACr 1  A9 28                lda     #40
0006AEr 1  8D rr rr             sta     head_x
0006B1r 1  A9 25                lda     #37
0006B3r 1  8D rr rr             sta     tmp2
0006B6r 1  AE rr rr     @body:  ldx     tmp2
0006B9r 1  A0 16                ldy     #22
0006BBr 1  20 rr rr             jsr     cell_at
0006BEr 1  A9 02                lda     #RIGHT
0006C0r 1  20 rr rr             jsr     grid_wr
0006C3r 1  EE rr rr             inc     tmp2
0006C6r 1  AD rr rr             lda     tmp2
0006C9r 1  C9 29                cmp     #41
0006CBr 1  D0 E9                bne     @body
0006CDr 1  A9 00                lda     #0
0006CFr 1  8D rr rr             sta     grow
0006D2r 1  4C rr rr             jmp     place_food      ; (only sets food_x/y; drawn by draw_all)
0006D5r 1               
0006D5r 1               draw_all:
0006D5r 1  20 rr rr             jsr     screen_init
0006D8r 1  A9 rr                lda     #<status_txt
0006DAr 1  A0 rr                ldy     #>status_txt
0006DCr 1  20 rr rr             jsr     print
0006DFr 1  20 rr rr             jsr     show_score
0006E2r 1                       ; the border: block graphics characters (rows of them with the
0006E2r 1                       ; repeat count, the sides as two tiles); the bottom right corner
0006E2r 1                       ; with pixels, so the screen can't scroll
0006E2r 1  A9 rr                lda     #<border_txt
0006E4r 1  A0 rr                ldy     #>border_txt
0006E6r 1  20 rr rr             jsr     print
0006E9r 1  A2 9F                ldx     #159
0006EBr 1  A0 5C                ldy     #92
0006EDr 1  A9 04                lda     #4
0006EFr 1  20 rr rr             jsr     vline
0006F2r 1  A2 9E                ldx     #158
0006F4r 1  A0 5F                ldy     #95
0006F6r 1  20 rr rr             jsr     setpix
0006F9r 1                       ; the snake
0006F9r 1  A9 25                lda     #37
0006FBr 1  8D rr rr             sta     tmp2
0006FEr 1  AE rr rr     @body:  ldx     tmp2
000701r 1  A0 16                ldy     #22
000703r 1  20 rr rr             jsr     draw_cell
000706r 1  EE rr rr             inc     tmp2
000709r 1  AD rr rr             lda     tmp2
00070Cr 1  C9 29                cmp     #41
00070Er 1  D0 EE                bne     @body
000710r 1  4C rr rr             jmp     draw_food
000713r 1               
000713r 1               show_score:
000713r 1  20 rr rr             jsr     txt_mode
000716r 1  A2 06                ldx     #6
000718r 1  A0 00                ldy     #0
00071Ar 1  20 rr rr             jsr     gotoxy
00071Dr 1  AD rr rr             lda     score+1
000720r 1  20 rr rr             jsr     prbcd
000723r 1  AD rr rr             lda     score
000726r 1  20 rr rr             jsr     prbcd
000729r 1  A2 26                ldx     #38
00072Br 1  A0 00                ldy     #0
00072Dr 1  20 rr rr             jsr     gotoxy
000730r 1  AD rr rr             lda     hiscore+1
000733r 1  20 rr rr             jsr     prbcd
000736r 1  AD rr rr             lda     hiscore
000739r 1  4C rr rr             jmp     prbcd
00073Cr 1               
00073Cr 1               txt_mode:
00073Cr 1  AD rr rr             lda     attr
00073Fr 1  F0 0F                beq     @done
000741r 1  A9 00                lda     #0
000743r 1  8D rr rr             sta     attr
000746r 1  A9 18                lda     #TC_ATTR
000748r 1  20 03 FE             jsr     putc
00074Br 1  A9 00                lda     #0
00074Dr 1  4C 03 FE             jmp     putc
000750r 1  60           @done:  rts
000751r 1               
000751r 1               ; put the food in a random empty cell
000751r 1               place_food:
000751r 1  20 rr rr     @x:     jsr     rand
000754r 1  29 7F                and     #$7F
000756r 1  C9 4F                cmp     #GW
000758r 1  B0 F7                bcs     @x
00075Ar 1  8D rr rr             sta     food_x
00075Dr 1  20 rr rr     @y:     jsr     rand
000760r 1  29 3F                and     #$3F
000762r 1  C9 2D                cmp     #GH
000764r 1  B0 F7                bcs     @y
000766r 1  8D rr rr             sta     food_y
000769r 1  A8                   tay
00076Ar 1  AE rr rr             ldx     food_x
00076Dr 1  20 rr rr             jsr     cell_at
000770r 1  20 rr rr             jsr     grid_rd
000773r 1  D0 DC                bne     @x              ; on the snake: try again
000775r 1  60                   rts
000776r 1               
000776r 1               ; ============================================================================
000776r 1               ; keyboard.  Turns are queued (up to 2) so that two quick key presses within
000776r 1               ; one move both count, e.g. a U-turn into the next lane.
000776r 1               ; ============================================================================
000776r 1               read_keys:
000776r 1  AD rr rr             lda     ctrl
000779r 1  F0 3D                beq     @l
00077Br 1  20 rr rr             jsr     read_pad        ; gamepad: each new d-pad press is a turn
00077Er 1  AD rr rr             lda     padnew
000781r 1  29 10                and     #PAD_UP
000783r 1  F0 05                beq     @1
000785r 1  A9 01                lda     #UP
000787r 1  20 rr rr             jsr     turn
00078Ar 1  AD rr rr     @1:     lda     padnew
00078Dr 1  29 20                and     #PAD_DOWN
00078Fr 1  F0 05                beq     @2
000791r 1  A9 03                lda     #DOWN
000793r 1  20 rr rr             jsr     turn
000796r 1  AD rr rr     @2:     lda     padnew
000799r 1  29 40                and     #PAD_LEFT
00079Br 1  F0 05                beq     @3
00079Dr 1  A9 04                lda     #LEFT
00079Fr 1  20 rr rr             jsr     turn
0007A2r 1  AD rr rr     @3:     lda     padnew
0007A5r 1  29 80                and     #PAD_RIGHT
0007A7r 1  F0 05                beq     @4
0007A9r 1  A9 02                lda     #RIGHT
0007ABr 1  20 rr rr             jsr     turn
0007AEr 1  AD rr rr     @4:     lda     padnew
0007B1r 1  29 08                and     #PAD_START
0007B3r 1  F0 03                beq     @l
0007B5r 1  20 rr rr             jsr     pad_pause
0007B8r 1  20 00 FE     @l:     jsr     getc
0007BBr 1  90 06                bcc     @done
0007BDr 1  20 rr rr             jsr     handle_key
0007C0r 1  4C rr rr             jmp     @l
0007C3r 1  60           @done:  rts
0007C4r 1               
0007C4r 1               handle_key:
0007C4r 1  AE rr rr             ldx     esc_st          ; ESC [ A..D (or ESC O A..D) are the arrows
0007C7r 1  F0 2C                beq     @plain
0007C9r 1  E0 01                cpx     #1
0007CBr 1  D0 12                bne     @esc2
0007CDr 1  C9 5B                cmp     #'['
0007CFr 1  F0 0A                beq     @br
0007D1r 1  C9 4F                cmp     #'O'
0007D3r 1  F0 06                beq     @br
0007D5r 1  A9 00                lda     #0
0007D7r 1  8D rr rr             sta     esc_st
0007DAr 1  60                   rts
0007DBr 1  EE rr rr     @br:    inc     esc_st
0007DEr 1  60                   rts
0007DFr 1  A2 00        @esc2:  ldx     #0
0007E1r 1  8E rr rr             stx     esc_st
0007E4r 1  C9 41                cmp     #'A'
0007E6r 1  F0 42                beq     @up
0007E8r 1  C9 42                cmp     #'B'
0007EAr 1  F0 42                beq     @down
0007ECr 1  C9 43                cmp     #'C'
0007EEr 1  F0 42                beq     @right
0007F0r 1  C9 44                cmp     #'D'
0007F2r 1  F0 42                beq     @left
0007F4r 1  60                   rts
0007F5r 1  C9 1B        @plain: cmp     #$1B
0007F7r 1  D0 04                bne     @np
0007F9r 1  EE rr rr             inc     esc_st
0007FCr 1  60                   rts
0007FDr 1  AE rr rr     @np:    ldx     ctrl            ; gamepad mode: ignore what the pad types
000800r 1  F0 06                beq     @kb
000802r 1  20 rr rr             jsr     pad_typed
000805r 1  90 01                bcc     @kb
000807r 1  60                   rts
000808r 1  29 DF        @kb:    and     #$DF            ; letters to upper case
00080Ar 1  C9 57                cmp     #'W'
00080Cr 1  F0 1C                beq     @up
00080Er 1  C9 53                cmp     #'S'
000810r 1  F0 1C                beq     @down
000812r 1  C9 44                cmp     #'D'
000814r 1  F0 1C                beq     @right
000816r 1  C9 41                cmp     #'A'
000818r 1  F0 1C                beq     @left
00081Ar 1  C9 51                cmp     #'Q'
00081Cr 1  F0 1C                beq     @quit
00081Er 1  C9 50                cmp     #'P'
000820r 1  F0 1E                beq     @pause
000822r 1  C9 4D                cmp     #'M'
000824r 1  D0 03                bne     @r
000826r 1  4C rr rr             jmp     sfx_toggle
000829r 1  60           @r:     rts
00082Ar 1  A9 01        @up:    lda     #UP
00082Cr 1  D0 30                bne     turn
00082Er 1  A9 03        @down:  lda     #DOWN
000830r 1  D0 2C                bne     turn
000832r 1  A9 02        @right: lda     #RIGHT
000834r 1  D0 28                bne     turn
000836r 1  A9 04        @left:  lda     #LEFT
000838r 1  D0 24                bne     turn
00083Ar 1  A9 01        @quit:  lda     #1
00083Cr 1  8D rr rr             sta     quit
00083Fr 1  60                   rts
000840r 1  20 rr rr     @pause: jsr     sfx_hush        ; (quiet while paused)
000843r 1  20 00 FE     @pw:    jsr     getc            ; wait for any key
000846r 1  90 FB                bcc     @pw
000848r 1  60                   rts
000849r 1               
000849r 1               ; pause until Start is pressed again (or a key)
000849r 1               pad_pause:
000849r 1  20 rr rr             jsr     sfx_hush
00084Cr 1  20 rr rr     @l:     jsr     read_pad
00084Fr 1  AD rr rr             lda     padnew
000852r 1  29 08                and     #PAD_START
000854r 1  D0 05                bne     @done
000856r 1  20 00 FE             jsr     getc
000859r 1  90 F1                bcc     @l
00085Br 1  4C rr rr     @done:  jmp     flush_in
00085Er 1               
00085Er 1               ; queue a turn to direction A, unless it is the way the snake (or the last
00085Er 1               ; queued turn) is already going, or straight back
00085Er 1  8D rr rr     turn:   sta     tmp
000861r 1  AE rr rr             ldx     kq_n
000864r 1  E0 02                cpx     #2
000866r 1  B0 21                bcs     @done           ; queue full
000868r 1  AD rr rr             lda     dir
00086Br 1  E0 00                cpx     #0
00086Dr 1  F0 03                beq     @cmp
00086Fr 1  BD rr rr             lda     kq-1,x          ; last queued turn
000872r 1  CD rr rr     @cmp:   cmp     tmp
000875r 1  F0 12                beq     @done           ; same way
000877r 1  A8                   tay
000878r 1  B9 rr rr             lda     opposite,y
00087Br 1  CD rr rr             cmp     tmp
00087Er 1  F0 09                beq     @done           ; reverse
000880r 1  AD rr rr             lda     tmp
000883r 1  9D rr rr             sta     kq,x
000886r 1  EE rr rr             inc     kq_n
000889r 1  60           @done:  rts
00088Ar 1               
00088Ar 1               ; ============================================================================
00088Ar 1               ; one move
00088Ar 1               ; ============================================================================
00088Ar 1  AD rr rr     step:   lda     kq_n            ; take a queued turn
00088Dr 1  F0 0F                beq     @go
00088Fr 1  AD rr rr             lda     kq
000892r 1  8D rr rr             sta     dir
000895r 1  AD rr rr             lda     kq+1
000898r 1  8D rr rr             sta     kq
00089Br 1  CE rr rr             dec     kq_n
00089Er 1  AE rr rr     @go:    ldx     dir             ; the new head position
0008A1r 1  AD rr rr             lda     head_x
0008A4r 1  18                   clc
0008A5r 1  7D rr rr             adc     dx,x
0008A8r 1  C9 4F                cmp     #GW             ; (-1 is $FF, also >= GW)
0008AAr 1  B0 0E                bcs     @wall
0008ACr 1  8D rr rr             sta     new_x
0008AFr 1  AD rr rr             lda     head_y
0008B2r 1  18                   clc
0008B3r 1  7D rr rr             adc     dy,x
0008B6r 1  C9 2D                cmp     #GH
0008B8r 1  90 03                bcc     @iny
0008BAr 1  4C rr rr     @wall:  jmp     @crash
0008BDr 1  8D rr rr     @iny:   sta     new_y
0008C0r 1  AD rr rr             lda     new_x           ; food?
0008C3r 1  CD rr rr             cmp     food_x
0008C6r 1  D0 0B                bne     @nofood
0008C8r 1  AD rr rr             lda     new_y
0008CBr 1  CD rr rr             cmp     food_y
0008CEr 1  D0 03                bne     @nofood
0008D0r 1  20 rr rr             jsr     eat
0008D3r 1  AD rr rr     @nofood:lda     grow            ; growing: the tail stays where it is
0008D6r 1  F0 06                beq     @tail
0008D8r 1  CE rr rr             dec     grow
0008DBr 1  4C rr rr             jmp     @check
0008DEr 1  AE rr rr     @tail:  ldx     tail_x          ; move the tail first, so the head may move
0008E1r 1  AC rr rr             ldy     tail_y          ; into the cell the tail just left
0008E4r 1  20 rr rr             jsr     cell_at
0008E7r 1  20 rr rr             jsr     grid_rd
0008EAr 1  8D rr rr             sta     tmp             ; its direction to the next segment
0008EDr 1  A9 00                lda     #0
0008EFr 1  20 rr rr             jsr     grid_wr
0008F2r 1  20 rr rr             jsr     erase_cell
0008F5r 1  AE rr rr             ldx     tmp
0008F8r 1  AD rr rr             lda     tail_x
0008FBr 1  18                   clc
0008FCr 1  7D rr rr             adc     dx,x
0008FFr 1  8D rr rr             sta     tail_x
000902r 1  AD rr rr             lda     tail_y
000905r 1  18                   clc
000906r 1  7D rr rr             adc     dy,x
000909r 1  8D rr rr             sta     tail_y
00090Cr 1  AE rr rr     @check: ldx     new_x           ; ran into itself?
00090Fr 1  AC rr rr             ldy     new_y
000912r 1  20 rr rr             jsr     cell_at
000915r 1  20 rr rr             jsr     grid_rd
000918r 1  D0 26                bne     @crash
00091Ar 1  AD rr rr             lda     dir             ; mark the new head (its direction is
00091Dr 1  20 rr rr             jsr     grid_wr         ; rewritten on the next move) ...
000920r 1  AE rr rr             ldx     head_x          ; ... and link the old head to it
000923r 1  AC rr rr             ldy     head_y
000926r 1  20 rr rr             jsr     cell_at
000929r 1  AD rr rr             lda     dir
00092Cr 1  20 rr rr             jsr     grid_wr
00092Fr 1  AD rr rr             lda     new_x
000932r 1  8D rr rr             sta     head_x
000935r 1  AA                   tax
000936r 1  AD rr rr             lda     new_y
000939r 1  8D rr rr             sta     head_y
00093Cr 1  A8                   tay
00093Dr 1  4C rr rr             jmp     draw_cell
000940r 1  A9 01        @crash: lda     #1
000942r 1  8D rr rr             sta     dead
000945r 1  60                   rts
000946r 1               
000946r 1               ; the head is about to move onto the food
000946r 1  A9 01        eat:    lda     #SND_EAT
000948r 1  20 rr rr             jsr     sfx_snd
00094Br 1  AD rr rr             lda     grow
00094Er 1  18                   clc
00094Fr 1  69 03                adc     #GROW_PER_FOOD
000951r 1  8D rr rr             sta     grow
000954r 1  F8                   sed                     ; 10 points per food
000955r 1  AD rr rr             lda     score
000958r 1  18                   clc
000959r 1  69 10                adc     #$10
00095Br 1  8D rr rr             sta     score
00095Er 1  AD rr rr             lda     score+1
000961r 1  69 00                adc     #0
000963r 1  8D rr rr             sta     score+1
000966r 1  D8                   cld
000967r 1  20 rr rr             jsr     show_score
00096Ar 1  AD rr rr             lda     speed           ; speed up: delay - 2, but not below speed/3
00096Dr 1  4A                   lsr
00096Er 1  4A                   lsr
00096Fr 1  8D rr rr             sta     tmp
000972r 1  4A                   lsr
000973r 1  4A                   lsr
000974r 1  6D rr rr             adc     tmp             ; ~ speed * 5/16 ...
000977r 1  8D rr rr             sta     tmp
00097Ar 1  AD rr rr             lda     move_delay
00097Dr 1  38                   sec
00097Er 1  E9 02                sbc     #2
000980r 1  90 05                bcc     @min
000982r 1  CD rr rr             cmp     tmp
000985r 1  B0 03                bcs     @ok
000987r 1  AD rr rr     @min:   lda     tmp
00098Ar 1  8D rr rr     @ok:    sta     move_delay
00098Dr 1  20 rr rr             jsr     place_food      ; the new food (the head cell is still empty
000990r 1  AD rr rr             lda     food_x          ; in the grid, so make sure it's not there)
000993r 1  CD rr rr             cmp     new_x
000996r 1  D0 08                bne     @draw
000998r 1  AD rr rr             lda     food_y
00099Br 1  CD rr rr             cmp     new_y
00099Er 1  F0 03                beq     eat_again
0009A0r 1  4C rr rr     @draw:  jmp     draw_food
0009A3r 1               eat_again:
0009A3r 1  20 rr rr             jsr     place_food
0009A6r 1  AD rr rr             lda     food_x
0009A9r 1  CD rr rr             cmp     new_x
0009ACr 1  D0 08                bne     @d
0009AEr 1  AD rr rr             lda     food_y
0009B1r 1  CD rr rr             cmp     new_y
0009B4r 1  F0 ED                beq     eat_again
0009B6r 1  4C rr rr     @d:     jmp     draw_food
0009B9r 1               
