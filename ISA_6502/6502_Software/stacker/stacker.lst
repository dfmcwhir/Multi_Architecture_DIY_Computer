0006A1r 1  A9 0A                lda     #10
0006A3r 1  8D rr rr             sta     to_next
0006A6r 1  20 rr rr             jsr     screen_setup
0006A9r 1  20 rr rr             jsr     bag_next
0006ACr 1  8D rr rr             sta     next
0006AFr 1  20 rr rr             jsr     spawn
0006B2r 1  20 rr rr             jsr     show_stats
0006B5r 1  20 rr rr             jsr     sfx_off         ; the music
0006B8r 1  A9 00                lda     #MUS_THEME
0006BAr 1  20 rr rr             jsr     sfx_snd
