00048Er 1  90 02                bcc     @n
000490r 1  49 B4                eor     #$B4
000492r 1  8D rr rr     @n:     sta     rng+1
000495r 1  4D rr rr             eor     rng
000498r 1  60                   rts
000499r 1               
000499r 1               ; wait about A ms.  The inner loop is sized for the clock (CLOCK_MHZ in
000499r 1               ; sbc_api.inc): 5 + 4 * (CLOCK_MHZ - 1) cycles a turn, DELAY_N turns a ms.
000499r 1               DELAY_N = (1000 * CLOCK_MHZ - 7) / (5 + 4 * (CLOCK_MHZ - 1))
000499r 1               delay_ms:
000499r 1  AA                   tax
00049Ar 1  F0 0D                beq     @done
00049Cr 1  20 rr rr     @o:     jsr     sfx_poll        ; (the sound goes on while waiting)
00049Fr 1  A0 DD                ldy     #DELAY_N
0004A1r 1               @i:
0004A1r 1  EA EA        .repeat CLOCK_MHZ - 1           ; (4 more cycles a turn for each MHz above 1)
0004A3r 1                       nop
0004A3r 1                       nop
0004A3r 1               .endrepeat
0004A3r 1  88                   dey
0004A4r 1  D0 FB                bne     @i
0004A6r 1  CA                   dex
0004A7r 1  D0 F3                bne     @o
0004A9r 1  60           @done:  rts
0004AAr 1               
0004AAr 1               ; wait about A x 50 ms
0004AAr 1               delay_long:
0004AAr 1  8D rr rr             sta     tmp
0004ADr 1  A9 32        @l:     lda     #50
0004AFr 1  20 rr rr             jsr     delay_ms
0004B2r 1  20 rr rr             jsr     flush_in        ; keys pressed meanwhile are dropped (so the
0004B5r 1  CE rr rr             dec     tmp             ; ROM's keyboard buffer never fills up)
0004B8r 1  D0 F3                bne     @l
0004BAr 1  60                   rts
0004BBr 1               
0004BBr 1               .macro MENU_IDLE
0004BBr 1                       jsr     rand            ; (waiting for a key stirs the random numbers)
0004BBr 1                       jsr     sfx_poll
0004BBr 1               .endmacro
0004BBr 1               CTRL_COL        = 19
0004BBr 1               CTRL_ROW        = 18
0004BBr 1               
0004BBr 1               ; ============================================================================
0004BBr 1               ; gamepad and menu input (shared by the SBC games)
0004BBr 1               ; ============================================================================
0004BBr 1               PAD_A           = $01           ; bits returned by SBC_PADSTATE
0004BBr 1               PAD_B           = $02
0004BBr 1               PAD_SELECT      = $04
0004BBr 1               PAD_START       = $08
0004BBr 1               PAD_UP          = $10
0004BBr 1               PAD_DOWN        = $20
0004BBr 1               PAD_LEFT        = $40
0004BBr 1               PAD_RIGHT       = $80
0004BBr 1               PAD_GO          = $80           ; menu_key's answer for gamepad A or Start
0004BBr 1               
0004BBr 1               ; read the gamepad: pad = buttons held now, padnew = buttons pressed since
0004BBr 1               ; the last call.  Preserves X and Y (SBC_PADSTATE only changes A).
0004BBr 1               read_pad:
0004BBr 1  20 12 FE             jsr     SBC_PADSTATE
0004BEr 1  C9 FF                cmp     #$FF            ; every button "pressed" = no pad
0004C0r 1  D0 02                bne     @ok
0004C2r 1  A9 00                lda     #0
0004C4r 1  8D rr rr     @ok:    sta     pad
0004C7r 1  AD rr rr             lda     padold
0004CAr 1  49 FF                eor     #$FF
0004CCr 1  2D rr rr             and     pad
0004CFr 1  8D rr rr             sta     padnew
0004D2r 1  AD rr rr             lda     pad
0004D5r 1  8D rr rr             sta     padold
0004D8r 1  60                   rts
0004D9r 1               
0004D9r 1               ; throw away waiting characters
0004D9r 1               flush_in:
0004D9r 1  20 00 FE             jsr     getc
0004DCr 1  B0 FB                bcs     flush_in
0004DEr 1  60                   rts
0004DFr 1               
0004DFr 1               ; carry set if A is one of the characters the gamepad driver types for the
0004DFr 1               ; pad (W A S D and space).  Those are ignored in gamepad mode so that one
0004DFr 1               ; press doesn't act twice.  Preserves A.
0004DFr 1               pad_typed:
0004DFr 1  C9 20                cmp     #' '
0004E1r 1  F0 12                beq     @y
0004E3r 1  C9 57                cmp     #'W'
0004E5r 1  F0 0E                beq     @y
0004E7r 1  C9 41                cmp     #'A'
0004E9r 1  F0 0A                beq     @y
0004EBr 1  C9 53                cmp     #'S'
0004EDr 1  F0 06                beq     @y
0004EFr 1  C9 44                cmp     #'D'
0004F1r 1  F0 02                beq     @y
0004F3r 1  18                   clc
0004F4r 1  60                   rts
0004F5r 1  38           @y:     sec
0004F6r 1  60                   rts
0004F7r 1               
0004F7r 1               ; wait for a menu choice.  Returns a key (letters in upper case), or
0004F7r 1               ; PAD_GO for the gamepad's A or Start button.
0004F7r 1               menu_key:
0004F7r 1  20 rr rr 20  @l:     MENU_IDLE
0004FBr 1  rr rr        
0004FDr 1  20 rr rr             jsr     read_pad
000500r 1  AD rr rr             lda     padnew
000503r 1  29 09                and     #PAD_A | PAD_START
000505r 1  D0 21                bne     @pad
000507r 1  20 00 FE             jsr     getc
00050Ar 1  90 EB                bcc     @l
00050Cr 1  C9 20                cmp     #' '            ; a space typed by the pad's A button?
00050Er 1  D0 0D                bne     @up
000510r 1  20 rr rr             jsr     read_pad
000513r 1  AD rr rr             lda     pad
000516r 1  29 01                and     #PAD_A
000518r 1  D0 0E                bne     @pad
00051Ar 1  A9 20                lda     #' '
00051Cr 1  60                   rts
00051Dr 1  C9 61        @up:    cmp     #'a'
00051Fr 1  90 06                bcc     @r
000521r 1  C9 7B                cmp     #'z'+1
000523r 1  B0 02                bcs     @r
000525r 1  29 DF                and     #$DF
000527r 1  60           @r:     rts
000528r 1  20 rr rr     @pad:   jsr     flush_in        ; the space the driver typed for it
00052Br 1  A9 80                lda     #PAD_GO
00052Dr 1  60                   rts
00052Er 1               
00052Er 1               ; print the controls line (CTRL_COL, CTRL_ROW)
00052Er 1               show_ctrl:
00052Er 1  20 rr rr             jsr     txt_mode
000531r 1  A2 13                ldx     #CTRL_COL
000533r 1  A0 12                ldy     #CTRL_ROW
000535r 1  20 rr rr             jsr     gotoxy
000538r 1  AD rr rr             lda     ctrl
00053Br 1  F0 07                beq     @kb
00053Dr 1  A9 rr                lda     #<ctrl_pad_txt
00053Fr 1  A0 rr                ldy     #>ctrl_pad_txt
000541r 1  4C rr rr             jmp     print
000544r 1  A9 rr        @kb:    lda     #<ctrl_kb_txt
000546r 1  A0 rr                ldy     #>ctrl_kb_txt
000548r 1  4C rr rr             jmp     print
00054Br 1               
00054Br 1               ; ============================================================================
00054Br 1               ; start, title
00054Br 1               ; ============================================================================
00054Br 1  D8           start:  cld
00054Cr 1  A2 FF                ldx     #$FF
00054Er 1  9A                   txs
00054Fr 1  A9 00                lda     #0              ; clear the variables (RAM is random at power-up)
000551r 1  AA                   tax
000552r 1  A0 03                ldy     #>(bss_end - bss_start + $FF)
000554r 1  9D rr rr     @c1:    sta     bss_start,x
000557r 1  E8                   inx
000558r 1  D0 FA                bne     @c1
00055Ar 1  EE rr rr             inc     @c1+2
00055Dr 1  88                   dey
00055Er 1  D0 F4                bne     @c1
000560r 1  AD rr rr             lda     ctrl_def
000563r 1  8D rr rr             sta     ctrl
000566r 1  A9 5A                lda     #$5A
000568r 1  8D rr rr             sta     rng
00056Br 1  A9 FF                lda     #$FF
00056Dr 1  8D rr rr             sta     attr
000570r 1  20 rr rr             jsr     sfx_init
000573r 1  AD rr rr             lda     mute_def
000576r 1  8D rr rr             sta     sfx_mute
000579r 1               
000579r 1  20 rr rr     title:  jsr     sfx_off
00057Cr 1  A9 rr                lda     #<cls_txt
00057Er 1  A0 rr                ldy     #>cls_txt
000580r 1  20 rr rr             jsr     print
000583r 1  A9 rr                lda     #<title_txt
000585r 1  A0 rr                ldy     #>title_txt
000587r 1  20 rr rr             jsr     print
00058Ar 1  20 rr rr             jsr     def_tiles
00058Dr 1  20 rr rr             jsr     draw_banner
000590r 1  20 rr rr             jsr     show_start_level
000593r 1  20 rr rr             jsr     show_hiscore_title
000596r 1  20 rr rr             jsr     show_ctrl
000599r 1  20 rr rr             jsr     read_pad
00059Cr 1  20 rr rr             jsr     flush_in
00059Fr 1  20 rr rr     @wait:  jsr     menu_key
0005A2r 1  C9 51                cmp     #'Q'
0005A4r 1  D0 03                bne     @notq
0005A6r 1  4C rr rr             jmp     exit_game
0005A9r 1  C9 4D        @notq:  cmp     #'M'            ; sound on / off
0005ABr 1  D0 06                bne     @notm
0005ADr 1  20 rr rr             jsr     sfx_toggle
0005B0r 1  4C rr rr             jmp     @wait
0005B3r 1  C9 47        @notm:  cmp     #'G'            ; switch keyboard / gamepad
0005B5r 1  D0 0E                bne     @notg
0005B7r 1  AD rr rr             lda     ctrl
0005BAr 1  49 01                eor     #1
0005BCr 1  8D rr rr             sta     ctrl
0005BFr 1  20 rr rr             jsr     show_ctrl
0005C2r 1  4C rr rr             jmp     @wait
0005C5r 1  C9 80        @notg:  cmp     #PAD_GO         ; A or Start on the pad: play with the pad
0005C7r 1  D0 08                bne     @notp
0005C9r 1  A9 01                lda     #1
0005CBr 1  8D rr rr             sta     ctrl
0005CEr 1  4C rr rr             jmp     new_game
0005D1r 1  C9 20        @notp:  cmp     #' '
0005D3r 1  D0 03                bne     @digit
0005D5r 1  4C rr rr             jmp     new_game
0005D8r 1  C9 30        @digit: cmp     #'0'            ; 0..9: the starting level
0005DAr 1  90 C3                bcc     @wait
0005DCr 1  C9 3A                cmp     #'9'+1
0005DEr 1  B0 BF                bcs     @wait
0005E0r 1  29 0F                and     #$0F
0005E2r 1  8D rr rr             sta     start_level
0005E5r 1  20 rr rr             jsr     show_start_level
0005E8r 1  4C rr rr             jmp     @wait
0005EBr 1               
0005EBr 1               ; the title banner, made of squares
0005EBr 1               draw_banner:
0005EBr 1  20 rr rr             jsr     gfx_mode
0005EEr 1  A9 rr                lda     #<banner
0005F0r 1  8D rr rr             sta     @rd+1
0005F3r 1  A9 rr                lda     #>banner
0005F5r 1  8D rr rr             sta     @rd+2
0005F8r 1  A0 02                ldy     #2              ; text row
0005FAr 1  8C rr rr     @row:   sty     tmp2
0005FDr 1  A2 0D                ldx     #40 - BANNER_W
0005FFr 1  20 rr rr             jsr     gotoxy
000602r 1  A9 1B                lda     #BANNER_W
000604r 1  8D rr rr             sta     tmp3
000607r 1               @sq:
000607r 1  AD FF FF     @rd:    lda     $FFFF
00060Ar 1  20 rr rr             jsr     put_glyph
00060Dr 1  EE rr rr             inc     @rd+1
000610r 1  D0 03                bne     @n
000612r 1  EE rr rr             inc     @rd+2
000615r 1  CE rr rr     @n:     dec     tmp3
000618r 1  D0 ED                bne     @sq
00061Ar 1  AC rr rr             ldy     tmp2
00061Dr 1  C8                   iny
00061Er 1  C0 07                cpy     #2 + BANNER_H
000620r 1  D0 D8                bne     @row
000622r 1  60                   rts
000623r 1               
000623r 1               show_start_level:
000623r 1  20 rr rr             jsr     txt_mode
000626r 1  A2 30                ldx     #48
000628r 1  A0 0F                ldy     #15
00062Ar 1  20 rr rr             jsr     gotoxy
00062Dr 1  AD rr rr             lda     start_level
000630r 1  18                   clc
000631r 1  69 30                adc     #'0'
000633r 1  4C 03 FE             jmp     putc
000636r 1               
000636r 1               show_hiscore_title:
000636r 1  20 rr rr             jsr     txt_mode
000639r 1  A2 22                ldx     #34
00063Br 1  A0 15                ldy     #21
00063Dr 1  20 rr rr             jsr     gotoxy
000640r 1  A9 rr                lda     #<hi_txt
000642r 1  A0 rr                ldy     #>hi_txt
000644r 1  20 rr rr             jsr     print
000647r 1  4C rr rr             jmp     pr_hiscore
00064Ar 1               
00064Ar 1               pr_hiscore:
00064Ar 1  AD rr rr             lda     hiscore+2
00064Dr 1  20 rr rr             jsr     prbcd
000650r 1  AD rr rr             lda     hiscore+1
000653r 1  20 rr rr             jsr     prbcd
000656r 1  AD rr rr             lda     hiscore
000659r 1  4C rr rr             jmp     prbcd
00065Cr 1               
00065Cr 1               exit_game:
00065Cr 1  20 rr rr             jsr     sfx_off
00065Fr 1  A9 rr                lda     #<bye_txt
000661r 1  A0 rr                ldy     #>bye_txt
000663r 1  20 rr rr             jsr     print
000666r 1  4C 06 FE             jmp     SBC_MENU        ; back to the boot menu
000669r 1               
000669r 1               ; ============================================================================
000669r 1               ; a game
000669r 1               ; ============================================================================
000669r 1               new_game:
000669r 1  A9 00                lda     #0
00066Br 1  A2 DB                ldx     #BW * BH - 1    ; empty board
00066Dr 1  9D rr rr     @b:     sta     board,x
000670r 1  CA                   dex
000671r 1  E0 FF                cpx     #$FF
000673r 1  D0 F8                bne     @b
000675r 1  A2 C7                ldx     #VIS - 1        ; the terminal shows nothing yet
000677r 1  A9 FF                lda     #$FF
000679r 1  9D rr rr     @s:     sta     shown,x
00067Cr 1  CA                   dex
00067Dr 1  E0 FF                cpx     #$FF
00067Fr 1  D0 F8                bne     @s
000681r 1  A9 00                lda     #0
000683r 1  8D rr rr             sta     score
