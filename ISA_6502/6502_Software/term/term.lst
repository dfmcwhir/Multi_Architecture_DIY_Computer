000890r 1  BD rr rr             lda     lcmd_adr+1,x
000893r 1  48                   pha
000894r 1  BD rr rr             lda     lcmd_adr,x
000897r 1  48                   pha
000898r 1  60                   rts                     ; (to it: its address - 1 was pushed)
000899r 1               
000899r 1  44 58 53 45  lcmd_chr:   .byte   "DXSELCKZAH?Q", 1
00089Dr 1  4C 43 4B 5A  
0008A1r 1  41 48 3F 51  
0008A6r 1               N_LCMD      = * - lcmd_chr
0008A6r 1  rr rr rr rr  lcmd_adr:   .word   dial-1, hangup-1, setup-1, t_echo-1, t_lf-1, t_cmap-1
0008AAr 1  rr rr rr rr  
0008AEr 1  rr rr rr rr  
0008B2r 1  rr rr rr rr              .word   t_bs-1, clear-1, send_ca-1, help-1, help-1, quit-1, send_ca-1
0008B6r 1  rr rr rr rr  
0008BAr 1  rr rr rr rr  
0008C0r 1               
0008C0r 1               ; "[TERM: " ... "]" on a line of its own: the text at A/Y
0008C0r 1  48           msg:    pha
0008C1r 1  98                   tya
0008C2r 1  48                   pha
0008C3r 1  A9 rr                lda     #<msg_txt
0008C5r 1  A0 rr                ldy     #>msg_txt
0008C7r 1  20 rr rr             jsr     dprint
0008CAr 1  68                   pla
0008CBr 1  A8                   tay
0008CCr 1  68                   pla
0008CDr 1  4C rr rr             jmp     dprint
0008D0r 1  A9 rr        msg_end:lda     #<end_txt
0008D2r 1  A0 rr                ldy     #>end_txt
0008D4r 1  4C rr rr             jmp     dprint
0008D7r 1               
0008D7r 1  A9 01        send_ca:lda     #1
0008D9r 1  4C rr rr             jmp     mdm_out
0008DCr 1               
0008DCr 1  A9 0C        clear:  lda     #12
0008DEr 1  4C rr rr             jmp     dout
0008E1r 1               
0008E1r 1  A9 rr        help:   lda     #<help_txt
0008E3r 1  A0 rr                ldy     #>help_txt
0008E5r 1  4C rr rr             jmp     dprint
0008E8r 1               
0008E8r 1               ; on/off settings: show the new state
0008E8r 1  A2 00        t_echo: ldx     #echo - flags
0008EAr 1  A9 rr                lda     #<echo_txt
0008ECr 1  A0 rr                ldy     #>echo_txt
0008EEr 1  D0 16                bne     toggle
0008F0r 1  A2 01        t_lf:   ldx     #addlf - flags
0008F2r 1  A9 rr                lda     #<lf_txt
0008F4r 1  A0 rr                ldy     #>lf_txt
0008F6r 1  D0 0E                bne     toggle
0008F8r 1  A2 02        t_cmap: ldx     #cmap - flags
0008FAr 1  A9 rr                lda     #<cmap_txt
0008FCr 1  A0 rr                ldy     #>cmap_txt
0008FEr 1  D0 06                bne     toggle
000900r 1  A2 03        t_bs:   ldx     #bs_swap - flags
000902r 1  A9 rr                lda     #<bs_txt
000904r 1  A0 rr                ldy     #>bs_txt
000906r 1  20 rr rr     toggle: jsr     msg
000909r 1  BD rr rr             lda     flags,x
00090Cr 1  49 01                eor     #1
00090Er 1  9D rr rr             sta     flags,x
000911r 1  D0 0A                bne     @on
000913r 1  A9 rr                lda     #<off_txt
000915r 1  A0 rr                ldy     #>off_txt
000917r 1  20 rr rr             jsr     dprint
00091Ar 1  4C rr rr             jmp     msg_end
00091Dr 1  A9 rr        @on:    lda     #<on_txt
00091Fr 1  A0 rr                ldy     #>on_txt
000921r 1  20 rr rr             jsr     dprint
000924r 1  4C rr rr             jmp     msg_end
000927r 1               
000927r 1               ; ---- the serial port ----------------------------------------------------------------------
000927r 1               ; the 6551 as the settings say.  Control: the rate, its own clock (RCS), the
000927r 1               ; data bits, the stop bits.  Command: the parity, RTS, receive IRQ on, DTR.
000927r 1               apply_port:
000927r 1  AE rr rr             ldx     baud_i
00092Ar 1  BD rr rr             lda     baud_codes,x
00092Dr 1  09 10                ora     #$10
00092Fr 1  AC rr rr             ldy     data_i
000932r 1  19 rr rr             ora     data_bits,y
000935r 1  AC rr rr             ldy     stop_i
000938r 1  F0 02                beq     :+
00093Ar 1  09 80                ora     #$80
00093Cr 1  8D 17 7F     :       sta     MDM_CTRL
00093Fr 1  BD rr rr             lda     txn_l,x
000942r 1  8D rr rr             sta     txn_lo
000945r 1  BD rr rr             lda     txn_h,x
000948r 1  8D rr rr             sta     txn_hi
00094Br 1  A9 01                lda     #1
00094Dr 1  8D rr rr             sta     rts_now
000950r 1                       ; (on)
000950r 1               ; the command register: parity, RTS (on, off, or as flow control says), DTR
000950r 1               put_cmd:
000950r 1  AC rr rr             ldy     par_i
000953r 1  B9 rr rr             lda     par_bits,y
000956r 1  0D rr rr             ora     dtr             ; (bit 0: DTR on)
000959r 1  AE rr rr             ldx     rts_i
00095Cr 1  F0 09                beq     @on
00095Er 1  E0 01                cpx     #1
000960r 1  F0 07                beq     @w
000962r 1  AE rr rr             ldx     rts_now
000965r 1  F0 02                beq     @w
000967r 1  09 08        @on:    ora     #$08            ; (TIC = 10: RTS asserted, no transmit IRQ)
000969r 1  8D 16 7F     @w:     sta     MDM_CMD
00096Cr 1  60                   rts
00096Dr 1               
00096Dr 1               ; RTS flow control: let go at FLOW_OFF bytes waiting, assert under FLOW_ON
00096Dr 1  A5 E3        flow:   lda     ROM_WP
00096Fr 1  38                   sec
000970r 1  E5 E2                sbc     ROM_RP
000972r 1  AE rr rr             ldx     rts_now
000975r 1  D0 0C                bne     @on
000977r 1  C9 40                cmp     #FLOW_ON        ; let go: assert again?
000979r 1  B0 14                bcs     @r
00097Br 1  A9 01                lda     #1
00097Dr 1  8D rr rr             sta     rts_now
000980r 1  4C rr rr             jmp     put_cmd
000983r 1  C9 C0        @on:    cmp     #FLOW_OFF       ; asserted: let go?
000985r 1  90 08                bcc     @r
000987r 1  A9 00                lda     #0
000989r 1  8D rr rr             sta     rts_now
00098Cr 1  4C rr rr             jmp     put_cmd
00098Fr 1  60           @r:     rts
000990r 1               
000990r 1               ; "[TERM: 1200 8N1]" (with ", RTS FLOW" when it is)
000990r 1               show_port:
000990r 1  A9 20                lda     #' '
000992r 1  8D rr rr             sta     psep
000995r 1  A9 rr                lda     #<port_txt0
000997r 1  A0 rr                ldy     #>port_txt0
000999r 1  20 rr rr             jsr     msg
00099Cr 1  20 rr rr             jsr     port_out
00099Fr 1  AD rr rr             lda     rts_i
0009A2r 1  C9 02                cmp     #2
0009A4r 1  D0 07                bne     :+
0009A6r 1  A9 rr                lda     #<flow_txt
0009A8r 1  A0 rr                ldy     #>flow_txt
0009AAr 1  20 rr rr             jsr     dprint
0009ADr 1  4C rr rr     :       jmp     msg_end
0009B0r 1               
0009B0r 1               ; the rate and format, as "1200 8N1", to the screen (dout) or, after
0009B0r 1               ; port_to = 1, the Zimodem as "1200,8N1"
0009B0r 1               port_out:
0009B0r 1  AE rr rr             ldx     baud_i
0009B3r 1  20 rr rr             jsr     baud_str
0009B6r 1  20 rr rr             jsr     to_dprint
0009B9r 1  AD rr rr             lda     psep            ; (" " or "," in an ATB)
0009BCr 1  20 rr rr             jsr     to_out
0009BFr 1  A9 38                lda     #'8'
0009C1r 1  38                   sec
0009C2r 1  ED rr rr             sbc     data_i
0009C5r 1  20 rr rr             jsr     to_out
0009C8r 1  AE rr rr             ldx     par_i
0009CBr 1  BD rr rr             lda     par_chr,x
0009CEr 1  20 rr rr             jsr     to_out
0009D1r 1  AD rr rr             lda     stop_i
0009D4r 1  18                   clc
0009D5r 1  69 31                adc     #'1'
0009D7r 1                       ; (on)
0009D7r 1  AE rr rr     to_out: ldx     port_to
0009DAr 1  D0 03                bne     :+
0009DCr 1  4C rr rr             jmp     dout
0009DFr 1  4C rr rr     :       jmp     mdm_out
0009E2r 1               to_dprint:
0009E2r 1  AE rr rr             ldx     port_to
0009E5r 1  D0 03                bne     :+
0009E7r 1  4C rr rr             jmp     dprint
0009EAr 1  4C rr rr     :       jmp     mprint
0009EDr 1               
0009EDr 1               ; A/Y = the rate X as text ("1200")
0009EDr 1               baud_str:
0009EDr 1  8A                   txa
0009EEr 1  0A                   asl
0009EFr 1  AA                   tax
0009F0r 1  BD rr rr             lda     baud_names,x
0009F3r 1  BC rr rr             ldy     baud_names+1,x
0009F6r 1  60                   rts
0009F7r 1               
0009F7r 1               N_BAUD      = 13
0009F7r 1  03 05 06 07  baud_codes: .byte   $03, $05, $06, $07, $08, $09, $0A, $0B, $0C, $0D, $0E, $0F, $00
0009FBr 1  08 09 0A 0B  
0009FFr 1  0C 0D 0E 0F  
000A04r 1  1A 14 0A 06  txn_l:      .byte   <TXN(110), <TXN(150), <TXN(300), <TXN(600), <TXN(1200), <TXN(1800)
000A08r 1  84 AE        
000A0Ar 1  C3 D8 62 EC              .byte   <TXN(2400), <TXN(3600), <TXN(4800), <TXN(7200), <TXN(9600), <TXN(19200)
000A0Er 1  B2 5A        
000A10r 1  10                       .byte   <TXN(115200)
000A11r 1  3C 2C 16 0B  txn_h:      .byte   >TXN(110), >TXN(150), >TXN(300), >TXN(600), >TXN(1200), >TXN(1800)
000A15r 1  05 03        
000A17r 1  02 01 01 00              .byte   >TXN(2400), >TXN(3600), >TXN(4800), >TXN(7200), >TXN(9600), >TXN(19200)
000A1Br 1  00 00        
000A1Dr 1  00                       .byte   >TXN(115200)
000A1Er 1  rr rr rr rr  baud_names: .word   b110, b150, b300, b600, b1200, b1800, b2400, b3600, b4800, b7200
000A22r 1  rr rr rr rr  
000A26r 1  rr rr rr rr  
000A32r 1  rr rr rr rr              .word   b9600, b19200, b115200
000A36r 1  rr rr        
000A38r 1  31 31 30 00  b110:       .byte   "110", 0
000A3Cr 1  31 35 30 00  b150:       .byte   "150", 0
000A40r 1  33 30 30 00  b300:       .byte   "300", 0
000A44r 1  36 30 30 00  b600:       .byte   "600", 0
000A48r 1  31 32 30 30  b1200:      .byte   "1200", 0
000A4Cr 1  00           
000A4Dr 1  31 38 30 30  b1800:      .byte   "1800", 0
000A51r 1  00           
000A52r 1  32 34 30 30  b2400:      .byte   "2400", 0
000A56r 1  00           
000A57r 1  33 36 30 30  b3600:      .byte   "3600", 0
000A5Br 1  00           
000A5Cr 1  34 38 30 30  b4800:      .byte   "4800", 0
000A60r 1  00           
000A61r 1  37 32 30 30  b7200:      .byte   "7200", 0
000A65r 1  00           
000A66r 1  39 36 30 30  b9600:      .byte   "9600", 0
000A6Ar 1  00           
000A6Br 1  31 39 32 30  b19200:     .byte   "19200", 0
000A6Fr 1  30 00        
000A71r 1  31 31 35 32  b115200:    .byte   "115200", 0
000A75r 1  30 30 00     
000A78r 1  00 20 40 60  data_bits:  .byte   $00, $20, $40, $60              ; 8 7 6 5 (control bits 5-6)
000A7Cr 1  00 20 60 A0  par_bits:   .byte   $00, $20, $60, $A0, $E0         ; none odd even mark space (command bits 5-7)
000A80r 1  E0           
000A81r 1  4E 4F 45 4D  par_chr:    .byte   "NOEMS"
000A85r 1  53           
000A86r 1               
000A86r 1               ; ---- set-up ---------------------------------------------------------------------------------
000A86r 1               ; a screen of the settings: a digit changes one (to its next value), S saves
000A86r 1               ; them in TERM.CFG, Enter or Esc goes back.  The port changes on the way out;
000A86r 1               ; if its rate or format changed, TERM offers to tell the Zimodem first (ATB,
000A86r 1               ; sent as the port still is).
000A86r 1               N_ITEMS     = 10
000A86r 1  A2 03        setup:  ldx     #3              ; (the port as it is)
000A88r 1  BD rr rr     @o:     lda     cfg,x
000A8Br 1  9D rr rr             sta     old_cfg,x
000A8Er 1  CA                   dex
000A8Fr 1  10 F7                bpl     @o
000A91r 1  20 rr rr     @draw:  jsr     setup_draw
000A94r 1  20 rr rr     @k:     jsr     kb_wait
000A97r 1  C9 0D                cmp     #13
000A99r 1  F0 32                beq     @out
000A9Br 1  C9 1B                cmp     #27
000A9Dr 1  F0 2E                beq     @out
000A9Fr 1  C9 30                cmp     #'0'
000AA1r 1  D0 02                bne     :+
000AA3r 1  A9 3A                lda     #'9' + 1        ; (0 is the tenth)
000AA5r 1  38           :       sec
000AA6r 1  E9 31                sbc     #'1'
000AA8r 1  C9 0A                cmp     #N_ITEMS
000AAAr 1  B0 13                bcs     @let
000AACr 1  AA                   tax                     ; the next value of item X
000AADr 1  FE rr rr             inc     cfg,x
000AB0r 1  BD rr rr             lda     cfg,x
000AB3r 1  DD rr rr             cmp     item_count,x
000AB6r 1  90 D9                bcc     @draw
000AB8r 1  A9 00                lda     #0
000ABAr 1  9D rr rr             sta     cfg,x
000ABDr 1  F0 D2                beq     @draw
000ABFr 1  69 30        @let:   adc     #'1' - 1        ; (back to the key: carry was set)
000AC1r 1  29 DF                and     #$DF
000AC3r 1  C9 53                cmp     #'S'
000AC5r 1  D0 CD                bne     @k
000AC7r 1  20 rr rr             jsr     cfg_save
000ACAr 1  4C rr rr             jmp     @k
000ACDr 1  A9 0C        @out:   lda     #12
000ACFr 1  20 rr rr             jsr     dout
000AD2r 1  A2 03                ldx     #3              ; the rate or format changed?
000AD4r 1  BD rr rr     @c:     lda     cfg,x
000AD7r 1  DD rr rr             cmp     old_cfg,x
000ADAr 1  D0 09                bne     @tell
000ADCr 1  CA                   dex
000ADDr 1  10 F5                bpl     @c
000ADFr 1  20 rr rr             jsr     put_cmd         ; (DTR, RTS)
000AE2r 1  4C rr rr             jmp     show_port
000AE5r 1  A9 2C        @tell:  lda     #','            ; tell the Zimodem?  ATB"rate,8N1"
000AE7r 1  8D rr rr             sta     psep
000AEAr 1  A9 rr                lda     #<tell_txt
000AECr 1  A0 rr                ldy     #>tell_txt
000AEEr 1  20 rr rr             jsr     msg
000AF1r 1  A9 rr                lda     #<atb_txt       ; (shown: port_to is 0)
000AF3r 1  A0 rr                ldy     #>atb_txt
000AF5r 1  20 rr rr             jsr     to_dprint
000AF8r 1  20 rr rr             jsr     port_out
000AFBr 1  A9 22                lda     #'"'
000AFDr 1  20 rr rr             jsr     to_out
000B00r 1  A9 rr                lda     #<tell2_txt
000B02r 1  A0 rr                ldy     #>tell2_txt
000B04r 1  20 rr rr             jsr     dprint
000B07r 1  20 rr rr             jsr     kb_wait
000B0Ar 1  29 DF                and     #$DF
000B0Cr 1  C9 59                cmp     #'Y'
000B0Er 1  D0 23                bne     @set
000B10r 1  A9 01                lda     #1              ; (sent with the port as it was)
000B12r 1  8D rr rr             sta     port_to
000B15r 1  A9 rr                lda     #<atb_txt
000B17r 1  A0 rr                ldy     #>atb_txt
000B19r 1  20 rr rr             jsr     to_dprint
000B1Cr 1  20 rr rr             jsr     port_out
000B1Fr 1  A9 22                lda     #'"'
000B21r 1  20 rr rr             jsr     to_out
000B24r 1  A9 0D                lda     #13
000B26r 1  20 rr rr             jsr     to_out
000B29r 1  A9 00                lda     #0
000B2Br 1  8D rr rr             sta     port_to
000B2Er 1  A9 32                lda     #50             ; (its OK comes the old way)
000B30r 1  20 rr rr             jsr     wait_ticks
000B33r 1  20 rr rr     @set:   jsr     msg_end
000B36r 1  20 rr rr             jsr     apply_port
000B39r 1  4C rr rr             jmp     show_port
000B3Cr 1               
000B3Cr 1               ; the set-up screen
000B3Cr 1               setup_draw:
000B3Cr 1  A9 0C                lda     #12
000B3Er 1  20 rr rr             jsr     dout
000B41r 1  A9 rr                lda     #<setup_txt
000B43r 1  A0 rr                ldy     #>setup_txt
000B45r 1  20 rr rr             jsr     dprint
000B48r 1  A2 00                ldx     #0
000B4Ar 1  8E rr rr     @l:     stx     item
000B4Dr 1  A9 20                lda     #' '            ; "  1  BAUD RATE     1200      (hint)"
000B4Fr 1  20 rr rr             jsr     dout
000B52r 1  20 rr rr             jsr     dout
000B55r 1  8A                   txa
000B56r 1  18                   clc
000B57r 1  69 31                adc     #'1'
000B59r 1  C9 3A                cmp     #'9' + 1
000B5Br 1  D0 02                bne     :+
000B5Dr 1  A9 30                lda     #'0'
000B5Fr 1  20 rr rr     :       jsr     dout
000B62r 1  A9 20                lda     #' '
000B64r 1  20 rr rr             jsr     dout
000B67r 1  20 rr rr             jsr     dout
000B6Ar 1  8A                   txa
000B6Br 1  0A                   asl
000B6Cr 1  AA                   tax
000B6Dr 1  BD rr rr             lda     item_names,x
000B70r 1  BC rr rr             ldy     item_names+1,x
000B73r 1  20 rr rr             jsr     dprint
000B76r 1  A9 0E                lda     #$0E            ; (the value at column 20)
000B78r 1  20 rr rr             jsr     dout
000B7Br 1  A9 14                lda     #20
000B7Dr 1  20 rr rr             jsr     dout
000B80r 1  AE rr rr             ldx     item            ; the value's name: in the item's list, at
000B83r 1  8A                   txa                     ;  the value x 2
000B84r 1  0A                   asl
000B85r 1  AA                   tax
000B86r 1  BD rr rr             lda     item_lists,x
000B89r 1  8D rr rr             sta     @lo+1
000B8Cr 1  8D rr rr             sta     @hi+1
000B8Fr 1  BD rr rr             lda     item_lists+1,x
000B92r 1  8D rr rr             sta     @lo+2
000B95r 1  8D rr rr             sta     @hi+2
000B98r 1  AE rr rr             ldx     item
000B9Br 1  BD rr rr             lda     cfg,x
000B9Er 1  0A                   asl
000B9Fr 1  A8                   tay
000BA0r 1  B9 FF FF     @lo:    lda     $FFFF,y
000BA3r 1  48                   pha
000BA4r 1  C8                   iny
000BA5r 1  B9 FF FF     @hi:    lda     $FFFF,y
000BA8r 1  A8                   tay
000BA9r 1  68                   pla
000BAAr 1  20 rr rr             jsr     dprint
000BADr 1  A9 0E                lda     #$0E            ; (the hint at column 30)
000BAFr 1  20 rr rr             jsr     dout
000BB2r 1  A9 1E                lda     #30
000BB4r 1  20 rr rr             jsr     dout
000BB7r 1  AD rr rr             lda     item
000BBAr 1  0A                   asl
000BBBr 1  AA                   tax
000BBCr 1  BD rr rr             lda     item_hints,x
000BBFr 1  BC rr rr             ldy     item_hints+1,x
000BC2r 1  20 rr rr             jsr     dprint
000BC5r 1  A9 0D                lda     #13
000BC7r 1  20 rr rr             jsr     dout
000BCAr 1  A9 0A                lda     #10
000BCCr 1  20 rr rr             jsr     dout
000BCFr 1  AE rr rr             ldx     item
000BD2r 1  E8                   inx
000BD3r 1  E0 0A                cpx     #N_ITEMS
000BD5r 1  F0 03                beq     :+
000BD7r 1  4C rr rr             jmp     @l
000BDAr 1  A9 rr        :       lda     #<setup2_txt
000BDCr 1  A0 rr                ldy     #>setup2_txt
000BDEr 1  4C rr rr             jmp     dprint
000BE1r 1               
000BE1r 1               ; each item: its name, how many values, their names, a hint
000BE1r 1  rr rr rr rr  item_names: .word   in1, in2, in3, in4, in5, in6, in7, in8, in9, in10
000BE5r 1  rr rr rr rr  
000BE9r 1  rr rr rr rr  
