001391r 1               ; ---- variables ----------------------------------------------------------------------------
001391r 1                       .segment "BSS"
000040r 1               cfg:                            ; the settings (TERM.CFG), in set-up's order
000040r 1  xx           baud_i:     .res 1              ; 0-12: 110 ... 19200, 115200 (external clock)
000041r 1  xx           data_i:     .res 1              ; 0-3: 8 7 6 5 data bits
000042r 1  xx           par_i:      .res 1              ; 0-4: none odd even mark space
000043r 1  xx           stop_i:     .res 1              ; 0-1: 1 or 2 stop bits
000044r 1  xx           dtr:        .res 1              ; 1: on
000045r 1  xx           rts_i:      .res 1              ; 0 on, 1 off, 2 flow control
000046r 1               flags:                          ; (the on/off ones)
000046r 1  xx           echo:       .res 1
000047r 1  xx           addlf:      .res 1
000048r 1  xx           cmap:       .res 1              ; 1: colours as mono
000049r 1  xx           bs_swap:    .res 1
00004Ar 1               CFG_LEN     = * - cfg
00004Ar 1  xx xx xx xx  old_cfg:    .res 4              ; (the port as it was when set-up began)
00004Er 1  xx           rts_now:    .res 1              ; flow control: RTS asserted now
00004Fr 1  xx           item:       .res 1
000050r 1  xx           port_to:    .res 1              ; port_out: 0 to the screen, 1 to the Zimodem
000051r 1  xx           psep:       .res 1              ;  and between the rate and the format: " " or ","
000052r 1  xx xx xx xx  cwd_buf:    .res CWD_MAX + 1
000056r 1  xx xx xx xx  
00005Ar 1  xx xx xx xx  
000072r 1  xx xx xx xx  fbuf:       .res CFG_LEN + 4
000076r 1  xx xx xx xx  
00007Ar 1  xx xx xx xx  
000080r 1  xx           txn_lo:     .res 1              ; the serial port's byte time (wait loop turns)
000081r 1  xx           txn_hi:     .res 1
000082r 1  xx           ier_t1:     .res 1
000083r 1  xx           cmd_mode:   .res 1
000084r 1  xx           rx_state:   .res 1              ; 0 text, 1 after ESC, 2 in ESC [, 3 a long one
000085r 1  xx           csi_len:    .res 1
000086r 1  xx xx xx xx  csi_buf:    .res CSI_MAX
00008Ar 1  xx xx xx xx  
00008Er 1  xx xx xx xx  
0000AEr 1  xx           kb_r:       .res 1
0000AFr 1  xx           kb_w:       .res 1
0000B0r 1  xx xx xx xx  kbbuf:      .res KB_SIZE
0000B4r 1  xx xx xx xx  
0000B8r 1  xx xx xx xx  
0000F0r 1  xx           bell_t:     .res 1
0000F1r 1  xx           wt:         .res 1
0000F2r 1  xx           s_fg:       .res 1              ; the colours and attributes asked for
0000F3r 1  xx           s_bg:       .res 1
0000F4r 1  xx           s_fgb:      .res 1
0000F5r 1  xx           s_bgb:      .res 1
0000F6r 1  xx           s_bold:     .res 1
0000F7r 1  xx           s_ul:       .res 1
0000F8r 1  xx           s_blink:    .res 1
0000F9r 1  xx           s_rev:      .res 1              ; (0 or 4)
0000FAr 1  xx           out_last:   .res 1              ; what the display was last told: bits 1 bold, 2 ul, 4 rev
0000FBr 1  xx           ext:        .res 1
0000FCr 1  xx xx        num:        .res 2
0000FEr 1  xx           tmp:        .res 1
0000FFr 1  xx           tmp2:       .res 1
000100r 1  xx           line_len:   .res 1
000101r 1  xx xx xx xx  line:       .res LINE_MAX
000105r 1  xx xx xx xx  
