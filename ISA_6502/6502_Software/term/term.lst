00077Fr 1  8D rr rr             sta     s_blink
000782r 1  60                   rts
000783r 1  C9 07        :       cmp     #7
000785r 1  D0 06                bne     :+
000787r 1  A9 04                lda     #4
000789r 1  8D rr rr             sta     s_rev
00078Cr 1  60                   rts
00078Dr 1  A0 00        :       ldy     #0
00078Fr 1  C9 16                cmp     #22
000791r 1  D0 04                bne     :+
000793r 1  8C rr rr             sty     s_bold
000796r 1  60                   rts
000797r 1  C9 18        :       cmp     #24
000799r 1  D0 04                bne     :+
