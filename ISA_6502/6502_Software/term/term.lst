000844r 1               
000844r 1               ; ---- the bell -----------------------------------------------------------------------------
000844r 1               ; a short beep on the AY card's channel A (nothing happens without the card)
000844r 1  A9 00        bell:   lda     #0
000846r 1  A2 8E                ldx     #142            ; about 880 Hz: 2 MHz / (16 x 142)
000848r 1  20 rr rr             jsr     ay_set
00084Br 1  A9 01                lda     #1
00084Dr 1  A2 00                ldx     #0
00084Fr 1  20 rr rr             jsr     ay_set
000852r 1  A9 07                lda     #7
000854r 1  A2 3E                ldx     #$3E            ; mixer: tone A only
000856r 1  20 rr rr             jsr     ay_set
000859r 1  A9 08                lda     #8
00085Br 1  A2 0C                ldx     #12
00085Dr 1  20 rr rr             jsr     ay_set
000860r 1  A9 0C                lda     #12             ; for 0.12 s
000862r 1  8D rr rr             sta     bell_t
000865r 1  60                   rts
000866r 1               bell_off:
000866r 1  A9 08                lda     #8
000868r 1  A2 00                ldx     #0
00086Ar 1  20 rr rr             jsr     ay_set
00086Dr 1  A9 07                lda     #7
00086Fr 1  A2 3F                ldx     #$3F
