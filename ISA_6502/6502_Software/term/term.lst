000749r 1  8D rr rr             sta     ext
00074Cr 1  60           @x:     rts
00074Dr 1  CE rr rr     @skip:  dec     ext
000750r 1  AD rr rr             lda     ext
000753r 1  C9 01                cmp     #1
000755r 1  D0 F5                bne     @x
000757r 1  A9 00                lda     #0
000759r 1  8D rr rr             sta     ext
00075Cr 1  60                   rts
00075Dr 1  AD rr rr     @n:     lda     num
000760r 1  D0 03                bne     :+
000762r 1  4C rr rr             jmp     sgr_reset
000765r 1  C9 01        :       cmp     #1
000767r 1  D0 04                bne     :+
000769r 1  8D rr rr             sta     s_bold
00076Cr 1  60                   rts
00076Dr 1  C9 04        :       cmp     #4
00076Fr 1  D0 04                bne     :+
000771r 1  8D rr rr             sta     s_ul
000774r 1  60                   rts
000775r 1  C9 05        :       cmp     #5
000777r 1  F0 04                beq     @bl
000779r 1  C9 06                cmp     #6
00077Br 1  D0 06                bne     :+
