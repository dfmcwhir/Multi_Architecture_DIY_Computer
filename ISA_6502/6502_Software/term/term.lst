00079Er 1  60                   rts
00079Fr 1  C9 19        :       cmp     #25
0007A1r 1  D0 04                bne     :+
0007A3r 1  8C rr rr             sty     s_blink
0007A6r 1  60                   rts
0007A7r 1  C9 1B        :       cmp     #27
0007A9r 1  D0 04                bne     :+
0007ABr 1  8C rr rr             sty     s_rev
0007AEr 1  60                   rts
0007AFr 1  C9 26        :       cmp     #38
0007B1r 1  F0 04                beq     @ext
0007B3r 1  C9 30                cmp     #48
0007B5r 1  D0 06                bne     :+
0007B7r 1  A9 01        @ext:   lda     #1
