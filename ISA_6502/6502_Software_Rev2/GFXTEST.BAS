10 REM GFXTEST - the display statements on the PICO9918 or ESP32_VGA
20 D=PEEK(65279):IF D<2 THEN PRINT "NEEDS PICO9918 OR ESP32_VGA":END
30 IF D=2 THEN W=255:H=191:C1=8:C2=3:C3=15:N=7
40 IF D=3 THEN W=319:H=239:C1=48:C2=12:C3=63:N=63
50 CLS 1
60 COLOR C3:LOCATE 1,1:PRINT "GRAPHICS TEST"
70 PLOT 0,0 TO W,H,C1:PLOT W,0 TO 0,H,C1
80 PLOT 20,40 TO 100,90,C2,1
90 PLOT 140,50 TO 200,110,C2,2
100 PLOT W/2,H/2,C3,40
110 PLOT W/2,H/2,C1,20,1
120 FOR I=0 TO 31:POKE 28672+I,255:NEXT
130 IF D=3 THEN FOR I=0 TO 255:POKE 28672+I,C3:NEXT
140 SPRITE DEF 0,28672
150 FOR X=0 TO W-16 STEP 2:SPRITE 0,0,X,H-30:NEXT
160 GET K$:IF K$="" THEN 160
170 CLS 0:PRINT "DONE"
