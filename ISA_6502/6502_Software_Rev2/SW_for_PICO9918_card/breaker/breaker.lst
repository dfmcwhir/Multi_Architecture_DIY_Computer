0006A0r 1  C9 51                cmp     #'Q'
0006A2r 1  D0 03                bne     @notq
0006A4r 1  4C rr rr             jmp     exit_game
0006A7r 1  C9 4D        @notq:  cmp     #'M'            ; sound on / off
0006A9r 1  D0 06                bne     @notm
0006ABr 1  20 rr rr             jsr     sfx_toggle
0006AEr 1  4C rr rr             jmp     @wait
0006B1r 1  C9 47        @notm:  cmp     #'G'
0006B3r 1  D0 0E                bne     @notg
0006B5r 1  AD rr rr             lda     ctrl
0006B8r 1  49 01                eor     #1
0006BAr 1  8D rr rr             sta     ctrl
