000650r 1  20 rr rr     @pico:  jsr     sfx_init
000653r 1  AD rr rr             lda     mute_def
000656r 1  8D rr rr             sta     sfx_mute
000659r 1  20 rr rr             jsr     gfx_init
00065Cr 1               
00065Cr 1  20 rr rr     title:  jsr     sfx_off
00065Fr 1  A9 00                lda     #0
000661r 1  8D rr rr             sta     rp_on
000664r 1  20 rr rr             jsr     new_screen
000667r 1  A9 rr                lda     #<title_txt
000669r 1  A0 rr                ldy     #>title_txt
00066Br 1  20 rr rr             jsr     print
00066Er 1  20 rr rr             jsr     txt_mode        ; the high score
000671r 1  A2 07                ldx     #7
000673r 1  A0 13                ldy     #19
000675r 1  20 rr rr             jsr     gotoxy
000678r 1  A9 rr                lda     #<hi_txt
00067Ar 1  A0 rr                ldy     #>hi_txt
