0006D6r 1               
0006D6r 1               exit_game:
0006D6r 1  20 rr rr             jsr     sfx_off
0006D9r 1  20 39 FE             jsr     SBC_CONRESET    ; the console's text screen back
0006DCr 1  4C 06 FE             jmp     SBC_MENU
0006DFr 1               
0006DFr 1               ; clear the screen (which hides the sprites) and forget what it showed
0006DFr 1               new_screen:
0006DFr 1  A9 00                lda     #<V_NAME        ; every name blank
0006E1r 1  A0 38                ldy     #>V_NAME
0006E3r 1  20 rr rr             jsr     vdp_waddr
0006E6r 1  A9 00                lda     #0
0006E8r 1  8D rr rr             sta     vdp_n
0006EBr 1  A9 03                lda     #3
0006EDr 1  8D rr rr             sta     vdp_n+1
0006F0r 1  A9 00                lda     #0
0006F2r 1  8D rr rr             sta     rv
0006F5r 1  20 rr rr             jsr     vdp_fill
0006F8r 1                       ; fall through
0006F8r 1               
0006F8r 1               ; no sprites
0006F8r 1               hide_sprites:
0006F8r 1  A9 00                lda     #<V_SATTR
0006FAr 1  A0 3B                ldy     #>V_SATTR
0006FCr 1  20 rr rr             jsr     vdp_waddr
0006FFr 1  A9 D0                lda     #$D0
000701r 1  8D 1C 7F             sta     VDP_DATA
000704r 1  60                   rts
000705r 1               
000705r 1               ; ============================================================================
000705r 1               ; the display
000705r 1               ; ============================================================================
000705r 1               ; set up the VDP: registers, then the load list (patterns, colours, sprites)
000705r 1               gfx_init:
000705r 1  A9 rr                lda     #<vdp_regs
000707r 1  A0 rr                ldy     #>vdp_regs
000709r 1  20 rr rr             jsr     vdp_setup       ; (VRAM cleared)
00070Cr 1  A9 00                lda     #0
00070Er 1  8D rr rr             sta     ll_i
000711r 1  AE rr rr     @e:     ldx     ll_i            ; entry: VRAM address, length, source (a
000714r 1  BD rr rr             lda     load_list+1,x   ; source below $0100: fill with that byte)
000717r 1  C9 FF                cmp     #$FF
000719r 1  F0 39                beq     @done
00071Br 1  A8                   tay
00071Cr 1  BD rr rr             lda     load_list,x
00071Fr 1  20 rr rr             jsr     vdp_waddr
000722r 1  BD rr rr             lda     load_list+2,x
000725r 1  8D rr rr             sta     vdp_n
000728r 1  BD rr rr             lda     load_list+3,x
00072Br 1  8D rr rr             sta     vdp_n+1
00072Er 1  BD rr rr             lda     load_list+5,x
000731r 1  F0 0F                beq     @fill
000733r 1  8D rr rr             sta     vdp_src+1
000736r 1  BD rr rr             lda     load_list+4,x
000739r 1  8D rr rr             sta     vdp_src
00073Cr 1  20 rr rr             jsr     vdp_copy
00073Fr 1  4C rr rr             jmp     @nx
000742r 1  BD rr rr     @fill:  lda     load_list+4,x
000745r 1  20 rr rr             jsr     vdp_fill
000748r 1  AD rr rr     @nx:    lda     ll_i
00074Br 1  18                   clc
00074Cr 1  69 06                adc     #6
00074Er 1  8D rr rr             sta     ll_i
000751r 1  4C rr rr             jmp     @e
000754r 1  A9 C2        @done:  lda     #$C2            ; R1: display on, 16K, 16 x 16 sprites, and
000756r 1  A2 01                ldx     #1              ; bit 5 (the VDP interrupt) off
000758r 1  4C rr rr             jmp     vdp_reg
00075Br 1               
00075Br 1               ; the sprite list: add one (sp_x, sp_y = the Y register, sp_p, sp_c)
00075Br 1               spr_add:
00075Br 1  AC rr rr             ldy     sp_n
00075Er 1  C0 20                cpy     #32
000760r 1  B0 1F                bcs     @r
000762r 1  98                   tya
000763r 1  0A                   asl
000764r 1  0A                   asl
000765r 1  A8                   tay
000766r 1  AD rr rr             lda     sp_y
000769r 1  99 rr rr             sta     satt,y
00076Cr 1  AD rr rr             lda     sp_x
00076Fr 1  99 rr rr             sta     satt+1,y
000772r 1  AD rr rr             lda     sp_p
000775r 1  99 rr rr             sta     satt+2,y
000778r 1  AD rr rr             lda     sp_c
00077Br 1  99 rr rr             sta     satt+3,y
00077Er 1  EE rr rr             inc     sp_n
000781r 1  60           @r:     rts
000782r 1               
000782r 1               ; the sprite list onto the screen
000782r 1               put_sprites:
000782r 1  A9 00                lda     #<V_SATTR
000784r 1  A0 3B                ldy     #>V_SATTR
000786r 1  20 rr rr             jsr     vdp_waddr
000789r 1  AD rr rr             lda     sp_n
00078Cr 1  0A                   asl
00078Dr 1  0A                   asl
00078Er 1  AA                   tax
00078Fr 1  F0 0C                beq     @end            ; (X bytes)
000791r 1  A0 00                ldy     #0
000793r 1  B9 rr rr     @l:     lda     satt,y
000796r 1  8D 1C 7F             sta     VDP_DATA
000799r 1  C8                   iny
00079Ar 1  CA                   dex
00079Br 1  D0 F6                bne     @l
00079Dr 1  AD rr rr     @end:   lda     sp_n
0007A0r 1  C9 20                cmp     #32
0007A2r 1  B0 05                bcs     @r
0007A4r 1  A9 D0                lda     #$D0            ; (the end of the list)
0007A6r 1  8D 1C 7F             sta     VDP_DATA
0007A9r 1  60           @r:     rts
0007AAr 1               
0007AAr 1               ; the title's capsules beside their words
0007AAr 1               title_sprites:
0007AAr 1  A9 00                lda     #0
0007ACr 1  8D rr rr             sta     sp_n
0007AFr 1  A2 05                ldx     #NCAPTYPE-1
0007B1r 1  8E rr rr     @c:     stx     sp_i
0007B4r 1  BD rr rr             lda     title_cx,x
0007B7r 1  8D rr rr             sta     sp_x
0007BAr 1  BD rr rr             lda     title_cy,x
0007BDr 1  8D rr rr             sta     sp_y
0007C0r 1  8A                   txa
0007C1r 1  0A                   asl
0007C2r 1  0A                   asl
0007C3r 1  69 44                adc     #S_SIGN_W
0007C5r 1  8D rr rr             sta     sp_p
0007C8r 1  A9 0F                lda     #C_SIGN
0007CAr 1  8D rr rr             sta     sp_c
0007CDr 1  20 rr rr             jsr     spr_add
0007D0r 1  AE rr rr             ldx     sp_i
0007D3r 1  A9 40                lda     #S_CAP
0007D5r 1  8D rr rr             sta     sp_p
0007D8r 1  BD rr rr             lda     cap_col,x
0007DBr 1  8D rr rr             sta     sp_c
0007DEr 1  20 rr rr             jsr     spr_add
0007E1r 1  AE rr rr             ldx     sp_i
0007E4r 1  CA                   dex
0007E5r 1  10 CA                bpl     @c
0007E7r 1  4C rr rr             jmp     put_sprites
0007EAr 1               
0007EAr 1               ; ============================================================================
0007EAr 1               ; a game
0007EAr 1               ; ============================================================================
0007EAr 1               new_game:
0007EAr 1  A9 00                lda     #0
0007ECr 1  8D rr rr             sta     score
0007EFr 1  8D rr rr             sta     score+1
0007F2r 1  8D rr rr             sta     score+2
0007F5r 1  8D rr rr             sta     level
0007F8r 1  8D rr rr             sta     quit
0007FBr 1  A9 03                lda     #3
0007FDr 1  8D rr rr             sta     lives
000800r 1               next_level:
000800r 1  EE rr rr             inc     level
000803r 1  20 rr rr             jsr     new_screen
000806r 1  A9 rr                lda     #<status_txt
000808r 1  A0 rr                ldy     #>status_txt
00080Ar 1  20 rr rr             jsr     print
00080Dr 1  20 rr rr             jsr     draw_walls
000810r 1  AE rr rr             ldx     level           ; the level's bricks (they go round after
000813r 1  CA                   dex                     ; the last one, a little faster)
000814r 1  E0 0A        @m:     cpx     #NLEVEL
000816r 1  90 07                bcc     @m1
000818r 1  8A                   txa
000819r 1  E9 0A                sbc     #NLEVEL
00081Br 1  AA                   tax
00081Cr 1  4C rr rr             jmp     @m
00081Fr 1  BD rr rr     @m1:    lda     lv_lo,x
000822r 1  8D rr rr             sta     @rd+1
000825r 1  BD rr rr             lda     lv_hi,x
000828r 1  8D rr rr             sta     @rd+2
00082Br 1  A9 00                lda     #0
00082Dr 1  8D rr rr             sta     bricks_left
000830r 1  A2 BD                ldx     #NBRICK-1
000832r 1  BD FF FF     @rd:    lda     $FFFF,x
000835r 1  9D rr rr             sta     map,x
000838r 1  F0 07                beq     @cn
00083Ar 1  C9 03                cmp     #3
00083Cr 1  F0 03                beq     @cn
00083Er 1  EE rr rr             inc     bricks_left
000841r 1  CA           @cn:    dex
000842r 1  E0 FF                cpx     #$FF
000844r 1  D0 EC                bne     @rd
000846r 1  20 rr rr             jsr     draw_bricks
000849r 1  AD rr rr             lda     level           ; the speed to start with: faster each
00084Cr 1  38                   sec                     ; time round the levels
00084Dr 1  E9 01                sbc     #1
00084Fr 1  4A                   lsr
000850r 1  4A                   lsr
000851r 1  4A                   lsr
000852r 1  C9 04                cmp     #4
000854r 1  90 02                bcc     @s
000856r 1  A9 04                lda     #4
000858r 1  8D rr rr     @s:     sta     base_spd
00085Br 1  A9 01                lda     #1
00085Dr 1  8D rr rr             sta     hud_dirty
000860r 1  20 rr rr             jsr     hud_update
000863r 1  20 rr rr             jsr     serve
000866r 1  A9 01                lda     #1
000868r 1  8D rr rr             sta     msg_on
00086Br 1  A9 0C                lda     #SND_START
00086Dr 1  20 rr rr             jsr     sfx_snd
000870r 1  A9 rr                lda     #<ready_txt     ; "LEVEL nn"
000872r 1  A0 rr                ldy     #>ready_txt
000874r 1  20 rr rr             jsr     print
000877r 1  AD rr rr             lda     level
00087Ar 1  20 rr rr             jsr     prdec2
00087Dr 1  4C rr rr             jmp     game_loop
000880r 1               
000880r 1               ; a new ball on the paddle (a new level, or after one is lost)
000880r 1  A2 02        serve:  ldx     #NBALL-1
000882r 1  A9 00                lda     #0
000884r 1  9D rr rr     @b:     sta     b_on,x
000887r 1  CA                   dex
000888r 1  10 FA                bpl     @b
00088Ar 1  A2 01                ldx     #NCAP-1
00088Cr 1  9D rr rr     @c:     sta     c_on,x
00088Fr 1  CA                   dex
000890r 1  10 FA                bpl     @c
000892r 1  A2 03                ldx     #NSHOT-1
000894r 1  9D rr rr     @s:     sta     s_on,x
000897r 1  CA                   dex
000898r 1  10 FA                bpl     @s
00089Ar 1  8D rr rr             sta     pw
00089Dr 1  8D rr rr             sta     hits
0008A0r 1  A9 10                lda     #PAD_NORMAL
0008A2r 1  8D rr rr             sta     pad_w
0008A5r 1  A9 48                lda     #80 - PAD_NORMAL / 2
0008A7r 1  8D rr rr             sta     pad_x
0008AAr 1  AD rr rr             lda     base_spd
0008ADr 1  8D rr rr             sta     spd
0008B0r 1  A2 00                ldx     #0
0008B2r 1  A9 01                lda     #1
0008B4r 1  8D rr rr             sta     b_on
0008B7r 1  A9 07                lda     #PAD_NORMAL / 2 - 1
0008B9r 1  8D rr rr             sta     b_off
0008BCr 1  20 rr rr             jsr     stick_ball
0008BFr 1  A9 64                lda     #SERVE_FRAMES
0008C1r 1  8D rr rr             sta     serve_t
0008C4r 1  60                   rts
0008C5r 1               
0008C5r 1               ; ball X on the paddle (b_off from its left end)
0008C5r 1               stick_ball:
0008C5r 1  A9 01                lda     #1
0008C7r 1  9D rr rr             sta     b_stuck,x
0008CAr 1  AD rr rr             lda     pad_x
0008CDr 1  18                   clc
0008CEr 1  7D rr rr             adc     b_off,x
0008D1r 1  9D rr rr             sta     b_xh,x
0008D4r 1  A9 55                lda     #BALL_TOP
0008D6r 1  9D rr rr             sta     b_yh,x
0008D9r 1  A9 00                lda     #0
0008DBr 1  9D rr rr             sta     b_xl,x
0008DEr 1  9D rr rr             sta     b_yl,x
0008E1r 1  60                   rts
0008E2r 1               
0008E2r 1               ; ---- the frame loop --------------------------------------------------------------
0008E2r 1               game_loop:
0008E2r 1  20 rr rr             jsr     sfx_poll
0008E5r 1  20 rr rr             jsr     read_input
0008E8r 1  AD rr rr             lda     quit
0008EBr 1  F0 03                beq     @1
0008EDr 1  4C rr rr             jmp     title
0008F0r 1  20 rr rr     @1:     jsr     move_paddle
0008F3r 1  20 rr rr             jsr     launch
0008F6r 1  20 rr rr             jsr     balls_update
0008F9r 1  20 rr rr             jsr     caps_update
0008FCr 1  20 rr rr             jsr     shots_update
0008FFr 1  20 rr rr             jsr     set_sprites     ; the sprite list ...
000902r 1  20 rr rr             jsr     pace            ; ... onto the screen when the frame is up
000905r 1  20 rr rr             jsr     hud_update
000908r 1  EE rr rr             inc     frame
00090Br 1  A2 02                ldx     #NBALL-1        ; any ball left?
00090Dr 1  BD rr rr     @b:     lda     b_on,x
000910r 1  D0 06                bne     @2
000912r 1  CA                   dex
000913r 1  10 F8                bpl     @b
000915r 1  4C rr rr             jmp     life_lost
000918r 1  AD rr rr     @2:     lda     bricks_left     ; the level cleared?
00091Br 1  D0 C5                bne     game_loop
00091Dr 1  4C rr rr             jmp     level_done
000920r 1               
000920r 1               ; the game's pace: speed video frames a game frame (the sound goes on
000920r 1               ; meanwhile), then the sprites
000920r 1  AD rr rr     pace:   lda     speed
000923r 1  8D rr rr             sta     wf_n
000926r 1  20 rr rr     @w:     jsr     vdp_frame
000929r 1  CE rr rr             dec     wf_n
00092Cr 1  D0 F8                bne     @w
00092Er 1  4C rr rr             jmp     put_sprites
000931r 1               
000931r 1               life_lost:
000931r 1  A9 0B                lda     #SND_LOST
000933r 1  20 rr rr             jsr     sfx_snd
000936r 1  20 rr rr             jsr     hide_sprites    ; (the sprites go)
000939r 1  A9 14                lda     #20
00093Br 1  20 rr rr             jsr     delay_long
00093Er 1  CE rr rr             dec     lives
000941r 1  A9 01                lda     #1
000943r 1  8D rr rr             sta     hud_dirty
000946r 1  20 rr rr             jsr     hud_update
000949r 1  AD rr rr             lda     lives
00094Cr 1  D0 03                bne     @more
00094Er 1  4C rr rr             jmp     game_over
000951r 1  20 rr rr     @more:  jsr     serve
000954r 1  4C rr rr             jmp     game_loop
000957r 1               
000957r 1               level_done:
000957r 1  A9 0D                lda     #SND_CLEAR
000959r 1  20 rr rr             jsr     sfx_snd
00095Cr 1  20 rr rr             jsr     hide_sprites
00095Fr 1  A9 rr                lda     #<clear_txt
000961r 1  A0 rr                ldy     #>clear_txt
000963r 1  20 rr rr             jsr     print
000966r 1  A9 1E                lda     #30
000968r 1  20 rr rr             jsr     delay_long
00096Br 1  4C rr rr             jmp     next_level
00096Er 1               
00096Er 1               game_over:
00096Er 1  A2 02                ldx     #2              ; new high score?
000970r 1  BD rr rr     @hc:    lda     score,x
000973r 1  DD rr rr             cmp     hiscore,x
000976r 1  90 1A                bcc     @nohi
000978r 1  D0 05                bne     @hi
00097Ar 1  CA                   dex
00097Br 1  10 F3                bpl     @hc
00097Dr 1  30 13                bmi     @nohi
00097Fr 1  A2 02        @hi:    ldx     #2
000981r 1  BD rr rr     @hs:    lda     score,x
000984r 1  9D rr rr             sta     hiscore,x
000987r 1  CA                   dex
000988r 1  10 F7                bpl     @hs
00098Ar 1  A9 01                lda     #1
00098Cr 1  8D rr rr             sta     hud_dirty
00098Fr 1  20 rr rr             jsr     hud_update
000992r 1  A9 0E        @nohi:  lda     #SND_OVER
000994r 1  20 rr rr             jsr     sfx_snd
000997r 1  A9 rr                lda     #<over_txt
000999r 1  A0 rr                ldy     #>over_txt
00099Br 1  20 rr rr             jsr     print
00099Er 1  A9 14                lda     #20
0009A0r 1  20 rr rr             jsr     delay_long
0009A3r 1  20 rr rr     @wait:  jsr     menu_key
0009A6r 1  C9 51                cmp     #'Q'
0009A8r 1  D0 03                bne     @nq
0009AAr 1  4C rr rr             jmp     title
0009ADr 1  C9 4D        @nq:    cmp     #'M'
0009AFr 1  D0 06                bne     @nm
0009B1r 1  20 rr rr             jsr     sfx_toggle
0009B4r 1  4C rr rr             jmp     @wait
0009B7r 1  C9 20        @nm:    cmp     #' '
0009B9r 1  F0 04                beq     @again
0009BBr 1  C9 80                cmp     #PAD_GO
0009BDr 1  D0 E4                bne     @wait
0009BFr 1  4C rr rr     @again: jmp     new_game
0009C2r 1               
0009C2r 1               ; ============================================================================
0009C2r 1               ; drawing the field
0009C2r 1               ; ============================================================================
0009C2r 1               draw_walls:
0009C2r 1  A2 00                ldx     #0              ; the top: row 1
0009C4r 1  A0 01                ldy     #1
0009C6r 1  20 rr rr             jsr     gotoxy
0009C9r 1  A9 02                lda     #2
0009CBr 1  8D 1C 7F             sta     VDP_DATA
0009CEr 1  A2 1E                ldx     #30
0009D0r 1  A9 01                lda     #1
0009D2r 1  8D 1C 7F     @t:     sta     VDP_DATA
0009D5r 1  CA                   dex
0009D6r 1  D0 FA                bne     @t
0009D8r 1  A9 03                lda     #3
0009DAr 1  8D 1C 7F             sta     VDP_DATA
0009DDr 1  A0 02                ldy     #2              ; the sides: columns 0 and 31, rows 2-23
0009DFr 1  A2 00        @s:     ldx     #0
0009E1r 1  20 rr rr             jsr     gotoxy
0009E4r 1  A9 02                lda     #2
