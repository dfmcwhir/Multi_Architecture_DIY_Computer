0006C0r 1  4C rr rr             jmp     @wait
0006C3r 1  C9 80        @notg:  cmp     #PAD_GO
0006C5r 1  D0 08                bne     @notp
0006C7r 1  A9 01                lda     #1
0006C9r 1  8D rr rr             sta     ctrl
