000716r 1  AD rr rr             lda     grp+6
000719r 1  29 03                and     #3
00071Br 1  A8                   tay
00071Cr 1  B9 rr rr             lda     ev_53,y
00071Fr 1  0D rr rr             ora     dg_t
000722r 1  8D rr rr             sta     dg_t
000725r 1  AD rr rr             lda     grp+7
000728r 1  29 03                and     #3
00072Ar 1  A8                   tay
