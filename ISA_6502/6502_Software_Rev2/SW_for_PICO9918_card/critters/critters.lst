0004A2r 1  60                   rts
0004A3r 1               
0004A3r 1               ; a character into the bitmap at the cursor (its 8 pattern bytes and 8
0004A3r 1               ; colour bytes), and the cursor on.  Preserves A, X, Y.
0004A3r 1  48           putc:   pha
0004A4r 1  8E rr rr             stx     pu_x
0004A7r 1  8C rr rr             sty     pu_y
0004AAr 1  38                   sec
0004ABr 1  E9 20                sbc     #$20
0004ADr 1  C9 40                cmp     #64
0004AFr 1  90 02                bcc     @ok
0004B1r 1  A9 00                lda     #0              ; (anything else: a space)
