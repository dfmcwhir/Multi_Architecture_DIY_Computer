000ABEr 1               .macro MENU_IDLE
000ABEr 1                       jsr     flush_px
000ABEr 1                       jsr     sfx_poll
000ABEr 1                       jsr     mouse_poll
000ABEr 1               .endmacro
000ABEr 1               CTRL_COL        = 0
000ABEr 1               CTRL_ROW        = 19
000ABEr 1               
000ABEr 1               ; ============================================================================
000ABEr 1               ; gamepad and menu input (shared by the SBC games)
000ABEr 1               ; ============================================================================
000ABEr 1               PAD_A           = $01           ; bits returned by SBC_PADSTATE
000ABEr 1               PAD_B           = $02
000ABEr 1               PAD_SELECT      = $04
000ABEr 1               PAD_START       = $08
000ABEr 1               PAD_UP          = $10
000ABEr 1               PAD_DOWN        = $20
000ABEr 1               PAD_LEFT        = $40
000ABEr 1               PAD_RIGHT       = $80
000ABEr 1               PAD_GO          = $80           ; menu_key's answer for gamepad A or Start
000ABEr 1               
000ABEr 1               ; read the gamepad: pad = buttons held now, padnew = buttons pressed since
000ABEr 1               ; the last call.  Preserves X and Y (SBC_PADSTATE only changes A).
000ABEr 1               read_pad:
000ABEr 1  20 12 FE             jsr     SBC_PADSTATE
000AC1r 1  C9 FF                cmp     #$FF            ; every button "pressed" = no pad
000AC3r 1  D0 02                bne     @ok
000AC5r 1  A9 00                lda     #0
000AC7r 1  8D rr rr     @ok:    sta     pad
000ACAr 1  AD rr rr             lda     padold
000ACDr 1  49 FF                eor     #$FF
000ACFr 1  2D rr rr             and     pad
000AD2r 1  8D rr rr             sta     padnew
000AD5r 1  AD rr rr             lda     pad
000AD8r 1  8D rr rr             sta     padold
000ADBr 1  60                   rts
000ADCr 1               
000ADCr 1               ; throw away waiting characters
000ADCr 1               flush_in:
000ADCr 1  20 00 FE             jsr     getc
000ADFr 1  B0 FB                bcs     flush_in
000AE1r 1  60                   rts
000AE2r 1               
000AE2r 1               ; carry set if A is one of the characters the gamepad driver types for the
000AE2r 1               ; pad (W A S D and space).  Those are ignored in gamepad mode so that one
000AE2r 1               ; press doesn't act twice.  Preserves A.
000AE2r 1               pad_typed:
000AE2r 1  C9 20                cmp     #' '
000AE4r 1  F0 12                beq     @y
000AE6r 1  C9 57                cmp     #'W'
000AE8r 1  F0 0E                beq     @y
000AEAr 1  C9 41                cmp     #'A'
000AECr 1  F0 0A                beq     @y
000AEEr 1  C9 53                cmp     #'S'
000AF0r 1  F0 06                beq     @y
000AF2r 1  C9 44                cmp     #'D'
000AF4r 1  F0 02                beq     @y
000AF6r 1  18                   clc
000AF7r 1  60                   rts
000AF8r 1  38           @y:     sec
000AF9r 1  60                   rts
000AFAr 1               
000AFAr 1               ; wait for a menu choice.  Returns a key (letters in upper case), or
000AFAr 1               ; PAD_GO for the gamepad's A or Start button.
000AFAr 1               menu_key:
000AFAr 1  20 rr rr             jsr     mouse_flush
000AFDr 1  20 rr rr 20  @l:     MENU_IDLE
000B01r 1  rr rr 20 rr  
000B05r 1  rr           
000B06r 1  AD rr rr             lda     m_click         ; a click: as the pad's A
000B09r 1  F0 08                beq     @nc
000B0Br 1  A9 00                lda     #0
000B0Dr 1  8D rr rr             sta     m_click
000B10r 1  A9 80                lda     #PAD_GO
000B12r 1  60                   rts
000B13r 1  20 rr rr     @nc:    jsr     read_pad
000B16r 1  AD rr rr             lda     padnew
000B19r 1  29 09                and     #PAD_A | PAD_START
000B1Br 1  D0 21                bne     @pad
000B1Dr 1  20 00 FE             jsr     getc
000B20r 1  90 DB                bcc     @l
000B22r 1  C9 20                cmp     #' '            ; a space typed by the pad's A button?
000B24r 1  D0 0D                bne     @up
000B26r 1  20 rr rr             jsr     read_pad
000B29r 1  AD rr rr             lda     pad
000B2Cr 1  29 01                and     #PAD_A
000B2Er 1  D0 0E                bne     @pad
000B30r 1  A9 20                lda     #' '
000B32r 1  60                   rts
000B33r 1  C9 61        @up:    cmp     #'a'
000B35r 1  90 06                bcc     @r
000B37r 1  C9 7B                cmp     #'z'+1
000B39r 1  B0 02                bcs     @r
000B3Br 1  29 DF                and     #$DF
000B3Dr 1  60           @r:     rts
000B3Er 1  20 rr rr     @pad:   jsr     flush_in        ; the space the driver typed for it
000B41r 1  A9 80                lda     #PAD_GO
000B43r 1  60                   rts
000B44r 1               
000B44r 1               ; print the controls line (CTRL_COL, CTRL_ROW)
000B44r 1               show_ctrl:
000B44r 1  20 rr rr             jsr     txt_mode
000B47r 1  A2 00                ldx     #CTRL_COL
000B49r 1  A0 13                ldy     #CTRL_ROW
000B4Br 1  20 rr rr             jsr     gotoxy
000B4Er 1  AD rr rr             lda     ctrl
000B51r 1  F0 07                beq     @kb
000B53r 1  A9 rr                lda     #<ctrl_pad_txt
000B55r 1  A0 rr                ldy     #>ctrl_pad_txt
000B57r 1  4C rr rr             jmp     print
000B5Ar 1  A9 rr        @kb:    lda     #<ctrl_kb_txt
000B5Cr 1  A0 rr                ldy     #>ctrl_kb_txt
000B5Er 1  4C rr rr             jmp     print
000B61r 1               
000B61r 1               ; ============================================================================
000B61r 1               ; start / title
000B61r 1               ; ============================================================================
000B61r 1  D8           start:  cld
000B62r 1  A2 FF                ldx     #$FF
000B64r 1  9A                   txs
000B65r 1  A9 00                lda     #0              ; clear every variable: RAM is random at power-up
000B67r 1  AA                   tax
000B68r 1  A0 04                ldy     #>(bss_end - bss_start + $FF)   ; whole pages (past the end is free RAM)
000B6Ar 1  9D rr rr     @clr:   sta     bss_start,x
000B6Dr 1  E8                   inx
000B6Er 1  D0 FA                bne     @clr
000B70r 1  EE rr rr             inc     @clr+2
000B73r 1  88                   dey
000B74r 1  D0 F4                bne     @clr
000B76r 1  AD rr rr             lda     ctrl_def
000B79r 1  8D rr rr             sta     ctrl
000B7Cr 1  A9 00                lda     #0
000B7Er 1  8D rr rr             sta     cur_skill
000B81r 1  20 rr rr             jsr     read_pad
000B84r 1                       ; the PICO9918?  (CPU Rev2 ROM: a JMP at $FE1B, SBC_SYSINFO)
000B84r 1  AD 1B FE             lda     SBC_SYSINFO
000B87r 1  C9 4C                cmp     #$4C
000B89r 1  D0 07                bne     @nopico
000B8Br 1  20 1B FE             jsr     SBC_SYSINFO
000B8Er 1  C9 02                cmp     #DISP_PICO
000B90r 1  F0 10                beq     @pico
000B92r 1               @nopico:
000B92r 1  A2 00                ldx     #0
000B94r 1  BD rr rr     @m:     lda     need_txt,x
000B97r 1  F0 06                beq     @bye
000B99r 1  20 03 FE             jsr     SBC_CHROUT
000B9Cr 1  E8                   inx
000B9Dr 1  D0 F5                bne     @m
000B9Fr 1  4C 06 FE     @bye:   jmp     SBC_MENU
000BA2r 1  20 rr rr     @pico:  jsr     sfx_init
000BA5r 1  AD rr rr             lda     mute_def
000BA8r 1  8D rr rr             sta     sfx_mute
000BABr 1  20 rr rr             jsr     gfx_init
000BAEr 1  20 rr rr             jsr     mouse_init
000BB1r 1  A9 00                lda     #0
000BB3r 1  8D rr rr             sta     level
000BB6r 1               
000BB6r 1  20 rr rr     title:  jsr     sfx_off
000BB9r 1  A9 F1                lda     #C_TEXT
000BBBr 1  8D rr rr             sta     cls_col
000BBEr 1  A9 rr                lda     #<title_txt
000BC0r 1  A0 rr                ldy     #>title_txt
000BC2r 1  20 rr rr             jsr     print
000BC5r 1                       ; a few creatures marching under the title
000BC5r 1  A9 00                lda     #0
000BC7r 1  8D rr rr             sta     s_op
000BCAr 1  A9 06                lda     #6
000BCCr 1  8D rr rr             sta     tmp2
000BCFr 1  AD rr rr     @demo:  lda     tmp2
000BD2r 1  0A                   asl
000BD3r 1  0A                   asl
000BD4r 1  0A                   asl
000BD5r 1  18                   clc
000BD6r 1  69 32                adc     #50
000BD8r 1  8D rr rr             sta     sx
000BDBr 1  A9 1E                lda     #30
000BDDr 1  8D rr rr             sta     sy
000BE0r 1  A0 00                ldy     #0
000BE2r 1  AD rr rr             lda     tmp2
000BE5r 1  C9 03                cmp     #3
000BE7r 1  D0 02                bne     @d1
000BE9r 1  A0 02                ldy     #2              ; one of them is a blocker
000BEBr 1  20 rr rr     @d1:    jsr     shape_op
000BEEr 1  CE rr rr             dec     tmp2
000BF1r 1  D0 DC                bne     @demo
000BF3r 1  A2 2C                ldx     #44             ; the ground they walk on
000BF5r 1  A0 1F                ldy     #31
000BF7r 1  A9 48                lda     #72
000BF9r 1  20 rr rr             jsr     hline
000BFCr 1  20 rr rr             jsr     show_ctrl
000BFFr 1  20 rr rr             jsr     show_start
000C02r 1  20 rr rr             jsr     read_pad
000C05r 1  20 rr rr             jsr     mouse_flush
000C08r 1  20 rr rr     @wait:  jsr     sfx_poll
000C0Br 1  20 rr rr             jsr     flush_px
000C0Er 1  20 rr rr             jsr     mouse_poll
000C11r 1  AD rr rr             lda     m_click         ; a click: play
000C14r 1  F0 08                beq     @nclk
000C16r 1  A9 00                lda     #0
000C18r 1  8D rr rr             sta     m_click
000C1Br 1  4C rr rr             jmp     play_level
000C1Er 1  20 rr rr     @nclk:  jsr     read_pad        ; gamepad: up / down choose the level,
000C21r 1  AD rr rr             lda     padnew          ; A or Start plays (with the pad)
000C24r 1  29 90                and     #PAD_UP | PAD_RIGHT
000C26r 1  F0 10                beq     @pdn
000C28r 1  AD rr rr             lda     level
000C2Br 1  C9 05                cmp     #NLEVELS-1
000C2Dr 1  B0 D9                bcs     @wait
000C2Fr 1  EE rr rr             inc     level
000C32r 1  20 rr rr             jsr     show_start
000C35r 1  4C rr rr             jmp     @wait
000C38r 1  AD rr rr     @pdn:   lda     padnew
000C3Br 1  29 60                and     #PAD_DOWN | PAD_LEFT
000C3Dr 1  F0 0E                beq     @pgo
000C3Fr 1  AD rr rr             lda     level
000C42r 1  F0 C4                beq     @wait
000C44r 1  CE rr rr             dec     level
000C47r 1  20 rr rr             jsr     show_start
000C4Ar 1  4C rr rr             jmp     @wait
000C4Dr 1  AD rr rr     @pgo:   lda     padnew
000C50r 1  29 09                and     #PAD_A | PAD_START
000C52r 1  F0 0B                beq     @key
000C54r 1  A9 01                lda     #1
000C56r 1  8D rr rr             sta     ctrl
000C59r 1  20 rr rr             jsr     flush_in
000C5Cr 1  4C rr rr             jmp     play_level
000C5Fr 1  20 00 FE     @key:   jsr     getc
000C62r 1  90 A4                bcc     @wait
000C64r 1  C9 61                cmp     #'a'
000C66r 1  90 06                bcc     @uc
000C68r 1  C9 7B                cmp     #'z'+1
000C6Ar 1  B0 02                bcs     @uc
000C6Cr 1  29 DF                and     #$DF
000C6Er 1  C9 51        @uc:    cmp     #'Q'
000C70r 1  D0 03                bne     @nq
000C72r 1  4C rr rr             jmp     exit_game
000C75r 1  C9 4D        @nq:    cmp     #'M'            ; sound on / off
000C77r 1  D0 06                bne     @nm
000C79r 1  20 rr rr             jsr     sfx_toggle
000C7Cr 1  4C rr rr             jmp     @wait
000C7Fr 1  C9 47        @nm:    cmp     #'G'            ; switch keyboard / gamepad
000C81r 1  D0 0E                bne     @ng
000C83r 1  AD rr rr             lda     ctrl
000C86r 1  49 01                eor     #1
000C88r 1  8D rr rr             sta     ctrl
000C8Br 1  20 rr rr             jsr     show_ctrl
000C8Er 1  4C rr rr             jmp     @wait
000C91r 1  C9 20        @ng:    cmp     #' '
000C93r 1  F0 11                beq     @go
000C95r 1  C9 31                cmp     #'1'
000C97r 1  90 04                bcc     @w2
000C99r 1  C9 37                cmp     #'1'+NLEVELS
000C9Br 1  90 03                bcc     @lv
000C9Dr 1  4C rr rr     @w2:    jmp     @wait
000CA0r 1               @lv:
000CA0r 1  38                   sec
000CA1r 1  E9 31                sbc     #'1'
000CA3r 1  8D rr rr             sta     level
000CA6r 1  4C rr rr     @go:    jmp     play_level
000CA9r 1               
000CA9r 1               ; "START AT LEVEL n" on the title screen
000CA9r 1               show_start:
000CA9r 1  20 rr rr             jsr     txt_mode
000CACr 1  A2 08                ldx     #8
000CAEr 1  A0 14                ldy     #CTRL_ROW+1
000CB0r 1  20 rr rr             jsr     gotoxy
000CB3r 1  A9 rr                lda     #<startlv_txt
000CB5r 1  A0 rr                ldy     #>startlv_txt
000CB7r 1  20 rr rr             jsr     print
000CBAr 1  AD rr rr             lda     level
000CBDr 1  18                   clc
000CBEr 1  69 31                adc     #'1'
000CC0r 1  4C rr rr             jmp     putc
000CC3r 1               
000CC3r 1               exit_game:
000CC3r 1  20 rr rr             jsr     sfx_off
000CC6r 1  20 rr rr             jsr     mouse_off
000CC9r 1  20 39 FE             jsr     SBC_CONRESET    ; the console's text screen back
000CCCr 1               exit_menu:
000CCCr 1  4C 06 FE             jmp     SBC_MENU        ; back to the boot menu
000CCFr 1               
000CCFr 1               ; ============================================================================
000CCFr 1               ; a level
000CCFr 1               ; ============================================================================
000CCFr 1               play_level:
000CCFr 1  20 rr rr             jsr     load_level
000CD2r 1  20 rr rr             jsr     intro           ; shows the level; carry set = Q pressed
000CD5r 1  90 03                bcc     @go
000CD7r 1  4C rr rr             jmp     title
000CDAr 1  20 rr rr     @go:    jsr     draw_level
000CDDr 1  20 rr rr             jsr     sfx_off         ; the tune, and off they go
000CE0r 1  A9 00                lda     #MUS_STROLL
000CE2r 1  20 rr rr             jsr     sfx_snd
000CE5r 1  A9 01                lda     #MUS_STROLL+1
000CE7r 1  20 rr rr             jsr     sfx_snd
000CEAr 1  A9 09                lda     #SND_START
000CECr 1  20 rr rr             jsr     sfx_snd
000CEFr 1  20 2D FE             jsr     SBC_TICKS
000CF2r 1  8D rr rr             sta     last_tick
000CF5r 1  20 rr rr             jsr     mouse_flush
000CF8r 1  4C rr rr             jmp     game_loop
000CFBr 1               
000CFBr 1               ; read the header of level `level` and build its terrain bitmap
000CFBr 1               load_level:
000CFBr 1  AE rr rr             ldx     level
000CFEr 1  BD rr rr             lda     lv_tab_lo,x
000D01r 1  BC rr rr             ldy     lv_tab_hi,x
000D04r 1  20 rr rr             jsr     lv_set
000D07r 1  20 rr rr             jsr     lv_get
000D0Ar 1  8D rr rr             sta     total
000D0Dr 1  20 rr rr             jsr     lv_get
000D10r 1  8D rr rr             sta     need
000D13r 1  20 rr rr             jsr     lv_get
000D16r 1  8D rr rr             sta     rate
000D19r 1  8D rr rr             sta     min_rate
000D1Cr 1  20 rr rr             jsr     lv_get
000D1Fr 1  8D rr rr             sta     time_bcd        ; seconds, BCD, low byte first
000D22r 1  20 rr rr             jsr     lv_get
000D25r 1  8D rr rr             sta     time_bcd+1
000D28r 1  A2 00                ldx     #0
000D2Ar 1  20 rr rr     @sk:    jsr     lv_get
000D2Dr 1  9D rr rr             sta     skills,x
000D30r 1  E8                   inx
000D31r 1  E0 06                cpx     #NSKILLS
000D33r 1  D0 F5                bne     @sk
000D35r 1  20 rr rr             jsr     lv_get
000D38r 1  8D rr rr             sta     hx
000D3Br 1  20 rr rr             jsr     lv_get
000D3Er 1  8D rr rr             sta     hy
000D41r 1  20 rr rr             jsr     lv_get
000D44r 1  8D rr rr             sta     ex
000D47r 1  20 rr rr             jsr     lv_get
000D4Ar 1  8D rr rr             sta     ey
000D4Dr 1  AD rr rr             lda     lv_rd+1         ; the name starts here
000D50r 1  8D rr rr             sta     name_ptr
000D53r 1  AD rr rr             lda     lv_rd+2
000D56r 1  8D rr rr             sta     name_ptr+1
000D59r 1  20 rr rr     @nm:    jsr     lv_get          ; skip it
000D5Cr 1  C9 FF                cmp     #TERM
000D5Er 1  D0 F9                bne     @nm
000D60r 1                       ; clear the bitmap (7 pages)
000D60r 1  A9 rr                lda     #>terrain
000D62r 1  8D rr rr             sta     @st+2
000D65r 1  A9 00                lda     #0
000D67r 1  AA                   tax
000D68r 1  9D rr rr     @st:    sta     terrain,x
000D6Br 1  E8                   inx
000D6Cr 1  D0 FA                bne     @st
000D6Er 1  EE rr rr             inc     @st+2
000D71r 1  AC rr rr             ldy     @st+2
000D74r 1  C0 rr                cpy     #>terrain + 7
000D76r 1  90 F0                bcc     @st
000D78r 1                       ; terrain commands
000D78r 1  20 rr rr     @cmd:   jsr     lv_get
000D7Br 1  F0 2E                beq     @end
000D7Dr 1  8D rr rr             sta     cmd
000D80r 1  20 rr rr             jsr     lv_get
000D83r 1  8D rr rr             sta     rx
000D86r 1  20 rr rr             jsr     lv_get
000D89r 1  8D rr rr             sta     ry
000D8Cr 1  20 rr rr             jsr     lv_get
000D8Fr 1  8D rr rr             sta     rw
000D92r 1  AD rr rr             lda     cmd
000D95r 1  C9 52                cmp     #'R'
000D97r 1  D0 0C                bne     @ramp
000D99r 1  20 rr rr             jsr     lv_get
000D9Cr 1  8D rr rr             sta     rh
000D9Fr 1  20 rr rr             jsr     fill_rect
000DA2r 1  4C rr rr             jmp     @cmd
000DA5r 1  20 rr rr     @ramp:  jsr     fill_ramp
000DA8r 1  4C rr rr             jmp     @cmd
000DABr 1               @end:   ; reset the game state
000DABr 1  A2 13                ldx     #MAXC-1
000DADr 1  A9 00                lda     #0
000DAFr 1  9D rr rr     @cl:    sta     c_st,x
000DB2r 1  9D rr rr             sta     d_on,x
000DB5r 1  CA                   dex
000DB6r 1  10 F7                bpl     @cl
000DB8r 1  A9 00                lda     #0
000DBAr 1  8D rr rr             sta     released
000DBDr 1  8D rr rr             sta     saved
000DC0r 1  8D rr rr             sta     out
000DC3r 1  8D rr rr             sta     tdiv
000DC6r 1  8D rr rr             sta     nuking
000DC9r 1  A9 FF                lda     #$FF
000DCBr 1  8D rr rr             sta     sel
000DCEr 1  A9 0A                lda     #10
000DD0r 1  8D rr rr             sta     rel_t
000DD3r 1  60                   rts
000DD4r 1               
000DD4r 1               ; level data reader (self-modifying pointer).  Preserves X and Y.
000DD4r 1  8D rr rr     lv_set: sta     lv_rd+1
000DD7r 1  8C rr rr             sty     lv_rd+2
000DDAr 1  60                   rts
000DDBr 1               lv_get:
000DDBr 1  AD FF FF     lv_rd:  lda     $FFFF
000DDEr 1  EE rr rr             inc     lv_rd+1
000DE1r 1  D0 03                bne     @r
000DE3r 1  EE rr rr             inc     lv_rd+2
000DE6r 1  C9 00        @r:     cmp     #0              ; flags reflect the byte
000DE8r 1  60                   rts
000DE9r 1               
000DE9r 1               ; fill rx, ry, rw x rh
000DE9r 1               fill_rect:
000DE9r 1  AD rr rr             lda     ry
000DECr 1  8D rr rr             sta     fy
000DEFr 1  AD rr rr             lda     rh
000DF2r 1  8D rr rr             sta     fh
000DF5r 1  AE rr rr     @row:   ldx     rx
000DF8r 1  AD rr rr             lda     rw
000DFBr 1  8D rr rr             sta     fw
000DFEr 1  AC rr rr             ldy     fy
000E01r 1  20 rr rr     @px:    jsr     t_setbit
000E04r 1  E8                   inx
000E05r 1  CE rr rr             dec     fw
000E08r 1  D0 F7                bne     @px
000E0Ar 1  EE rr rr             inc     fy
000E0Dr 1  CE rr rr             dec     fh
000E10r 1  D0 E3                bne     @row
000E12r 1  60                   rts
000E13r 1               
000E13r 1               ; ramp: rw columns starting at rx; 'U' rises to the right, 'D' falls.
000E13r 1               ; Column i is filled from its top down to row ry.
000E13r 1               fill_ramp:
000E13r 1  A9 00                lda     #0
000E15r 1  8D rr rr             sta     fw              ; column counter
000E18r 1  AD rr rr     @col:   lda     cmd
000E1Br 1  C9 55                cmp     #'U'
000E1Dr 1  F0 0D                beq     @up
000E1Fr 1  AD rr rr             lda     rw              ; D: top = ry - (rw-1-i)
000E22r 1  38                   sec
000E23r 1  E9 01                sbc     #1
000E25r 1  38                   sec
000E26r 1  ED rr rr             sbc     fw
000E29r 1  4C rr rr             jmp     @top
000E2Cr 1  AD rr rr     @up:    lda     fw              ; U: top = ry - i
000E2Fr 1  8D rr rr     @top:   sta     tmp
000E32r 1  AD rr rr             lda     ry
000E35r 1  38                   sec
000E36r 1  ED rr rr             sbc     tmp
000E39r 1  A8                   tay
000E3Ar 1  AD rr rr             lda     rx
000E3Dr 1  18                   clc
