0005ADr 1  8D rr rr             sta     pmask
0005B0r 1  AD rr rr             lda     px_x
0005B3r 1  29 01                and     #1
0005B5r 1  0D rr rr             ora     pmask
0005B8r 1  A8                   tay
0005B9r 1  B9 rr rr             lda     bitmask8,y
0005BCr 1  60                   rts
0005BDr 1               
