0006DAr 1  8D rr rr             sta     dg_t
0006DDr 1  AD rr rr             lda     grp+3
0006E0r 1  29 03                and     #3
0006E2r 1  A8                   tay
0006E3r 1  B9 rr rr             lda     od_64,y
0006E6r 1  0D rr rr             ora     dg_t
0006E9r 1  8D rr rr             sta     dg_t
0006ECr 1  AD rr rr             lda     grp+4
0006EFr 1  29 03                and     #3
0006F1r 1  A8                   tay
0006F2r 1  B9 rr rr             lda     ev_31,y
0006F5r 1  0D rr rr             ora     dg_t
0006F8r 1  8D rr rr             sta     dg_t
0006FBr 1  AD rr rr             lda     grp+5
0006FEr 1  29 03                and     #3
000700r 1  A8                   tay
000701r 1  B9 rr rr             lda     od_0,y
000704r 1  0D rr rr             ora     dg_t
