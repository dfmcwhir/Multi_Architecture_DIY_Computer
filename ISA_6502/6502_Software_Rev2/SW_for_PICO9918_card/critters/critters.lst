000554r 1  8D rr rr             sta     pmask
000557r 1  20 rr rr             jsr     want_rd
00055Ar 1  8D rr rr             sta     pold
00055Dr 1  2D rr rr             and     pmask
000560r 1  CD rr rr     px_put: cmp     pold
000563r 1  F0 2B                beq     @r              ; no change
000565r 1  48                   pha
000566r 1  AD rr rr             lda     pold            ; already different from the screen: listed
000569r 1  20 rr rr             jsr     shown_cmp
00056Cr 1  D0 1E                bne     @w
00056Er 1  AE rr rr             ldx     dl_n
000571r 1  E0 C8                cpx     #DLMAX
000573r 1  B0 12                bcs     @full
000575r 1  AD rr rr             lda     pc_col
000578r 1  9D rr rr             sta     dl_c,x
00057Br 1  AD rr rr             lda     pc_row
00057Er 1  9D rr rr             sta     dl_r,x
000581r 1  EE rr rr             inc     dl_n
000584r 1  4C rr rr             jmp     @w
000587r 1  A9 01        @full:  lda     #1              ; too many: flush_px looks at everything
000589r 1  8D rr rr             sta     dl_full
00058Cr 1  68           @w:     pla
00058Dr 1  20 rr rr             jsr     want_wr
000590r 1  AE rr rr     @r:     ldx     px_x
000593r 1  AC rr rr             ldy     px_y
000596r 1  60                   rts
000597r 1               
000597r 1               ; point want_rd / want_wr / shown_cmp / shown_wr at the character holding
000597r 1               ; pixel X, Y.  A = the pixel's bit in it.
