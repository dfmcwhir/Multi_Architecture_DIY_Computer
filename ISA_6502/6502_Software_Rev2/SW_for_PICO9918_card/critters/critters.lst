000690r 1  B9 FF FF     @w2:    lda     $FFFF,y
000693r 1  99 rr rr             sta     grp,y
000696r 1  99 FF FF     @s2:    sta     $FFFF,y
000699r 1  88                   dey
00069Ar 1  10 F4                bpl     @w2
00069Cr 1  20 rr rr             jsr     sfx_poll
00069Fr 1                       ; fall through
00069Fr 1               
00069Fr 1               ; grp[0..7] (row prow, group pgrp) -> its three cells: columns 1 + 3 pgrp ..
00069Fr 1               ; Each character (2 x 4 pixels, bit 2k = row k's left pixel, 2k+1 its
00069Fr 1               ; right) becomes 3 screen pixels across (left, left, right at an even
00069Fr 1               ; column; left, right, right at an odd one) by 8 lines (each pixel row twice).
00069Fr 1               draw_group:
00069Fr 1  A2 00                ldx     #0              ; k
0006A1r 1  8E rr rr     @k:     stx     dg_k
