0008B5r 1               
0008B5r 1               ; wait about A ms.  The inner loop is sized for the clock (CLOCK_MHZ in
0008B5r 1               ; sbc_api.inc): 5 + 4 * (CLOCK_MHZ - 1) cycles a turn, DELAY_N turns a ms.
0008B5r 1               DELAY_N = (1000 * CLOCK_MHZ - 7) / (5 + 4 * (CLOCK_MHZ - 1))
0008B5r 1               delay_ms:
0008B5r 1  48                   pha                     ; (send what was drawn first)
0008B6r 1  20 rr rr             jsr     flush_px
0008B9r 1  68                   pla
0008BAr 1  AA                   tax
0008BBr 1  F0 11                beq     @done
0008BDr 1  20 rr rr     @o:     jsr     sfx_poll        ; (the sound goes on while waiting)
0008C0r 1  A0 EA                ldy     #DELAY_N
0008C2r 1               @i:
0008C2r 1  EA EA EA EA  .repeat CLOCK_MHZ - 1           ; (4 more cycles a turn for each MHz above 1)
0008C6r 1  EA EA        
0008C8r 1                       nop
0008C8r 1                       nop
0008C8r 1               .endrepeat
0008C8r 1  88                   dey
0008C9r 1  D0 F7                bne     @i
0008CBr 1  CA                   dex
0008CCr 1  D0 EF                bne     @o
0008CEr 1  60           @done:  rts
