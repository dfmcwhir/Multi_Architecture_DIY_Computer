000B7Dr 1               ; ============================================================================
000B7Dr 1               ; level loading
000B7Dr 1               ; ============================================================================
000B7Dr 1               ; load the file named in lp_name to LEVEL_BUF.  Carry set on failure (message
000B7Dr 1               ; shown, key waited for).
000B7Dr 1               load_level:
000B7Dr 1  20 rr rr             jsr     cls
000B80r 1  A2 0A                ldx     #10
000B82r 1  A0 08                ldy     #8
000B84r 1  20 rr rr             jsr     t_at
000B87r 1  A9 rr                lda     #<loading_txt
000B89r 1  A0 rr                ldy     #>loading_txt
000B8Br 1  20 rr rr             jsr     t_puts
000B8Er 1  A9 rr                lda     #<lp_name
000B90r 1  A0 rr                ldy     #>lp_name
000B92r 1  20 rr rr             jsr     t_puts
000B95r 1  AD rr rr             lda     has_load
000B98r 1  F0 23                beq     @builtin
000B9Ar 1  A9 rr                lda     #<lp_block
000B9Cr 1  A0 rr                ldy     #>lp_block
000B9Er 1  20 15 FE             jsr     SBC_LOAD
000BA1r 1  90 4E                bcc     @check
000BA3r 1  8D rr rr             sta     load_err
000BA6r 1  A2 03                ldx     #3
000BA8r 1  A0 0A                ldy     #10
000BAAr 1  20 rr rr             jsr     t_at
000BADr 1  A9 rr                lda     #<loaderr_txt
000BAFr 1  A0 rr                ldy     #>loaderr_txt
000BB1r 1  20 rr rr             jsr     t_puts
000BB4r 1  AD rr rr             lda     load_err
000BB7r 1  20 rr rr             jsr     pr_hex
000BBAr 1  4C rr rr             jmp     @fail
000BBDr 1               @builtin:
000BBDr 1  A2 00                ldx     #0              ; only the first map is built in
000BBFr 1  BD rr rr     @cmp:   lda     lp_name,x
000BC2r 1  DD rr rr             cmp     first_name,x
000BC5r 1  D0 4B                bne     @noload
000BC7r 1  E8                   inx
000BC8r 1  E0 09                cpx     #9
000BCAr 1  D0 F3                bne     @cmp
000BCCr 1  A9 rr                lda     #<builtin_level ; copy it (5 pages)
000BCEr 1  8D rr rr             sta     @rd+1
000BD1r 1  A9 rr                lda     #>builtin_level
000BD3r 1  8D rr rr             sta     @rd+2
000BD6r 1  A9 58                lda     #>LEVEL_BUF
000BD8r 1  8D rr rr             sta     @wr+2
000BDBr 1  A2 05                ldx     #5
000BDDr 1  A0 00                ldy     #0
000BDFr 1  B9 FF FF     @rd:    lda     $FFFF,y
000BE2r 1  99 00 58     @wr:    sta     LEVEL_BUF,y
000BE5r 1  C8                   iny
000BE6r 1  D0 F7                bne     @rd
000BE8r 1  EE rr rr             inc     @rd+2
000BEBr 1  EE rr rr             inc     @wr+2
000BEEr 1  CA                   dex
000BEFr 1  D0 EE                bne     @rd
000BF1r 1  AD 00 58     @check: lda     LEVEL_BUF       ; is it a level?
000BF4r 1  C9 44                cmp     #'D'
000BF6r 1  D0 09                bne     @bad
000BF8r 1  AD 01 58             lda     LEVEL_BUF+1
000BFBr 1  C9 36                cmp     #'6'
000BFDr 1  D0 02                bne     @bad
000BFFr 1  18                   clc
000C00r 1  60                   rts
000C01r 1  A2 04        @bad:   ldx     #4
000C03r 1  A0 0A                ldy     #10
000C05r 1  20 rr rr             jsr     t_at
000C08r 1  A9 rr                lda     #<badlvl_txt
000C0Ar 1  A0 rr                ldy     #>badlvl_txt
000C0Cr 1  20 rr rr             jsr     t_puts
000C0Fr 1  4C rr rr             jmp     @fail
000C12r 1  A2 01        @noload:ldx     #1
000C14r 1  A0 0A                ldy     #10
000C16r 1  20 rr rr             jsr     t_at
000C19r 1  A9 rr                lda     #<noload_txt
000C1Br 1  A0 rr                ldy     #>noload_txt
000C1Dr 1  20 rr rr             jsr     t_puts
000C20r 1  A2 0A        @fail:  ldx     #10
000C22r 1  A0 0D                ldy     #13
000C24r 1  20 rr rr             jsr     t_at
000C27r 1  A9 rr                lda     #<anykey_txt
000C29r 1  A0 rr                ldy     #>anykey_txt
