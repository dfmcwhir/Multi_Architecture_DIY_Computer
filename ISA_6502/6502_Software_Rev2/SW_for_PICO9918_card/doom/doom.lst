000888r 1               
000888r 1               ; grp[0..7] (row prow, group pgrp) -> its three cells: columns 1 + 3 * pgrp ..
000888r 1               draw_group:
000888r 1                       ; the four pixel rows of each cell: g0..g2 for row k = 0..3, built from
000888r 1                       ; the 2 bits (left, right) of each character at row k
000888r 1  A2 00                ldx     #0              ; k
