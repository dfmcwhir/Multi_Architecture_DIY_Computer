001037r 1  AD rr rr             lda     mf
00103Ar 1  18                   clc
00103Br 1  6D rr rr             adc     w_lo
00103Er 1  AA                   tax                     ; f + w_lo
00103Fr 1  B0 13                bcs     @b1
001041r 1  38                   sec
001042r 1  BD rr rr             lda     sq_lo,x
001045r 1  F9 rr rr             sbc     sq_lo,y
001048r 1  BD rr rr             lda     sq_hi,x
00104Br 1  F9 rr rr             sbc     sq_hi,y
00104Er 1  8D rr rr             sta     r_lo
001051r 1  4C rr rr             jmp     @p2
001054r 1  38           @b1:    sec
001055r 1  BD rr rr             lda     sq2_lo,x
001058r 1  F9 rr rr             sbc     sq_lo,y
00105Br 1  BD rr rr             lda     sq2_hi,x
00105Er 1  F9 rr rr             sbc     sq_hi,y
001061r 1  8D rr rr             sta     r_lo
001064r 1  AD rr rr     @p2:    lda     mf              ; high product, added in
001067r 1  38                   sec
001068r 1  ED rr rr             sbc     w_hi
00106Br 1  B0 04                bcs     @d2
00106Dr 1  49 FF                eor     #$FF
00106Fr 1  69 01                adc     #1
001071r 1  A8           @d2:    tay
001072r 1  AD rr rr             lda     mf
001075r 1  18                   clc
001076r 1  6D rr rr             adc     w_hi
001079r 1  AA                   tax
