000FDFr 1               ; m_lo/m_hi = A * Y (unsigned 8 x 8), with quarter squares:
000FDFr 1               ; a*b = f(a+b) - f(a-b), f(n) = n*n/4.  Changes X.
000FDFr 1  8D rr rr     mul8:   sta     m_a
000FE2r 1  8C rr rr             sty     m_b
000FE5r 1  18                   clc
000FE6r 1  6D rr rr             adc     m_b
000FE9r 1  AA                   tax
000FEAr 1  B0 0F                bcs     @big
000FECr 1  BD rr rr             lda     sq_lo,x
000FEFr 1  8D rr rr             sta     m_lo
000FF2r 1  BD rr rr             lda     sq_hi,x
