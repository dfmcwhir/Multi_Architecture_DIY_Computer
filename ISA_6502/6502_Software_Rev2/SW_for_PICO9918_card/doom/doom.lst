000A41r 1               ; after the frame is drawn into FB: each cell's wall (from its middle column)
000A41r 1               ; and things (any of its columns), for draw_group
000A41r 1               build_colours:
000A41r 1  A2 1D                ldx     #29             ; the gun: its top row in each cell
000A43r 1  AD rr rr             lda     gun_y
000A46r 1  D0 0D                bne     @gf
000A48r 1  BD rr rr     @g:     lda     gun_cell,x
000A4Br 1  9D C0 6B             sta     CG,x
000A4Er 1  CA                   dex
000A4Fr 1  10 F7                bpl     @g
000A51r 1  A9 E0                lda     #C_GUN
000A53r 1  D0 0B                bne     @gs
000A55r 1  BD rr rr     @gf:    lda     gun_cellf,x     ; (firing: the flash too)
000A58r 1  9D C0 6B             sta     CG,x
000A5Br 1  CA                   dex
000A5Cr 1  10 F7                bpl     @gf
000A5Er 1  A9 B0                lda     #C_FLASH
000A60r 1  8D rr rr     @gs:    sta     cl_g
000A63r 1  A2 1D                ldx     #29
000A65r 1  BC rr rr     @c:     ldy     cellrep,x       ; the wall
000A68r 1  B9 rr rr             lda     c_hgt,y
000A6Br 1  A8                   tay
000A6Cr 1  B9 rr rr             lda     dc_r0,y
000A6Fr 1  0A                   asl
000A70r 1  0A                   asl
000A71r 1  19 rr rr             ora     dc_t0,y
000A74r 1  9D 00 6B             sta     CW0,x
000A77r 1  B9 rr rr             lda     dc_r1,y
000A7Ar 1  0A                   asl
000A7Br 1  0A                   asl
000A7Cr 1  19 rr rr             ora     dc_t1,y
000A7Fr 1  9D 20 6B             sta     CW1,x
000A82r 1  BC rr rr             ldy     cellrep,x
000A85r 1  B9 rr rr             lda     c_pidx,y        ; style * 8 + side * 4 + band
000A88r 1  4A                   lsr
000A89r 1  4A                   lsr
000A8Ar 1  A8                   tay
000A8Br 1  B9 rr rr             lda     wall_col,y
000A8Er 1  9D 40 6B             sta     CWC,x
000A91r 1  A9 FF                lda     #$FF            ; the things
000A93r 1  9D 60 6B             sta     CT0,x
000A96r 1  A9 00                lda     #0
000A98r 1  9D 80 6B             sta     CT1,x
000A9Br 1  BC rr rr             ldy     cellfirst,x
000A9Er 1  B9 50 6A     @t:     lda     TH1,y
000AA1r 1  F0 19                beq     @tn
000AA3r 1  DD 80 6B             cmp     CT1,x
000AA6r 1  90 03                bcc     @t1
000AA8r 1  9D 80 6B             sta     CT1,x
000AABr 1  B9 00 6A     @t1:    lda     TH0,y
000AAEr 1  DD 60 6B             cmp     CT0,x
000AB1r 1  B0 03                bcs     @t0
000AB3r 1  9D 60 6B             sta     CT0,x
000AB6r 1  B9 A0 6A     @t0:    lda     THC,y
000AB9r 1  9D A0 6B             sta     CTC,x
000ABCr 1  98           @tn:    tya
000ABDr 1  DD rr rr             cmp     celllast,x
000AC0r 1  B0 03                bcs     @cn
000AC2r 1  C8                   iny
000AC3r 1  D0 D9                bne     @t
000AC5r 1  CA           @cn:    dex
000AC6r 1  10 9D                bpl     @c
000AC8r 1  A9 01                lda     #1
000ACAr 1  8D rr rr             sta     col_on
000ACDr 1  60                   rts
000ACEr 1               
000ACEr 1               ; forget what the screen shows: the next frame is drawn whole
000ACEr 1               clear_sb:
000ACEr 1  A9 01                lda     #1              ; (the next frame must be drawn)
000AD0r 1  8D rr rr             sta     force
000AD3r 1  8D rr rr             sta     pfull           ; (all of it: blank cells need their colours)
000AD6r 1  A9 00                lda     #0
000AD8r 1  A2 00                ldx     #0
000ADAr 1  9D 00 64 9D  @l:     .repeat 6, K
000ADEr 1  00 65 9D 00  
000AE2r 1  66 9D 00 67  
000AECr 1                       sta     SB + K * 256,x
000AECr 1                       .endrepeat
000AECr 1  E8                   inx
000AEDr 1  D0 EB                bne     @l
000AEFr 1  60                   rts
000AF0r 1               
000AF0r 1               ; ============================================================================
000AF0r 1               ; gamepad and menu input (shared by the SBC games)
000AF0r 1               ; ============================================================================
000AF0r 1               PAD_A           = $01           ; bits returned by SBC_PADSTATE
000AF0r 1               PAD_B           = $02
000AF0r 1               PAD_SELECT      = $04
000AF0r 1               PAD_START       = $08
000AF0r 1               PAD_UP          = $10
000AF0r 1               PAD_DOWN        = $20
000AF0r 1               PAD_LEFT        = $40
000AF0r 1               PAD_RIGHT       = $80
000AF0r 1               PAD_GO          = $80           ; menu_key's answer for gamepad A or Start
000AF0r 1               
000AF0r 1               ; read the gamepad: pad = buttons held now, padnew = buttons pressed since
000AF0r 1               ; the last call.  Preserves X and Y (SBC_PADSTATE only changes A).
000AF0r 1               read_pad:
000AF0r 1  20 12 FE             jsr     SBC_PADSTATE
000AF3r 1  C9 FF                cmp     #$FF            ; every button "pressed" = no pad
000AF5r 1  D0 02                bne     @ok
000AF7r 1  A9 00                lda     #0
000AF9r 1  8D rr rr     @ok:    sta     pad
000AFCr 1  AD rr rr             lda     padold
000AFFr 1  49 FF                eor     #$FF
000B01r 1  2D rr rr             and     pad
000B04r 1  8D rr rr             sta     padnew
000B07r 1  AD rr rr             lda     pad
000B0Ar 1  8D rr rr             sta     padold
000B0Dr 1  60                   rts
000B0Er 1               
000B0Er 1               ; throw away waiting characters
000B0Er 1               flush_in:
000B0Er 1  20 00 FE             jsr     getc
000B11r 1  B0 FB                bcs     flush_in
000B13r 1  60                   rts
000B14r 1               
000B14r 1               ; carry set if A is one of the characters the gamepad driver types for the
000B14r 1               ; pad (W A S D and space).  Those are ignored in gamepad mode so that one
000B14r 1               ; press doesn't act twice.  Preserves A.
000B14r 1               pad_typed:
000B14r 1  C9 20                cmp     #' '
000B16r 1  F0 12                beq     @y
000B18r 1  C9 57                cmp     #'W'
000B1Ar 1  F0 0E                beq     @y
000B1Cr 1  C9 41                cmp     #'A'
000B1Er 1  F0 0A                beq     @y
000B20r 1  C9 53                cmp     #'S'
000B22r 1  F0 06                beq     @y
000B24r 1  C9 44                cmp     #'D'
000B26r 1  F0 02                beq     @y
000B28r 1  18                   clc
000B29r 1  60                   rts
000B2Ar 1  38           @y:     sec
000B2Br 1  60                   rts
000B2Cr 1               
000B2Cr 1               ; wait for a menu choice.  Returns a key (letters in upper case), or
000B2Cr 1               ; PAD_GO for the gamepad's A or Start button.
000B2Cr 1               menu_key:
000B2Cr 1  20 rr rr 20  @l:     MENU_IDLE
000B30r 1  rr rr        
000B32r 1  20 rr rr             jsr     read_pad
000B35r 1  AD rr rr             lda     padnew
000B38r 1  29 09                and     #PAD_A | PAD_START
000B3Ar 1  D0 21                bne     @pad
000B3Cr 1  20 00 FE             jsr     getc
000B3Fr 1  90 EB                bcc     @l
000B41r 1  C9 20                cmp     #' '            ; a space typed by the pad's A button?
000B43r 1  D0 0D                bne     @up
000B45r 1  20 rr rr             jsr     read_pad
000B48r 1  AD rr rr             lda     pad
000B4Br 1  29 01                and     #PAD_A
000B4Dr 1  D0 0E                bne     @pad
000B4Fr 1  A9 20                lda     #' '
000B51r 1  60                   rts
000B52r 1  C9 61        @up:    cmp     #'a'
000B54r 1  90 06                bcc     @r
000B56r 1  C9 7B                cmp     #'z'+1
000B58r 1  B0 02                bcs     @r
000B5Ar 1  29 DF                and     #$DF
000B5Cr 1  60           @r:     rts
000B5Dr 1  20 rr rr     @pad:   jsr     flush_in        ; the space the driver typed for it
000B60r 1  A9 80                lda     #PAD_GO
000B62r 1  60                   rts
000B63r 1               
000B63r 1               
000B63r 1               
000B63r 1               ; print the controls line on the title screen
000B63r 1               show_ctrl:
000B63r 1  A2 01                ldx     #1
