0002BAr 2  20 rr rr     @noi:   jsr     sfx_byte
0002BDr 2  9D rr rr             sta     sfx_noise,x
0002C0r 2  4C rr rr             jmp     @cmd
0002C3r 2  20 rr rr     @mix:   jsr     sfx_byte
0002C6r 2  9D rr rr             sta     sfx_mix,x
0002C9r 2  4C rr rr             jmp     @cmd
0002CCr 2  20 rr rr     @sw:    jsr     sfx_byte
0002CFr 2  9D rr rr             sta     sfx_swl,x
0002D2r 2  20 rr rr             jsr     sfx_byte
0002D5r 2  9D rr rr             sta     sfx_swh,x
0002D8r 2  4C rr rr             jmp     @cmd
0002DBr 2  20 rr rr     @dc:    jsr     sfx_byte
0002DEr 2  9D rr rr             sta     sfx_dec,x
0002E1r 2  9D rr rr             sta     sfx_decc,x
0002E4r 2  4C rr rr             jmp     @cmd
0002E7r 2  20 rr rr     @lp:    jsr     sfx_byte
0002EAr 2  9D rr rr             sta     sfx_lcnt,x
0002EDr 2  BD rr rr             lda     sfx_lo,x
0002F0r 2  9D rr rr             sta     sfx_lpl,x
0002F3r 2  BD rr rr             lda     sfx_hi,x
0002F6r 2  9D rr rr             sta     sfx_lph,x
0002F9r 2  4C rr rr             jmp     @cmd
0002FCr 2  BD rr rr     @nx:    lda     sfx_lcnt,x
0002FFr 2  F0 05                beq     @back           ; (0: for ever)
000301r 2  DE rr rr             dec     sfx_lcnt,x
000304r 2  F0 0C                beq     @go
000306r 2  BD rr rr     @back:  lda     sfx_lpl,x
000309r 2  9D rr rr             sta     sfx_lo,x
00030Cr 2  BD rr rr             lda     sfx_lph,x
00030Fr 2  9D rr rr             sta     sfx_hi,x
000312r 2  4C rr rr     @go:    jmp     @cmd
000315r 2  20 rr rr     @jp:    jsr     sfx_byte
000318r 2  48                   pha
000319r 2  20 rr rr             jsr     sfx_byte
00031Cr 2  9D rr rr             sta     sfx_hi,x
00031Fr 2  68                   pla
000320r 2  9D rr rr             sta     sfx_lo,x
000323r 2  4C rr rr             jmp     @cmd
000326r 2  A9 00        @rest:  lda     #0
000328r 2  9D rr rr             sta     sfx_vol,x
00032Br 2  4C rr rr             jmp     @len
00032Er 2  20 rr rr     @ln:    jsr     sfx_byte
000331r 2  9D rr rr             sta     sfx_len,x
000334r 2  4C rr rr             jmp     @cmd
000337r 2               
000337r 2               ; the next byte of voice X's script
000337r 2               sfx_byte:
000337r 2  BD rr rr             lda     sfx_lo,x
00033Ar 2  8D rr rr             sta     @ld+1
00033Dr 2  BD rr rr             lda     sfx_hi,x
000340r 2  8D rr rr             sta     @ld+2
000343r 2  AD FF FF     @ld:    lda     $FFFF
000346r 2  FE rr rr             inc     sfx_lo,x
000349r 2  D0 03                bne     @r
00034Br 2  FE rr rr             inc     sfx_hi,x
00034Er 2  60           @r:     rts
00034Fr 2               
00034Fr 2               ; the tone periods of C1 .. B1 for the 2 MHz chip clock: 2 MHz / (16 x
00034Fr 2               ; frequency); each octave up is half (to within a third of a percent)
00034Fr 2  EE 18 4D 8E  sfx_c1_lo:  .lobytes 3822, 3608, 3405, 3214, 3034, 2863, 2703, 2551, 2408, 2273, 2145, 2025
000353r 2  DA 2F 8F F7  
000357r 2  68 E1 61 E9  
00035Br 2  0E 0E 0D 0C  sfx_c1_hi:  .hibytes 3822, 3608, 3405, 3214, 3034, 2863, 2703, 2551, 2408, 2273, 2145, 2025
00035Fr 2  0B 0B 0A 09  
000363r 2  09 08 08 07  
000367r 2               
000367r 2               
000367r 1                       .include "lib/vdp.s"    ; the PICO9918 routines
000367r 2               ; ============================================================================
000367r 2               ; vdp.s - PICO9918 / TMS9918A routines shared by the SBC games (CPU Rev2)
000367r 2               ;
000367r 2               ; Include it after setting VDP_NAME (the name table's VRAM address):
000367r 2               ;           VDP_NAME = $1800
000367r 2               ;           .include "lib/vdp.s"
000367r 2               ; No zero page is used: the copy routines patch their own addresses.
000367r 2               ;
000367r 2               ;   vdp_setup   A/Y -> 8 bytes: R0-R7.  Puts a PICO9918 (F18A mode) back to
000367r 2               ;               plain TMS9918A behaviour first (24 rows, all 32 sprites, no
000367r 2               ;               scrolling, no second tile layer; the unlock leaves VR30 at
000367r 2               ;               31 sprites a line),
000367r 2               ;               clears the 16K of VRAM, then loads R0-R7.  Interrupts from
000367r 2               ;               the VDP should be off in R1 (bit 5): the games poll.
000367r 2               ;   vdp_reg     register X = A
000367r 2               ;   vdp_waddr   VRAM write address = A (low) / Y (high)
000367r 2               ;   vdp_fill    write A to VRAM vdp_n (16 bit) times, from the address set
000367r 2               ;   vdp_copy    copy vdp_n bytes from RAM vdp_src to VRAM (from the address set)
000367r 2               ;   vdp_at      write address = the name table cell at column X, row Y
000367r 2               ;   vdp_puts    write the 0-ended string at A/Y from there (names = ASCII)
000367r 2               ;   vdp_bcd     write A as two digits
000367r 2               ;   vdp_frame   wait for the next frame (60 a second), calling frame_idle
000367r 2               ;               (the game's: sound, random numbers) while it waits
000367r 2               ;
000367r 2               ; The VDP's ports: data $7F1C, control/status $7F1D.  Reading the status
000367r 2               ; clears the frame flag, so nothing else should read it while a game runs
000367r 2               ; (the ROM doesn't, with PICO_IRQ = 0 in its config.inc, the default).
000367r 2               ; ============================================================================
000367r 2               
000367r 2               VDP_DATA        = $7F1C
000367r 2               VDP_CTRL        = $7F1D
000367r 2               
000367r 2               ; register X = A.  Keeps A, X, Y.
000367r 2               vdp_reg:
000367r 2  8D 1D 7F             sta     VDP_CTRL
00036Ar 2  48                   pha
00036Br 2  8A                   txa
00036Cr 2  09 80                ora     #$80
00036Er 2  8D 1D 7F             sta     VDP_CTRL
000371r 2  68                   pla
000372r 2  60                   rts
000373r 2               
000373r 2               ; VRAM write address = A (low) / Y (high).  Keeps A, X, Y.
000373r 2               vdp_waddr:
000373r 2  8D 1D 7F             sta     VDP_CTRL
000376r 2  48                   pha
000377r 2  98                   tya
000378r 2  29 3F                and     #$3F
00037Ar 2  09 40                ora     #$40
00037Cr 2  8D 1D 7F             sta     VDP_CTRL
00037Fr 2  68                   pla
000380r 2  60                   rts
000381r 2               
000381r 2               ; write A, vdp_n times.  Keeps A.
000381r 2               vdp_fill:
000381r 2  AE rr rr             ldx     vdp_n           ; the odd bytes first
000384r 2  F0 06                beq     @pg
000386r 2  8D 1C 7F     @lo:    sta     VDP_DATA
000389r 2  CA                   dex
00038Ar 2  D0 FA                bne     @lo
00038Cr 2  AC rr rr     @pg:    ldy     vdp_n+1         ; then whole pages
00038Fr 2  F0 0B                beq     @done
000391r 2  A2 00        @p:     ldx     #0
000393r 2  8D 1C 7F     @pp:    sta     VDP_DATA
000396r 2  CA                   dex
000397r 2  D0 FA                bne     @pp
000399r 2  88                   dey
00039Ar 2  D0 F5                bne     @p
00039Cr 2  60           @done:  rts
00039Dr 2               
00039Dr 2               ; copy vdp_n bytes from vdp_src to VRAM
00039Dr 2               vdp_copy:
00039Dr 2  AD rr rr             lda     vdp_src
0003A0r 2  8D rr rr             sta     @rd+1
0003A3r 2  AD rr rr             lda     vdp_src+1
0003A6r 2  8D rr rr             sta     @rd+2
0003A9r 2  AD rr rr             lda     vdp_n
0003ACr 2  8D rr rr             sta     vdp_t
0003AFr 2  AD rr rr             lda     vdp_n+1
0003B2r 2  8D rr rr             sta     vdp_t+1
0003B5r 2  AD rr rr     @l:     lda     vdp_t
0003B8r 2  0D rr rr             ora     vdp_t+1
0003BBr 2  F0 1C                beq     @done
0003BDr 2  AD FF FF     @rd:    lda     $FFFF
0003C0r 2  8D 1C 7F             sta     VDP_DATA
0003C3r 2  EE rr rr             inc     @rd+1
0003C6r 2  D0 03                bne     :+
0003C8r 2  EE rr rr             inc     @rd+2
0003CBr 2  AD rr rr     :       lda     vdp_t
0003CEr 2  D0 03                bne     :+
0003D0r 2  CE rr rr             dec     vdp_t+1
0003D3r 2  CE rr rr     :       dec     vdp_t
0003D6r 2  4C rr rr             jmp     @l
0003D9r 2  60           @done:  rts
0003DAr 2               
0003DAr 2               ; A/Y -> 8 register values.  Clears VRAM.
0003DAr 2               vdp_setup:
0003DAr 2  8D rr rr             sta     @rr+1
0003DDr 2  8C rr rr             sty     @rr+2
0003E0r 2  AD 1D 7F             lda     VDP_CTRL        ; (resets the register write latch)
0003E3r 2  A9 80                lda     #$80            ; R1 = $80: display off while we work
0003E5r 2  A2 01                ldx     #1
0003E7r 2  20 rr rr             jsr     vdp_reg
0003EAr 2  A9 1C                lda     #$1C            ; F18A unlock (a PICO9918): $1C twice to VR57
0003ECr 2  A2 39                ldx     #57
0003EEr 2  20 rr rr             jsr     vdp_reg
0003F1r 2  20 rr rr             jsr     vdp_reg
0003F4r 2  A9 00                lda     #0              ; VR49: 24 rows, no 80 columns, no layer 2
0003F6r 2  A2 31                ldx     #49
0003F8r 2  20 rr rr             jsr     vdp_reg
0003FBr 2  A2 32                ldx     #50             ; VR50: plain TMS9918A behaviour
0003FDr 2  20 rr rr             jsr     vdp_reg
000400r 2  A2 13                ldx     #19             ; VR19: no line interrupt
000402r 2  20 rr rr             jsr     vdp_reg
000405r 2  A2 19                ldx     #25             ; VR25-VR29: no scrolling, one page
000407r 2  20 rr rr     @sc:    jsr     vdp_reg
00040Ar 2  E8                   inx
00040Br 2  E0 1E                cpx     #30
00040Dr 2  D0 F8                bne     @sc
00040Fr 2  A9 20                lda     #32             ; VR51: all 32 sprites
000411r 2  A2 33                ldx     #51
000413r 2  20 rr rr             jsr     vdp_reg
000416r 2                       ; (on a real TMS9918A those writes land in R0-R7: all set below)
000416r 2  A9 80                lda     #$80            ; R1 again: display off
000418r 2  A2 01                ldx     #1
00041Ar 2  20 rr rr             jsr     vdp_reg
00041Dr 2  A9 00                lda     #0              ; clear the 16K
00041Fr 2  A8                   tay
000420r 2  20 rr rr             jsr     vdp_waddr
000423r 2  A9 00                lda     #$00
000425r 2  8D rr rr             sta     vdp_n
000428r 2  A9 40                lda     #$40
00042Ar 2  8D rr rr             sta     vdp_n+1
00042Dr 2  A9 00                lda     #0
00042Fr 2  20 rr rr             jsr     vdp_fill
000432r 2  A2 00                ldx     #0
000434r 2  BD FF FF     @rr:    lda     $FFFF,x
000437r 2  20 rr rr             jsr     vdp_reg
00043Ar 2  E8                   inx
00043Br 2  E0 08                cpx     #8
00043Dr 2  D0 F5                bne     @rr
00043Fr 2  60                   rts
000440r 2               
000440r 2               ; write address = name table cell X (column), Y (row).  Keeps X and Y.
000440r 2               vdp_at:
000440r 2  8E rr rr             stx     vdp_t
000443r 2  98                   tya
000444r 2  4A                   lsr                     ; row * 32: high byte = row / 8
000445r 2  4A                   lsr
000446r 2  4A                   lsr
000447r 2  8D rr rr             sta     vdp_t+1
00044Ar 2  98                   tya
00044Br 2  0A                   asl
00044Cr 2  0A                   asl
00044Dr 2  0A                   asl
00044Er 2  0A                   asl
00044Fr 2  0A                   asl                     ; low byte = (row & 7) * 32
000450r 2  18                   clc
000451r 2  6D rr rr             adc     vdp_t
000454r 2  18                   clc
000455r 2  69 00                adc     #<VDP_NAME
000457r 2  8D 1D 7F             sta     VDP_CTRL
00045Ar 2  AD rr rr             lda     vdp_t+1
00045Dr 2  69 38                adc     #>VDP_NAME
00045Fr 2  29 3F                and     #$3F
000461r 2  09 40                ora     #$40
000463r 2  8D 1D 7F             sta     VDP_CTRL
000466r 2  60                   rts
000467r 2               
000467r 2               ; write the 0-ended string at A/Y.  Keeps X.
000467r 2               vdp_puts:
000467r 2  8D rr rr             sta     @rd+1
00046Ar 2  8C rr rr             sty     @rd+2
00046Dr 2  A0 00                ldy     #0
00046Fr 2  B9 FF FF     @rd:    lda     $FFFF,y
000472r 2  F0 06                beq     @done
000474r 2  8D 1C 7F             sta     VDP_DATA
000477r 2  C8                   iny
000478r 2  D0 F5                bne     @rd
00047Ar 2  60           @done:  rts
00047Br 2               
00047Br 2               ; A as two BCD digits.  Keeps X, Y.
00047Br 2               vdp_bcd:
00047Br 2  48                   pha
00047Cr 2  4A                   lsr
00047Dr 2  4A                   lsr
00047Er 2  4A                   lsr
00047Fr 2  4A                   lsr
000480r 2  09 30                ora     #'0'
000482r 2  8D 1C 7F             sta     VDP_DATA
000485r 2  68                   pla
000486r 2  48                   pha
000487r 2  29 0F                and     #$0F
000489r 2  09 30                ora     #'0'
00048Br 2  8D 1C 7F             sta     VDP_DATA
00048Er 2  68                   pla
00048Fr 2  60                   rts
000490r 2               
000490r 2               ; wait for the next frame
000490r 2               vdp_frame:
000490r 2  20 rr rr     @w:     jsr     frame_idle
000493r 2  AD 1D 7F             lda     VDP_CTRL
000496r 2  10 F8                bpl     @w
000498r 2  60                   rts
000499r 2               
000499r 2                       .segment "BSS"
000075r 2  xx xx        vdp_n:          .res 2
000077r 2  xx xx        vdp_src:        .res 2
000079r 2  xx xx        vdp_t:          .res 2
00007Br 2                       .segment "CODE"
000499r 2               
000499r 1               
000499r 1               getc            = SBC_CHRIN     ; carry set = key in A
000499r 1               
000499r 1               frame_idle:
000499r 1  4C rr rr             jmp     sfx_poll
00049Cr 1               
00049Cr 1               ; 16 bit Galois LFSR.  Returns a random byte in A.  Preserves X and Y.
00049Cr 1  AD rr rr     rand:   lda     rng+1
00049Fr 1  4A                   lsr
0004A0r 1  6E rr rr             ror     rng
0004A3r 1  90 02                bcc     @n
0004A5r 1  49 B4                eor     #$B4
0004A7r 1  8D rr rr     @n:     sta     rng+1
0004AAr 1  4D rr rr             eor     rng
0004ADr 1  60                   rts
0004AEr 1               
0004AEr 1               ; wait about A x 50 ms (3 frames each), dropping keys
0004AEr 1               delay_long:
0004AEr 1  8D rr rr             sta     tmp
0004B1r 1  A9 03        @l:     lda     #3
0004B3r 1  8D rr rr             sta     wf_n
0004B6r 1  20 rr rr     @f:     jsr     vdp_frame
0004B9r 1  CE rr rr             dec     wf_n
0004BCr 1  D0 F8                bne     @f
0004BEr 1  20 rr rr             jsr     flush_in
0004C1r 1  CE rr rr             dec     tmp
0004C4r 1  D0 EB                bne     @l
0004C6r 1  60                   rts
0004C7r 1               
0004C7r 1               .macro MENU_IDLE
0004C7r 1                       jsr     vdp_frame
0004C7r 1                       jsr     rand
0004C7r 1               .endmacro
0004C7r 1               
0004C7r 1               ; ---- the game's pace: a frame takes at least speed / 60 s (the ROM's 60 Hz
0004C7r 1               ; counter), the sound going on meanwhile
0004C7r 1               game_pace:
0004C7r 1  20 rr rr             jsr     sfx_poll
0004CAr 1  20 2D FE             jsr     SBC_TICKS
0004CDr 1  38                   sec
0004CEr 1  ED rr rr             sbc     last_tick
0004D1r 1  CD rr rr             cmp     speed
0004D4r 1  90 F1                bcc     game_pace
0004D6r 1  20 2D FE             jsr     SBC_TICKS
0004D9r 1  8D rr rr             sta     last_tick
0004DCr 1  60                   rts
0004DDr 1               
0004DDr 1               ; ============================================================================
0004DDr 1               ; text
0004DDr 1               ; ============================================================================
0004DDr 1               ; text cursor: column X, row Y (0-31, 0-23)
0004DDr 1  8E rr rr     t_at:   stx     t_col
0004E0r 1  8C rr rr             sty     t_row
0004E3r 1  60                   rts
0004E4r 1               
0004E4r 1               ; character A at the cursor, which moves on.  Preserves X, Y.
0004E4r 1  8E rr rr     t_putc: stx     t_sx
0004E7r 1  8C rr rr             sty     t_sy
0004EAr 1  8D rr rr             sta     t_ch
0004EDr 1  AD rr rr             lda     t_row
0004F0r 1  C9 12                cmp     #TXT_ROW
0004F2r 1  90 15                bcc     @bm
0004F4r 1  AE rr rr             ldx     t_col           ; the status lines: a name
0004F7r 1  AC rr rr             ldy     t_row
0004FAr 1  20 rr rr             jsr     vdp_at
0004FDr 1  AD rr rr             lda     t_ch
000500r 1  18                   clc
000501r 1  69 60                adc     #P_FONT
000503r 1  8D 1C 7F             sta     VDP_DATA
000506r 1  4C rr rr             jmp     @next
000509r 1  20 rr rr     @bm:    jsr     cell_addr       ; the bitmap: the letter's 8 bytes, and white
00050Cr 1  AD rr rr             lda     t_ca            ; on black
00050Fr 1  8D 1D 7F             sta     VDP_CTRL
000512r 1  AD rr rr             lda     t_ca+1
000515r 1  09 40                ora     #$40
000517r 1  8D 1D 7F             sta     VDP_CTRL
00051Ar 1  AD rr rr             lda     t_ch            ; font + (c - $20) * 8
00051Dr 1  38                   sec
00051Er 1  E9 20                sbc     #$20
000520r 1  8D rr rr             sta     t_fa
000523r 1  A9 00                lda     #0
000525r 1  0E rr rr             asl     t_fa
000528r 1  2A                   rol
000529r 1  0E rr rr             asl     t_fa
00052Cr 1  2A                   rol
00052Dr 1  0E rr rr             asl     t_fa
000530r 1  2A                   rol
000531r 1  18                   clc
000532r 1  69 rr                adc     #>font
000534r 1  8D rr rr             sta     @f+2
000537r 1  AD rr rr             lda     t_fa
00053Ar 1  18                   clc
00053Br 1  69 rr                adc     #<font
00053Dr 1  8D rr rr             sta     @f+1
000540r 1  90 03                bcc     :+
000542r 1  EE rr rr             inc     @f+2
000545r 1  A2 00        :       ldx     #0
000547r 1  BD FF FF     @f:     lda     $FFFF,x
00054Ar 1  8D 1C 7F             sta     VDP_DATA
00054Dr 1  E8                   inx
00054Er 1  E0 08                cpx     #8
000550r 1  D0 F5                bne     @f
000552r 1  AD rr rr             lda     t_ca
000555r 1  8D 1D 7F             sta     VDP_CTRL
000558r 1  AD rr rr             lda     t_ca+1
00055Br 1  09 60                ora     #$40 + >V_COL
00055Dr 1  8D 1D 7F             sta     VDP_CTRL
000560r 1  A9 F1                lda     #C_TEXT
000562r 1  A2 08                ldx     #8
000564r 1  8D 1C 7F     @c:     sta     VDP_DATA
000567r 1  CA                   dex
000568r 1  D0 FA                bne     @c
00056Ar 1  EE rr rr     @next:  inc     t_col
00056Dr 1  AE rr rr             ldx     t_sx
000570r 1  AC rr rr             ldy     t_sy
000573r 1  60                   rts
000574r 1               
000574r 1               ; t_ca = the pattern address of cell t_col, t_row (Graphics II: third * $800
000574r 1               ; + (row & 7) * 256 + col * 8)
000574r 1               cell_addr:
000574r 1  AD rr rr             lda     t_col
000577r 1  0A                   asl
000578r 1  0A                   asl
000579r 1  0A                   asl
00057Ar 1  8D rr rr             sta     t_ca
00057Dr 1  AD rr rr             lda     t_row
000580r 1  29 07                and     #7
000582r 1  8D rr rr             sta     t_ca+1
000585r 1  AD rr rr             lda     t_row
000588r 1  4A                   lsr
000589r 1  4A                   lsr
00058Ar 1  4A                   lsr
00058Br 1  0A                   asl
00058Cr 1  0A                   asl
00058Dr 1  0A                   asl                     ; third * 8 (pages)
00058Er 1  0D rr rr             ora     t_ca+1
000591r 1  8D rr rr             sta     t_ca+1
000594r 1  60                   rts
000595r 1               
000595r 1               ; print the string at A/Y (ended by TERM or 0).  Preserves nothing.
000595r 1  8D rr rr     t_puts: sta     @r+1
000598r 1  8C rr rr             sty     @r+2
00059Br 1  A0 00                ldy     #0
00059Dr 1  B9 FF FF     @r:     lda     $FFFF,y
0005A0r 1  F0 0A                beq     @d
0005A2r 1  C9 FF                cmp     #TERM
0005A4r 1  F0 06                beq     @d
0005A6r 1  20 rr rr             jsr     t_putc
0005A9r 1  C8                   iny
0005AAr 1  D0 F1                bne     @r
0005ACr 1  60           @d:     rts
0005ADr 1               
0005ADr 1               ; a table of texts: column, row, .word text ... $FF
0005ADr 1  8D rr rr     t_table:sta     @rd+1
0005B0r 1  8C rr rr             sty     @rd+2
0005B3r 1  A2 00                ldx     #0
0005B5r 1  8E rr rr     @l:     stx     tt_i
0005B8r 1  20 rr rr             jsr     @rd
0005BBr 1  C9 FF                cmp     #$FF
0005BDr 1  F0 29                beq     @done
0005BFr 1  8D rr rr             sta     tt_c
0005C2r 1  E8                   inx
0005C3r 1  20 rr rr             jsr     @rd
0005C6r 1  A8                   tay
0005C7r 1  AE rr rr             ldx     tt_c
0005CAr 1  20 rr rr             jsr     t_at
0005CDr 1  AE rr rr             ldx     tt_i
0005D0r 1  E8                   inx
0005D1r 1  E8                   inx
0005D2r 1  20 rr rr             jsr     @rd
0005D5r 1  48                   pha
0005D6r 1  E8                   inx
0005D7r 1  20 rr rr             jsr     @rd
0005DAr 1  A8                   tay
0005DBr 1  68                   pla
0005DCr 1  20 rr rr             jsr     t_puts
0005DFr 1  AD rr rr             lda     tt_i
0005E2r 1  18                   clc
0005E3r 1  69 04                adc     #4
0005E5r 1  AA                   tax
0005E6r 1  D0 CD                bne     @l
0005E8r 1  60           @done:  rts
0005E9r 1  BD FF FF     @rd:    lda     $FFFF,x
0005ECr 1  60                   rts
0005EDr 1               
0005EDr 1               ; A in decimal, 3 places (spaces before)
0005EDr 1  A2 20        pr_dec3:ldx     #' '
0005EFr 1  8E rr rr             stx     t_lead
0005F2r 1  A2 00                ldx     #0
0005F4r 1  C9 64        @h:     cmp     #100
0005F6r 1  90 05                bcc     @hd
0005F8r 1  E9 64                sbc     #100
0005FAr 1  E8                   inx
0005FBr 1  D0 F7                bne     @h
0005FDr 1  48           @hd:    pha
0005FEr 1  8A                   txa
0005FFr 1  F0 0C                beq     @h0
000601r 1  09 30                ora     #'0'
000603r 1  20 rr rr             jsr     t_putc
000606r 1  A9 30                lda     #'0'
000608r 1  8D rr rr             sta     t_lead
00060Br 1  D0 05                bne     @t
00060Dr 1  A9 20        @h0:    lda     #' '
00060Fr 1  20 rr rr             jsr     t_putc
000612r 1  68           @t:     pla
000613r 1                       ; (on into the tens and ones, with leading t_lead)
000613r 1  A2 00                ldx     #0
000615r 1  C9 0A        @tl:    cmp     #10
000617r 1  90 05                bcc     @td
000619r 1  E9 0A                sbc     #10
00061Br 1  E8                   inx
00061Cr 1  D0 F7                bne     @tl
00061Er 1  48           @td:    pha
00061Fr 1  8A                   txa
000620r 1  D0 06                bne     @tn
000622r 1  AD rr rr             lda     t_lead
000625r 1  4C rr rr             jmp     @tp
000628r 1  09 30        @tn:    ora     #'0'
00062Ar 1  20 rr rr     @tp:    jsr     t_putc
00062Dr 1  68                   pla
00062Er 1  09 30                ora     #'0'
000630r 1  4C rr rr             jmp     t_putc
000633r 1               
000633r 1               ; A in decimal, 2 places
000633r 1  A2 00        pr_dec2:ldx     #0
000635r 1  C9 0A        @t:     cmp     #10
000637r 1  90 05                bcc     @d
000639r 1  E9 0A                sbc     #10
00063Br 1  E8                   inx
00063Cr 1  D0 F7                bne     @t
00063Er 1  48           @d:     pha
00063Fr 1  8A                   txa
000640r 1  09 30                ora     #'0'
000642r 1  20 rr rr             jsr     t_putc
000645r 1  68                   pla
000646r 1  09 30                ora     #'0'
000648r 1  4C rr rr             jmp     t_putc
00064Br 1               
00064Br 1               ; A as 2 hex digits
00064Br 1  48           pr_hex: pha
00064Cr 1  4A                   lsr
00064Dr 1  4A                   lsr
00064Er 1  4A                   lsr
00064Fr 1  4A                   lsr
000650r 1  20 rr rr             jsr     @dig
000653r 1  68                   pla
000654r 1  29 0F                and     #$0F
000656r 1  C9 0A        @dig:   cmp     #10
000658r 1  90 02                bcc     @n
00065Ar 1  69 06                adc     #6
00065Cr 1  69 30        @n:     adc     #'0'
00065Er 1  4C rr rr             jmp     t_putc
000661r 1               
000661r 1               ; text row Y: blank (rows 18-23: names; the bitmap: zeros)
000661r 1               t_clear_row:
000661r 1  C0 12                cpy     #TXT_ROW
000663r 1  90 10                bcc     @bm
000665r 1  A2 00                ldx     #0
000667r 1  20 rr rr             jsr     vdp_at
00066Ar 1  A9 80                lda     #' ' + P_FONT
00066Cr 1  A2 20                ldx     #32
00066Er 1  8D 1C 7F     @n:     sta     VDP_DATA
000671r 1  CA                   dex
000672r 1  D0 FA                bne     @n
000674r 1  60                   rts
000675r 1  8C rr rr     @bm:    sty     t_row
000678r 1  A9 00                lda     #0
00067Ar 1  8D rr rr             sta     t_col
00067Dr 1  20 rr rr             jsr     cell_addr
000680r 1  AD rr rr             lda     t_ca
000683r 1  AC rr rr             ldy     t_ca+1
000686r 1  20 rr rr             jsr     vdp_waddr
000689r 1  A9 00                lda     #0
00068Br 1  8D rr rr             sta     vdp_n
00068Er 1  A9 01                lda     #1
000690r 1  8D rr rr             sta     vdp_n+1
000693r 1  A9 00                lda     #0
000695r 1  4C rr rr             jmp     vdp_fill
000698r 1               
000698r 1               ; ============================================================================
000698r 1               ; the display
000698r 1               ; ============================================================================
000698r 1               gfx_init:
000698r 1  A9 rr                lda     #<vdp_regs
00069Ar 1  A0 rr                ldy     #>vdp_regs
00069Cr 1  20 rr rr             jsr     vdp_setup       ; (VRAM cleared: all black)
00069Fr 1  A9 00                lda     #<V_SATTR       ; no sprites
0006A1r 1  A0 3B                ldy     #>V_SATTR
0006A3r 1  20 rr rr             jsr     vdp_waddr
0006A6r 1  A9 D0                lda     #$D0
0006A8r 1  8D 1C 7F             sta     VDP_DATA
0006ABr 1                       ; the names: rows 0-17 the bitmap in order (0-255, 0-255, 0-63),
0006ABr 1                       ; rows 18-23 spaces
0006ABr 1  A9 00                lda     #<V_NAME
0006ADr 1  A0 38                ldy     #>V_NAME
0006AFr 1  20 rr rr             jsr     vdp_waddr
0006B2r 1  A0 02                ldy     #2
0006B4r 1  A2 00                ldx     #0
0006B6r 1  8A           @n1:    txa
0006B7r 1  8D 1C 7F             sta     VDP_DATA
0006BAr 1  E8                   inx
