000C3Cr 1  AA                   tax
000C3Dr 1  A0 06                ldy     #>(bss_end - bss_start + $FF)   ; whole pages (past the end is free RAM)
000C3Fr 1  9D rr rr     @c1:    sta     bss_start,x
000C42r 1  E8                   inx
000C43r 1  D0 FA                bne     @c1
