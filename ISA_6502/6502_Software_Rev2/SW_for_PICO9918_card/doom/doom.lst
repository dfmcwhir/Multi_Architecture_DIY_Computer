001029r 1               ; r_lo/r_hi = (A * w) >> 8, w = w_lo/w_hi unsigned 16 bit.
001029r 1               ; Two quarter-square products: a*b = sq(a+b) - sq(a-b), sq(n) = n*n/4
001029r 1               ; (sq2 is the table for sums of 256 and more).
001029r 1  8D rr rr     mul8x16:sta     mf
00102Cr 1  38                   sec                     ; low product: only its high byte is needed
00102Dr 1  ED rr rr             sbc     w_lo
001030r 1  B0 04                bcs     @d1
001032r 1  49 FF                eor     #$FF
001034r 1  69 01                adc     #1
