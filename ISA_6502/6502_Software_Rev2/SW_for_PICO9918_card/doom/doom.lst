0008BAr 1                       ; its left pixel at 0
0008BAr 1  AD rr rr             lda     grp+2
0008BDr 1  29 03                and     #3
0008BFr 1  A8                   tay
0008C0r 1  B9 rr rr             lda     ev_7,y
