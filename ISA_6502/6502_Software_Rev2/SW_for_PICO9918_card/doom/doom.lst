000B6Ar 1  AD rr rr             lda     ctrl
000B6Dr 1  F0 07                beq     @kb
000B6Fr 1  A9 rr                lda     #<ctrl_pad_txt
000B71r 1  A0 rr                ldy     #>ctrl_pad_txt
000B73r 1  4C rr rr             jmp     t_puts
000B76r 1  A9 rr        @kb:    lda     #<ctrl_kb_txt
000B78r 1  A0 rr                ldy     #>ctrl_kb_txt
000B7Ar 1  4C rr rr             jmp     t_puts
