00185Er 1               
00185Er 1               ; carry set if A is one of the characters the gamepad driver types for the
00185Er 1               ; pad (W A S D and space).  Those are ignored in gamepad mode so that one
00185Er 1               ; press doesn't act twice.  Preserves A.
00185Er 1               pad_typed:
00185Er 1  C9 20                cmp     #' '
001860r 1  F0 12                beq     @y
001862r 1  C9 57                cmp     #'W'
001864r 1  F0 0E                beq     @y
001866r 1  C9 41                cmp     #'A'
001868r 1  F0 0A                beq     @y
00186Ar 1  C9 53                cmp     #'S'
00186Cr 1  F0 06                beq     @y
00186Er 1  C9 44                cmp     #'D'
001870r 1  F0 02                beq     @y
001872r 1  18                   clc
001873r 1  60                   rts
001874r 1  38           @y:     sec
001875r 1  60                   rts
001876r 1               
001876r 1               ; wait for a menu choice.  Returns a key (letters in upper case), or
001876r 1               ; PAD_GO for the gamepad's A or Start button.
001876r 1               menu_key:
001876r 1  20 rr rr 20  @l:     MENU_IDLE
00187Ar 1  rr rr        
00187Cr 1  20 rr rr             jsr     read_pad
00187Fr 1  AD rr rr             lda     padnew
001882r 1  29 09                and     #PAD_A | PAD_START
001884r 1  D0 21                bne     @pad
001886r 1  20 00 FE             jsr     getc
001889r 1  90 EB                bcc     @l
00188Br 1  C9 20                cmp     #' '            ; a space typed by the pad's A button?
00188Dr 1  D0 0D                bne     @up
00188Fr 1  20 rr rr             jsr     read_pad
001892r 1  AD rr rr             lda     pad
001895r 1  29 01                and     #PAD_A
001897r 1  D0 0E                bne     @pad
001899r 1  A9 20                lda     #' '
00189Br 1  60                   rts
00189Cr 1  C9 61        @up:    cmp     #'a'
00189Er 1  90 06                bcc     @r
0018A0r 1  C9 7B                cmp     #'z'+1
0018A2r 1  B0 02                bcs     @r
0018A4r 1  29 DF                and     #$DF
0018A6r 1  60           @r:     rts
0018A7r 1  20 rr rr     @pad:   jsr     flush_in        ; the space the driver typed for it
0018AAr 1  A9 80                lda     #PAD_GO
0018ACr 1  60                   rts
