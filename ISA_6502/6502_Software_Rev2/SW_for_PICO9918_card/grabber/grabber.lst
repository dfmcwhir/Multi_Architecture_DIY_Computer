001237r 1               
001237r 1               ; wait about A ms.  The inner loop is sized for the clock (CLOCK_MHZ in
001237r 1               ; sbc_api.inc): 5 + 4 * (CLOCK_MHZ - 1) cycles a turn, DELAY_N turns a ms.
001237r 1               DELAY_N = (1000 * CLOCK_MHZ - 7) / (5 + 4 * (CLOCK_MHZ - 1))
001237r 1               delay_ms:
001237r 1  AA                   tax
001238r 1  F0 11                beq     @done
00123Ar 1  20 rr rr     @o:     jsr     sfx_poll        ; (and while waiting)
00123Dr 1  A0 EA                ldy     #DELAY_N
00123Fr 1               @i:
00123Fr 1  EA EA EA EA  .repeat CLOCK_MHZ - 1
001243r 1  EA EA        
001245r 1                       nop
001245r 1                       nop
001245r 1               .endrepeat
