0014D2r 1  8D rr rr             sta     ang
0014D5r 1  8D rr rr             sta     ang+1
0014D8r 1  8D rr rr             sta     angv
0014DBr 1  8D rr rr             sta     angv+1
0014DEr 1  8D rr rr             sta     hl
0014E1r 1  8D rr rr             sta     carry
0014E4r 1  8D rr rr             sta     pop_t
0014E7r 1  8D rr rr             sta     fire_req
