0013CAr 1  BD rr rr     @c:     lda     hi_money,x
0013CDr 1  9D rr rr             sta     num,x
0013D0r 1  CA                   dex
0013D1r 1  10 F7                bpl     @c
0013D3r 1  20 rr rr             jsr     prnum
0013D6r 1  A9 rr                lda     #<hi2_txt
0013D8r 1  A0 rr                ldy     #>hi2_txt
