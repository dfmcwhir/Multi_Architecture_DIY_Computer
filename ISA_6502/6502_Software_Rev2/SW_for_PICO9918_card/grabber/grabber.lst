0015ADr 1  20 rr rr             jsr     sfx_snd
0015B0r 1  A9 rr                lda     #<over_txt
0015B2r 1  A0 rr                ldy     #>over_txt
0015B4r 1  20 rr rr             jsr     print
0015B7r 1  20 rr rr             jsr     prmoney
0015BAr 1  A9 rr                lda     #<over2_txt
0015BCr 1  A0 rr                ldy     #>over2_txt
0015BEr 1  20 rr rr             jsr     print
0015C1r 1  A2 02                ldx     #2
0015C3r 1  BD rr rr     @g:     lda     target,x
0015C6r 1  9D rr rr             sta     num,x
0015C9r 1  CA                   dex
0015CAr 1  10 F7                bpl     @g
0015CCr 1  20 rr rr             jsr     prnum
0015CFr 1  A9 rr                lda     #<over3_txt
0015D1r 1  A0 rr                ldy     #>over3_txt
0015D3r 1  20 rr rr             jsr     print
0015D6r 1  AD rr rr             lda     money+2         ; the best so far?
0015D9r 1  CD rr rr             cmp     hi_money+2
0015DCr 1  D0 0E                bne     @c
0015DEr 1  AD rr rr             lda     money+1
0015E1r 1  CD rr rr             cmp     hi_money+1
0015E4r 1  D0 06                bne     @c
0015E6r 1  AD rr rr             lda     money
0015E9r 1  CD rr rr             cmp     hi_money
0015ECr 1  90 11        @c:     bcc     @nohi
0015EEr 1  A2 02                ldx     #2
0015F0r 1  BD rr rr     @h:     lda     money,x
0015F3r 1  9D rr rr             sta     hi_money,x
0015F6r 1  CA                   dex
0015F7r 1  10 F7                bpl     @h
0015F9r 1  AD rr rr             lda     level
0015FCr 1  8D rr rr             sta     hi_level
0015FFr 1  A9 14        @nohi:  lda     #20
001601r 1  20 rr rr             jsr     delay_long
001604r 1  20 rr rr     @wait:  jsr     menu_key
001607r 1  C9 51                cmp     #'Q'
001609r 1  D0 03                bne     @nq
00160Br 1  4C rr rr             jmp     title
00160Er 1  C9 4D        @nq:    cmp     #'M'
001610r 1  D0 06                bne     @nm
001612r 1  20 rr rr             jsr     sfx_toggle
001615r 1  4C rr rr             jmp     @wait
001618r 1  C9 20        @nm:    cmp     #' '
00161Ar 1  F0 04                beq     @again
00161Cr 1  C9 80                cmp     #PAD_GO
00161Er 1  D0 E4                bne     @wait
001620r 1  4C rr rr     @again: jmp     new_game
001623r 1               
001623r 1               ; the things left in the pit worth grabbing (not TNT).  Z set if none.
001623r 1               count_left:
001623r 1  A2 17                ldx     #NITEM-1
001625r 1  A0 00                ldy     #0
001627r 1  BD rr rr     @l:     lda     it_k,x
00162Ar 1  F0 05                beq     @n
00162Cr 1  C9 06                cmp     #K_TNT
00162Er 1  F0 01                beq     @n
