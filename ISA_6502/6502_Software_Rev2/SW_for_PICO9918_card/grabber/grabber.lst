0013EFr 1  A9 00                lda     #0
0013F1r 1  A2 02                ldx     #2
0013F3r 1  9D rr rr     @z:     sta     money,x
0013F6r 1  9D rr rr             sta     target,x
0013F9r 1  CA                   dex
0013FAr 1  10 F7                bpl     @z
0013FCr 1  8D rr rr             sta     level
0013FFr 1  8D rr rr             sta     bombs
001402r 1  8D rr rr             sta     strong
