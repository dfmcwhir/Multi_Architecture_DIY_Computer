001408r 1  8D rr rr             sta     has_laser
00140Br 1  8D rr rr             sta     quit
00140Er 1               
00140Er 1               ; ---- a level: make the pit, raise the goal, show it, play ----------------------------
00140Er 1               next_level:
00140Er 1  EE rr rr             inc     level
001411r 1  20 rr rr             jsr     gen_level
001414r 1  A9 15                lda     #21             ; the goal goes up by 50-70% of what's in the pit
001416r 1  20 rr rr             jsr     rnd
001419r 1  18                   clc
00141Ar 1  69 32                adc     #50
00141Cr 1  8D rr rr             sta     pct
00141Fr 1  AD rr rr             lda     total           ; num = total * pct / 100
001422r 1  AE rr rr             ldx     pct
001425r 1  20 rr rr             jsr     mul8
001428r 1  8D rr rr             sta     num
00142Br 1  8E rr rr             stx     num+1
00142Er 1  AD rr rr             lda     total+1
001431r 1  AE rr rr             ldx     pct
001434r 1  20 rr rr             jsr     mul8
001437r 1  18                   clc
001438r 1  6D rr rr             adc     num+1
00143Br 1  8D rr rr             sta     num+1
00143Er 1  8A                   txa
00143Fr 1  69 00                adc     #0
001441r 1  8D rr rr             sta     num+2
001444r 1  A9 64                lda     #100
001446r 1  20 rr rr             jsr     div24
001449r 1  18                   clc                     ; target += num
00144Ar 1  A2 00                ldx     #0
00144Cr 1  A0 03                ldy     #3
00144Er 1  BD rr rr     @t:     lda     target,x
001451r 1  7D rr rr             adc     num,x
001454r 1  9D rr rr             sta     target,x
001457r 1  E8                   inx
001458r 1  88                   dey
001459r 1  D0 F3                bne     @t
00145Br 1                       ; "LEVEL n  GOAL $..."
00145Br 1  20 rr rr             jsr     new_screen
00145Er 1  A9 rr                lda     #<lvl_txt
001460r 1  A0 rr                ldy     #>lvl_txt
001462r 1  20 rr rr             jsr     print
001465r 1  AD rr rr             lda     level
001468r 1  20 rr rr             jsr     pr8
00146Br 1  A9 rr                lda     #<goal_txt
00146Dr 1  A0 rr                ldy     #>goal_txt
00146Fr 1  20 rr rr             jsr     print
001472r 1  A2 02                ldx     #2
001474r 1  BD rr rr     @g:     lda     target,x
001477r 1  9D rr rr             sta     num,x
00147Ar 1  CA                   dex
00147Br 1  10 F7                bpl     @g
00147Dr 1  20 rr rr             jsr     prnum
001480r 1  A9 rr                lda     #<have_txt
001482r 1  A0 rr                ldy     #>have_txt
001484r 1  20 rr rr             jsr     print
001487r 1  20 rr rr             jsr     prmoney
00148Ar 1  AD rr rr             lda     strong
00148Dr 1  F0 07                beq     @ns
00148Fr 1  A9 rr                lda     #<strong_txt
001491r 1  A0 rr                ldy     #>strong_txt
001493r 1  20 rr rr             jsr     print
