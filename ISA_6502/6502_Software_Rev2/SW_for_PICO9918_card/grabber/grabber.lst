001499r 1  F0 07                beq     @ng
00149Br 1  A9 rr                lda     #<gx2_txt
00149Dr 1  A0 rr                ldy     #>gx2_txt
00149Fr 1  20 rr rr             jsr     print
0014A2r 1  AD rr rr     @ng:    lda     has_laser
