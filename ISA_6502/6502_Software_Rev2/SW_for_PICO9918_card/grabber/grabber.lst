0014C2r 1  8D rr rr             sta     fieldcol
0014C5r 1  20 2D FE             jsr     SBC_TICKS
0014C8r 1  8D rr rr             sta     last_tick
0014CBr 1  A9 00                lda     #H_SWING
0014CDr 1  8D rr rr             sta     hst
