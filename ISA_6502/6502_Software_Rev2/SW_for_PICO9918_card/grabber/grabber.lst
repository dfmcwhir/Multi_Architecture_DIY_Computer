0001A8r 2  CA                   dex
0001A9r 2  10 85                bpl     @ch
0001ABr 2  A9 07                lda     #7
0001ADr 2  8D 22 7F             sta     SFX_AY_ADDR
0001B0r 2  AD rr rr             lda     sfx_mixer
0001B3r 2  8D 23 7F             sta     SFX_AY_DATA
0001B6r 2  60                   rts
0001B7r 2  3E 3D 3B     sfx_tone_on:    .byte   $3E, $3D, $3B
0001BAr 2  37 2F 1F     sfx_noise_on:   .byte   $37, $2F, $1F
0001BDr 2               
0001BDr 2               ; one voice (X): the sweep and the decay, then the script when its wait
0001BDr 2               ; is over
0001BDr 2               sfx_voice:
0001BDr 2  BD rr rr             lda     sfx_swl,x       ; the sweep
0001C0r 2  1D rr rr             ora     sfx_swh,x
0001C3r 2  F0 13                beq     @ns
0001C5r 2  BD rr rr             lda     sfx_perl,x
0001C8r 2  18                   clc
0001C9r 2  7D rr rr             adc     sfx_swl,x
0001CCr 2  9D rr rr             sta     sfx_perl,x
0001CFr 2  BD rr rr             lda     sfx_perh,x
0001D2r 2  7D rr rr             adc     sfx_swh,x
0001D5r 2  9D rr rr             sta     sfx_perh,x
0001D8r 2  BD rr rr     @ns:    lda     sfx_dec,x       ; the decay
0001DBr 2  F0 10                beq     @nd
0001DDr 2  DE rr rr             dec     sfx_decc,x
0001E0r 2  D0 0B                bne     @nd
0001E2r 2  9D rr rr             sta     sfx_decc,x
0001E5r 2  BD rr rr             lda     sfx_vol,x
0001E8r 2  F0 03                beq     @nd
0001EAr 2  DE rr rr             dec     sfx_vol,x
0001EDr 2  BD rr rr     @nd:    lda     sfx_wait,x
0001F0r 2  F0 06                beq     @run
0001F2r 2  DE rr rr             dec     sfx_wait,x
0001F5r 2  F0 01                beq     @run
0001F7r 2  60                   rts
0001F8r 2  A9 28        @run:   lda     #40             ; (at most 40 commands a tick: a script that
0001FAr 2  8D rr rr             sta     sfx_guard       ;  never waits can't hang the game)
0001FDr 2  CE rr rr     @cmd:   dec     sfx_guard
000200r 2  F0 76                beq     @stop
000202r 2  20 rr rr             jsr     sfx_byte
000205r 2  C9 80                cmp     #$80
000207r 2  90 09                bcc     @nw
000209r 2  29 7F                and     #$7F            ; wait
00020Br 2  9D rr rr             sta     sfx_wait,x
00020Er 2  FE rr rr             inc     sfx_wait,x
000211r 2  60                   rts
000212r 2  C9 20        @nw:    cmp     #$20
000214r 2  90 54                bcc     @op
000216r 2  38                   sec                     ; a note
000217r 2  E9 20                sbc     #$20
000219r 2  C9 60                cmp     #96
00021Br 2  90 02                bcc     @nt
00021Dr 2  A9 5F                lda     #95
00021Fr 2  A0 00        @nt:    ldy     #0              ; octave Y, note A in it
000221r 2  C9 0C        @oc:    cmp     #12
000223r 2  90 05                bcc     @ok
000225r 2  E9 0C                sbc     #12
000227r 2  C8                   iny
000228r 2  D0 F7                bne     @oc
00022Ar 2  8C rr rr     @ok:    sty     sfx_guard+1     ; (as a count)
00022Dr 2  A8                   tay
00022Er 2  B9 rr rr             lda     sfx_c1_lo,y     ; the period in octave 1, halved for each
000231r 2  9D rr rr             sta     sfx_perl,x      ; octave up
000234r 2  B9 rr rr             lda     sfx_c1_hi,y
000237r 2  AC rr rr             ldy     sfx_guard+1
00023Ar 2  F0 16                beq     @p
00023Cr 2  4A           @sh:    lsr
00023Dr 2  7E rr rr             ror     sfx_perl,x
000240r 2  88                   dey
000241r 2  D0 F9                bne     @sh
000243r 2  9D rr rr             sta     sfx_perh,x      ; (rounded: the last bit out was a half)
000246r 2  90 0D                bcc     @r0
000248r 2  FE rr rr             inc     sfx_perl,x
00024Br 2  D0 08                bne     @r0
00024Dr 2  FE rr rr             inc     sfx_perh,x
000250r 2  D0 03                bne     @r0
000252r 2  9D rr rr     @p:     sta     sfx_perh,x
000255r 2               @r0:
000255r 2  BD rr rr             lda     sfx_base,x
000258r 2  9D rr rr             sta     sfx_vol,x
00025Br 2  BD rr rr             lda     sfx_dec,x
00025Er 2  9D rr rr             sta     sfx_decc,x
000261r 2  BD rr rr     @len:   lda     sfx_len,x       ; (LEN: wait that long)
000264r 2  F0 97                beq     @cmd
000266r 2  9D rr rr             sta     sfx_wait,x
000269r 2  60                   rts
00026Ar 2  C9 0C        @op:    cmp     #12
00026Cr 2  B0 0A                bcs     @stop
00026Er 2  A8                   tay
00026Fr 2  B9 rr rr             lda     @hi,y
000272r 2  48                   pha
000273r 2  B9 rr rr             lda     @lo,y
000276r 2  48                   pha
000277r 2  60                   rts                     ; (to the command, which goes back to @cmd)
000278r 2  A9 00        @stop:  lda     #0
00027Ar 2  9D rr rr             sta     sfx_hi,x
00027Dr 2  9D rr rr             sta     sfx_vol,x
000280r 2  60                   rts
000281r 2  rr rr rr rr  @lo:    .lobytes  @stop-1, @per-1, @vl-1, @noi-1, @mix-1, @sw-1, @dc-1, @lp-1, @nx-1, @jp-1, @rest-1, @ln-1
000285r 2  rr rr rr rr  
000289r 2  rr rr rr rr  
00028Dr 2  rr rr rr rr  @hi:    .hibytes  @stop-1, @per-1, @vl-1, @noi-1, @mix-1, @sw-1, @dc-1, @lp-1, @nx-1, @jp-1, @rest-1, @ln-1
000291r 2  rr rr rr rr  
000295r 2  rr rr rr rr  
000299r 2  20 rr rr     @per:   jsr     sfx_byte
00029Cr 2  9D rr rr             sta     sfx_perl,x
00029Fr 2  20 rr rr             jsr     sfx_byte
0002A2r 2  9D rr rr             sta     sfx_perh,x
0002A5r 2  4C rr rr             jmp     @cmd
0002A8r 2  20 rr rr     @vl:    jsr     sfx_byte
0002ABr 2  9D rr rr             sta     sfx_base,x
0002AEr 2  9D rr rr             sta     sfx_vol,x
0002B1r 2  BD rr rr             lda     sfx_dec,x
0002B4r 2  9D rr rr             sta     sfx_decc,x
0002B7r 2  4C rr rr             jmp     @cmd
0002BAr 2  20 rr rr     @noi:   jsr     sfx_byte
0002BDr 2  9D rr rr             sta     sfx_noise,x
0002C0r 2  4C rr rr             jmp     @cmd
0002C3r 2  20 rr rr     @mix:   jsr     sfx_byte
0002C6r 2  9D rr rr             sta     sfx_mix,x
0002C9r 2  4C rr rr             jmp     @cmd
0002CCr 2  20 rr rr     @sw:    jsr     sfx_byte
0002CFr 2  9D rr rr             sta     sfx_swl,x
0002D2r 2  20 rr rr             jsr     sfx_byte
0002D5r 2  9D rr rr             sta     sfx_swh,x
0002D8r 2  4C rr rr             jmp     @cmd
0002DBr 2  20 rr rr     @dc:    jsr     sfx_byte
0002DEr 2  9D rr rr             sta     sfx_dec,x
0002E1r 2  9D rr rr             sta     sfx_decc,x
0002E4r 2  4C rr rr             jmp     @cmd
0002E7r 2  20 rr rr     @lp:    jsr     sfx_byte
0002EAr 2  9D rr rr             sta     sfx_lcnt,x
0002EDr 2  BD rr rr             lda     sfx_lo,x
0002F0r 2  9D rr rr             sta     sfx_lpl,x
0002F3r 2  BD rr rr             lda     sfx_hi,x
0002F6r 2  9D rr rr             sta     sfx_lph,x
0002F9r 2  4C rr rr             jmp     @cmd
0002FCr 2  BD rr rr     @nx:    lda     sfx_lcnt,x
0002FFr 2  F0 05                beq     @back           ; (0: for ever)
000301r 2  DE rr rr             dec     sfx_lcnt,x
000304r 2  F0 0C                beq     @go
000306r 2  BD rr rr     @back:  lda     sfx_lpl,x
000309r 2  9D rr rr             sta     sfx_lo,x
00030Cr 2  BD rr rr             lda     sfx_lph,x
00030Fr 2  9D rr rr             sta     sfx_hi,x
000312r 2  4C rr rr     @go:    jmp     @cmd
000315r 2  20 rr rr     @jp:    jsr     sfx_byte
000318r 2  48                   pha
000319r 2  20 rr rr             jsr     sfx_byte
00031Cr 2  9D rr rr             sta     sfx_hi,x
00031Fr 2  68                   pla
000320r 2  9D rr rr             sta     sfx_lo,x
000323r 2  4C rr rr             jmp     @cmd
000326r 2  A9 00        @rest:  lda     #0
000328r 2  9D rr rr             sta     sfx_vol,x
00032Br 2  4C rr rr             jmp     @len
00032Er 2  20 rr rr     @ln:    jsr     sfx_byte
000331r 2  9D rr rr             sta     sfx_len,x
000334r 2  4C rr rr             jmp     @cmd
000337r 2               
000337r 2               ; the next byte of voice X's script
000337r 2               sfx_byte:
000337r 2  BD rr rr             lda     sfx_lo,x
00033Ar 2  8D rr rr             sta     @ld+1
00033Dr 2  BD rr rr             lda     sfx_hi,x
000340r 2  8D rr rr             sta     @ld+2
000343r 2  AD FF FF     @ld:    lda     $FFFF
000346r 2  FE rr rr             inc     sfx_lo,x
000349r 2  D0 03                bne     @r
00034Br 2  FE rr rr             inc     sfx_hi,x
00034Er 2  60           @r:     rts
00034Fr 2               
00034Fr 2               ; the tone periods of C1 .. B1 for the 2 MHz chip clock: 2 MHz / (16 x
00034Fr 2               ; frequency); each octave up is half (to within a third of a percent)
00034Fr 2  EE 18 4D 8E  sfx_c1_lo:  .lobytes 3822, 3608, 3405, 3214, 3034, 2863, 2703, 2551, 2408, 2273, 2145, 2025
000353r 2  DA 2F 8F F7  
000357r 2  68 E1 61 E9  
00035Br 2  0E 0E 0D 0C  sfx_c1_hi:  .hibytes 3822, 3608, 3405, 3214, 3034, 2863, 2703, 2551, 2408, 2273, 2145, 2025
00035Fr 2  0B 0B 0A 09  
000363r 2  09 08 08 07  
000367r 2               
000367r 2               
000367r 1                       .include "lib/vdp.s"    ; the PICO9918 routines
000367r 2               ; ============================================================================
000367r 2               ; vdp.s - PICO9918 / TMS9918A routines shared by the SBC games (CPU Rev2)
000367r 2               ;
000367r 2               ; Include it after setting VDP_NAME (the name table's VRAM address):
000367r 2               ;           VDP_NAME = $1800
000367r 2               ;           .include "lib/vdp.s"
000367r 2               ; No zero page is used: the copy routines patch their own addresses.
000367r 2               ;
000367r 2               ;   vdp_setup   A/Y -> 8 bytes: R0-R7.  Puts a PICO9918 (F18A mode) back to
000367r 2               ;               plain TMS9918A behaviour first (24 rows, all 32 sprites, no
000367r 2               ;               scrolling, no second tile layer; the unlock leaves VR30 at
000367r 2               ;               31 sprites a line),
000367r 2               ;               clears the 16K of VRAM, then loads R0-R7.  Interrupts from
000367r 2               ;               the VDP should be off in R1 (bit 5): the games poll.
000367r 2               ;   vdp_reg     register X = A
000367r 2               ;   vdp_waddr   VRAM write address = A (low) / Y (high)
000367r 2               ;   vdp_fill    write A to VRAM vdp_n (16 bit) times, from the address set
000367r 2               ;   vdp_copy    copy vdp_n bytes from RAM vdp_src to VRAM (from the address set)
000367r 2               ;   vdp_at      write address = the name table cell at column X, row Y
000367r 2               ;   vdp_puts    write the 0-ended string at A/Y from there (names = ASCII)
000367r 2               ;   vdp_bcd     write A as two digits
000367r 2               ;   vdp_frame   wait for the next frame (60 a second), calling frame_idle
000367r 2               ;               (the game's: sound, random numbers) while it waits
000367r 2               ;
000367r 2               ; The VDP's ports: data $7F1C, control/status $7F1D.  Reading the status
000367r 2               ; clears the frame flag, so nothing else should read it while a game runs
000367r 2               ; (the ROM doesn't, with PICO_IRQ = 0 in its config.inc, the default).
000367r 2               ; ============================================================================
000367r 2               
000367r 2               VDP_DATA        = $7F1C
000367r 2               VDP_CTRL        = $7F1D
000367r 2               
000367r 2               ; register X = A.  Keeps A, X, Y.
000367r 2               vdp_reg:
000367r 2  8D 1D 7F             sta     VDP_CTRL
00036Ar 2  48                   pha
00036Br 2  8A                   txa
00036Cr 2  09 80                ora     #$80
00036Er 2  8D 1D 7F             sta     VDP_CTRL
000371r 2  68                   pla
000372r 2  60                   rts
000373r 2               
000373r 2               ; VRAM write address = A (low) / Y (high).  Keeps A, X, Y.
000373r 2               vdp_waddr:
000373r 2  8D 1D 7F             sta     VDP_CTRL
000376r 2  48                   pha
000377r 2  98                   tya
000378r 2  29 3F                and     #$3F
00037Ar 2  09 40                ora     #$40
00037Cr 2  8D 1D 7F             sta     VDP_CTRL
00037Fr 2  68                   pla
000380r 2  60                   rts
000381r 2               
000381r 2               ; write A, vdp_n times.  Keeps A.
000381r 2               vdp_fill:
000381r 2  AE rr rr             ldx     vdp_n           ; the odd bytes first
000384r 2  F0 06                beq     @pg
000386r 2  8D 1C 7F     @lo:    sta     VDP_DATA
000389r 2  CA                   dex
00038Ar 2  D0 FA                bne     @lo
00038Cr 2  AC rr rr     @pg:    ldy     vdp_n+1         ; then whole pages
00038Fr 2  F0 0B                beq     @done
000391r 2  A2 00        @p:     ldx     #0
000393r 2  8D 1C 7F     @pp:    sta     VDP_DATA
000396r 2  CA                   dex
000397r 2  D0 FA                bne     @pp
000399r 2  88                   dey
00039Ar 2  D0 F5                bne     @p
00039Cr 2  60           @done:  rts
00039Dr 2               
00039Dr 2               ; copy vdp_n bytes from vdp_src to VRAM
00039Dr 2               vdp_copy:
00039Dr 2  AD rr rr             lda     vdp_src
0003A0r 2  8D rr rr             sta     @rd+1
0003A3r 2  AD rr rr             lda     vdp_src+1
0003A6r 2  8D rr rr             sta     @rd+2
0003A9r 2  AD rr rr             lda     vdp_n
0003ACr 2  8D rr rr             sta     vdp_t
0003AFr 2  AD rr rr             lda     vdp_n+1
0003B2r 2  8D rr rr             sta     vdp_t+1
0003B5r 2  AD rr rr     @l:     lda     vdp_t
0003B8r 2  0D rr rr             ora     vdp_t+1
0003BBr 2  F0 1C                beq     @done
0003BDr 2  AD FF FF     @rd:    lda     $FFFF
0003C0r 2  8D 1C 7F             sta     VDP_DATA
0003C3r 2  EE rr rr             inc     @rd+1
0003C6r 2  D0 03                bne     :+
0003C8r 2  EE rr rr             inc     @rd+2
0003CBr 2  AD rr rr     :       lda     vdp_t
0003CEr 2  D0 03                bne     :+
0003D0r 2  CE rr rr             dec     vdp_t+1
0003D3r 2  CE rr rr     :       dec     vdp_t
0003D6r 2  4C rr rr             jmp     @l
0003D9r 2  60           @done:  rts
0003DAr 2               
0003DAr 2               ; A/Y -> 8 register values.  Clears VRAM.
0003DAr 2               vdp_setup:
0003DAr 2  8D rr rr             sta     @rr+1
0003DDr 2  8C rr rr             sty     @rr+2
0003E0r 2  AD 1D 7F             lda     VDP_CTRL        ; (resets the register write latch)
0003E3r 2  A9 80                lda     #$80            ; R1 = $80: display off while we work
0003E5r 2  A2 01                ldx     #1
0003E7r 2  20 rr rr             jsr     vdp_reg
0003EAr 2  A9 1C                lda     #$1C            ; F18A unlock (a PICO9918): $1C twice to VR57
0003ECr 2  A2 39                ldx     #57
0003EEr 2  20 rr rr             jsr     vdp_reg
0003F1r 2  20 rr rr             jsr     vdp_reg
0003F4r 2  A9 00                lda     #0              ; VR49: 24 rows, no 80 columns, no layer 2
0003F6r 2  A2 31                ldx     #49
0003F8r 2  20 rr rr             jsr     vdp_reg
0003FBr 2  A2 32                ldx     #50             ; VR50: plain TMS9918A behaviour
0003FDr 2  20 rr rr             jsr     vdp_reg
000400r 2  A2 13                ldx     #19             ; VR19: no line interrupt
000402r 2  20 rr rr             jsr     vdp_reg
000405r 2  A2 19                ldx     #25             ; VR25-VR29: no scrolling, one page
000407r 2  20 rr rr     @sc:    jsr     vdp_reg
00040Ar 2  E8                   inx
00040Br 2  E0 1E                cpx     #30
00040Dr 2  D0 F8                bne     @sc
00040Fr 2  A9 20                lda     #32             ; VR51: all 32 sprites
000411r 2  A2 33                ldx     #51
000413r 2  20 rr rr             jsr     vdp_reg
000416r 2                       ; (on a real TMS9918A those writes land in R0-R7: all set below)
000416r 2  A9 80                lda     #$80            ; R1 again: display off
000418r 2  A2 01                ldx     #1
00041Ar 2  20 rr rr             jsr     vdp_reg
00041Dr 2  A9 00                lda     #0              ; clear the 16K
00041Fr 2  A8                   tay
000420r 2  20 rr rr             jsr     vdp_waddr
000423r 2  A9 00                lda     #$00
000425r 2  8D rr rr             sta     vdp_n
000428r 2  A9 40                lda     #$40
00042Ar 2  8D rr rr             sta     vdp_n+1
00042Dr 2  A9 00                lda     #0
00042Fr 2  20 rr rr             jsr     vdp_fill
000432r 2  A2 00                ldx     #0
000434r 2  BD FF FF     @rr:    lda     $FFFF,x
000437r 2  20 rr rr             jsr     vdp_reg
00043Ar 2  E8                   inx
00043Br 2  E0 08                cpx     #8
00043Dr 2  D0 F5                bne     @rr
00043Fr 2  60                   rts
000440r 2               
000440r 2               ; write address = name table cell X (column), Y (row).  Keeps X and Y.
000440r 2               vdp_at:
000440r 2  8E rr rr             stx     vdp_t
000443r 2  98                   tya
000444r 2  4A                   lsr                     ; row * 32: high byte = row / 8
000445r 2  4A                   lsr
000446r 2  4A                   lsr
000447r 2  8D rr rr             sta     vdp_t+1
00044Ar 2  98                   tya
00044Br 2  0A                   asl
00044Cr 2  0A                   asl
00044Dr 2  0A                   asl
00044Er 2  0A                   asl
00044Fr 2  0A                   asl                     ; low byte = (row & 7) * 32
000450r 2  18                   clc
000451r 2  6D rr rr             adc     vdp_t
000454r 2  18                   clc
000455r 2  69 00                adc     #<VDP_NAME
000457r 2  8D 1D 7F             sta     VDP_CTRL
00045Ar 2  AD rr rr             lda     vdp_t+1
00045Dr 2  69 18                adc     #>VDP_NAME
00045Fr 2  29 3F                and     #$3F
000461r 2  09 40                ora     #$40
000463r 2  8D 1D 7F             sta     VDP_CTRL
000466r 2  60                   rts
000467r 2               
000467r 2               ; write the 0-ended string at A/Y.  Keeps X.
000467r 2               vdp_puts:
000467r 2  8D rr rr             sta     @rd+1
00046Ar 2  8C rr rr             sty     @rd+2
00046Dr 2  A0 00                ldy     #0
00046Fr 2  B9 FF FF     @rd:    lda     $FFFF,y
000472r 2  F0 06                beq     @done
000474r 2  8D 1C 7F             sta     VDP_DATA
000477r 2  C8                   iny
000478r 2  D0 F5                bne     @rd
00047Ar 2  60           @done:  rts
00047Br 2               
00047Br 2               ; A as two BCD digits.  Keeps X, Y.
00047Br 2               vdp_bcd:
00047Br 2  48                   pha
00047Cr 2  4A                   lsr
00047Dr 2  4A                   lsr
00047Er 2  4A                   lsr
00047Fr 2  4A                   lsr
000480r 2  09 30                ora     #'0'
000482r 2  8D 1C 7F             sta     VDP_DATA
000485r 2  68                   pla
000486r 2  48                   pha
000487r 2  29 0F                and     #$0F
000489r 2  09 30                ora     #'0'
00048Br 2  8D 1C 7F             sta     VDP_DATA
00048Er 2  68                   pla
00048Fr 2  60                   rts
000490r 2               
000490r 2               ; wait for the next frame
000490r 2               vdp_frame:
000490r 2  20 rr rr     @w:     jsr     frame_idle
000493r 2  AD 1D 7F             lda     VDP_CTRL
000496r 2  10 F8                bpl     @w
000498r 2  60                   rts
000499r 2               
000499r 2                       .segment "BSS"
000075r 2  xx xx        vdp_n:          .res 2
000077r 2  xx xx        vdp_src:        .res 2
000079r 2  xx xx        vdp_t:          .res 2
00007Br 2                       .segment "CODE"
000499r 2               
000499r 1                       .include "disp2.s"      ; the picture
000499r 2               ; ============================================================================
000499r 2               ; disp2.s - GOLD GRABBER's picture on the PICO9918 (included by grabber.s)
000499r 2               ;
000499r 2               ; Graphics I, the F18A's ECM2 (2 bits a pixel) for both tile layers and the
000499r 2               ; sprites (16 x 16); the art is gen_pico.py's (grabber_gfx.inc).
000499r 2               ;   layer 1: the field's background (sky, grass, dirt); text (white on black)
000499r 2               ;   layer 2: the miner, the platform and the winch; the things in the pit,
000499r 2               ;            drawn into patterns of their own (the pool, from POOL) by
000499r 2               ;            compose; highlighted text (white on blue)
000499r 2               ;   sprites: the claw, what it holds, the gophers, the bangs, the target,
000499r 2               ;            the rope and the laser (their patterns drawn here)
000499r 2               ; Layer 2 is under the sprites (R50 bit 0).  A game pixel is 1.5 x 2 screen
000499r 2               ; pixels: x = 8 + x + x / 2, y = 8 + 2y.
000499r 2               ; ============================================================================
000499r 2               
000499r 2               V_TP0           = $0000         ; tile patterns, plane 0
000499r 2               V_TP1           = $0800         ;   plane 1
000499r 2               V_SP0           = $1000         ; sprite patterns, plane 0 (32 x 32 bytes)
000499r 2               V_SP1           = $1400         ;   plane 1
000499r 2               V_NAME1         = $1800         ; layer 1 names
000499r 2               V_ATT1          = $1C00         ; layer 1 attributes (a byte a pattern)
000499r 2               V_ATT2          = $1D00         ; layer 2 attributes
000499r 2               V_SATTR         = $1E00         ; sprite attributes
000499r 2               V_NAME2         = $2000         ; layer 2 names
000499r 2               VDP_NAME        = V_NAME1
000499r 2               
000499r 2               NSLOT           = 30            ; sprite patterns for pictures (cached)
000499r 2               SL_ROPE         = 30            ; ... the rope's own
000499r 2               SL_LASER        = 31            ; ... the laser's
000499r 2               PIV_SX          = 8 + PIVX + PIVX / 2
000499r 2               PIV_SY          = 8 + 2 * PIVY
000499r 2               
000499r 2               ; ---- the display's set-up ----------------------------------------------------
000499r 2               gfx_init:
000499r 2  A9 rr                lda     #<vdp_regs
00049Br 2  A0 rr                ldy     #>vdp_regs
00049Dr 2  20 rr rr             jsr     vdp_setup       ; (VRAM cleared)
0004A0r 2  A2 00                ldx     #0              ; the F18A's registers
0004A2r 2  8E rr rr     @r:     stx     tmp
0004A5r 2  BD rr rr             lda     f18a_regs+1,x
0004A8r 2  48                   pha
0004A9r 2  BD rr rr             lda     f18a_regs,x
0004ACr 2  AA                   tax
0004ADr 2  68                   pla
0004AEr 2  20 rr rr             jsr     vdp_reg
0004B1r 2  AE rr rr             ldx     tmp
0004B4r 2  E8                   inx
0004B5r 2  E8                   inx
0004B6r 2  E0 0E                cpx     #F18A_N * 2
0004B8r 2  D0 E8                bne     @r
0004BAr 2                       ; the palette: VR47 = $C0 (auto increment from 0), 128 bytes
0004BAr 2  A9 C0                lda     #$C0
0004BCr 2  A2 2F                ldx     #47
0004BEr 2  20 rr rr             jsr     vdp_reg
0004C1r 2  A2 00                ldx     #0
0004C3r 2  BD rr rr     @p:     lda     pal_data,x
0004C6r 2  8D 1C 7F             sta     VDP_DATA
0004C9r 2  E8                   inx
0004CAr 2  E0 80                cpx     #128
0004CCr 2  D0 F5                bne     @p
0004CEr 2  A9 00                lda     #0
0004D0r 2  A2 2F                ldx     #47
0004D2r 2  20 rr rr             jsr     vdp_reg
0004D5r 2                       ; the font into both planes ($20-$5F)
0004D5r 2  A9 00                lda     #<(V_TP0 + $100)
0004D7r 2  A0 01                ldy     #>(V_TP0 + $100)
0004D9r 2  20 rr rr             jsr     font_up
0004DCr 2  A9 00                lda     #<(V_TP1 + $100)
0004DEr 2  A0 09                ldy     #>(V_TP1 + $100)
0004E0r 2  20 rr rr             jsr     font_up
0004E3r 2                       ; the field's patterns
0004E3r 2  A9 00                lda     #<(V_TP0 + T_BASE * 8)
0004E5r 2  A0 03                ldy     #>(V_TP0 + T_BASE * 8)
0004E7r 2  20 rr rr             jsr     vdp_waddr
0004EAr 2  A9 rr                lda     #<t_pat0
0004ECr 2  8D rr rr             sta     vdp_src
0004EFr 2  A9 rr                lda     #>t_pat0
0004F1r 2  8D rr rr             sta     vdp_src+1
0004F4r 2  A9 B0                lda     #<(T_COUNT * 8)
0004F6r 2  8D rr rr             sta     vdp_n
0004F9r 2  A9 01                lda     #>(T_COUNT * 8)
0004FBr 2  8D rr rr             sta     vdp_n+1
0004FEr 2  20 rr rr             jsr     vdp_copy
000501r 2  A9 00                lda     #<(V_TP1 + T_BASE * 8)
000503r 2  A0 0B                ldy     #>(V_TP1 + T_BASE * 8)
000505r 2  20 rr rr             jsr     vdp_waddr
000508r 2  A9 rr                lda     #<t_pat1
00050Ar 2  8D rr rr             sta     vdp_src
00050Dr 2  A9 rr                lda     #>t_pat1
00050Fr 2  8D rr rr             sta     vdp_src+1
000512r 2  A9 B0                lda     #<(T_COUNT * 8)
000514r 2  8D rr rr             sta     vdp_n
000517r 2  A9 01                lda     #>(T_COUNT * 8)
000519r 2  8D rr rr             sta     vdp_n+1
00051Cr 2  20 rr rr             jsr     vdp_copy
00051Fr 2                       ; the attribute tables
00051Fr 2  A9 00                lda     #<V_ATT1
000521r 2  A0 1C                ldy     #>V_ATT1
000523r 2  20 rr rr             jsr     vdp_waddr
000526r 2  A2 00                ldx     #0
000528r 2  BD rr rr     @a1:    lda     attr1,x
00052Br 2  8D 1C 7F             sta     VDP_DATA
00052Er 2  E8                   inx
00052Fr 2  D0 F7                bne     @a1
000531r 2  A9 00                lda     #<V_ATT2
000533r 2  A0 1D                ldy     #>V_ATT2
000535r 2  20 rr rr             jsr     vdp_waddr
000538r 2  BD rr rr     @a2:    lda     attr2,x
00053Br 2  8D 1C 7F             sta     VDP_DATA
00053Er 2  E8                   inx
00053Fr 2  D0 F7                bne     @a2
000541r 2  A9 FF                lda     #$FF            ; no sprite patterns loaded
000543r 2  A2 1D                ldx     #NSLOT-1
000545r 2  9D rr rr     @s:     sta     sl_part,x
000548r 2  CA                   dex
000549r 2  10 FA                bpl     @s
00054Br 2  8D rr rr             sta     rope_md
00054Er 2  8D rr rr             sta     laser_md
000551r 2  20 rr rr             jsr     cls
000554r 2  A9 C2                lda     #$C2            ; R1: display on, 16K, 16 x 16 sprites, and
000556r 2  A2 01                ldx     #1              ; bit 5 (the VDP interrupt) off
000558r 2  4C rr rr             jmp     vdp_reg
00055Br 2               
00055Br 2               ; the font's 512 bytes to VRAM at A/Y
00055Br 2  20 rr rr     font_up:jsr     vdp_waddr
00055Er 2  A9 rr                lda     #<font
000560r 2  8D rr rr             sta     vdp_src
000563r 2  A9 rr                lda     #>font
000565r 2  8D rr rr             sta     vdp_src+1
000568r 2  A9 00                lda     #<512
00056Ar 2  8D rr rr             sta     vdp_n
00056Dr 2  A9 02                lda     #>512
00056Fr 2  8D rr rr             sta     vdp_n+1
000572r 2  4C rr rr             jmp     vdp_copy
000575r 2               
000575r 2               ; before going back to the console: the PICO9918 resets itself and its
000575r 2               ; palette (VR50 = $C0)
000575r 2               pal_restore:
000575r 2  A9 C0                lda     #$C0
000577r 2  A2 32                ldx     #50
000579r 2  4C rr rr             jmp     vdp_reg
00057Cr 2               
00057Cr 2               ; ---- a new page --------------------------------------------------------------
00057Cr 2               ; both layers empty (black), no sprites, the things' patterns all free
00057Cr 2               new_screen:
00057Cr 2  AD rr rr     cls:    lda     font_gone       ; (the things were drawn over letters)
00057Fr 2  F0 22                beq     @f
000581r 2  A9 00                lda     #<(V_TP0 + $100)
000583r 2  A0 01                ldy     #>(V_TP0 + $100)
000585r 2  20 rr rr             jsr     font_up
000588r 2  A9 00                lda     #<(V_TP1 + $100)
00058Ar 2  A0 09                ldy     #>(V_TP1 + $100)
00058Cr 2  20 rr rr             jsr     font_up
00058Fr 2  A9 20                lda     #<(V_ATT2 + $20)
000591r 2  A0 1D                ldy     #>(V_ATT2 + $20)
000593r 2  20 rr rr             jsr     vdp_waddr
000596r 2  A2 20                ldx     #$20
000598r 2  BD rr rr     @fa:    lda     attr2,x
00059Br 2  8D 1C 7F             sta     VDP_DATA
00059Er 2  E8                   inx
00059Fr 2  E0 60                cpx     #$60
0005A1r 2  D0 F5                bne     @fa
0005A3r 2  A9 00        @f:     lda     #0
0005A5r 2  8D rr rr             sta     font_gone
0005A8r 2  8D rr rr             sta     rv
0005ABr 2  8D rr rr             sta     cur_col
0005AEr 2  8D rr rr             sta     cur_row
0005B1r 2  8D rr rr             sta     fieldcol
0005B4r 2  8D rr rr             sta     wshown
0005B7r 2  A9 00                lda     #<V_SATTR       ; no sprites
0005B9r 2  A0 1E                ldy     #>V_SATTR
0005BBr 2  20 rr rr             jsr     vdp_waddr
0005BEr 2  A9 D0                lda     #$D0
0005C0r 2  8D 1C 7F             sta     VDP_DATA
0005C3r 2  A9 00                lda     #<V_NAME1       ; the names: layer 1, then layer 2
0005C5r 2  A0 18                ldy     #>V_NAME1
0005C7r 2  20 rr rr             jsr     vdp_waddr
0005CAr 2  20 rr rr             jsr     @fill
0005CDr 2  A9 00                lda     #<V_NAME2
0005CFr 2  A0 20                ldy     #>V_NAME2
0005D1r 2  20 rr rr             jsr     vdp_waddr
0005D4r 2  20 rr rr             jsr     @fill
0005D7r 2  A9 00                lda     #0              ; layer 2's copy, and the pool
0005D9r 2  AA                   tax
0005DAr 2  9D rr rr     @c:     sta     l2n,x
0005DDr 2  9D rr rr             sta     l2n+256,x
0005E0r 2  9D rr rr             sta     l2n+512,x
0005E3r 2  E8                   inx
0005E4r 2  D0 F4                bne     @c
0005E6r 2  A2 85                ldx     #NPOOL
0005E8r 2  9D rr rr     @u:     sta     pool_used-1,x
0005EBr 2  CA                   dex
0005ECr 2  D0 FA                bne     @u
0005EEr 2  60                   rts
0005EFr 2  A9 00        @fill:  lda     #0
0005F1r 2  8D rr rr             sta     vdp_n
0005F4r 2  A9 03                lda     #3
0005F6r 2  8D rr rr             sta     vdp_n+1
0005F9r 2  A9 00                lda     #0
0005FBr 2  4C rr rr             jmp     vdp_fill
0005FEr 2               
0005FEr 2               ; ---- text --------------------------------------------------------------------------
0005FEr 2               ; a character at the cursor, and the cursor on (off the right edge:
0005FEr 2               ; nothing).  Plain text: layer 1 (white on black), and layer 2 cleared
0005FEr 2               ; there; highlighted (rv): layer 2 (white on blue), but a highlighted space
0005FEr 2               ; in the sky row of the field: nothing (layer 2 cleared).  Preserves A, X, Y.
0005FEr 2  48           putc:   pha
0005FFr 2  8E rr rr             stx     pu_x
000602r 2  8C rr rr             sty     pu_y
000605r 2  AE rr rr             ldx     cur_col
000608r 2  E0 20                cpx     #32
00060Ar 2  90 03                bcc     :+
00060Cr 2  4C rr rr             jmp     @out
00060Fr 2  C9 20        :       cmp     #$20
000611r 2  90 04                bcc     @sp
000613r 2  C9 60                cmp     #$60
000615r 2  90 02                bcc     @ok
000617r 2  A9 20        @sp:    lda     #$20            ; (anything else: a space)
000619r 2  8D rr rr     @ok:    sta     pu_c
00061Cr 2  AD rr rr             lda     cur_row         ; the cell: row * 32 + column
00061Fr 2  8D rr rr             sta     pu_a+1
000622r 2  A9 00                lda     #0
000624r 2  4E rr rr             lsr     pu_a+1
000627r 2  6A                   ror
000628r 2  4E rr rr             lsr     pu_a+1
00062Br 2  6A                   ror
00062Cr 2  4E rr rr             lsr     pu_a+1
00062Fr 2  6A                   ror
000630r 2  0D rr rr             ora     cur_col
000633r 2  8D rr rr             sta     pu_a
000636r 2  AE rr rr             ldx     rv
000639r 2  D0 1D                bne     @hi
00063Br 2  AD rr rr             lda     pu_a            ; layer 1
00063Er 2  AC rr rr             ldy     pu_a+1
000641r 2  18                   clc
000642r 2  69 00                adc     #<V_NAME1
000644r 2  48                   pha
000645r 2  98                   tya
000646r 2  69 18                adc     #>V_NAME1
000648r 2  A8                   tay
000649r 2  68                   pla
00064Ar 2  20 rr rr             jsr     vdp_waddr
00064Dr 2  AD rr rr             lda     pu_c
000650r 2  8D 1C 7F             sta     VDP_DATA
000653r 2  A9 00                lda     #0              ; layer 2 cleared
000655r 2  4C rr rr             jmp     @l2
000658r 2  AD rr rr     @hi:    lda     pu_c
00065Br 2  C9 20                cmp     #$20
00065Dr 2  D0 0E                bne     @l2
00065Fr 2  AE rr rr             ldx     fieldcol
000662r 2  F0 09                beq     @l2
000664r 2  AE rr rr             ldx     cur_row
000667r 2  E0 01                cpx     #1
000669r 2  D0 02                bne     @l2
00066Br 2  A9 00                lda     #0
00066Dr 2  8D rr rr     @l2:    sta     pu_c
000670r 2  AD rr rr             lda     pu_a            ; layer 2 (and its copy)
000673r 2  18                   clc
000674r 2  69 rr                adc     #<l2n
000676r 2  8D rr rr             sta     @w+1
000679r 2  AD rr rr             lda     pu_a+1
00067Cr 2  69 rr                adc     #>l2n
00067Er 2  8D rr rr             sta     @w+2
000681r 2  AD rr rr             lda     pu_c
000684r 2  8D FF FF     @w:     sta     $FFFF
000687r 2  AD rr rr             lda     pu_a
00068Ar 2  AC rr rr             ldy     pu_a+1
00068Dr 2  18                   clc
00068Er 2  69 00                adc     #<V_NAME2
000690r 2  48                   pha
000691r 2  98                   tya
000692r 2  69 20                adc     #>V_NAME2
000694r 2  A8                   tay
000695r 2  68                   pla
000696r 2  20 rr rr             jsr     vdp_waddr
000699r 2  AD rr rr             lda     pu_c
00069Cr 2  8D 1C 7F             sta     VDP_DATA
00069Fr 2  EE rr rr     @out:   inc     cur_col
0006A2r 2  AE rr rr             ldx     pu_x
0006A5r 2  AC rr rr             ldy     pu_y
0006A8r 2  68                   pla
0006A9r 2  60                   rts
0006AAr 2               
0006AAr 2               ; ---- the field ----------------------------------------------------------------------
0006AAr 2               ; the background (layer 1), the miner, platform and winch, and the things
0006AAr 2               ; that lie still (layer 2)
0006AAr 2               draw_field:
0006AAr 2  A9 20                lda     #<(V_NAME1 + 32)        ; (not row 0: the status line)
0006ACr 2  A0 18                ldy     #>(V_NAME1 + 32)
0006AEr 2  20 rr rr             jsr     vdp_waddr
0006B1r 2  A9 rr                lda     #<(field_l1 + 32)
0006B3r 2  8D rr rr             sta     vdp_src
0006B6r 2  A9 rr                lda     #>(field_l1 + 32)
0006B8r 2  8D rr rr             sta     vdp_src+1
0006BBr 2  A9 E0                lda     #<736
0006BDr 2  8D rr rr             sta     vdp_n
0006C0r 2  A9 02                lda     #>736
0006C2r 2  8D rr rr             sta     vdp_n+1
0006C5r 2  20 rr rr             jsr     vdp_copy
0006C8r 2  A2 18                ldx     #N_L2-1         ; layer 2's still pictures (into the copy)
0006CAr 2  BD rr rr     @s:     lda     l2_lo,x
0006CDr 2  18                   clc
0006CEr 2  69 rr                adc     #<l2n
0006D0r 2  8D rr rr             sta     @w+1
0006D3r 2  BD rr rr             lda     l2_hi,x
0006D6r 2  69 rr                adc     #>l2n
0006D8r 2  8D rr rr             sta     @w+2
0006DBr 2  BD rr rr             lda     l2_nm,x
0006DEr 2  8D FF FF     @w:     sta     $FFFF
0006E1r 2  CA                   dex
0006E2r 2  10 E6                bpl     @s
0006E4r 2  A9 00                lda     #0
0006E6r 2  8D rr rr             sta     wshown
0006E9r 2  A2 17                ldx     #NITEM-1        ; the things
0006EBr 2  8E rr rr     @i:     stx     fd_i
0006EEr 2  BD rr rr             lda     it_k,x
0006F1r 2  F0 07                beq     @n
0006F3r 2  C9 07                cmp     #K_GOPHER
0006F5r 2  F0 03                beq     @n
0006F7r 2  20 rr rr             jsr     comp_item
0006FAr 2  AE rr rr     @n:     ldx     fd_i
0006FDr 2  CA                   dex
0006FEr 2  10 EB                bpl     @i
000700r 2  A9 00                lda     #0              ; layer 2 to the screen (not row 0)
000702r 2  8D rr rr             sta     ur_x0
000705r 2  A9 01                lda     #1
000707r 2  8D rr rr             sta     ur_y0
00070Ar 2  A9 1F                lda     #31
00070Cr 2  8D rr rr             sta     ur_x1
00070Fr 2  A9 17                lda     #23
000711r 2  8D rr rr             sta     ur_y1
000714r 2  4C rr rr             jmp     upload
000717r 2               
000717r 2               ; the winch's picture: turning (2 frames) while reeling in
000717r 2               draw_winch:
000717r 2  A9 00                lda     #0
000719r 2  AE rr rr             ldx     hst
00071Cr 2  E0 02                cpx     #H_BACK
00071Er 2  D0 06                bne     @f
000720r 2  AD rr rr             lda     frame
000723r 2  4A                   lsr
000724r 2  29 01                and     #1
000726r 2  CD rr rr     @f:     cmp     wshown
000729r 2  F0 2D                beq     @r
00072Br 2  8D rr rr             sta     wshown
00072Er 2  A2 01                ldx     #N_WINCH-1
000730r 2  8E rr rr     @l:     stx     tmp
000733r 2  BD rr rr             lda     w_lo,x
000736r 2  18                   clc
000737r 2  69 00                adc     #<V_NAME2
000739r 2  48                   pha
00073Ar 2  BD rr rr             lda     w_hi,x
00073Dr 2  69 20                adc     #>V_NAME2
00073Fr 2  A8                   tay
000740r 2  68                   pla
000741r 2  20 rr rr             jsr     vdp_waddr
000744r 2  AE rr rr             ldx     tmp
000747r 2  BD rr rr             lda     w_nm0,x
00074Ar 2  AC rr rr             ldy     wshown
00074Dr 2  F0 03                beq     @0
00074Fr 2  BD rr rr             lda     w_nm1,x
000752r 2  8D 1C 7F     @0:     sta     VDP_DATA
000755r 2  CA                   dex
000756r 2  10 D8                bpl     @l
000758r 2  60           @r:     rts
000759r 2               
000759r 2               ; ---- the things in the pit: drawn into layer 2 ----------------------------------------
000759r 2               ; item X's picture into the pool (ur_ the cells it covers)
000759r 2               comp_item:
000759r 2  BD rr rr             lda     it_k,x
00075Cr 2  38                   sec
00075Dr 2  E9 01                sbc     #1              ; (kinds 1-6 are CP_GEM .. CP_TNT)
00075Fr 2  48                   pha
000760r 2  BD rr rr             lda     it_y,x
000763r 2  0A                   asl
000764r 2  18                   clc
000765r 2  69 08                adc     #8
000767r 2  A8                   tay
000768r 2  BD rr rr             lda     it_x,x
00076Br 2  20 rr rr             jsr     scr_x
00076Er 2  AA                   tax
00076Fr 2  68                   pla
000770r 2                       ; fall through
000770r 2               
000770r 2               ; compose picture A at screen X, Y into layer 2's copy and the pool;
000770r 2               ; ur_x0..ur_y1 = the cells it covers
000770r 2  8E rr rr     compose:stx     cm_x
000773r 2  8C rr rr             sty     cm_y
