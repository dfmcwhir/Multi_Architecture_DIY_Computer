00125Dr 1               ; the last call.  Preserves X and Y (SBC_PADSTATE only changes A).
00125Dr 1               read_pad:
00125Dr 1  20 12 FE             jsr     SBC_PADSTATE
001260r 1  C9 FF                cmp     #$FF            ; every button "pressed" = no pad
001262r 1  D0 02                bne     @ok
001264r 1  A9 00                lda     #0
001266r 1  8D rr rr     @ok:    sta     pad
001269r 1  AD rr rr             lda     padold
00126Cr 1  49 FF                eor     #$FF
00126Er 1  2D rr rr             and     pad
001271r 1  8D rr rr             sta     padnew
001274r 1  AD rr rr             lda     pad
001277r 1  8D rr rr             sta     padold
00127Ar 1  60                   rts
00127Br 1               
00127Br 1               ; throw away waiting characters
00127Br 1               flush_in:
00127Br 1  20 00 FE             jsr     getc
00127Er 1  B0 FB                bcs     flush_in
001280r 1  60                   rts
001281r 1               
001281r 1               ; carry set if A is one of the characters the gamepad driver types for the
001281r 1               ; pad (W A S D and space).  Those are ignored in gamepad mode so that one
001281r 1               ; press doesn't act twice.  Preserves A.
001281r 1               pad_typed:
001281r 1  C9 20                cmp     #' '
001283r 1  F0 12                beq     @y
001285r 1  C9 57                cmp     #'W'
001287r 1  F0 0E                beq     @y
001289r 1  C9 41                cmp     #'A'
00128Br 1  F0 0A                beq     @y
00128Dr 1  C9 53                cmp     #'S'
00128Fr 1  F0 06                beq     @y
001291r 1  C9 44                cmp     #'D'
001293r 1  F0 02                beq     @y
001295r 1  18                   clc
001296r 1  60                   rts
001297r 1  38           @y:     sec
001298r 1  60                   rts
001299r 1               
001299r 1               ; wait for a menu choice.  Returns a key (letters in upper case), or
001299r 1               ; PAD_GO for the gamepad's A or Start button.
001299r 1               menu_key:
001299r 1  20 rr rr 20  @l:     MENU_IDLE
00129Dr 1  rr rr        
00129Fr 1  20 rr rr             jsr     read_pad
0012A2r 1  AD rr rr             lda     padnew
0012A5r 1  29 09                and     #PAD_A | PAD_START
0012A7r 1  D0 21                bne     @pad
0012A9r 1  20 00 FE             jsr     getc
0012ACr 1  90 EB                bcc     @l
0012AEr 1  C9 20                cmp     #' '            ; a space typed by the pad's A button?
0012B0r 1  D0 0D                bne     @up
0012B2r 1  20 rr rr             jsr     read_pad
0012B5r 1  AD rr rr             lda     pad
0012B8r 1  29 01                and     #PAD_A
0012BAr 1  D0 0E                bne     @pad
0012BCr 1  A9 20                lda     #' '
0012BEr 1  60                   rts
0012BFr 1  C9 61        @up:    cmp     #'a'
0012C1r 1  90 06                bcc     @r
0012C3r 1  C9 7B                cmp     #'z'+1
0012C5r 1  B0 02                bcs     @r
0012C7r 1  29 DF                and     #$DF
0012C9r 1  60           @r:     rts
0012CAr 1  20 rr rr     @pad:   jsr     flush_in        ; the space the driver typed for it
0012CDr 1  A9 80                lda     #PAD_GO
0012CFr 1  60                   rts
0012D0r 1               
0012D0r 1               ; print the controls line (CTRL_COL, CTRL_ROW)
0012D0r 1               show_ctrl:
0012D0r 1  20 rr rr             jsr     txt_mode
0012D3r 1  A2 00                ldx     #CTRL_COL
0012D5r 1  A0 16                ldy     #CTRL_ROW
0012D7r 1  20 rr rr             jsr     gotoxy
0012DAr 1  AD rr rr             lda     ctrl
0012DDr 1  F0 07                beq     @kb
0012DFr 1  A9 rr                lda     #<ctrl_pad_txt
0012E1r 1  A0 rr                ldy     #>ctrl_pad_txt
0012E3r 1  4C rr rr             jmp     print
0012E6r 1  A9 rr        @kb:    lda     #<ctrl_kb_txt
0012E8r 1  A0 rr                ldy     #>ctrl_kb_txt
0012EAr 1  4C rr rr             jmp     print
0012EDr 1               
0012EDr 1               ; ============================================================================
0012EDr 1               ; start, title
0012EDr 1               ; ============================================================================
0012EDr 1  D8           start:  cld
0012EEr 1  A2 FF                ldx     #$FF
0012F0r 1  9A                   txs
0012F1r 1  A9 00                lda     #0              ; clear the variables (RAM is random at power-up)
0012F3r 1  AA                   tax
0012F4r 1  A0 03                ldy     #>(bss_end - bss_start + $FF)
0012F6r 1  9D rr rr     @c1:    sta     bss_start,x
0012F9r 1  E8                   inx
0012FAr 1  D0 FA                bne     @c1
0012FCr 1  EE rr rr             inc     @c1+2
0012FFr 1  88                   dey
001300r 1  D0 F4                bne     @c1
001302r 1  AD rr rr             lda     ctrl_def
001305r 1  8D rr rr             sta     ctrl
001308r 1  A9 5A                lda     #$5A
00130Ar 1  8D rr rr             sta     rng
00130Dr 1                       ; the PICO9918?  (CPU Rev2 ROM: a JMP at $FE1B, SBC_SYSINFO)
00130Dr 1  AD 1B FE             lda     SBC_SYSINFO
001310r 1  C9 4C                cmp     #$4C
001312r 1  D0 07                bne     @nopico
001314r 1  20 1B FE             jsr     SBC_SYSINFO
001317r 1  C9 02                cmp     #DISP_PICO
001319r 1  F0 10                beq     @pico
00131Br 1               @nopico:
00131Br 1  A2 00                ldx     #0
00131Dr 1  BD rr rr     @m:     lda     need_txt,x
001320r 1  F0 06                beq     @bye
001322r 1  20 03 FE             jsr     SBC_CHROUT
001325r 1  E8                   inx
001326r 1  D0 F5                bne     @m
001328r 1  4C 06 FE     @bye:   jmp     SBC_MENU
00132Br 1  20 rr rr     @pico:  jsr     sfx_init
00132Er 1  AD rr rr             lda     mute_def
001331r 1  8D rr rr             sta     sfx_mute
001334r 1  20 rr rr             jsr     gfx_init
001337r 1               
001337r 1  20 rr rr     title:  jsr     sfx_off
00133Ar 1  20 rr rr             jsr     new_screen
00133Dr 1  A9 rr                lda     #<title_txt
00133Fr 1  A0 rr                ldy     #>title_txt
001341r 1  20 rr rr             jsr     print
001344r 1  20 rr rr             jsr     hi_title
001347r 1  A2 00                ldx     #0              ; the pictures for the list of things
001349r 1  8E rr rr     @p:     stx     tmp3
00134Cr 1  BD rr rr             lda     tc_x,x
00134Fr 1  8D rr rr             sta     tmp4
001352r 1  BC rr rr             ldy     tc_y,x
001355r 1  BD rr rr             lda     tc_id,x
001358r 1  AE rr rr             ldx     tmp4
00135Br 1  20 rr rr             jsr     compose
00135Er 1  20 rr rr             jsr     upload
001361r 1  AE rr rr             ldx     tmp3
001364r 1  E8                   inx
001365r 1  E0 09                cpx     #NTC
001367r 1  D0 E0                bne     @p
001369r 1  20 rr rr             jsr     show_ctrl
00136Cr 1  20 rr rr             jsr     read_pad
00136Fr 1  20 rr rr             jsr     flush_in
001372r 1  20 rr rr     @wait:  jsr     menu_key
001375r 1  C9 51                cmp     #'Q'
001377r 1  D0 03                bne     @notq
001379r 1  4C rr rr             jmp     exit_game
00137Cr 1  C9 4D        @notq:  cmp     #'M'            ; sound on / off
00137Er 1  D0 06                bne     @notm
001380r 1  20 rr rr             jsr     sfx_toggle
001383r 1  4C rr rr             jmp     @wait
001386r 1  C9 47        @notm:  cmp     #'G'
001388r 1  D0 0E                bne     @notg
00138Ar 1  AD rr rr             lda     ctrl
00138Dr 1  49 01                eor     #1
00138Fr 1  8D rr rr             sta     ctrl
001392r 1  20 rr rr             jsr     show_ctrl
001395r 1  4C rr rr             jmp     @wait
001398r 1  C9 80        @notg:  cmp     #PAD_GO
00139Ar 1  D0 08                bne     @notp
00139Cr 1  A9 01                lda     #1
00139Er 1  8D rr rr             sta     ctrl
0013A1r 1  4C rr rr             jmp     new_game
0013A4r 1  C9 20        @notp:  cmp     #' '
0013A6r 1  D0 CA                bne     @wait
0013A8r 1  4C rr rr             jmp     new_game
0013ABr 1               
0013ABr 1               hi_title:
