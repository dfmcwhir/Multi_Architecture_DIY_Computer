0014F2r 1  A9 00                lda     #0
0014F4r 1  A2 05                ldx     #NEXP-1
0014F6r 1  9D rr rr     @e2:    sta     ex_t,x
0014F9r 1  CA                   dex
0014FAr 1  10 FA                bpl     @e2
0014FCr 1  A9 3C                lda     #LEVEL_TIME
0014FEr 1  8D rr rr             sta     tsec
001501r 1  A9 14                lda     #FPS
001503r 1  8D rr rr             sta     tfr
001506r 1  A9 FF                lda     #$FF
001508r 1  8D rr rr             sta     hud_dirty
00150Br 1  20 rr rr             jsr     calc_hook
00150Er 1               
00150Er 1               ; ---- the frame loop --------------------------------------------------------------
00150Er 1               game_loop:
00150Er 1  20 rr rr             jsr     sfx_poll
001511r 1  A9 00                lda     #0
001513r 1  8D rr rr             sta     nbytes
001516r 1  8D rr rr             sta     nbytes+1
001519r 1  8D rr rr             sta     npix
00151Cr 1  8D rr rr             sta     npix+1
00151Fr 1  20 rr rr             jsr     read_input
001522r 1  AD rr rr             lda     quit
001525r 1  F0 03                beq     @1
001527r 1  4C rr rr             jmp     title
00152Ar 1  20 rr rr     @1:     jsr     hook_update
00152Dr 1  AD rr rr             lda     hst             ; reeling in: a click every 4 frames
001530r 1  C9 02                cmp     #H_BACK
001532r 1  D0 0C                bne     @nr
001534r 1  AD rr rr             lda     frame
001537r 1  29 03                and     #3
001539r 1  D0 05                bne     @nr
00153Br 1  A9 01                lda     #SND_REEL
00153Dr 1  20 rr rr             jsr     sfx_snd
001540r 1  20 rr rr     @nr:    jsr     gophers
001543r 1  20 rr rr             jsr     tnt_update
001546r 1  20 rr rr             jsr     clock
001549r 1  20 rr rr             jsr     frame_draw
00154Cr 1  20 rr rr             jsr     hud_update
00154Fr 1  20 rr rr             jsr     pace
001552r 1  EE rr rr             inc     frame
001555r 1  AD rr rr             lda     tsec            ; the end of the level: out of time,
001558r 1  F0 14                beq     level_end
00155Ar 1  AD rr rr             lda     hst             ; or nothing left worth having
00155Dr 1  D0 AF                bne     game_loop
00155Fr 1  20 rr rr             jsr     count_left
001562r 1  D0 AA                bne     game_loop
001564r 1  A2 05                ldx     #NEXP-1         ; (once the bangs are over)
001566r 1  BD rr rr     @x:     lda     ex_t,x
001569r 1  D0 A3                bne     game_loop
00156Br 1  CA                   dex
00156Cr 1  10 F8                bpl     @x
00156Er 1               
00156Er 1               ; ---- the end of a level: the goal met, or not ----------------------------------------
00156Er 1               level_end:
00156Er 1  A9 00                lda     #0              ; strength, double gems and the laser last one level
001570r 1  8D rr rr             sta     strong
001573r 1  8D rr rr             sta     gx2
001576r 1  8D rr rr             sta     has_laser
001579r 1  AD rr rr             lda     money+2         ; money >= target?
00157Cr 1  CD rr rr             cmp     target+2
00157Fr 1  D0 0E                bne     @c
001581r 1  AD rr rr             lda     money+1
001584r 1  CD rr rr             cmp     target+1
001587r 1  D0 06                bne     @c
001589r 1  AD rr rr             lda     money
00158Cr 1  CD rr rr             cmp     target
00158Fr 1  B0 03        @c:     bcs     @met
001591r 1  4C rr rr             jmp     game_over
001594r 1  A9 09        @met:   lda     #SND_MET
001596r 1  20 rr rr             jsr     sfx_snd
001599r 1  A9 rr                lda     #<met_txt
00159Br 1  A0 rr                ldy     #>met_txt
00159Dr 1  20 rr rr             jsr     print
0015A0r 1  A9 28                lda     #40
0015A2r 1  20 rr rr             jsr     delay_long
0015A5r 1  20 rr rr             jsr     shop
0015A8r 1  4C rr rr             jmp     next_level
0015ABr 1               
0015ABr 1               game_over:
