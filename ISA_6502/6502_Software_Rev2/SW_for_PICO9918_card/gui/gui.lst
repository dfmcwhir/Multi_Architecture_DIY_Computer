ca65 V2.19 - Git d20d99b
Main file   : gui.s
Current file: gui.s

000000r 1               ; ============================================================================
000000r 1               ; gui.s - the file manager (shell) for the 6502 SBC, CPU Rev2, PICO9918
000000r 1               ;
000000r 1               ;   build:  make.bat           (GUI.BIN = install.s + this)
000000r 1               ;   start:  L GUI 0800  then  R      (once; after that G on the boot menu)
000000r 1               ;
000000r 1               ; It lives in the top RAM bank at $1000 (install.s copies it there and
000000r 1               ; registers it with SBC_SHELL), so programs still load at $0800 in bank 0
000000r 1               ; and have all of their RAM.  When a program ends with JMP SBC_MENU (all
000000r 1               ; the games do), or BASIC's EXIT, the ROM comes back here.
000000r 1               ;
000000r 1               ; Needs ROM stage 6 (SBC_DIR, SBC_RUN, SBC_SHELL).
000000r 1               ;
000000r 1               ; Header (at $1000 in its bank):
000000r 1               ;   $1000  JMP start
000000r 1               ;   $1003  "SH65"            (the ROM checks it)
000000r 1               ;   $1007  1 = first start   (install.s's copy; then 0)
000000r 1               ;   $1008  .word the end of the program (for install.s)
000000r 1               ;
000000r 1               ; Screen: Graphics I with the F18A's ECM2 tiles (3 colours + background a
000000r 1               ; tile) and an ECM2 sprite for the mouse pointer.
000000r 1               ;   row 0      the drive and folder; the U: and C: buttons
000000r 1               ;   row 1      column titles
000000r 1               ;   rows 2-21  the files (20 a screen); column 31 the scroll bar
000000r 1               ;   row 22     messages
000000r 1               ;   row 23     buttons: COPY, PASTE, DEL, UP, BASIC, MON, MENU
000000r 1               ;
000000r 1               ; Mouse:    click selects, double click opens; right click = up a folder;
000000r 1               ;           the scroll bar's arrows and track; the buttons
000000r 1               ; Keyboard: Up / Down select, Enter or Right open, Backspace / Left / Esc
000000r 1               ;           up a folder, U / C drive, B BASIC, M monitor, Q boot menu,
000000r 1               ;           R read the folder again, < > a screen up / down,
000000r 1               ;           F5 or K copy, F6 or P paste, F8 or X delete
000000r 1               ;
000000r 1               ; COPY remembers the selected file; PASTE copies it into the folder shown
000000r 1               ; (any folder, either drive: SBC_COPY); DEL deletes the selected file
000000r 1               ; (SBC_DELETE).  Replacing and deleting ask first: YES / NO on the message
000000r 1               ; line (click, Y / N, or the pad's A / B).
000000r 1               ; Gamepad:  Up / Down select, A / Start / Right open, B / Left up a folder,
000000r 1               ;           Select changes the drive
000000r 1               ;
000000r 1               ; Opening: a folder goes into it; .BIN runs (SBC_RUN, bank 0 at $0800);
000000r 1               ; .BAS starts BASIC and runs it; anything else is shown as text.
000000r 1               ;
000000r 1               ; No zero page is used (the ROM's pointers are left alone).
000000r 1               ; ============================================================================
000000r 1               
000000r 1                       .include "sbc_api.inc"
000000r 2               ; sbc_api.inc - fixed ROM entry points of the SBC (see jumptable.s), and the
000000r 2               ; CPU clock.  Use in your own ca65 programs:  .include "sbc_api.inc"
000000r 2               ; (the games find it one folder up: their make.bat passes  -I ..  to ca65)
000000r 2               SBC_CHRIN       = $FE00         ; carry set + A = char, carry clear = none waiting
000000r 2               SBC_CHROUT      = $FE03         ; print A (A, X, Y preserved)
000000r 2               SBC_MENU        = $FE06         ; boot menu
000000r 2               SBC_COLD        = $FE09         ; BASIC cold start
000000r 2               SBC_WARM        = $FE0C         ; BASIC warm start
000000r 2               SBC_MONITOR     = $FE0F         ; monitor prompt (or JMP $FF00)
000000r 2               SBC_PADSTATE    = $FE12         ; A = gamepad buttons held: bit0 A,1 B,2 Select,3 Start,4 Up,5 Down,6 Left,7 Right
000000r 2               SBC_LOAD        = $FE15         ; load a file from the current device (U: or C:): A/Y = parameter block (.word addr, .word max, "NAME.EXT",0)
000000r 2                                               ;   carry clear = loaded, X/Y = length; carry set = failed, A = error code
000000r 2               SBC_CWD         = $FE18         ; A/Y = the monitor's current folder: 0-ended, "" (the top) or "/A/B"
000000r 2                                               ;   (newer ROMs: check for a JMP ($4C) at $FE18 first)
000000r 2               
000000r 2               ; ---- CPU Rev2 ROMs (API version 2).  Check first:  LDA $FE1B / CMP #$4C,
000000r 2               ;      then JSR SBC_SYSINFO and check Y >= 2.
000000r 2               SBC_SYSINFO     = $FE1B         ; A = display type (DISP_...), X = device status, Y = API version
000000r 2               SBC_SEROUT      = $FE1E         ; send A out of the serial console port (A, X, Y preserved)
000000r 2               SBC_MOUSEON     = $FE21         ; A = 1 mouse reports on, 0 off (off at reset); C=1 = no mouse
000000r 2               SBC_MOUSE       = $FE24         ; A = buttons (bit0 L, 1 R, 2 M), X/Y = signed movement since
000000r 2                                               ;   the last call (right/down +); C=1 = a report arrived
000000r 2               SBC_BANKSET     = $FE27         ; A = RAM bank 0-15 for $1000-$7EFF (X, Y kept).  Your code that
000000r 2                                               ;   calls it must be in $0000-$0FFF, or it switches itself out!
000000r 2               SBC_BANKGET     = $FE2A         ; A = bank selected, X = number of banks fitted
000000r 2               SBC_TICKS       = $FE2D         ; A/X/Y = 60 Hz counter, low/middle/high
000000r 2               SBC_ACIAIN      = $FE30         ; serial card 6551: C=1 + A = byte, C=0 none
000000r 2               SBC_ACIAOUT     = $FE33         ; serial card 6551: send A (A, X, Y preserved)
000000r 2               SBC_VSYNC       = $FE36         ; C=1 if a frame ended since the last call (PICO9918 / ESP32_VGA),
000000r 2                                               ;   A = the VDP status / ESP32 STATUS
000000r 2               SBC_CONRESET    = $FE39         ; display back to the text console, cleared (call it when
000000r 2                                               ;   your game exits after changing the display mode)
000000r 2               SBC_SNDNOTE     = $FE3C         ; A/Y -> 5 bytes: voice (AY 0-2, ESP32 0-3), note (0-95, 36 = C4),
000000r 2                                               ;   volume (0-15; AY 16 = envelope), time (16 bit, 1/60 s,
000000r 2                                               ;   0 = hold).  Doesn't wait.  C=1 = bad values
000000r 2               SBC_SNDQUIET    = $FE3F         ; all sound off
000000r 2               SBC_SNDBUSY     = $FE42         ; A = voice: C=1 while its timed note is still playing
000000r 2               SBC_SAY         = $FE45         ; A/Y -> SPO256 allophones (0-63) ended by $FF; queued
000000r 2               SBC_SAYBUSY     = $FE48         ; C=1 while the SPO256 is speaking
000000r 2               SBC_AYREAD      = $FE4B         ; X = AY register (14/15 = I/O ports A/B) -> A
000000r 2               SBC_AYWRITE     = $FE4E         ; AY register X = A (register 7 bits 6/7 = ports A/B output)
000000r 2               SBC_TIME        = $FE51         ; A/Y -> 18 byte buffer <- "mm/dd/yy hh:mm:ss",0 (CF card's DS1302);
000000r 2                                               ;   C=1 = no clock
000000r 2               SBC_SETTIME     = $FE54         ; A/Y -> 14 characters "dwyymmddHHMMSS" (dw 01 = Sunday)
000000r 2               SBC_DIR         = $FE57         ; stage 6: A/Y -> block: .word table, .byte most entries, .byte device
000000r 2                                               ;   ('U', 'C' or 0 = as it is): the current folder (SBC_CWD) into the
000000r 2                                               ;   table, 16 bytes an entry: name 8, ext 3 (space padded), attributes
000000r 2                                               ;   ($10 = folder), size 4.  C=0: A = entries; C=1: A = error code
000000r 2               SBC_RUN         = $FE5A         ; stage 6: A/Y -> block: .byte 0 = .BIN (bank 0, $0800) / 1 = BASIC
000000r 2                                               ;   program, .byte device, "NAME.EXT",0 (in the current folder).
000000r 2                                               ;   Returns only on an error: C=1, A = code
000000r 2               SBC_SHELL       = $FE5D         ; stage 6: A = the RAM bank of a shell ($1000 JMP, $1003 "SH65"):
000000r 2                                               ;   SBC_MENU then goes back to it.  A = 0: none.  C=1: no shell there
000000r 2               SBC_COPY        = $FE60         ; stage 6b: A/Y -> block: .byte source device ('U'/'C'), .word -> source
000000r 2                                               ;   path "/A/NAME.EXT",0, .byte destination device, .word -> its path.
000000r 2                                               ;   Uses every RAM bank but yours as the buffer (bank 0 is lost).
000000r 2                                               ;   C=0 copied; C=1, A = error ($F0 too big)
000000r 2               SBC_DELETE      = $FE63         ; stage 6b: A/Y -> block: .byte device, .word -> path.  C=1, A = error
000000r 2                                               ;   ($42 not found, $FD the drive can't delete)
000000r 2               SBC_DISPTYPE    = $FEFF         ; a byte: the display type (DISP_...)
000000r 2               
000000r 2               ; SBC_SYSINFO display types
000000r 2               DISP_NONE       = 0
000000r 2               DISP_TERM       = 1             ; KB_MONITOR_TERM (PIC32 terminal)
000000r 2               DISP_PICO       = 2             ; PICO9918
000000r 2               DISP_ESP32      = 3             ; ESP32_VGA
000000r 2               
000000r 2               ; SBC_SYSINFO device status bits (X)
000000r 2               DEV_VIA         = $01
000000r 2               DEV_ACIA        = $02
000000r 2               DEV_DISPLAY     = $04
000000r 2               DEV_AVRKBD      = $08
000000r 2               
000000r 2               ; Key codes from the AVR keyboard interface (Serial Rev3 / PICO9918 card)
000000r 2               KEY_UP          = $05           ; ^E  (WordStar)
000000r 2               KEY_DOWN        = $18           ; ^X
000000r 2               KEY_LEFT        = $10           ; ^P
000000r 2               KEY_RIGHT       = $04           ; ^D
000000r 2               KEY_ESC         = $03           ; Esc sends ^C
000000r 2               KEY_F1          = 129           ; F1-F12 = 129-140, shifted 141-152
000000r 2               
000000r 2               ; First RAM address for loaded programs (CPU Rev2 ROM)
000000r 2               SBC_USER_RAM    = $0800
000000r 2               
000000r 2               ; The CPU clock in MHz (whole numbers, 1 to 8).  Programs size their delay
000000r 2               ; loops from it, so a millisecond stays a millisecond.  To build for another
000000r 2               ; clock, change it here or give it on the command line:  make.bat 1
000000r 2               .ifndef CLOCK_MHZ
000000r 2               CLOCK_MHZ       = 2
000000r 2               .endif
000000r 2               
000000r 1               
000000r 1               ; the stage 6 entries (an older sbc_api.inc doesn't have them)
000000r 1               .ifndef SBC_SHELL
000000r 1               SBC_DIR         = $FE57
000000r 1               SBC_RUN         = $FE5A
000000r 1               SBC_SHELL       = $FE5D
000000r 1               .endif
000000r 1               .ifndef SBC_COPY
000000r 1               SBC_COPY        = $FE60
000000r 1               SBC_DELETE      = $FE63
000000r 1               .endif
000000r 1               
000000r 1               VDP_NAME        = $2000
000000r 1               V_TP0           = $0000         ; tile patterns, plane 0
000000r 1               V_TP1           = $0800         ;   plane 1
000000r 1               V_SP0           = $1000         ; sprite patterns, plane 0
000000r 1               V_SP1           = $1800         ;   plane 1
000000r 1               V_ATT           = $2400         ; tile attributes (one a pattern)
000000r 1               V_SAT           = $2600         ; sprite attributes
000000r 1               
000000r 1               LIST_Y          = 2             ; the list's first row
000000r 1               LIST_H          = 20            ; rows in the list
000000r 1               MAXENT          = 200           ; folder entries read
000000r 1               PAGE_LINES      = 21            ; text lines a page in the viewer
000000r 1               TRAMP           = $0F80         ; (common RAM: the way out to bank 0)
000000r 1               
000000r 1               K_BS            = $08
000000r 1               K_CR            = $0D
000000r 1               K_ESC           = $1B
000000r 1               K_DEL           = $7F
000000r 1               
000000r 1                       .segment "CODE"
000000r 1               gui_base:
000000r 1  4C rr rr             jmp     start
000003r 1  53 48 36 35          .byte   "SH65"
000007r 1               gui_new:
000007r 1  01                   .byte   1
000008r 1  rr rr                .word   gui_end
00000Ar 1               
00000Ar 1               ; ----------------------------------------------------------------------------
00000Ar 1               start:
00000Ar 1  D8                   cld
00000Br 1  20 1B FE             jsr     SBC_SYSINFO
00000Er 1  C9 02                cmp     #DISP_PICO
000010r 1  F0 08                beq     @ok
000012r 1  A9 00                lda     #0              ; not the PICO9918: no shell
000014r 1  20 5D FE             jsr     SBC_SHELL
000017r 1  4C 06 FE             jmp     SBC_MENU
00001Ar 1  AD rr rr     @ok:    lda     gui_new
00001Dr 1  F0 20                beq     @old
00001Fr 1  A9 00                lda     #0              ; the first start
000021r 1  8D rr rr             sta     gui_new
000024r 1  8D rr rr             sta     cwd
000027r 1  8D rr rr             sta     sel
00002Ar 1  8D rr rr             sta     top
00002Dr 1  8D rr rr             sta     clip_name
000030r 1  A9 55                lda     #'U'
000032r 1  8D rr rr             sta     dev
000035r 1  A9 80                lda     #128
000037r 1  8D rr rr             sta     m_x
00003Ar 1  A9 60                lda     #96
00003Cr 1  8D rr rr             sta     m_y
00003Fr 1  A9 00        @old:   lda     #0
000041r 1  8D rr rr             sta     mouse_ok
000044r 1  8D rr rr             sta     esc_st
000047r 1  8D rr rr             sta     up_name
00004Ar 1  8D rr rr             sta     m_click
00004Dr 1  8D rr rr             sta     m_rclick
000050r 1  20 12 FE             jsr     SBC_PADSTATE    ; (a button still held from the program)
000053r 1  8D rr rr             sta     pad_old
000056r 1  20 00 FE     @fl:    jsr     SBC_CHRIN       ; keys typed before
000059r 1  B0 FB                bcs     @fl
00005Br 1  20 rr rr             jsr     gfx_init
00005Er 1  20 rr rr             jsr     mouse_init
000061r 1  20 rr rr             jsr     load_dir
000064r 1  20 rr rr     main:   jsr     vdp_frame
000067r 1  EE rr rr             inc     frames
00006Ar 1  20 rr rr             jsr     mouse_poll
00006Dr 1  20 rr rr             jsr     do_mouse
000070r 1  20 rr rr             jsr     do_pad
000073r 1  20 rr rr             jsr     do_keys
000076r 1  4C rr rr             jmp     main
000079r 1               
000079r 1               frame_idle:
000079r 1  60                   rts
00007Ar 1               
00007Ar 1               ; ============================================================================
00007Ar 1               ; the folder
00007Ar 1               ; ============================================================================
00007Ar 1               
00007Ar 1               ; read the folder (dev, cwd), sort it, show it
00007Ar 1               load_dir:
00007Ar 1  A9 rr                lda     #<s_reading
00007Cr 1  A0 rr                ldy     #>s_reading
00007Er 1  20 rr rr             jsr     st_text
000081r 1  20 rr rr             jsr     put_cwd
000084r 1  20 rr rr             jsr     read_dir
000087r 1  90 35                bcc     @ok
000089r 1  8D rr rr             sta     errc
00008Cr 1  AD rr rr             lda     cwd             ; a folder that has gone: try the top
00008Fr 1  F0 16                beq     @fail
000091r 1  A9 00                lda     #0
000093r 1  8D rr rr             sta     cwd
000096r 1  8D rr rr             sta     sel
000099r 1  8D rr rr             sta     top
00009Cr 1  20 rr rr             jsr     put_cwd
00009Fr 1  20 rr rr             jsr     read_dir
0000A2r 1  90 1A                bcc     @ok
0000A4r 1  8D rr rr             sta     errc
0000A7r 1  A9 00        @fail:  lda     #0
0000A9r 1  8D rr rr             sta     n_ent
0000ACr 1  8D rr rr             sta     n_list
0000AFr 1  8D rr rr             sta     sel
0000B2r 1  8D rr rr             sta     top
0000B5r 1  20 rr rr             jsr     draw_all
0000B8r 1  AD rr rr             lda     errc
0000BBr 1  4C rr rr             jmp     st_error
0000BEr 1  8D rr rr     @ok:    sta     n_ent
0000C1r 1  A2 00                ldx     #0
0000C3r 1  AD rr rr             lda     cwd
0000C6r 1  F0 06                beq     @nu
0000C8r 1  A9 FF                lda     #$FF            ; ".." first, below the top
0000CAr 1  8D rr rr             sta     order
0000CDr 1  E8                   inx
0000CEr 1  8E rr rr     @nu:    stx     k0
0000D1r 1  A0 00                ldy     #0
0000D3r 1  CC rr rr     @o:     cpy     n_ent
0000D6r 1  F0 08                beq     @od
0000D8r 1  98                   tya
0000D9r 1  9D rr rr             sta     order,x
0000DCr 1  E8                   inx
0000DDr 1  C8                   iny
0000DEr 1  D0 F3                bne     @o
0000E0r 1  8E rr rr     @od:    stx     n_list
0000E3r 1  20 rr rr             jsr     sort
0000E6r 1  AD rr rr             lda     up_name         ; (back up a folder: select the one left)
0000E9r 1  F0 08                beq     @cl
0000EBr 1  20 rr rr             jsr     find_up
0000EEr 1  A9 00                lda     #0
0000F0r 1  8D rr rr             sta     up_name
0000F3r 1  20 rr rr     @cl:    jsr     clamp_sel
0000F6r 1  20 rr rr             jsr     draw_all
0000F9r 1  4C rr rr             jmp     st_count
0000FCr 1               
0000FCr 1               read_dir:
0000FCr 1  AD rr rr             lda     dev
0000FFr 1  8D rr rr             sta     dirblk+3
000102r 1  A9 rr                lda     #<dirblk
000104r 1  A0 rr                ldy     #>dirblk
000106r 1  4C 57 FE             jmp     SBC_DIR
000109r 1               
000109r 1               ; the ROM's current folder = cwd
000109r 1               put_cwd:
000109r 1  20 18 FE             jsr     SBC_CWD
00010Cr 1  8D rr rr             sta     @wr+1
00010Fr 1  8C rr rr             sty     @wr+2
000112r 1  A2 1F                ldx     #31
000114r 1  BD rr rr     @c:     lda     cwd,x
000117r 1  9D FF FF     @wr:    sta     $FFFF,x
00011Ar 1  CA                   dex
00011Br 1  10 F7                bpl     @c
00011Dr 1  60                   rts
00011Er 1               
00011Er 1               ; table entry A -> ebuf (16 bytes)
00011Er 1               get_ent:
00011Er 1  20 rr rr             jsr     ent_addr
000121r 1  8D rr rr             sta     @rd+1
000124r 1  8C rr rr             sty     @rd+2
000127r 1  A2 0F                ldx     #15
000129r 1  BD FF FF     @rd:    lda     $FFFF,x
00012Cr 1  9D rr rr             sta     ebuf,x
00012Fr 1  CA                   dex
000130r 1  10 F7                bpl     @rd
000132r 1  60                   rts
000133r 1               
000133r 1               ; A = table index -> A/Y = its address (table + 16 A)
000133r 1               ent_addr:
000133r 1  8D rr rr             sta     ea
000136r 1  A9 00                lda     #0
000138r 1  8D rr rr             sta     ea+1
00013Br 1  0E rr rr             asl     ea
00013Er 1  2E rr rr             rol     ea+1
000141r 1  0E rr rr             asl     ea
000144r 1  2E rr rr             rol     ea+1
000147r 1  0E rr rr             asl     ea
00014Ar 1  2E rr rr             rol     ea+1
00014Dr 1  0E rr rr             asl     ea
000150r 1  2E rr rr             rol     ea+1
000153r 1  AD rr rr             lda     ea
000156r 1  18                   clc
000157r 1  69 rr                adc     #<table
000159r 1  48                   pha
00015Ar 1  AD rr rr             lda     ea+1
00015Dr 1  69 rr                adc     #>table
00015Fr 1  A8                   tay
000160r 1  68                   pla
000161r 1  60                   rts
000162r 1               
000162r 1               ; sort order[k0 .. n_list): folders first, then by name (insertion sort)
000162r 1  AE rr rr     sort:   ldx     k0
000165r 1  E8                   inx
000166r 1  8E rr rr             stx     si
000169r 1  AD rr rr     @out:   lda     si
00016Cr 1  CD rr rr             cmp     n_list
00016Fr 1  B0 3F                bcs     @done
000171r 1  AA                   tax
000172r 1  BD rr rr             lda     order,x
000175r 1  8D rr rr             sta     sv
000178r 1  20 rr rr             jsr     get_ent         ; (the one being placed: in ebuf)
00017Br 1  AD rr rr             lda     si
00017Er 1  8D rr rr             sta     sj
000181r 1  AD rr rr     @in:    lda     sj
000184r 1  CD rr rr             cmp     k0
000187r 1  F0 18                beq     @put
000189r 1  AA                   tax
00018Ar 1  BD rr rr             lda     order-1,x
00018Dr 1  20 rr rr             jsr     v_less
000190r 1  90 0F                bcc     @put
000192r 1  AE rr rr             ldx     sj
000195r 1  BD rr rr             lda     order-1,x
000198r 1  9D rr rr             sta     order,x
00019Br 1  CE rr rr             dec     sj
00019Er 1  4C rr rr             jmp     @in
0001A1r 1  AE rr rr     @put:   ldx     sj
0001A4r 1  AD rr rr             lda     sv
0001A7r 1  9D rr rr             sta     order,x
0001AAr 1  EE rr rr             inc     si
0001ADr 1  4C rr rr             jmp     @out
0001B0r 1  60           @done:  rts
0001B1r 1               
0001B1r 1               ; C=1 if the entry in ebuf comes before table entry A
0001B1r 1  20 rr rr     v_less: jsr     ent_addr
0001B4r 1  8D rr rr             sta     @at+1
0001B7r 1  8C rr rr             sty     @at+2
0001BAr 1  8D rr rr             sta     @nm+1
0001BDr 1  8C rr rr             sty     @nm+2
0001C0r 1  AD rr rr             lda     ebuf+11
0001C3r 1  29 10                and     #$10
0001C5r 1  8D rr rr             sta     t1
0001C8r 1  A2 0B                ldx     #11
0001CAr 1  BD FF FF     @at:    lda     $FFFF,x
0001CDr 1  29 10                and     #$10
0001CFr 1  CD rr rr             cmp     t1
0001D2r 1  F0 07                beq     @name
0001D4r 1  AD rr rr             lda     t1              ; one folder, one file: the folder first
0001D7r 1  F0 11                beq     @no
0001D9r 1  38           @yes:   sec
0001DAr 1  60                   rts
0001DBr 1  A2 00        @name:  ldx     #0
0001DDr 1  BD rr rr     @l:     lda     ebuf,x
0001E0r 1  DD FF FF     @nm:    cmp     $FFFF,x
0001E3r 1  D0 07                bne     @d
0001E5r 1  E8                   inx
0001E6r 1  E0 0B                cpx     #11
0001E8r 1  D0 F3                bne     @l
0001EAr 1  18           @no:    clc
0001EBr 1  60                   rts
0001ECr 1  90 EB        @d:     bcc     @yes
0001EEr 1  18                   clc
0001EFr 1  60                   rts
0001F0r 1               
0001F0r 1               ; select the entry named up_name
0001F0r 1               find_up:
0001F0r 1  20 rr rr             jsr     find_name
0001F3r 1  90 03                bcc     @r
0001F5r 1  8E rr rr             stx     sel
0001F8r 1  60           @r:     rts
0001F9r 1               
0001F9r 1               ; the list row of the entry named up_name: C=1, X = the row (and ebuf,
0001F9r 1               ; nbuf hold it); C=0 none
0001F9r 1               find_name:
0001F9r 1  AD rr rr             lda     k0
0001FCr 1  8D rr rr             sta     si
0001FFr 1  AD rr rr     @l:     lda     si
000202r 1  CD rr rr             cmp     n_list
000205r 1  B0 23                bcs     @no
000207r 1  AA                   tax
000208r 1  BD rr rr             lda     order,x
