000148r 1  49 4E 47 20  
00014Cr 1  54 48 45 20  
00015Ar 1               s_start:
00015Ar 1  53 54 41 52          .byte   "STARTING ", 0
00015Er 1  54 49 4E 47  
000162r 1  20 00        
000164r 1  52 45 41 44  s_read: .byte   "READING ", 0
000168r 1  49 4E 47 20  
00016Cr 1  00           
00016Dr 1  3F 46 4F 4C  s_long: .byte   "?FOLDER PATH TOO LONG", 0
000171r 1  44 45 52 20  
000175r 1  50 41 54 48  
000183r 1               s_empty:
000183r 1  20 45 4D 50          .byte   " EMPTY FOLDER", 0
000187r 1  54 59 20 46  
00018Br 1  4F 4C 44 45  
