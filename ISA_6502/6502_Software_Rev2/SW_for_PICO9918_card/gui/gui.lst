000261r 1  9D rr rr             sta     nbuf,x
000264r 1  8E rr rr             stx     nlen
000267r 1  60                   rts
000268r 1               
000268r 1               ; A = the kind of the entry in ebuf: 0 folder, 2 program, 3 BASIC,
000268r 1               ; 4 text, 5 other  (1 is "..")
000268r 1               ent_kind:
