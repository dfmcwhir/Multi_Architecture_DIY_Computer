0002F8r 1  60           @r:     rts
0002F9r 1               
0002F9r 1  AE rr rr     sel_dn: ldx     sel
0002FCr 1  8E rr rr             stx     osel
0002FFr 1  E8                   inx
000300r 1  EC rr rr             cpx     n_list
