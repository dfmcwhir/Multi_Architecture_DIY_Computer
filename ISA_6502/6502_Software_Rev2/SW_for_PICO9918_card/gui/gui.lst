0010C4r 1  20 rr rr             jsr     put_pointer
0010C7r 1  60           @r:     rts
0010C8r 1               
0010C8r 1               mouse_off:
0010C8r 1  AD rr rr             lda     mouse_ok
0010CBr 1  F0 05                beq     @r
0010CDr 1  A9 00                lda     #0
0010CFr 1  20 21 FE             jsr     SBC_MOUSEON
0010D2r 1  60           @r:     rts
0010D3r 1               
0010D3r 1               mouse_flush:
0010D3r 1  20 rr rr             jsr     mouse_poll
0010D6r 1  A9 00                lda     #0
0010D8r 1  8D rr rr             sta     m_click
0010DBr 1  8D rr rr             sta     m_rclick
0010DEr 1  60                   rts
0010DFr 1               
0010DFr 1               ; move the pointer; m_click / m_rclick = a button pressed
0010DFr 1               mouse_poll:
0010DFr 1  AD rr rr             lda     mouse_ok
0010E2r 1  D0 01                bne     @go
0010E4r 1  60                   rts
0010E5r 1  20 24 FE     @go:    jsr     SBC_MOUSE
0010E8r 1  B0 01                bcs     @rep
0010EAr 1  60                   rts
0010EBr 1  8D rr rr     @rep:   sta     m_btn
0010EEr 1  8C rr rr             sty     m_dy
0010F1r 1  8A                   txa                     ; x: 0 .. 252
0010F2r 1  F0 1B                beq     @y
0010F4r 1  30 0E                bmi     @xn
0010F6r 1  18                   clc
0010F7r 1  6D rr rr             adc     m_x
0010FAr 1  B0 04                bcs     @xmax
0010FCr 1  C9 FD                cmp     #253
0010FEr 1  90 0C                bcc     @xs
001100r 1  A9 FC        @xmax:  lda     #252
001102r 1  D0 08                bne     @xs
001104r 1  18           @xn:    clc
001105r 1  6D rr rr             adc     m_x
001108r 1  B0 02                bcs     @xs
00110Ar 1  A9 00                lda     #0
00110Cr 1  8D rr rr     @xs:    sta     m_x
00110Fr 1  AD rr rr     @y:     lda     m_dy            ; y: 0 .. 190
001112r 1  F0 1B                beq     @b
001114r 1  30 0E                bmi     @yn
001116r 1  18                   clc
001117r 1  6D rr rr             adc     m_y
00111Ar 1  B0 04                bcs     @ymax
00111Cr 1  C9 BF                cmp     #191
00111Er 1  90 0C                bcc     @ys
001120r 1  A9 BE        @ymax:  lda     #190
001122r 1  D0 08                bne     @ys
001124r 1  18           @yn:    clc
001125r 1  6D rr rr             adc     m_y
001128r 1  B0 02                bcs     @ys
00112Ar 1  A9 00                lda     #0
00112Cr 1  8D rr rr     @ys:    sta     m_y
00112Fr 1  AD rr rr     @b:     lda     m_old           ; pressed now and not before
001132r 1  49 FF                eor     #$FF
001134r 1  2D rr rr             and     m_btn
001137r 1  4A                   lsr
001138r 1  90 05                bcc     @nl
00113Ar 1  A2 01                ldx     #1
00113Cr 1  8E rr rr             stx     m_click
00113Fr 1  4A           @nl:    lsr
001140r 1  90 05                bcc     @nr
001142r 1  A2 01                ldx     #1
001144r 1  8E rr rr             stx     m_rclick
001147r 1  AD rr rr     @nr:    lda     m_btn
00114Ar 1  8D rr rr             sta     m_old
00114Dr 1               put_pointer:
00114Dr 1  AD rr rr             lda     gfx_on
001150r 1  F0 14                beq     @r
001152r 1  A9 00                lda     #<V_SAT
001154r 1  A0 26                ldy     #>V_SAT
001156r 1  20 rr rr             jsr     vdp_waddr
001159r 1  AE rr rr             ldx     m_y
00115Cr 1  CA                   dex
00115Dr 1  8E 1C 7F             stx     VDP_DATA
001160r 1  AD rr rr             lda     m_x
001163r 1  8D 1C 7F             sta     VDP_DATA
001166r 1  60           @r:     rts
001167r 1               
001167r 1                       .include "lib/vdp.s"
001167r 2               ; ============================================================================
001167r 2               ; vdp.s - PICO9918 / TMS9918A routines shared by the SBC games (CPU Rev2)
001167r 2               ;
001167r 2               ; Include it after setting VDP_NAME (the name table's VRAM address):
001167r 2               ;           VDP_NAME = $1800
001167r 2               ;           .include "lib/vdp.s"
001167r 2               ; No zero page is used: the copy routines patch their own addresses.
001167r 2               ;
001167r 2               ;   vdp_setup   A/Y -> 8 bytes: R0-R7.  Puts a PICO9918 (F18A mode) back to
001167r 2               ;               plain TMS9918A behaviour first (24 rows, all 32 sprites, no
001167r 2               ;               scrolling, no second tile layer; the unlock leaves VR30 at
001167r 2               ;               31 sprites a line),
001167r 2               ;               clears the 16K of VRAM, then loads R0-R7.  Interrupts from
001167r 2               ;               the VDP should be off in R1 (bit 5): the games poll.
001167r 2               ;   vdp_reg     register X = A
001167r 2               ;   vdp_waddr   VRAM write address = A (low) / Y (high)
001167r 2               ;   vdp_fill    write A to VRAM vdp_n (16 bit) times, from the address set
001167r 2               ;   vdp_copy    copy vdp_n bytes from RAM vdp_src to VRAM (from the address set)
001167r 2               ;   vdp_at      write address = the name table cell at column X, row Y
001167r 2               ;   vdp_puts    write the 0-ended string at A/Y from there (names = ASCII)
001167r 2               ;   vdp_bcd     write A as two digits
001167r 2               ;   vdp_frame   wait for the next frame (60 a second), calling frame_idle
001167r 2               ;               (the game's: sound, random numbers) while it waits
001167r 2               ;
001167r 2               ; The VDP's ports: data $7F1C, control/status $7F1D.  Reading the status
001167r 2               ; clears the frame flag, so nothing else should read it while a game runs
001167r 2               ; (the ROM doesn't, with PICO_IRQ = 0 in its config.inc, the default).
001167r 2               ; ============================================================================
001167r 2               
001167r 2               VDP_DATA        = $7F1C
001167r 2               VDP_CTRL        = $7F1D
001167r 2               
001167r 2               ; register X = A.  Keeps A, X, Y.
001167r 2               vdp_reg:
001167r 2  8D 1D 7F             sta     VDP_CTRL
00116Ar 2  48                   pha
00116Br 2  8A                   txa
00116Cr 2  09 80                ora     #$80
00116Er 2  8D 1D 7F             sta     VDP_CTRL
001171r 2  68                   pla
001172r 2  60                   rts
001173r 2               
001173r 2               ; VRAM write address = A (low) / Y (high).  Keeps A, X, Y.
001173r 2               vdp_waddr:
001173r 2  8D 1D 7F             sta     VDP_CTRL
001176r 2  48                   pha
001177r 2  98                   tya
001178r 2  29 3F                and     #$3F
00117Ar 2  09 40                ora     #$40
00117Cr 2  8D 1D 7F             sta     VDP_CTRL
00117Fr 2  68                   pla
001180r 2  60                   rts
001181r 2               
001181r 2               ; write A, vdp_n times.  Keeps A.
001181r 2               vdp_fill:
001181r 2  AE rr rr             ldx     vdp_n           ; the odd bytes first
001184r 2  F0 06                beq     @pg
001186r 2  8D 1C 7F     @lo:    sta     VDP_DATA
001189r 2  CA                   dex
00118Ar 2  D0 FA                bne     @lo
00118Cr 2  AC rr rr     @pg:    ldy     vdp_n+1         ; then whole pages
00118Fr 2  F0 0B                beq     @done
001191r 2  A2 00        @p:     ldx     #0
001193r 2  8D 1C 7F     @pp:    sta     VDP_DATA
001196r 2  CA                   dex
001197r 2  D0 FA                bne     @pp
001199r 2  88                   dey
00119Ar 2  D0 F5                bne     @p
00119Cr 2  60           @done:  rts
00119Dr 2               
00119Dr 2               ; copy vdp_n bytes from vdp_src to VRAM
00119Dr 2               vdp_copy:
00119Dr 2  AD rr rr             lda     vdp_src
0011A0r 2  8D rr rr             sta     @rd+1
0011A3r 2  AD rr rr             lda     vdp_src+1
0011A6r 2  8D rr rr             sta     @rd+2
0011A9r 2  AD rr rr             lda     vdp_n
0011ACr 2  8D rr rr             sta     vdp_t
0011AFr 2  AD rr rr             lda     vdp_n+1
0011B2r 2  8D rr rr             sta     vdp_t+1
0011B5r 2  AD rr rr     @l:     lda     vdp_t
0011B8r 2  0D rr rr             ora     vdp_t+1
0011BBr 2  F0 1C                beq     @done
0011BDr 2  AD FF FF     @rd:    lda     $FFFF
0011C0r 2  8D 1C 7F             sta     VDP_DATA
0011C3r 2  EE rr rr             inc     @rd+1
0011C6r 2  D0 03                bne     :+
0011C8r 2  EE rr rr             inc     @rd+2
0011CBr 2  AD rr rr     :       lda     vdp_t
0011CEr 2  D0 03                bne     :+
0011D0r 2  CE rr rr             dec     vdp_t+1
0011D3r 2  CE rr rr     :       dec     vdp_t
0011D6r 2  4C rr rr             jmp     @l
0011D9r 2  60           @done:  rts
0011DAr 2               
0011DAr 2               ; A/Y -> 8 register values.  Clears VRAM.
0011DAr 2               vdp_setup:
0011DAr 2  8D rr rr             sta     @rr+1
0011DDr 2  8C rr rr             sty     @rr+2
0011E0r 2  AD 1D 7F             lda     VDP_CTRL        ; (resets the register write latch)
0011E3r 2  A9 80                lda     #$80            ; R1 = $80: display off while we work
0011E5r 2  A2 01                ldx     #1
0011E7r 2  20 rr rr             jsr     vdp_reg
0011EAr 2  A9 1C                lda     #$1C            ; F18A unlock (a PICO9918): $1C twice to VR57
0011ECr 2  A2 39                ldx     #57
0011EEr 2  20 rr rr             jsr     vdp_reg
0011F1r 2  20 rr rr             jsr     vdp_reg
0011F4r 2  A9 00                lda     #0              ; VR49: 24 rows, no 80 columns, no layer 2
0011F6r 2  A2 31                ldx     #49
0011F8r 2  20 rr rr             jsr     vdp_reg
0011FBr 2  A2 32                ldx     #50             ; VR50: plain TMS9918A behaviour
0011FDr 2  20 rr rr             jsr     vdp_reg
001200r 2  A2 13                ldx     #19             ; VR19: no line interrupt
001202r 2  20 rr rr             jsr     vdp_reg
001205r 2  A2 19                ldx     #25             ; VR25-VR29: no scrolling, one page
001207r 2  20 rr rr     @sc:    jsr     vdp_reg
00120Ar 2  E8                   inx
00120Br 2  E0 1E                cpx     #30
00120Dr 2  D0 F8                bne     @sc
00120Fr 2  A9 20                lda     #32             ; VR51: all 32 sprites
001211r 2  A2 33                ldx     #51
001213r 2  20 rr rr             jsr     vdp_reg
001216r 2                       ; (on a real TMS9918A those writes land in R0-R7: all set below)
001216r 2  A9 80                lda     #$80            ; R1 again: display off
001218r 2  A2 01                ldx     #1
00121Ar 2  20 rr rr             jsr     vdp_reg
00121Dr 2  A9 00                lda     #0              ; clear the 16K
00121Fr 2  A8                   tay
001220r 2  20 rr rr             jsr     vdp_waddr
001223r 2  A9 00                lda     #$00
001225r 2  8D rr rr             sta     vdp_n
001228r 2  A9 40                lda     #$40
00122Ar 2  8D rr rr             sta     vdp_n+1
00122Dr 2  A9 00                lda     #0
00122Fr 2  20 rr rr             jsr     vdp_fill
001232r 2  A2 00                ldx     #0
001234r 2  BD FF FF     @rr:    lda     $FFFF,x
001237r 2  20 rr rr             jsr     vdp_reg
00123Ar 2  E8                   inx
00123Br 2  E0 08                cpx     #8
00123Dr 2  D0 F5                bne     @rr
00123Fr 2  60                   rts
001240r 2               
001240r 2               ; write address = name table cell X (column), Y (row).  Keeps X and Y.
001240r 2               vdp_at:
001240r 2  8E rr rr             stx     vdp_t
001243r 2  98                   tya
001244r 2  4A                   lsr                     ; row * 32: high byte = row / 8
001245r 2  4A                   lsr
001246r 2  4A                   lsr
001247r 2  8D rr rr             sta     vdp_t+1
00124Ar 2  98                   tya
00124Br 2  0A                   asl
00124Cr 2  0A                   asl
00124Dr 2  0A                   asl
00124Er 2  0A                   asl
00124Fr 2  0A                   asl                     ; low byte = (row & 7) * 32
001250r 2  18                   clc
001251r 2  6D rr rr             adc     vdp_t
001254r 2  18                   clc
001255r 2  69 00                adc     #<VDP_NAME
001257r 2  8D 1D 7F             sta     VDP_CTRL
00125Ar 2  AD rr rr             lda     vdp_t+1
00125Dr 2  69 20                adc     #>VDP_NAME
00125Fr 2  29 3F                and     #$3F
001261r 2  09 40                ora     #$40
001263r 2  8D 1D 7F             sta     VDP_CTRL
001266r 2  60                   rts
001267r 2               
001267r 2               ; write the 0-ended string at A/Y.  Keeps X.
001267r 2               vdp_puts:
001267r 2  8D rr rr             sta     @rd+1
00126Ar 2  8C rr rr             sty     @rd+2
00126Dr 2  A0 00                ldy     #0
00126Fr 2  B9 FF FF     @rd:    lda     $FFFF,y
001272r 2  F0 06                beq     @done
001274r 2  8D 1C 7F             sta     VDP_DATA
001277r 2  C8                   iny
001278r 2  D0 F5                bne     @rd
00127Ar 2  60           @done:  rts
00127Br 2               
00127Br 2               ; A as two BCD digits.  Keeps X, Y.
00127Br 2               vdp_bcd:
00127Br 2  48                   pha
00127Cr 2  4A                   lsr
00127Dr 2  4A                   lsr
00127Er 2  4A                   lsr
00127Fr 2  4A                   lsr
001280r 2  09 30                ora     #'0'
001282r 2  8D 1C 7F             sta     VDP_DATA
001285r 2  68                   pla
001286r 2  48                   pha
001287r 2  29 0F                and     #$0F
001289r 2  09 30                ora     #'0'
00128Br 2  8D 1C 7F             sta     VDP_DATA
00128Er 2  68                   pla
00128Fr 2  60                   rts
001290r 2               
001290r 2               ; wait for the next frame
001290r 2               vdp_frame:
001290r 2  20 rr rr     @w:     jsr     frame_idle
001293r 2  AD 1D 7F             lda     VDP_CTRL
001296r 2  10 F8                bpl     @w
001298r 2  60                   rts
001299r 2               
001299r 2                       .segment "BSS"
000000r 2  xx xx        vdp_n:          .res 2
000002r 2  xx xx        vdp_src:        .res 2
000004r 2  xx xx        vdp_t:          .res 2
000006r 2                       .segment "CODE"
001299r 2               
001299r 1               
001299r 1               ; ============================================================================
001299r 1               ; data
001299r 1               ; ============================================================================
001299r 1                       .segment "RODATA"
000000r 1               
000000r 1               ; R0-R7: Graphics I, display off, names $2000, attributes $2400, tile
000000r 1               ; patterns $0000, sprite attributes $2600, sprite patterns $1000
000000r 1               vdp_regs:
000000r 1  00 80 08 90          .byte   $00, $80, VDP_NAME / $400, V_ATT / $40, V_TP0 / $800, V_SAT / $80, V_SP0 / $800, $01
000004r 1  00 4C 02 01  
000008r 1               f18a_regs:
000008r 1  18 00                .byte   24, 0                   ; palette selects (ECM: unused)
00000Ar 1  1D 00                .byte   29, 0                   ; 2K plane offsets, one page
00000Cr 1  1E 1F                .byte   30, 31                  ; sprites a line
00000Er 1  32 00                .byte   50, $00
000010r 1  31 22                .byte   49, $22                 ; ECM2 tiles, ECM2 sprites, one layer
000012r 1               F18A_N          = (* - f18a_regs) / 2
000012r 1               
000012r 1               ; the extensions: 3 letters and the kind (2 program, 3 BASIC, 4 text)
000012r 1               ext_tab:
000012r 1  42 49 4E 02          .byte   "BIN", 2, "BAS", 3
000016r 1  42 41 53 03  
00001Ar 1  54 58 54 04          .byte   "TXT", 4, "DOC", 4, "ME ", 4, "MD ", 4, "INC", 4, "S  ", 4
00001Er 1  44 4F 43 04  
000022r 1  4D 45 20 04  
000032r 1  41 53 4D 04          .byte   "ASM", 4, "LST", 4, "CFG", 4, "BAT", 4, "LOG", 4, "INI", 4
000036r 1  4C 53 54 04  
00003Ar 1  43 46 47 04  
00004Ar 1  43 20 20 04          .byte   "C  ", 4, "H  ", 4, "PY ", 4, "CSV", 4, "LBL", 4, "MAP", 4
00004Er 1  48 20 20 04  
000052r 1  50 59 20 04  
000062r 1  00                   .byte   0
000063r 1               
000063r 1               ; keys and what they do
000063r 1               key_tab:
000063r 1  05 18 10 08          .byte   KEY_UP, KEY_DOWN, KEY_LEFT, K_BS, K_DEL, KEY_ESC
000067r 1  7F 03        
000069r 1  04 0D 55 43          .byte   KEY_RIGHT, K_CR, 'U', 'C', 'B', 'M', 'Q', 'R', '<', '>', $2C, '.'   ; ($2C = comma)
00006Dr 1  42 4D 51 52  
000071r 1  3C 3E 2C 2E  
000075r 1  85 86 88 4B          .byte   KEY_F1+4, KEY_F1+5, KEY_F1+7, 'K', 'P', 'X'
000079r 1  50 58        
00007Br 1  00                   .byte   0
00007Cr 1  rr rr rr rr  key_go: .word   sel_up-1, sel_dn-1, go_up-1, go_up-1, go_up-1, go_up-1
000080r 1  rr rr rr rr  
000084r 1  rr rr rr rr  
000088r 1  rr rr rr rr          .word   open_sel-1, open_sel-1, drive_u-1, drive_c-1, act_basic-1
00008Cr 1  rr rr rr rr  
000090r 1  rr rr        
000092r 1  rr rr rr rr          .word   act_monitor-1, act_menu-1, refresh-1, page_up-1, page_down-1
000096r 1  rr rr rr rr  
00009Ar 1  rr rr        
00009Cr 1  rr rr rr rr          .word   page_up-1, page_down-1
0000A0r 1  rr rr rr rr          .word   act_copy-1, act_paste-1, act_delete-1, act_copy-1, act_paste-1, act_delete-1
0000A4r 1  rr rr rr rr  
0000A8r 1  rr rr rr rr  
0000ACr 1               
0000ACr 1               ; the viewer's keys: key, 1 next / 2 back / 3 close
0000ACr 1               vkey_tab:
0000ACr 1  20 01 0D 01          .byte   ' ', 1, K_CR, 1, KEY_DOWN, 1, 'S', 1, 'D', 1, KEY_RIGHT, 1
0000B0r 1  18 01 53 01  
0000B4r 1  44 01 04 01  
0000B8r 1  05 02 57 02          .byte   KEY_UP, 2, 'W', 2, 'A', 2
0000BCr 1  41 02        
0000BEr 1  51 03 03 03          .byte   'Q', 3, KEY_ESC, 3, K_ESC, 3, K_BS, 3, K_DEL, 3, KEY_LEFT, 3
0000C2r 1  1B 03 08 03  
0000C6r 1  7F 03 10 03  
0000CAr 1  00                   .byte   0
0000CBr 1               
0000CBr 1               ; the buttons on row 23: first column, after the last, what they do
0000CBr 1  00 05 0B 0F  btn_x0: .byte   0, 5, 11, 15, 18, 24, 28, $FF
0000CFr 1  12 18 1C FF  
0000D3r 1  04 0A 0E 11  btn_x1: .byte   4, 10, 14, 17, 23, 27, 32
0000D7r 1  17 1B 20     
0000DAr 1  rr rr rr rr  btn_go: .word   act_copy-1, act_paste-1, act_delete-1, go_up-1
0000DEr 1  rr rr rr rr  
0000E2r 1  rr rr rr rr          .word   act_basic-1, act_monitor-1, act_menu-1
0000E6r 1  rr rr        
0000E8r 1               
0000E8r 1  43 4F 50 59  s_btns: .byte   "COPY PASTE DEL UP BASIC MON MENU"
0000ECr 1  20 50 41 53  
0000F0r 1  54 45 20 44  
000108r 1  20 20 20 20  s_head: .byte   "    NAME             SIZE TYPE  "
00010Cr 1  4E 41 4D 45  
000110r 1  20 20 20 20  
000128r 1  3C 44 49 52  s_dir:  .byte   "<DIR>"
00012Cr 1  3E           
00012Dr 1               s_kinds:
