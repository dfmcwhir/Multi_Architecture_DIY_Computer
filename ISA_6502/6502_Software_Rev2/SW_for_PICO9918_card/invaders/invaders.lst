00088Br 1  09 30                ora     #'0'
00088Dr 1  8D 1C 7F             sta     VDP_DATA
000890r 1  60                   rts
000891r 1               
000891r 1               ; BCD score += Y:A
000891r 1               add_score:
000891r 1  F8                   sed
000892r 1  18                   clc
000893r 1  6D rr rr             adc     score
000896r 1  8D rr rr             sta     score
000899r 1  98                   tya
00089Ar 1  6D rr rr             adc     score+1
00089Dr 1  8D rr rr             sta     score+1
0008A0r 1  D8                   cld
0008A1r 1  4C rr rr             jmp     show_score
0008A4r 1               
0008A4r 1               ; ============================================================================
0008A4r 1               ; a new wave
0008A4r 1               ; ============================================================================
0008A4r 1               init_wave:
0008A4r 1  A2 04                ldx     #NROWS-1
0008A6r 1  A9 FF        @row:   lda     #$FF
0008A8r 1  9D rr rr             sta     alive,x
0008ABr 1  A9 03                lda     #FORM_C
0008ADr 1  9D rr rr             sta     rowc,x
0008B0r 1  A9 00                lda     #0
0008B2r 1  9D rr rr             sta     rowph,x
0008B5r 1  9D rr rr             sta     rowfrm,x
0008B8r 1  8A                   txa                     ; rowy = FORM_TOP + 2*row + min(wave, 4)
0008B9r 1  0A                   asl
0008BAr 1  18                   clc
0008BBr 1  69 03                adc     #FORM_TOP
0008BDr 1  9D rr rr             sta     rowy,x
0008C0r 1  AD rr rr             lda     wave
0008C3r 1  C9 04                cmp     #4
0008C5r 1  90 02                bcc     @w
0008C7r 1  A9 04                lda     #4
0008C9r 1  18           @w:     clc
0008CAr 1  7D rr rr             adc     rowy,x
0008CDr 1  9D rr rr             sta     rowy,x
0008D0r 1  CA                   dex
0008D1r 1  10 D3                bpl     @row
0008D3r 1  A9 28                lda     #NROWS*NCOLS
0008D5r 1  8D rr rr             sta     alive_count
0008D8r 1  A9 01                lda     #1
0008DAr 1  8D rr rr             sta     dir
0008DDr 1  8D rr rr             sta     inv_t
0008E0r 1  A9 04                lda     #NROWS-1
0008E2r 1  8D rr rr             sta     cur_row
0008E5r 1  A9 00                lda     #0
0008E7r 1  8D rr rr             sta     dropping
0008EAr 1  8D rr rr             sta     invaded
0008EDr 1  8D rr rr             sta     dead
0008F0r 1  8D rr rr             sta     shot_on
0008F3r 1  8D rr rr             sta     bomb_on
0008F6r 1  8D rr rr             sta     bomb_on+1
0008F9r 1  8D rr rr             sta     bomb_on+2
0008FCr 1  8D rr rr             sta     ufo_on
0008FFr 1  8D rr rr             sta     expl_t
000902r 1  8D rr rr             sta     shield_gone
000905r 1  8D rr rr             sta     key_dir
000908r 1  8D rr rr             sta     key_hold
00090Br 1  AD rr rr             lda     wave            ; bombs get more frequent each wave
00090Er 1  C9 06                cmp     #6
000910r 1  90 02                bcc     @r
000912r 1  A9 06                lda     #6
000914r 1  0A           @r:     asl
000915r 1  0A                   asl
000916r 1  18                   clc
000917r 1  69 06                adc     #6              ; 6 .. 30 out of 256 a frame
000919r 1  8D rr rr             sta     bomb_rate
00091Cr 1  A9 78                lda     #PX_START
00091Er 1  8D rr rr             sta     px
000921r 1  20 rr rr             jsr     ufo_reset
000924r 1  A2 BF                ldx     #4*48-1         ; fresh shields
000926r 1  8A           @sh:    txa
000927r 1  48                   pha
000928r 1  C9 30        @m:     cmp     #48             ; (X mod 48)
00092Ar 1  90 04                bcc     @g
00092Cr 1  E9 30                sbc     #48
00092Er 1  B0 F8                bcs     @m
000930r 1  A8           @g:     tay
000931r 1  B9 rr rr             lda     gfx_shield,y
000934r 1  9D rr rr             sta     shields,x
000937r 1  68                   pla
000938r 1  AA                   tax
000939r 1  CA                   dex
00093Ar 1  E0 FF                cpx     #$FF
00093Cr 1  D0 E8                bne     @sh
00093Er 1  60                   rts
00093Fr 1               
00093Fr 1               ; the 4 shields: their patterns from the RAM copy, and their names
00093Fr 1               draw_shields:
00093Fr 1  A9 00                lda     #<(V_PAT + P_SHIELD*8)
000941r 1  A0 03                ldy     #>(V_PAT + P_SHIELD*8)
000943r 1  20 rr rr             jsr     vdp_waddr
000946r 1  A2 00                ldx     #0              ; X = shield * 48 + line * 3 + column
000948r 1  8E rr rr             stx     sd_s
00094Br 1  A0 00        @s:     ldy     #0              ; pattern row 0/1, pattern 0-2, its 8 lines
00094Dr 1  8C rr rr             sty     sd_tr
000950r 1  A9 00        @tr:    lda     #0
000952r 1  8D rr rr             sta     sd_tc
000955r 1  AD rr rr     @tc:    lda     sd_s            ; first byte of this pattern:
000958r 1  8D rr rr             sta     tmp             ; shield*48 + tr*24 + tc
00095Br 1  0A                   asl
00095Cr 1  18                   clc
00095Dr 1  6D rr rr             adc     tmp
000960r 1  0A                   asl
000961r 1  0A                   asl
000962r 1  0A                   asl
000963r 1  0A                   asl                     ; shield * 48
000964r 1  8D rr rr             sta     tmp
000967r 1  AD rr rr             lda     sd_tr
00096Ar 1  F0 02                beq     @t0
00096Cr 1  A9 18                lda     #24
00096Er 1  18           @t0:    clc
00096Fr 1  6D rr rr             adc     tmp
000972r 1  6D rr rr             adc     sd_tc
000975r 1  AA                   tax
000976r 1  A0 08                ldy     #8
000978r 1  BD rr rr     @l:     lda     shields,x
00097Br 1  8D 1C 7F             sta     VDP_DATA
00097Er 1  E8                   inx
00097Fr 1  E8                   inx
000980r 1  E8                   inx
000981r 1  88                   dey
000982r 1  D0 F4                bne     @l
000984r 1  EE rr rr             inc     sd_tc
000987r 1  AD rr rr             lda     sd_tc
00098Ar 1  C9 03                cmp     #3
00098Cr 1  D0 C7                bne     @tc
00098Er 1  EE rr rr             inc     sd_tr
000991r 1  AD rr rr             lda     sd_tr
000994r 1  C9 02                cmp     #2
000996r 1  D0 B8                bne     @tr
000998r 1  EE rr rr             inc     sd_s
00099Br 1  AD rr rr             lda     sd_s
00099Er 1  C9 04                cmp     #4
0009A0r 1  D0 A9                bne     @s
0009A2r 1                       ; the names: P_SHIELD + shield*6 + tr*3 + tc
0009A2r 1  A9 00                lda     #0
0009A4r 1  8D rr rr             sta     sd_s
0009A7r 1  AE rr rr     @n:     ldx     sd_s
0009AAr 1  BD rr rr             lda     shield_col,x
0009ADr 1  AA                   tax
0009AEr 1  A0 12                ldy     #SHIELD_ROW
0009B0r 1  20 rr rr             jsr     vdp_at
0009B3r 1  AD rr rr             lda     sd_s
0009B6r 1  0A                   asl
0009B7r 1  8D rr rr             sta     tmp
0009BAr 1  0A                   asl
0009BBr 1  18                   clc
0009BCr 1  6D rr rr             adc     tmp             ; * 6
0009BFr 1  69 60                adc     #P_SHIELD
0009C1r 1  8D 1C 7F             sta     VDP_DATA
0009C4r 1  69 01                adc     #1
0009C6r 1  8D 1C 7F             sta     VDP_DATA
0009C9r 1  69 01                adc     #1
0009CBr 1  8D 1C 7F             sta     VDP_DATA
0009CEr 1  8D rr rr             sta     tmp
0009D1r 1  A0 13                ldy     #SHIELD_ROW+1
0009D3r 1  20 rr rr             jsr     vdp_at
0009D6r 1  AD rr rr             lda     tmp
0009D9r 1  69 01                adc     #1
0009DBr 1  8D 1C 7F             sta     VDP_DATA
0009DEr 1  69 01                adc     #1
0009E0r 1  8D 1C 7F             sta     VDP_DATA
0009E3r 1  69 01                adc     #1
0009E5r 1  8D 1C 7F             sta     VDP_DATA
0009E8r 1  EE rr rr             inc     sd_s
0009EBr 1  AD rr rr             lda     sd_s
0009EEr 1  C9 04                cmp     #4
0009F0r 1  D0 B5                bne     @n
0009F2r 1  60                   rts
0009F3r 1               
0009F3r 1               ; the invaders have come down to the shields: remove them
0009F3r 1               wipe_shields:
0009F3r 1  AD rr rr             lda     shield_gone
0009F6r 1  D0 32                bne     @done
0009F8r 1  EE rr rr             inc     shield_gone
0009FBr 1  A2 BF                ldx     #4*48-1
0009FDr 1  A9 00                lda     #0
0009FFr 1  9D rr rr     @z:     sta     shields,x
000A02r 1  CA                   dex
000A03r 1  E0 FF                cpx     #$FF
000A05r 1  D0 F8                bne     @z
000A07r 1  A2 00                ldx     #0
000A09r 1  A0 12                ldy     #SHIELD_ROW
000A0Br 1  20 rr rr             jsr     vdp_at
000A0Er 1  A9 40                lda     #64
000A10r 1  8D rr rr             sta     vdp_n
000A13r 1  A9 00                lda     #0
000A15r 1  8D rr rr             sta     vdp_n+1
000A18r 1  A9 00                lda     #P_BLANK
000A1Ar 1  20 rr rr             jsr     vdp_fill
000A1Dr 1  A2 04                ldx     #NROWS-1        ; (any invaders on those lines again)
000A1Fr 1  BD rr rr     @r:     lda     alive,x
000A22r 1  F0 03                beq     @n
000A24r 1  20 rr rr             jsr     draw_row
000A27r 1  CA           @n:     dex
000A28r 1  10 F5                bpl     @r
000A2Ar 1  60           @done:  rts
000A2Br 1               
000A2Br 1               ; ============================================================================
000A2Br 1               ; shields: 4 bitmaps of 24 x 16 pixels (3 bytes a line, bit 7 = left)
000A2Br 1               ; ============================================================================
000A2Br 1               
000A2Br 1               ; is pixel X, Y part of a shield?  Carry set if so; then sh_i = its byte in
000A2Br 1               ; shields, sh_m = its bit, and sh_va = the VRAM address of its pattern byte.
000A2Br 1               ; Preserves X and Y.
000A2Br 1               shield_px:
000A2Br 1  8E rr rr             stx     sh_x
000A2Er 1  8C rr rr             sty     sh_y
000A31r 1  98                   tya
000A32r 1  38                   sec
000A33r 1  E9 90                sbc     #SHIELD_Y
000A35r 1  C9 10                cmp     #16
000A37r 1  B0 11                bcs     @no
000A39r 1  8D rr rr             sta     sh_line
000A3Cr 1  A0 03                ldy     #3
000A3Er 1  8A           @k:     txa
000A3Fr 1  38                   sec
000A40r 1  F9 rr rr             sbc     shield_x,y
000A43r 1  C9 18                cmp     #24
000A45r 1  90 0B                bcc     @found
000A47r 1  88                   dey
000A48r 1  10 F4                bpl     @k
000A4Ar 1  AE rr rr     @no:    ldx     sh_x
000A4Dr 1  AC rr rr             ldy     sh_y
000A50r 1  18                   clc
000A51r 1  60                   rts
000A52r 1  8D rr rr     @found: sta     sh_col          ; 0-23
000A55r 1  8C rr rr             sty     sh_s
000A58r 1  29 07                and     #7
000A5Ar 1  AA                   tax
000A5Br 1  BD rr rr             lda     bitmask_hi,x
000A5Er 1  8D rr rr             sta     sh_m
000A61r 1  AD rr rr             lda     sh_col          ; byte = shield*48 + line*3 + col/8
000A64r 1  4A                   lsr
000A65r 1  4A                   lsr
000A66r 1  4A                   lsr
000A67r 1  8D rr rr             sta     sh_tc
000A6Ar 1  AD rr rr             lda     sh_line
000A6Dr 1  0A                   asl
000A6Er 1  6D rr rr             adc     sh_line
000A71r 1  6D rr rr             adc     sh_tc
000A74r 1  8D rr rr             sta     sh_i
000A77r 1  AD rr rr             lda     sh_s            ; + shield*48
000A7Ar 1  0A                   asl
000A7Br 1  6D rr rr             adc     sh_s
000A7Er 1  0A                   asl
000A7Fr 1  0A                   asl
000A80r 1  0A                   asl
000A81r 1  0A                   asl
000A82r 1  18                   clc
000A83r 1  6D rr rr             adc     sh_i
000A86r 1  8D rr rr             sta     sh_i
000A89r 1  AA                   tax
000A8Ar 1  BD rr rr             lda     shields,x
000A8Dr 1  2D rr rr             and     sh_m
000A90r 1  F0 B8                beq     @no
000A92r 1                       ; the VRAM byte: (P_SHIELD + s*6 + (line/8)*3 + col/8) * 8 + line & 7
000A92r 1  AD rr rr             lda     sh_s
000A95r 1  0A                   asl
000A96r 1  6D rr rr             adc     sh_s
000A99r 1  0A                   asl                     ; s * 6
000A9Ar 1  8D rr rr             sta     tmp3
000A9Dr 1  AD rr rr             lda     sh_line
000AA0r 1  C9 08                cmp     #8
000AA2r 1  AD rr rr             lda     tmp3
000AA5r 1  90 02                bcc     @t
000AA7r 1  69 02                adc     #3-1            ; (carry is set)
000AA9r 1  18           @t:     clc
000AAAr 1  6D rr rr             adc     sh_tc
000AADr 1  69 60                adc     #P_SHIELD       ; the pattern number (< $80)
000AAFr 1  8D rr rr             sta     sh_va+1         ; * 8, into 16 bits
000AB2r 1  A9 00                lda     #0
000AB4r 1  0E rr rr             asl     sh_va+1
000AB7r 1  2A                   rol
000AB8r 1  0E rr rr             asl     sh_va+1
000ABBr 1  2A                   rol
000ABCr 1  0E rr rr             asl     sh_va+1
000ABFr 1  2A                   rol
000AC0r 1  8D rr rr             sta     tmp3            ; high byte
000AC3r 1  AD rr rr             lda     sh_line
000AC6r 1  29 07                and     #7
000AC8r 1  0D rr rr             ora     sh_va+1
000ACBr 1  8D rr rr             sta     sh_va
000ACEr 1  AD rr rr             lda     tmp3
000AD1r 1  8D rr rr             sta     sh_va+1
000AD4r 1  AE rr rr             ldx     sh_x
000AD7r 1  AC rr rr             ldy     sh_y
000ADAr 1  38                   sec
000ADBr 1  60                   rts
000ADCr 1               
000ADCr 1               ; clear the pixel shield_px found.  Preserves X and Y.
000ADCr 1               shield_clr:
000ADCr 1  8E rr rr             stx     sh_x2
000ADFr 1  AE rr rr             ldx     sh_i
000AE2r 1  AD rr rr             lda     sh_m
000AE5r 1  49 FF                eor     #$FF
000AE7r 1  3D rr rr             and     shields,x
000AEAr 1  9D rr rr             sta     shields,x
000AEDr 1  48                   pha
000AEEr 1  AD rr rr             lda     sh_va
000AF1r 1  8D 1D 7F             sta     VDP_CTRL
000AF4r 1  AD rr rr             lda     sh_va+1
000AF7r 1  09 40                ora     #$40 + >V_PAT
000AF9r 1  8D 1D 7F             sta     VDP_CTRL
000AFCr 1  68                   pla
000AFDr 1  8D 1C 7F             sta     VDP_DATA
000B00r 1  AE rr rr             ldx     sh_x2
000B03r 1  60                   rts
000B04r 1               
000B04r 1               ; blast a hole round X, Y: the shield pixels in a 3 x 3 square (and a few
000B04r 1               ; more at random).  Preserves X and Y.
000B04r 1               shield_blast:
000B04r 1  8E rr rr             stx     bl_x
000B07r 1  8C rr rr             sty     bl_y
000B0Ar 1  A9 0C                lda     #12
000B0Cr 1  8D rr rr             sta     bl_n
000B0Fr 1  AE rr rr     @l:     ldx     bl_n
000B12r 1  AD rr rr             lda     bl_y
000B15r 1  18                   clc
000B16r 1  7D rr rr             adc     blast_dy,x
000B19r 1  A8                   tay
000B1Ar 1  AD rr rr             lda     bl_x
000B1Dr 1  18                   clc
000B1Er 1  7D rr rr             adc     blast_dx,x
000B21r 1  AA                   tax
000B22r 1  20 rr rr             jsr     shield_px
000B25r 1  90 0F                bcc     @next
000B27r 1  AD rr rr             lda     bl_n
000B2Ar 1  C9 09                cmp     #9
000B2Cr 1  90 05                bcc     @clr            ; the square: always
000B2Er 1  20 rr rr             jsr     rand
000B31r 1  30 03                bmi     @next           ; the rest: half of them
000B33r 1  20 rr rr     @clr:   jsr     shield_clr
000B36r 1  CE rr rr     @next:  dec     bl_n
000B39r 1  10 D4                bpl     @l
000B3Br 1  AE rr rr             ldx     bl_x
000B3Er 1  AC rr rr             ldy     bl_y
000B41r 1  60                   rts
000B42r 1               
000B42r 1               ; ============================================================================
000B42r 1               ; keyboard / gamepad
000B42r 1               ; ============================================================================
000B42r 1               read_keys:
000B42r 1  A9 00                lda     #0
000B44r 1  8D rr rr             sta     key_fire
000B47r 1  AD rr rr             lda     key_hold        ; a direction key moves for KEY_HOLD frames
000B4Ar 1  F0 0A                beq     @nh             ; (its auto-repeat keeps it going)
000B4Cr 1  CE rr rr             dec     key_hold
000B4Fr 1  D0 05                bne     @nh
000B51r 1  A9 00                lda     #0
000B53r 1  8D rr rr             sta     key_dir
000B56r 1  AD rr rr     @nh:    lda     padold          ; the pad, in either mode: held = moving
000B59r 1  8D rr rr             sta     pad_prev
000B5Cr 1  20 rr rr             jsr     read_pad
000B5Fr 1  AD rr rr             lda     pad
000B62r 1  29 C0                and     #PAD_LEFT | PAD_RIGHT
000B64r 1  F0 17                beq     @nopad
000B66r 1  A2 01                ldx     #1
000B68r 1  29 40                and     #PAD_LEFT
000B6Ar 1  F0 02                beq     @pr
000B6Cr 1  A2 FF                ldx     #$FF
000B6Er 1  8E rr rr     @pr:    stx     key_dir
000B71r 1  A9 00                lda     #0
000B73r 1  8D rr rr             sta     key_hold
000B76r 1  A9 01                lda     #1
000B78r 1  8D rr rr             sta     pad_mv
000B7Br 1  D0 0D                bne     @pf
000B7Dr 1  AD rr rr     @nopad: lda     pad_mv          ; let go: stop at once
000B80r 1  F0 08                beq     @pf
000B82r 1  A9 00                lda     #0
000B84r 1  8D rr rr             sta     pad_mv
000B87r 1  8D rr rr             sta     key_dir
000B8Ar 1  AD rr rr     @pf:    lda     pad
000B8Dr 1  29 03                and     #PAD_A | PAD_B
000B8Fr 1  F0 05                beq     @nf
000B91r 1  A9 01                lda     #1
000B93r 1  8D rr rr             sta     key_fire
000B96r 1  AD rr rr     @nf:    lda     padnew
000B99r 1  29 08                and     #PAD_START
000B9Br 1  F0 03                beq     @l
000B9Dr 1  20 rr rr             jsr     pad_pause
000BA0r 1  20 00 FE     @l:     jsr     getc
000BA3r 1  90 06                bcc     @done
000BA5r 1  20 rr rr             jsr     handle_key
000BA8r 1  4C rr rr             jmp     @l
000BABr 1  60           @done:  rts
000BACr 1               
000BACr 1               handle_key:
000BACr 1  AE rr rr             ldx     esc_st          ; ESC [ C / ESC [ D: arrows from a terminal
000BAFr 1  F0 24                beq     @plain
000BB1r 1  E0 01                cpx     #1
000BB3r 1  D0 12                bne     @esc2
000BB5r 1  C9 5B                cmp     #'['
000BB7r 1  F0 0A                beq     @br
000BB9r 1  C9 4F                cmp     #'O'
000BBBr 1  F0 06                beq     @br
000BBDr 1  A9 00                lda     #0
000BBFr 1  8D rr rr             sta     esc_st
000BC2r 1  60                   rts
000BC3r 1  EE rr rr     @br:    inc     esc_st
000BC6r 1  60                   rts
000BC7r 1  A2 00        @esc2:  ldx     #0
000BC9r 1  8E rr rr             stx     esc_st
000BCCr 1  C9 43                cmp     #'C'
000BCEr 1  F0 5D                beq     @right
000BD0r 1  C9 44                cmp     #'D'
000BD2r 1  F0 55                beq     @left
000BD4r 1  60                   rts
000BD5r 1  C9 1B        @plain: cmp     #$1B
000BD7r 1  D0 04                bne     @np
000BD9r 1  EE rr rr             inc     esc_st
000BDCr 1  60                   rts
000BDDr 1  C9 10        @np:    cmp     #KEY_LEFT       ; the AVR keyboard's arrow keys
000BDFr 1  F0 48                beq     @left
000BE1r 1  C9 04                cmp     #KEY_RIGHT
000BE3r 1  F0 48                beq     @right
000BE5r 1  C9 18                cmp     #KEY_DOWN
000BE7r 1  F0 4F                beq     @stop
000BE9r 1  20 rr rr             jsr     pad_typed       ; W A S D space: typed by the pad?
000BECr 1  90 10                bcc     @kb
000BEEr 1  AE rr rr             ldx     ctrl            ; gamepad mode: always ignored
000BF1r 1  D0 0A                bne     @ign
000BF3r 1  AE rr rr             ldx     pad             ; or while a pad button is (was) held
000BF6r 1  D0 05                bne     @ign
000BF8r 1  AE rr rr             ldx     pad_prev
000BFBr 1  F0 01                beq     @kb
000BFDr 1  60           @ign:   rts
000BFEr 1  C9 20        @kb:    cmp     #' '
000C00r 1  F0 3F                beq     @fire
000C02r 1  C9 2C                cmp     #','
000C04r 1  F0 23                beq     @left
000C06r 1  C9 2E                cmp     #'.'
000C08r 1  F0 23                beq     @right
000C0Ar 1  29 DF                and     #$DF            ; letters to upper case
000C0Cr 1  C9 41                cmp     #'A'
000C0Er 1  F0 19                beq     @left
000C10r 1  C9 44                cmp     #'D'
000C12r 1  F0 19                beq     @right
000C14r 1  C9 53                cmp     #'S'
000C16r 1  F0 20                beq     @stop
000C18r 1  C9 57                cmp     #'W'
000C1Ar 1  F0 25                beq     @fire
000C1Cr 1  C9 51                cmp     #'Q'
000C1Er 1  F0 27                beq     @quit
000C20r 1  C9 50                cmp     #'P'
000C22r 1  F0 29                beq     @pause
000C24r 1  C9 4D                cmp     #'M'
000C26r 1  F0 3C                beq     toggle_sound
000C28r 1  60                   rts
000C29r 1  A9 FF        @left:  lda     #$FF
000C2Br 1  D0 02                bne     @dir
000C2Dr 1  A9 01        @right: lda     #1
000C2Fr 1  8D rr rr     @dir:   sta     key_dir
000C32r 1  A9 07                lda     #KEY_HOLD
000C34r 1  8D rr rr             sta     key_hold
000C37r 1  60                   rts
000C38r 1  A9 00        @stop:  lda     #0
000C3Ar 1  8D rr rr             sta     key_dir
000C3Dr 1  8D rr rr             sta     key_hold
000C40r 1  60                   rts
000C41r 1  A9 01        @fire:  lda     #1
000C43r 1  8D rr rr             sta     key_fire
000C46r 1  60                   rts
000C47r 1  A9 01        @quit:  lda     #1
000C49r 1  8D rr rr             sta     quit
000C4Cr 1  60                   rts
000C4Dr 1  20 rr rr     @pause: jsr     sfx_hush
000C50r 1  20 rr rr     @pw:    jsr     frame_idle_q
000C53r 1  20 00 FE             jsr     getc
000C56r 1  90 F8                bcc     @pw
000C58r 1  A9 00                lda     #0
000C5Ar 1  8D rr rr             sta     key_dir
000C5Dr 1  8D rr rr             sta     key_hold
000C60r 1  60                   rts
000C61r 1               
000C61r 1               ; keeps the random numbers going in a pause (the sound stays quiet)
000C61r 1               frame_idle_q:
000C61r 1  4C rr rr             jmp     rand
000C64r 1               
000C64r 1               toggle_sound:
000C64r 1  AD rr rr             lda     sfx_mute
000C67r 1  49 01                eor     #1
000C69r 1  8D rr rr             sta     sfx_mute
000C6Cr 1  4C rr rr             jmp     sfx_hush
000C6Fr 1               
000C6Fr 1               ; pause until Start is pressed again (or a key)
000C6Fr 1               pad_pause:
000C6Fr 1  20 rr rr             jsr     sfx_hush
000C72r 1  20 rr rr     @l:     jsr     read_pad
000C75r 1  AD rr rr             lda     padnew
000C78r 1  29 08                and     #PAD_START
000C7Ar 1  D0 05                bne     @done
000C7Cr 1  20 00 FE             jsr     getc
000C7Fr 1  90 F1                bcc     @l
000C81r 1  4C rr rr     @done:  jmp     flush_in
000C84r 1               
000C84r 1               ; ============================================================================
000C84r 1               ; the cannon and its shot
000C84r 1               ; ============================================================================
000C84r 1               move_player:
000C84r 1  AD rr rr             lda     key_dir
000C87r 1  F0 34                beq     @done
000C89r 1  AD rr rr             lda     frame_odd       ; 1.5 pixels a frame: 1, then 2
000C8Cr 1  49 01                eor     #1
000C8Er 1  8D rr rr             sta     frame_odd
000C91r 1  18                   clc
000C92r 1  69 01                adc     #1
000C94r 1  8D rr rr             sta     tmp
000C97r 1  AD rr rr             lda     key_dir
000C9Ar 1  30 0F                bmi     @left
000C9Cr 1  AD rr rr             lda     px
000C9Fr 1  18                   clc
000CA0r 1  6D rr rr             adc     tmp
000CA3r 1  C9 EF                cmp     #PX_MAX+1
000CA5r 1  90 13                bcc     @set
000CA7r 1  A9 EE                lda     #PX_MAX
000CA9r 1  D0 0F                bne     @set
000CABr 1  AD rr rr     @left:  lda     px
000CAEr 1  38                   sec
000CAFr 1  ED rr rr             sbc     tmp
000CB2r 1  90 04                bcc     @min
000CB4r 1  C9 04                cmp     #PX_MIN
000CB6r 1  B0 02                bcs     @set
000CB8r 1  A9 04        @min:   lda     #PX_MIN
000CBAr 1  8D rr rr     @set:   sta     px
000CBDr 1               @done:  ; (on into draw_player)
000CBDr 1               
000CBDr 1               draw_player:
000CBDr 1  A9 A7                lda     #PLAYER_Y-1
000CBFr 1  8D rr rr             sta     spr_tab+S_CANNON*4
000CC2r 1  AD rr rr             lda     px
000CC5r 1  8D rr rr             sta     spr_tab+S_CANNON*4+1
000CC8r 1  A9 00                lda     #SP_CANNON
000CCAr 1  8D rr rr             sta     spr_tab+S_CANNON*4+2
000CCDr 1  A9 03                lda     #C_CANNON
000CCFr 1  8D rr rr             sta     spr_tab+S_CANNON*4+3
000CD2r 1  60                   rts
000CD3r 1               
000CD3r 1  AD rr rr     fire:   lda     key_fire
000CD6r 1  F0 1F                beq     @done
000CD8r 1  AD rr rr             lda     shot_on
000CDBr 1  D0 1A                bne     @done
000CDDr 1  AD rr rr             lda     px              ; the gun is at the sprite's 8th pixel
000CE0r 1  8D rr rr             sta     shot_x
000CE3r 1  A9 A4                lda     #PLAYER_Y-4
000CE5r 1  8D rr rr             sta     shot_y
000CE8r 1  A9 01                lda     #1
000CEAr 1  8D rr rr             sta     shot_on
000CEDr 1  20 rr rr             jsr     draw_shot
000CF0r 1  A9 04                lda     #SND_SHOT
000CF2r 1  A2 04                ldx     #4
000CF4r 1  4C rr rr             jmp     sfx_play
000CF7r 1  60           @done:  rts
000CF8r 1               
000CF8r 1               draw_shot:
000CF8r 1  AD rr rr             lda     shot_y
000CFBr 1  38                   sec
000CFCr 1  E9 01                sbc     #1
000CFEr 1  8D rr rr             sta     spr_tab+S_SHOT*4
000D01r 1  AD rr rr             lda     shot_x
000D04r 1  8D rr rr             sta     spr_tab+S_SHOT*4+1
000D07r 1  A9 04                lda     #SP_SHOT
000D09r 1  8D rr rr             sta     spr_tab+S_SHOT*4+2
000D0Cr 1  A9 0F                lda     #C_SHOT
000D0Er 1  8D rr rr             sta     spr_tab+S_SHOT*4+3
000D11r 1  60                   rts
000D12r 1               
000D12r 1               ; the shot goes up 4 pixels a frame, checked a pixel at a time
000D12r 1               move_shot:
000D12r 1  AD rr rr             lda     shot_on
000D15r 1  F0 26                beq     @done
000D17r 1  A9 04                lda     #4
000D19r 1  8D rr rr             sta     shot_n
000D1Cr 1  CE rr rr     @step:  dec     shot_y
000D1Fr 1  AD rr rr             lda     shot_y
000D22r 1  C9 09                cmp     #9              ; the status line
000D24r 1  90 0D                bcc     @off
000D26r 1  20 rr rr             jsr     shot_hits
000D29r 1  B0 08                bcs     @off
000D2Br 1  CE rr rr             dec     shot_n
000D2Er 1  D0 EC                bne     @step
000D30r 1  4C rr rr             jmp     draw_shot
000D33r 1  A9 00        @off:   lda     #0
000D35r 1  8D rr rr             sta     shot_on
000D38r 1  A9 C0                lda     #HIDE_Y
000D3Ar 1  8D rr rr             sta     spr_tab+S_SHOT*4
000D3Dr 1  60           @done:  rts
000D3Er 1               
000D3Er 1               ; has the shot's tip (shot_x + 7, shot_y) hit something?  Carry set if so.
000D3Er 1               shot_hits:
000D3Er 1  AD rr rr             lda     shot_x
000D41r 1  18                   clc
000D42r 1  69 07                adc     #7
000D44r 1  8D rr rr             sta     hit_x
000D47r 1  AD rr rr             lda     ufo_on          ; the saucer?
000D4Ar 1  F0 1B                beq     @inv
000D4Cr 1  AD rr rr             lda     shot_y
000D4Fr 1  C9 0C                cmp     #UFO_Y
000D51r 1  90 14                bcc     @inv
000D53r 1  C9 13                cmp     #UFO_Y+7
000D55r 1  B0 10                bcs     @inv
000D57r 1  AD rr rr             lda     hit_x
000D5Ar 1  38                   sec
000D5Br 1  ED rr rr             sbc     ufo_x
000D5Er 1  C9 10                cmp     #16
000D60r 1  B0 05                bcs     @inv
000D62r 1  20 rr rr             jsr     ufo_hit
000D65r 1  38                   sec
000D66r 1  60                   rts
000D67r 1  AD rr rr     @inv:   lda     shot_y          ; an invader?
000D6Ar 1  4A                   lsr
000D6Br 1  4A                   lsr
000D6Cr 1  4A                   lsr
000D6Dr 1  8D rr rr             sta     hit_row
000D70r 1  A2 04                ldx     #NROWS-1
000D72r 1  BD rr rr     @rl:    lda     alive,x
000D75r 1  F0 15                beq     @next
000D77r 1  BD rr rr             lda     rowy,x
000D7Ar 1  CD rr rr             cmp     hit_row
000D7Dr 1  D0 0D                bne     @next
000D7Fr 1  AD rr rr             lda     hit_x
000D82r 1  20 rr rr             jsr     slot_at
000D85r 1  90 05                bcc     @next
000D87r 1  20 rr rr             jsr     kill_inv
000D8Ar 1  38                   sec
000D8Br 1  60                   rts
000D8Cr 1  CA           @next:  dex
000D8Dr 1  10 E3                bpl     @rl
000D8Fr 1  AE rr rr             ldx     hit_x           ; a shield?
000D92r 1  AC rr rr             ldy     shot_y
000D95r 1  20 rr rr             jsr     shield_px
000D98r 1  90 04                bcc     @r
000D9Ar 1  20 rr rr             jsr     shield_blast
000D9Dr 1  38                   sec
000D9Er 1  60           @r:     rts
000D9Fr 1               
000D9Fr 1               ; ============================================================================
000D9Fr 1               ; the invaders
000D9Fr 1               ; ============================================================================
000D9Fr 1               
000D9Fr 1               ; row X's left pixel (of slot 0), signed 16 bit -> rx (lo), rx+1 (hi):
000D9Fr 1               ; rowc * 8 + rowph * 2.  Preserves X.
000D9Fr 1               row_left:
000D9Fr 1  A9 00                lda     #0
000DA1r 1  8D rr rr             sta     rx+1
000DA4r 1  BD rr rr             lda     rowc,x
000DA7r 1  10 03                bpl     @p
000DA9r 1  CE rr rr             dec     rx+1            ; (negative)
000DACr 1  0A           @p:     asl
000DADr 1  2E rr rr             rol     rx+1
000DB0r 1  0A                   asl
000DB1r 1  2E rr rr             rol     rx+1
000DB4r 1  0A                   asl
000DB5r 1  2E rr rr             rol     rx+1
000DB8r 1  8D rr rr             sta     rx
000DBBr 1  BD rr rr             lda     rowph,x
000DBEr 1  0A                   asl
000DBFr 1  18                   clc
000DC0r 1  6D rr rr             adc     rx
000DC3r 1  8D rr rr             sta     rx
000DC6r 1  90 03                bcc     @r
000DC8r 1  EE rr rr             inc     rx+1
000DCBr 1  60           @r:     rts
000DCCr 1               
000DCCr 1               ; is pixel column A on a live invader of row X?  Carry set if so, with its
000DCCr 1               ; slot in Y.  Preserves X.
000DCCr 1               slot_at:
000DCCr 1  8D rr rr             sta     sa_x
000DCFr 1  20 rr rr             jsr     row_left
000DD2r 1  AD rr rr             lda     sa_x            ; rel = x - left (16 bit), must be 0-191
000DD5r 1  38                   sec
000DD6r 1  ED rr rr             sbc     rx
000DD9r 1  8D rr rr             sta     sa_rel
000DDCr 1  A9 00                lda     #0
000DDEr 1  ED rr rr             sbc     rx+1
000DE1r 1  D0 35                bne     @no
000DE3r 1  AD rr rr             lda     sa_rel
000DE6r 1  C9 C0                cmp     #NCOLS*CELL
000DE8r 1  B0 2E                bcs     @no
000DEAr 1  A0 00                ldy     #0              ; slot = rel / 24, rel = rel mod 24
000DECr 1  C9 18        @d:     cmp     #CELL
