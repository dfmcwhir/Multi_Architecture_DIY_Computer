000EA0r 1  69 01                adc     #1
000EA2r 1  A8                   tay
000EA3r 1  A9 00                lda     #0
000EA5r 1  8D rr rr             sta     dr_c
000EA8r 1  8C rr rr     @on:    sty     dr_i
