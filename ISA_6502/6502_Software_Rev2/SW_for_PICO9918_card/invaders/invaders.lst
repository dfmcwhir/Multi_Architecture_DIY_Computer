ca65 V2.19 - Git d20d99b
Main file   : invaders.s
Current file: invaders.s

000000r 1               ; ============================================================================
000000r 1               ; invaders.s - a Space Invaders style game for the 6502 SBC, CPU Rev2,
000000r 1               ;              on the PICO9918 card (TMS9918A Graphics I mode and sprites)
000000r 1               ;
000000r 1               ;   build:  make.bat  (ca65 -I .. invaders.s, ld65 -C invaders.cfg)
000000r 1               ;   run:    L INVADERS 0800    then   R
000000r 1               ;
000000r 1               ; Header (patchable from the monitor):
000000r 1               ;   $0800  JMP start
000000r 1               ;   $0803  speed      frames per game tick: 1 = full speed (60 a second),
000000r 1               ;                     2 = half speed ...
000000r 1               ;   $0804  controls   at start: 0 keyboard, 1 gamepad (G on the title
000000r 1               ;                     screen switches; A or Start on the pad picks the pad)
000000r 1               ;   $0805  sound      at start: 0 on, 1 off (M switches)
000000r 1               ;
000000r 1               ; Sound: the AY-3-8910 card, through ../ay/sfx.s (timed by the VIA's timer 2).
000000r 1               ;
000000r 1               ; Keys:  A / D, , / . or the arrow keys  move (S or down: stop)
000000r 1               ;        SPACE or W                     fire
000000r 1               ;        P pause, M sound on / off, Q quit (back to the boot menu)
000000r 1               ; Gamepad: left / right move, A or B fire, Start pause
000000r 1               ;
000000r 1               ; The screen (256 x 192, 32 x 24 cells of 8 x 8):
000000r 1               ;   row 0      the status line (text)
000000r 1               ;   y 12       the saucer (a sprite)
000000r 1               ;   rows 3-    the invaders: name table cells.  Each invader has a 24 pixel
000000r 1               ;              cell (3 patterns); the patterns come in 4 positions, 0, 2,
000000r 1               ;              4 and 6 pixels to the right, so a row moves 2 pixels at a
000000r 1               ;              time and is redrawn with one line of names.
000000r 1               ;   rows 18-19 the shields: 4 x 6 patterns of their own, worn away pixel by
000000r 1               ;              pixel (the game keeps a copy of each in RAM)
000000r 1               ;   y 168      the cannon (a sprite);  y 180  the ground
000000r 1               ; Sprites: 0 cannon, 1 shot, 2-4 bombs, 5 saucer, 6 explosion.
000000r 1               ;
000000r 1               ; Timing: one game tick per frame (the VDP's frame flag, polled).
000000r 1               ; No zero page is used, so EhBASIC's and the BIOS's zero page are untouched.
000000r 1               ; ============================================================================
000000r 1               
000000r 1                       .setcpu "6502"
000000r 1               
000000r 1                       .include "sbc_api.inc"  ; fixed ROM entry points ($FE00 table)
000000r 2               ; sbc_api.inc - fixed ROM entry points of the SBC (see jumptable.s), and the
000000r 2               ; CPU clock.  Use in your own ca65 programs:  .include "sbc_api.inc"
000000r 2               ; (the games find it one folder up: their make.bat passes  -I ..  to ca65)
000000r 2               SBC_CHRIN       = $FE00         ; carry set + A = char, carry clear = none waiting
000000r 2               SBC_CHROUT      = $FE03         ; print A (A, X, Y preserved)
000000r 2               SBC_MENU        = $FE06         ; boot menu
000000r 2               SBC_COLD        = $FE09         ; BASIC cold start
000000r 2               SBC_WARM        = $FE0C         ; BASIC warm start
000000r 2               SBC_MONITOR     = $FE0F         ; monitor prompt (or JMP $FF00)
000000r 2               SBC_PADSTATE    = $FE12         ; A = gamepad buttons held: bit0 A,1 B,2 Select,3 Start,4 Up,5 Down,6 Left,7 Right
000000r 2               SBC_LOAD        = $FE15         ; load a file from the current device (U: or C:): A/Y = parameter block (.word addr, .word max, "NAME.EXT",0)
000000r 2                                               ;   carry clear = loaded, X/Y = length; carry set = failed, A = error code
000000r 2               SBC_CWD         = $FE18         ; A/Y = the monitor's current folder: 0-ended, "" (the top) or "/A/B"
000000r 2                                               ;   (newer ROMs: check for a JMP ($4C) at $FE18 first)
000000r 2               
000000r 2               ; ---- CPU Rev2 ROMs (API version 2).  Check first:  LDA $FE1B / CMP #$4C,
000000r 2               ;      then JSR SBC_SYSINFO and check Y >= 2.
000000r 2               SBC_SYSINFO     = $FE1B         ; A = display type (DISP_...), X = device status, Y = API version
000000r 2               SBC_SEROUT      = $FE1E         ; send A out of the serial console port (A, X, Y preserved)
000000r 2               SBC_MOUSEON     = $FE21         ; A = 1 mouse reports on, 0 off (off at reset); C=1 = no mouse
000000r 2               SBC_MOUSE       = $FE24         ; A = buttons (bit0 L, 1 R, 2 M), X/Y = signed movement since
000000r 2                                               ;   the last call (right/down +); C=1 = a report arrived
000000r 2               SBC_BANKSET     = $FE27         ; A = RAM bank 0-15 for $1000-$7EFF (X, Y kept).  Your code that
000000r 2                                               ;   calls it must be in $0000-$0FFF, or it switches itself out!
000000r 2               SBC_BANKGET     = $FE2A         ; A = bank selected, X = number of banks fitted
000000r 2               SBC_TICKS       = $FE2D         ; A/X/Y = 60 Hz counter, low/middle/high
000000r 2               SBC_ACIAIN      = $FE30         ; serial card 6551: C=1 + A = byte, C=0 none
000000r 2               SBC_ACIAOUT     = $FE33         ; serial card 6551: send A (A, X, Y preserved)
000000r 2               SBC_VSYNC       = $FE36         ; C=1 if a frame ended since the last call (PICO9918 / ESP32_VGA),
000000r 2                                               ;   A = the VDP status / ESP32 STATUS
000000r 2               SBC_CONRESET    = $FE39         ; display back to the text console, cleared (call it when
000000r 2                                               ;   your game exits after changing the display mode)
000000r 2               SBC_SNDNOTE     = $FE3C         ; A/Y -> 5 bytes: voice (AY 0-2, ESP32 0-3), note (0-95, 36 = C4),
000000r 2                                               ;   volume (0-15; AY 16 = envelope), time (16 bit, 1/60 s,
000000r 2                                               ;   0 = hold).  Doesn't wait.  C=1 = bad values
000000r 2               SBC_SNDQUIET    = $FE3F         ; all sound off
000000r 2               SBC_SNDBUSY     = $FE42         ; A = voice: C=1 while its timed note is still playing
000000r 2               SBC_SAY         = $FE45         ; A/Y -> SPO256 allophones (0-63) ended by $FF; queued
000000r 2               SBC_SAYBUSY     = $FE48         ; C=1 while the SPO256 is speaking
000000r 2               SBC_AYREAD      = $FE4B         ; X = AY register (14/15 = I/O ports A/B) -> A
000000r 2               SBC_AYWRITE     = $FE4E         ; AY register X = A (register 7 bits 6/7 = ports A/B output)
000000r 2               SBC_TIME        = $FE51         ; A/Y -> 18 byte buffer <- "mm/dd/yy hh:mm:ss",0 (CF card's DS1302);
000000r 2                                               ;   C=1 = no clock
000000r 2               SBC_SETTIME     = $FE54         ; A/Y -> 14 characters "dwyymmddHHMMSS" (dw 01 = Sunday)
000000r 2               SBC_DISPTYPE    = $FEFF         ; a byte: the display type (DISP_...)
000000r 2               
000000r 2               ; SBC_SYSINFO display types
000000r 2               DISP_NONE       = 0
000000r 2               DISP_TERM       = 1             ; KB_MONITOR_TERM (PIC32 terminal)
000000r 2               DISP_PICO       = 2             ; PICO9918
000000r 2               DISP_ESP32      = 3             ; ESP32_VGA
000000r 2               
000000r 2               ; SBC_SYSINFO device status bits (X)
000000r 2               DEV_VIA         = $01
000000r 2               DEV_ACIA        = $02
000000r 2               DEV_DISPLAY     = $04
000000r 2               DEV_AVRKBD      = $08
000000r 2               
000000r 2               ; Key codes from the AVR keyboard interface (Serial Rev3 / PICO9918 card)
000000r 2               KEY_UP          = $05           ; ^E  (WordStar)
000000r 2               KEY_DOWN        = $18           ; ^X
000000r 2               KEY_LEFT        = $10           ; ^P
000000r 2               KEY_RIGHT       = $04           ; ^D
000000r 2               KEY_ESC         = $03           ; Esc sends ^C
000000r 2               KEY_F1          = 129           ; F1-F12 = 129-140, shifted 141-152
000000r 2               
000000r 2               ; First RAM address for loaded programs (CPU Rev2 ROM)
000000r 2               SBC_USER_RAM    = $0800
000000r 2               
000000r 2               ; The CPU clock in MHz (whole numbers, 1 to 8).  Programs size their delay
000000r 2               ; loops from it, so a millisecond stays a millisecond.  To build for another
000000r 2               ; clock, change it here or give it on the command line:  make.bat 1
000000r 2               .ifndef CLOCK_MHZ
000000r 2               CLOCK_MHZ       = 2
000000r 2               .endif
000000r 2               
000000r 1               
000000r 1               ; ---- VRAM layout (Graphics I) -----------------------------------------------
000000r 1               V_PAT           = $0000         ; patterns
000000r 1               V_NAME          = $1800         ; names (32 x 24)
000000r 1               V_SATTR         = $1B00         ; sprite attributes
000000r 1               V_COLOUR        = $2000         ; colours (32 groups of 8 patterns)
000000r 1               V_SPAT          = $3800         ; sprite patterns
000000r 1               VDP_NAME        = V_NAME
000000r 1               
000000r 1               ; patterns
000000r 1               P_BLANK         = $00
000000r 1               P_SHIELD        = $60           ; 4 x 6
000000r 1               P_GROUND        = $78
000000r 1               P_LIFE          = $79           ; 2 side by side
000000r 1               P_INV           = $80           ; kind * 24 + frame * 12 + position * 3
000000r 1               ; sprite patterns (16 x 16: 4 each)
000000r 1               SP_CANNON       = 0
000000r 1               SP_SHOT         = 4
000000r 1               SP_BOMB         = 8             ; and 12
000000r 1               SP_SAUCER       = 16
000000r 1               SP_EXPL         = 20
000000r 1               SP_PEXPL        = 24            ; and 28
000000r 1               ; sprite slots
000000r 1               S_CANNON        = 0
000000r 1               S_SHOT          = 1
000000r 1               S_BOMB          = 2             ; 2-4
000000r 1               S_SAUCER        = 5
000000r 1               S_EXPL          = 6
000000r 1               NSPR            = 7
000000r 1               HIDE_Y          = $C0           ; a sprite's Y that puts it below the screen
000000r 1               ; colours
000000r 1               C_CANNON        = 3             ; light green
000000r 1               C_SHOT          = 15            ; white
000000r 1               C_BOMB          = 15
000000r 1               C_SAUCER        = 8             ; red
000000r 1               C_EXPL          = 15
000000r 1               
000000r 1               ; ---- the layout ----------------------------------------------------------
000000r 1               NROWS           = 5
000000r 1               NCOLS           = 8
000000r 1               CELL            = 24            ; pixels from one invader to the next
000000r 1               FORM_C          = 3             ; starting cell column of the formation
000000r 1               FORM_TOP        = 3             ; starting cell row of the top invader row
000000r 1               SHIELD_ROW      = 18
000000r 1               SHIELD_Y        = SHIELD_ROW*8
000000r 1               PLAYER_Y        = 168
000000r 1               PLAYER_ROW      = PLAYER_Y/8    ; 21
000000r 1               GROUND_ROW      = 22
000000r 1               GROUND_Y        = GROUND_ROW*8+4
000000r 1               UFO_Y           = 12
000000r 1               PX_MIN          = 4             ; the cannon sprite's x range
000000r 1               PX_MAX          = 238
000000r 1               PX_START        = 120
000000r 1               EDGE_L          = 4             ; the formation turns at these pixels
000000r 1               EDGE_R          = 251
000000r 1               KEY_HOLD        = 7             ; frames a direction key keeps moving (the
000000r 1                                               ; keyboard's auto-repeat comes every ~5)
000000r 1               
000000r 1               ; ============================================================================
000000r 1                       .segment "CODE"
000000r 1               
000000r 1  4C rr rr             jmp     start
000003r 1  01           speed:  .byte   1
000004r 1  00           ctrl_def:.byte  0               ; controls at start: 0 keyboard, 1 gamepad
000005r 1  00           mute_def:.byte  0               ; sound at start: 0 on, 1 off
000006r 1  00 00                .byte   0, 0            ; spare
000008r 1               
000008r 1                       .include "ay/sfx.s"     ; sound effects on the AY-3-8910 card
000008r 2               ; ============================================================================
000008r 2               ; sfx.s - sound effects and music for games, on the AY-3-8910 card
000008r 2               ;         ($7F22 register number, $7F23 data; 2 MHz chip clock)
000008r 2               ;
000008r 2               ; Include it in a game (it finds its note table one folder up, like
000008r 2               ; sbc_api.inc:  ca65 -I ..):
000008r 2               ;           .include "ay/sfx.s"
000008r 2               ; and then
000008r 2               ;   sfx_init    once at the start (silence, the timer)
000008r 2               ;   sfx_poll    often: at least every 20 ms (the game loop, and the delay
000008r 2               ;               loops).  It runs the sound 50 times a second, timed by the
000008r 2               ;               VIA's timer 2 (polled: its interrupt stays off; timer 1 and
000008r 2               ;               the gamepad aren't touched).  Keeps A, X, Y and the flags.
000008r 2               ;   sfx_play    play script A on voice X (see below); it doesn't if that
000008r 2               ;               voice is busy with a script of higher priority
000008r 2               ;   sfx_stop    stop voice X
000008r 2               ;   sfx_off     stop everything (and silence)
000008r 2               ;   sfx_mute    0 = sound on, 1 = muted (the scripts still run, unheard)
000008r 2               ;   sfx_hush    call before waiting without sfx_poll (a pause): silences the
000008r 2               ;               card until the next tick
000008r 2               ; With SFX_SND defined before the include, also:
000008r 2               ;   sfx_snd     play script A on its own voice (sfx_prio's high 4 bits)
000008r 2               ;   sfx_toggle  sound on / off (for the M key)
000008r 2               ;
000008r 2               ; The voices: 0-2 are the background (music, a saucer's hum ...) on the
000008r 2               ; chip's channels A-C; 3-5 are the foreground on the same channels.  While
000008r 2               ; a foreground voice plays, it is heard instead of the background voice of
000008r 2               ; its channel, which carries on unheard and comes back when it stops.
000008r 2               ;
000008r 2               ; A game lists its scripts in sfx_scripts (.word address) and their
000008r 2               ; priorities in sfx_prio (.byte, higher wins), indexed by script number.
000008r 2               ;
000008r 2               ; A script is bytes, run 50 times a second until it waits:
000008r 2               ;   $80-$FF         wait 1-128 ticks (1/50 s each): $80 + ticks - 1
000008r 2               ;   $20-$7F         note 0-95 (C1 .. B8, A4 = 45): $20 + note; the
000008r 2               ;                   volume goes back to the VOL level, the decay restarts;
000008r 2               ;                   then it waits LEN ticks (if LEN isn't 0)
000008r 2               ;   SX_END          (0) the end: the voice stops
000008r 2               ;   SX_PER  lo, hi  tone period (12 bits): 2 MHz / (16 x period) Hz
000008r 2               ;   SX_VOL  v       volume 0-15 (also the level each note starts at)
000008r 2               ;   SX_NOISE n      noise period 0-31 (for the whole chip)
000008r 2               ;   SX_MIX  m       bit 0 tone on, bit 1 noise on
000008r 2               ;   SX_SWEEP lo, hi add this (signed) to the period every tick (0 = off)
000008r 2               ;   SX_DECAY d      the volume drops by 1 every d ticks (0 = holds)
000008r 2               ;   SX_LOOP c       the start of a part to play c times (0 = for ever)
000008r 2               ;   SX_NEXT         the end of that part
000008r 2               ;   SX_JUMP lo, hi  go on at another script (for music that repeats)
000008r 2               ;   SX_REST         volume 0 until the next note (and wait LEN ticks)
000008r 2               ;   SX_LEN t        notes and rests wait t ticks each from now on (music:
000008r 2               ;                   a byte a note); 0 (the start) = they don't wait
000008r 2               ; ============================================================================
000008r 2               
000008r 2               ; ---- variables (123 bytes): in the BSS, or at SFX_VARS if the game sets it
000008r 2               ;      (SMB puts them at $0100, the bottom of the stack page) ----------------
000008r 2               .ifdef SFX_VARS
000008r 2               sfx_vars        = SFX_VARS
000008r 2               sfx_lo          = sfx_vars
000008r 2               sfx_hi          = sfx_lo + 6
000008r 2               sfx_wait        = sfx_hi + 6
000008r 2               sfx_perl        = sfx_wait + 6
000008r 2               sfx_perh        = sfx_perl + 6
000008r 2               sfx_swl         = sfx_perh + 6
000008r 2               sfx_swh         = sfx_swl + 6
000008r 2               sfx_vol         = sfx_swh + 6
000008r 2               sfx_base        = sfx_vol + 6
000008r 2               sfx_dec         = sfx_base + 6
000008r 2               sfx_decc        = sfx_dec + 6
000008r 2               sfx_mix         = sfx_decc + 6
000008r 2               sfx_noise       = sfx_mix + 6
000008r 2               sfx_lpl         = sfx_noise + 6
000008r 2               sfx_lph         = sfx_lpl + 6
000008r 2               sfx_lcnt        = sfx_lph + 6
000008r 2               sfx_vprio       = sfx_lcnt + 6
000008r 2               sfx_len         = sfx_vprio + 6
000008r 2               sfx_runs        = sfx_len + 6
000008r 2               sfx_mixer       = sfx_runs + 1
000008r 2               sfx_chan        = sfx_mixer + 1
000008r 2               sfx_guard       = sfx_chan + 1
000008r 2               sfx_mute        = sfx_guard + 2
000008r 2               sfx_sa          = sfx_mute + 1
000008r 2               sfx_sx          = sfx_sa + 1
000008r 2               sfx_sy          = sfx_sx + 1
000008r 2               sfx_vars_end    = sfx_sy + 1
000008r 2               .else
000008r 2                       .segment "BSS"
000000r 2               sfx_vars:
000000r 2  xx xx xx xx  sfx_lo:     .res 6              ; script pointer (high byte 0: voice off)
000004r 2  xx xx        
000006r 2  xx xx xx xx  sfx_hi:     .res 6
00000Ar 2  xx xx        
00000Cr 2  xx xx xx xx  sfx_wait:   .res 6
000010r 2  xx xx        
000012r 2  xx xx xx xx  sfx_perl:   .res 6              ; tone period
000016r 2  xx xx        
000018r 2  xx xx xx xx  sfx_perh:   .res 6
00001Cr 2  xx xx        
00001Er 2  xx xx xx xx  sfx_swl:    .res 6              ; sweep
000022r 2  xx xx        
000024r 2  xx xx xx xx  sfx_swh:    .res 6
000028r 2  xx xx        
00002Ar 2  xx xx xx xx  sfx_vol:    .res 6
00002Er 2  xx xx        
000030r 2  xx xx xx xx  sfx_base:   .res 6              ; the volume notes start at
000034r 2  xx xx        
000036r 2  xx xx xx xx  sfx_dec:    .res 6              ; decay: ticks a step
00003Ar 2  xx xx        
00003Cr 2  xx xx xx xx  sfx_decc:   .res 6
000040r 2  xx xx        
000042r 2  xx xx xx xx  sfx_mix:    .res 6
000046r 2  xx xx        
000048r 2  xx xx xx xx  sfx_noise:  .res 6
00004Cr 2  xx xx        
00004Er 2  xx xx xx xx  sfx_lpl:    .res 6              ; loop start
000052r 2  xx xx        
000054r 2  xx xx xx xx  sfx_lph:    .res 6
000058r 2  xx xx        
00005Ar 2  xx xx xx xx  sfx_lcnt:   .res 6
00005Er 2  xx xx        
000060r 2  xx xx xx xx  sfx_vprio:  .res 6
000064r 2  xx xx        
000066r 2  xx xx xx xx  sfx_len:    .res 6              ; LEN
00006Ar 2  xx xx        
00006Cr 2  xx           sfx_runs:   .res 1
00006Dr 2  xx           sfx_mixer:  .res 1
00006Er 2  xx           sfx_chan:   .res 1
00006Fr 2  xx xx        sfx_guard:  .res 2
000071r 2  xx           sfx_mute:   .res 1
000072r 2  xx           sfx_sa:     .res 1              ; (sfx_snd)
000073r 2  xx           sfx_sx:     .res 1
000074r 2  xx           sfx_sy:     .res 1
000075r 2               sfx_vars_end:
000075r 2                       .segment "CODE"
000008r 2               .endif
000008r 2               
000008r 2               SX_END          = 0
000008r 2               SX_PER          = 1
000008r 2               SX_VOL          = 2
000008r 2               SX_NOISE        = 3
000008r 2               SX_MIX          = 4
000008r 2               SX_SWEEP        = 5
000008r 2               SX_DECAY        = 6
000008r 2               SX_LOOP         = 7
000008r 2               SX_NEXT         = 8
000008r 2               SX_JUMP         = 9
000008r 2               SX_REST         = 10
000008r 2               SX_LEN          = 11
000008r 2               .define SX_WAIT(t)  ($80 + (t) - 1)
000008r 2               .define SX_NOTE(n)  ($20 + (n))
000008r 2               
000008r 2               SFX_AY_ADDR     = $7F22
000008r 2               SFX_AY_DATA     = $7F23
000008r 2               SFX_T2CL        = $7F08
000008r 2               SFX_T2CH        = $7F09
000008r 2               SFX_ACR         = $7F0B
000008r 2               SFX_IFR         = $7F0D
000008r 2               SFX_IER         = $7F0E
000008r 2               
000008r 2               ; the timer counts a 50th of a second in SFX_RUNS runs of SFX_COUNT cycles
000008r 2               ; (it holds 16 bits)
000008r 2               SFX_CYCLES      = CLOCK_MHZ * 20000
000008r 2               SFX_RUNS        = (SFX_CYCLES + 65535) / 65536
000008r 2               SFX_COUNT       = SFX_CYCLES / SFX_RUNS - 2
000008r 2               
000008r 2               ; ---- the routines ------------------------------------------------------------------------
000008r 2               sfx_init:
000008r 2  A9 00                lda     #0
00000Ar 2  A2 74                ldx     #sfx_vars_end - sfx_vars - 1
00000Cr 2  9D rr rr     @c:     sta     sfx_vars,x
00000Fr 2  CA                   dex
000010r 2  10 FA                bpl     @c
000012r 2  AD 0B 7F             lda     SFX_ACR         ; timer 2: one shot, its interrupt off
000015r 2  29 DF                and     #$DF
000017r 2  8D 0B 7F             sta     SFX_ACR
00001Ar 2  A9 20                lda     #$20
00001Cr 2  8D 0E 7F             sta     SFX_IER
00001Fr 2  A9 02                lda     #SFX_RUNS
000021r 2  8D rr rr             sta     sfx_runs
000024r 2  A9 3E                lda     #<SFX_COUNT
000026r 2  8D 08 7F             sta     SFX_T2CL
000029r 2  A9 9C                lda     #>SFX_COUNT
00002Br 2  8D 09 7F             sta     SFX_T2CH
00002Er 2                       ; (on into sfx_off)
00002Er 2               
00002Er 2               ; stop every voice, silence
00002Er 2               sfx_off:
00002Er 2  48                   pha
00002Fr 2  8A                   txa
000030r 2  48                   pha
000031r 2  A2 05                ldx     #5
000033r 2  A9 00                lda     #0
000035r 2  9D rr rr     @v:     sta     sfx_hi,x
000038r 2  CA                   dex
000039r 2  10 FA                bpl     @v
00003Br 2  68                   pla
00003Cr 2  AA                   tax
00003Dr 2  68                   pla
00003Er 2                       ; (on into sfx_hush)
00003Er 2               
00003Er 2               ; silence the card (until the next tick).  Keeps A, X, Y.
00003Er 2               sfx_hush:
00003Er 2  48                   pha
00003Fr 2  8A                   txa
000040r 2  48                   pha
000041r 2  A9 07                lda     #7              ; mixer: all off
000043r 2  8D 22 7F             sta     SFX_AY_ADDR
000046r 2  A9 3F                lda     #$3F
000048r 2  8D 23 7F             sta     SFX_AY_DATA
00004Br 2  A2 08                ldx     #8              ; volumes 0
00004Dr 2  A9 00                lda     #0
00004Fr 2  8E 22 7F     @v:     stx     SFX_AY_ADDR
000052r 2  8D 23 7F             sta     SFX_AY_DATA
000055r 2  E8                   inx
000056r 2  E0 0B                cpx     #11
000058r 2  D0 F5                bne     @v
00005Ar 2  68                   pla
00005Br 2  AA                   tax
00005Cr 2  68                   pla
00005Dr 2  60                   rts
00005Er 2               
00005Er 2               ; stop voice X
00005Er 2               sfx_stop:
00005Er 2  48                   pha
00005Fr 2  A9 00                lda     #0
000061r 2  9D rr rr             sta     sfx_hi,x
000064r 2  68                   pla
000065r 2  60                   rts
000066r 2               
000066r 2               ; play script A on voice X (0-5); not if the voice is playing a script of
000066r 2               ; higher priority.  Keeps X.
000066r 2               sfx_play:
000066r 2  A8                   tay
000067r 2  BD rr rr             lda     sfx_hi,x
00006Ar 2  F0 09                beq     @go
00006Cr 2  B9 rr rr             lda     sfx_prio,y
00006Fr 2  DD rr rr             cmp     sfx_vprio,x
000072r 2  B0 01                bcs     @go
000074r 2  60                   rts
000075r 2  B9 rr rr     @go:    lda     sfx_prio,y
000078r 2  9D rr rr             sta     sfx_vprio,x
00007Br 2  98                   tya
00007Cr 2  0A                   asl
00007Dr 2  A8                   tay
00007Er 2  B9 rr rr             lda     sfx_scripts,y
000081r 2  9D rr rr             sta     sfx_lo,x
000084r 2  B9 rr rr             lda     sfx_scripts+1,y
000087r 2  9D rr rr             sta     sfx_hi,x
00008Ar 2  A9 00                lda     #0
00008Cr 2  9D rr rr             sta     sfx_wait,x
00008Fr 2  9D rr rr             sta     sfx_swl,x
000092r 2  9D rr rr             sta     sfx_swh,x
000095r 2  9D rr rr             sta     sfx_dec,x
000098r 2  9D rr rr             sta     sfx_perl,x
00009Br 2  9D rr rr             sta     sfx_perh,x
00009Er 2  9D rr rr             sta     sfx_len,x
0000A1r 2  A9 0F                lda     #15
0000A3r 2  9D rr rr             sta     sfx_base,x
0000A6r 2  9D rr rr             sta     sfx_vol,x
0000A9r 2  A9 01                lda     #1              ; tone on, noise off
0000ABr 2  9D rr rr             sta     sfx_mix,x
0000AEr 2  60                   rts
0000AFr 2               
0000AFr 2               ; run the sound if a tick has come.  Keeps A, X, Y and the flags (so it can
0000AFr 2               ; go anywhere: in putc, in a loop ...)
0000AFr 2               sfx_poll:
0000AFr 2  08                   php
0000B0r 2  48                   pha
0000B1r 2  AD 0D 7F             lda     SFX_IFR
0000B4r 2  29 20                and     #$20
0000B6r 2  D0 03                bne     @t
0000B8r 2  68                   pla
0000B9r 2  28                   plp
0000BAr 2  60                   rts
0000BBr 2  8A           @t:     txa
0000BCr 2  48                   pha
0000BDr 2  98                   tya
0000BEr 2  48                   pha
0000BFr 2                       ; the timer has gone on counting down past 0 ($FFFF, $FFFE ...): how
0000BFr 2                       ; late this call is.  The next run is that much shorter, so the beat
0000BFr 2                       ; keeps time however long the game takes between calls.
0000BFr 2  AE 09 7F     @rd:    ldx     SFX_T2CH
0000C2r 2  AD 08 7F             lda     SFX_T2CL
0000C5r 2  EC 09 7F             cpx     SFX_T2CH        ; (the high byte changed in between: again)
0000C8r 2  D0 F5                bne     @rd
0000CAr 2  38                   sec
0000CBr 2  69 22                adc     #<(SFX_COUNT - SFX_FIX)
0000CDr 2  A8                   tay
0000CEr 2  8A                   txa
0000CFr 2  69 9C                adc     #>(SFX_COUNT - SFX_FIX)
0000D1r 2  B0 04                bcs     @set
0000D3r 2  A0 64                ldy     #100            ; (more than a whole run late: soon)
0000D5r 2  A9 00                lda     #0
0000D7r 2  8C 08 7F     @set:   sty     SFX_T2CL
0000DAr 2  8D 09 7F             sta     SFX_T2CH
0000DDr 2  CE rr rr             dec     sfx_runs
0000E0r 2  D0 08                bne     @r
0000E2r 2  A9 02                lda     #SFX_RUNS
0000E4r 2  8D rr rr             sta     sfx_runs
0000E7r 2  20 rr rr             jsr     sfx_tick
0000EAr 2  68           @r:     pla
0000EBr 2  A8                   tay
0000ECr 2  68                   pla
0000EDr 2  AA                   tax
0000EEr 2  68                   pla
0000EFr 2  28                   plp
0000F0r 2  60                   rts
0000F1r 2               SFX_FIX = 28                    ; cycles from reading the timer to starting it
0000F1r 2               
0000F1r 2               .ifdef SFX_SND
0000F1r 2               ; ---- (with SFX_SND defined) ---------------------------------------------------
0000F1r 2               ; play script A on its own voice: the high 4 bits of its sfx_prio byte (the
0000F1r 2               ; low 4 are its priority).  Keeps A, X and Y.
0000F1r 2               sfx_snd:
0000F1r 2                       sta     sfx_sa
0000F1r 2                       stx     sfx_sx
0000F1r 2                       sty     sfx_sy
0000F1r 2                       tay
0000F1r 2                       lda     sfx_prio,y
0000F1r 2                       lsr
0000F1r 2                       lsr
0000F1r 2                       lsr
0000F1r 2                       lsr
0000F1r 2                       tax
0000F1r 2                       tya
0000F1r 2                       jsr     sfx_play
0000F1r 2                       lda     sfx_sa
0000F1r 2                       ldx     sfx_sx
0000F1r 2                       ldy     sfx_sy
0000F1r 2                       rts
0000F1r 2               
0000F1r 2               ; sound on / off (the M key).  Keeps X and Y.
0000F1r 2               sfx_toggle:
0000F1r 2                       lda     sfx_mute
0000F1r 2                       eor     #1
0000F1r 2                       sta     sfx_mute
0000F1r 2                       jmp     sfx_hush
0000F1r 2               .endif
0000F1r 2               
0000F1r 2               ; ---- a tick: every voice a step, then the card ---------------------------------------------
0000F1r 2               sfx_tick:
0000F1r 2  A2 05                ldx     #5
0000F3r 2  BD rr rr     @v:     lda     sfx_hi,x
0000F6r 2  F0 03                beq     @n
0000F8r 2  20 rr rr             jsr     sfx_voice
0000FBr 2  CA           @n:     dex
0000FCr 2  10 F5                bpl     @v
0000FEr 2                       ; the card: each channel hears its foreground voice if that plays,
0000FEr 2                       ; else its background voice
0000FEr 2  A9 3F                lda     #$3F
000100r 2  8D rr rr             sta     sfx_mixer
000103r 2  A2 02                ldx     #2
000105r 2  8E rr rr     @ch:    stx     sfx_chan
000108r 2  8A                   txa
000109r 2  18                   clc
00010Ar 2  69 03                adc     #3
00010Cr 2  A8                   tay                     ; foreground voice
00010Dr 2  B9 rr rr             lda     sfx_hi,y
000110r 2  D0 0C                bne     @have
000112r 2  AC rr rr             ldy     sfx_chan        ; background voice
000115r 2  B9 rr rr             lda     sfx_hi,y
000118r 2  D0 04                bne     @have
00011Ar 2  A9 00                lda     #0              ; neither: silent
00011Cr 2  F0 4E                beq     @vol
00011Er 2  8A           @have:  txa                     ; the tone period
00011Fr 2  0A                   asl
000120r 2  8D 22 7F             sta     SFX_AY_ADDR
000123r 2  B9 rr rr             lda     sfx_perl,y
000126r 2  8D 23 7F             sta     SFX_AY_DATA
000129r 2  8A                   txa
00012Ar 2  0A                   asl
00012Br 2  09 01                ora     #1
00012Dr 2  8D 22 7F             sta     SFX_AY_ADDR
000130r 2  B9 rr rr             lda     sfx_perh,y
000133r 2  29 0F                and     #$0F
000135r 2  8D 23 7F             sta     SFX_AY_DATA
000138r 2  B9 rr rr             lda     sfx_mix,y       ; the mixer bits (0 = on)
00013Br 2  4A                   lsr
00013Cr 2  90 09                bcc     @nt
00013Er 2  BD rr rr             lda     sfx_tone_on,x
000141r 2  2D rr rr             and     sfx_mixer
000144r 2  8D rr rr             sta     sfx_mixer
000147r 2  B9 rr rr     @nt:    lda     sfx_mix,y
00014Ar 2  29 02                and     #2
00014Cr 2  F0 14                beq     @nn
00014Er 2  BD rr rr             lda     sfx_noise_on,x
000151r 2  2D rr rr             and     sfx_mixer
000154r 2  8D rr rr             sta     sfx_mixer
000157r 2  A9 06                lda     #6
000159r 2  8D 22 7F             sta     SFX_AY_ADDR
00015Cr 2  B9 rr rr             lda     sfx_noise,y
00015Fr 2  8D 23 7F             sta     SFX_AY_DATA
000162r 2  B9 rr rr     @nn:    lda     sfx_vol,y
000165r 2  AC rr rr             ldy     sfx_mute
000168r 2  F0 02                beq     @vol
00016Ar 2  A9 00                lda     #0
00016Cr 2  AC rr rr     @vol:   ldy     sfx_chan
00016Fr 2  AA                   tax
000170r 2  98                   tya
000171r 2  18                   clc
000172r 2  69 08                adc     #8
000174r 2  8D 22 7F             sta     SFX_AY_ADDR
000177r 2  8E 23 7F             stx     SFX_AY_DATA
00017Ar 2  AE rr rr             ldx     sfx_chan
00017Dr 2  CA                   dex
00017Er 2  10 85                bpl     @ch
000180r 2  A9 07                lda     #7
000182r 2  8D 22 7F             sta     SFX_AY_ADDR
000185r 2  AD rr rr             lda     sfx_mixer
000188r 2  8D 23 7F             sta     SFX_AY_DATA
00018Br 2  60                   rts
00018Cr 2  3E 3D 3B     sfx_tone_on:    .byte   $3E, $3D, $3B
00018Fr 2  37 2F 1F     sfx_noise_on:   .byte   $37, $2F, $1F
000192r 2               
000192r 2               ; one voice (X): the sweep and the decay, then the script when its wait
000192r 2               ; is over
000192r 2               sfx_voice:
000192r 2  BD rr rr             lda     sfx_swl,x       ; the sweep
000195r 2  1D rr rr             ora     sfx_swh,x
000198r 2  F0 13                beq     @ns
00019Ar 2  BD rr rr             lda     sfx_perl,x
00019Dr 2  18                   clc
00019Er 2  7D rr rr             adc     sfx_swl,x
0001A1r 2  9D rr rr             sta     sfx_perl,x
0001A4r 2  BD rr rr             lda     sfx_perh,x
0001A7r 2  7D rr rr             adc     sfx_swh,x
0001AAr 2  9D rr rr             sta     sfx_perh,x
0001ADr 2  BD rr rr     @ns:    lda     sfx_dec,x       ; the decay
0001B0r 2  F0 10                beq     @nd
0001B2r 2  DE rr rr             dec     sfx_decc,x
0001B5r 2  D0 0B                bne     @nd
0001B7r 2  9D rr rr             sta     sfx_decc,x
0001BAr 2  BD rr rr             lda     sfx_vol,x
0001BDr 2  F0 03                beq     @nd
0001BFr 2  DE rr rr             dec     sfx_vol,x
0001C2r 2  BD rr rr     @nd:    lda     sfx_wait,x
0001C5r 2  F0 06                beq     @run
0001C7r 2  DE rr rr             dec     sfx_wait,x
0001CAr 2  F0 01                beq     @run
0001CCr 2  60                   rts
0001CDr 2  A9 28        @run:   lda     #40             ; (at most 40 commands a tick: a script that
0001CFr 2  8D rr rr             sta     sfx_guard       ;  never waits can't hang the game)
0001D2r 2  CE rr rr     @cmd:   dec     sfx_guard
0001D5r 2  F0 76                beq     @stop
0001D7r 2  20 rr rr             jsr     sfx_byte
0001DAr 2  C9 80                cmp     #$80
0001DCr 2  90 09                bcc     @nw
0001DEr 2  29 7F                and     #$7F            ; wait
0001E0r 2  9D rr rr             sta     sfx_wait,x
0001E3r 2  FE rr rr             inc     sfx_wait,x
0001E6r 2  60                   rts
0001E7r 2  C9 20        @nw:    cmp     #$20
0001E9r 2  90 54                bcc     @op
0001EBr 2  38                   sec                     ; a note
0001ECr 2  E9 20                sbc     #$20
0001EEr 2  C9 60                cmp     #96
0001F0r 2  90 02                bcc     @nt
0001F2r 2  A9 5F                lda     #95
0001F4r 2  A0 00        @nt:    ldy     #0              ; octave Y, note A in it
0001F6r 2  C9 0C        @oc:    cmp     #12
0001F8r 2  90 05                bcc     @ok
0001FAr 2  E9 0C                sbc     #12
0001FCr 2  C8                   iny
0001FDr 2  D0 F7                bne     @oc
0001FFr 2  8C rr rr     @ok:    sty     sfx_guard+1     ; (as a count)
000202r 2  A8                   tay
000203r 2  B9 rr rr             lda     sfx_c1_lo,y     ; the period in octave 1, halved for each
000206r 2  9D rr rr             sta     sfx_perl,x      ; octave up
000209r 2  B9 rr rr             lda     sfx_c1_hi,y
00020Cr 2  AC rr rr             ldy     sfx_guard+1
00020Fr 2  F0 16                beq     @p
000211r 2  4A           @sh:    lsr
000212r 2  7E rr rr             ror     sfx_perl,x
000215r 2  88                   dey
000216r 2  D0 F9                bne     @sh
000218r 2  9D rr rr             sta     sfx_perh,x      ; (rounded: the last bit out was a half)
00021Br 2  90 0D                bcc     @r0
00021Dr 2  FE rr rr             inc     sfx_perl,x
000220r 2  D0 08                bne     @r0
000222r 2  FE rr rr             inc     sfx_perh,x
000225r 2  D0 03                bne     @r0
000227r 2  9D rr rr     @p:     sta     sfx_perh,x
00022Ar 2               @r0:
00022Ar 2  BD rr rr             lda     sfx_base,x
00022Dr 2  9D rr rr             sta     sfx_vol,x
000230r 2  BD rr rr             lda     sfx_dec,x
000233r 2  9D rr rr             sta     sfx_decc,x
000236r 2  BD rr rr     @len:   lda     sfx_len,x       ; (LEN: wait that long)
000239r 2  F0 97                beq     @cmd
00023Br 2  9D rr rr             sta     sfx_wait,x
00023Er 2  60                   rts
00023Fr 2  C9 0C        @op:    cmp     #12
000241r 2  B0 0A                bcs     @stop
000243r 2  A8                   tay
000244r 2  B9 rr rr             lda     @hi,y
000247r 2  48                   pha
000248r 2  B9 rr rr             lda     @lo,y
00024Br 2  48                   pha
00024Cr 2  60                   rts                     ; (to the command, which goes back to @cmd)
00024Dr 2  A9 00        @stop:  lda     #0
00024Fr 2  9D rr rr             sta     sfx_hi,x
000252r 2  9D rr rr             sta     sfx_vol,x
000255r 2  60                   rts
000256r 2  rr rr rr rr  @lo:    .lobytes  @stop-1, @per-1, @vl-1, @noi-1, @mix-1, @sw-1, @dc-1, @lp-1, @nx-1, @jp-1, @rest-1, @ln-1
00025Ar 2  rr rr rr rr  
00025Er 2  rr rr rr rr  
000262r 2  rr rr rr rr  @hi:    .hibytes  @stop-1, @per-1, @vl-1, @noi-1, @mix-1, @sw-1, @dc-1, @lp-1, @nx-1, @jp-1, @rest-1, @ln-1
000266r 2  rr rr rr rr  
00026Ar 2  rr rr rr rr  
00026Er 2  20 rr rr     @per:   jsr     sfx_byte
000271r 2  9D rr rr             sta     sfx_perl,x
000274r 2  20 rr rr             jsr     sfx_byte
000277r 2  9D rr rr             sta     sfx_perh,x
00027Ar 2  4C rr rr             jmp     @cmd
00027Dr 2  20 rr rr     @vl:    jsr     sfx_byte
000280r 2  9D rr rr             sta     sfx_base,x
000283r 2  9D rr rr             sta     sfx_vol,x
000286r 2  BD rr rr             lda     sfx_dec,x
000289r 2  9D rr rr             sta     sfx_decc,x
00028Cr 2  4C rr rr             jmp     @cmd
00028Fr 2  20 rr rr     @noi:   jsr     sfx_byte
000292r 2  9D rr rr             sta     sfx_noise,x
000295r 2  4C rr rr             jmp     @cmd
000298r 2  20 rr rr     @mix:   jsr     sfx_byte
00029Br 2  9D rr rr             sta     sfx_mix,x
00029Er 2  4C rr rr             jmp     @cmd
0002A1r 2  20 rr rr     @sw:    jsr     sfx_byte
0002A4r 2  9D rr rr             sta     sfx_swl,x
0002A7r 2  20 rr rr             jsr     sfx_byte
0002AAr 2  9D rr rr             sta     sfx_swh,x
0002ADr 2  4C rr rr             jmp     @cmd
0002B0r 2  20 rr rr     @dc:    jsr     sfx_byte
0002B3r 2  9D rr rr             sta     sfx_dec,x
0002B6r 2  9D rr rr             sta     sfx_decc,x
0002B9r 2  4C rr rr             jmp     @cmd
0002BCr 2  20 rr rr     @lp:    jsr     sfx_byte
0002BFr 2  9D rr rr             sta     sfx_lcnt,x
0002C2r 2  BD rr rr             lda     sfx_lo,x
0002C5r 2  9D rr rr             sta     sfx_lpl,x
0002C8r 2  BD rr rr             lda     sfx_hi,x
0002CBr 2  9D rr rr             sta     sfx_lph,x
0002CEr 2  4C rr rr             jmp     @cmd
0002D1r 2  BD rr rr     @nx:    lda     sfx_lcnt,x
0002D4r 2  F0 05                beq     @back           ; (0: for ever)
0002D6r 2  DE rr rr             dec     sfx_lcnt,x
0002D9r 2  F0 0C                beq     @go
0002DBr 2  BD rr rr     @back:  lda     sfx_lpl,x
0002DEr 2  9D rr rr             sta     sfx_lo,x
0002E1r 2  BD rr rr             lda     sfx_lph,x
0002E4r 2  9D rr rr             sta     sfx_hi,x
0002E7r 2  4C rr rr     @go:    jmp     @cmd
0002EAr 2  20 rr rr     @jp:    jsr     sfx_byte
0002EDr 2  48                   pha
0002EEr 2  20 rr rr             jsr     sfx_byte
0002F1r 2  9D rr rr             sta     sfx_hi,x
0002F4r 2  68                   pla
0002F5r 2  9D rr rr             sta     sfx_lo,x
0002F8r 2  4C rr rr             jmp     @cmd
0002FBr 2  A9 00        @rest:  lda     #0
0002FDr 2  9D rr rr             sta     sfx_vol,x
000300r 2  4C rr rr             jmp     @len
000303r 2  20 rr rr     @ln:    jsr     sfx_byte
000306r 2  9D rr rr             sta     sfx_len,x
000309r 2  4C rr rr             jmp     @cmd
00030Cr 2               
00030Cr 2               ; the next byte of voice X's script
00030Cr 2               sfx_byte:
00030Cr 2  BD rr rr             lda     sfx_lo,x
00030Fr 2  8D rr rr             sta     @ld+1
000312r 2  BD rr rr             lda     sfx_hi,x
000315r 2  8D rr rr             sta     @ld+2
000318r 2  AD FF FF     @ld:    lda     $FFFF
00031Br 2  FE rr rr             inc     sfx_lo,x
00031Er 2  D0 03                bne     @r
000320r 2  FE rr rr             inc     sfx_hi,x
000323r 2  60           @r:     rts
000324r 2               
000324r 2               ; the tone periods of C1 .. B1 for the 2 MHz chip clock: 2 MHz / (16 x
000324r 2               ; frequency); each octave up is half (to within a third of a percent)
000324r 2  EE 18 4D 8E  sfx_c1_lo:  .lobytes 3822, 3608, 3405, 3214, 3034, 2863, 2703, 2551, 2408, 2273, 2145, 2025
000328r 2  DA 2F 8F F7  
00032Cr 2  68 E1 61 E9  
000330r 2  0E 0E 0D 0C  sfx_c1_hi:  .hibytes 3822, 3608, 3405, 3214, 3034, 2863, 2703, 2551, 2408, 2273, 2145, 2025
000334r 2  0B 0B 0A 09  
000338r 2  09 08 08 07  
00033Cr 2               
00033Cr 2               
00033Cr 1                       .include "lib/vdp.s"    ; the PICO9918 routines
00033Cr 2               ; ============================================================================
00033Cr 2               ; vdp.s - PICO9918 / TMS9918A routines shared by the SBC games (CPU Rev2)
00033Cr 2               ;
00033Cr 2               ; Include it after setting VDP_NAME (the name table's VRAM address):
00033Cr 2               ;           VDP_NAME = $1800
00033Cr 2               ;           .include "lib/vdp.s"
00033Cr 2               ; No zero page is used: the copy routines patch their own addresses.
00033Cr 2               ;
00033Cr 2               ;   vdp_setup   A/Y -> 8 bytes: R0-R7.  Puts a PICO9918 (F18A mode) back to
00033Cr 2               ;               plain TMS9918A behaviour first (24 rows, all 32 sprites),
00033Cr 2               ;               clears the 16K of VRAM, then loads R0-R7.  Interrupts from
00033Cr 2               ;               the VDP should be off in R1 (bit 5): the games poll.
00033Cr 2               ;   vdp_reg     register X = A
00033Cr 2               ;   vdp_waddr   VRAM write address = A (low) / Y (high)
00033Cr 2               ;   vdp_fill    write A to VRAM vdp_n (16 bit) times, from the address set
00033Cr 2               ;   vdp_copy    copy vdp_n bytes from RAM vdp_src to VRAM (from the address set)
00033Cr 2               ;   vdp_at      write address = the name table cell at column X, row Y
00033Cr 2               ;   vdp_puts    write the 0-ended string at A/Y from there (names = ASCII)
00033Cr 2               ;   vdp_bcd     write A as two digits
00033Cr 2               ;   vdp_frame   wait for the next frame (60 a second), calling frame_idle
00033Cr 2               ;               (the game's: sound, random numbers) while it waits
00033Cr 2               ;
00033Cr 2               ; The VDP's ports: data $7F1C, control/status $7F1D.  Reading the status
00033Cr 2               ; clears the frame flag, so nothing else should read it while a game runs
00033Cr 2               ; (the ROM doesn't, with PICO_IRQ = 0 in its config.inc, the default).
00033Cr 2               ; ============================================================================
00033Cr 2               
00033Cr 2               VDP_DATA        = $7F1C
00033Cr 2               VDP_CTRL        = $7F1D
00033Cr 2               
00033Cr 2               ; register X = A.  Keeps A, X, Y.
00033Cr 2               vdp_reg:
00033Cr 2  8D 1D 7F             sta     VDP_CTRL
00033Fr 2  48                   pha
000340r 2  8A                   txa
000341r 2  09 80                ora     #$80
000343r 2  8D 1D 7F             sta     VDP_CTRL
000346r 2  68                   pla
000347r 2  60                   rts
000348r 2               
000348r 2               ; VRAM write address = A (low) / Y (high).  Keeps A, X, Y.
000348r 2               vdp_waddr:
000348r 2  8D 1D 7F             sta     VDP_CTRL
00034Br 2  48                   pha
00034Cr 2  98                   tya
00034Dr 2  29 3F                and     #$3F
00034Fr 2  09 40                ora     #$40
000351r 2  8D 1D 7F             sta     VDP_CTRL
000354r 2  68                   pla
000355r 2  60                   rts
000356r 2               
000356r 2               ; write A, vdp_n times.  Keeps A.
000356r 2               vdp_fill:
000356r 2  AE rr rr             ldx     vdp_n           ; the odd bytes first
000359r 2  F0 06                beq     @pg
00035Br 2  8D 1C 7F     @lo:    sta     VDP_DATA
00035Er 2  CA                   dex
00035Fr 2  D0 FA                bne     @lo
000361r 2  AC rr rr     @pg:    ldy     vdp_n+1         ; then whole pages
000364r 2  F0 0B                beq     @done
000366r 2  A2 00        @p:     ldx     #0
000368r 2  8D 1C 7F     @pp:    sta     VDP_DATA
00036Br 2  CA                   dex
00036Cr 2  D0 FA                bne     @pp
00036Er 2  88                   dey
00036Fr 2  D0 F5                bne     @p
000371r 2  60           @done:  rts
000372r 2               
000372r 2               ; copy vdp_n bytes from vdp_src to VRAM
000372r 2               vdp_copy:
000372r 2  AD rr rr             lda     vdp_src
000375r 2  8D rr rr             sta     @rd+1
000378r 2  AD rr rr             lda     vdp_src+1
00037Br 2  8D rr rr             sta     @rd+2
00037Er 2  AD rr rr             lda     vdp_n
000381r 2  8D rr rr             sta     vdp_t
000384r 2  AD rr rr             lda     vdp_n+1
000387r 2  8D rr rr             sta     vdp_t+1
00038Ar 2  AD rr rr     @l:     lda     vdp_t
00038Dr 2  0D rr rr             ora     vdp_t+1
000390r 2  F0 1C                beq     @done
000392r 2  AD FF FF     @rd:    lda     $FFFF
000395r 2  8D 1C 7F             sta     VDP_DATA
000398r 2  EE rr rr             inc     @rd+1
00039Br 2  D0 03                bne     :+
00039Dr 2  EE rr rr             inc     @rd+2
0003A0r 2  AD rr rr     :       lda     vdp_t
0003A3r 2  D0 03                bne     :+
0003A5r 2  CE rr rr             dec     vdp_t+1
0003A8r 2  CE rr rr     :       dec     vdp_t
0003ABr 2  4C rr rr             jmp     @l
0003AEr 2  60           @done:  rts
0003AFr 2               
0003AFr 2               ; A/Y -> 8 register values.  Clears VRAM.
0003AFr 2               vdp_setup:
0003AFr 2  8D rr rr             sta     @rr+1
0003B2r 2  8C rr rr             sty     @rr+2
0003B5r 2  AD 1D 7F             lda     VDP_CTRL        ; (resets the register write latch)
0003B8r 2  A9 80                lda     #$80            ; R1 = $80: display off while we work
0003BAr 2  A2 01                ldx     #1
0003BCr 2  20 rr rr             jsr     vdp_reg
0003BFr 2  A9 1C                lda     #$1C            ; F18A unlock (a PICO9918): $1C twice to VR57
0003C1r 2  A2 39                ldx     #57
0003C3r 2  20 rr rr             jsr     vdp_reg
0003C6r 2  20 rr rr             jsr     vdp_reg
0003C9r 2  A9 00                lda     #0              ; VR49: 24 rows, no 80 columns
0003CBr 2  A2 31                ldx     #49
0003CDr 2  20 rr rr             jsr     vdp_reg
0003D0r 2  A2 32                ldx     #50             ; VR50: plain TMS9918A behaviour
0003D2r 2  20 rr rr             jsr     vdp_reg
0003D5r 2  A9 20                lda     #32             ; VR51: all 32 sprites
0003D7r 2  A2 33                ldx     #51
0003D9r 2  20 rr rr             jsr     vdp_reg
0003DCr 2                       ; (on a real TMS9918A those writes land in R1-R3: all set below)
0003DCr 2  A9 80                lda     #$80            ; R1 again: display off
0003DEr 2  A2 01                ldx     #1
0003E0r 2  20 rr rr             jsr     vdp_reg
0003E3r 2  A9 00                lda     #0              ; clear the 16K
0003E5r 2  A8                   tay
0003E6r 2  20 rr rr             jsr     vdp_waddr
0003E9r 2  A9 00                lda     #$00
0003EBr 2  8D rr rr             sta     vdp_n
0003EEr 2  A9 40                lda     #$40
0003F0r 2  8D rr rr             sta     vdp_n+1
0003F3r 2  A9 00                lda     #0
0003F5r 2  20 rr rr             jsr     vdp_fill
0003F8r 2  A2 00                ldx     #0
0003FAr 2  BD FF FF     @rr:    lda     $FFFF,x
0003FDr 2  20 rr rr             jsr     vdp_reg
000400r 2  E8                   inx
000401r 2  E0 08                cpx     #8
000403r 2  D0 F5                bne     @rr
000405r 2  60                   rts
000406r 2               
000406r 2               ; write address = name table cell X (column), Y (row).  Keeps X and Y.
000406r 2               vdp_at:
000406r 2  8E rr rr             stx     vdp_t
000409r 2  98                   tya
00040Ar 2  4A                   lsr                     ; row * 32: high byte = row / 8
00040Br 2  4A                   lsr
00040Cr 2  4A                   lsr
00040Dr 2  8D rr rr             sta     vdp_t+1
000410r 2  98                   tya
000411r 2  0A                   asl
000412r 2  0A                   asl
000413r 2  0A                   asl
000414r 2  0A                   asl
000415r 2  0A                   asl                     ; low byte = (row & 7) * 32
000416r 2  18                   clc
000417r 2  6D rr rr             adc     vdp_t
00041Ar 2  18                   clc
00041Br 2  69 00                adc     #<VDP_NAME
00041Dr 2  8D 1D 7F             sta     VDP_CTRL
000420r 2  AD rr rr             lda     vdp_t+1
000423r 2  69 18                adc     #>VDP_NAME
000425r 2  29 3F                and     #$3F
000427r 2  09 40                ora     #$40
000429r 2  8D 1D 7F             sta     VDP_CTRL
00042Cr 2  60                   rts
00042Dr 2               
00042Dr 2               ; write the 0-ended string at A/Y.  Keeps X.
00042Dr 2               vdp_puts:
00042Dr 2  8D rr rr             sta     @rd+1
000430r 2  8C rr rr             sty     @rd+2
000433r 2  A0 00                ldy     #0
000435r 2  B9 FF FF     @rd:    lda     $FFFF,y
000438r 2  F0 06                beq     @done
00043Ar 2  8D 1C 7F             sta     VDP_DATA
00043Dr 2  C8                   iny
00043Er 2  D0 F5                bne     @rd
000440r 2  60           @done:  rts
000441r 2               
000441r 2               ; A as two BCD digits.  Keeps X, Y.
000441r 2               vdp_bcd:
000441r 2  48                   pha
000442r 2  4A                   lsr
000443r 2  4A                   lsr
000444r 2  4A                   lsr
000445r 2  4A                   lsr
000446r 2  09 30                ora     #'0'
000448r 2  8D 1C 7F             sta     VDP_DATA
00044Br 2  68                   pla
00044Cr 2  48                   pha
00044Dr 2  29 0F                and     #$0F
00044Fr 2  09 30                ora     #'0'
000451r 2  8D 1C 7F             sta     VDP_DATA
000454r 2  68                   pla
000455r 2  60                   rts
000456r 2               
000456r 2               ; wait for the next frame
000456r 2               vdp_frame:
000456r 2  20 rr rr     @w:     jsr     frame_idle
000459r 2  AD 1D 7F             lda     VDP_CTRL
00045Cr 2  10 F8                bpl     @w
00045Er 2  60                   rts
00045Fr 2               
00045Fr 2                       .segment "BSS"
000075r 2  xx xx        vdp_n:          .res 2
000077r 2  xx xx        vdp_src:        .res 2
000079r 2  xx xx        vdp_t:          .res 2
00007Br 2                       .segment "CODE"
00045Fr 2               
00045Fr 1               
00045Fr 1               getc            = SBC_CHRIN     ; carry set = key in A
00045Fr 1               
00045Fr 1               ; called by vdp_frame while it waits
00045Fr 1               frame_idle:
00045Fr 1  20 rr rr             jsr     sfx_poll
000462r 1  4C rr rr             jmp     rand
000465r 1               
000465r 1               ; 16 bit Galois LFSR.  Returns a random byte in A.  Preserves X and Y.
000465r 1  AD rr rr     rand:   lda     rng+1
000468r 1  4A                   lsr
000469r 1  6E rr rr             ror     rng
00046Cr 1  90 02                bcc     @n
00046Er 1  49 B4                eor     #$B4
000470r 1  8D rr rr     @n:     sta     rng+1
000473r 1  4D rr rr             eor     rng
000476r 1  60                   rts
000477r 1               
000477r 1               ; wait A frames (keys pressed meanwhile are dropped)
000477r 1               wait_frames:
000477r 1  8D rr rr             sta     wf_n
00047Ar 1  20 rr rr     @l:     jsr     vdp_frame
00047Dr 1  20 rr rr             jsr     put_sprites
000480r 1  20 rr rr             jsr     flush_in
000483r 1  CE rr rr             dec     wf_n
000486r 1  D0 F2                bne     @l
000488r 1  60                   rts
000489r 1               
000489r 1               ; ============================================================================
000489r 1               ; gamepad and menu input (as in the other SBC games)
000489r 1               ; ============================================================================
000489r 1               PAD_A           = $01
000489r 1               PAD_B           = $02
000489r 1               PAD_SELECT      = $04
000489r 1               PAD_START       = $08
000489r 1               PAD_UP          = $10
000489r 1               PAD_DOWN        = $20
000489r 1               PAD_LEFT        = $40
000489r 1               PAD_RIGHT       = $80
000489r 1               PAD_GO          = $80           ; menu_key's answer for gamepad A or Start
000489r 1               
000489r 1               read_pad:
000489r 1  20 12 FE             jsr     SBC_PADSTATE
00048Cr 1  C9 FF                cmp     #$FF            ; every button "pressed" = no pad
00048Er 1  D0 02                bne     @ok
000490r 1  A9 00                lda     #0
000492r 1  8D rr rr     @ok:    sta     pad
000495r 1  AD rr rr             lda     padold
000498r 1  49 FF                eor     #$FF
00049Ar 1  2D rr rr             and     pad
00049Dr 1  8D rr rr             sta     padnew
0004A0r 1  AD rr rr             lda     pad
0004A3r 1  8D rr rr             sta     padold
0004A6r 1  60                   rts
0004A7r 1               
0004A7r 1               flush_in:
0004A7r 1  20 00 FE             jsr     getc
0004AAr 1  B0 FB                bcs     flush_in
0004ACr 1  60                   rts
0004ADr 1               
0004ADr 1               ; carry set if A is a character the gamepad driver types (W A S D space)
0004ADr 1               pad_typed:
0004ADr 1  C9 20                cmp     #' '
0004AFr 1  F0 12                beq     @y
0004B1r 1  C9 57                cmp     #'W'
0004B3r 1  F0 0E                beq     @y
0004B5r 1  C9 41                cmp     #'A'
0004B7r 1  F0 0A                beq     @y
0004B9r 1  C9 53                cmp     #'S'
0004BBr 1  F0 06                beq     @y
0004BDr 1  C9 44                cmp     #'D'
0004BFr 1  F0 02                beq     @y
0004C1r 1  18                   clc
0004C2r 1  60                   rts
0004C3r 1  38           @y:     sec
0004C4r 1  60                   rts
0004C5r 1               
0004C5r 1               ; wait for a menu choice: a key (letters in upper case) or PAD_GO
0004C5r 1               menu_key:
0004C5r 1  20 rr rr     @l:     jsr     vdp_frame
0004C8r 1  20 rr rr             jsr     put_sprites
0004CBr 1  20 rr rr             jsr     read_pad
0004CEr 1  AD rr rr             lda     padnew
0004D1r 1  29 09                and     #PAD_A | PAD_START
0004D3r 1  D0 21                bne     @pad
0004D5r 1  20 00 FE             jsr     getc
0004D8r 1  90 EB                bcc     @l
0004DAr 1  C9 20                cmp     #' '            ; a space typed by the pad's A button?
0004DCr 1  D0 0D                bne     @up
0004DEr 1  20 rr rr             jsr     read_pad
0004E1r 1  AD rr rr             lda     pad
0004E4r 1  29 01                and     #PAD_A
0004E6r 1  D0 0E                bne     @pad
0004E8r 1  A9 20                lda     #' '
0004EAr 1  60                   rts
0004EBr 1  C9 61        @up:    cmp     #'a'
0004EDr 1  90 06                bcc     @r
0004EFr 1  C9 7B                cmp     #'z'+1
0004F1r 1  B0 02                bcs     @r
0004F3r 1  29 DF                and     #$DF
0004F5r 1  60           @r:     rts
0004F6r 1  20 rr rr     @pad:   jsr     flush_in
0004F9r 1  A9 80                lda     #PAD_GO
0004FBr 1  60                   rts
0004FCr 1               
0004FCr 1               ; ============================================================================
0004FCr 1               ; start
0004FCr 1               ; ============================================================================
0004FCr 1  D8           start:  cld
0004FDr 1  A2 FF                ldx     #$FF
0004FFr 1  9A                   txs
000500r 1  A9 00                lda     #0              ; clear all variables
000502r 1  AA                   tax
000503r 1  9D rr rr     @clr:   sta     vars_start,x
000506r 1  9D rr rr             sta     vars_start+$100,x
000509r 1  E8                   inx
00050Ar 1  D0 F7                bne     @clr
00050Cr 1  A9 A5                lda     #$A5
00050Er 1  8D rr rr             sta     rng
000511r 1  AD rr rr             lda     ctrl_def
000514r 1  8D rr rr             sta     ctrl
000517r 1                       ; the PICO9918?  (CPU Rev2 ROM: a JMP at $FE1B, SBC_SYSINFO)
000517r 1  AD 1B FE             lda     SBC_SYSINFO
00051Ar 1  C9 4C                cmp     #$4C
00051Cr 1  D0 07                bne     @nopico
00051Er 1  20 1B FE             jsr     SBC_SYSINFO
000521r 1  C9 02                cmp     #DISP_PICO
000523r 1  F0 10                beq     @pico
000525r 1               @nopico:
000525r 1  A2 00                ldx     #0
000527r 1  BD rr rr     @m:     lda     need_txt,x
00052Ar 1  F0 06                beq     @bye
00052Cr 1  20 03 FE             jsr     SBC_CHROUT
00052Fr 1  E8                   inx
000530r 1  D0 F5                bne     @m
000532r 1  4C 06 FE     @bye:   jmp     SBC_MENU
000535r 1  20 rr rr     @pico:  jsr     sfx_init
000538r 1  AD rr rr             lda     mute_def
00053Br 1  8D rr rr             sta     sfx_mute
00053Er 1  20 rr rr             jsr     gfx_init
000541r 1  A9 00                lda     #0
000543r 1  8D rr rr             sta     hiscore
000546r 1  8D rr rr             sta     hiscore+1
000549r 1               
000549r 1               ; ---- title screen ----------------------------------------------------------
000549r 1  20 rr rr     title:  jsr     sfx_off
00054Cr 1  20 rr rr             jsr     clear_names
00054Fr 1  20 rr rr             jsr     hide_sprites
000552r 1  A2 00                ldx     #0              ; the texts
000554r 1  8E rr rr             stx     tmp
000557r 1  AE rr rr     @t:     ldx     tmp
00055Ar 1  BD rr rr             lda     title_txt,x
00055Dr 1  F0 20                beq     @tdone
00055Fr 1  48                   pha
000560r 1  BC rr rr             ldy     title_txt+1,x
000563r 1  68                   pla
000564r 1  AA                   tax
000565r 1  20 rr rr             jsr     vdp_at
000568r 1  AE rr rr             ldx     tmp
00056Br 1  BD rr rr             lda     title_txt+2,x
00056Er 1  BC rr rr             ldy     title_txt+3,x
000571r 1  20 rr rr             jsr     vdp_puts
000574r 1  AD rr rr             lda     tmp
000577r 1  18                   clc
000578r 1  69 04                adc     #4
00057Ar 1  8D rr rr             sta     tmp
00057Dr 1  D0 D8                bne     @t
00057Fr 1  A2 00        @tdone: ldx     #0              ; the invaders next to their points
000581r 1  8E rr rr     @k:     stx     tmp
000584r 1  8A                   txa
000585r 1  0A                   asl
000586r 1  18                   clc
000587r 1  69 08                adc     #8
000589r 1  A8                   tay                     ; rows 8, 10, 12
00058Ar 1  A2 09                ldx     #9
00058Cr 1  20 rr rr             jsr     vdp_at
00058Fr 1  AE rr rr             ldx     tmp
000592r 1  BD rr rr             lda     kind_pat,x
000595r 1  8D 1C 7F             sta     VDP_DATA
000598r 1  18                   clc
000599r 1  69 01                adc     #1
00059Br 1  8D 1C 7F             sta     VDP_DATA
00059Er 1  69 01                adc     #1
0005A0r 1  8D 1C 7F             sta     VDP_DATA
0005A3r 1  AE rr rr             ldx     tmp
0005A6r 1  E8                   inx
0005A7r 1  E0 03                cpx     #3
0005A9r 1  D0 D6                bne     @k
0005ABr 1  A9 30                lda     #48             ; and the saucer (row 6)
0005ADr 1  8D rr rr             sta     spr_tab+S_SAUCER*4
0005B0r 1  A9 48                lda     #72
0005B2r 1  8D rr rr             sta     spr_tab+S_SAUCER*4+1
0005B5r 1  A9 10                lda     #SP_SAUCER
0005B7r 1  8D rr rr             sta     spr_tab+S_SAUCER*4+2
0005BAr 1  A9 08                lda     #C_SAUCER
0005BCr 1  8D rr rr             sta     spr_tab+S_SAUCER*4+3
0005BFr 1  20 rr rr             jsr     show_ctrl
0005C2r 1  20 rr rr             jsr     show_hiscore
0005C5r 1  20 rr rr             jsr     read_pad
0005C8r 1  20 rr rr     @wait:  jsr     menu_key
0005CBr 1  C9 51                cmp     #'Q'
0005CDr 1  D0 03                bne     @notq
0005CFr 1  4C rr rr             jmp     exit_game
0005D2r 1  C9 4D        @notq:  cmp     #'M'
0005D4r 1  D0 06                bne     @notm
0005D6r 1  20 rr rr             jsr     toggle_sound
0005D9r 1  4C rr rr             jmp     @wait
0005DCr 1  C9 47        @notm:  cmp     #'G'
0005DEr 1  D0 0E                bne     @notg
0005E0r 1  AD rr rr             lda     ctrl
0005E3r 1  49 01                eor     #1
0005E5r 1  8D rr rr             sta     ctrl
0005E8r 1  20 rr rr             jsr     show_ctrl
0005EBr 1  4C rr rr             jmp     @wait
0005EEr 1  C9 80        @notg:  cmp     #PAD_GO
0005F0r 1  D0 07                bne     @notp
0005F2r 1  A9 01                lda     #1
0005F4r 1  8D rr rr             sta     ctrl
0005F7r 1  D0 04                bne     new_game
0005F9r 1  C9 20        @notp:  cmp     #' '
0005FBr 1  D0 CB                bne     @wait
0005FDr 1               
0005FDr 1               ; ---- new game ----------------------------------------------------------------
0005FDr 1               new_game:
0005FDr 1  A9 00                lda     #0
0005FFr 1  8D rr rr             sta     score
000602r 1  8D rr rr             sta     score+1
000605r 1  8D rr rr             sta     wave
000608r 1  A9 03                lda     #3
00060Ar 1  8D rr rr             sta     lives
00060Dr 1               
00060Dr 1               new_wave:
00060Dr 1  20 rr rr             jsr     sfx_off
000610r 1  20 rr rr             jsr     init_wave
000613r 1  20 rr rr             jsr     draw_all
000616r 1               
000616r 1               ; ---- main loop ---------------------------------------------------------------
000616r 1               game_loop:
000616r 1  AD rr rr             lda     speed
000619r 1  8D rr rr             sta     wf_n
00061Cr 1  20 rr rr     @f:     jsr     vdp_frame
00061Fr 1  CE rr rr             dec     wf_n
000622r 1  D0 F8                bne     @f
000624r 1  20 rr rr             jsr     put_sprites
000627r 1  20 rr rr             jsr     sfx_poll
00062Ar 1  20 rr rr             jsr     read_keys
00062Dr 1  AD rr rr             lda     quit
000630r 1  F0 03                beq     @noquit
000632r 1  4C rr rr             jmp     exit_game
000635r 1               @noquit:
000635r 1  20 rr rr             jsr     move_player
000638r 1  20 rr rr             jsr     fire
00063Br 1  20 rr rr             jsr     move_shot
00063Er 1  20 rr rr             jsr     move_bombs
000641r 1  AD rr rr             lda     dead
000644r 1  F0 0B                beq     @alive
000646r 1  20 rr rr             jsr     player_died
000649r 1  AD rr rr             lda     lives
00064Cr 1  F0 31                beq     game_over
00064Er 1  4C rr rr             jmp     game_loop
000651r 1  20 rr rr     @alive: jsr     spawn_bomb
000654r 1  20 rr rr             jsr     ufo_tick
000657r 1  20 rr rr             jsr     inv_tick
00065Ar 1  20 rr rr             jsr     expl_tick
00065Dr 1  AD rr rr             lda     invaded
000660r 1  D0 1D                bne     game_over
000662r 1  AD rr rr             lda     alive_count
000665r 1  D0 AF                bne     game_loop
000667r 1  EE rr rr             inc     wave
00066Ar 1  20 rr rr             jsr     sfx_off
00066Dr 1  A9 0A                lda     #SND_WAVE
00066Fr 1  A2 03                ldx     #3
000671r 1  20 rr rr             jsr     sfx_play
000674r 1  20 rr rr             jsr     hide_moving
000677r 1  A9 3C                lda     #60
000679r 1  20 rr rr             jsr     wait_frames     ; a second between waves
00067Cr 1  4C rr rr             jmp     new_wave
00067Fr 1               
00067Fr 1               ; ---- game over ----------------------------------------------------------------
00067Fr 1               game_over:
00067Fr 1  AD rr rr             lda     score+1         ; a new high score?
000682r 1  CD rr rr             cmp     hiscore+1
000685r 1  90 19                bcc     @nohi
000687r 1  D0 08                bne     @hi
000689r 1  AD rr rr             lda     score
00068Cr 1  CD rr rr             cmp     hiscore
00068Fr 1  90 0F                bcc     @nohi
000691r 1  AD rr rr     @hi:    lda     score
000694r 1  8D rr rr             sta     hiscore
000697r 1  AD rr rr             lda     score+1
00069Ar 1  8D rr rr             sta     hiscore+1
00069Dr 1  20 rr rr             jsr     show_score
0006A0r 1  20 rr rr     @nohi:  jsr     sfx_off
0006A3r 1  A9 0B                lda     #SND_OVER
0006A5r 1  A2 03                ldx     #3
0006A7r 1  20 rr rr             jsr     sfx_play
0006AAr 1  20 rr rr             jsr     hide_moving
0006ADr 1  A2 00                ldx     #0
0006AFr 1  8E rr rr     @o:     stx     tmp
0006B2r 1  BD rr rr             lda     over_txt,x
0006B5r 1  F0 1E                beq     @odone
0006B7r 1  48                   pha
0006B8r 1  BC rr rr             ldy     over_txt+1,x
0006BBr 1  68                   pla
0006BCr 1  AA                   tax
0006BDr 1  20 rr rr             jsr     vdp_at
0006C0r 1  AE rr rr             ldx     tmp
0006C3r 1  BD rr rr             lda     over_txt+2,x
0006C6r 1  BC rr rr             ldy     over_txt+3,x
0006C9r 1  20 rr rr             jsr     vdp_puts
0006CCr 1  AD rr rr             lda     tmp
0006CFr 1  18                   clc
0006D0r 1  69 04                adc     #4
0006D2r 1  AA                   tax
0006D3r 1  D0 DA                bne     @o
0006D5r 1  A9 3C        @odone: lda     #60
0006D7r 1  20 rr rr             jsr     wait_frames     ; ignore keys for a second
0006DAr 1  20 rr rr     @wait:  jsr     menu_key
0006DDr 1  C9 51                cmp     #'Q'
0006DFr 1  F0 15                beq     @title
0006E1r 1  C9 4D                cmp     #'M'
0006E3r 1  D0 06                bne     @nm
0006E5r 1  20 rr rr             jsr     toggle_sound
0006E8r 1  4C rr rr             jmp     @wait
0006EBr 1  C9 20        @nm:    cmp     #' '
0006EDr 1  F0 04                beq     @again
0006EFr 1  C9 80                cmp     #PAD_GO
0006F1r 1  D0 E7                bne     @wait
0006F3r 1  4C rr rr     @again: jmp     new_game
0006F6r 1  4C rr rr     @title: jmp     title
0006F9r 1               
0006F9r 1               ; ---- quit ------------------------------------------------------------------
0006F9r 1               exit_game:
0006F9r 1  20 rr rr             jsr     sfx_off
0006FCr 1  20 39 FE             jsr     SBC_CONRESET    ; the console's text screen back
0006FFr 1  4C 06 FE             jmp     SBC_MENU
000702r 1               
000702r 1               ; ============================================================================
000702r 1               ; screen
000702r 1               ; ============================================================================
000702r 1               
000702r 1               ; set up the VDP and load the patterns, colours and sprites
000702r 1               gfx_init:
000702r 1  A9 rr                lda     #<vdp_regs
000704r 1  A0 rr                ldy     #>vdp_regs
000706r 1  20 rr rr             jsr     vdp_setup
000709r 1  A9 00                lda     #<(V_PAT + $20*8)       ; the font
00070Br 1  A0 01                ldy     #>(V_PAT + $20*8)
00070Dr 1  20 rr rr             jsr     vdp_waddr
000710r 1  A2 rr                ldx     #<gfx_font
000712r 1  A0 rr                ldy     #>gfx_font
000714r 1  20 rr rr             jsr     copy_xy
000717r 1  00 02                .word   64*8
000719r 1  A9 C0                lda     #<(V_PAT + P_GROUND*8)  ; the ground and the cannon
00071Br 1  A0 03                ldy     #>(V_PAT + P_GROUND*8)
00071Dr 1  20 rr rr             jsr     vdp_waddr
000720r 1  A2 rr                ldx     #<gfx_ground
000722r 1  A0 rr                ldy     #>gfx_ground
000724r 1  20 rr rr             jsr     copy_xy
000727r 1  18 00                .word   3*8
000729r 1  A9 00                lda     #<(V_PAT + P_INV*8)     ; the invaders
00072Br 1  A0 04                ldy     #>(V_PAT + P_INV*8)
00072Dr 1  20 rr rr             jsr     vdp_waddr
000730r 1  A2 rr                ldx     #<gfx_inv
000732r 1  A0 rr                ldy     #>gfx_inv
000734r 1  20 rr rr             jsr     copy_xy
000737r 1  40 02                .word   72*8
000739r 1  A9 00                lda     #<V_COLOUR
00073Br 1  A0 20                ldy     #>V_COLOUR
00073Dr 1  20 rr rr             jsr     vdp_waddr
000740r 1  A2 rr                ldx     #<gfx_colours
000742r 1  A0 rr                ldy     #>gfx_colours
000744r 1  20 rr rr             jsr     copy_xy
000747r 1  20 00                .word   32
000749r 1  A9 00                lda     #<V_SPAT
00074Br 1  A0 38                ldy     #>V_SPAT
00074Dr 1  20 rr rr             jsr     vdp_waddr
000750r 1  A2 rr                ldx     #<gfx_sprites
000752r 1  A0 rr                ldy     #>gfx_sprites
000754r 1  20 rr rr             jsr     copy_xy
000757r 1  00 01                .word   8*32
000759r 1  A9 1C                lda     #<(V_SATTR + NSPR*4)    ; the end of the sprite list
00075Br 1  A0 1B                ldy     #>(V_SATTR + NSPR*4)
00075Dr 1  20 rr rr             jsr     vdp_waddr
000760r 1  A9 D0                lda     #$D0
000762r 1  8D 1C 7F             sta     VDP_DATA
000765r 1  20 rr rr             jsr     hide_sprites
000768r 1  20 rr rr             jsr     put_sprites
00076Br 1  A9 C2                lda     #$C2            ; R1: display on, 16 x 16 sprites
00076Dr 1  A2 01                ldx     #1
00076Fr 1  4C rr rr             jmp     vdp_reg
000772r 1               
000772r 1               ; copy from X/Y (low/high) to VRAM; the length is the .word after the JSR
000772r 1               copy_xy:
000772r 1  8E rr rr             stx     vdp_src
000775r 1  8C rr rr             sty     vdp_src+1
000778r 1  68                   pla                     ; the return address points at the .word - 1
000779r 1  8D rr rr             sta     cx_ret
00077Cr 1  68                   pla
00077Dr 1  8D rr rr             sta     cx_ret+1
000780r 1  A0 01                ldy     #1
000782r 1  20 rr rr             jsr     cx_byte
000785r 1  8D rr rr             sta     vdp_n
000788r 1  A0 02                ldy     #2
00078Ar 1  20 rr rr             jsr     cx_byte
00078Dr 1  8D rr rr             sta     vdp_n+1
000790r 1  AD rr rr             lda     cx_ret          ; return past the .word
000793r 1  18                   clc
000794r 1  69 02                adc     #2
000796r 1  AA                   tax
000797r 1  AD rr rr             lda     cx_ret+1
00079Ar 1  69 00                adc     #0
00079Cr 1  48                   pha
00079Dr 1  8A                   txa
00079Er 1  48                   pha
00079Fr 1  4C rr rr             jmp     vdp_copy
0007A2r 1               cx_byte:                        ; A = the byte at cx_ret + Y
0007A2r 1  AD rr rr             lda     cx_ret
0007A5r 1  8D rr rr             sta     @rd+1
0007A8r 1  AD rr rr             lda     cx_ret+1
0007ABr 1  8D rr rr             sta     @rd+2
0007AEr 1  B9 FF FF     @rd:    lda     $FFFF,y
0007B1r 1  60                   rts
0007B2r 1               
0007B2r 1               ; the whole name table blank
0007B2r 1               clear_names:
0007B2r 1  A9 00                lda     #<V_NAME
0007B4r 1  A0 18                ldy     #>V_NAME
0007B6r 1  20 rr rr             jsr     vdp_waddr
0007B9r 1  A9 00                lda     #<768
0007BBr 1  8D rr rr             sta     vdp_n
0007BEr 1  A9 03                lda     #>768
0007C0r 1  8D rr rr             sta     vdp_n+1
0007C3r 1  A9 00                lda     #P_BLANK
0007C5r 1  4C rr rr             jmp     vdp_fill
0007C8r 1               
0007C8r 1               ; all sprites below the screen
0007C8r 1               hide_sprites:
0007C8r 1  A2 18                ldx     #NSPR*4-4
0007CAr 1  A9 C0        @l:     lda     #HIDE_Y
0007CCr 1  9D rr rr             sta     spr_tab,x
0007CFr 1  A9 00                lda     #0
0007D1r 1  9D rr rr             sta     spr_tab+3,x
0007D4r 1  CA                   dex
0007D5r 1  CA                   dex
0007D6r 1  CA                   dex
0007D7r 1  CA                   dex
0007D8r 1  10 F0                bpl     @l
0007DAr 1  60                   rts
0007DBr 1               
0007DBr 1               ; all but the cannon
0007DBr 1               hide_moving:
0007DBr 1  A9 C0                lda     #HIDE_Y
0007DDr 1  A2 04                ldx     #S_SHOT*4
0007DFr 1  9D rr rr     @l:     sta     spr_tab,x
0007E2r 1  E8                   inx
0007E3r 1  E8                   inx
0007E4r 1  E8                   inx
0007E5r 1  E8                   inx
0007E6r 1  E0 1C                cpx     #NSPR*4
0007E8r 1  D0 F5                bne     @l
0007EAr 1  60                   rts
0007EBr 1               
0007EBr 1               ; the sprite table to VRAM (once a frame)
0007EBr 1               put_sprites:
0007EBr 1  A9 00                lda     #<V_SATTR
0007EDr 1  A0 1B                ldy     #>V_SATTR
0007EFr 1  20 rr rr             jsr     vdp_waddr
0007F2r 1  A2 00                ldx     #0
0007F4r 1  BD rr rr     @l:     lda     spr_tab,x
0007F7r 1  8D 1C 7F             sta     VDP_DATA
0007FAr 1  E8                   inx
0007FBr 1  E0 1C                cpx     #NSPR*4
0007FDr 1  D0 F5                bne     @l
0007FFr 1  60                   rts
000800r 1               
000800r 1               ; the controls line on the title screen
000800r 1               show_ctrl:
000800r 1  A2 02                ldx     #2
000802r 1  A0 14                ldy     #20
000804r 1  20 rr rr             jsr     vdp_at
000807r 1  AD rr rr             lda     ctrl
00080Ar 1  F0 07                beq     @kb
