00080Er 1  A0 rr                ldy     #>ctrl_pad_txt
000810r 1  4C rr rr             jmp     vdp_puts
000813r 1  A9 rr        @kb:    lda     #<ctrl_kb_txt
000815r 1  A0 rr                ldy     #>ctrl_kb_txt
000817r 1  4C rr rr             jmp     vdp_puts
00081Ar 1               
00081Ar 1               ; draw the whole playfield for a new wave
00081Ar 1               draw_all:
00081Ar 1  20 rr rr             jsr     clear_names
00081Dr 1  A2 00                ldx     #0
00081Fr 1  A0 00                ldy     #0
000821r 1  20 rr rr             jsr     vdp_at
000824r 1  A9 rr                lda     #<status_txt
000826r 1  A0 rr                ldy     #>status_txt
000828r 1  20 rr rr             jsr     vdp_puts
00082Br 1  20 rr rr             jsr     show_score
00082Er 1  20 rr rr             jsr     show_hiscore
000831r 1  20 rr rr             jsr     show_lives
000834r 1  A2 00                ldx     #0              ; the ground
000836r 1  A0 16                ldy     #GROUND_ROW
000838r 1  20 rr rr             jsr     vdp_at
00083Br 1  A9 20                lda     #32
00083Dr 1  8D rr rr             sta     vdp_n
000840r 1  A9 00                lda     #0
000842r 1  8D rr rr             sta     vdp_n+1
000845r 1  A9 78                lda     #P_GROUND
000847r 1  20 rr rr             jsr     vdp_fill
00084Ar 1  20 rr rr             jsr     draw_shields
00084Dr 1  A2 04                ldx     #NROWS-1
00084Fr 1  20 rr rr     @inv:   jsr     draw_row        ; (keeps X)
000852r 1  CA                   dex
000853r 1  10 FA                bpl     @inv
000855r 1  20 rr rr             jsr     hide_sprites
000858r 1  4C rr rr             jmp     draw_player
00085Br 1               
00085Br 1               show_score:
00085Br 1  A2 06                ldx     #6
00085Dr 1  A0 00                ldy     #0
00085Fr 1  20 rr rr             jsr     vdp_at
000862r 1  AD rr rr             lda     score+1
000865r 1  20 rr rr             jsr     vdp_bcd
000868r 1  AD rr rr             lda     score
00086Br 1  4C rr rr             jmp     vdp_bcd
00086Er 1               
00086Er 1               show_hiscore:
