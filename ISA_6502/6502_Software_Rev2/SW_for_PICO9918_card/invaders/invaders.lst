000E51r 1  BD rr rr             lda     alive,x
000E54r 1  8D rr rr             sta     dr_mask
000E57r 1  A2 08                ldx     #NCOLS
000E59r 1  4E rr rr     @s:     lsr     dr_mask
000E5Cr 1  90 16                bcc     @dead
000E5Er 1  AD rr rr             lda     dr_base
000E61r 1  99 rr rr             sta     rowbuf,y
000E64r 1  C8                   iny
000E65r 1  69 00                adc     #0              ; (carry set: +1)
000E67r 1  99 rr rr             sta     rowbuf,y
000E6Ar 1  C8                   iny
000E6Br 1  18                   clc
000E6Cr 1  69 01                adc     #1
000E6Er 1  99 rr rr             sta     rowbuf,y
000E71r 1  C8                   iny
000E72r 1  D0 0E                bne     @n
000E74r 1  A9 00        @dead:  lda     #P_BLANK
000E76r 1  99 rr rr             sta     rowbuf,y
000E79r 1  C8                   iny
000E7Ar 1  99 rr rr             sta     rowbuf,y
000E7Dr 1  C8                   iny
000E7Er 1  99 rr rr             sta     rowbuf,y
000E81r 1  C8                   iny
000E82r 1  CA           @n:     dex
000E83r 1  D0 D4                bne     @s
000E85r 1  A9 00                lda     #P_BLANK
000E87r 1  99 rr rr             sta     rowbuf,y        ; [25]
000E8Ar 1                       ; the part on the screen: columns rowc-1 .. rowc+24
000E8Ar 1  AE rr rr             ldx     dr_r
000E8Dr 1  BD rr rr             lda     rowc,x
000E90r 1  38                   sec
000E91r 1  E9 01                sbc     #1
000E93r 1  8D rr rr             sta     dr_c            ; first column (signed)
000E96r 1  A0 00                ldy     #0              ; first index into rowbuf
000E98r 1  AD rr rr             lda     dr_c
000E9Br 1  10 0B                bpl     @on
