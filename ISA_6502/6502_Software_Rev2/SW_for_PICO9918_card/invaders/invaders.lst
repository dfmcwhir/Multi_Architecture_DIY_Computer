000E11r 1  AE rr rr             ldx     sa_row
000E14r 1  B0 02                bcs     @no
000E16r 1  38                   sec
000E17r 1  60                   rts
000E18r 1  18           @no:    clc
000E19r 1  60                   rts
000E1Ar 1               
000E1Ar 1               ; draw row X: blank, 8 cells of 3 patterns, blank, starting a cell to the
000E1Ar 1               ; left of slot 0 (only the part on the screen).  Preserves X.
000E1Ar 1               draw_row:
000E1Ar 1  8E rr rr             stx     dr_r
000E1Dr 1  A0 00                ldy     #0              ; build the 26 names in rowbuf
000E1Fr 1  8C rr rr             sty     rowbuf
000E22r 1  C8                   iny
000E23r 1  BD rr rr             lda     rowkind,x       ; the first pattern: kind*24 + frame*12 + pos*3
000E26r 1  8D rr rr             sta     tmp
000E29r 1  0A                   asl
000E2Ar 1  18                   clc
000E2Br 1  6D rr rr             adc     tmp
000E2Er 1  0A                   asl
000E2Fr 1  0A                   asl
000E30r 1  0A                   asl                     ; kind * 24
000E31r 1  8D rr rr             sta     tmp
000E34r 1  BD rr rr             lda     rowfrm,x
000E37r 1  F0 02                beq     @f0
000E39r 1  A9 0C                lda     #12
000E3Br 1  18           @f0:    clc
000E3Cr 1  6D rr rr             adc     tmp
000E3Fr 1  8D rr rr             sta     tmp
000E42r 1  BD rr rr             lda     rowph,x
000E45r 1  0A                   asl
000E46r 1  7D rr rr             adc     rowph,x
000E49r 1  6D rr rr             adc     tmp
000E4Cr 1  69 80                adc     #P_INV
