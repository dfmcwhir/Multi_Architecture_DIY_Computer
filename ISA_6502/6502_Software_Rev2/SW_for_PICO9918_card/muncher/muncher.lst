000756r 1               ; ---- the sprites ------------------------------------------------------------------
000756r 1               ; Sprite 0 the muncher, 1-4 the ghosts' eyes, 5-8 their bodies.  An actor
000756r 1               ; glides from the tile it was on (afx, afy) to the one it is on now (atx,
000756r 1               ; aty) as its accumulator fills, so it is drawn a tile behind: the game
000756r 1               ; moves it a whole tile when the accumulator carries.
000756r 1               put_sprites:
000756r 1  A2 00                ldx     #0
000758r 1  AD rr rr     @a:     lda     snap            ; just placed: no glide
00075Br 1  D0 50                bne     @set
00075Dr 1  BD rr rr             lda     ax,x
000760r 1  DD rr rr             cmp     atx,x
000763r 1  D0 12                bne     @mv
000765r 1  BD rr rr             lda     ay,x
000768r 1  DD rr rr             cmp     aty,x
00076Br 1  D0 0A                bne     @mv
00076Dr 1  BD rr rr             lda     aacc,x          ; a carry without a move: standing still
000770r 1  DD rr rr             cmp     lacc,x
000773r 1  B0 50                bcs     @frac
000775r 1  90 42                bcc     @stand
000777r 1  BD rr rr     @mv:    lda     atx,x
00077Ar 1  9D rr rr             sta     afx,x
00077Dr 1  BD rr rr             lda     aty,x
000780r 1  9D rr rr             sta     afy,x
000783r 1  BD rr rr             lda     ax,x
000786r 1  9D rr rr             sta     atx,x
000789r 1  BD rr rr             lda     ay,x
00078Cr 1  9D rr rr             sta     aty,x
00078Fr 1  BD rr rr             lda     atx,x           ; not to a neighbour (the tunnel): no glide
000792r 1  38                   sec
000793r 1  FD rr rr             sbc     afx,x
000796r 1  18                   clc
000797r 1  69 01                adc     #1
000799r 1  C9 03                cmp     #3
00079Br 1  B0 1C                bcs     @stand
00079Dr 1  BD rr rr             lda     aty,x
0007A0r 1  38                   sec
0007A1r 1  FD rr rr             sbc     afy,x
0007A4r 1  18                   clc
0007A5r 1  69 01                adc     #1
0007A7r 1  C9 03                cmp     #3
0007A9r 1  B0 0E                bcs     @stand
0007ABr 1  90 18                bcc     @frac
0007ADr 1  BD rr rr     @set:   lda     ax,x
0007B0r 1  9D rr rr             sta     atx,x
0007B3r 1  BD rr rr             lda     ay,x
0007B6r 1  9D rr rr             sta     aty,x
0007B9r 1  BD rr rr     @stand: lda     atx,x
0007BCr 1  9D rr rr             sta     afx,x
0007BFr 1  BD rr rr             lda     aty,x
0007C2r 1  9D rr rr             sta     afy,x
0007C5r 1  BD rr rr     @frac:  lda     aacc,x
0007C8r 1  9D rr rr             sta     lacc,x
0007CBr 1  4A                   lsr
0007CCr 1  4A                   lsr
0007CDr 1  4A                   lsr
0007CEr 1  4A                   lsr
0007CFr 1  4A                   lsr
0007D0r 1  A8                   tay                     ; eighths of the way
0007D1r 1  BD rr rr             lda     afx,x           ; x = 8 + 6 fx - 1 (8 wide on a 6 wide tile)
0007D4r 1  0A                   asl
0007D5r 1  7D rr rr             adc     afx,x
0007D8r 1  0A                   asl
0007D9r 1  69 07                adc     #7
0007DBr 1  9D rr rr             sta     spx,x
0007DEr 1  BD rr rr             lda     atx,x
0007E1r 1  DD rr rr             cmp     afx,x
0007E4r 1  F0 19                beq     @nx
0007E6r 1  90 0D                bcc     @xl
0007E8r 1  BD rr rr             lda     spx,x
0007EBr 1  18                   clc
0007ECr 1  79 rr rr             adc     xo_tab,y
0007EFr 1  9D rr rr             sta     spx,x
0007F2r 1  4C rr rr             jmp     @nx
0007F5r 1  BD rr rr     @xl:    lda     spx,x
0007F8r 1  38                   sec
0007F9r 1  F9 rr rr             sbc     xo_tab,y
0007FCr 1  9D rr rr             sta     spx,x
0007FFr 1  BD rr rr     @nx:    lda     afy,x           ; y = 8 fy - 1 (the VDP draws a line lower)
000802r 1  0A                   asl
000803r 1  0A                   asl
000804r 1  0A                   asl
000805r 1  38                   sec
000806r 1  E9 01                sbc     #1
000808r 1  9D rr rr             sta     spy,x
