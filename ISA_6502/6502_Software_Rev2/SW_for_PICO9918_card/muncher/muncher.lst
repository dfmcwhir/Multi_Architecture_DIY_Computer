000830r 1  F0 03                beq     :+
000832r 1  4C rr rr             jmp     @a
000835r 1  A9 00        :       lda     #0
000837r 1  8D rr rr             sta     snap
00083Ar 1                       ; the attribute table, built in satt
00083Ar 1  A2 00                ldx     #0              ; the muncher
00083Cr 1  20 rr rr             jsr     sprite_of
00083Fr 1  4A                   lsr
000840r 1  AC rr rr             ldy     die_pic
000843r 1  F0 01                beq     @m
000845r 1  98                   tya
000846r 1  8D rr rr     @m:     sta     satt+2
000849r 1  AD rr rr             lda     spy
00084Cr 1  8D rr rr             sta     satt
00084Fr 1  AD rr rr             lda     spx
000852r 1  8D rr rr             sta     satt+1
000855r 1  A9 0B                lda     #MUNCH_COL
000857r 1  8D rr rr             sta     satt+3
00085Ar 1  A2 01                ldx     #1
00085Cr 1  8E rr rr     @g:     stx     ri
