0008F6r 1               :
0008F6r 1  A9 D0                lda     #$D0
0008F8r 1  8D rr rr             sta     satt+36
0008FBr 1  A9 00                lda     #<V_SATTR
0008FDr 1  A0 0D                ldy     #>V_SATTR
0008FFr 1  20 rr rr             jsr     vdp_waddr
000902r 1  A9 rr                lda     #<satt
000904r 1  A2 rr                ldx     #>satt
000906r 1  A0 25                ldy     #37
000908r 1  8C rr rr             sty     vdp_n
00090Br 1  A0 00                ldy     #0
00090Dr 1  4C rr rr             jmp     copy_n2
000910r 1               
000910r 1               ; across a 6 pixel tile in eighths
000910r 1  00 01 02 02  xo_tab: .byte   0, 1, 2, 2, 3, 4, 4, 5
000914r 1  03 04 04 05  
000918r 1               
000918r 1               ; R0-R7: Graphics I, display off (gfx_init turns it on); names $0800,
000918r 1               ; colours $0C00, patterns $0000, sprite attributes $0D00, sprite patterns
000918r 1               ; $1800; backdrop black
000918r 1               vdp_regs:
000918r 1  00 80 02 30          .byte   $00, $80, V_NAME1/$400, V_COL1/$40, V_PAT/$800, V_SATTR/$80, V_SPAT/$800, $01
00091Cr 1  00 1A 03 01  
000920r 1               
000920r 1               ; while the VDP waits for a frame (vdp_frame isn't used, but lib/vdp.s needs it)
000920r 1               frame_idle:
000920r 1  4C rr rr             jmp     sfx_poll
000923r 1               
000923r 1               ; wait about A ms.  The inner loop is sized for the clock (CLOCK_MHZ in
000923r 1               ; sbc_api.inc): 5 + 4 * (CLOCK_MHZ - 1) cycles a turn, DELAY_N turns a ms.
000923r 1               DELAY_N = (1000 * CLOCK_MHZ - 7) / (5 + 4 * (CLOCK_MHZ - 1))
000923r 1               delay_ms:
000923r 1  AA                   tax
000924r 1  F0 11                beq     @done
000926r 1  20 rr rr     @o:     jsr     sfx_poll        ; (the sound goes on while waiting)
000929r 1  A0 EA                ldy     #DELAY_N
00092Br 1               @i:
00092Br 1  EA EA EA EA  .repeat CLOCK_MHZ - 1           ; (4 more cycles a turn for each MHz above 1)
00092Fr 1  EA EA        
000931r 1                       nop
000931r 1                       nop
000931r 1               .endrepeat
000931r 1  88                   dey
000932r 1  D0 F7                bne     @i
000934r 1  CA                   dex
000935r 1  D0 EF                bne     @o
000937r 1  60           @done:  rts
000938r 1               
000938r 1               ; wait about A x 50 ms
000938r 1               delay_long:
000938r 1  8D rr rr             sta     tmp
00093Br 1  A9 32        @l:     lda     #50
00093Dr 1  20 rr rr             jsr     delay_ms
000940r 1  20 rr rr             jsr     flush_in        ; keys pressed meanwhile are dropped (so the
000943r 1  CE rr rr             dec     tmp             ; ROM's keyboard buffer never fills up)
000946r 1  D0 F3                bne     @l
000948r 1  60                   rts
000949r 1               
000949r 1               ; 16 bit Galois LFSR.  Returns a random byte in A.  Preserves X and Y.
000949r 1  AD rr rr     rand:   lda     rng+1
00094Cr 1  4A                   lsr
00094Dr 1  6E rr rr             ror     rng
000950r 1  90 02                bcc     @n
000952r 1  49 B4                eor     #$B4
000954r 1  8D rr rr     @n:     sta     rng+1
000957r 1  4D rr rr             eor     rng
00095Ar 1  60                   rts
00095Br 1               
00095Br 1               .macro MENU_IDLE
00095Br 1                       jsr     rand            ; stir the random numbers while waiting
00095Br 1                       jsr     sfx_poll
00095Br 1               .endmacro
00095Br 1               CTRL_COL        = 0
00095Br 1               CTRL_ROW        = 18
00095Br 1               
00095Br 1               ; ============================================================================
00095Br 1               ; gamepad and menu input (shared by the SBC games)
00095Br 1               ; ============================================================================
00095Br 1               PAD_A           = $01           ; bits returned by SBC_PADSTATE
00095Br 1               PAD_B           = $02
00095Br 1               PAD_SELECT      = $04
00095Br 1               PAD_START       = $08
00095Br 1               PAD_UP          = $10
00095Br 1               PAD_DOWN        = $20
00095Br 1               PAD_LEFT        = $40
00095Br 1               PAD_RIGHT       = $80
00095Br 1               PAD_GO          = $80           ; menu_key's answer for gamepad A or Start
00095Br 1               
00095Br 1               ; read the gamepad: pad = buttons held now, padnew = buttons pressed since
00095Br 1               ; the last call.  Preserves X and Y (SBC_PADSTATE only changes A).
00095Br 1               read_pad:
00095Br 1  20 12 FE             jsr     SBC_PADSTATE
00095Er 1  C9 FF                cmp     #$FF            ; every button "pressed" = no pad
000960r 1  D0 02                bne     @ok
000962r 1  A9 00                lda     #0
000964r 1  8D rr rr     @ok:    sta     pad
000967r 1  AD rr rr             lda     padold
00096Ar 1  49 FF                eor     #$FF
00096Cr 1  2D rr rr             and     pad
00096Fr 1  8D rr rr             sta     padnew
000972r 1  AD rr rr             lda     pad
000975r 1  8D rr rr             sta     padold
000978r 1  60                   rts
000979r 1               
000979r 1               ; throw away waiting characters
000979r 1               flush_in:
000979r 1  20 00 FE             jsr     getc
00097Cr 1  B0 FB                bcs     flush_in
00097Er 1  60                   rts
00097Fr 1               
00097Fr 1               ; carry set if A is one of the characters the gamepad driver types for the
00097Fr 1               ; pad (W A S D and space).  Those are ignored in gamepad mode so that one
00097Fr 1               ; press doesn't act twice.  Preserves A.
00097Fr 1               pad_typed:
00097Fr 1  C9 20                cmp     #' '
000981r 1  F0 12                beq     @y
000983r 1  C9 57                cmp     #'W'
000985r 1  F0 0E                beq     @y
000987r 1  C9 41                cmp     #'A'
000989r 1  F0 0A                beq     @y
00098Br 1  C9 53                cmp     #'S'
00098Dr 1  F0 06                beq     @y
00098Fr 1  C9 44                cmp     #'D'
000991r 1  F0 02                beq     @y
000993r 1  18                   clc
000994r 1  60                   rts
000995r 1  38           @y:     sec
000996r 1  60                   rts
000997r 1               
000997r 1               ; wait for a menu choice.  Returns a key (letters in upper case), or
000997r 1               ; PAD_GO for the gamepad's A or Start button.
000997r 1               menu_key:
000997r 1  20 rr rr 20  @l:     MENU_IDLE
00099Br 1  rr rr        
00099Dr 1  20 rr rr             jsr     read_pad
0009A0r 1  AD rr rr             lda     padnew
0009A3r 1  29 09                and     #PAD_A | PAD_START
0009A5r 1  D0 21                bne     @pad
0009A7r 1  20 00 FE             jsr     getc
0009AAr 1  90 EB                bcc     @l
0009ACr 1  C9 20                cmp     #' '            ; a space typed by the pad's A button?
0009AEr 1  D0 0D                bne     @up
0009B0r 1  20 rr rr             jsr     read_pad
0009B3r 1  AD rr rr             lda     pad
0009B6r 1  29 01                and     #PAD_A
0009B8r 1  D0 0E                bne     @pad
0009BAr 1  A9 20                lda     #' '
0009BCr 1  60                   rts
0009BDr 1  C9 61        @up:    cmp     #'a'
0009BFr 1  90 06                bcc     @r
0009C1r 1  C9 7B                cmp     #'z'+1
0009C3r 1  B0 02                bcs     @r
0009C5r 1  29 DF                and     #$DF
0009C7r 1  60           @r:     rts
0009C8r 1  20 rr rr     @pad:   jsr     flush_in        ; the space the driver typed for it
0009CBr 1  A9 80                lda     #PAD_GO
0009CDr 1  60                   rts
0009CEr 1               
0009CEr 1               ; print the controls line (CTRL_COL, CTRL_ROW)
0009CEr 1               show_ctrl:
0009CEr 1  20 rr rr             jsr     l1
0009D1r 1  A2 00                ldx     #CTRL_COL
0009D3r 1  A0 12                ldy     #CTRL_ROW
0009D5r 1  20 rr rr             jsr     gotoxy
0009D8r 1  AD rr rr             lda     ctrl
0009DBr 1  F0 07                beq     @kb
0009DDr 1  A9 rr                lda     #<ctrl_pad_txt
0009DFr 1  A0 rr                ldy     #>ctrl_pad_txt
0009E1r 1  4C rr rr             jmp     print
0009E4r 1  A9 rr        @kb:    lda     #<ctrl_kb_txt
0009E6r 1  A0 rr                ldy     #>ctrl_kb_txt
0009E8r 1  4C rr rr             jmp     print
0009EBr 1               
0009EBr 1               
0009EBr 1               ; ============================================================================
0009EBr 1               ; the maze in RAM
0009EBr 1               ; ============================================================================
0009EBr 1               
0009EBr 1               ; point mz_rd / mz_wr at tile X, Y.  Preserves X and Y.
0009EBr 1  8A           mz_at:  txa
0009ECr 1  18                   clc
0009EDr 1  79 rr rr             adc     mrow_lo,y
0009F0r 1  8D rr rr             sta     mz_rd+1
0009F3r 1  8D rr rr             sta     mz_wr+1
0009F6r 1  B9 rr rr             lda     mrow_hi,y
0009F9r 1  69 00                adc     #0
0009FBr 1  8D rr rr             sta     mz_rd+2
0009FEr 1  8D rr rr             sta     mz_wr+2
000A01r 1  60                   rts
000A02r 1  AD FF FF     mz_rd:  lda     $FFFF
000A05r 1  60                   rts
000A06r 1  8D FF FF     mz_wr:  sta     $FFFF
000A09r 1  60                   rts
000A0Ar 1               
000A0Ar 1               ; A = tile at X, Y.  Preserves X and Y.
000A0Ar 1               tile_get:
000A0Ar 1  20 rr rr             jsr     mz_at
000A0Dr 1  4C rr rr             jmp     mz_rd
000A10r 1               
000A10r 1               ; copy the maze from ROM (4 pages; the maze is 21 x 40 = 840 bytes)
000A10r 1               copy_maze:
000A10r 1  A9 rr                lda     #<maze_src
000A12r 1  8D rr rr             sta     @rd+1
000A15r 1  A9 rr                lda     #>maze_src
000A17r 1  8D rr rr             sta     @rd+2
000A1Ar 1  A9 rr                lda     #>maze
000A1Cr 1  8D rr rr             sta     @wr+2
000A1Fr 1  A2 04                ldx     #4
