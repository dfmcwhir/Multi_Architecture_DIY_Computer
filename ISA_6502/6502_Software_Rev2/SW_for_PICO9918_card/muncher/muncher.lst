00064Fr 1  20 rr rr             jsr     l1
000652r 1  20 rr rr     @n:     jsr     @get
000655r 1  C9 FF                cmp     #TERM
000657r 1  F0 42                beq     @r
000659r 1  C9 0F                cmp     #TC_ROW
00065Br 1  D0 09                bne     @1
00065Dr 1  20 rr rr             jsr     @get
000660r 1  8D rr rr             sta     pr_row
000663r 1  4C rr rr             jmp     @n
000666r 1  C9 0E        @1:     cmp     #TC_COL
000668r 1  D0 0D                bne     @2
00066Ar 1  20 rr rr             jsr     @get
00066Dr 1  AA                   tax
00066Er 1  AC rr rr             ldy     pr_row
000671r 1  20 rr rr             jsr     gotoxy
000674r 1  4C rr rr             jmp     @n
000677r 1  C9 01        @2:     cmp     #TC_L1
000679r 1  D0 06                bne     @3
00067Br 1  20 rr rr             jsr     l1
00067Er 1  4C rr rr             jmp     @n
000681r 1  C9 02        @3:     cmp     #TC_L2
000683r 1  D0 06                bne     @4
000685r 1  20 rr rr             jsr     l2
000688r 1  4C rr rr             jmp     @n
00068Br 1  C9 0C        @4:     cmp     #TC_CLS
00068Dr 1  D0 06                bne     @5
00068Fr 1  20 rr rr             jsr     cls
000692r 1  4C rr rr             jmp     @n
000695r 1  8D 1C 7F     @5:     sta     VDP_DATA
000698r 1  4C rr rr             jmp     @n
00069Br 1  60           @r:     rts
00069Cr 1               @get:
00069Cr 1  AD FF FF     @ld:    lda     $FFFF
00069Fr 1  EE rr rr             inc     @ld+1
0006A2r 1  D0 03                bne     :+
0006A4r 1  EE rr rr             inc     @ld+2
0006A7r 1  60           :       rts
0006A8r 1               
0006A8r 1               ; ---- the maze ---------------------------------------------------------------------
0006A8r 1               ; layer 1: the walls (rows 0-20); layer 2: the dots, pellets and the door
0006A8r 1               draw_maze:
0006A8r 1  A9 00                lda     #<V_NAME1
0006AAr 1  A0 08                ldy     #>V_NAME1
0006ACr 1  20 rr rr             jsr     vdp_waddr
0006AFr 1  A9 rr                lda     #<wall_names
0006B1r 1  A2 rr                ldx     #>wall_names
0006B3r 1  A0 A0                ldy     #<(MAZE_H * 32)
0006B5r 1  8C rr rr             sty     vdp_n
0006B8r 1  A0 02                ldy     #>(MAZE_H * 32)
0006BAr 1  20 rr rr             jsr     copy_n2
0006BDr 1  A9 00                lda     #0
0006BFr 1  8D rr rr             sta     dr_r
0006C2r 1  AC rr rr     @r:     ldy     dr_r
0006C5r 1  20 rr rr             jsr     dot_row
0006C8r 1  EE rr rr             inc     dr_r
0006CBr 1  AD rr rr             lda     dr_r
0006CEr 1  C9 15                cmp     #MAZE_H
0006D0r 1  D0 F0                bne     @r
0006D2r 1  60                   rts
0006D3r 1               
0006D3r 1               ; layer 2, maze row Y: all 10 groups of 4 tiles (cells 1-30)
0006D3r 1               dot_row:
0006D3r 1  8C rr rr             sty     dr_y
0006D6r 1  20 rr rr             jsr     l2
