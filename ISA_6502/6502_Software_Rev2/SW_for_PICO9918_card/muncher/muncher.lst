00089Er 1  D0 27                bne     @flash
0008A0r 1  4A                   lsr
0008A1r 1  48                   pha
0008A2r 1  AD rr rr             lda     ri
0008A5r 1  0A                   asl
0008A6r 1  0A                   asl
0008A7r 1  A8                   tay
0008A8r 1  68                   pla
0008A9r 1  99 rr rr             sta     satt+18,y
0008ACr 1  BD rr rr             lda     ghost_col-1,x
0008AFr 1  99 rr rr             sta     satt+19,y
0008B2r 1  AD rr rr             lda     sg_y
0008B5r 1  99 rr rr             sta     satt+16,y
