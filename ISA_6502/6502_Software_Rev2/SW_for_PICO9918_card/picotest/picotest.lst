ca65 V2.19 - Git d20d99b
Main file   : picotest.s
Current file: picotest.s

000000r 1               ; ============================================================================
000000r 1               ; picotest.s - checks the PICO9918's F18A features that SMB will use:
000000r 1               ;   1. tile layer 1 smooth scrolling across two name table pages (R27 and the
000000r 1               ;      page bit in R2, R29 bit 1 = two pages)
000000r 1               ;   2. tile layer 2 for a fixed status line on top (R49 bit 7, names R10,
000000r 1               ;      colours R11; colour 0 = see-through)
000000r 1               ;   3. magnified 8 x 8 sprites, 12 on one line (R30: sprites per line)
000000r 1               ;
000000r 1               ;   run:  L PICOTEST 0800  then  R.    Keys: SPACE pause, Q quit.
000000r 1               ; ============================================================================
000000r 1                       .setcpu "6502"
000000r 1                       .include "sbc_api.inc"
000000r 2               ; sbc_api.inc - fixed ROM entry points of the SBC (see jumptable.s), and the
000000r 2               ; CPU clock.  Use in your own ca65 programs:  .include "sbc_api.inc"
000000r 2               ; (the games find it one folder up: their make.bat passes  -I ..  to ca65)
000000r 2               SBC_CHRIN       = $FE00         ; carry set + A = char, carry clear = none waiting
000000r 2               SBC_CHROUT      = $FE03         ; print A (A, X, Y preserved)
000000r 2               SBC_MENU        = $FE06         ; boot menu
000000r 2               SBC_COLD        = $FE09         ; BASIC cold start
000000r 2               SBC_WARM        = $FE0C         ; BASIC warm start
000000r 2               SBC_MONITOR     = $FE0F         ; monitor prompt (or JMP $FF00)
000000r 2               SBC_PADSTATE    = $FE12         ; A = gamepad buttons held: bit0 A,1 B,2 Select,3 Start,4 Up,5 Down,6 Left,7 Right
000000r 2               SBC_LOAD        = $FE15         ; load a file from the current device (U: or C:): A/Y = parameter block (.word addr, .word max, "NAME.EXT",0)
000000r 2                                               ;   carry clear = loaded, X/Y = length; carry set = failed, A = error code
000000r 2               SBC_CWD         = $FE18         ; A/Y = the monitor's current folder: 0-ended, "" (the top) or "/A/B"
000000r 2                                               ;   (newer ROMs: check for a JMP ($4C) at $FE18 first)
000000r 2               
000000r 2               ; ---- CPU Rev2 ROMs (API version 2).  Check first:  LDA $FE1B / CMP #$4C,
000000r 2               ;      then JSR SBC_SYSINFO and check Y >= 2.
000000r 2               SBC_SYSINFO     = $FE1B         ; A = display type (DISP_...), X = device status, Y = API version
000000r 2               SBC_SEROUT      = $FE1E         ; send A out of the serial console port (A, X, Y preserved)
000000r 2               SBC_MOUSEON     = $FE21         ; A = 1 mouse reports on, 0 off (off at reset); C=1 = no mouse
000000r 2               SBC_MOUSE       = $FE24         ; A = buttons (bit0 L, 1 R, 2 M), X/Y = signed movement since
000000r 2                                               ;   the last call (right/down +); C=1 = a report arrived
000000r 2               SBC_BANKSET     = $FE27         ; A = RAM bank 0-15 for $1000-$7EFF (X, Y kept).  Your code that
000000r 2                                               ;   calls it must be in $0000-$0FFF, or it switches itself out!
000000r 2               SBC_BANKGET     = $FE2A         ; A = bank selected, X = number of banks fitted
000000r 2               SBC_TICKS       = $FE2D         ; A/X/Y = 60 Hz counter, low/middle/high
000000r 2               SBC_ACIAIN      = $FE30         ; serial card 6551: C=1 + A = byte, C=0 none
000000r 2               SBC_ACIAOUT     = $FE33         ; serial card 6551: send A (A, X, Y preserved)
000000r 2               SBC_VSYNC       = $FE36         ; C=1 if a frame ended since the last call (PICO9918 / ESP32_VGA),
000000r 2                                               ;   A = the VDP status / ESP32 STATUS
000000r 2               SBC_CONRESET    = $FE39         ; display back to the text console, cleared (call it when
000000r 2                                               ;   your game exits after changing the display mode)
000000r 2               SBC_SNDNOTE     = $FE3C         ; A/Y -> 5 bytes: voice (AY 0-2, ESP32 0-3), note (0-95, 36 = C4),
000000r 2                                               ;   volume (0-15; AY 16 = envelope), time (16 bit, 1/60 s,
000000r 2                                               ;   0 = hold).  Doesn't wait.  C=1 = bad values
000000r 2               SBC_SNDQUIET    = $FE3F         ; all sound off
000000r 2               SBC_SNDBUSY     = $FE42         ; A = voice: C=1 while its timed note is still playing
000000r 2               SBC_SAY         = $FE45         ; A/Y -> SPO256 allophones (0-63) ended by $FF; queued
000000r 2               SBC_SAYBUSY     = $FE48         ; C=1 while the SPO256 is speaking
000000r 2               SBC_AYREAD      = $FE4B         ; X = AY register (14/15 = I/O ports A/B) -> A
000000r 2               SBC_AYWRITE     = $FE4E         ; AY register X = A (register 7 bits 6/7 = ports A/B output)
000000r 2               SBC_TIME        = $FE51         ; A/Y -> 18 byte buffer <- "mm/dd/yy hh:mm:ss",0 (CF card's DS1302);
000000r 2                                               ;   C=1 = no clock
000000r 2               SBC_SETTIME     = $FE54         ; A/Y -> 14 characters "dwyymmddHHMMSS" (dw 01 = Sunday)
000000r 2               SBC_DISPTYPE    = $FEFF         ; a byte: the display type (DISP_...)
000000r 2               
000000r 2               ; SBC_SYSINFO display types
000000r 2               DISP_NONE       = 0
000000r 2               DISP_TERM       = 1             ; KB_MONITOR_TERM (PIC32 terminal)
000000r 2               DISP_PICO       = 2             ; PICO9918
000000r 2               DISP_ESP32      = 3             ; ESP32_VGA
000000r 2               
000000r 2               ; SBC_SYSINFO device status bits (X)
000000r 2               DEV_VIA         = $01
000000r 2               DEV_ACIA        = $02
000000r 2               DEV_DISPLAY     = $04
000000r 2               DEV_AVRKBD      = $08
000000r 2               
000000r 2               ; Key codes from the AVR keyboard interface (Serial Rev3 / PICO9918 card)
000000r 2               KEY_UP          = $05           ; ^E  (WordStar)
000000r 2               KEY_DOWN        = $18           ; ^X
000000r 2               KEY_LEFT        = $10           ; ^P
000000r 2               KEY_RIGHT       = $04           ; ^D
000000r 2               KEY_ESC         = $03           ; Esc sends ^C
000000r 2               KEY_F1          = 129           ; F1-F12 = 129-140, shifted 141-152
000000r 2               
000000r 2               ; First RAM address for loaded programs (CPU Rev2 ROM)
000000r 2               SBC_USER_RAM    = $0800
000000r 2               
000000r 2               ; The CPU clock in MHz (whole numbers, 1 to 8).  Programs size their delay
000000r 2               ; loops from it, so a millisecond stays a millisecond.  To build for another
000000r 2               ; clock, change it here or give it on the command line:  make.bat 1
000000r 2               .ifndef CLOCK_MHZ
000000r 2               CLOCK_MHZ       = 2
000000r 2               .endif
000000r 2               
000000r 1               
000000r 1               V_NAME1         = $0000         ; layer 1 names: two pages, $0000 and $0400
000000r 1               V_PAT           = $0800         ; patterns
000000r 1               V_NAME2         = $1000         ; layer 2 names
000000r 1               V_SATTR         = $1B00
000000r 1               V_COL1          = $2000         ; layer 1 colours
000000r 1               V_COL2          = $2040         ; layer 2 colours
000000r 1               V_SPAT          = $3800
000000r 1               VDP_NAME        = V_NAME1
000000r 1               NSPR            = 12
000000r 1               
000000r 1                       .segment "CODE"
000000r 1  4C rr rr             jmp     start
000003r 1  00 00 00 00          .byte   0, 0, 0, 0, 0
000007r 1  00           
000008r 1                       .include "lib/vdp.s"
000008r 2               ; ============================================================================
000008r 2               ; vdp.s - PICO9918 / TMS9918A routines shared by the SBC games (CPU Rev2)
000008r 2               ;
000008r 2               ; Include it after setting VDP_NAME (the name table's VRAM address):
000008r 2               ;           VDP_NAME = $1800
000008r 2               ;           .include "lib/vdp.s"
000008r 2               ; No zero page is used: the copy routines patch their own addresses.
000008r 2               ;
000008r 2               ;   vdp_setup   A/Y -> 8 bytes: R0-R7.  Puts a PICO9918 (F18A mode) back to
000008r 2               ;               plain TMS9918A behaviour first (24 rows, all 32 sprites, no
000008r 2               ;               scrolling, no second tile layer; the unlock leaves VR30 at
000008r 2               ;               31 sprites a line),
000008r 2               ;               clears the 16K of VRAM, then loads R0-R7.  Interrupts from
000008r 2               ;               the VDP should be off in R1 (bit 5): the games poll.
000008r 2               ;   vdp_reg     register X = A
000008r 2               ;   vdp_waddr   VRAM write address = A (low) / Y (high)
000008r 2               ;   vdp_fill    write A to VRAM vdp_n (16 bit) times, from the address set
000008r 2               ;   vdp_copy    copy vdp_n bytes from RAM vdp_src to VRAM (from the address set)
000008r 2               ;   vdp_at      write address = the name table cell at column X, row Y
000008r 2               ;   vdp_puts    write the 0-ended string at A/Y from there (names = ASCII)
000008r 2               ;   vdp_bcd     write A as two digits
000008r 2               ;   vdp_frame   wait for the next frame (60 a second), calling frame_idle
000008r 2               ;               (the game's: sound, random numbers) while it waits
000008r 2               ;
000008r 2               ; The VDP's ports: data $7F1C, control/status $7F1D.  Reading the status
000008r 2               ; clears the frame flag, so nothing else should read it while a game runs
000008r 2               ; (the ROM doesn't, with PICO_IRQ = 0 in its config.inc, the default).
000008r 2               ; ============================================================================
000008r 2               
000008r 2               VDP_DATA        = $7F1C
000008r 2               VDP_CTRL        = $7F1D
000008r 2               
000008r 2               ; register X = A.  Keeps A, X, Y.
000008r 2               vdp_reg:
000008r 2  8D 1D 7F             sta     VDP_CTRL
00000Br 2  48                   pha
00000Cr 2  8A                   txa
00000Dr 2  09 80                ora     #$80
00000Fr 2  8D 1D 7F             sta     VDP_CTRL
000012r 2  68                   pla
000013r 2  60                   rts
000014r 2               
000014r 2               ; VRAM write address = A (low) / Y (high).  Keeps A, X, Y.
000014r 2               vdp_waddr:
000014r 2  8D 1D 7F             sta     VDP_CTRL
000017r 2  48                   pha
000018r 2  98                   tya
000019r 2  29 3F                and     #$3F
00001Br 2  09 40                ora     #$40
00001Dr 2  8D 1D 7F             sta     VDP_CTRL
000020r 2  68                   pla
000021r 2  60                   rts
000022r 2               
000022r 2               ; write A, vdp_n times.  Keeps A.
000022r 2               vdp_fill:
000022r 2  AE rr rr             ldx     vdp_n           ; the odd bytes first
000025r 2  F0 06                beq     @pg
000027r 2  8D 1C 7F     @lo:    sta     VDP_DATA
00002Ar 2  CA                   dex
00002Br 2  D0 FA                bne     @lo
00002Dr 2  AC rr rr     @pg:    ldy     vdp_n+1         ; then whole pages
000030r 2  F0 0B                beq     @done
000032r 2  A2 00        @p:     ldx     #0
000034r 2  8D 1C 7F     @pp:    sta     VDP_DATA
000037r 2  CA                   dex
000038r 2  D0 FA                bne     @pp
00003Ar 2  88                   dey
00003Br 2  D0 F5                bne     @p
00003Dr 2  60           @done:  rts
00003Er 2               
00003Er 2               ; copy vdp_n bytes from vdp_src to VRAM
00003Er 2               vdp_copy:
00003Er 2  AD rr rr             lda     vdp_src
000041r 2  8D rr rr             sta     @rd+1
000044r 2  AD rr rr             lda     vdp_src+1
000047r 2  8D rr rr             sta     @rd+2
00004Ar 2  AD rr rr             lda     vdp_n
00004Dr 2  8D rr rr             sta     vdp_t
000050r 2  AD rr rr             lda     vdp_n+1
000053r 2  8D rr rr             sta     vdp_t+1
000056r 2  AD rr rr     @l:     lda     vdp_t
000059r 2  0D rr rr             ora     vdp_t+1
00005Cr 2  F0 1C                beq     @done
00005Er 2  AD FF FF     @rd:    lda     $FFFF
000061r 2  8D 1C 7F             sta     VDP_DATA
000064r 2  EE rr rr             inc     @rd+1
000067r 2  D0 03                bne     :+
000069r 2  EE rr rr             inc     @rd+2
00006Cr 2  AD rr rr     :       lda     vdp_t
00006Fr 2  D0 03                bne     :+
000071r 2  CE rr rr             dec     vdp_t+1
000074r 2  CE rr rr     :       dec     vdp_t
000077r 2  4C rr rr             jmp     @l
00007Ar 2  60           @done:  rts
00007Br 2               
00007Br 2               ; A/Y -> 8 register values.  Clears VRAM.
00007Br 2               vdp_setup:
00007Br 2  8D rr rr             sta     @rr+1
00007Er 2  8C rr rr             sty     @rr+2
000081r 2  AD 1D 7F             lda     VDP_CTRL        ; (resets the register write latch)
000084r 2  A9 80                lda     #$80            ; R1 = $80: display off while we work
000086r 2  A2 01                ldx     #1
000088r 2  20 rr rr             jsr     vdp_reg
00008Br 2  A9 1C                lda     #$1C            ; F18A unlock (a PICO9918): $1C twice to VR57
00008Dr 2  A2 39                ldx     #57
00008Fr 2  20 rr rr             jsr     vdp_reg
000092r 2  20 rr rr             jsr     vdp_reg
000095r 2  A9 00                lda     #0              ; VR49: 24 rows, no 80 columns, no layer 2
000097r 2  A2 31                ldx     #49
000099r 2  20 rr rr             jsr     vdp_reg
00009Cr 2  A2 32                ldx     #50             ; VR50: plain TMS9918A behaviour
00009Er 2  20 rr rr             jsr     vdp_reg
0000A1r 2  A2 13                ldx     #19             ; VR19: no line interrupt
0000A3r 2  20 rr rr             jsr     vdp_reg
0000A6r 2  A2 19                ldx     #25             ; VR25-VR29: no scrolling, one page
0000A8r 2  20 rr rr     @sc:    jsr     vdp_reg
0000ABr 2  E8                   inx
0000ACr 2  E0 1E                cpx     #30
0000AEr 2  D0 F8                bne     @sc
0000B0r 2  A9 20                lda     #32             ; VR51: all 32 sprites
0000B2r 2  A2 33                ldx     #51
0000B4r 2  20 rr rr             jsr     vdp_reg
0000B7r 2                       ; (on a real TMS9918A those writes land in R0-R7: all set below)
0000B7r 2  A9 80                lda     #$80            ; R1 again: display off
0000B9r 2  A2 01                ldx     #1
0000BBr 2  20 rr rr             jsr     vdp_reg
0000BEr 2  A9 00                lda     #0              ; clear the 16K
0000C0r 2  A8                   tay
0000C1r 2  20 rr rr             jsr     vdp_waddr
0000C4r 2  A9 00                lda     #$00
0000C6r 2  8D rr rr             sta     vdp_n
0000C9r 2  A9 40                lda     #$40
0000CBr 2  8D rr rr             sta     vdp_n+1
0000CEr 2  A9 00                lda     #0
0000D0r 2  20 rr rr             jsr     vdp_fill
0000D3r 2  A2 00                ldx     #0
0000D5r 2  BD FF FF     @rr:    lda     $FFFF,x
0000D8r 2  20 rr rr             jsr     vdp_reg
0000DBr 2  E8                   inx
0000DCr 2  E0 08                cpx     #8
0000DEr 2  D0 F5                bne     @rr
0000E0r 2  60                   rts
0000E1r 2               
0000E1r 2               ; write address = name table cell X (column), Y (row).  Keeps X and Y.
0000E1r 2               vdp_at:
0000E1r 2  8E rr rr             stx     vdp_t
0000E4r 2  98                   tya
0000E5r 2  4A                   lsr                     ; row * 32: high byte = row / 8
0000E6r 2  4A                   lsr
0000E7r 2  4A                   lsr
0000E8r 2  8D rr rr             sta     vdp_t+1
0000EBr 2  98                   tya
0000ECr 2  0A                   asl
0000EDr 2  0A                   asl
0000EEr 2  0A                   asl
0000EFr 2  0A                   asl
0000F0r 2  0A                   asl                     ; low byte = (row & 7) * 32
0000F1r 2  18                   clc
0000F2r 2  6D rr rr             adc     vdp_t
0000F5r 2  18                   clc
0000F6r 2  69 00                adc     #<VDP_NAME
0000F8r 2  8D 1D 7F             sta     VDP_CTRL
0000FBr 2  AD rr rr             lda     vdp_t+1
0000FEr 2  69 00                adc     #>VDP_NAME
000100r 2  29 3F                and     #$3F
000102r 2  09 40                ora     #$40
000104r 2  8D 1D 7F             sta     VDP_CTRL
000107r 2  60                   rts
000108r 2               
000108r 2               ; write the 0-ended string at A/Y.  Keeps X.
000108r 2               vdp_puts:
000108r 2  8D rr rr             sta     @rd+1
00010Br 2  8C rr rr             sty     @rd+2
00010Er 2  A0 00                ldy     #0
000110r 2  B9 FF FF     @rd:    lda     $FFFF,y
000113r 2  F0 06                beq     @done
000115r 2  8D 1C 7F             sta     VDP_DATA
000118r 2  C8                   iny
000119r 2  D0 F5                bne     @rd
00011Br 2  60           @done:  rts
00011Cr 2               
00011Cr 2               ; A as two BCD digits.  Keeps X, Y.
00011Cr 2               vdp_bcd:
00011Cr 2  48                   pha
00011Dr 2  4A                   lsr
00011Er 2  4A                   lsr
00011Fr 2  4A                   lsr
000120r 2  4A                   lsr
000121r 2  09 30                ora     #'0'
000123r 2  8D 1C 7F             sta     VDP_DATA
000126r 2  68                   pla
000127r 2  48                   pha
000128r 2  29 0F                and     #$0F
00012Ar 2  09 30                ora     #'0'
00012Cr 2  8D 1C 7F             sta     VDP_DATA
00012Fr 2  68                   pla
000130r 2  60                   rts
000131r 2               
000131r 2               ; wait for the next frame
000131r 2               vdp_frame:
000131r 2  20 rr rr     @w:     jsr     frame_idle
000134r 2  AD 1D 7F             lda     VDP_CTRL
000137r 2  10 F8                bpl     @w
000139r 2  60                   rts
00013Ar 2               
00013Ar 2                       .segment "BSS"
000000r 2  xx xx        vdp_n:          .res 2
000002r 2  xx xx        vdp_src:        .res 2
000004r 2  xx xx        vdp_t:          .res 2
000006r 2                       .segment "CODE"
00013Ar 2               
00013Ar 1               
00013Ar 1               frame_idle:
00013Ar 1  60                   rts
00013Br 1               
00013Br 1  D8           start:  cld
00013Cr 1  A2 FF                ldx     #$FF
00013Er 1  9A                   txs
00013Fr 1  AD 1B FE             lda     SBC_SYSINFO             ; a Rev2 ROM and the PICO9918?
000142r 1  C9 4C                cmp     #$4C
000144r 1  D0 07                bne     @no
000146r 1  20 1B FE             jsr     SBC_SYSINFO
000149r 1  C9 02                cmp     #DISP_PICO
00014Br 1  F0 03                beq     @ok
00014Dr 1  4C 06 FE     @no:    jmp     SBC_MENU
000150r 1  A9 rr        @ok:    lda     #<regs
000152r 1  A0 rr                ldy     #>regs
000154r 1  20 rr rr             jsr     vdp_setup
000157r 1                       ; patterns: the font at $20-$5F, a column number pattern set, ground
000157r 1  A9 00                lda     #<(V_PAT + $20*8)
000159r 1  A0 09                ldy     #>(V_PAT + $20*8)
00015Br 1  20 rr rr             jsr     vdp_waddr
00015Er 1  A9 rr                lda     #<font
000160r 1  8D rr rr             sta     vdp_src
000163r 1  A9 rr                lda     #>font
000165r 1  8D rr rr             sta     vdp_src+1
000168r 1  A9 00                lda     #0
00016Ar 1  8D rr rr             sta     vdp_n
00016Dr 1  A9 02                lda     #2
00016Fr 1  8D rr rr             sta     vdp_n+1
000172r 1  20 rr rr             jsr     vdp_copy
000175r 1  A9 00                lda     #<(V_PAT + $80*8)       ; $80 brick, $81 sky dot, $82 sprite ball
000177r 1  A0 0C                ldy     #>(V_PAT + $80*8)
000179r 1  20 rr rr             jsr     vdp_waddr
00017Cr 1  A2 00                ldx     #0
00017Er 1  BD rr rr     @p:     lda     pats,x
000181r 1  8D 1C 7F             sta     VDP_DATA
000184r 1  E8                   inx
000185r 1  E0 18                cpx     #3*8
000187r 1  D0 F5                bne     @p
000189r 1                       ; layer 1 colours: text $20-$5F yellow on blue, $80 brick red on blue
000189r 1  A9 00                lda     #<V_COL1
00018Br 1  A0 20                ldy     #>V_COL1
00018Dr 1  20 rr rr             jsr     vdp_waddr
000190r 1  A2 00                ldx     #0
000192r 1  BD rr rr     @c1:    lda     col1,x
000195r 1  8D 1C 7F             sta     VDP_DATA
000198r 1  E8                   inx
000199r 1  E0 20                cpx     #32
00019Br 1  D0 F5                bne     @c1
00019Dr 1                       ; layer 2 colours: group 0 see-through, text white on black
00019Dr 1  A9 40                lda     #<V_COL2
00019Fr 1  A0 20                ldy     #>V_COL2
0001A1r 1  20 rr rr             jsr     vdp_waddr
0001A4r 1  A2 00                ldx     #0
0001A6r 1  BD rr rr     @c2:    lda     col2,x
0001A9r 1  8D 1C 7F             sta     VDP_DATA
0001ACr 1  E8                   inx
0001ADr 1  E0 20                cpx     #32
0001AFr 1  D0 F5                bne     @c2
0001B1r 1                       ; layer 1, both pages: the column number (0-63) at the top of each
0001B1r 1                       ; column, sky dots, bricks at the bottom
0001B1r 1  A9 00                lda     #0
0001B3r 1  8D rr rr             sta     row
0001B6r 1  A2 00        @r1:    ldx     #0
0001B8r 1  8E rr rr     @cl:    stx     col
0001BBr 1  AD rr rr             lda     col             ; address: page (col / 32) * $400 + row * 32 + col & 31
0001BEr 1  29 1F                and     #31
0001C0r 1  8D rr rr             sta     tmp
0001C3r 1  AD rr rr             lda     row
0001C6r 1  0A                   asl
0001C7r 1  0A                   asl
0001C8r 1  0A                   asl
0001C9r 1  0A                   asl
0001CAr 1  0A                   asl
0001CBr 1  0D rr rr             ora     tmp
0001CEr 1  8D 1D 7F             sta     VDP_CTRL
0001D1r 1  AD rr rr             lda     row
0001D4r 1  4A                   lsr
0001D5r 1  4A                   lsr
0001D6r 1  4A                   lsr
0001D7r 1  8D rr rr             sta     tmp
0001DAr 1  AD rr rr             lda     col
0001DDr 1  29 20                and     #32
0001DFr 1  4A                   lsr
0001E0r 1  4A                   lsr
0001E1r 1  4A                   lsr                     ; page 1: +4 to the high byte
0001E2r 1  0D rr rr             ora     tmp
0001E5r 1  09 40                ora     #$40 + >V_NAME1
0001E7r 1  8D 1D 7F             sta     VDP_CTRL
0001EAr 1  AD rr rr             lda     row
0001EDr 1  C9 02                cmp     #2
0001EFr 1  F0 27                beq     @tens
0001F1r 1  C9 03                cmp     #3
0001F3r 1  F0 34                beq     @ones
0001F5r 1  C9 14                cmp     #20
0001F7r 1  B0 3F                bcs     @brick
0001F9r 1  AD rr rr             lda     col             ; a diagonal of letters, so the scroll shows
0001FCr 1  18                   clc
0001FDr 1  6D rr rr             adc     row
000200r 1  29 07                and     #7
