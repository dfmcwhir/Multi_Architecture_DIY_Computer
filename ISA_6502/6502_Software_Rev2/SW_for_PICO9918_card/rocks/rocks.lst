000D37r 1  9D rr rr             sta     o_vy_lo,x
000D3Ar 1  AD rr rr             lda     w_hi
000D3Dr 1  9D rr rr             sta     o_vy_hi,x
000D40r 1  60                   rts
000D41r 1               ; A = s.7 -> A (lo), w_hi = A * 4 (sign extended).  Preserves X, Y.
000D41r 1  20 rr rr     times4: jsr     sext8
000D44r 1  0E rr rr             asl     w_lo
000D47r 1  2E rr rr             rol     w_hi
000D4Ar 1  0E rr rr             asl     w_lo
000D4Dr 1  2E rr rr             rol     w_hi
000D50r 1  AD rr rr             lda     w_lo
000D53r 1  60                   rts
000D54r 1               
000D54r 1               ; A = the heading (0-31) from the saucer that points nearest the ship: the
000D54r 1               ; one with the biggest dx * cos + dy * sin
000D54r 1  AD rr rr     aim:    lda     o_x_hi+O_SHIP   ; dx round the wrap, -80 .. 79
000D57r 1  38                   sec
000D58r 1  ED rr rr             sbc     o_x_hi+O_UFO
000D5Br 1  B0 02                bcs     @x1
000D5Dr 1  69 A0                adc     #FW
