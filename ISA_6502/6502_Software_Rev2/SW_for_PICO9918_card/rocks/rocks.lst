000A51r 1  9D rr rr             sta     o_vy_hi,x
000A54r 1  60                   rts
000A55r 1  A0 06        sar6:   ldy     #6
000A57r 1  AD rr rr     @l:     lda     w_hi
000A5Ar 1  C9 80                cmp     #$80
000A5Cr 1  6E rr rr             ror     w_hi
000A5Fr 1  6E rr rr             ror     w_lo
000A62r 1  88                   dey
000A63r 1  D0 F2                bne     @l
