000AF2r 1  9D rr rr             sta     o_vy_lo,x
000AF5r 1  AD rr rr             lda     w_hi
000AF8r 1  6D rr rr             adc     o_vy_hi+O_SHIP
000AFBr 1  9D rr rr             sta     o_vy_hi,x
000AFEr 1  60                   rts
000AFFr 1               ; A = s.7 sine -> A = sine * 4 / 128 rounded (about -4..4)
000AFFr 1               nose_ofs:
000AFFr 1  18                   clc
000B00r 1  69 80                adc     #$80            ; 0..255 offset by 128
000B02r 1  4A                   lsr
000B03r 1  4A                   lsr
000B04r 1  4A                   lsr
000B05r 1  4A                   lsr
000B06r 1  4A                   lsr                     ; 0..7
000B07r 1  38                   sec
000B08r 1  E9 04                sbc     #4
000B0Ar 1  60                   rts
000B0Br 1               ; w = A (s.7) * 5 / 2  (a 2.5 pixels a frame speed component, 8.8)
000B0Br 1  8E rr rr     times5: stx     t5x
000B0Er 1  20 rr rr             jsr     sext8
000B11r 1  AD rr rr             lda     w_lo            ; w * 5
000B14r 1  8D rr rr             sta     tmp
000B17r 1  AD rr rr             lda     w_hi
000B1Ar 1  8D rr rr             sta     tmp+1
000B1Dr 1  0E rr rr             asl     w_lo
000B20r 1  2E rr rr             rol     w_hi
000B23r 1  0E rr rr             asl     w_lo
000B26r 1  2E rr rr             rol     w_hi
