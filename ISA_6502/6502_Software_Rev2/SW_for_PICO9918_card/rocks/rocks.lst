000735r 1               
000735r 1               hi_title:
000735r 1  A2 07                ldx     #7
000737r 1  A0 16                ldy     #22
000739r 1  20 rr rr             jsr     gotoxy
00073Cr 1  A9 rr                lda     #<hi_txt
00073Er 1  A0 rr                ldy     #>hi_txt
000740r 1  20 rr rr             jsr     print
000743r 1  AD rr rr             lda     hiscore+2
