000DBBr 1  8D rr rr             sta     adot_hi
000DBEr 1  AD rr rr             lda     adot_lo         ; bigger than the best? (signed)
000DC1r 1  CD rr rr             cmp     abv_lo
000DC4r 1  AD rr rr             lda     adot_hi
000DC7r 1  ED rr rr             sbc     abv_hi
000DCAr 1  50 02                bvc     @nv
000DCCr 1  49 80                eor     #$80
000DCEr 1  30 0F        @nv:    bmi     @nb
000DD0r 1  AD rr rr             lda     adot_lo
000DD3r 1  8D rr rr             sta     abv_lo
