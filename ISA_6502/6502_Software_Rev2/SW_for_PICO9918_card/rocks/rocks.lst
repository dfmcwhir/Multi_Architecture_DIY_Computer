000AC4r 1  A9 80                lda     #$80
000AC6r 1  9D rr rr             sta     o_x_lo,x
000AC9r 1  9D rr rr             sta     o_y_lo,x
000ACCr 1  B9 rr rr             lda     sin_tab+8,y
000ACFr 1  20 rr rr             jsr     times5
000AD2r 1  AD rr rr             lda     w_lo
000AD5r 1  18                   clc
000AD6r 1  6D rr rr             adc     o_vx_lo+O_SHIP
000AD9r 1  9D rr rr             sta     o_vx_lo,x
000ADCr 1  AD rr rr             lda     w_hi
000ADFr 1  6D rr rr             adc     o_vx_hi+O_SHIP
000AE2r 1  9D rr rr             sta     o_vx_hi,x
