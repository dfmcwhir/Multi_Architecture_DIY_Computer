000939r 1  B9 rr rr             lda     sin_tab,y
00093Cr 1  20 rr rr             jsr     sext8
00093Fr 1  20 rr rr             jsr     sar3
000942r 1  A2 00                ldx     #O_SHIP
000944r 1  20 rr rr             jsr     add_vy
000947r 1  20 rr rr             jsr     clamp_ship
00094Ar 1  AD rr rr     @fr:    lda     fire_gap
00094Dr 1  F0 03                beq     @f2
00094Fr 1  CE rr rr             dec     fire_gap
000952r 1  AD rr rr     @f2:    lda     fire
