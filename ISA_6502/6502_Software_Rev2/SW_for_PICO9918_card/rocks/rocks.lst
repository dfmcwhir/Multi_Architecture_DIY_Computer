000A98r 1  A9 1C                lda     #BUL_LIFE
000A9Ar 1  9D rr rr             sta     o_t,x
000A9Dr 1  AD rr rr             lda     sdir            ; from the nose, 2.5 pixels a frame + the ship's speed
000AA0r 1  4A                   lsr
000AA1r 1  4A                   lsr
000AA2r 1  4A                   lsr
000AA3r 1  A8                   tay
000AA4r 1  B9 rr rr             lda     sin_tab+8,y     ; nose: 4 pixels out
000AA7r 1  20 rr rr             jsr     nose_ofs
000AAAr 1  18                   clc
000AABr 1  6D rr rr             adc     o_x_hi+O_SHIP
000AAEr 1  20 rr rr             jsr     wrap_x
000AB1r 1  9D rr rr             sta     o_x_hi,x
000AB4r 1  B9 rr rr             lda     sin_tab,y
000AB7r 1  20 rr rr             jsr     nose_ofs
000ABAr 1  18                   clc
000ABBr 1  6D rr rr             adc     o_y_hi+O_SHIP
000ABEr 1  20 rr rr             jsr     wrap_y
