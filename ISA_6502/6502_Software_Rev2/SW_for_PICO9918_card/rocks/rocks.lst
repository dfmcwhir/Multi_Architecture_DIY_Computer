000BA6r 1  E9 50                sbc     #FW/2
000BA8r 1  20 rr rr             jsr     absa
000BABr 1  C9 18                cmp     #24
000BADr 1  B0 0F                bcs     @n
000BAFr 1  BD rr rr             lda     o_y_hi,x
000BB2r 1  38                   sec
000BB3r 1  E9 2E                sbc     #FH/2
000BB5r 1  20 rr rr             jsr     absa
000BB8r 1  C9 14                cmp     #20
000BBAr 1  B0 02                bcs     @n
000BBCr 1  38                   sec
000BBDr 1  60                   rts
000BBEr 1  E8           @n:     inx
