000A68r 1  C9 FF                cmp     #$FF            ;  speed would never stop)
000A6Ar 1  D0 0F                bne     @r
000A6Cr 1  AD rr rr             lda     w_lo
000A6Fr 1  C9 FF                cmp     #$FF
000A71r 1  D0 08                bne     @r
000A73r 1  A9 00                lda     #0
000A75r 1  8D rr rr             sta     w_lo
