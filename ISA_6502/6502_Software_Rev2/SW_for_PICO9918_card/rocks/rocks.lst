000E26r 1  10 11                bpl     @r
000E28r 1  A9 00                lda     #0
000E2Ar 1  38                   sec
000E2Br 1  ED rr rr             sbc     ml
000E2Er 1  8D rr rr             sta     ml
000E31r 1  A9 00                lda     #0
