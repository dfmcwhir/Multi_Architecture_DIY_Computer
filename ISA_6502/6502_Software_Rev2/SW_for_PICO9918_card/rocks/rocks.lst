000B2Cr 1  18                   clc
000B2Dr 1  6D rr rr             adc     tmp
000B30r 1  8D rr rr             sta     w_lo
000B33r 1  AD rr rr             lda     w_hi
000B36r 1  6D rr rr             adc     tmp+1
000B39r 1  8D rr rr             sta     w_hi
000B3Cr 1  0E rr rr             asl     w_lo            ; * 2: s.7 * 10 / 256 * 256 ... = 2.5 px at 127
000B3Fr 1  2E rr rr             rol     w_hi
000B42r 1  AE rr rr             ldx     t5x
000B45r 1  60                   rts
000B46r 1               
000B46r 1               ; A = an x that may be off the field by a little -> back on it
000B46r 1  C9 A0        wrap_x: cmp     #FW
000B48r 1  90 0B                bcc     @r
000B4Ar 1  C9 D0                cmp     #FW + 48
000B4Cr 1  90 04                bcc     @hi
000B4Er 1  18                   clc
