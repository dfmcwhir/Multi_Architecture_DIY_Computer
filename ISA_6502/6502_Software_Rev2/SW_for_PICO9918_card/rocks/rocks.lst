000B76r 1  F0 20                beq     @r
000B78r 1  C9 01                cmp     #1
000B7Ar 1  F0 1C                beq     @r              ; (1: stays, the game is over)
000B7Cr 1  CE rr rr             dec     dead_t
000B7Fr 1  AD rr rr             lda     dead_t
000B82r 1  C9 01                cmp     #1
000B84r 1  D0 12                bne     @r
000B86r 1  AD rr rr             lda     lives
