000685r 1  88                   dey
000686r 1  D0 F4                bne     @c1
000688r 1  AD rr rr             lda     ctrl_def
00068Br 1  8D rr rr             sta     ctrl
00068Er 1  A9 5A                lda     #$5A
000690r 1  8D rr rr             sta     rng
000693r 1                       ; the PICO9918?  (CPU Rev2 ROM: a JMP at $FE1B, SBC_SYSINFO)
000693r 1  AD 1B FE             lda     SBC_SYSINFO
000696r 1  C9 4C                cmp     #$4C
000698r 1  D0 07                bne     @nopico
00069Ar 1  20 1B FE             jsr     SBC_SYSINFO
00069Dr 1  C9 02                cmp     #DISP_PICO
00069Fr 1  F0 10                beq     @pico
0006A1r 1               @nopico:
