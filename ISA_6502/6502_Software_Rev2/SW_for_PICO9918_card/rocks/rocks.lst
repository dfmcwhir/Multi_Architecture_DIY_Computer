000A10r 1               ; v -= v / 64 for object X
000A10r 1               friction:
000A10r 1  BD rr rr             lda     o_vx_lo,x
000A13r 1  8D rr rr             sta     w_lo
000A16r 1  BD rr rr             lda     o_vx_hi,x
000A19r 1  8D rr rr             sta     w_hi
000A1Cr 1  20 rr rr             jsr     sar6
000A1Fr 1  BD rr rr             lda     o_vx_lo,x
000A22r 1  38                   sec
000A23r 1  ED rr rr             sbc     w_lo
000A26r 1  9D rr rr             sta     o_vx_lo,x
000A29r 1  BD rr rr             lda     o_vx_hi,x
000A2Cr 1  ED rr rr             sbc     w_hi
000A2Fr 1  9D rr rr             sta     o_vx_hi,x
000A32r 1  BD rr rr             lda     o_vy_lo,x
000A35r 1  8D rr rr             sta     w_lo
000A38r 1  BD rr rr             lda     o_vy_hi,x
000A3Br 1  8D rr rr             sta     w_hi
000A3Er 1  20 rr rr             jsr     sar6
000A41r 1  BD rr rr             lda     o_vy_lo,x
