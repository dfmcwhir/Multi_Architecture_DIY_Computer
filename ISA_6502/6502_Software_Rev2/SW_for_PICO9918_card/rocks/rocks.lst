000B61r 1  60                   rts
000B62r 1  38           @hi:    sec
000B63r 1  E9 5C                sbc     #FH
000B65r 1  60           @r:     rts
000B66r 1               
000B66r 1               ; the ship blinks while it can't be hit; after a crash it comes back
000B66r 1               ship_life:
000B66r 1  AD rr rr             lda     inv_t
000B69r 1  F0 03                beq     @d
000B6Br 1  CE rr rr             dec     inv_t
000B6Er 1  AD rr rr     @d:     lda     o_kind+O_SHIP
