00095Fr 1  AD rr rr     @hy:    lda     hyper
000962r 1  F0 29                beq     @fric
000964r 1  20 rr rr             jsr     rand            ; hyperspace: somewhere else at random
000967r 1  C9 A0                cmp     #FW
000969r 1  B0 22                bcs     @fric
00096Br 1  8D rr rr             sta     o_x_hi+O_SHIP
00096Er 1  A9 05                lda     #SND_HYPER
000970r 1  20 rr rr             jsr     sfx_snd
000973r 1  20 rr rr     @hr:    jsr     rand
000976r 1  29 7F                and     #$7F
000978r 1  C9 5C                cmp     #FH
00097Ar 1  B0 F7                bcs     @hr
00097Cr 1  8D rr rr             sta     o_y_hi+O_SHIP
00097Fr 1  A9 00                lda     #0
000981r 1  8D rr rr             sta     o_vx_lo+O_SHIP
000984r 1  8D rr rr             sta     o_vx_hi+O_SHIP
000987r 1  8D rr rr             sta     o_vy_lo+O_SHIP
00098Ar 1  8D rr rr             sta     o_vy_hi+O_SHIP
00098Dr 1  A2 00        @fric:  ldx     #O_SHIP         ; friction: v -= v / 64
00098Fr 1  20 rr rr             jsr     friction
000992r 1  60                   rts
000993r 1               
000993r 1               ; w = A sign extended
000993r 1  8D rr rr     sext8:  sta     w_lo            ; (preserves X and Y)
000996r 1  C9 80                cmp     #$80
000998r 1  A9 00                lda     #0
00099Ar 1  90 02                bcc     @p
00099Cr 1  A9 FF                lda     #$FF
00099Er 1  8D rr rr     @p:     sta     w_hi
0009A1r 1  60                   rts
0009A2r 1               ; w = w / 8 (arithmetic)
0009A2r 1  A2 03        sar3:   ldx     #3
0009A4r 1  AD rr rr     @l:     lda     w_hi
0009A7r 1  C9 80                cmp     #$80
0009A9r 1  6E rr rr             ror     w_hi
0009ACr 1  6E rr rr             ror     w_lo
0009AFr 1  CA                   dex
0009B0r 1  D0 F2                bne     @l
0009B2r 1  60                   rts
0009B3r 1  BD rr rr     add_vx: lda     o_vx_lo,x
0009B6r 1  18                   clc
0009B7r 1  6D rr rr             adc     w_lo
