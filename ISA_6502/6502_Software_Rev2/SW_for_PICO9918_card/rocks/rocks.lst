0006AEr 1  4C 06 FE     @bye:   jmp     SBC_MENU
0006B1r 1  20 rr rr     @pico:  jsr     sfx_init
0006B4r 1  AD rr rr             lda     mute_def
0006B7r 1  8D rr rr             sta     sfx_mute
0006BAr 1  20 rr rr             jsr     gfx_init
0006BDr 1               
0006BDr 1  20 rr rr     title:  jsr     sfx_off
0006C0r 1  20 rr rr             jsr     new_screen
0006C3r 1                       ; a few rocks for decoration
0006C3r 1  20 rr rr             jsr     clear_objects
0006C6r 1  A2 00                ldx     #0
0006C8r 1  8E rr rr     @r:     stx     tmp2
0006CBr 1  BD rr rr             lda     deco_x,x
0006CEr 1  8D rr rr             sta     tmp3
0006D1r 1  BD rr rr             lda     deco_y,x
0006D4r 1  A8                   tay
0006D5r 1  BD rr rr             lda     deco_s,x
0006D8r 1  AE rr rr             ldx     tmp3
0006DBr 1  20 rr rr             jsr     add_rock_at
0006DEr 1  AE rr rr             ldx     tmp2
0006E1r 1  E8                   inx
0006E2r 1  E0 05                cpx     #NDECO
0006E4r 1  D0 E2                bne     @r
0006E6r 1  20 rr rr             jsr     frame_draw
0006E9r 1  A9 rr                lda     #<title_txt
0006EBr 1  A0 rr                ldy     #>title_txt
0006EDr 1  20 rr rr             jsr     print
0006F0r 1  20 rr rr             jsr     hi_title
0006F3r 1  20 rr rr             jsr     show_ctrl
0006F6r 1  20 rr rr             jsr     read_pad
0006F9r 1  20 rr rr             jsr     flush_in
0006FCr 1  20 rr rr     @wait:  jsr     menu_key
0006FFr 1  C9 51                cmp     #'Q'
000701r 1  D0 03                bne     @notq
000703r 1  4C rr rr             jmp     exit_game
000706r 1  C9 4D        @notq:  cmp     #'M'            ; sound on / off
000708r 1  D0 06                bne     @notm
00070Ar 1  20 rr rr             jsr     sfx_toggle
00070Dr 1  4C rr rr             jmp     @wait
000710r 1  C9 47        @notm:  cmp     #'G'
000712r 1  D0 0E                bne     @notg
000714r 1  AD rr rr             lda     ctrl
000717r 1  49 01                eor     #1
000719r 1  8D rr rr             sta     ctrl
00071Cr 1  20 rr rr             jsr     show_ctrl
00071Fr 1  4C rr rr             jmp     @wait
000722r 1  C9 80        @notg:  cmp     #PAD_GO
000724r 1  D0 08                bne     @notp
000726r 1  A9 01                lda     #1
000728r 1  8D rr rr             sta     ctrl
