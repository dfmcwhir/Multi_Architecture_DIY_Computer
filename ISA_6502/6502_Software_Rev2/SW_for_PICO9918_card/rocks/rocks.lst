000A7Er 1  BD rr rr     @f:     lda     o_kind,x
000A81r 1  F0 06                beq     @got
000A83r 1  E8                   inx
000A84r 1  E0 05                cpx     #O_BUL+NBUL
000A86r 1  D0 F6                bne     @f
000A88r 1  60                   rts
000A89r 1  A9 04        @got:   lda     #SND_FIRE
