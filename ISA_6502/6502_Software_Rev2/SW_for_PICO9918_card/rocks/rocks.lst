0008F2r 1  8D rr rr             sta     o_vy_hi+O_SHIP
0008F5r 1  8D rr rr             sta     dead_t
0008F8r 1  A9 C0                lda     #192            ; pointing up
0008FAr 1  8D rr rr             sta     sdir
0008FDr 1  A9 32                lda     #INVULN
0008FFr 1  8D rr rr             sta     inv_t
000902r 1  60                   rts
000903r 1               
