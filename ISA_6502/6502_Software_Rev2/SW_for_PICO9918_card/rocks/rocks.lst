00075Er 1               
00075Er 1               ; clear the screen and forget what it showed
00075Er 1               new_screen:
00075Er 1  20 rr rr             jsr     cls
000761r 1  A9 00                lda     #0
000763r 1  AA                   tax
000764r 1  9D rr rr 9D  @c:     .repeat 8, K
000768r 1  rr rr 9D rr  
00076Cr 1  rr 9D rr rr  
000794r 1                       sta     fb + K * 256,x
000794r 1                       sta     sb + K * 256,x
000794r 1                       .endrepeat
000794r 1  E8                   inx
000795r 1  D0 CD                bne     @c
000797r 1  A2 16                ldx     #FROWS-1
000799r 1  9D rr rr     @d:     sta     rd_lo,x
00079Cr 1  9D rr rr             sta     rd_hi,x
00079Fr 1  9D rr rr             sta     rp_lo,x
0007A2r 1  9D rr rr             sta     rp_hi,x
0007A5r 1  CA                   dex
0007A6r 1  10 F1                bpl     @d
0007A8r 1  60                   rts
0007A9r 1               
0007A9r 1               ; ============================================================================
0007A9r 1               ; a game
0007A9r 1               ; ============================================================================
0007A9r 1               new_game:
0007A9r 1  A9 00                lda     #0
0007ABr 1  8D rr rr             sta     score
0007AEr 1  8D rr rr             sta     score+1
0007B1r 1  8D rr rr             sta     score+2
0007B4r 1  8D rr rr             sta     wave
0007B7r 1  8D rr rr             sta     quit
0007BAr 1  A9 03                lda     #3
0007BCr 1  8D rr rr             sta     lives
0007BFr 1  A9 00                lda     #0
0007C1r 1  8D rr rr             sta     ufo_wait
0007C4r 1  A9 5A                lda     #90             ; the first saucer comes after a while
0007C6r 1  8D rr rr             sta     ufo_next
0007C9r 1  20 rr rr             jsr     new_screen
0007CCr 1  A9 rr                lda     #<status_txt
0007CEr 1  A0 rr                ldy     #>status_txt
0007D0r 1  20 rr rr             jsr     print
0007D3r 1  20 rr rr             jsr     clear_objects
0007D6r 1  20 rr rr             jsr     spawn_ship
0007D9r 1  20 2D FE             jsr     SBC_TICKS       ; (the pace counts from here)
0007DCr 1  8D rr rr             sta     last_tick
0007DFr 1               new_wave:
0007DFr 1  EE rr rr             inc     wave
0007E2r 1  AD rr rr             lda     wave            ; 3 + wave big rocks, up to 8
0007E5r 1  18                   clc
0007E6r 1  69 03                adc     #3
0007E8r 1  C9 09                cmp     #9
0007EAr 1  90 02                bcc     @n
0007ECr 1  A9 08                lda     #8
0007EEr 1  8D rr rr     @n:     sta     tmp2
0007F1r 1  20 rr rr     @r:     jsr     rand            ; along the left or top edge, away from the ship
0007F4r 1  29 01                and     #1
0007F6r 1  F0 0D                beq     @left
0007F8r 1  20 rr rr             jsr     rand
0007FBr 1  C9 A0                cmp     #FW
0007FDr 1  B0 F2                bcs     @r
0007FFr 1  AA                   tax
000800r 1  A0 00                ldy     #0
000802r 1  4C rr rr             jmp     @add
000805r 1  20 rr rr     @left:  jsr     rand
000808r 1  29 7F                and     #$7F
00080Ar 1  C9 5C                cmp     #FH
00080Cr 1  B0 F7                bcs     @left
00080Er 1  A8                   tay
00080Fr 1  A2 00                ldx     #0
000811r 1  A9 00        @add:   lda     #0              ; big
000813r 1  20 rr rr             jsr     add_rock_at
000816r 1  CE rr rr             dec     tmp2
000819r 1  D0 D6                bne     @r
00081Br 1  A9 01                lda     #1
00081Dr 1  8D rr rr             sta     hud_dirty
000820r 1  8D rr rr             sta     beat_t          ; the heartbeat: slow again
000823r 1  A9 12                lda     #BEAT_SLOW
000825r 1  8D rr rr             sta     beat_gap
000828r 1  A9 00                lda     #0
00082Ar 1  8D rr rr             sta     wave_t
00082Dr 1  AD rr rr             lda     o_kind+O_SHIP   ; (the ship gets a moment to see them)
000830r 1  F0 05                beq     game_loop
000832r 1  A9 1E                lda     #30
000834r 1  8D rr rr             sta     inv_t
000837r 1               
000837r 1               ; ---- the frame loop --------------------------------------------------------------
000837r 1               game_loop:
000837r 1  20 rr rr             jsr     sfx_poll
00083Ar 1  20 rr rr             jsr     read_input
00083Dr 1  AD rr rr             lda     quit
000840r 1  F0 03                beq     @1
000842r 1  4C rr rr             jmp     title
000845r 1  20 rr rr     @1:     jsr     ship_control
000848r 1  20 rr rr             jsr     ufo_update
00084Br 1  20 rr rr             jsr     move_all
00084Er 1  20 rr rr             jsr     collide
000851r 1  20 rr rr             jsr     ship_life
000854r 1  20 rr rr             jsr     frame_draw
000857r 1  20 rr rr             jsr     hud_update
00085Ar 1  AD rr rr             lda     dead_t          ; game over?
00085Dr 1  C9 01                cmp     #1
00085Fr 1  D0 08                bne     @2
000861r 1  AD rr rr             lda     lives
000864r 1  D0 03                bne     @2
000866r 1  4C rr rr             jmp     game_over
000869r 1  20 rr rr     @2:     jsr     snd_frame
00086Cr 1  20 rr rr             jsr     wave_check
00086Fr 1  20 rr rr             jsr     pace
000872r 1  EE rr rr             inc     frame
000875r 1  4C rr rr             jmp     game_loop
000878r 1               
000878r 1               ; ---- the sounds that go on: the engine, the saucer's hum, the heartbeat ----
000878r 1               snd_frame:
000878r 1  AD rr rr             lda     flame           ; thrust: its rumble, every frame
00087Br 1  F0 05                beq     @nt
00087Dr 1  A9 06                lda     #SND_THRUST
00087Fr 1  20 rr rr             jsr     sfx_snd
000882r 1  AD rr rr     @nt:    lda     o_kind+O_UFO    ; a saucer: its hum (big or small)
000885r 1  C9 05                cmp     #K_UFO
000887r 1  D0 14                bne     @nu
000889r 1  AD rr rr             lda     ufo_hum
00088Cr 1  D0 1E                bne     @beat
00088Er 1  EE rr rr             inc     ufo_hum
000891r 1  AD rr rr             lda     o_size+O_UFO
000894r 1  18                   clc
000895r 1  69 02                adc     #SND_UFOBIG
000897r 1  20 rr rr             jsr     sfx_snd
00089Ar 1  4C rr rr             jmp     @beat
00089Dr 1  AD rr rr     @nu:    lda     ufo_hum
0008A0r 1  F0 0A                beq     @beat
0008A2r 1  A9 00                lda     #0
0008A4r 1  8D rr rr             sta     ufo_hum
0008A7r 1  A2 01                ldx     #1
0008A9r 1  20 rr rr             jsr     sfx_stop
0008ACr 1  AD rr rr     @beat:  lda     wave_t          ; the heartbeat, while there are rocks: it
0008AFr 1  D0 20                bne     @r              ; gets faster as the wave goes on
0008B1r 1  CE rr rr             dec     beat_t
0008B4r 1  D0 1B                bne     @r
0008B6r 1  AD rr rr             lda     beat_gap
0008B9r 1  8D rr rr             sta     beat_t
0008BCr 1  C9 07                cmp     #BEAT_FAST+1
0008BEr 1  90 03                bcc     @b
0008C0r 1  CE rr rr             dec     beat_gap
0008C3r 1  AD rr rr     @b:     lda     beat_n
0008C6r 1  49 01                eor     #1
0008C8r 1  8D rr rr             sta     beat_n
0008CBr 1  18                   clc
0008CCr 1  69 00                adc     #SND_BEAT1
0008CEr 1  4C rr rr             jmp     sfx_snd
0008D1r 1  60           @r:     rts
0008D2r 1               BEAT_SLOW       = 18            ; frames between beats at the start of a wave
0008D2r 1               BEAT_FAST       = 6             ; ... at the quickest
0008D2r 1               
0008D2r 1               ; ---- the ship ---------------------------------------------------------------------
0008D2r 1               spawn_ship:
0008D2r 1  A9 01                lda     #K_SHIP
0008D4r 1  8D rr rr             sta     o_kind+O_SHIP
