000BC1r 1  D0 D8                bne     @l
000BC3r 1  18                   clc
000BC4r 1  60                   rts
000BC5r 1               
000BC5r 1  10 05        absa:   bpl     @r
000BC7r 1  49 FF                eor     #$FF
000BC9r 1  18                   clc
000BCAr 1  69 01                adc     #1
000BCCr 1  60           @r:     rts
000BCDr 1               
000BCDr 1               ; ---- the saucer -------------------------------------------------------------------
000BCDr 1               ; Now and then (while the ship is out) a saucer crosses the field from one
000BCDr 1               ; side, drifting up and down, and shoots: the big one anywhere, the small one
000BCDr 1               ; (from wave 3, or 10000 points) at the ship.
000BCDr 1               ufo_update:
000BCDr 1  AD rr rr             lda     o_kind+O_UFO
000BD0r 1  C9 05                cmp     #K_UFO
000BD2r 1  F0 1B                beq     @on
000BD4r 1  AD rr rr             lda     o_kind+O_SHIP   ; none: count towards the next one
000BD7r 1  F0 15                beq     @r
000BD9r 1  AD rr rr             lda     frame
000BDCr 1  29 03                and     #3
000BDEr 1  D0 0E                bne     @r
000BE0r 1  EE rr rr             inc     ufo_wait
000BE3r 1  AD rr rr             lda     ufo_wait
000BE6r 1  CD rr rr             cmp     ufo_next
000BE9r 1  90 03                bcc     @r
000BEBr 1  4C rr rr             jmp     ufo_start
000BEEr 1  60           @r:     rts
000BEFr 1  AD rr rr     @on:    lda     frame           ; a new up / down drift now and then
000BF2r 1  29 1F                and     #31
000BF4r 1  D0 12                bne     @f
000BF6r 1  20 rr rr             jsr     rand
000BF9r 1  29 03                and     #3
000BFBr 1  AA                   tax
000BFCr 1  BD rr rr             lda     drift_lo,x
000BFFr 1  8D rr rr             sta     o_vy_lo+O_UFO
000C02r 1  BD rr rr             lda     drift_hi,x
000C05r 1  8D rr rr             sta     o_vy_hi+O_UFO
000C08r 1  CE rr rr     @f:     dec     ufo_fire
000C0Br 1  D0 E1                bne     @r
000C0Dr 1  AE rr rr             ldx     o_size+O_UFO
000C10r 1  BD rr rr             lda     ufo_gap,x
000C13r 1  8D rr rr             sta     ufo_fire
000C16r 1  4C rr rr             jmp     ufo_shoot
000C19r 1               
000C19r 1               ufo_start:
000C19r 1  A9 00                lda     #0
000C1Br 1  8D rr rr             sta     ufo_wait
000C1Er 1  20 rr rr             jsr     rand            ; the next one in 64-127 x 4 frames
000C21r 1  29 3F                and     #63
000C23r 1  09 40                ora     #64
000C25r 1  8D rr rr             sta     ufo_next
000C28r 1  A2 00                ldx     #0              ; big, or small?
000C2Ar 1  AD rr rr             lda     score+2
000C2Dr 1  D0 07                bne     @maybe          ; 10000 points or more
000C2Fr 1  AD rr rr             lda     wave
000C32r 1  C9 03                cmp     #3
000C34r 1  90 08                bcc     @size
000C36r 1  20 rr rr     @maybe: jsr     rand
000C39r 1  C9 6E                cmp     #110
000C3Br 1  B0 01                bcs     @size
000C3Dr 1  E8                   inx
000C3Er 1  8E rr rr     @size:  stx     o_size+O_UFO
000C41r 1  A9 05                lda     #K_UFO
000C43r 1  8D rr rr             sta     o_kind+O_UFO
000C46r 1  8A                   txa
000C47r 1  18                   clc
000C48r 1  69 49                adc     #SH_UFO_BIG
000C4Ar 1  8D rr rr             sta     o_shape+O_UFO
000C4Dr 1  BD rr rr             lda     ufo_life,x      ; frames to cross the field
000C50r 1  8D rr rr             sta     o_t+O_UFO
000C53r 1  BD rr rr             lda     ufo_gap,x
000C56r 1  8D rr rr             sta     ufo_fire
000C59r 1  BD rr rr             lda     ufo_spd,x       ; speed (fraction of a pixel a frame, or 1)
000C5Cr 1  8D rr rr             sta     tmp2
000C5Fr 1  A9 00                lda     #0
000C61r 1  8D rr rr             sta     o_x_lo+O_UFO
000C64r 1  8D rr rr             sta     o_y_lo+O_UFO
000C67r 1  8D rr rr             sta     o_vy_lo+O_UFO
000C6Ar 1  8D rr rr             sta     o_vy_hi+O_UFO
000C6Dr 1  20 rr rr             jsr     rand            ; which side
000C70r 1  29 01                and     #1
000C72r 1  F0 1D                beq     @left
000C74r 1  A9 9F                lda     #FW-1           ; from the right, going left
000C76r 1  8D rr rr             sta     o_x_hi+O_UFO
000C79r 1  A9 00                lda     #0
000C7Br 1  38                   sec
000C7Cr 1  ED rr rr             sbc     tmp2
000C7Fr 1  8D rr rr             sta     o_vx_lo+O_UFO
000C82r 1  A9 FF                lda     #$FF
000C84r 1  AE rr rr             ldx     tmp2
000C87r 1  D0 02                bne     @vh
000C89r 1  A9 FF                lda     #$FF            ; (speed 1: -1.0)
000C8Br 1  8D rr rr     @vh:    sta     o_vx_hi+O_UFO
000C8Er 1  4C rr rr             jmp     @y
000C91r 1  A9 00        @left:  lda     #0
000C93r 1  8D rr rr             sta     o_x_hi+O_UFO
000C96r 1  AD rr rr             lda     tmp2
000C99r 1  8D rr rr             sta     o_vx_lo+O_UFO
000C9Cr 1  A9 00                lda     #0
000C9Er 1  AE rr rr             ldx     tmp2
000CA1r 1  D0 02                bne     @vl
000CA3r 1  A9 01                lda     #1              ; (speed 1: +1.0)
000CA5r 1  8D rr rr     @vl:    sta     o_vx_hi+O_UFO
000CA8r 1  20 rr rr     @y:     jsr     rand            ; a height away from the very edges
000CABr 1  29 7F                and     #$7F
000CADr 1  C9 4C                cmp     #FH-16
000CAFr 1  B0 F7                bcs     @y
000CB1r 1  69 08                adc     #8
000CB3r 1  8D rr rr             sta     o_y_hi+O_UFO
000CB6r 1  60                   rts
000CB7r 1               
000CB7r 1               ; the saucer fires a bullet: 2 pixels a frame for 30 frames
000CB7r 1               ufo_shoot:
000CB7r 1  A2 2E                ldx     #O_EB
000CB9r 1  BD rr rr     @f:     lda     o_kind,x
000CBCr 1  F0 06                beq     @got
000CBEr 1  E8                   inx
000CBFr 1  E0 30                cpx     #O_EB+NEB
000CC1r 1  D0 F6                bne     @f
000CC3r 1  60                   rts
000CC4r 1  8E rr rr     @got:   stx     ebx
000CC7r 1  AD rr rr             lda     o_size+O_UFO    ; big: any way; small: at the ship
000CCAr 1  F0 29                beq     @rnd
000CCCr 1  AD rr rr             lda     o_kind+O_SHIP
000CCFr 1  F0 24                beq     @rnd
000CD1r 1  20 rr rr             jsr     aim
000CD4r 1  8D rr rr             sta     tmp2
000CD7r 1  AD rr rr             lda     wave            ; a little off before wave 6
000CDAr 1  C9 06                cmp     #6
000CDCr 1  B0 1F                bcs     @dir
000CDEr 1  20 rr rr             jsr     rand
000CE1r 1  29 03                and     #3
000CE3r 1  38                   sec
000CE4r 1  E9 01                sbc     #1              ; -1 .. 2 -> mostly -1 .. 1
000CE6r 1  C9 02                cmp     #2
000CE8r 1  D0 02                bne     @j
000CEAr 1  A9 00                lda     #0
000CECr 1  18           @j:     clc
000CEDr 1  6D rr rr             adc     tmp2
000CF0r 1  29 1F                and     #NDIR-1
000CF2r 1  4C rr rr             jmp     @dir2
000CF5r 1  20 rr rr     @rnd:   jsr     rand
000CF8r 1  29 1F                and     #NDIR-1
000CFAr 1  4C rr rr             jmp     @dir2
000CFDr 1  AD rr rr     @dir:   lda     tmp2
000D00r 1  A8           @dir2:  tay
000D01r 1  AE rr rr             ldx     ebx
000D04r 1  A9 06                lda     #K_EBUL
000D06r 1  9D rr rr             sta     o_kind,x
000D09r 1  A9 1E                lda     #30
000D0Br 1  9D rr rr             sta     o_t,x
000D0Er 1  AD rr rr             lda     o_x_hi+O_UFO
000D11r 1  9D rr rr             sta     o_x_hi,x
000D14r 1  AD rr rr             lda     o_y_hi+O_UFO
000D17r 1  9D rr rr             sta     o_y_hi,x
000D1Ar 1  A9 80                lda     #$80
000D1Cr 1  9D rr rr             sta     o_x_lo,x
000D1Fr 1  9D rr rr             sta     o_y_lo,x
000D22r 1  B9 rr rr             lda     sin_tab+8,y     ; v = (cos, sin) * 4 / 256 * 128 ~ 2 pixels
000D25r 1  20 rr rr             jsr     times4
000D28r 1  9D rr rr             sta     o_vx_lo,x
000D2Br 1  AD rr rr             lda     w_hi
000D2Er 1  9D rr rr             sta     o_vx_hi,x
000D31r 1  B9 rr rr             lda     sin_tab,y
