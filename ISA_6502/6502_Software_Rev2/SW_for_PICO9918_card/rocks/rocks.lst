000677r 1  A9 00                lda     #0              ; clear the variables (RAM is random at power-up)
000679r 1  AA                   tax
00067Ar 1  A0 04                ldy     #>(bss_end - bss_start + $FF)
00067Cr 1  9D rr rr     @c1:    sta     bss_start,x
00067Fr 1  E8                   inx
000680r 1  D0 FA                bne     @c1
