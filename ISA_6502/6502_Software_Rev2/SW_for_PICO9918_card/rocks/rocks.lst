0009D4r 1  6D rr rr             adc     w_hi
0009D7r 1  9D rr rr             sta     o_vy_hi,x
0009DAr 1  60                   rts
0009DBr 1               
0009DBr 1               ; keep the ship's speed under 2 pixels a frame in each direction
0009DBr 1               clamp_ship:
0009DBr 1  AD rr rr             lda     o_vx_hi+O_SHIP
0009DEr 1  20 rr rr             jsr     @c
0009E1r 1  8D rr rr             sta     o_vx_hi+O_SHIP
