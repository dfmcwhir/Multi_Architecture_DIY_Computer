000DDFr 1  88           @nb:    dey
000DE0r 1  10 AB                bpl     @d
000DE2r 1  AD rr rr             lda     abest
000DE5r 1  60                   rts
000DE6r 1               
000DE6r 1               ; mh:ml = A * X, both signed.  Preserves Y.
