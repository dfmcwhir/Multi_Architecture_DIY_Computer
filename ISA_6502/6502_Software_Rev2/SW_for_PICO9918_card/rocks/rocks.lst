000D90r 1  AE rr rr             ldx     adx
000D93r 1  20 rr rr             jsr     smul8
000D96r 1  AD rr rr             lda     ml
000D99r 1  8D rr rr             sta     adot_lo
000D9Cr 1  AD rr rr             lda     mh
000D9Fr 1  8D rr rr             sta     adot_hi
000DA2r 1  B9 rr rr             lda     sin_tab,y       ; + dy * sin
000DA5r 1  AE rr rr             ldx     ady
000DA8r 1  20 rr rr             jsr     smul8
000DABr 1  AD rr rr             lda     ml
000DAEr 1  18                   clc
000DAFr 1  6D rr rr             adc     adot_lo
000DB2r 1  8D rr rr             sta     adot_lo
000DB5r 1  AD rr rr             lda     mh
