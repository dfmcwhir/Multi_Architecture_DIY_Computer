000F48r 1  AD rr rr     @row:   lda     tmp3
000F4Br 1  18                   clc
000F4Cr 1  69 rr                adc     #>map
000F4Er 1  8D rr rr             sta     @wr+2
000F51r 1  A2 00                ldx     #0              ; map column
000F53r 1  20 rr rr     @run:   jsr     @get
000F56r 1  F0 0D                beq     @nrow
000F58r 1  A8                   tay                     ; count
000F59r 1  20 rr rr             jsr     @get            ; tile
000F5Cr 1  9D rr rr     @wr:    sta     map,x
