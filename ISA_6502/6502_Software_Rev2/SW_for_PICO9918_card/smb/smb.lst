000000r 1               ; ============================================================================
000000r 1               ; smb.s - SUPER MOS BROS. for the 6502 SBC, CPU Rev2, on the PICO9918 card
000000r 1               ;
000000r 1               ;   build:  make.bat  (ca65 -I .. smb.s, ld65 -C smb.cfg)
000000r 1               ;   run:    L SMB 0800   then  R       (WORLD1.SMB ... WORLD5.SMB on the drive)
000000r 1               ;
000000r 1               ; Header (patchable from the monitor):
000000r 1               ;   $0800  JMP start
000000r 1               ;   $0803  speed      frames (1/60 s) per game frame: 3 = 20 a second, the
000000r 1               ;                     speed the game was made for
000000r 1               ;   $0804  controls   at start: 0 keyboard, 1 gamepad
000000r 1               ;   $0805  (spare)
000000r 1               ;   $0806  sound      at start: 0 on, 1 off
000000r 1               ;
000000r 1               ; The game (MOS, the objects, the levels, the sound) is the PIC32 version's;
000000r 1               ; the drawing is new, for the PICO9918 in its F18A mode:
000000r 1               ;   - everything is drawn at the screen's full resolution, in the F18A's
000000r 1               ;     enhanced colour mode ECM2: each tile and each sprite has 3 colours of
000000r 1               ;     its own (art_hd.py, gen_pico.py -> smb_pico.inc).
000000r 1               ;   - tile layer 1 (Graphics I): the level: a tile (8 x 8 game pixels) is
000000r 1               ;     2 x 2 cells of 16 x 16 pixels of art.  Two name table pages side by
000000r 1               ;     side make a ring 32 tiles wide; it scrolls smoothly with the hardware
000000r 1               ;     scroll (R27, and the page bit in R2), and only the tile columns coming
000000r 1               ;     into view are written.  11 tile rows = cell rows 2-23.
000000r 1               ;   - tile layer 2, on top: the status lines (cell rows 0-1) and the texts;
000000r 1               ;     everything else on it is pattern 0, see-through.
000000r 1               ;   - the sprites: 16 x 16, each picture cut into parts (MOS: a second layer
000000r 1               ;     for his hair, eyes and shoes); mirrored with the F18A's flip bit.  Each
000000r 1               ;     hardware sprite has its own pattern: a part is copied into it when
000000r 1               ;     that sprite's part changes.
000000r 1               ;   A game pixel is 2 x 2 screen pixels; the view is 128 x 88 game pixels.
000000r 1               ; No zero page is used.
000000r 1               ; ============================================================================
000000r 1               
000000r 1                       .setcpu "6502"
000000r 1                       .include "sbc_api.inc"
000000r 2               ; sbc_api.inc - fixed ROM entry points of the SBC (see jumptable.s), and the
000000r 2               ; CPU clock.  Use in your own ca65 programs:  .include "sbc_api.inc"
000000r 2               ; (the games find it one folder up: their make.bat passes  -I ..  to ca65)
000000r 2               SBC_CHRIN       = $FE00         ; carry set + A = char, carry clear = none waiting
000000r 2               SBC_CHROUT      = $FE03         ; print A (A, X, Y preserved)
000000r 2               SBC_MENU        = $FE06         ; boot menu
000000r 2               SBC_COLD        = $FE09         ; BASIC cold start
000000r 2               SBC_WARM        = $FE0C         ; BASIC warm start
000000r 2               SBC_MONITOR     = $FE0F         ; monitor prompt (or JMP $FF00)
000000r 2               SBC_PADSTATE    = $FE12         ; A = gamepad buttons held: bit0 A,1 B,2 Select,3 Start,4 Up,5 Down,6 Left,7 Right
000000r 2               SBC_LOAD        = $FE15         ; load a file from the current device (U: or C:): A/Y = parameter block (.word addr, .word max, "NAME.EXT",0)
000000r 2                                               ;   carry clear = loaded, X/Y = length; carry set = failed, A = error code
000000r 2               SBC_CWD         = $FE18         ; A/Y = the monitor's current folder: 0-ended, "" (the top) or "/A/B"
000000r 2                                               ;   (newer ROMs: check for a JMP ($4C) at $FE18 first)
000000r 2               
000000r 2               ; ---- CPU Rev2 ROMs (API version 2).  Check first:  LDA $FE1B / CMP #$4C,
000000r 2               ;      then JSR SBC_SYSINFO and check Y >= 2.
000000r 2               SBC_SYSINFO     = $FE1B         ; A = display type (DISP_...), X = device status, Y = API version
000000r 2               SBC_SEROUT      = $FE1E         ; send A out of the serial console port (A, X, Y preserved)
000000r 2               SBC_MOUSEON     = $FE21         ; A = 1 mouse reports on, 0 off (off at reset); C=1 = no mouse
000000r 2               SBC_MOUSE       = $FE24         ; A = buttons (bit0 L, 1 R, 2 M), X/Y = signed movement since
000000r 2                                               ;   the last call (right/down +); C=1 = a report arrived
000000r 2               SBC_BANKSET     = $FE27         ; A = RAM bank 0-15 for $1000-$7EFF (X, Y kept).  Your code that
000000r 2                                               ;   calls it must be in $0000-$0FFF, or it switches itself out!
000000r 2               SBC_BANKGET     = $FE2A         ; A = bank selected, X = number of banks fitted
000000r 2               SBC_TICKS       = $FE2D         ; A/X/Y = 60 Hz counter, low/middle/high
000000r 2               SBC_ACIAIN      = $FE30         ; serial card 6551: C=1 + A = byte, C=0 none
000000r 2               SBC_ACIAOUT     = $FE33         ; serial card 6551: send A (A, X, Y preserved)
000000r 2               SBC_VSYNC       = $FE36         ; C=1 if a frame ended since the last call (PICO9918 / ESP32_VGA),
000000r 2                                               ;   A = the VDP status / ESP32 STATUS
000000r 2               SBC_CONRESET    = $FE39         ; display back to the text console, cleared (call it when
000000r 2                                               ;   your game exits after changing the display mode)
000000r 2               SBC_SNDNOTE     = $FE3C         ; A/Y -> 5 bytes: voice (AY 0-2, ESP32 0-3), note (0-95, 36 = C4),
000000r 2                                               ;   volume (0-15; AY 16 = envelope), time (16 bit, 1/60 s,
000000r 2                                               ;   0 = hold).  Doesn't wait.  C=1 = bad values
000000r 2               SBC_SNDQUIET    = $FE3F         ; all sound off
000000r 2               SBC_SNDBUSY     = $FE42         ; A = voice: C=1 while its timed note is still playing
000000r 2               SBC_SAY         = $FE45         ; A/Y -> SPO256 allophones (0-63) ended by $FF; queued
000000r 2               SBC_SAYBUSY     = $FE48         ; C=1 while the SPO256 is speaking
000000r 2               SBC_AYREAD      = $FE4B         ; X = AY register (14/15 = I/O ports A/B) -> A
000000r 2               SBC_AYWRITE     = $FE4E         ; AY register X = A (register 7 bits 6/7 = ports A/B output)
000000r 2               SBC_TIME        = $FE51         ; A/Y -> 18 byte buffer <- "mm/dd/yy hh:mm:ss",0 (CF card's DS1302);
000000r 2                                               ;   C=1 = no clock
000000r 2               SBC_SETTIME     = $FE54         ; A/Y -> 14 characters "dwyymmddHHMMSS" (dw 01 = Sunday)
000000r 2               SBC_DISPTYPE    = $FEFF         ; a byte: the display type (DISP_...)
000000r 2               
000000r 2               ; SBC_SYSINFO display types
000000r 2               DISP_NONE       = 0
000000r 2               DISP_TERM       = 1             ; KB_MONITOR_TERM (PIC32 terminal)
000000r 2               DISP_PICO       = 2             ; PICO9918
000000r 2               DISP_ESP32      = 3             ; ESP32_VGA
000000r 2               
000000r 2               ; SBC_SYSINFO device status bits (X)
000000r 2               DEV_VIA         = $01
000000r 2               DEV_ACIA        = $02
000000r 2               DEV_DISPLAY     = $04
000000r 2               DEV_AVRKBD      = $08
000000r 2               
000000r 2               ; Key codes from the AVR keyboard interface (Serial Rev3 / PICO9918 card)
000000r 2               KEY_UP          = $05           ; ^E  (WordStar)
000000r 2               KEY_DOWN        = $18           ; ^X
000000r 2               KEY_LEFT        = $10           ; ^P
000000r 2               KEY_RIGHT       = $04           ; ^D
000000r 2               KEY_ESC         = $03           ; Esc sends ^C
000000r 2               KEY_F1          = 129           ; F1-F12 = 129-140, shifted 141-152
000000r 2               
000000r 2               ; First RAM address for loaded programs (CPU Rev2 ROM)
000000r 2               SBC_USER_RAM    = $0800
000000r 2               
000000r 2               ; The CPU clock in MHz (whole numbers, 1 to 8).  Programs size their delay
000000r 2               ; loops from it, so a millisecond stays a millisecond.  To build for another
000000r 2               ; clock, change it here or give it on the command line:  make.bat 1
000000r 2               .ifndef CLOCK_MHZ
000000r 2               CLOCK_MHZ       = 2
000000r 2               .endif
000000r 2               
000000r 1               
000000r 1               SPEED_DEFAULT   = 3             ; frames per game frame
000000r 1               
000000r 1               ; ---- VRAM -----------------------------------------------------------------------
000000r 1               V_TP0           = $0000         ; tile patterns (both layers), plane 0
000000r 1               V_TP1           = $0800         ;   plane 1
000000r 1               V_SP0           = $1000         ; sprite patterns, plane 0: sprite k at names 4 k
000000r 1               V_SP1           = $1400         ;   plane 1 (1K on: R29's SPGS = 01)
000000r 1               V_NAME1         = $1800         ; layer 1 names: pages $1800 and $1C00
000000r 1               V_NAME2         = $2000         ; layer 2 names
000000r 1               V_ATT1          = $2300         ; layer 1 attributes (one a pattern)
000000r 1               V_ATT2          = $2400         ; layer 2 attributes
000000r 1               V_SATTR         = $2500         ; sprite attributes
000000r 1               VDP_NAME        = V_NAME2       ; (vdp_at, vdp_puts: layer 2, the texts)
000000r 1               MAXSPR          = 31            ; hardware sprites used at most
000000r 1               
000000r 1               ; ---- the view ----------------------------------------------------------------------
000000r 1               MAPROWS         = 11
000000r 1               VIEW_H          = 88            ; game pixels
000000r 1               VIEW_W          = 128           ; game pixels (16 tiles)
000000r 1               VIEW_T          = 16            ; tiles across
000000r 1               VIEW_COLS       = VIEW_W / 2    ; in the old "characters" (2 game pixels):
000000r 1                                               ; the game keeps scroll in those
000000r 1               TOP_Y           = 16            ; screen y of the view's top (2 status rows)
000000r 1               LOADMAX         = 16 * 256      ; the world file buffer (wc)
000000r 1               
000000r 1               ; ---- objects -----------------------------------------------------------------------
000000r 1               NOBJ            = 10
000000r 1               O_MOS           = 0
000000r 1               O_FIRST         = 1             ; 1-6: enemies, shells, mushrooms, the dragon, its fire
000000r 1               O_LAST          = 6
000000r 1               O_COIN          = 7             ; a coin popping out of a block
000000r 1               O_FIRE          = 8             ; 8-9: MOS's electrons
000000r 1               K_NONE          = 0
000000r 1               K_MOS           = 1
000000r 1               K_BUG           = 2             ; an AND gate
000000r 1               K_FLAT          = 3             ; a squashed one (for a moment)
000000r 1               K_SHELLY        = 4             ; an OR gate
000000r 1               K_SHELL         = 5             ; ... pulled in
000000r 1               K_MUSH          = 6
000000r 1               K_COIN          = 7
000000r 1               K_ONEUP         = 8             ; the mushroom from a hidden block
000000r 1               K_FLOWER        = 9
000000r 1               K_FIRE          = 10            ; an electron
000000r 1               K_DRAGON        = 11            ; KIL
000000r 1               K_BREATH        = 12            ; its fire
000000r 1               K_OC            = 13            ; the overclock device
000000r 1               K_FISH          = 14            ; a gate swimming on its side (liquid cooling)
000000r 1               K_FAN           = 15            ; a flying fan
000000r 1               K_CLOUD         = 16            ; the cloud: it throws gates down
000000r 1               K_PRINCESS      = 17            ; Princess Graphics Card
000000r 1               REVIVE          = 160           ; frames before a still shell walks again
000000r 1               FAN_TOP         = 12            ; how high the high fans fly
000000r 1               FISH_V          = $0100         ; how fast the fish swim
000000r 1               
000000r 1               ; MOS's states
000000r 1               MS_PLAY         = 0
000000r 1               MS_FLAG         = 1             ; sliding down the pole
000000r 1               MS_WALK         = 2             ; walking to the castle
000000r 1               MS_IN           = 3             ; in the castle: time bonus
000000r 1               MS_DEAD         = 4
000000r 1               MS_RESET        = 5             ; pressed RESET: the bridge falls
000000r 1               MS_PIPE         = 6             ; going down a pipe
000000r 1               MS_RESCUE       = 7             ; found the princess
000000r 1               
000000r 1               ; ---- physics (8.8 pixels per frame) -------------------------------------------------
000000r 1               WALK_MAX        = $01C0
000000r 1               RUN_MAX         = $0300
000000r 1               ACCEL           = $0020
000000r 1               DECEL           = $0020
000000r 1               SKID            = $0048
000000r 1               JUMP_V          = $0600         ; + speed / 8
000000r 1               GRAV_HOLD       = $0080         ; rising with jump held
000000r 1               GRAV            = $0180
000000r 1               MAX_FALL        = $0600
000000r 1               STOMP_V         = $0480
000000r 1               BUG_V           = $00A0
000000r 1               SHELL_V         = $0300
000000r 1               MUSH_V          = $00C0
000000r 1               OBJ_GRAV        = $0100
000000r 1               INVULN          = 60            ; frames after shrinking
000000r 1               FIRE_V          = $0380         ; electrons: across
000000r 1               FIRE_BOUNCE     = $0280         ; ... up, when they bounce
000000r 1               FIRE_GRAV       = $0060
000000r 1               DRAGON_HP       = 5
000000r 1               OC_TIME         = 200           ; frames of overclock (10 s)
000000r 1               SWIM_V          = $0180         ; under the coolant: a stroke
000000r 1               GRAV_W          = $0018
000000r 1               MAX_FALL_W      = $0100
000000r 1               WATER_MAX       = $0100         ; ... and the most speed across
000000r 1               TIME_TICK       = 9             ; frames per unit of the timer (about 0.4 s)
000000r 1               SOUND           = 1
000000r 1               
000000r 1               ; ============================================================================
