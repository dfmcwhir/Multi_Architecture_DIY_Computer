000EBAr 1               
000EBAr 1               ; ---- the levels -------------------------------------------------------------------
000EBAr 1               ; every world is a file, WORLDn.SMB (n: wsrc), loaded with SBC_LOAD into wc
000EBAr 1               ; (free until the level starts) each time one of its levels starts.
000EBAr 1               ; Carry set if it can't be had (no SBC_LOAD in the ROM, no file, not a world,
000EBAr 1               ; no level lvl in it).
000EBAr 1               get_world:
000EBAr 1  AD rr rr             lda     wsrc
000EBDr 1  C9 0A                cmp     #10
000EBFr 1  B0 36                bcs     @fail
000EC1r 1  AD 15 FE             lda     SBC_LOAD        ; a JMP there: the ROM has SBC_LOAD
000EC4r 1  C9 4C                cmp     #$4C
000EC6r 1  D0 2F                bne     @fail
000EC8r 1  AD rr rr             lda     wsrc
000ECBr 1  09 30                ora     #'0'
000ECDr 1  8D rr rr             sta     load_name+5
000ED0r 1  A9 rr                lda     #<load_blk
000ED2r 1  A0 rr                ldy     #>load_blk
000ED4r 1  20 15 FE             jsr     SBC_LOAD
000ED7r 1  B0 1E                bcs     @fail
000ED9r 1  AD rr rr             lda     wc              ; "SM", version 2
000EDCr 1  C9 53                cmp     #'S'
000EDEr 1  D0 17                bne     @fail
000EE0r 1  AD rr rr             lda     wc+1
000EE3r 1  C9 4D                cmp     #'M'
000EE5r 1  D0 10                bne     @fail
000EE7r 1  AD rr rr             lda     wc+2
000EEAr 1  C9 02                cmp     #2
000EECr 1  D0 09                bne     @fail
000EEEr 1  AD rr rr             lda     lvl             ; (levels in it: wc+3)
000EF1r 1  CD rr rr             cmp     wc+3
000EF4r 1  B0 01                bcs     @fail
000EF6r 1  60                   rts
000EF7r 1  38           @fail:  sec
000EF8r 1  60                   rts
000EF9r 1               
000EF9r 1               ; ---- load the level (in wc): the map, MOS, the timer, no objects ---------------------
000EF9r 1               load_level:
000EF9r 1  A2 00                ldx     #0              ; an empty map
000EFBr 1  8A                   txa
000EFCr 1  9D rr rr 9D  @clr:   .repeat MAPROWS, K
000F00r 1  rr rr 9D rr  
000F04r 1  rr 9D rr rr  
000F1Dr 1                       sta     map + K * 256,x
000F1Dr 1                       .endrepeat
000F1Dr 1  E8                   inx
000F1Er 1  D0 DC                bne     @clr
000F20r 1  AD rr rr             lda     lvl             ; the level: at wc + its offset (wc+4 + lvl * 2)
000F23r 1  0A                   asl
000F24r 1  A8                   tay
000F25r 1  18                   clc
000F26r 1  B9 rr rr             lda     wc+4,y
000F29r 1  69 rr                adc     #<wc
000F2Br 1  8D rr rr             sta     @rd+1
000F2Er 1  B9 rr rr             lda     wc+5,y
000F31r 1  69 rr                adc     #>wc
000F33r 1  8D rr rr             sta     @rd+2
000F36r 1  A2 00                ldx     #0              ; width, start, time, flags, room, exit pipe
000F38r 1  20 rr rr     @in:    jsr     @get
000F3Br 1  9D rr rr             sta     lv_w,x
000F3Er 1  E8                   inx
000F3Fr 1  E0 08                cpx     #8
000F41r 1  D0 F5                bne     @in
000F43r 1  A9 00                lda     #0
