0023C6r 2               ; (735 bytes of scripts)
0023C6r 2               
0023C6r 1               
0023C6r 1                       .segment "CODE"
000000r 1  4C rr rr             jmp     start
000003r 1  03           speed:  .byte   SPEED_DEFAULT
000004r 1  01           ctrl_def:.byte  1               ; controls at start: 0 keyboard, 1 gamepad
000005r 1  00                   .byte   0               ; (spare)
000006r 1  00           mute_def:.byte  0               ; sound at start: 0 on, 1 off
000007r 1  00                   .byte   0
000008r 1               
000008r 1                       .include "ay/sfx.s"     ; the sound engine (AY-3-8910 card)
000008r 2               ; ============================================================================
000008r 2               ; sfx.s - sound effects and music for games, on the AY-3-8910 card
000008r 2               ;         ($7F22 register number, $7F23 data; 2 MHz chip clock)
000008r 2               ;
000008r 2               ; Include it in a game (it finds its note table one folder up, like
000008r 2               ; sbc_api.inc:  ca65 -I ..):
000008r 2               ;           .include "ay/sfx.s"
000008r 2               ; and then
000008r 2               ;   sfx_init    once at the start (silence, the timer)
000008r 2               ;   sfx_poll    often: at least every 20 ms (the game loop, and the delay
000008r 2               ;               loops).  It runs the sound 50 times a second, timed by the
000008r 2               ;               VIA's timer 2 (polled: its interrupt stays off; timer 1 and
000008r 2               ;               the gamepad aren't touched).  Keeps A, X, Y and the flags.
000008r 2               ;   sfx_play    play script A on voice X (see below); it doesn't if that
000008r 2               ;               voice is busy with a script of higher priority
000008r 2               ;   sfx_stop    stop voice X
000008r 2               ;   sfx_off     stop everything (and silence)
000008r 2               ;   sfx_mute    0 = sound on, 1 = muted (the scripts still run, unheard)
000008r 2               ;   sfx_hush    call before waiting without sfx_poll (a pause): silences the
000008r 2               ;               card until the next tick
000008r 2               ; With SFX_SND defined before the include, also:
000008r 2               ;   sfx_snd     play script A on its own voice (sfx_prio's high 4 bits)
000008r 2               ;   sfx_toggle  sound on / off (for the M key)
000008r 2               ;
000008r 2               ; The voices: 0-2 are the background (music, a saucer's hum ...) on the
000008r 2               ; chip's channels A-C; 3-5 are the foreground on the same channels.  While
000008r 2               ; a foreground voice plays, it is heard instead of the background voice of
000008r 2               ; its channel, which carries on unheard and comes back when it stops.
000008r 2               ;
000008r 2               ; A game lists its scripts in sfx_scripts (.word address) and their
000008r 2               ; priorities in sfx_prio (.byte, higher wins), indexed by script number.
000008r 2               ;
000008r 2               ; A script is bytes, run 50 times a second until it waits:
000008r 2               ;   $80-$FF         wait 1-128 ticks (1/50 s each): $80 + ticks - 1
000008r 2               ;   $20-$7F         note 0-95 (C1 .. B8, A4 = 45): $20 + note; the
000008r 2               ;                   volume goes back to the VOL level, the decay restarts;
000008r 2               ;                   then it waits LEN ticks (if LEN isn't 0)
000008r 2               ;   SX_END          (0) the end: the voice stops
000008r 2               ;   SX_PER  lo, hi  tone period (12 bits): 2 MHz / (16 x period) Hz
000008r 2               ;   SX_VOL  v       volume 0-15 (also the level each note starts at)
000008r 2               ;   SX_NOISE n      noise period 0-31 (for the whole chip)
000008r 2               ;   SX_MIX  m       bit 0 tone on, bit 1 noise on
000008r 2               ;   SX_SWEEP lo, hi add this (signed) to the period every tick (0 = off)
000008r 2               ;   SX_DECAY d      the volume drops by 1 every d ticks (0 = holds)
000008r 2               ;   SX_LOOP c       the start of a part to play c times (0 = for ever)
000008r 2               ;   SX_NEXT         the end of that part
000008r 2               ;   SX_JUMP lo, hi  go on at another script (for music that repeats)
000008r 2               ;   SX_REST         volume 0 until the next note (and wait LEN ticks)
000008r 2               ;   SX_LEN t        notes and rests wait t ticks each from now on (music:
000008r 2               ;                   a byte a note); 0 (the start) = they don't wait
000008r 2               ; ============================================================================
000008r 2               
000008r 2               ; ---- variables (123 bytes): in the BSS, or at SFX_VARS if the game sets it
000008r 2               ;      (SMB puts them at $0100, the bottom of the stack page) ----------------
000008r 2               .ifdef SFX_VARS
000008r 2               sfx_vars        = SFX_VARS
000008r 2               sfx_lo          = sfx_vars
000008r 2               sfx_hi          = sfx_lo + 6
000008r 2               sfx_wait        = sfx_hi + 6
000008r 2               sfx_perl        = sfx_wait + 6
000008r 2               sfx_perh        = sfx_perl + 6
000008r 2               sfx_swl         = sfx_perh + 6
000008r 2               sfx_swh         = sfx_swl + 6
000008r 2               sfx_vol         = sfx_swh + 6
000008r 2               sfx_base        = sfx_vol + 6
000008r 2               sfx_dec         = sfx_base + 6
000008r 2               sfx_decc        = sfx_dec + 6
000008r 2               sfx_mix         = sfx_decc + 6
000008r 2               sfx_noise       = sfx_mix + 6
000008r 2               sfx_lpl         = sfx_noise + 6
000008r 2               sfx_lph         = sfx_lpl + 6
000008r 2               sfx_lcnt        = sfx_lph + 6
000008r 2               sfx_vprio       = sfx_lcnt + 6
000008r 2               sfx_len         = sfx_vprio + 6
000008r 2               sfx_runs        = sfx_len + 6
000008r 2               sfx_mixer       = sfx_runs + 1
000008r 2               sfx_chan        = sfx_mixer + 1
000008r 2               sfx_guard       = sfx_chan + 1
000008r 2               sfx_mute        = sfx_guard + 2
000008r 2               sfx_sa          = sfx_mute + 1
000008r 2               sfx_sx          = sfx_sa + 1
000008r 2               sfx_sy          = sfx_sx + 1
000008r 2               sfx_vars_end    = sfx_sy + 1
000008r 2               .else
000008r 2                       .segment "BSS"
000000r 2               sfx_vars:
000000r 2  xx xx xx xx  sfx_lo:     .res 6              ; script pointer (high byte 0: voice off)
000004r 2  xx xx        
000006r 2  xx xx xx xx  sfx_hi:     .res 6
00000Ar 2  xx xx        
00000Cr 2  xx xx xx xx  sfx_wait:   .res 6
000010r 2  xx xx        
000012r 2  xx xx xx xx  sfx_perl:   .res 6              ; tone period
000016r 2  xx xx        
000018r 2  xx xx xx xx  sfx_perh:   .res 6
00001Cr 2  xx xx        
00001Er 2  xx xx xx xx  sfx_swl:    .res 6              ; sweep
000022r 2  xx xx        
000024r 2  xx xx xx xx  sfx_swh:    .res 6
000028r 2  xx xx        
00002Ar 2  xx xx xx xx  sfx_vol:    .res 6
00002Er 2  xx xx        
000030r 2  xx xx xx xx  sfx_base:   .res 6              ; the volume notes start at
000034r 2  xx xx        
000036r 2  xx xx xx xx  sfx_dec:    .res 6              ; decay: ticks a step
00003Ar 2  xx xx        
00003Cr 2  xx xx xx xx  sfx_decc:   .res 6
000040r 2  xx xx        
000042r 2  xx xx xx xx  sfx_mix:    .res 6
000046r 2  xx xx        
000048r 2  xx xx xx xx  sfx_noise:  .res 6
00004Cr 2  xx xx        
00004Er 2  xx xx xx xx  sfx_lpl:    .res 6              ; loop start
000052r 2  xx xx        
000054r 2  xx xx xx xx  sfx_lph:    .res 6
000058r 2  xx xx        
00005Ar 2  xx xx xx xx  sfx_lcnt:   .res 6
00005Er 2  xx xx        
000060r 2  xx xx xx xx  sfx_vprio:  .res 6
000064r 2  xx xx        
000066r 2  xx xx xx xx  sfx_len:    .res 6              ; LEN
00006Ar 2  xx xx        
00006Cr 2  xx           sfx_runs:   .res 1
00006Dr 2  xx           sfx_mixer:  .res 1
00006Er 2  xx           sfx_chan:   .res 1
00006Fr 2  xx xx        sfx_guard:  .res 2
000071r 2  xx           sfx_mute:   .res 1
000072r 2  xx           sfx_sa:     .res 1              ; (sfx_snd)
000073r 2  xx           sfx_sx:     .res 1
000074r 2  xx           sfx_sy:     .res 1
000075r 2               sfx_vars_end:
000075r 2                       .segment "CODE"
000008r 2               .endif
000008r 2               
000008r 2               SX_END          = 0
000008r 2               SX_PER          = 1
000008r 2               SX_VOL          = 2
000008r 2               SX_NOISE        = 3
000008r 2               SX_MIX          = 4
000008r 2               SX_SWEEP        = 5
000008r 2               SX_DECAY        = 6
000008r 2               SX_LOOP         = 7
000008r 2               SX_NEXT         = 8
000008r 2               SX_JUMP         = 9
000008r 2               SX_REST         = 10
000008r 2               SX_LEN          = 11
000008r 2               .define SX_WAIT(t)  ($80 + (t) - 1)
000008r 2               .define SX_NOTE(n)  ($20 + (n))
000008r 2               
000008r 2               SFX_AY_ADDR     = $7F22
000008r 2               SFX_AY_DATA     = $7F23
000008r 2               SFX_T2CL        = $7F08
000008r 2               SFX_T2CH        = $7F09
000008r 2               SFX_ACR         = $7F0B
000008r 2               SFX_IFR         = $7F0D
000008r 2               SFX_IER         = $7F0E
000008r 2               
000008r 2               ; the timer counts a 50th of a second in SFX_RUNS runs of SFX_COUNT cycles
000008r 2               ; (it holds 16 bits)
000008r 2               SFX_CYCLES      = CLOCK_MHZ * 20000
000008r 2               SFX_RUNS        = (SFX_CYCLES + 65535) / 65536
000008r 2               SFX_COUNT       = SFX_CYCLES / SFX_RUNS - 2
000008r 2               
000008r 2               ; ---- the routines ------------------------------------------------------------------------
000008r 2               sfx_init:
000008r 2  A9 00                lda     #0
00000Ar 2  A2 74                ldx     #sfx_vars_end - sfx_vars - 1
00000Cr 2  9D rr rr     @c:     sta     sfx_vars,x
00000Fr 2  CA                   dex
000010r 2  10 FA                bpl     @c
000012r 2  AD 0B 7F             lda     SFX_ACR         ; timer 2: one shot, its interrupt off
000015r 2  29 DF                and     #$DF
000017r 2  8D 0B 7F             sta     SFX_ACR
00001Ar 2  A9 20                lda     #$20
00001Cr 2  8D 0E 7F             sta     SFX_IER
00001Fr 2  A9 02                lda     #SFX_RUNS
000021r 2  8D rr rr             sta     sfx_runs
000024r 2  A9 3E                lda     #<SFX_COUNT
000026r 2  8D 08 7F             sta     SFX_T2CL
000029r 2  A9 9C                lda     #>SFX_COUNT
00002Br 2  8D 09 7F             sta     SFX_T2CH
00002Er 2                       ; (on into sfx_off)
00002Er 2               
00002Er 2               ; stop every voice, silence
00002Er 2               sfx_off:
00002Er 2  48                   pha
00002Fr 2  8A                   txa
000030r 2  48                   pha
000031r 2  A2 05                ldx     #5
000033r 2  A9 00                lda     #0
000035r 2  9D rr rr     @v:     sta     sfx_hi,x
000038r 2  CA                   dex
000039r 2  10 FA                bpl     @v
00003Br 2  68                   pla
00003Cr 2  AA                   tax
00003Dr 2  68                   pla
00003Er 2                       ; (on into sfx_hush)
00003Er 2               
00003Er 2               ; silence the card (until the next tick).  Keeps A, X, Y.
00003Er 2               sfx_hush:
00003Er 2  48                   pha
00003Fr 2  8A                   txa
000040r 2  48                   pha
000041r 2  A9 07                lda     #7              ; mixer: all off
000043r 2  8D 22 7F             sta     SFX_AY_ADDR
000046r 2  A9 3F                lda     #$3F
000048r 2  8D 23 7F             sta     SFX_AY_DATA
00004Br 2  A2 08                ldx     #8              ; volumes 0
00004Dr 2  A9 00                lda     #0
00004Fr 2  8E 22 7F     @v:     stx     SFX_AY_ADDR
000052r 2  8D 23 7F             sta     SFX_AY_DATA
000055r 2  E8                   inx
000056r 2  E0 0B                cpx     #11
000058r 2  D0 F5                bne     @v
00005Ar 2  68                   pla
00005Br 2  AA                   tax
00005Cr 2  68                   pla
00005Dr 2  60                   rts
00005Er 2               
00005Er 2               ; stop voice X
00005Er 2               sfx_stop:
00005Er 2  48                   pha
00005Fr 2  A9 00                lda     #0
000061r 2  9D rr rr             sta     sfx_hi,x
000064r 2  68                   pla
000065r 2  60                   rts
000066r 2               
000066r 2               ; play script A on voice X (0-5); not if the voice is playing a script of
000066r 2               ; higher priority.  Keeps X.
000066r 2               sfx_play:
000066r 2  A8                   tay
000067r 2  BD rr rr             lda     sfx_hi,x
00006Ar 2  F0 09                beq     @go
00006Cr 2  B9 rr rr             lda     sfx_prio,y
00006Fr 2  DD rr rr             cmp     sfx_vprio,x
000072r 2  B0 01                bcs     @go
000074r 2  60                   rts
000075r 2  B9 rr rr     @go:    lda     sfx_prio,y
000078r 2  9D rr rr             sta     sfx_vprio,x
00007Br 2  98                   tya
00007Cr 2  0A                   asl
00007Dr 2  A8                   tay
00007Er 2  B9 rr rr             lda     sfx_scripts,y
000081r 2  9D rr rr             sta     sfx_lo,x
000084r 2  B9 rr rr             lda     sfx_scripts+1,y
000087r 2  9D rr rr             sta     sfx_hi,x
00008Ar 2  A9 00                lda     #0
00008Cr 2  9D rr rr             sta     sfx_wait,x
00008Fr 2  9D rr rr             sta     sfx_swl,x
000092r 2  9D rr rr             sta     sfx_swh,x
000095r 2  9D rr rr             sta     sfx_dec,x
000098r 2  9D rr rr             sta     sfx_perl,x
00009Br 2  9D rr rr             sta     sfx_perh,x
00009Er 2  9D rr rr             sta     sfx_len,x
0000A1r 2  A9 0F                lda     #15
0000A3r 2  9D rr rr             sta     sfx_base,x
0000A6r 2  9D rr rr             sta     sfx_vol,x
0000A9r 2  A9 01                lda     #1              ; tone on, noise off
0000ABr 2  9D rr rr             sta     sfx_mix,x
0000AEr 2  60                   rts
0000AFr 2               
0000AFr 2               ; run the sound if a tick has come.  Keeps A, X, Y and the flags (so it can
0000AFr 2               ; go anywhere: in putc, in a loop ...)
0000AFr 2               sfx_poll:
0000AFr 2  08                   php
0000B0r 2  48                   pha
0000B1r 2  AD 0D 7F             lda     SFX_IFR
0000B4r 2  29 20                and     #$20
0000B6r 2  D0 03                bne     @t
0000B8r 2  68                   pla
0000B9r 2  28                   plp
0000BAr 2  60                   rts
0000BBr 2  8A           @t:     txa
0000BCr 2  48                   pha
0000BDr 2  98                   tya
0000BEr 2  48                   pha
0000BFr 2                       ; the timer has gone on counting down past 0 ($FFFF, $FFFE ...): how
0000BFr 2                       ; late this call is.  The next run is that much shorter, so the beat
0000BFr 2                       ; keeps time however long the game takes between calls.
0000BFr 2  AE 09 7F     @rd:    ldx     SFX_T2CH
0000C2r 2  AD 08 7F             lda     SFX_T2CL
0000C5r 2  EC 09 7F             cpx     SFX_T2CH        ; (the high byte changed in between: again)
0000C8r 2  D0 F5                bne     @rd
0000CAr 2  38                   sec
0000CBr 2  69 22                adc     #<(SFX_COUNT - SFX_FIX)
0000CDr 2  A8                   tay
0000CEr 2  8A                   txa
0000CFr 2  69 9C                adc     #>(SFX_COUNT - SFX_FIX)
0000D1r 2  B0 04                bcs     @set
0000D3r 2  A0 64                ldy     #100            ; (more than a whole run late: soon)
0000D5r 2  A9 00                lda     #0
0000D7r 2  8C 08 7F     @set:   sty     SFX_T2CL
0000DAr 2  8D 09 7F             sta     SFX_T2CH
0000DDr 2  CE rr rr             dec     sfx_runs
0000E0r 2  D0 08                bne     @r
0000E2r 2  A9 02                lda     #SFX_RUNS
0000E4r 2  8D rr rr             sta     sfx_runs
0000E7r 2  20 rr rr             jsr     sfx_tick
0000EAr 2  68           @r:     pla
0000EBr 2  A8                   tay
0000ECr 2  68                   pla
0000EDr 2  AA                   tax
0000EEr 2  68                   pla
0000EFr 2  28                   plp
0000F0r 2  60                   rts
0000F1r 2               SFX_FIX = 28                    ; cycles from reading the timer to starting it
0000F1r 2               
0000F1r 2               .ifdef SFX_SND
0000F1r 2               ; ---- (with SFX_SND defined) ---------------------------------------------------
0000F1r 2               ; play script A on its own voice: the high 4 bits of its sfx_prio byte (the
0000F1r 2               ; low 4 are its priority).  Keeps A, X and Y.
0000F1r 2               sfx_snd:
0000F1r 2                       sta     sfx_sa
0000F1r 2                       stx     sfx_sx
0000F1r 2                       sty     sfx_sy
0000F1r 2                       tay
0000F1r 2                       lda     sfx_prio,y
0000F1r 2                       lsr
0000F1r 2                       lsr
0000F1r 2                       lsr
0000F1r 2                       lsr
0000F1r 2                       tax
0000F1r 2                       tya
0000F1r 2                       jsr     sfx_play
0000F1r 2                       lda     sfx_sa
0000F1r 2                       ldx     sfx_sx
0000F1r 2                       ldy     sfx_sy
0000F1r 2                       rts
0000F1r 2               
0000F1r 2               ; sound on / off (the M key).  Keeps X and Y.
0000F1r 2               sfx_toggle:
0000F1r 2                       lda     sfx_mute
0000F1r 2                       eor     #1
0000F1r 2                       sta     sfx_mute
0000F1r 2                       jmp     sfx_hush
0000F1r 2               .endif
0000F1r 2               
0000F1r 2               ; ---- a tick: every voice a step, then the card ---------------------------------------------
0000F1r 2               sfx_tick:
0000F1r 2  A2 05                ldx     #5
0000F3r 2  BD rr rr     @v:     lda     sfx_hi,x
0000F6r 2  F0 03                beq     @n
0000F8r 2  20 rr rr             jsr     sfx_voice
0000FBr 2  CA           @n:     dex
0000FCr 2  10 F5                bpl     @v
0000FEr 2                       ; the card: each channel hears its foreground voice if that plays,
0000FEr 2                       ; else its background voice
0000FEr 2  A9 3F                lda     #$3F
000100r 2  8D rr rr             sta     sfx_mixer
000103r 2  A2 02                ldx     #2
000105r 2  8E rr rr     @ch:    stx     sfx_chan
000108r 2  8A                   txa
000109r 2  18                   clc
00010Ar 2  69 03                adc     #3
00010Cr 2  A8                   tay                     ; foreground voice
00010Dr 2  B9 rr rr             lda     sfx_hi,y
000110r 2  D0 0C                bne     @have
000112r 2  AC rr rr             ldy     sfx_chan        ; background voice
000115r 2  B9 rr rr             lda     sfx_hi,y
000118r 2  D0 04                bne     @have
00011Ar 2  A9 00                lda     #0              ; neither: silent
00011Cr 2  F0 4E                beq     @vol
00011Er 2  8A           @have:  txa                     ; the tone period
00011Fr 2  0A                   asl
000120r 2  8D 22 7F             sta     SFX_AY_ADDR
000123r 2  B9 rr rr             lda     sfx_perl,y
000126r 2  8D 23 7F             sta     SFX_AY_DATA
000129r 2  8A                   txa
00012Ar 2  0A                   asl
00012Br 2  09 01                ora     #1
00012Dr 2  8D 22 7F             sta     SFX_AY_ADDR
000130r 2  B9 rr rr             lda     sfx_perh,y
000133r 2  29 0F                and     #$0F
000135r 2  8D 23 7F             sta     SFX_AY_DATA
000138r 2  B9 rr rr             lda     sfx_mix,y       ; the mixer bits (0 = on)
00013Br 2  4A                   lsr
00013Cr 2  90 09                bcc     @nt
00013Er 2  BD rr rr             lda     sfx_tone_on,x
000141r 2  2D rr rr             and     sfx_mixer
000144r 2  8D rr rr             sta     sfx_mixer
000147r 2  B9 rr rr     @nt:    lda     sfx_mix,y
00014Ar 2  29 02                and     #2
00014Cr 2  F0 14                beq     @nn
00014Er 2  BD rr rr             lda     sfx_noise_on,x
000151r 2  2D rr rr             and     sfx_mixer
000154r 2  8D rr rr             sta     sfx_mixer
000157r 2  A9 06                lda     #6
000159r 2  8D 22 7F             sta     SFX_AY_ADDR
00015Cr 2  B9 rr rr             lda     sfx_noise,y
00015Fr 2  8D 23 7F             sta     SFX_AY_DATA
000162r 2  B9 rr rr     @nn:    lda     sfx_vol,y
000165r 2  AC rr rr             ldy     sfx_mute
000168r 2  F0 02                beq     @vol
00016Ar 2  A9 00                lda     #0
00016Cr 2  AC rr rr     @vol:   ldy     sfx_chan
00016Fr 2  AA                   tax
000170r 2  98                   tya
000171r 2  18                   clc
000172r 2  69 08                adc     #8
000174r 2  8D 22 7F             sta     SFX_AY_ADDR
000177r 2  8E 23 7F             stx     SFX_AY_DATA
00017Ar 2  AE rr rr             ldx     sfx_chan
00017Dr 2  CA                   dex
00017Er 2  10 85                bpl     @ch
000180r 2  A9 07                lda     #7
000182r 2  8D 22 7F             sta     SFX_AY_ADDR
000185r 2  AD rr rr             lda     sfx_mixer
000188r 2  8D 23 7F             sta     SFX_AY_DATA
00018Br 2  60                   rts
00018Cr 2  3E 3D 3B     sfx_tone_on:    .byte   $3E, $3D, $3B
00018Fr 2  37 2F 1F     sfx_noise_on:   .byte   $37, $2F, $1F
000192r 2               
000192r 2               ; one voice (X): the sweep and the decay, then the script when its wait
000192r 2               ; is over
000192r 2               sfx_voice:
000192r 2  BD rr rr             lda     sfx_swl,x       ; the sweep
000195r 2  1D rr rr             ora     sfx_swh,x
000198r 2  F0 13                beq     @ns
00019Ar 2  BD rr rr             lda     sfx_perl,x
00019Dr 2  18                   clc
00019Er 2  7D rr rr             adc     sfx_swl,x
0001A1r 2  9D rr rr             sta     sfx_perl,x
0001A4r 2  BD rr rr             lda     sfx_perh,x
0001A7r 2  7D rr rr             adc     sfx_swh,x
0001AAr 2  9D rr rr             sta     sfx_perh,x
0001ADr 2  BD rr rr     @ns:    lda     sfx_dec,x       ; the decay
0001B0r 2  F0 10                beq     @nd
0001B2r 2  DE rr rr             dec     sfx_decc,x
0001B5r 2  D0 0B                bne     @nd
0001B7r 2  9D rr rr             sta     sfx_decc,x
0001BAr 2  BD rr rr             lda     sfx_vol,x
0001BDr 2  F0 03                beq     @nd
0001BFr 2  DE rr rr             dec     sfx_vol,x
0001C2r 2  BD rr rr     @nd:    lda     sfx_wait,x
0001C5r 2  F0 06                beq     @run
0001C7r 2  DE rr rr             dec     sfx_wait,x
0001CAr 2  F0 01                beq     @run
0001CCr 2  60                   rts
0001CDr 2  A9 28        @run:   lda     #40             ; (at most 40 commands a tick: a script that
0001CFr 2  8D rr rr             sta     sfx_guard       ;  never waits can't hang the game)
0001D2r 2  CE rr rr     @cmd:   dec     sfx_guard
0001D5r 2  F0 76                beq     @stop
0001D7r 2  20 rr rr             jsr     sfx_byte
0001DAr 2  C9 80                cmp     #$80
0001DCr 2  90 09                bcc     @nw
0001DEr 2  29 7F                and     #$7F            ; wait
0001E0r 2  9D rr rr             sta     sfx_wait,x
0001E3r 2  FE rr rr             inc     sfx_wait,x
0001E6r 2  60                   rts
0001E7r 2  C9 20        @nw:    cmp     #$20
0001E9r 2  90 54                bcc     @op
0001EBr 2  38                   sec                     ; a note
0001ECr 2  E9 20                sbc     #$20
0001EEr 2  C9 60                cmp     #96
0001F0r 2  90 02                bcc     @nt
0001F2r 2  A9 5F                lda     #95
0001F4r 2  A0 00        @nt:    ldy     #0              ; octave Y, note A in it
0001F6r 2  C9 0C        @oc:    cmp     #12
0001F8r 2  90 05                bcc     @ok
0001FAr 2  E9 0C                sbc     #12
0001FCr 2  C8                   iny
0001FDr 2  D0 F7                bne     @oc
0001FFr 2  8C rr rr     @ok:    sty     sfx_guard+1     ; (as a count)
000202r 2  A8                   tay
000203r 2  B9 rr rr             lda     sfx_c1_lo,y     ; the period in octave 1, halved for each
000206r 2  9D rr rr             sta     sfx_perl,x      ; octave up
000209r 2  B9 rr rr             lda     sfx_c1_hi,y
00020Cr 2  AC rr rr             ldy     sfx_guard+1
00020Fr 2  F0 16                beq     @p
000211r 2  4A           @sh:    lsr
000212r 2  7E rr rr             ror     sfx_perl,x
000215r 2  88                   dey
000216r 2  D0 F9                bne     @sh
000218r 2  9D rr rr             sta     sfx_perh,x      ; (rounded: the last bit out was a half)
00021Br 2  90 0D                bcc     @r0
00021Dr 2  FE rr rr             inc     sfx_perl,x
000220r 2  D0 08                bne     @r0
000222r 2  FE rr rr             inc     sfx_perh,x
000225r 2  D0 03                bne     @r0
000227r 2  9D rr rr     @p:     sta     sfx_perh,x
00022Ar 2               @r0:
00022Ar 2  BD rr rr             lda     sfx_base,x
00022Dr 2  9D rr rr             sta     sfx_vol,x
000230r 2  BD rr rr             lda     sfx_dec,x
000233r 2  9D rr rr             sta     sfx_decc,x
000236r 2  BD rr rr     @len:   lda     sfx_len,x       ; (LEN: wait that long)
000239r 2  F0 97                beq     @cmd
00023Br 2  9D rr rr             sta     sfx_wait,x
00023Er 2  60                   rts
00023Fr 2  C9 0C        @op:    cmp     #12
000241r 2  B0 0A                bcs     @stop
000243r 2  A8                   tay
000244r 2  B9 rr rr             lda     @hi,y
000247r 2  48                   pha
000248r 2  B9 rr rr             lda     @lo,y
00024Br 2  48                   pha
00024Cr 2  60                   rts                     ; (to the command, which goes back to @cmd)
00024Dr 2  A9 00        @stop:  lda     #0
00024Fr 2  9D rr rr             sta     sfx_hi,x
000252r 2  9D rr rr             sta     sfx_vol,x
000255r 2  60                   rts
000256r 2  rr rr rr rr  @lo:    .lobytes  @stop-1, @per-1, @vl-1, @noi-1, @mix-1, @sw-1, @dc-1, @lp-1, @nx-1, @jp-1, @rest-1, @ln-1
00025Ar 2  rr rr rr rr  
00025Er 2  rr rr rr rr  
000262r 2  rr rr rr rr  @hi:    .hibytes  @stop-1, @per-1, @vl-1, @noi-1, @mix-1, @sw-1, @dc-1, @lp-1, @nx-1, @jp-1, @rest-1, @ln-1
000266r 2  rr rr rr rr  
00026Ar 2  rr rr rr rr  
00026Er 2  20 rr rr     @per:   jsr     sfx_byte
000271r 2  9D rr rr             sta     sfx_perl,x
000274r 2  20 rr rr             jsr     sfx_byte
000277r 2  9D rr rr             sta     sfx_perh,x
00027Ar 2  4C rr rr             jmp     @cmd
00027Dr 2  20 rr rr     @vl:    jsr     sfx_byte
000280r 2  9D rr rr             sta     sfx_base,x
000283r 2  9D rr rr             sta     sfx_vol,x
000286r 2  BD rr rr             lda     sfx_dec,x
000289r 2  9D rr rr             sta     sfx_decc,x
00028Cr 2  4C rr rr             jmp     @cmd
00028Fr 2  20 rr rr     @noi:   jsr     sfx_byte
000292r 2  9D rr rr             sta     sfx_noise,x
000295r 2  4C rr rr             jmp     @cmd
000298r 2  20 rr rr     @mix:   jsr     sfx_byte
00029Br 2  9D rr rr             sta     sfx_mix,x
00029Er 2  4C rr rr             jmp     @cmd
0002A1r 2  20 rr rr     @sw:    jsr     sfx_byte
0002A4r 2  9D rr rr             sta     sfx_swl,x
0002A7r 2  20 rr rr             jsr     sfx_byte
0002AAr 2  9D rr rr             sta     sfx_swh,x
0002ADr 2  4C rr rr             jmp     @cmd
0002B0r 2  20 rr rr     @dc:    jsr     sfx_byte
0002B3r 2  9D rr rr             sta     sfx_dec,x
0002B6r 2  9D rr rr             sta     sfx_decc,x
0002B9r 2  4C rr rr             jmp     @cmd
0002BCr 2  20 rr rr     @lp:    jsr     sfx_byte
0002BFr 2  9D rr rr             sta     sfx_lcnt,x
0002C2r 2  BD rr rr             lda     sfx_lo,x
0002C5r 2  9D rr rr             sta     sfx_lpl,x
0002C8r 2  BD rr rr             lda     sfx_hi,x
0002CBr 2  9D rr rr             sta     sfx_lph,x
0002CEr 2  4C rr rr             jmp     @cmd
0002D1r 2  BD rr rr     @nx:    lda     sfx_lcnt,x
0002D4r 2  F0 05                beq     @back           ; (0: for ever)
0002D6r 2  DE rr rr             dec     sfx_lcnt,x
0002D9r 2  F0 0C                beq     @go
0002DBr 2  BD rr rr     @back:  lda     sfx_lpl,x
0002DEr 2  9D rr rr             sta     sfx_lo,x
0002E1r 2  BD rr rr             lda     sfx_lph,x
0002E4r 2  9D rr rr             sta     sfx_hi,x
0002E7r 2  4C rr rr     @go:    jmp     @cmd
0002EAr 2  20 rr rr     @jp:    jsr     sfx_byte
0002EDr 2  48                   pha
0002EEr 2  20 rr rr             jsr     sfx_byte
0002F1r 2  9D rr rr             sta     sfx_hi,x
0002F4r 2  68                   pla
0002F5r 2  9D rr rr             sta     sfx_lo,x
0002F8r 2  4C rr rr             jmp     @cmd
0002FBr 2  A9 00        @rest:  lda     #0
0002FDr 2  9D rr rr             sta     sfx_vol,x
000300r 2  4C rr rr             jmp     @len
000303r 2  20 rr rr     @ln:    jsr     sfx_byte
000306r 2  9D rr rr             sta     sfx_len,x
000309r 2  4C rr rr             jmp     @cmd
00030Cr 2               
00030Cr 2               ; the next byte of voice X's script
00030Cr 2               sfx_byte:
00030Cr 2  BD rr rr             lda     sfx_lo,x
00030Fr 2  8D rr rr             sta     @ld+1
000312r 2  BD rr rr             lda     sfx_hi,x
000315r 2  8D rr rr             sta     @ld+2
000318r 2  AD FF FF     @ld:    lda     $FFFF
00031Br 2  FE rr rr             inc     sfx_lo,x
00031Er 2  D0 03                bne     @r
000320r 2  FE rr rr             inc     sfx_hi,x
000323r 2  60           @r:     rts
000324r 2               
000324r 2               ; the tone periods of C1 .. B1 for the 2 MHz chip clock: 2 MHz / (16 x
000324r 2               ; frequency); each octave up is half (to within a third of a percent)
000324r 2  EE 18 4D 8E  sfx_c1_lo:  .lobytes 3822, 3608, 3405, 3214, 3034, 2863, 2703, 2551, 2408, 2273, 2145, 2025
000328r 2  DA 2F 8F F7  
00032Cr 2  68 E1 61 E9  
000330r 2  0E 0E 0D 0C  sfx_c1_hi:  .hibytes 3822, 3608, 3405, 3214, 3034, 2863, 2703, 2551, 2408, 2273, 2145, 2025
000334r 2  0B 0B 0A 09  
000338r 2  09 08 08 07  
00033Cr 2               
00033Cr 2               
00033Cr 1                       .include "lib/vdp.s"    ; the PICO9918 routines
00033Cr 2               ; ============================================================================
00033Cr 2               ; vdp.s - PICO9918 / TMS9918A routines shared by the SBC games (CPU Rev2)
00033Cr 2               ;
00033Cr 2               ; Include it after setting VDP_NAME (the name table's VRAM address):
00033Cr 2               ;           VDP_NAME = $1800
00033Cr 2               ;           .include "lib/vdp.s"
00033Cr 2               ; No zero page is used: the copy routines patch their own addresses.
00033Cr 2               ;
00033Cr 2               ;   vdp_setup   A/Y -> 8 bytes: R0-R7.  Puts a PICO9918 (F18A mode) back to
00033Cr 2               ;               plain TMS9918A behaviour first (24 rows, all 32 sprites, no
00033Cr 2               ;               scrolling, no second tile layer; the unlock leaves VR30 at
00033Cr 2               ;               31 sprites a line),
00033Cr 2               ;               clears the 16K of VRAM, then loads R0-R7.  Interrupts from
00033Cr 2               ;               the VDP should be off in R1 (bit 5): the games poll.
00033Cr 2               ;   vdp_reg     register X = A
00033Cr 2               ;   vdp_waddr   VRAM write address = A (low) / Y (high)
00033Cr 2               ;   vdp_fill    write A to VRAM vdp_n (16 bit) times, from the address set
00033Cr 2               ;   vdp_copy    copy vdp_n bytes from RAM vdp_src to VRAM (from the address set)
00033Cr 2               ;   vdp_at      write address = the name table cell at column X, row Y
00033Cr 2               ;   vdp_puts    write the 0-ended string at A/Y from there (names = ASCII)
00033Cr 2               ;   vdp_bcd     write A as two digits
00033Cr 2               ;   vdp_frame   wait for the next frame (60 a second), calling frame_idle
00033Cr 2               ;               (the game's: sound, random numbers) while it waits
00033Cr 2               ;
00033Cr 2               ; The VDP's ports: data $7F1C, control/status $7F1D.  Reading the status
00033Cr 2               ; clears the frame flag, so nothing else should read it while a game runs
00033Cr 2               ; (the ROM doesn't, with PICO_IRQ = 0 in its config.inc, the default).
00033Cr 2               ; ============================================================================
00033Cr 2               
00033Cr 2               VDP_DATA        = $7F1C
00033Cr 2               VDP_CTRL        = $7F1D
00033Cr 2               
00033Cr 2               ; register X = A.  Keeps A, X, Y.
00033Cr 2               vdp_reg:
00033Cr 2  8D 1D 7F             sta     VDP_CTRL
00033Fr 2  48                   pha
000340r 2  8A                   txa
000341r 2  09 80                ora     #$80
000343r 2  8D 1D 7F             sta     VDP_CTRL
000346r 2  68                   pla
000347r 2  60                   rts
000348r 2               
000348r 2               ; VRAM write address = A (low) / Y (high).  Keeps A, X, Y.
000348r 2               vdp_waddr:
000348r 2  8D 1D 7F             sta     VDP_CTRL
00034Br 2  48                   pha
00034Cr 2  98                   tya
00034Dr 2  29 3F                and     #$3F
00034Fr 2  09 40                ora     #$40
000351r 2  8D 1D 7F             sta     VDP_CTRL
000354r 2  68                   pla
000355r 2  60                   rts
000356r 2               
000356r 2               ; write A, vdp_n times.  Keeps A.
000356r 2               vdp_fill:
000356r 2  AE rr rr             ldx     vdp_n           ; the odd bytes first
000359r 2  F0 06                beq     @pg
00035Br 2  8D 1C 7F     @lo:    sta     VDP_DATA
00035Er 2  CA                   dex
00035Fr 2  D0 FA                bne     @lo
000361r 2  AC rr rr     @pg:    ldy     vdp_n+1         ; then whole pages
000364r 2  F0 0B                beq     @done
000366r 2  A2 00        @p:     ldx     #0
000368r 2  8D 1C 7F     @pp:    sta     VDP_DATA
00036Br 2  CA                   dex
00036Cr 2  D0 FA                bne     @pp
00036Er 2  88                   dey
00036Fr 2  D0 F5                bne     @p
000371r 2  60           @done:  rts
000372r 2               
000372r 2               ; copy vdp_n bytes from vdp_src to VRAM
000372r 2               vdp_copy:
000372r 2  AD rr rr             lda     vdp_src
000375r 2  8D rr rr             sta     @rd+1
000378r 2  AD rr rr             lda     vdp_src+1
00037Br 2  8D rr rr             sta     @rd+2
00037Er 2  AD rr rr             lda     vdp_n
000381r 2  8D rr rr             sta     vdp_t
000384r 2  AD rr rr             lda     vdp_n+1
000387r 2  8D rr rr             sta     vdp_t+1
00038Ar 2  AD rr rr     @l:     lda     vdp_t
00038Dr 2  0D rr rr             ora     vdp_t+1
000390r 2  F0 1C                beq     @done
000392r 2  AD FF FF     @rd:    lda     $FFFF
000395r 2  8D 1C 7F             sta     VDP_DATA
000398r 2  EE rr rr             inc     @rd+1
00039Br 2  D0 03                bne     :+
00039Dr 2  EE rr rr             inc     @rd+2
0003A0r 2  AD rr rr     :       lda     vdp_t
0003A3r 2  D0 03                bne     :+
0003A5r 2  CE rr rr             dec     vdp_t+1
0003A8r 2  CE rr rr     :       dec     vdp_t
0003ABr 2  4C rr rr             jmp     @l
0003AEr 2  60           @done:  rts
0003AFr 2               
0003AFr 2               ; A/Y -> 8 register values.  Clears VRAM.
0003AFr 2               vdp_setup:
0003AFr 2  8D rr rr             sta     @rr+1
0003B2r 2  8C rr rr             sty     @rr+2
0003B5r 2  AD 1D 7F             lda     VDP_CTRL        ; (resets the register write latch)
0003B8r 2  A9 80                lda     #$80            ; R1 = $80: display off while we work
0003BAr 2  A2 01                ldx     #1
0003BCr 2  20 rr rr             jsr     vdp_reg
0003BFr 2  A9 1C                lda     #$1C            ; F18A unlock (a PICO9918): $1C twice to VR57
0003C1r 2  A2 39                ldx     #57
0003C3r 2  20 rr rr             jsr     vdp_reg
0003C6r 2  20 rr rr             jsr     vdp_reg
0003C9r 2  A9 00                lda     #0              ; VR49: 24 rows, no 80 columns, no layer 2
0003CBr 2  A2 31                ldx     #49
0003CDr 2  20 rr rr             jsr     vdp_reg
0003D0r 2  A2 32                ldx     #50             ; VR50: plain TMS9918A behaviour
0003D2r 2  20 rr rr             jsr     vdp_reg
0003D5r 2  A2 13                ldx     #19             ; VR19: no line interrupt
0003D7r 2  20 rr rr             jsr     vdp_reg
0003DAr 2  A2 19                ldx     #25             ; VR25-VR29: no scrolling, one page
0003DCr 2  20 rr rr     @sc:    jsr     vdp_reg
0003DFr 2  E8                   inx
0003E0r 2  E0 1E                cpx     #30
0003E2r 2  D0 F8                bne     @sc
0003E4r 2  A9 20                lda     #32             ; VR51: all 32 sprites
0003E6r 2  A2 33                ldx     #51
0003E8r 2  20 rr rr             jsr     vdp_reg
0003EBr 2                       ; (on a real TMS9918A those writes land in R0-R7: all set below)
0003EBr 2  A9 80                lda     #$80            ; R1 again: display off
0003EDr 2  A2 01                ldx     #1
0003EFr 2  20 rr rr             jsr     vdp_reg
0003F2r 2  A9 00                lda     #0              ; clear the 16K
0003F4r 2  A8                   tay
0003F5r 2  20 rr rr             jsr     vdp_waddr
0003F8r 2  A9 00                lda     #$00
0003FAr 2  8D rr rr             sta     vdp_n
0003FDr 2  A9 40                lda     #$40
0003FFr 2  8D rr rr             sta     vdp_n+1
000402r 2  A9 00                lda     #0
000404r 2  20 rr rr             jsr     vdp_fill
000407r 2  A2 00                ldx     #0
000409r 2  BD FF FF     @rr:    lda     $FFFF,x
00040Cr 2  20 rr rr             jsr     vdp_reg
00040Fr 2  E8                   inx
000410r 2  E0 08                cpx     #8
000412r 2  D0 F5                bne     @rr
000414r 2  60                   rts
000415r 2               
000415r 2               ; write address = name table cell X (column), Y (row).  Keeps X and Y.
000415r 2               vdp_at:
000415r 2  8E rr rr             stx     vdp_t
000418r 2  98                   tya
000419r 2  4A                   lsr                     ; row * 32: high byte = row / 8
00041Ar 2  4A                   lsr
00041Br 2  4A                   lsr
00041Cr 2  8D rr rr             sta     vdp_t+1
00041Fr 2  98                   tya
000420r 2  0A                   asl
000421r 2  0A                   asl
000422r 2  0A                   asl
000423r 2  0A                   asl
000424r 2  0A                   asl                     ; low byte = (row & 7) * 32
000425r 2  18                   clc
000426r 2  6D rr rr             adc     vdp_t
000429r 2  18                   clc
00042Ar 2  69 00                adc     #<VDP_NAME
00042Cr 2  8D 1D 7F             sta     VDP_CTRL
00042Fr 2  AD rr rr             lda     vdp_t+1
000432r 2  69 20                adc     #>VDP_NAME
000434r 2  29 3F                and     #$3F
000436r 2  09 40                ora     #$40
000438r 2  8D 1D 7F             sta     VDP_CTRL
00043Br 2  60                   rts
00043Cr 2               
00043Cr 2               ; write the 0-ended string at A/Y.  Keeps X.
00043Cr 2               vdp_puts:
00043Cr 2  8D rr rr             sta     @rd+1
00043Fr 2  8C rr rr             sty     @rd+2
000442r 2  A0 00                ldy     #0
000444r 2  B9 FF FF     @rd:    lda     $FFFF,y
000447r 2  F0 06                beq     @done
000449r 2  8D 1C 7F             sta     VDP_DATA
00044Cr 2  C8                   iny
00044Dr 2  D0 F5                bne     @rd
00044Fr 2  60           @done:  rts
000450r 2               
000450r 2               ; A as two BCD digits.  Keeps X, Y.
000450r 2               vdp_bcd:
000450r 2  48                   pha
000451r 2  4A                   lsr
000452r 2  4A                   lsr
000453r 2  4A                   lsr
000454r 2  4A                   lsr
000455r 2  09 30                ora     #'0'
000457r 2  8D 1C 7F             sta     VDP_DATA
00045Ar 2  68                   pla
00045Br 2  48                   pha
00045Cr 2  29 0F                and     #$0F
00045Er 2  09 30                ora     #'0'
000460r 2  8D 1C 7F             sta     VDP_DATA
000463r 2  68                   pla
000464r 2  60                   rts
000465r 2               
000465r 2               ; wait for the next frame
000465r 2               vdp_frame:
000465r 2  20 rr rr     @w:     jsr     frame_idle
000468r 2  AD 1D 7F             lda     VDP_CTRL
00046Br 2  10 F8                bpl     @w
00046Dr 2  60                   rts
00046Er 2               
00046Er 2                       .segment "BSS"
000075r 2  xx xx        vdp_n:          .res 2
000077r 2  xx xx        vdp_src:        .res 2
000079r 2  xx xx        vdp_t:          .res 2
00007Br 2                       .segment "CODE"
00046Er 2               
00046Er 1               
00046Er 1               ; ----------------------------------------------------------------------------
00046Er 1               ; helpers
00046Er 1               ; ----------------------------------------------------------------------------
00046Er 1               getc            = SBC_CHRIN     ; carry set = key in A
00046Er 1               
00046Er 1               ; called by vdp_frame while it waits
00046Er 1               frame_idle:
00046Er 1  4C rr rr             jmp     sfx_poll
000471r 1               
000471r 1               ; 16 bit Galois LFSR.  A = a random byte.  Preserves X and Y.
000471r 1  AD rr rr     rand:   lda     rng+1
000474r 1  4A                   lsr
000475r 1  6E rr rr             ror     rng
000478r 1  90 02                bcc     @n
00047Ar 1  49 B4                eor     #$B4
00047Cr 1  8D rr rr     @n:     sta     rng+1
00047Fr 1  4D rr rr             eor     rng
000482r 1  60                   rts
000483r 1               
000483r 1               ; wait A frames (1/60 s), dropping keys
000483r 1               wait_frames:
000483r 1  8D rr rr             sta     wf_n
000486r 1  20 rr rr     @l:     jsr     vdp_frame
000489r 1  20 rr rr             jsr     flush_in
00048Cr 1  CE rr rr             dec     wf_n
00048Fr 1  D0 F5                bne     @l
000491r 1  60                   rts
000492r 1               
000492r 1               ; wait about A x 50 ms (as the PIC32 version: 3 frames each)
000492r 1               delay_long:
000492r 1  8D rr rr             sta     tmp
000495r 1  A9 03        @l:     lda     #3
000497r 1  20 rr rr             jsr     wait_frames
00049Ar 1  CE rr rr             dec     tmp
00049Dr 1  D0 F6                bne     @l
00049Fr 1  60                   rts
0004A0r 1               
0004A0r 1               ; layer 2 text: print a table of column, row, .word text ... $FF
0004A0r 1               print_table:
0004A0r 1  8D rr rr             sta     @rd+1
0004A3r 1  8C rr rr             sty     @rd+2
0004A6r 1  A2 00                ldx     #0
0004A8r 1  8E rr rr     @l:     stx     pt_i
0004ABr 1  20 rr rr             jsr     @rd
0004AEr 1  C9 FF                cmp     #$FF            ; (the end; column 0 is a column)
0004B0r 1  F0 29                beq     @done
0004B2r 1  8D rr rr             sta     pt_c
0004B5r 1  E8                   inx
0004B6r 1  20 rr rr             jsr     @rd
0004B9r 1  A8                   tay
0004BAr 1  AE rr rr             ldx     pt_c
0004BDr 1  20 rr rr             jsr     vdp_at
0004C0r 1  AE rr rr             ldx     pt_i
0004C3r 1  E8                   inx
0004C4r 1  E8                   inx
0004C5r 1  20 rr rr             jsr     @rd
0004C8r 1  48                   pha
0004C9r 1  E8                   inx
0004CAr 1  20 rr rr             jsr     @rd
0004CDr 1  A8                   tay
0004CEr 1  68                   pla
0004CFr 1  20 rr rr             jsr     vdp_puts
0004D2r 1  AD rr rr             lda     pt_i
0004D5r 1  18                   clc
0004D6r 1  69 04                adc     #4
0004D8r 1  AA                   tax
0004D9r 1  D0 CD                bne     @l
0004DBr 1  60           @done:  rts
0004DCr 1  BD FF FF     @rd:    lda     $FFFF,x
0004DFr 1  60                   rts
0004E0r 1               
0004E0r 1               ; A as two hex digits (layer 2, at the address set).  Keeps X, Y.
0004E0r 1  48           prhex:  pha
0004E1r 1  4A                   lsr
0004E2r 1  4A                   lsr
0004E3r 1  4A                   lsr
0004E4r 1  4A                   lsr
0004E5r 1  20 rr rr             jsr     @d
0004E8r 1  68                   pla
0004E9r 1  29 0F                and     #$0F
0004EBr 1  C9 0A        @d:     cmp     #10
0004EDr 1  90 02                bcc     @n
0004EFr 1  69 06                adc     #'A' - '0' - 10 - 1
0004F1r 1  69 30        @n:     adc     #'0'
0004F3r 1  8D 1C 7F             sta     VDP_DATA
0004F6r 1  60                   rts
0004F7r 1               
0004F7r 1               ; A (0-99) in decimal, without a leading zero.  Keeps Y.
0004F7r 1  A2 30        prdec:  ldx     #'0'
0004F9r 1  C9 0A        @t:     cmp     #10
0004FBr 1  90 05                bcc     @u
0004FDr 1  E9 0A                sbc     #10
0004FFr 1  E8                   inx
000500r 1  D0 F7                bne     @t
000502r 1  E0 30        @u:     cpx     #'0'
000504r 1  F0 03                beq     @one
000506r 1  8E 1C 7F             stx     VDP_DATA
000509r 1  09 30        @one:   ora     #'0'
00050Br 1  8D 1C 7F             sta     VDP_DATA
00050Er 1  60                   rts
00050Fr 1               
00050Fr 1               ; A as two BCD digits.  Keeps X, Y.
00050Fr 1               prbcd = vdp_bcd
00050Fr 1               
00050Fr 1               ; layer 2: rows Y.. (A of them) see-through again
00050Fr 1               clear_rows:
00050Fr 1  8D rr rr             sta     tmp2
000512r 1  A2 00        @r:     ldx     #0
000514r 1  20 rr rr             jsr     vdp_at
000517r 1  A2 20                ldx     #32
000519r 1  A9 00                lda     #0
00051Br 1  8D 1C 7F     @c:     sta     VDP_DATA
00051Er 1  CA                   dex
00051Fr 1  D0 FA                bne     @c
000521r 1  C8                   iny
000522r 1  CE rr rr             dec     tmp2
000525r 1  D0 EB                bne     @r
000527r 1  60                   rts
000528r 1               
000528r 1               ; layer 2: a box of A rows of spaces (opaque black) from row Y, for text
000528r 1               black_rows:
000528r 1  8D rr rr             sta     tmp2
00052Br 1  A2 00        @r:     ldx     #0
00052Dr 1  20 rr rr             jsr     vdp_at
000530r 1  A2 20                ldx     #32
000532r 1  A9 20                lda     #' '
000534r 1  8D 1C 7F     @c:     sta     VDP_DATA
000537r 1  CA                   dex
000538r 1  D0 FA                bne     @c
00053Ar 1  C8                   iny
00053Br 1  CE rr rr             dec     tmp2
00053Er 1  D0 EB                bne     @r
000540r 1  60                   rts
000541r 1               
000541r 1               .macro MENU_IDLE
000541r 1                       jsr     vdp_frame       ; (a frame at a time: the sound goes on)
000541r 1                       jsr     rand            ; (waiting stirs the random numbers)
000541r 1               .endmacro
000541r 1               
000541r 1               ; ============================================================================
000541r 1               ; the display
000541r 1               ; ============================================================================
000541r 1               
000541r 1               ;
000541r 1               ; set up the VDP: the registers, the tile patterns (2 planes), their
000541r 1               ; attributes, the palette, the F18A's features
000541r 1               gfx_init:
000541r 1  A9 rr                lda     #<vdp_regs
000543r 1  A0 rr                ldy     #>vdp_regs
000545r 1  20 rr rr             jsr     vdp_setup
000548r 1  A9 00                lda     #<V_TP0
00054Ar 1  A0 00                ldy     #>V_TP0
00054Cr 1  20 rr rr             jsr     vdp_waddr
00054Fr 1  A9 rr                lda     #<tile_p0
000551r 1  A2 rr                ldx     #>tile_p0
000553r 1  20 rr rr             jsr     @copy
000556r 1  A9 00                lda     #<V_TP1
000558r 1  A0 08                ldy     #>V_TP1
00055Ar 1  20 rr rr             jsr     vdp_waddr
00055Dr 1  A9 rr                lda     #<tile_p1
00055Fr 1  A2 rr                ldx     #>tile_p1
000561r 1  20 rr rr             jsr     @copy
000564r 1  A9 00                lda     #<V_ATT1
000566r 1  A0 23                ldy     #>V_ATT1
000568r 1  20 rr rr             jsr     vdp_waddr
00056Br 1  20 rr rr             jsr     @attr
00056Er 1  A9 00                lda     #<V_ATT2
000570r 1  A0 24                ldy     #>V_ATT2
000572r 1  20 rr rr             jsr     vdp_waddr
000575r 1  20 rr rr             jsr     @attr
000578r 1  A9 C0                lda     #$C0            ; the palette (R47: the data port writes it,
00057Ar 1  A2 2F                ldx     #47             ; counting up from entry 0)
00057Cr 1  20 rr rr             jsr     vdp_reg
00057Fr 1  A2 00                ldx     #0
000581r 1  BD rr rr     @pl:    lda     pal_data,x
000584r 1  8D 1C 7F             sta     VDP_DATA
000587r 1  E8                   inx
000588r 1  10 F7                bpl     @pl
00058Ar 1  A9 00                lda     #0              ; (the data port: VRAM again)
00058Cr 1  A2 2F                ldx     #47
00058Er 1  20 rr rr             jsr     vdp_reg
000591r 1  A2 00                ldx     #0              ; the F18A registers
000593r 1  8E rr rr     @fr:    stx     tmp
000596r 1  BD rr rr             lda     f18a_regs+1,x
000599r 1  48                   pha
00059Ar 1  BD rr rr             lda     f18a_regs,x
00059Dr 1  AA                   tax
00059Er 1  68                   pla
00059Fr 1  20 rr rr             jsr     vdp_reg
0005A2r 1  AE rr rr             ldx     tmp
0005A5r 1  E8                   inx
0005A6r 1  E8                   inx
0005A7r 1  E0 0E                cpx     #F18A_N * 2
0005A9r 1  D0 E8                bne     @fr
0005ABr 1  20 rr rr             jsr     forget_parts
0005AEr 1  20 rr rr             jsr     no_sprites
0005B1r 1  20 rr rr             jsr     put_sprites
0005B4r 1  A9 C2                lda     #$C2            ; R1: display on, 16 x 16 sprites, no
0005B6r 1  A2 01                ldx     #1              ; interrupt
0005B8r 1  4C rr rr             jmp     vdp_reg
0005BBr 1  8D rr rr     @copy:  sta     vdp_src
0005BEr 1  8E rr rr             stx     vdp_src+1
0005C1r 1  A9 60                lda     #<(NPAT * 8)
0005C3r 1  8D rr rr             sta     vdp_n
0005C6r 1  A9 05                lda     #>(NPAT * 8)
0005C8r 1  8D rr rr             sta     vdp_n+1
0005CBr 1  4C rr rr             jmp     vdp_copy
0005CEr 1  A9 rr        @attr:  lda     #<tile_attr
0005D0r 1  8D rr rr             sta     vdp_src
0005D3r 1  A9 rr                lda     #>tile_attr
0005D5r 1  8D rr rr             sta     vdp_src+1
0005D8r 1  A9 00                lda     #0
0005DAr 1  8D rr rr             sta     vdp_n
0005DDr 1  A9 01                lda     #1
0005DFr 1  8D rr rr             sta     vdp_n+1
0005E2r 1  4C rr rr             jmp     vdp_copy
0005E5r 1               
0005E5r 1               ; a text screen: layer 1 blank, black, no scroll, no sprites, layer 2 clear
0005E5r 1               text_screen:
0005E5r 1  20 rr rr             jsr     no_sprites
0005E8r 1  20 rr rr             jsr     put_sprites
0005EBr 1  A9 00                lda     #0
0005EDr 1  A2 1B                ldx     #27
0005EFr 1  20 rr rr             jsr     vdp_reg
0005F2r 1  A9 06                lda     #V_NAME1/$400
0005F4r 1  A2 02                ldx     #2
0005F6r 1  20 rr rr             jsr     vdp_reg
0005F9r 1  A9 01                lda     #$01            ; R7: black
0005FBr 1  A2 07                ldx     #7
0005FDr 1  20 rr rr             jsr     vdp_reg
000600r 1  A9 00                lda     #<V_NAME1
000602r 1  A0 18                ldy     #>V_NAME1
000604r 1  20 rr rr             jsr     vdp_waddr
000607r 1  A9 00                lda     #0
000609r 1  8D rr rr             sta     vdp_n
00060Cr 1  A9 08                lda     #8
00060Er 1  8D rr rr             sta     vdp_n+1
000611r 1  A9 00                lda     #0
000613r 1  20 rr rr             jsr     vdp_fill
000616r 1  A0 00                ldy     #0
000618r 1  A9 18                lda     #24
00061Ar 1  4C rr rr             jmp     clear_rows
00061Dr 1               
00061Dr 1               ; the sprite table: none
00061Dr 1               no_sprites:
00061Dr 1  A9 D0                lda     #$D0
00061Fr 1  8D rr rr             sta     spr_tab
000622r 1  A9 00                lda     #0
000624r 1  8D rr rr             sta     nspr
000627r 1  60                   rts
000628r 1               
000628r 1               ; the sprite table to VRAM (in the frame's blank, best): first the parts
000628r 1               ; that changed into their sprites' patterns
000628r 1               put_sprites:
000628r 1  A2 00                ldx     #0
00062Ar 1  EC rr rr     @pp:    cpx     nspr
00062Dr 1  B0 17                bcs     @tab
00062Fr 1  BD rr rr             lda     sl_want,x
000632r 1  DD rr rr             cmp     sl_have,x
000635r 1  F0 0C                beq     @pn
000637r 1  9D rr rr             sta     sl_have,x
00063Ar 1  8E rr rr             stx     ps_k
00063Dr 1  20 rr rr             jsr     load_part
000640r 1  AE rr rr             ldx     ps_k
000643r 1  E8           @pn:    inx
000644r 1  D0 E4                bne     @pp
000646r 1  A9 00        @tab:   lda     #<V_SATTR
000648r 1  A0 25                ldy     #>V_SATTR
00064Ar 1  20 rr rr             jsr     vdp_waddr
00064Dr 1  A2 00                ldx     #0
00064Fr 1  BD rr rr     @l:     lda     spr_tab,x
000652r 1  8D 1C 7F             sta     VDP_DATA
000655r 1  C9 D0                cmp     #$D0            ; (the end: only on a Y byte)
000657r 1  D0 05                bne     @n
000659r 1  8A                   txa
00065Ar 1  29 03                and     #3
00065Cr 1  F0 03                beq     @r
00065Er 1  E8           @n:     inx
00065Fr 1  D0 EE                bne     @l
000661r 1  60           @r:     rts
000662r 1               
000662r 1               ; part A into sprite X's pattern: 32 bytes into each plane
000662r 1               load_part:
000662r 1  8D rr rr             sta     tmp                     ; spr_parts + part * 64
000665r 1  A9 00                lda     #0
000667r 1  8D rr rr             sta     tmp+1
00066Ar 1  A0 06                ldy     #6
00066Cr 1  0E rr rr     @m:     asl     tmp
00066Fr 1  2E rr rr             rol     tmp+1
000672r 1  88                   dey
000673r 1  D0 F7                bne     @m
000675r 1  AD rr rr             lda     tmp
000678r 1  18                   clc
000679r 1  69 rr                adc     #<spr_parts
00067Br 1  8D rr rr             sta     @a+1
00067Er 1  8D rr rr             sta     @b+1
000681r 1  AD rr rr             lda     tmp+1
000684r 1  69 rr                adc     #>spr_parts
000686r 1  8D rr rr             sta     @a+2
000689r 1  8D rr rr             sta     @b+2
00068Cr 1  8A                   txa                             ; V_SP0 / V_SP1 + 32 x
00068Dr 1  4A                   lsr
00068Er 1  4A                   lsr
00068Fr 1  4A                   lsr
000690r 1  8D rr rr             sta     tmp+1
000693r 1  8A                   txa
000694r 1  0A                   asl
000695r 1  0A                   asl
000696r 1  0A                   asl
000697r 1  0A                   asl
000698r 1  0A                   asl
000699r 1  8D rr rr             sta     tmp
00069Cr 1  AD rr rr             lda     tmp+1
00069Fr 1  18                   clc
0006A0r 1  69 10                adc     #>V_SP0
0006A2r 1  A8                   tay
0006A3r 1  AD rr rr             lda     tmp
0006A6r 1  20 rr rr             jsr     vdp_waddr
0006A9r 1  A2 00                ldx     #0
0006ABr 1  BD FF FF     @a:     lda     $FFFF,x
0006AEr 1  8D 1C 7F             sta     VDP_DATA
0006B1r 1  E8                   inx
0006B2r 1  E0 20                cpx     #32
0006B4r 1  D0 F5                bne     @a
0006B6r 1  AD rr rr             lda     tmp+1
0006B9r 1  18                   clc
0006BAr 1  69 14                adc     #>V_SP1
0006BCr 1  A8                   tay
0006BDr 1  AD rr rr             lda     tmp
0006C0r 1  20 rr rr             jsr     vdp_waddr
0006C3r 1  BD FF FF     @b:     lda     $FFFF,x                 ; (x 32-63: plane 1)
0006C6r 1  8D 1C 7F             sta     VDP_DATA
0006C9r 1  E8                   inx
0006CAr 1  E0 40                cpx     #64
0006CCr 1  D0 F5                bne     @b
0006CEr 1  60                   rts
0006CFr 1               
0006CFr 1               ; every sprite's part forgotten (they are loaded again)
0006CFr 1               forget_parts:
0006CFr 1  A2 1F                ldx     #31
0006D1r 1  A9 FF                lda     #$FF
0006D3r 1  9D rr rr     @f:     sta     sl_have,x
0006D6r 1  CA                   dex
0006D7r 1  10 FA                bpl     @f
0006D9r 1  60                   rts
0006DAr 1               
0006DAr 1               ; ---- the level on layer 1 ---------------------------------------------------------
0006DAr 1               
0006DAr 1               ; put tile htc, htr on the screen (into the ring).  Preserves X.
0006DAr 1               put_tile:
0006DAr 1  8E rr rr             stx     pt_x
0006DDr 1  AD rr rr             lda     htr             ; the map row's page
0006E0r 1  18                   clc
0006E1r 1  69 rr                adc     #>map
0006E3r 1  8D rr rr             sta     @m+2
0006E6r 1  AC rr rr             ldy     htc
0006E9r 1  BE rr rr     @m:     ldx     map,y           ; tile code (number * 4)
0006ECr 1  AD rr rr             lda     htc             ; ring column: (htc & 31) * 2 cells, page
0006EFr 1  29 0F                and     #15             ; (htc & 16)
0006F1r 1  0A                   asl
0006F2r 1  8D rr rr             sta     pt_cc
0006F5r 1  AD rr rr             lda     htc
0006F8r 1  29 10                and     #16
0006FAr 1  4A                   lsr
0006FBr 1  4A                   lsr                     ; page 1: +4 to the address' high byte
0006FCr 1  8D rr rr             sta     pt_pg
0006FFr 1  AD rr rr             lda     htr             ; cell row 2 + 2 * htr: address = row * 32
000702r 1  0A                   asl
000703r 1  18                   clc
000704r 1  69 02                adc     #2
000706r 1  8D rr rr             sta     pt_r
000709r 1  20 rr rr             jsr     @addr
00070Cr 1  BD rr rr             lda     tile_nm,x
00070Fr 1  8D 1C 7F             sta     VDP_DATA
000712r 1  BD rr rr             lda     tile_nm+1,x
000715r 1  8D 1C 7F             sta     VDP_DATA
000718r 1  EE rr rr             inc     pt_r
00071Br 1  20 rr rr             jsr     @addr
00071Er 1  BD rr rr             lda     tile_nm+2,x
000721r 1  8D 1C 7F             sta     VDP_DATA
000724r 1  BD rr rr             lda     tile_nm+3,x
000727r 1  8D 1C 7F             sta     VDP_DATA
00072Ar 1  AE rr rr             ldx     pt_x
00072Dr 1  60                   rts
00072Er 1  AD rr rr     @addr:  lda     pt_r            ; low: (row & 7) * 32 + column
000731r 1  0A                   asl
000732r 1  0A                   asl
000733r 1  0A                   asl
000734r 1  0A                   asl
000735r 1  0A                   asl
000736r 1  0D rr rr             ora     pt_cc
000739r 1  8D 1D 7F             sta     VDP_CTRL
00073Cr 1  AD rr rr             lda     pt_r            ; high: row / 8 + page + write
00073Fr 1  4A                   lsr
000740r 1  4A                   lsr
000741r 1  4A                   lsr
000742r 1  0D rr rr             ora     pt_pg
000745r 1  09 58                ora     #$40 + >V_NAME1
000747r 1  8D 1D 7F             sta     VDP_CTRL
00074Ar 1  60                   rts
00074Br 1               
00074Br 1               ; tile column A, all 11 rows
00074Br 1               put_col:
00074Br 1  8D rr rr             sta     htc
00074Er 1  AD rr rr             lda     htr
000751r 1  48                   pha
000752r 1  A9 00                lda     #0
000754r 1  8D rr rr             sta     htr
000757r 1  20 rr rr     @r:     jsr     put_tile
00075Ar 1  EE rr rr             inc     htr
00075Dr 1  AD rr rr             lda     htr
000760r 1  C9 0B                cmp     #MAPROWS
000762r 1  D0 F3                bne     @r
000764r 1  68                   pla
000765r 1  8D rr rr             sta     htr
000768r 1  60                   rts
000769r 1               
000769r 1               ; the tile at htc, htr changed (the map has it): draw it if it is in the ring
000769r 1               tile_changed:
000769r 1  AD rr rr             lda     htc             ; htc - the view's first tile: 0 .. VIEW_T + 1?
00076Cr 1  38                   sec
00076Dr 1  ED rr rr             sbc     cam_t
000770r 1  C9 12                cmp     #VIEW_T + 2
000772r 1  B0 0B                bcs     @r
000774r 1  AD rr rr             lda     htc             ; (and drawn already)
000777r 1  CD rr rr             cmp     drawn_hi
00077Ar 1  B0 03                bcs     @r
00077Cr 1  4C rr rr             jmp     put_tile
00077Fr 1  60           @r:     rts
000780r 1               
000780r 1               ; put tile A at htc, htr and show it
000780r 1               set_tile:
000780r 1  48                   pha
000781r 1  AD rr rr             lda     htr
000784r 1  18                   clc
000785r 1  69 rr                adc     #>map
000787r 1  8D rr rr             sta     @w+2
00078Ar 1  AC rr rr             ldy     htc
00078Dr 1  68                   pla
00078Er 1  99 rr rr     @w:     sta     map,y
000791r 1  4C rr rr             jmp     tile_changed
000794r 1               
000794r 1               ; ---- each frame: the scroll, new columns, the sprites ----------------------------
000794r 1  AD rr rr     render: lda     sc2+1           ; cam_t = the view's first tile (sc2 / 8)
000797r 1  8D rr rr             sta     tmp
00079Ar 1  AD rr rr             lda     sc2
00079Dr 1  4E rr rr             lsr     tmp
0007A0r 1  6A                   ror
0007A1r 1  4E rr rr             lsr     tmp
0007A4r 1  6A                   ror
0007A5r 1  4E rr rr             lsr     tmp
0007A8r 1  6A                   ror
0007A9r 1  8D rr rr             sta     cam_t
0007ACr 1  AD rr rr             lda     full            ; all of it again?
0007AFr 1  F0 0B                beq     @cols
0007B1r 1  A9 00                lda     #0
0007B3r 1  8D rr rr             sta     full
0007B6r 1  AD rr rr             lda     cam_t
0007B9r 1  8D rr rr             sta     drawn_hi
0007BCr 1  AD rr rr     @cols:  lda     cam_t           ; draw up to the view's last tile + 1
0007BFr 1  18                   clc
0007C0r 1  69 11                adc     #VIEW_T + 1
0007C2r 1  90 02                bcc     @c1
0007C4r 1  A9 FF                lda     #$FF
0007C6r 1  8D rr rr     @c1:    sta     tmp2
0007C9r 1  AD rr rr     @c:     lda     drawn_hi
0007CCr 1  CD rr rr             cmp     tmp2
0007CFr 1  F0 02                beq     @c2
0007D1r 1  B0 08                bcs     @spr
0007D3r 1  20 rr rr     @c2:    jsr     put_col
0007D6r 1  EE rr rr             inc     drawn_hi
0007D9r 1  D0 EE                bne     @c              ; (column 255: the end)
0007DBr 1  4C rr rr     @spr:   jmp     make_sprites
0007DEr 1               
0007DEr 1               ; the hardware scroll: screen x = sc2 * 2 (mod 512).  In the frame's blank.
0007DEr 1               set_scroll:
0007DEr 1  AD rr rr             lda     sc2
0007E1r 1  0A                   asl
0007E2r 1  A2 1B                ldx     #27
0007E4r 1  20 rr rr             jsr     vdp_reg
0007E7r 1  AD rr rr             lda     sc2+1
0007EAr 1  2A                   rol
0007EBr 1  29 01                and     #1
0007EDr 1  09 06                ora     #V_NAME1/$400
0007EFr 1  A2 02                ldx     #2
0007F1r 1  4C rr rr             jmp     vdp_reg
0007F4r 1               
0007F4r 1               ; the sprite table for this frame (MOS first: on top)
0007F4r 1               make_sprites:
0007F4r 1  A9 00                lda     #0
0007F6r 1  8D rr rr             sta     nspr
0007F9r 1  A2 00                ldx     #O_MOS
0007FBr 1  AD rr rr             lda     o_kind
0007FEr 1  F0 08                beq     @objs
000800r 1  20 rr rr             jsr     mos_frame
000803r 1  B0 03                bcs     @objs
000805r 1  20 rr rr             jsr     add_obj
000808r 1  A2 01        @objs:  ldx     #1
00080Ar 1  8E rr rr     @l:     stx     ms_i
00080Dr 1  BD rr rr             lda     o_kind,x
000810r 1  F0 0B                beq     @n
000812r 1  20 rr rr             jsr     obj_frame
000815r 1  B0 06                bcs     @n
000817r 1  AE rr rr             ldx     ms_i
00081Ar 1  20 rr rr             jsr     add_obj
00081Dr 1  AE rr rr     @n:     ldx     ms_i
000820r 1  E8                   inx
000821r 1  E0 0A                cpx     #NOBJ
000823r 1  D0 E5                bne     @l
000825r 1  AD rr rr             lda     nspr            ; the end of the list
000828r 1  0A                   asl
000829r 1  0A                   asl
00082Ar 1  AA                   tax
00082Br 1  A9 D0                lda     #$D0
00082Dr 1  9D rr rr             sta     spr_tab,x
000830r 1  60                   rts
000831r 1               
000831r 1               ; object X with picture A (mirrored if smir): its blocks into the table
000831r 1               add_obj:
000831r 1  0A                   asl
000832r 1  0D rr rr             ora     smir
000835r 1  A8                   tay
000836r 1  B9 rr rr             lda     sp_lo,y
000839r 1  8D rr rr             sta     @rd+1
00083Cr 1  B9 rr rr             lda     sp_hi,y
00083Fr 1  8D rr rr             sta     @rd+2
000842r 1  38                   sec                     ; x on the screen (game pixels): x - sc2
000843r 1  BD rr rr             lda     o_xl,x
000846r 1  ED rr rr             sbc     sc2
000849r 1  8D rr rr             sta     ao_x
00084Cr 1  BD rr rr             lda     o_xh,x
00084Fr 1  ED rr rr             sbc     sc2+1
000852r 1  8D rr rr             sta     ao_x+1
000855r 1  BD rr rr             lda     o_y,x           ; y (signed: above the view is negative)
000858r 1  8D rr rr             sta     ao_y
00085Br 1  A0 00                ldy     #0
00085Dr 1  20 rr rr             jsr     @rd             ; the count
000860r 1  8D rr rr             sta     ao_n
000863r 1  D0 03                bne     @b
000865r 1  4C rr rr             jmp     @r
000868r 1  AD rr rr     @b:     lda     nspr
00086Br 1  C9 1F                cmp     #MAXSPR
00086Dr 1  90 03                bcc     :+
00086Fr 1  4C rr rr             jmp     @r
000872r 1  C8           :       iny
000873r 1  20 rr rr             jsr     @rd             ; dx (signed)
000876r 1  8D rr rr             sta     tmp
000879r 1  C8                   iny
00087Ar 1  20 rr rr             jsr     @rd             ; dy
00087Dr 1  8D rr rr             sta     tmp2
000880r 1  C8                   iny
000881r 1  20 rr rr             jsr     @rd
000884r 1  8D rr rr             sta     ao_p            ; part
000887r 1  C8                   iny
000888r 1  20 rr rr             jsr     @rd
00088Br 1  8D rr rr             sta     ao_c            ; attribute: colour group, flip
00088Er 1  8C rr rr             sty     ao_i
000891r 1                       ; screen x = (x + dx) * 2: -16..255 shows (negative: the early clock)
000891r 1  AD rr rr             lda     tmp
000894r 1  10 03                bpl     :+
000896r 1  CE rr rr             dec     ao_x+1          ; (sign-extend dx)
000899r 1  18           :       clc
00089Ar 1  6D rr rr             adc     ao_x
00089Dr 1  8D rr rr             sta     ao_sx
0008A0r 1  AD rr rr             lda     ao_x+1
0008A3r 1  69 00                adc     #0
0008A5r 1  8D rr rr             sta     ao_sx+1
0008A8r 1  AD rr rr             lda     tmp             ; (undo the sign extension for the next)
0008ABr 1  10 03                bpl     :+
0008ADr 1  EE rr rr             inc     ao_x+1
0008B0r 1  0E rr rr     :       asl     ao_sx
0008B3r 1  2E rr rr             rol     ao_sx+1
0008B6r 1  AD rr rr             lda     ao_sx+1
0008B9r 1  F0 1E                beq     @xok            ; 0..255
0008BBr 1  C9 FF                cmp     #$FF
0008BDr 1  F0 03                beq     :+
0008BFr 1  4C rr rr             jmp     @skip
0008C2r 1               :
0008C2r 1  AD rr rr             lda     ao_sx           ; -32..-1: early clock, x + 32
0008C5r 1  C9 E0                cmp     #$E0
0008C7r 1  B0 03                bcs     :+
0008C9r 1  4C rr rr             jmp     @skip
0008CCr 1  69 1F        :       adc     #31             ; (carry set: +32)
0008CEr 1  8D rr rr             sta     ao_sx
0008D1r 1  AD rr rr             lda     ao_c
0008D4r 1  09 80                ora     #$80
0008D6r 1  8D rr rr             sta     ao_c
0008D9r 1               @xok:   ; screen y = (y + dy) * 2 + TOP_Y: the top, -16 .. 191 shows
0008D9r 1  AD rr rr             lda     ao_y
0008DCr 1  18                   clc
0008DDr 1  6D rr rr             adc     tmp2
0008E0r 1  8D rr rr             sta     tmp
0008E3r 1  A9 00                lda     #0              ; (y is signed: bit 7)
0008E5r 1  2C rr rr             bit     ao_y
0008E8r 1  10 02                bpl     :+
0008EAr 1  A9 FF                lda     #$FF
0008ECr 1  69 00        :       adc     #0
0008EEr 1  8D rr rr             sta     tmp+1
0008F1r 1  0E rr rr             asl     tmp
0008F4r 1  2E rr rr             rol     tmp+1
0008F7r 1  AD rr rr             lda     tmp
0008FAr 1  18                   clc
0008FBr 1  69 10                adc     #TOP_Y
0008FDr 1  8D rr rr             sta     tmp
000900r 1  90 03                bcc     :+
000902r 1  EE rr rr             inc     tmp+1
000905r 1  AD rr rr     :       lda     tmp+1
000908r 1  F0 0D                beq     @yok            ; 0..255: under 192 only
00090Ar 1  C9 FF                cmp     #$FF
00090Cr 1  D0 42                bne     @skip
00090Er 1  AD rr rr             lda     tmp
000911r 1  C9 F0                cmp     #$F0            ; -16..-1
000913r 1  90 3B                bcc     @skip
000915r 1  B0 07                bcs     @yset
000917r 1  AD rr rr     @yok:   lda     tmp
00091Ar 1  C9 C0                cmp     #192
00091Cr 1  B0 32                bcs     @skip
00091Er 1  AD rr rr     @yset:  lda     nspr            ; into the table: y - 1, x, pattern, colour
000921r 1  0A                   asl
000922r 1  0A                   asl
000923r 1  AA                   tax
000924r 1  AD rr rr             lda     tmp
000927r 1  38                   sec
000928r 1  E9 01                sbc     #1
00092Ar 1  C9 D0                cmp     #$D0            ; ($D0 would end the list)
00092Cr 1  D0 02                bne     :+
00092Er 1  A9 D1                lda     #$D1
000930r 1  9D rr rr     :       sta     spr_tab,x
000933r 1  AD rr rr             lda     ao_sx
000936r 1  9D rr rr             sta     spr_tab+1,x
000939r 1  8A                   txa                     ; its own pattern: names 4 n (= x)
00093Ar 1  9D rr rr             sta     spr_tab+2,x
00093Dr 1  AD rr rr             lda     ao_c
000940r 1  9D rr rr             sta     spr_tab+3,x
000943r 1  8A                   txa                     ; ... and its part
000944r 1  4A                   lsr
000945r 1  4A                   lsr
000946r 1  AA                   tax
000947r 1  AD rr rr             lda     ao_p
00094Ar 1  9D rr rr             sta     sl_want,x
00094Dr 1  EE rr rr             inc     nspr
000950r 1  AC rr rr     @skip:  ldy     ao_i
000953r 1  CE rr rr             dec     ao_n
000956r 1  F0 03                beq     @r
000958r 1  4C rr rr             jmp     @b
00095Br 1  AE rr rr     @r:     ldx     ms_i
00095Er 1  60                   rts
00095Fr 1  B9 FF FF     @rd:    lda     $FFFF,y
000962r 1  60                   rts
000963r 1               
000963r 1               ; ---- the frame's timing --------------------------------------------------------
000963r 1               ; a game frame is speed frames: wait for them (the first comes at once if
000963r 1               ; the game's work took longer than a frame), then show it: the scroll and
000963r 1               ; the sprites go in at the start of the frame's blank.
000963r 1  AD rr rr     pace:   lda     speed
000966r 1  8D rr rr             sta     wf_n
000969r 1  20 rr rr     @w:     jsr     vdp_frame
00096Cr 1  CE rr rr             dec     wf_n
00096Fr 1  D0 F8                bne     @w
000971r 1  20 rr rr             jsr     set_scroll
000974r 1  4C rr rr             jmp     put_sprites
000977r 1               
000977r 1               ; ============================================================================
000977r 1               ; gamepad and menu input (shared by the SBC games)
000977r 1               ; ============================================================================
000977r 1               PAD_A           = $01           ; bits returned by SBC_PADSTATE
000977r 1               PAD_B           = $02
000977r 1               PAD_SELECT      = $04
000977r 1               PAD_START       = $08
000977r 1               PAD_UP          = $10
000977r 1               PAD_DOWN        = $20
000977r 1               PAD_LEFT        = $40
000977r 1               PAD_RIGHT       = $80
000977r 1               PAD_GO          = $80           ; menu_key's answer for gamepad A or Start
000977r 1               
000977r 1               ; read the gamepad: pad = buttons held now, padnew = buttons pressed since
000977r 1               ; the last call.  Preserves X and Y (SBC_PADSTATE only changes A).
000977r 1               read_pad:
000977r 1  20 12 FE             jsr     SBC_PADSTATE
00097Ar 1  C9 FF                cmp     #$FF            ; every button "pressed" = no pad
00097Cr 1  D0 02                bne     @ok
00097Er 1  A9 00                lda     #0
000980r 1  8D rr rr     @ok:    sta     pad
000983r 1  AD rr rr             lda     padold
000986r 1  49 FF                eor     #$FF
000988r 1  2D rr rr             and     pad
00098Br 1  8D rr rr             sta     padnew
00098Er 1  AD rr rr             lda     pad
000991r 1  8D rr rr             sta     padold
000994r 1  60                   rts
000995r 1               
000995r 1               ; throw away waiting characters
000995r 1               flush_in:
000995r 1  20 00 FE             jsr     getc
000998r 1  B0 FB                bcs     flush_in
00099Ar 1  60                   rts
00099Br 1               
00099Br 1               ; carry set if A is one of the characters the gamepad driver types for the
00099Br 1               ; pad (W A S D and space).  Those are ignored in gamepad mode so that one
00099Br 1               ; press doesn't act twice.  Preserves A.
00099Br 1               pad_typed:
00099Br 1  C9 20                cmp     #' '
00099Dr 1  F0 12                beq     @y
00099Fr 1  C9 57                cmp     #'W'
0009A1r 1  F0 0E                beq     @y
0009A3r 1  C9 41                cmp     #'A'
0009A5r 1  F0 0A                beq     @y
0009A7r 1  C9 53                cmp     #'S'
0009A9r 1  F0 06                beq     @y
0009ABr 1  C9 44                cmp     #'D'
0009ADr 1  F0 02                beq     @y
0009AFr 1  18                   clc
0009B0r 1  60                   rts
0009B1r 1  38           @y:     sec
0009B2r 1  60                   rts
0009B3r 1               
0009B3r 1               ; wait for a menu choice.  Returns a key (letters in upper case), or
0009B3r 1               ; PAD_GO for the gamepad's A or Start button.
0009B3r 1               menu_key:
0009B3r 1  20 rr rr 20  @l:     MENU_IDLE
0009B7r 1  rr rr        
0009B9r 1  20 rr rr             jsr     read_pad
0009BCr 1  AD rr rr             lda     padnew
0009BFr 1  29 09                and     #PAD_A | PAD_START
0009C1r 1  D0 21                bne     @pad
0009C3r 1  20 00 FE             jsr     getc
0009C6r 1  90 EB                bcc     @l
0009C8r 1  C9 20                cmp     #' '            ; a space typed by the pad's A button?
0009CAr 1  D0 0D                bne     @up
0009CCr 1  20 rr rr             jsr     read_pad
0009CFr 1  AD rr rr             lda     pad
0009D2r 1  29 01                and     #PAD_A
0009D4r 1  D0 0E                bne     @pad
0009D6r 1  A9 20                lda     #' '
0009D8r 1  60                   rts
0009D9r 1  C9 61        @up:    cmp     #'a'
0009DBr 1  90 06                bcc     @r
0009DDr 1  C9 7B                cmp     #'z'+1
0009DFr 1  B0 02                bcs     @r
0009E1r 1  29 DF                and     #$DF
0009E3r 1  60           @r:     rts
0009E4r 1  20 rr rr     @pad:   jsr     flush_in        ; the space the driver typed for it
0009E7r 1  A9 80                lda     #PAD_GO
0009E9r 1  60                   rts
0009EAr 1               
0009EAr 1               
0009EAr 1               
0009EAr 1               ; ============================================================================
0009EAr 1               ; start, title
0009EAr 1               ; ============================================================================
0009EAr 1  D8           start:  cld
0009EBr 1  A2 FF                ldx     #$FF
0009EDr 1  9A                   txs
0009EEr 1  A9 00                lda     #0              ; clear the variables (RAM is random at power-up)
0009F0r 1  AA                   tax
0009F1r 1  A0 04                ldy     #>(bss_end - bss_start + $FF)
0009F3r 1  9D rr rr     @c1:    sta     bss_start,x
0009F6r 1  E8                   inx
0009F7r 1  D0 FA                bne     @c1
0009F9r 1  EE rr rr             inc     @c1+2
0009FCr 1  88                   dey
0009FDr 1  D0 F4                bne     @c1
0009FFr 1  AD rr rr             lda     ctrl_def
000A02r 1  8D rr rr             sta     ctrl
000A05r 1  A9 5A                lda     #$5A
000A07r 1  8D rr rr             sta     rng
000A0Ar 1                       ; the PICO9918?  (CPU Rev2 ROM: a JMP at $FE1B, SBC_SYSINFO)
000A0Ar 1  AD 1B FE             lda     SBC_SYSINFO
000A0Dr 1  C9 4C                cmp     #$4C
000A0Fr 1  D0 07                bne     @nopico
000A11r 1  20 1B FE             jsr     SBC_SYSINFO
000A14r 1  C9 02                cmp     #DISP_PICO
000A16r 1  F0 10                beq     @pico
000A18r 1               @nopico:
000A18r 1  A2 00                ldx     #0
000A1Ar 1  BD rr rr     @m:     lda     need_txt,x
000A1Dr 1  F0 06                beq     @bye
000A1Fr 1  20 03 FE             jsr     SBC_CHROUT
000A22r 1  E8                   inx
000A23r 1  D0 F5                bne     @m
000A25r 1  4C 06 FE     @bye:   jmp     SBC_MENU
000A28r 1  20 rr rr     @pico:  jsr     sfx_init
000A2Br 1  AD rr rr             lda     mute_def
000A2Er 1  8D rr rr             sta     sfx_mute
000A31r 1  20 rr rr             jsr     gfx_init
000A34r 1               
000A34r 1  20 rr rr     title:  jsr     sfx_off
000A37r 1  20 rr rr             jsr     text_screen
000A3Ar 1  20 rr rr             jsr     title_scene
000A3Dr 1  A9 rr                lda     #<title_txt
000A3Fr 1  A0 rr                ldy     #>title_txt
000A41r 1  20 rr rr             jsr     print_table
000A44r 1  A2 12                ldx     #18
000A46r 1  A0 0D                ldy     #13
000A48r 1  20 rr rr             jsr     vdp_at
000A4Br 1  AD rr rr             lda     hiscore+2
000A4Er 1  20 rr rr             jsr     prhex
000A51r 1  AD rr rr             lda     hiscore+1
000A54r 1  20 rr rr             jsr     prhex
000A57r 1  AD rr rr             lda     hiscore
000A5Ar 1  20 rr rr             jsr     prhex
000A5Dr 1  20 rr rr             jsr     show_ctrl
000A60r 1  20 rr rr             jsr     read_pad
000A63r 1  20 rr rr             jsr     flush_in
000A66r 1  20 rr rr     @wait:  jsr     menu_key
000A69r 1  C9 51                cmp     #'Q'
000A6Br 1  D0 03                bne     @notq
000A6Dr 1  4C rr rr             jmp     exit_game
000A70r 1  C9 4D        @notq:  cmp     #'M'            ; sound on / off
000A72r 1  D0 06                bne     @notm
000A74r 1  20 rr rr             jsr     toggle_sound
000A77r 1  4C rr rr             jmp     @wait
000A7Ar 1  C9 47        @notm:  cmp     #'G'
000A7Cr 1  D0 0E                bne     @notg
000A7Er 1  AD rr rr             lda     ctrl
000A81r 1  49 01                eor     #1
000A83r 1  8D rr rr             sta     ctrl
000A86r 1  20 rr rr             jsr     show_ctrl
000A89r 1  4C rr rr             jmp     @wait
000A8Cr 1  C9 80        @notg:  cmp     #PAD_GO
000A8Er 1  D0 08                bne     @notp
000A90r 1  A9 01                lda     #1
000A92r 1  8D rr rr             sta     ctrl
000A95r 1  4C rr rr             jmp     new_game
000A98r 1  C9 20        @notp:  cmp     #' '
000A9Ar 1  D0 CA                bne     @wait
000A9Cr 1  4C rr rr             jmp     new_game
000A9Fr 1               
000A9Fr 1               ; the title's picture: some ground, a pipe, a ? block, a brick, MOS (layer 1)
000A9Fr 1               title_scene:
000A9Fr 1  A2 00                ldx     #0              ; an empty map
000AA1r 1  8A                   txa
000AA2r 1  9D rr rr 9D  @clr:   .repeat MAPROWS, K
000AA6r 1  rr rr 9D rr  
000AAAr 1  rr 9D rr rr  
000AC3r 1                       sta     map + K * 256,x
000AC3r 1                       .endrepeat
000AC3r 1  E8                   inx
000AC4r 1  D0 DC                bne     @clr
000AC6r 1  A2 0F                ldx     #15
000AC8r 1  A9 04        @g:     lda     #T_GROUND
000ACAr 1  9D rr rr             sta     map + 10 * 256,x
000ACDr 1  9D rr rr             sta     map + 9 * 256,x
000AD0r 1  CA                   dex
000AD1r 1  10 F5                bpl     @g
000AD3r 1  A9 1C                lda     #T_PIPETL
000AD5r 1  8D rr rr             sta     map + 7 * 256 + 12
000AD8r 1  A9 20                lda     #T_PIPETR
000ADAr 1  8D rr rr             sta     map + 7 * 256 + 13
000ADDr 1  A9 24                lda     #T_PIPEL
000ADFr 1  8D rr rr             sta     map + 8 * 256 + 12
000AE2r 1  A9 28                lda     #T_PIPER
000AE4r 1  8D rr rr             sta     map + 8 * 256 + 13
000AE7r 1  A9 00                lda     #0
000AE9r 1  8D rr rr             sta     sc2
000AECr 1  8D rr rr             sta     sc2+1
000AEFr 1  A9 05                lda     #$05            ; R7: sky
000AF1r 1  A2 07                ldx     #7
000AF3r 1  20 rr rr             jsr     vdp_reg
000AF6r 1  A9 01                lda     #1
000AF8r 1  8D rr rr             sta     full
000AFBr 1  A9 00                lda     #0              ; MOS on the ground, and an AND gate
000AFDr 1  A2 09                ldx     #NOBJ-1
000AFFr 1  9D rr rr     @o:     sta     o_kind,x
000B02r 1  CA                   dex
000B03r 1  10 FA                bpl     @o
000B05r 1  20 rr rr             jsr     clear_obj0
000B08r 1  A9 01                lda     #K_MOS
000B0Ar 1  8D rr rr             sta     o_kind
000B0Dr 1  A9 28                lda     #40
000B0Fr 1  8D rr rr             sta     o_xl
000B12r 1  A9 40                lda     #64
000B14r 1  8D rr rr             sta     o_y
000B17r 1  A9 01                lda     #1
000B19r 1  8D rr rr             sta     onground
000B1Cr 1  A2 01                ldx     #1
000B1Er 1  20 rr rr             jsr     clear_obj
000B21r 1  A9 02                lda     #K_BUG
000B23r 1  8D rr rr             sta     o_kind+1
000B26r 1  A9 50                lda     #80
000B28r 1  8D rr rr             sta     o_xl+1
000B2Br 1  A9 40                lda     #64
000B2Dr 1  8D rr rr             sta     o_y+1
000B30r 1  A9 00                lda     #0
000B32r 1  8D rr rr             sta     big
000B35r 1  8D rr rr             sta     mstate
000B38r 1  8D rr rr             sta     duck
000B3Br 1  8D rr rr             sta     inv_t
000B3Er 1  8D rr rr             sta     oc_t
000B41r 1  8D rr rr             sta     facing
000B44r 1  20 rr rr             jsr     render
000B47r 1  20 rr rr             jsr     set_scroll
000B4Ar 1  4C rr rr             jmp     put_sprites
000B4Dr 1               
000B4Dr 1               exit_game:
000B4Dr 1  20 rr rr             jsr     sfx_off
000B50r 1  A9 C0                lda     #$C0            ; the PICO9918 back to its defaults (VR50: a
000B52r 1  A2 32                ldx     #50             ; reset, the palette too)
000B54r 1  20 rr rr             jsr     vdp_reg
000B57r 1  20 39 FE             jsr     SBC_CONRESET    ; the console's text screen back
000B5Ar 1  4C 06 FE             jmp     SBC_MENU
000B5Dr 1               
000B5Dr 1               ; the controls line on the title screen
000B5Dr 1               show_ctrl:
000B5Dr 1  A2 01                ldx     #1
000B5Fr 1  A0 0F                ldy     #15
000B61r 1  20 rr rr             jsr     vdp_at
000B64r 1  AD rr rr             lda     ctrl
000B67r 1  F0 07                beq     @kb
000B69r 1  A9 rr                lda     #<ctrl_pad_txt
000B6Br 1  A0 rr                ldy     #>ctrl_pad_txt
000B6Dr 1  4C rr rr             jmp     vdp_puts
000B70r 1  A9 rr        @kb:    lda     #<ctrl_kb_txt
000B72r 1  A0 rr                ldy     #>ctrl_kb_txt
000B74r 1  4C rr rr             jmp     vdp_puts
000B77r 1               
000B77r 1               ; ============================================================================
000B77r 1               ; a game
000B77r 1               ; ============================================================================
000B77r 1               new_game:
000B77r 1  A9 00                lda     #0
000B79r 1  8D rr rr             sta     score
000B7Cr 1  8D rr rr             sta     score+1
000B7Fr 1  8D rr rr             sta     score+2
000B82r 1  8D rr rr             sta     bits
000B85r 1  8D rr rr             sta     bytes
000B88r 1  8D rr rr             sta     lvl
000B8Br 1  8D rr rr             sta     big
000B8Er 1  8D rr rr             sta     fire
000B91r 1  A9 01                lda     #1
000B93r 1  8D rr rr             sta     world
000B96r 1  8D rr rr             sta     wsrc
000B99r 1  A9 03                lda     #3
000B9Br 1  8D rr rr             sta     lives
000B9Er 1               
000B9Er 1               ; ---- a level: "CELL 1-1  MOS x 3" for a moment, then play -------------------------
000B9Er 1               start_level:
000B9Er 1  20 rr rr             jsr     text_screen
000BA1r 1  20 rr rr             jsr     get_world       ; (worlds from the USB drive)
000BA4r 1  90 43                bcc     @ok
000BA6r 1  AD rr rr             lda     wsrc            ; (no 1-1 at all: a word, and back to the title)
000BA9r 1  C9 01                cmp     #1
000BABr 1  D0 14                bne     @nd
000BADr 1  AD rr rr             lda     lvl
000BB0r 1  D0 0F                bne     @nd
000BB2r 1  A9 rr                lda     #<noworld_txt
000BB4r 1  A0 rr                ldy     #>noworld_txt
000BB6r 1  20 rr rr             jsr     print_table
000BB9r 1  A9 64                lda     #100
000BBBr 1  20 rr rr             jsr     delay_long
000BBEr 1  4C rr rr             jmp     title
000BC1r 1  A9 rr        @nd:    lda     #<nodisk_txt    ; no more worlds: around again
000BC3r 1  A0 rr                ldy     #>nodisk_txt
000BC5r 1  20 rr rr             jsr     print_table
000BC8r 1  A2 0F                ldx     #15
000BCAr 1  A0 0A                ldy     #10
000BCCr 1  20 rr rr             jsr     vdp_at
000BCFr 1  AD rr rr             lda     wsrc
000BD2r 1  09 30                ora     #'0'
000BD4r 1  8D 1C 7F             sta     VDP_DATA
000BD7r 1  A9 3C                lda     #60
000BD9r 1  20 rr rr             jsr     delay_long
000BDCr 1  A9 01                lda     #1
000BDEr 1  8D rr rr             sta     wsrc
000BE1r 1  A9 00                lda     #0
000BE3r 1  8D rr rr             sta     lvl
000BE6r 1  4C rr rr             jmp     start_level
000BE9r 1  A2 0C        @ok:    ldx     #12
000BEBr 1  A0 09                ldy     #9
000BEDr 1  20 rr rr             jsr     vdp_at
000BF0r 1  A9 rr                lda     #<world_txt
000BF2r 1  A0 rr                ldy     #>world_txt
000BF4r 1  20 rr rr             jsr     vdp_puts
000BF7r 1  20 rr rr             jsr     pr_world
000BFAr 1  A2 0C                ldx     #12
000BFCr 1  A0 0C                ldy     #12
000BFEr 1  20 rr rr             jsr     vdp_at
000C01r 1  A9 rr                lda     #<lives_txt
000C03r 1  A0 rr                ldy     #>lives_txt
000C05r 1  20 rr rr             jsr     vdp_puts
000C08r 1  AD rr rr             lda     lives
000C0Br 1  20 rr rr             jsr     prdec
000C0Er 1  20 rr rr             jsr     load_level
000C11r 1  AD rr rr             lda     lv_flags        ; a castle: a word about KIL
000C14r 1  29 01                and     #1
000C16r 1  F0 07                beq     @nk
000C18r 1  A9 rr                lda     #<kil_txt
000C1Ar 1  A0 rr                ldy     #>kil_txt
000C1Cr 1  20 rr rr             jsr     print_table
000C1Fr 1  A9 1E        @nk:    lda     #30
000C21r 1  20 rr rr             jsr     delay_long
000C24r 1  20 rr rr             jsr     new_screen
000C27r 1  20 rr rr             jsr     sfx_off
000C2Ar 1  20 rr rr             jsr     music_level
000C2Dr 1               
000C2Dr 1               ; ---- the frame loop --------------------------------------------------------------
000C2Dr 1               game_loop:
000C2Dr 1  20 rr rr             jsr     read_input
000C30r 1  AD rr rr             lda     quit
000C33r 1  F0 03                beq     @1
000C35r 1  4C rr rr             jmp     title
000C38r 1  20 rr rr     @1:     jsr     mos_update
000C3Br 1  20 rr rr             jsr     obj_update
000C3Er 1  20 rr rr             jsr     fire_update
000C41r 1  20 rr rr             jsr     obj_collide
000C44r 1  20 rr rr             jsr     camera
000C47r 1  20 rr rr             jsr     spawn_enemies
000C4Ar 1  20 rr rr             jsr     clock
000C4Dr 1  20 rr rr             jsr     render
000C50r 1  20 rr rr             jsr     hud_update
000C53r 1  20 rr rr             jsr     pace
000C56r 1  EE rr rr             inc     frame
000C59r 1  AD rr rr             lda     mstate          ; the end of a life, or of the level?
