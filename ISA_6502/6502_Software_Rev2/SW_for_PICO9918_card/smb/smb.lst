000E3Br 1  CD rr rr             cmp     sc2
000E3Er 1  AD rr rr             lda     tmp+1
000E41r 1  ED rr rr             sbc     sc2+1
000E44r 1  90 3F                bcc     @r
000E46r 1  AD rr rr             lda     max_sc          ; but not past the end: max_sc * 2
000E49r 1  0A                   asl
