000E25r 1               ; ---- the view follows MOS (forward only), a game pixel at a time -----------------
000E25r 1               ; sc2 = the view's left edge in game pixels (x - 64), scroll = sc2 / 2 (in the
000E25r 1               ; old characters, as the rest of the game keeps it)
000E25r 1  38           camera: sec
000E26r 1  AD rr rr             lda     o_xl
000E29r 1  E9 40                sbc     #64
000E2Br 1  8D rr rr             sta     tmp
000E2Er 1  AD rr rr             lda     o_xh
