000C11r 1  AE rr rr             ldx     tmp3
000C14r 1  4C rr rr             jmp     @rm
000C17r 1  AD rr rr     @scored:lda     nfull           ; points: 40, 100, 300, 1200 x (level + 1)
000C1Ar 1  0A                   asl
000C1Br 1  0A                   asl                     ; *4 (3 bytes each, the first unused)
000C1Cr 1  38                   sec
000C1Dr 1  E9 04                sbc     #4
