0009CAr 1  0A                   asl
0009CBr 1  0A                   asl
0009CCr 1  6D rr rr             adc     trot            ; (carry clear: ptype < 64)
0009CFr 1  0A                   asl
0009D0r 1  0A                   asl
0009D1r 1  8D rr rr             sta     pidx            ; ptype * 16 + trot * 4
0009D4r 1  A8                   tay
0009D5r 1  A2 04                ldx     #4
0009D7r 1  B9 rr rr     @sq:    lda     pc_x,y
0009DAr 1  18                   clc
0009DBr 1  6D rr rr             adc     tx
0009DEr 1  C9 0A                cmp     #BW             ; off the side (or < 0: >= 128)
0009E0r 1  B0 2B                bcs     @no
0009E2r 1  8D rr rr             sta     tmp
0009E5r 1  B9 rr rr             lda     pc_y,y
0009E8r 1  18                   clc
0009E9r 1  6D rr rr             adc     ty
