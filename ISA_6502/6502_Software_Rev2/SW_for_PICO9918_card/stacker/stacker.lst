000E3Fr 1  20 rr rr             jsr     handle_key
000E42r 1  4C rr rr             jmp     @keys
000E45r 1  60           @done:  rts
000E46r 1               
000E46r 1               pad_move:
000E46r 1  AD rr rr             lda     pad
000E49r 1  29 40                and     #PAD_LEFT
000E4Br 1  F0 05                beq     @r
000E4Dr 1  A9 FF                lda     #$FF
000E4Fr 1  4C rr rr             jmp     move
