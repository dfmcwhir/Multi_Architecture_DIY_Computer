000DBEr 1               
000DBEr 1               
000DBEr 1               ; ============================================================================
000DBEr 1  AD rr rr     input:  lda     padold          ; the pad works in either mode
000DC1r 1  8D rr rr             sta     pad_prev
000DC4r 1  20 rr rr             jsr     read_pad
000DC7r 1  AD rr rr             lda     padnew          ; left / right: move now, repeat when held
000DCAr 1  29 C0                and     #PAD_LEFT | PAD_RIGHT
000DCCr 1  F0 0B                beq     @held
000DCEr 1  A9 00                lda     #0
000DD0r 1  8D rr rr             sta     das
000DD3r 1  20 rr rr             jsr     pad_move
000DD6r 1  4C rr rr             jmp     @rot
000DD9r 1  AD rr rr     @held:  lda     pad
000DDCr 1  29 C0                and     #PAD_LEFT | PAD_RIGHT
000DDEr 1  F0 12                beq     @rot
000DE0r 1  EE rr rr             inc     das
000DE3r 1  AD rr rr             lda     das
000DE6r 1  C9 0C                cmp     #DAS_DELAY
000DE8r 1  90 08                bcc     @rot
