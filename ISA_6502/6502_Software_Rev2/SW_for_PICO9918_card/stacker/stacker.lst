000DECr 1  8D rr rr             sta     das
000DEFr 1  20 rr rr             jsr     pad_move
000DF2r 1  AD rr rr     @rot:   lda     padnew
000DF5r 1  29 01                and     #PAD_A
000DF7r 1  F0 05                beq     @b
000DF9r 1  A9 01                lda     #1
000DFBr 1  20 rr rr             jsr     rotate
000DFEr 1  AD rr rr     @b:     lda     padnew
000E01r 1  29 02                and     #PAD_B
000E03r 1  F0 05                beq     @up
000E05r 1  A9 03                lda     #3
000E07r 1  20 rr rr             jsr     rotate
000E0Ar 1  AD rr rr     @up:    lda     padnew
000E0Dr 1  29 10                and     #PAD_UP
000E0Fr 1  F0 06                beq     @dn
000E11r 1  20 rr rr             jsr     hard_drop
000E14r 1  4C rr rr             jmp     @st
000E17r 1  AD rr rr     @dn:    lda     pad
000E1Ar 1  29 20                and     #PAD_DOWN
000E1Cr 1  F0 0D                beq     @st
000E1Er 1  EE rr rr             inc     sdcount
000E21r 1  AD rr rr             lda     sdcount
000E24r 1  29 01                and     #1
000E26r 1  F0 03                beq     @st
000E28r 1  20 rr rr             jsr     soft_drop
000E2Br 1  AD rr rr     @st:    lda     padnew
000E2Er 1  29 08                and     #PAD_START
