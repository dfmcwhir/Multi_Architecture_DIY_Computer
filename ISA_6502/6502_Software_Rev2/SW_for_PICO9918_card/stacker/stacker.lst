0001A8r 2  CA                   dex
0001A9r 2  10 85                bpl     @ch
0001ABr 2  A9 07                lda     #7
0001ADr 2  8D 22 7F             sta     SFX_AY_ADDR
0001B0r 2  AD rr rr             lda     sfx_mixer
0001B3r 2  8D 23 7F             sta     SFX_AY_DATA
0001B6r 2  60                   rts
0001B7r 2  3E 3D 3B     sfx_tone_on:    .byte   $3E, $3D, $3B
0001BAr 2  37 2F 1F     sfx_noise_on:   .byte   $37, $2F, $1F
0001BDr 2               
0001BDr 2               ; one voice (X): the sweep and the decay, then the script when its wait
0001BDr 2               ; is over
0001BDr 2               sfx_voice:
0001BDr 2  BD rr rr             lda     sfx_swl,x       ; the sweep
0001C0r 2  1D rr rr             ora     sfx_swh,x
0001C3r 2  F0 13                beq     @ns
0001C5r 2  BD rr rr             lda     sfx_perl,x
0001C8r 2  18                   clc
0001C9r 2  7D rr rr             adc     sfx_swl,x
0001CCr 2  9D rr rr             sta     sfx_perl,x
0001CFr 2  BD rr rr             lda     sfx_perh,x
0001D2r 2  7D rr rr             adc     sfx_swh,x
0001D5r 2  9D rr rr             sta     sfx_perh,x
0001D8r 2  BD rr rr     @ns:    lda     sfx_dec,x       ; the decay
0001DBr 2  F0 10                beq     @nd
0001DDr 2  DE rr rr             dec     sfx_decc,x
0001E0r 2  D0 0B                bne     @nd
0001E2r 2  9D rr rr             sta     sfx_decc,x
0001E5r 2  BD rr rr             lda     sfx_vol,x
0001E8r 2  F0 03                beq     @nd
0001EAr 2  DE rr rr             dec     sfx_vol,x
0001EDr 2  BD rr rr     @nd:    lda     sfx_wait,x
0001F0r 2  F0 06                beq     @run
0001F2r 2  DE rr rr             dec     sfx_wait,x
0001F5r 2  F0 01                beq     @run
0001F7r 2  60                   rts
0001F8r 2  A9 28        @run:   lda     #40             ; (at most 40 commands a tick: a script that
0001FAr 2  8D rr rr             sta     sfx_guard       ;  never waits can't hang the game)
0001FDr 2  CE rr rr     @cmd:   dec     sfx_guard
000200r 2  F0 76                beq     @stop
000202r 2  20 rr rr             jsr     sfx_byte
000205r 2  C9 80                cmp     #$80
000207r 2  90 09                bcc     @nw
000209r 2  29 7F                and     #$7F            ; wait
00020Br 2  9D rr rr             sta     sfx_wait,x
00020Er 2  FE rr rr             inc     sfx_wait,x
000211r 2  60                   rts
000212r 2  C9 20        @nw:    cmp     #$20
000214r 2  90 54                bcc     @op
000216r 2  38                   sec                     ; a note
000217r 2  E9 20                sbc     #$20
000219r 2  C9 60                cmp     #96
00021Br 2  90 02                bcc     @nt
00021Dr 2  A9 5F                lda     #95
00021Fr 2  A0 00        @nt:    ldy     #0              ; octave Y, note A in it
000221r 2  C9 0C        @oc:    cmp     #12
000223r 2  90 05                bcc     @ok
000225r 2  E9 0C                sbc     #12
000227r 2  C8                   iny
000228r 2  D0 F7                bne     @oc
00022Ar 2  8C rr rr     @ok:    sty     sfx_guard+1     ; (as a count)
00022Dr 2  A8                   tay
00022Er 2  B9 rr rr             lda     sfx_c1_lo,y     ; the period in octave 1, halved for each
000231r 2  9D rr rr             sta     sfx_perl,x      ; octave up
000234r 2  B9 rr rr             lda     sfx_c1_hi,y
000237r 2  AC rr rr             ldy     sfx_guard+1
00023Ar 2  F0 16                beq     @p
00023Cr 2  4A           @sh:    lsr
00023Dr 2  7E rr rr             ror     sfx_perl,x
000240r 2  88                   dey
000241r 2  D0 F9                bne     @sh
000243r 2  9D rr rr             sta     sfx_perh,x      ; (rounded: the last bit out was a half)
000246r 2  90 0D                bcc     @r0
000248r 2  FE rr rr             inc     sfx_perl,x
00024Br 2  D0 08                bne     @r0
00024Dr 2  FE rr rr             inc     sfx_perh,x
000250r 2  D0 03                bne     @r0
000252r 2  9D rr rr     @p:     sta     sfx_perh,x
000255r 2               @r0:
000255r 2  BD rr rr             lda     sfx_base,x
000258r 2  9D rr rr             sta     sfx_vol,x
00025Br 2  BD rr rr             lda     sfx_dec,x
00025Er 2  9D rr rr             sta     sfx_decc,x
000261r 2  BD rr rr     @len:   lda     sfx_len,x       ; (LEN: wait that long)
000264r 2  F0 97                beq     @cmd
000266r 2  9D rr rr             sta     sfx_wait,x
000269r 2  60                   rts
00026Ar 2  C9 0C        @op:    cmp     #12
00026Cr 2  B0 0A                bcs     @stop
00026Er 2  A8                   tay
00026Fr 2  B9 rr rr             lda     @hi,y
000272r 2  48                   pha
000273r 2  B9 rr rr             lda     @lo,y
000276r 2  48                   pha
000277r 2  60                   rts                     ; (to the command, which goes back to @cmd)
000278r 2  A9 00        @stop:  lda     #0
00027Ar 2  9D rr rr             sta     sfx_hi,x
00027Dr 2  9D rr rr             sta     sfx_vol,x
000280r 2  60                   rts
000281r 2  rr rr rr rr  @lo:    .lobytes  @stop-1, @per-1, @vl-1, @noi-1, @mix-1, @sw-1, @dc-1, @lp-1, @nx-1, @jp-1, @rest-1, @ln-1
000285r 2  rr rr rr rr  
000289r 2  rr rr rr rr  
00028Dr 2  rr rr rr rr  @hi:    .hibytes  @stop-1, @per-1, @vl-1, @noi-1, @mix-1, @sw-1, @dc-1, @lp-1, @nx-1, @jp-1, @rest-1, @ln-1
000291r 2  rr rr rr rr  
000295r 2  rr rr rr rr  
000299r 2  20 rr rr     @per:   jsr     sfx_byte
00029Cr 2  9D rr rr             sta     sfx_perl,x
00029Fr 2  20 rr rr             jsr     sfx_byte
0002A2r 2  9D rr rr             sta     sfx_perh,x
0002A5r 2  4C rr rr             jmp     @cmd
0002A8r 2  20 rr rr     @vl:    jsr     sfx_byte
0002ABr 2  9D rr rr             sta     sfx_base,x
0002AEr 2  9D rr rr             sta     sfx_vol,x
0002B1r 2  BD rr rr             lda     sfx_dec,x
0002B4r 2  9D rr rr             sta     sfx_decc,x
0002B7r 2  4C rr rr             jmp     @cmd
0002BAr 2  20 rr rr     @noi:   jsr     sfx_byte
0002BDr 2  9D rr rr             sta     sfx_noise,x
0002C0r 2  4C rr rr             jmp     @cmd
0002C3r 2  20 rr rr     @mix:   jsr     sfx_byte
0002C6r 2  9D rr rr             sta     sfx_mix,x
0002C9r 2  4C rr rr             jmp     @cmd
0002CCr 2  20 rr rr     @sw:    jsr     sfx_byte
0002CFr 2  9D rr rr             sta     sfx_swl,x
0002D2r 2  20 rr rr             jsr     sfx_byte
0002D5r 2  9D rr rr             sta     sfx_swh,x
0002D8r 2  4C rr rr             jmp     @cmd
0002DBr 2  20 rr rr     @dc:    jsr     sfx_byte
0002DEr 2  9D rr rr             sta     sfx_dec,x
0002E1r 2  9D rr rr             sta     sfx_decc,x
0002E4r 2  4C rr rr             jmp     @cmd
0002E7r 2  20 rr rr     @lp:    jsr     sfx_byte
0002EAr 2  9D rr rr             sta     sfx_lcnt,x
0002EDr 2  BD rr rr             lda     sfx_lo,x
0002F0r 2  9D rr rr             sta     sfx_lpl,x
0002F3r 2  BD rr rr             lda     sfx_hi,x
0002F6r 2  9D rr rr             sta     sfx_lph,x
0002F9r 2  4C rr rr             jmp     @cmd
0002FCr 2  BD rr rr     @nx:    lda     sfx_lcnt,x
0002FFr 2  F0 05                beq     @back           ; (0: for ever)
000301r 2  DE rr rr             dec     sfx_lcnt,x
000304r 2  F0 0C                beq     @go
000306r 2  BD rr rr     @back:  lda     sfx_lpl,x
000309r 2  9D rr rr             sta     sfx_lo,x
00030Cr 2  BD rr rr             lda     sfx_lph,x
00030Fr 2  9D rr rr             sta     sfx_hi,x
000312r 2  4C rr rr     @go:    jmp     @cmd
000315r 2  20 rr rr     @jp:    jsr     sfx_byte
000318r 2  48                   pha
000319r 2  20 rr rr             jsr     sfx_byte
00031Cr 2  9D rr rr             sta     sfx_hi,x
00031Fr 2  68                   pla
000320r 2  9D rr rr             sta     sfx_lo,x
000323r 2  4C rr rr             jmp     @cmd
000326r 2  A9 00        @rest:  lda     #0
000328r 2  9D rr rr             sta     sfx_vol,x
00032Br 2  4C rr rr             jmp     @len
00032Er 2  20 rr rr     @ln:    jsr     sfx_byte
000331r 2  9D rr rr             sta     sfx_len,x
000334r 2  4C rr rr             jmp     @cmd
000337r 2               
000337r 2               ; the next byte of voice X's script
000337r 2               sfx_byte:
000337r 2  BD rr rr             lda     sfx_lo,x
00033Ar 2  8D rr rr             sta     @ld+1
00033Dr 2  BD rr rr             lda     sfx_hi,x
000340r 2  8D rr rr             sta     @ld+2
000343r 2  AD FF FF     @ld:    lda     $FFFF
000346r 2  FE rr rr             inc     sfx_lo,x
000349r 2  D0 03                bne     @r
00034Br 2  FE rr rr             inc     sfx_hi,x
00034Er 2  60           @r:     rts
00034Fr 2               
00034Fr 2               ; the tone periods of C1 .. B1 for the 2 MHz chip clock: 2 MHz / (16 x
00034Fr 2               ; frequency); each octave up is half (to within a third of a percent)
00034Fr 2  EE 18 4D 8E  sfx_c1_lo:  .lobytes 3822, 3608, 3405, 3214, 3034, 2863, 2703, 2551, 2408, 2273, 2145, 2025
000353r 2  DA 2F 8F F7  
000357r 2  68 E1 61 E9  
00035Br 2  0E 0E 0D 0C  sfx_c1_hi:  .hibytes 3822, 3608, 3405, 3214, 3034, 2863, 2703, 2551, 2408, 2273, 2145, 2025
00035Fr 2  0B 0B 0A 09  
000363r 2  09 08 08 07  
000367r 2               
000367r 2               
000367r 1                       .include "lib/vdp.s"    ; the PICO9918 routines
000367r 2               ; ============================================================================
000367r 2               ; vdp.s - PICO9918 / TMS9918A routines shared by the SBC games (CPU Rev2)
000367r 2               ;
000367r 2               ; Include it after setting VDP_NAME (the name table's VRAM address):
000367r 2               ;           VDP_NAME = $1800
000367r 2               ;           .include "lib/vdp.s"
000367r 2               ; No zero page is used: the copy routines patch their own addresses.
000367r 2               ;
000367r 2               ;   vdp_setup   A/Y -> 8 bytes: R0-R7.  Puts a PICO9918 (F18A mode) back to
000367r 2               ;               plain TMS9918A behaviour first (24 rows, all 32 sprites),
000367r 2               ;               clears the 16K of VRAM, then loads R0-R7.  Interrupts from
000367r 2               ;               the VDP should be off in R1 (bit 5): the games poll.
000367r 2               ;   vdp_reg     register X = A
000367r 2               ;   vdp_waddr   VRAM write address = A (low) / Y (high)
000367r 2               ;   vdp_fill    write A to VRAM vdp_n (16 bit) times, from the address set
000367r 2               ;   vdp_copy    copy vdp_n bytes from RAM vdp_src to VRAM (from the address set)
000367r 2               ;   vdp_at      write address = the name table cell at column X, row Y
000367r 2               ;   vdp_puts    write the 0-ended string at A/Y from there (names = ASCII)
000367r 2               ;   vdp_bcd     write A as two digits
000367r 2               ;   vdp_frame   wait for the next frame (60 a second), calling frame_idle
000367r 2               ;               (the game's: sound, random numbers) while it waits
000367r 2               ;
000367r 2               ; The VDP's ports: data $7F1C, control/status $7F1D.  Reading the status
000367r 2               ; clears the frame flag, so nothing else should read it while a game runs
000367r 2               ; (the ROM doesn't, with PICO_IRQ = 0 in its config.inc, the default).
000367r 2               ; ============================================================================
000367r 2               
000367r 2               VDP_DATA        = $7F1C
000367r 2               VDP_CTRL        = $7F1D
000367r 2               
000367r 2               ; register X = A.  Keeps A, X, Y.
000367r 2               vdp_reg:
000367r 2  8D 1D 7F             sta     VDP_CTRL
00036Ar 2  48                   pha
00036Br 2  8A                   txa
00036Cr 2  09 80                ora     #$80
00036Er 2  8D 1D 7F             sta     VDP_CTRL
000371r 2  68                   pla
000372r 2  60                   rts
000373r 2               
000373r 2               ; VRAM write address = A (low) / Y (high).  Keeps A, X, Y.
000373r 2               vdp_waddr:
000373r 2  8D 1D 7F             sta     VDP_CTRL
000376r 2  48                   pha
000377r 2  98                   tya
000378r 2  29 3F                and     #$3F
00037Ar 2  09 40                ora     #$40
00037Cr 2  8D 1D 7F             sta     VDP_CTRL
00037Fr 2  68                   pla
000380r 2  60                   rts
000381r 2               
000381r 2               ; write A, vdp_n times.  Keeps A.
000381r 2               vdp_fill:
000381r 2  AE rr rr             ldx     vdp_n           ; the odd bytes first
000384r 2  F0 06                beq     @pg
000386r 2  8D 1C 7F     @lo:    sta     VDP_DATA
000389r 2  CA                   dex
00038Ar 2  D0 FA                bne     @lo
00038Cr 2  AC rr rr     @pg:    ldy     vdp_n+1         ; then whole pages
00038Fr 2  F0 0B                beq     @done
000391r 2  A2 00        @p:     ldx     #0
000393r 2  8D 1C 7F     @pp:    sta     VDP_DATA
000396r 2  CA                   dex
000397r 2  D0 FA                bne     @pp
000399r 2  88                   dey
00039Ar 2  D0 F5                bne     @p
00039Cr 2  60           @done:  rts
00039Dr 2               
00039Dr 2               ; copy vdp_n bytes from vdp_src to VRAM
00039Dr 2               vdp_copy:
00039Dr 2  AD rr rr             lda     vdp_src
0003A0r 2  8D rr rr             sta     @rd+1
0003A3r 2  AD rr rr             lda     vdp_src+1
0003A6r 2  8D rr rr             sta     @rd+2
0003A9r 2  AD rr rr             lda     vdp_n
0003ACr 2  8D rr rr             sta     vdp_t
0003AFr 2  AD rr rr             lda     vdp_n+1
0003B2r 2  8D rr rr             sta     vdp_t+1
0003B5r 2  AD rr rr     @l:     lda     vdp_t
0003B8r 2  0D rr rr             ora     vdp_t+1
0003BBr 2  F0 1C                beq     @done
0003BDr 2  AD FF FF     @rd:    lda     $FFFF
0003C0r 2  8D 1C 7F             sta     VDP_DATA
0003C3r 2  EE rr rr             inc     @rd+1
0003C6r 2  D0 03                bne     :+
0003C8r 2  EE rr rr             inc     @rd+2
0003CBr 2  AD rr rr     :       lda     vdp_t
0003CEr 2  D0 03                bne     :+
0003D0r 2  CE rr rr             dec     vdp_t+1
0003D3r 2  CE rr rr     :       dec     vdp_t
0003D6r 2  4C rr rr             jmp     @l
0003D9r 2  60           @done:  rts
0003DAr 2               
0003DAr 2               ; A/Y -> 8 register values.  Clears VRAM.
0003DAr 2               vdp_setup:
0003DAr 2  8D rr rr             sta     @rr+1
0003DDr 2  8C rr rr             sty     @rr+2
0003E0r 2  AD 1D 7F             lda     VDP_CTRL        ; (resets the register write latch)
0003E3r 2  A9 80                lda     #$80            ; R1 = $80: display off while we work
0003E5r 2  A2 01                ldx     #1
0003E7r 2  20 rr rr             jsr     vdp_reg
0003EAr 2  A9 1C                lda     #$1C            ; F18A unlock (a PICO9918): $1C twice to VR57
0003ECr 2  A2 39                ldx     #57
0003EEr 2  20 rr rr             jsr     vdp_reg
0003F1r 2  20 rr rr             jsr     vdp_reg
0003F4r 2  A9 00                lda     #0              ; VR49: 24 rows, no 80 columns
0003F6r 2  A2 31                ldx     #49
0003F8r 2  20 rr rr             jsr     vdp_reg
0003FBr 2  A2 32                ldx     #50             ; VR50: plain TMS9918A behaviour
0003FDr 2  20 rr rr             jsr     vdp_reg
000400r 2  A9 20                lda     #32             ; VR51: all 32 sprites
000402r 2  A2 33                ldx     #51
000404r 2  20 rr rr             jsr     vdp_reg
000407r 2                       ; (on a real TMS9918A those writes land in R1-R3: all set below)
000407r 2  A9 80                lda     #$80            ; R1 again: display off
000409r 2  A2 01                ldx     #1
00040Br 2  20 rr rr             jsr     vdp_reg
00040Er 2  A9 00                lda     #0              ; clear the 16K
000410r 2  A8                   tay
000411r 2  20 rr rr             jsr     vdp_waddr
000414r 2  A9 00                lda     #$00
000416r 2  8D rr rr             sta     vdp_n
000419r 2  A9 40                lda     #$40
00041Br 2  8D rr rr             sta     vdp_n+1
00041Er 2  A9 00                lda     #0
000420r 2  20 rr rr             jsr     vdp_fill
000423r 2  A2 00                ldx     #0
000425r 2  BD FF FF     @rr:    lda     $FFFF,x
000428r 2  20 rr rr             jsr     vdp_reg
00042Br 2  E8                   inx
00042Cr 2  E0 08                cpx     #8
00042Er 2  D0 F5                bne     @rr
000430r 2  60                   rts
000431r 2               
000431r 2               ; write address = name table cell X (column), Y (row).  Keeps X and Y.
000431r 2               vdp_at:
000431r 2  8E rr rr             stx     vdp_t
000434r 2  98                   tya
000435r 2  4A                   lsr                     ; row * 32: high byte = row / 8
000436r 2  4A                   lsr
000437r 2  4A                   lsr
000438r 2  8D rr rr             sta     vdp_t+1
00043Br 2  98                   tya
00043Cr 2  0A                   asl
00043Dr 2  0A                   asl
00043Er 2  0A                   asl
00043Fr 2  0A                   asl
000440r 2  0A                   asl                     ; low byte = (row & 7) * 32
000441r 2  18                   clc
000442r 2  6D rr rr             adc     vdp_t
000445r 2  18                   clc
000446r 2  69 00                adc     #<VDP_NAME
000448r 2  8D 1D 7F             sta     VDP_CTRL
00044Br 2  AD rr rr             lda     vdp_t+1
00044Er 2  69 18                adc     #>VDP_NAME
000450r 2  29 3F                and     #$3F
000452r 2  09 40                ora     #$40
000454r 2  8D 1D 7F             sta     VDP_CTRL
000457r 2  60                   rts
000458r 2               
000458r 2               ; write the 0-ended string at A/Y.  Keeps X.
000458r 2               vdp_puts:
000458r 2  8D rr rr             sta     @rd+1
00045Br 2  8C rr rr             sty     @rd+2
00045Er 2  A0 00                ldy     #0
000460r 2  B9 FF FF     @rd:    lda     $FFFF,y
000463r 2  F0 06                beq     @done
000465r 2  8D 1C 7F             sta     VDP_DATA
000468r 2  C8                   iny
000469r 2  D0 F5                bne     @rd
00046Br 2  60           @done:  rts
00046Cr 2               
00046Cr 2               ; A as two BCD digits.  Keeps X, Y.
00046Cr 2               vdp_bcd:
00046Cr 2  48                   pha
00046Dr 2  4A                   lsr
00046Er 2  4A                   lsr
00046Fr 2  4A                   lsr
000470r 2  4A                   lsr
000471r 2  09 30                ora     #'0'
000473r 2  8D 1C 7F             sta     VDP_DATA
000476r 2  68                   pla
000477r 2  48                   pha
000478r 2  29 0F                and     #$0F
00047Ar 2  09 30                ora     #'0'
00047Cr 2  8D 1C 7F             sta     VDP_DATA
00047Fr 2  68                   pla
000480r 2  60                   rts
000481r 2               
000481r 2               ; wait for the next frame
000481r 2               vdp_frame:
000481r 2  20 rr rr     @w:     jsr     frame_idle
000484r 2  AD 1D 7F             lda     VDP_CTRL
000487r 2  10 F8                bpl     @w
000489r 2  60                   rts
00048Ar 2               
00048Ar 2                       .segment "BSS"
000075r 2  xx xx        vdp_n:          .res 2
000077r 2  xx xx        vdp_src:        .res 2
000079r 2  xx xx        vdp_t:          .res 2
00007Br 2                       .segment "CODE"
00048Ar 2               
00048Ar 1               
00048Ar 1               getc            = SBC_CHRIN     ; carry set = key in A
00048Ar 1               
00048Ar 1               ; called by vdp_frame while it waits
00048Ar 1               frame_idle:
00048Ar 1  20 rr rr             jsr     sfx_poll
00048Dr 1  4C rr rr             jmp     rand
000490r 1               
000490r 1               ; 16 bit Galois LFSR.  A = a random byte.  Preserves X and Y.
000490r 1  AD rr rr     rand:   lda     rng+1
000493r 1  4A                   lsr
000494r 1  6E rr rr             ror     rng
000497r 1  90 02                bcc     @n
000499r 1  49 B4                eor     #$B4
00049Br 1  8D rr rr     @n:     sta     rng+1
00049Er 1  4D rr rr             eor     rng
0004A1r 1  60                   rts
0004A2r 1               
0004A2r 1               ; wait A frames (keys pressed meanwhile are dropped)
0004A2r 1               wait_frames:
0004A2r 1  8D rr rr             sta     wf_n
0004A5r 1  20 rr rr     @l:     jsr     vdp_frame
0004A8r 1  20 rr rr             jsr     flush_in
0004ABr 1  CE rr rr             dec     wf_n
0004AEr 1  D0 F5                bne     @l
0004B0r 1  60                   rts
0004B1r 1               
0004B1r 1               ; print a table of texts: column, row, .word address ... 0
0004B1r 1               print_table:
0004B1r 1  8D rr rr             sta     @rd+1
0004B4r 1  8C rr rr             sty     @rd+2
0004B7r 1  A2 00                ldx     #0
0004B9r 1  8E rr rr     @l:     stx     pt_i
0004BCr 1  20 rr rr             jsr     @rd
0004BFr 1  F0 29                beq     @done
0004C1r 1  8D rr rr             sta     pt_c
0004C4r 1  E8                   inx
0004C5r 1  20 rr rr             jsr     @rd
0004C8r 1  A8                   tay
0004C9r 1  AE rr rr             ldx     pt_c
0004CCr 1  20 rr rr             jsr     vdp_at
0004CFr 1  AE rr rr             ldx     pt_i
0004D2r 1  E8                   inx
0004D3r 1  E8                   inx
0004D4r 1  20 rr rr             jsr     @rd
0004D7r 1  48                   pha
0004D8r 1  E8                   inx
0004D9r 1  20 rr rr             jsr     @rd
0004DCr 1  A8                   tay
0004DDr 1  68                   pla
0004DEr 1  20 rr rr             jsr     vdp_puts
0004E1r 1  AD rr rr             lda     pt_i
0004E4r 1  18                   clc
0004E5r 1  69 04                adc     #4
0004E7r 1  AA                   tax
0004E8r 1  D0 CF                bne     @l
0004EAr 1  60           @done:  rts
0004EBr 1  BD FF FF     @rd:    lda     $FFFF,x
0004EEr 1  60                   rts
0004EFr 1               
0004EFr 1               ; ============================================================================
0004EFr 1               ; gamepad and menu input
0004EFr 1               ; ============================================================================
0004EFr 1               PAD_A           = $01
0004EFr 1               PAD_B           = $02
0004EFr 1               PAD_SELECT      = $04
0004EFr 1               PAD_START       = $08
0004EFr 1               PAD_UP          = $10
0004EFr 1               PAD_DOWN        = $20
0004EFr 1               PAD_LEFT        = $40
0004EFr 1               PAD_RIGHT       = $80
0004EFr 1               PAD_GO          = $80           ; menu_key's answer for gamepad A or Start
0004EFr 1               
0004EFr 1               read_pad:
0004EFr 1  20 12 FE             jsr     SBC_PADSTATE
0004F2r 1  C9 FF                cmp     #$FF            ; every button "pressed" = no pad
0004F4r 1  D0 02                bne     @ok
0004F6r 1  A9 00                lda     #0
0004F8r 1  8D rr rr     @ok:    sta     pad
0004FBr 1  AD rr rr             lda     padold
0004FEr 1  49 FF                eor     #$FF
000500r 1  2D rr rr             and     pad
000503r 1  8D rr rr             sta     padnew
000506r 1  AD rr rr             lda     pad
000509r 1  8D rr rr             sta     padold
00050Cr 1  60                   rts
00050Dr 1               
00050Dr 1               flush_in:
00050Dr 1  20 00 FE             jsr     getc
000510r 1  B0 FB                bcs     flush_in
000512r 1  60                   rts
000513r 1               
000513r 1               ; carry set if A is a character the gamepad driver types (W A S D space)
000513r 1               pad_typed:
000513r 1  C9 20                cmp     #' '
000515r 1  F0 12                beq     @y
000517r 1  C9 57                cmp     #'W'
000519r 1  F0 0E                beq     @y
00051Br 1  C9 41                cmp     #'A'
00051Dr 1  F0 0A                beq     @y
00051Fr 1  C9 53                cmp     #'S'
000521r 1  F0 06                beq     @y
000523r 1  C9 44                cmp     #'D'
000525r 1  F0 02                beq     @y
000527r 1  18                   clc
000528r 1  60                   rts
000529r 1  38           @y:     sec
00052Ar 1  60                   rts
00052Br 1               
00052Br 1               ; wait for a menu choice: a key (letters in upper case) or PAD_GO
00052Br 1               menu_key:
00052Br 1  20 rr rr     @l:     jsr     vdp_frame
00052Er 1  20 rr rr             jsr     read_pad
000531r 1  AD rr rr             lda     padnew
000534r 1  29 09                and     #PAD_A | PAD_START
000536r 1  D0 21                bne     @pad
000538r 1  20 00 FE             jsr     getc
00053Br 1  90 EE                bcc     @l
00053Dr 1  C9 20                cmp     #' '            ; a space typed by the pad's A button?
00053Fr 1  D0 0D                bne     @up
000541r 1  20 rr rr             jsr     read_pad
000544r 1  AD rr rr             lda     pad
000547r 1  29 01                and     #PAD_A
000549r 1  D0 0E                bne     @pad
00054Br 1  A9 20                lda     #' '
00054Dr 1  60                   rts
00054Er 1  C9 61        @up:    cmp     #'a'
000550r 1  90 06                bcc     @r
000552r 1  C9 7B                cmp     #'z'+1
000554r 1  B0 02                bcs     @r
000556r 1  29 DF                and     #$DF
000558r 1  60           @r:     rts
000559r 1  20 rr rr     @pad:   jsr     flush_in
00055Cr 1  A9 80                lda     #PAD_GO
00055Er 1  60                   rts
00055Fr 1               
00055Fr 1               show_ctrl:
00055Fr 1  A2 01                ldx     #1
000561r 1  A0 13                ldy     #19
000563r 1  20 rr rr             jsr     vdp_at
000566r 1  AD rr rr             lda     ctrl
000569r 1  F0 07                beq     @kb
00056Br 1  A9 rr                lda     #<ctrl_pad_txt
00056Dr 1  A0 rr                ldy     #>ctrl_pad_txt
00056Fr 1  4C rr rr             jmp     vdp_puts
000572r 1  A9 rr        @kb:    lda     #<ctrl_kb_txt
000574r 1  A0 rr                ldy     #>ctrl_kb_txt
000576r 1  4C rr rr             jmp     vdp_puts
000579r 1               
000579r 1               ; ============================================================================
000579r 1               ; start, title
000579r 1               ; ============================================================================
000579r 1  D8           start:  cld
00057Ar 1  A2 FF                ldx     #$FF
00057Cr 1  9A                   txs
00057Dr 1  A9 00                lda     #0              ; clear the variables
00057Fr 1  AA                   tax
000580r 1  A0 03                ldy     #>(bss_end - bss_start + $FF)
000582r 1  9D rr rr     @c1:    sta     bss_start,x
000585r 1  E8                   inx
000586r 1  D0 FA                bne     @c1
000588r 1  EE rr rr             inc     @c1+2
00058Br 1  88                   dey
00058Cr 1  D0 F4                bne     @c1
00058Er 1  AD rr rr             lda     ctrl_def
000591r 1  8D rr rr             sta     ctrl
000594r 1  A9 5A                lda     #$5A
000596r 1  8D rr rr             sta     rng
000599r 1                       ; the PICO9918?  (CPU Rev2 ROM: a JMP at $FE1B, SBC_SYSINFO)
000599r 1  AD 1B FE             lda     SBC_SYSINFO
00059Cr 1  C9 4C                cmp     #$4C
00059Er 1  D0 07                bne     @nopico
0005A0r 1  20 1B FE             jsr     SBC_SYSINFO
0005A3r 1  C9 02                cmp     #DISP_PICO
0005A5r 1  F0 10                beq     @pico
0005A7r 1               @nopico:
0005A7r 1  A2 00                ldx     #0
0005A9r 1  BD rr rr     @m:     lda     need_txt,x
0005ACr 1  F0 06                beq     @bye
0005AEr 1  20 03 FE             jsr     SBC_CHROUT
0005B1r 1  E8                   inx
0005B2r 1  D0 F5                bne     @m
0005B4r 1  4C 06 FE     @bye:   jmp     SBC_MENU
0005B7r 1  20 rr rr     @pico:  jsr     sfx_init
0005BAr 1  AD rr rr             lda     mute_def
0005BDr 1  8D rr rr             sta     sfx_mute
0005C0r 1  20 rr rr             jsr     gfx_init
0005C3r 1               
0005C3r 1  20 rr rr     title:  jsr     sfx_off
0005C6r 1  20 rr rr             jsr     clear_names
0005C9r 1  A9 rr                lda     #<title_txt
0005CBr 1  A0 rr                ldy     #>title_txt
0005CDr 1  20 rr rr             jsr     print_table
0005D0r 1  20 rr rr             jsr     draw_banner
0005D3r 1  20 rr rr             jsr     show_start_level
0005D6r 1  20 rr rr             jsr     show_hiscore_title
0005D9r 1  20 rr rr             jsr     show_ctrl
0005DCr 1  20 rr rr             jsr     read_pad
0005DFr 1  20 rr rr             jsr     flush_in
0005E2r 1  20 rr rr     @wait:  jsr     menu_key
0005E5r 1  C9 51                cmp     #'Q'
0005E7r 1  D0 03                bne     @notq
0005E9r 1  4C rr rr             jmp     exit_game
0005ECr 1  C9 4D        @notq:  cmp     #'M'            ; sound on / off
0005EEr 1  D0 06                bne     @notm
0005F0r 1  20 rr rr             jsr     sfx_toggle
0005F3r 1  4C rr rr             jmp     @wait
0005F6r 1  C9 47        @notm:  cmp     #'G'            ; switch keyboard / gamepad
0005F8r 1  D0 0E                bne     @notg
0005FAr 1  AD rr rr             lda     ctrl
0005FDr 1  49 01                eor     #1
0005FFr 1  8D rr rr             sta     ctrl
000602r 1  20 rr rr             jsr     show_ctrl
000605r 1  4C rr rr             jmp     @wait
000608r 1  C9 80        @notg:  cmp     #PAD_GO         ; A or Start on the pad: play with the pad
00060Ar 1  D0 08                bne     @notp
00060Cr 1  A9 01                lda     #1
00060Er 1  8D rr rr             sta     ctrl
000611r 1  4C rr rr             jmp     new_game
000614r 1  C9 20        @notp:  cmp     #' '
000616r 1  D0 03                bne     @digit
000618r 1  4C rr rr             jmp     new_game
00061Br 1  C9 30        @digit: cmp     #'0'            ; 0..9: the starting level
00061Dr 1  90 C3                bcc     @wait
00061Fr 1  C9 3A                cmp     #'9'+1
000621r 1  B0 BF                bcs     @wait
000623r 1  29 0F                and     #$0F
000625r 1  8D rr rr             sta     start_level
000628r 1  20 rr rr             jsr     show_start_level
00062Br 1  4C rr rr             jmp     @wait
00062Er 1               
00062Er 1               ; the title banner, made of squares
00062Er 1               draw_banner:
00062Er 1  A9 rr                lda     #<banner
000630r 1  8D rr rr             sta     @rd+1
000633r 1  A9 rr                lda     #>banner
000635r 1  8D rr rr             sta     @rd+2
000638r 1  A0 02                ldy     #2              ; cell row
00063Ar 1  A2 02        @row:   ldx     #(32 - BANNER_W) / 2
00063Cr 1  20 rr rr             jsr     vdp_at
00063Fr 1  A9 1B                lda     #BANNER_W
000641r 1  8D rr rr             sta     tmp3
000644r 1  AD FF FF     @rd:    lda     $FFFF
000647r 1  20 rr rr             jsr     sq_name
00064Ar 1  8D 1C 7F             sta     VDP_DATA
00064Dr 1  EE rr rr             inc     @rd+1
000650r 1  D0 03                bne     @n
000652r 1  EE rr rr             inc     @rd+2
000655r 1  CE rr rr     @n:     dec     tmp3
000658r 1  D0 EA                bne     @rd
00065Ar 1  C8                   iny
00065Br 1  C0 07                cpy     #2 + BANNER_H
00065Dr 1  D0 DB                bne     @row
00065Fr 1  60                   rts
000660r 1               
000660r 1               ; A = the name (pattern) of square A.  Preserves X and Y.
000660r 1               sq_name:
000660r 1  C9 0A                cmp     #G_BLANK
000662r 1  B0 06                bcs     @blank
000664r 1  0A                   asl
000665r 1  0A                   asl
000666r 1  0A                   asl
000667r 1  69 60                adc     #P_SQUARE
000669r 1  60                   rts
00066Ar 1  A9 00        @blank: lda     #0
00066Cr 1  60                   rts
00066Dr 1               
00066Dr 1               show_start_level:
00066Dr 1  A2 1A                ldx     #26
00066Fr 1  A0 11                ldy     #17
000671r 1  20 rr rr             jsr     vdp_at
000674r 1  AD rr rr             lda     start_level
000677r 1  09 30                ora     #'0'
000679r 1  8D 1C 7F             sta     VDP_DATA
00067Cr 1  60                   rts
00067Dr 1               
00067Dr 1               show_hiscore_title:
00067Dr 1  A2 12                ldx     #18
00067Fr 1  A0 15                ldy     #21
000681r 1  20 rr rr             jsr     vdp_at
000684r 1                       ; (on into pr_hiscore)
000684r 1               pr_hiscore:
000684r 1  AD rr rr             lda     hiscore+2
000687r 1  20 rr rr             jsr     vdp_bcd
00068Ar 1  AD rr rr             lda     hiscore+1
00068Dr 1  20 rr rr             jsr     vdp_bcd
000690r 1  AD rr rr             lda     hiscore
000693r 1  4C rr rr             jmp     vdp_bcd
000696r 1               
000696r 1               exit_game:
000696r 1  20 rr rr             jsr     sfx_off
000699r 1  20 39 FE             jsr     SBC_CONRESET    ; the console's text screen back
00069Cr 1  4C 06 FE             jmp     SBC_MENU        ; back to the boot menu
00069Fr 1               
00069Fr 1               ; set up the VDP and load the patterns and colours
00069Fr 1               gfx_init:
00069Fr 1  A9 rr                lda     #<vdp_regs
0006A1r 1  A0 rr                ldy     #>vdp_regs
0006A3r 1  20 rr rr             jsr     vdp_setup
0006A6r 1  A9 00                lda     #<(V_PAT + $20*8)       ; the font
0006A8r 1  A0 01                ldy     #>(V_PAT + $20*8)
0006AAr 1  20 rr rr             jsr     vdp_waddr
0006ADr 1  A9 rr                lda     #<gfx_font
0006AFr 1  A2 rr                ldx     #>gfx_font
0006B1r 1  A0 02                ldy     #>(64*8)
0006B3r 1  20 rr rr             jsr     copy_vram
0006B6r 1  A9 00                lda     #<(V_PAT + P_SQUARE*8)  ; the squares, 8 patterns apart
0006B8r 1  8D rr rr             sta     tmp
0006BBr 1  A9 03                lda     #>(V_PAT + P_SQUARE*8)
0006BDr 1  8D rr rr             sta     tmp2
0006C0r 1  A9 rr                lda     #<gfx_squares
0006C2r 1  8D rr rr             sta     vdp_src
0006C5r 1  A9 rr                lda     #>gfx_squares
0006C7r 1  8D rr rr             sta     vdp_src+1
0006CAr 1  A9 0A                lda     #10
0006CCr 1  8D rr rr             sta     tmp3
0006CFr 1  AD rr rr     @sq:    lda     tmp
0006D2r 1  AC rr rr             ldy     tmp2
0006D5r 1  20 rr rr             jsr     vdp_waddr
0006D8r 1  A9 08                lda     #8
0006DAr 1  8D rr rr             sta     vdp_n
0006DDr 1  A9 00                lda     #0
0006DFr 1  8D rr rr             sta     vdp_n+1
0006E2r 1  20 rr rr             jsr     vdp_copy
0006E5r 1  AD rr rr             lda     vdp_src
0006E8r 1  18                   clc
0006E9r 1  69 08                adc     #8
0006EBr 1  8D rr rr             sta     vdp_src
0006EEr 1  90 03                bcc     :+
0006F0r 1  EE rr rr             inc     vdp_src+1
0006F3r 1  AD rr rr     :       lda     tmp
0006F6r 1  18                   clc
0006F7r 1  69 40                adc     #64
0006F9r 1  8D rr rr             sta     tmp
0006FCr 1  90 03                bcc     :+
0006FEr 1  EE rr rr             inc     tmp2
000701r 1  CE rr rr     :       dec     tmp3
000704r 1  D0 C9                bne     @sq
000706r 1  A9 00                lda     #<(V_PAT + P_WALL*8)    ; the well's side and floor
000708r 1  A0 06                ldy     #>(V_PAT + P_WALL*8)
00070Ar 1  20 rr rr             jsr     vdp_waddr
00070Dr 1  A9 rr                lda     #<gfx_well
00070Fr 1  8D rr rr             sta     vdp_src
000712r 1  A9 rr                lda     #>gfx_well
000714r 1  8D rr rr             sta     vdp_src+1
000717r 1  A9 08                lda     #8
000719r 1  8D rr rr             sta     vdp_n
00071Cr 1  20 rr rr             jsr     vdp_copy
00071Fr 1  A9 40                lda     #<(V_PAT + P_FLOOR*8)
000721r 1  A0 06                ldy     #>(V_PAT + P_FLOOR*8)
000723r 1  20 rr rr             jsr     vdp_waddr
000726r 1  A9 rr                lda     #<(gfx_well+8)
000728r 1  8D rr rr             sta     vdp_src
00072Br 1  A9 rr                lda     #>(gfx_well+8)
00072Dr 1  8D rr rr             sta     vdp_src+1
000730r 1  20 rr rr             jsr     vdp_copy
000733r 1  A9 00                lda     #<V_COLOUR
000735r 1  A0 20                ldy     #>V_COLOUR
000737r 1  20 rr rr             jsr     vdp_waddr
00073Ar 1  A9 rr                lda     #<gfx_colours
00073Cr 1  A2 rr                ldx     #>gfx_colours
00073Er 1  A0 00                ldy     #0
