000C9Br 1  69 09                adc     #BW-1
000C9Dr 1  AA                   tax                     ; last square of the row
000C9Er 1  E0 0A        @m:     cpx     #BW
000CA0r 1  90 09                bcc     @top
000CA2r 1  BD rr rr             lda     board-BW,x
000CA5r 1  9D rr rr             sta     board,x
000CA8r 1  CA                   dex
000CA9r 1  D0 F3                bne     @m              ; (X >= BW here, so never 0)
000CABr 1  A9 00        @top:   lda     #0              ; a new empty row at the top
000CADr 1  9D rr rr     @t:     sta     board,x
000CB0r 1  CA                   dex
000CB1r 1  10 FA                bpl     @t
000CB3r 1  60                   rts
