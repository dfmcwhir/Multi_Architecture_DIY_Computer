000E92r 1  EE rr rr             inc     esc_st
000E95r 1  60                   rts
000E96r 1  C9 10        @np:    cmp     #KEY_LEFT       ; the AVR keyboard's arrow keys
000E98r 1  F0 57                beq     @left
000E9Ar 1  C9 04                cmp     #KEY_RIGHT
000E9Cr 1  F0 58                beq     @right
000E9Er 1  C9 05                cmp     #KEY_UP
000EA0r 1  F0 59                beq     @rot
000EA2r 1  C9 18                cmp     #KEY_DOWN
000EA4r 1  F0 5F                beq     @down
000EA6r 1  20 rr rr             jsr     pad_typed       ; W A S D space typed by the pad?
000EA9r 1  90 10                bcc     @kb
