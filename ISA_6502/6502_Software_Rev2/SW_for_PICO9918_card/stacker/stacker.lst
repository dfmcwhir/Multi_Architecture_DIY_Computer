000CE6r 1  CA                   dex
000CE7r 1  E0 FF                cpx     #$FF
000CE9r 1  D0 F5                bne     @c
000CEBr 1  60                   rts
000CECr 1               
000CECr 1               ; disp = the board + the ghost + the falling piece
000CECr 1               compose:
000CECr 1  20 rr rr             jsr     compose_board
000CEFr 1  AD rr rr             lda     px              ; the ghost: as far down as it goes
