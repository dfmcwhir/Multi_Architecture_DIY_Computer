0015C0r 1               
0015C0r 1               ; ============================================================================
0015C0r 1               ; the display (PICO9918: Graphics I, two tile layers, ECM2 tiles and sprites)
0015C0r 1               ; ============================================================================
0015C0r 1               ; Layer 1 is the formation only, drawn at name column FM_COL + 2 gx; it sways
0015C0r 1               ; with the hardware scroll (R27 = 8 FM_COL - fxs).  Layer 2 (on top, but
0015C0r 1               ; under the sprites) has the status line, the messages, the stars and the
0015C0r 1               ; ships in reserve.  Every sprite (one per object, 16 x 16) has its own
0015C0r 1               ; pattern (names 4 k), loaded from the pictures when its picture changes.
0015C0r 1               
0015C0r 1               ; set up the VDP: registers, the tiles' two planes and attributes, the
0015C0r 1               ; palette entries 16-63, the F18A's features
0015C0r 1               gfx_init:
0015C0r 1  A9 rr                lda     #<vdp_regs
0015C2r 1  A0 rr                ldy     #>vdp_regs
0015C4r 1  20 rr rr             jsr     vdp_setup       ; (VRAM cleared)
0015C7r 1  A9 00                lda     #<V_TP0         ; the tiles: plane 0, plane 1
0015C9r 1  A0 00                ldy     #>V_TP0
0015CBr 1  20 rr rr             jsr     vdp_waddr
0015CEr 1  A9 rr                lda     #<tile_p0
0015D0r 1  A2 rr                ldx     #>tile_p0
0015D2r 1  A0 08                ldy     #8
0015D4r 1  20 rr rr             jsr     copy_pages
0015D7r 1  A9 00                lda     #<V_TP1
0015D9r 1  A0 08                ldy     #>V_TP1
0015DBr 1  20 rr rr             jsr     vdp_waddr
0015DEr 1  A9 rr                lda     #<tile_p1
0015E0r 1  A2 rr                ldx     #>tile_p1
0015E2r 1  A0 08                ldy     #8
0015E4r 1  20 rr rr             jsr     copy_pages
0015E7r 1  A9 00                lda     #<V_ATT1        ; the attributes (by pattern), both layers
0015E9r 1  A0 24                ldy     #>V_ATT1
0015EBr 1  20 rr rr             jsr     vdp_waddr
0015EEr 1  A9 rr                lda     #<tile_attr
0015F0r 1  A2 rr                ldx     #>tile_attr
0015F2r 1  A0 01                ldy     #1
0015F4r 1  20 rr rr             jsr     copy_pages
0015F7r 1  A9 00                lda     #<V_ATT2
0015F9r 1  A0 25                ldy     #>V_ATT2
0015FBr 1  20 rr rr             jsr     vdp_waddr
0015FEr 1  A9 rr                lda     #<tile_attr
001600r 1  A2 rr                ldx     #>tile_attr
001602r 1  A0 01                ldy     #1
001604r 1  20 rr rr             jsr     copy_pages
001607r 1  A9 D0                lda     #$C0 | 16       ; the palette from entry 16 on (R47: the data
001609r 1  A2 2F                ldx     #47             ; port writes the palette, counting up)
00160Br 1  20 rr rr             jsr     vdp_reg
00160Er 1  A2 00                ldx     #0
001610r 1  BD rr rr     @pl:    lda     pal_game,x
001613r 1  8D 1C 7F             sta     VDP_DATA
001616r 1  E8                   inx
001617r 1  E0 60                cpx     #96
001619r 1  D0 F5                bne     @pl
00161Br 1  A9 00                lda     #0              ; (the data port: VRAM again)
00161Dr 1  A2 2F                ldx     #47
00161Fr 1  20 rr rr             jsr     vdp_reg
001622r 1  A2 00                ldx     #0              ; the F18A registers
001624r 1  8E rr rr     @fr:    stx     tmp
001627r 1  BD rr rr             lda     f18a_regs+1,x   ; (value)
00162Ar 1  48                   pha
00162Br 1  BD rr rr             lda     f18a_regs,x     ; (register)
00162Er 1  AA                   tax
00162Fr 1  68                   pla
001630r 1  20 rr rr             jsr     vdp_reg
001633r 1  AE rr rr             ldx     tmp
001636r 1  E8                   inx
001637r 1  E8                   inx
001638r 1  E0 16                cpx     #F18A_N * 2
00163Ar 1  D0 E8                bne     @fr
00163Cr 1  20 rr rr             jsr     cls
00163Fr 1  A9 C2                lda     #$C2            ; R1: display on, 16K, 16 x 16 sprites,
001641r 1  A2 01                ldx     #1              ; and bit 5 (the VDP interrupt) off
001643r 1  4C rr rr             jmp     vdp_reg
001646r 1               
