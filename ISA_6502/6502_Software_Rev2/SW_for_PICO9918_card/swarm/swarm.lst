0028C8r 2  1D 1D 1D 1D          .byte   $1D, $1D, $1D, $1D, $1D, $1D, $1D, $1D, $1D, $1D, $1D, $1D, $1D, $1D, $1D, $1D
0028CCr 2  1D 1D 1D 1D  
0028D0r 2  1D 1D 1D 1D  
0028D8r 2  1D 1D 1D 1D          .byte   $1D, $1D, $1D, $1D, $1D, $1D, $1D, $1D, $1D, $1D, $1D, $1D, $1D, $1D, $1D, $1D
0028DCr 2  1D 1D 1D 1D  
0028E0r 2  1D 1D 1D 1D  
0028E8r 2               FM_PAT0       = $A0           ; the formation: + (kind * 2 + wings) * 4: TL TR BL BR
0028E8r 2               STAR_PAT0     = $60           ; + (y & 7) / 2 * 8 + (x & 7); dim + $20
0028E8r 2               LIFE_PAT0     = $01           ; TL TR BL BR
0028E8r 2               RED_FONT      = $A0           ; added to a character: red
0028E8r 2               two3:
0028E8r 2  00 01 01 02          .byte   $00, $01, $01, $02, $03, $03, $04, $05, $05, $06, $07, $07, $08, $09, $09, $0A
0028ECr 2  03 03 04 05  
