; flight paths: frames, turn ... then $FF home, $FE attack, $FD away
PATH_TOP      = 0
PATH_SIDE     = 1
PATH_DIVE     = 2
PATH_DIVE2    = 3
PATH_B_LOOP   = 4
PATH_B_WAVE   = 5
PATH_B_DIP    = 6
PATH_B_ARC    = 7
path_lo:        .byte   <path_top, <path_side, <path_dive, <path_dive2, <path_b_loop, <path_b_wave, <path_b_dip, <path_b_arc
path_hi:        .byte   >path_top, >path_side, >path_dive, >path_dive2, >path_b_loop, >path_b_wave, >path_b_dip, >path_b_arc
