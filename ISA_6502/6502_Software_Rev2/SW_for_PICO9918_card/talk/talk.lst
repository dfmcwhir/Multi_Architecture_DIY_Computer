000000r 1               ; ============================================================================
000000r 1               ; talk.s - text to speech on the SPO256-AL2 (CPU Rev2, any display)
000000r 1               ;
000000r 1               ;   build:  make.bat  (TALK.BIN, loads and runs at $0800)
000000r 1               ;
000000r 1               ; Type a line and it is spoken.  Commands:
000000r 1               ;   /F NAME   speak a text file (the current drive and folder); Esc stops
000000r 1               ;   /P        show the allophones as they are spoken (on / off)
000000r 1               ;   /A ...    speak allophones by name or number:  /A HH1 EH LL OW
000000r 1               ;   /?        help
000000r 1               ;   /Q        quit (back to the file manager or the boot menu)
000000r 1               ;
000000r 1               ; How (tts_ref.py is the same thing in Python, and the test's reference):
000000r 1               ;  1. normalise: upper case; numbers to words (0-65535, longer ones digit by
000000r 1               ;     digit); , ; : -> ','   . ! -> '.'   ? '-' kept; the rest spaces
000000r 1               ;  2. xlate: the US Naval Research Lab's letter-to-sound rules (NRL Report
000000r 1               ;     7948, 1976: 329 rules, public domain) turn letters into phonemes;
000000r 1               ;     a short word list (words.txt) is checked first
000000r 1               ;  3. allo: phonemes -> SPO256 allophones, choosing by the sounds around
000000r 1               ;     (KK1/KK2/KK3, DD1/DD2, R-coloured vowels, ...), short pauses before
000000r 1               ;     stops, PA3 between words, PA4 at commas, PA5 at full stops
000000r 1               ;  4. SBC_SAY queues them (the ROM feeds the chip from the VIA interrupt)
000000r 1               ;
000000r 1               ; No zero page is used.
000000r 1               ; ============================================================================
000000r 1               
000000r 1                       .include "sbc_api.inc"
000000r 2               ; sbc_api.inc - fixed ROM entry points of the SBC (see jumptable.s), and the
000000r 2               ; CPU clock.  Use in your own ca65 programs:  .include "sbc_api.inc"
000000r 2               ; (the games find it one folder up: their make.bat passes  -I ..  to ca65)
000000r 2               SBC_CHRIN       = $FE00         ; carry set + A = char, carry clear = none waiting
000000r 2               SBC_CHROUT      = $FE03         ; print A (A, X, Y preserved)
000000r 2               SBC_MENU        = $FE06         ; boot menu
000000r 2               SBC_COLD        = $FE09         ; BASIC cold start
000000r 2               SBC_WARM        = $FE0C         ; BASIC warm start
000000r 2               SBC_MONITOR     = $FE0F         ; monitor prompt (or JMP $FF00)
000000r 2               SBC_PADSTATE    = $FE12         ; A = gamepad buttons held: bit0 A,1 B,2 Select,3 Start,4 Up,5 Down,6 Left,7 Right
000000r 2               SBC_LOAD        = $FE15         ; load a file from the current device (U: or C:): A/Y = parameter block (.word addr, .word max, "NAME.EXT",0)
000000r 2                                               ;   carry clear = loaded, X/Y = length; carry set = failed, A = error code
000000r 2               SBC_CWD         = $FE18         ; A/Y = the monitor's current folder: 0-ended, "" (the top) or "/A/B"
000000r 2                                               ;   (newer ROMs: check for a JMP ($4C) at $FE18 first)
000000r 2               
000000r 2               ; ---- CPU Rev2 ROMs (API version 2).  Check first:  LDA $FE1B / CMP #$4C,
000000r 2               ;      then JSR SBC_SYSINFO and check Y >= 2.
000000r 2               SBC_SYSINFO     = $FE1B         ; A = display type (DISP_...), X = device status, Y = API version
000000r 2               SBC_SEROUT      = $FE1E         ; send A out of the serial console port (A, X, Y preserved)
000000r 2               SBC_MOUSEON     = $FE21         ; A = 1 mouse reports on, 0 off (off at reset); C=1 = no mouse
000000r 2               SBC_MOUSE       = $FE24         ; A = buttons (bit0 L, 1 R, 2 M), X/Y = signed movement since
000000r 2                                               ;   the last call (right/down +); C=1 = a report arrived
000000r 2               SBC_BANKSET     = $FE27         ; A = RAM bank 0-15 for $1000-$7EFF (X, Y kept).  Your code that
000000r 2                                               ;   calls it must be in $0000-$0FFF, or it switches itself out!
000000r 2               SBC_BANKGET     = $FE2A         ; A = bank selected, X = number of banks fitted
000000r 2               SBC_TICKS       = $FE2D         ; A/X/Y = 60 Hz counter, low/middle/high
000000r 2               SBC_ACIAIN      = $FE30         ; serial card 6551: C=1 + A = byte, C=0 none
000000r 2               SBC_ACIAOUT     = $FE33         ; serial card 6551: send A (A, X, Y preserved)
000000r 2               SBC_VSYNC       = $FE36         ; C=1 if a frame ended since the last call (PICO9918 / ESP32_VGA),
000000r 2                                               ;   A = the VDP status / ESP32 STATUS
000000r 2               SBC_CONRESET    = $FE39         ; display back to the text console, cleared (call it when
000000r 2                                               ;   your game exits after changing the display mode)
000000r 2               SBC_SNDNOTE     = $FE3C         ; A/Y -> 5 bytes: voice (AY 0-2, ESP32 0-3), note (0-95, 36 = C4),
000000r 2                                               ;   volume (0-15; AY 16 = envelope), time (16 bit, 1/60 s,
000000r 2                                               ;   0 = hold).  Doesn't wait.  C=1 = bad values
000000r 2               SBC_SNDQUIET    = $FE3F         ; all sound off
000000r 2               SBC_SNDBUSY     = $FE42         ; A = voice: C=1 while its timed note is still playing
000000r 2               SBC_SAY         = $FE45         ; A/Y -> SPO256 allophones (0-63) ended by $FF; queued
000000r 2               SBC_SAYBUSY     = $FE48         ; C=1 while the SPO256 is speaking
000000r 2               SBC_AYREAD      = $FE4B         ; X = AY register (14/15 = I/O ports A/B) -> A
000000r 2               SBC_AYWRITE     = $FE4E         ; AY register X = A (register 7 bits 6/7 = ports A/B output)
000000r 2               SBC_TIME        = $FE51         ; A/Y -> 18 byte buffer <- "mm/dd/yy hh:mm:ss",0 (CF card's DS1302);
000000r 2                                               ;   C=1 = no clock
000000r 2               SBC_SETTIME     = $FE54         ; A/Y -> 14 characters "dwyymmddHHMMSS" (dw 01 = Sunday)
000000r 2               SBC_DIR         = $FE57         ; stage 6: A/Y -> block: .word table, .byte most entries, .byte device
000000r 2                                               ;   ('U', 'C' or 0 = as it is): the current folder (SBC_CWD) into the
000000r 2                                               ;   table, 16 bytes an entry: name 8, ext 3 (space padded), attributes
000000r 2                                               ;   ($10 = folder), size 4.  C=0: A = entries; C=1: A = error code
000000r 2               SBC_RUN         = $FE5A         ; stage 6: A/Y -> block: .byte 0 = .BIN (bank 0, $0800) / 1 = BASIC
000000r 2                                               ;   program, .byte device, "NAME.EXT",0 (in the current folder).
000000r 2                                               ;   Returns only on an error: C=1, A = code
000000r 2               SBC_SHELL       = $FE5D         ; stage 6: A = the RAM bank of a shell ($1000 JMP, $1003 "SH65"):
000000r 2                                               ;   SBC_MENU then goes back to it.  A = 0: none.  C=1: no shell there
000000r 2               SBC_COPY        = $FE60         ; stage 6b: A/Y -> block: .byte source device ('U'/'C'), .word -> source
000000r 2                                               ;   path "/A/NAME.EXT",0, .byte destination device, .word -> its path.
000000r 2                                               ;   Uses every RAM bank but yours as the buffer (bank 0 is lost).
000000r 2                                               ;   C=0 copied; C=1, A = error ($F0 too big)
000000r 2               SBC_DELETE      = $FE63         ; stage 6b: A/Y -> block: .byte device, .word -> path.  C=1, A = error
000000r 2                                               ;   ($42 not found, $FD the drive can't delete)
000000r 2               SBC_DISPTYPE    = $FEFF         ; a byte: the display type (DISP_...)
000000r 2               
000000r 2               ; SBC_SYSINFO display types
000000r 2               DISP_NONE       = 0
000000r 2               DISP_TERM       = 1             ; KB_MONITOR_TERM (PIC32 terminal)
000000r 2               DISP_PICO       = 2             ; PICO9918
000000r 2               DISP_ESP32      = 3             ; ESP32_VGA
000000r 2               
000000r 2               ; SBC_SYSINFO device status bits (X)
000000r 2               DEV_VIA         = $01
000000r 2               DEV_ACIA        = $02
000000r 2               DEV_DISPLAY     = $04
000000r 2               DEV_AVRKBD      = $08
000000r 2               
000000r 2               ; Key codes from the AVR keyboard interface (Serial Rev3 / PICO9918 card)
000000r 2               KEY_UP          = $05           ; ^E  (WordStar)
000000r 2               KEY_DOWN        = $18           ; ^X
000000r 2               KEY_LEFT        = $10           ; ^P
000000r 2               KEY_RIGHT       = $04           ; ^D
000000r 2               KEY_ESC         = $03           ; Esc sends ^C
000000r 2               KEY_F1          = 129           ; F1-F12 = 129-140, shifted 141-152
000000r 2               
000000r 2               ; First RAM address for loaded programs (CPU Rev2 ROM)
000000r 2               SBC_USER_RAM    = $0800
000000r 2               
000000r 2               ; The CPU clock in MHz (whole numbers, 1 to 8).  Programs size their delay
000000r 2               ; loops from it, so a millisecond stays a millisecond.  To build for another
000000r 2               ; clock, change it here or give it on the command line:  make.bat 1
000000r 2               .ifndef CLOCK_MHZ
000000r 2               CLOCK_MHZ       = 2
000000r 2               .endif
000000r 2               
000000r 1               
000000r 1               SPO_PORT        = $7F26
000000r 1               TB_MAX          = 190           ; a chunk of text (numbers may add 60)
000000r 1               LINE_MAX        = 120
000000r 1               AB_FLUSH        = 200           ; allophones queued at once (at a pause)
000000r 1               K_BS            = $08
000000r 1               K_CR            = $0D
000000r 1               K_ESC           = $1B
000000r 1               
000000r 1               ; character classes (ctab)
000000r 1               C_VOW           = $01           ; A E I O U Y
000000r 1               C_CON           = $02           ; the other letters
000000r 1               C_VCD           = $04           ; B D V G J L M N R W Z
000000r 1               C_FRN           = $08           ; E I Y
000000r 1               C_LET           = $10
000000r 1               C_SIB           = $20           ; S C G Z X J
000000r 1               C_LNG           = $40           ; T S R D L Z N J
000000r 1               
000000r 1                       .segment "CODE"
000000r 1  D8           start:  cld
000001r 1  A9 00                lda     #0
000003r 1  8D rr rr             sta     show
000006r 1  8D rr rr             sta     spo
000009r 1  AD 26 7F             lda     SPO_PORT        ; an idle SPO256: STBY = 1, /LRQ = 0
00000Cr 1  29 03                and     #$03
00000Er 1  C9 01                cmp     #$01
000010r 1  D0 03                bne     :+
000012r 1  EE rr rr             inc     spo
000015r 1  A9 rr        :       lda     #<s_hello
000017r 1  A0 rr                ldy     #>s_hello
000019r 1  20 rr rr             jsr     puts
00001Cr 1  AD rr rr             lda     spo
00001Fr 1  D0 0C                bne     main
000021r 1  A9 rr                lda     #<s_nochip
000023r 1  A0 rr                ldy     #>s_nochip
000025r 1  20 rr rr             jsr     puts
000028r 1  A9 01                lda     #1
00002Ar 1  8D rr rr             sta     show
00002Dr 1               
00002Dr 1  A9 rr        main:   lda     #<s_prompt
00002Fr 1  A0 rr                ldy     #>s_prompt
000031r 1  20 rr rr             jsr     puts
000034r 1  20 rr rr             jsr     getline
000037r 1  AD rr rr             lda     llen
00003Ar 1  F0 F1                beq     main
00003Cr 1  AD rr rr             lda     line
00003Fr 1  C9 2F                cmp     #'/'
000041r 1  D0 06                bne     @say
000043r 1  20 rr rr             jsr     command
000046r 1  4C rr rr             jmp     main
000049r 1  A9 rr        @say:   lda     #<line          ; speak the line
00004Br 1  8D rr rr             sta     src
00004Er 1  A9 rr                lda     #>line
000050r 1  8D rr rr             sta     src+1
000053r 1  AD rr rr             lda     llen
000056r 1  18                   clc
000057r 1  69 rr                adc     #<line
000059r 1  8D rr rr             sta     send
00005Cr 1  A9 rr                lda     #>line
00005Er 1  69 00                adc     #0
000060r 1  8D rr rr             sta     send+1
000063r 1  A9 00                lda     #0
000065r 1  8D rr rr             sta     echo
000068r 1  20 rr rr             jsr     speak
00006Br 1  4C rr rr             jmp     main
00006Er 1               
00006Er 1               ; ----------------------------------------------------------------------------
00006Er 1               ; commands
00006Er 1               ; ----------------------------------------------------------------------------
00006Er 1               command:
00006Er 1  AD rr rr             lda     line+1
000071r 1  C9 61                cmp     #'a'
000073r 1  90 02                bcc     :+
000075r 1  29 DF                and     #$DF
000077r 1  C9 51        :       cmp     #'Q'
000079r 1  D0 06                bne     @nq
00007Br 1  20 39 FE             jsr     SBC_CONRESET
00007Er 1  4C 06 FE             jmp     SBC_MENU
000081r 1  C9 50        @nq:    cmp     #'P'
000083r 1  D0 18                bne     @np
000085r 1  AD rr rr             lda     show
000088r 1  49 01                eor     #1
00008Ar 1  8D rr rr             sta     show
00008Dr 1  A9 rr                lda     #<s_showon
00008Fr 1  A0 rr                ldy     #>s_showon
000091r 1  AE rr rr             ldx     show
000094r 1  D0 04                bne     :+
000096r 1  A9 rr                lda     #<s_showoff
000098r 1  A0 rr                ldy     #>s_showoff
00009Ar 1  4C rr rr     :       jmp     puts
00009Dr 1  C9 46        @np:    cmp     #'F'
00009Fr 1  D0 03                bne     @nf
0000A1r 1  4C rr rr             jmp     cmd_file
0000A4r 1  C9 41        @nf:    cmp     #'A'
0000A6r 1  D0 03                bne     @na
0000A8r 1  4C rr rr             jmp     cmd_allo
0000ABr 1  A9 rr        @na:    lda     #<s_help
0000ADr 1  A0 rr                ldy     #>s_help
0000AFr 1  4C rr rr             jmp     puts
0000B2r 1               
0000B2r 1               ; /F NAME: load the file and speak it, showing the text
0000B2r 1               cmd_file:
0000B2r 1  A2 02                ldx     #2              ; the name (after spaces)
0000B4r 1  EC rr rr     @sp:    cpx     llen
0000B7r 1  B0 44                bcs     @noname
0000B9r 1  BD rr rr             lda     line,x
0000BCr 1  C9 20                cmp     #' '
0000BEr 1  D0 03                bne     @nm
0000C0r 1  E8                   inx
0000C1r 1  D0 F1                bne     @sp
0000C3r 1  A0 00        @nm:    ldy     #0
0000C5r 1  EC rr rr     @cp:    cpx     llen
0000C8r 1  B0 16                bcs     @e
0000CAr 1  BD rr rr             lda     line,x
0000CDr 1  C9 61                cmp     #'a'
0000CFr 1  90 06                bcc     :+
0000D1r 1  C9 7B                cmp     #'z'+1
0000D3r 1  B0 02                bcs     :+
0000D5r 1  29 DF                and     #$DF
0000D7r 1  99 rr rr     :       sta     ldblk+4,y
0000DAr 1  E8                   inx
0000DBr 1  C8                   iny
0000DCr 1  C0 0D                cpy     #13
0000DEr 1  90 E5                bcc     @cp
0000E0r 1  A9 00        @e:     lda     #0
0000E2r 1  99 rr rr             sta     ldblk+4,y
0000E5r 1  A9 rr                lda     #<ldblk
0000E7r 1  A0 rr                ldy     #>ldblk
0000E9r 1  20 15 FE             jsr     SBC_LOAD
0000ECr 1  90 16                bcc     @ok
0000EEr 1  48                   pha
0000EFr 1  A9 rr                lda     #<s_ferr
0000F1r 1  A0 rr                ldy     #>s_ferr
0000F3r 1  20 rr rr             jsr     puts
0000F6r 1  68                   pla
0000F7r 1  20 rr rr             jsr     puthex
0000FAr 1  4C rr rr             jmp     crlf
0000FDr 1               @noname:
0000FDr 1  A9 rr                lda     #<s_help
0000FFr 1  A0 rr                ldy     #>s_help
000101r 1  4C rr rr             jmp     puts
000104r 1  8E rr rr     @ok:    stx     t1              ; X/Y = the length
000107r 1  A9 rr                lda     #<fbuf
000109r 1  8D rr rr             sta     src
00010Cr 1  18                   clc
00010Dr 1  6D rr rr             adc     t1
000110r 1  8D rr rr             sta     send
000113r 1  A9 rr                lda     #>fbuf
000115r 1  8D rr rr             sta     src+1
000118r 1  98                   tya
000119r 1  69 rr                adc     #>fbuf
00011Br 1  8D rr rr             sta     send+1
00011Er 1  A9 01                lda     #1
000120r 1  8D rr rr             sta     echo
000123r 1  20 rr rr             jsr     crlf
000126r 1  20 rr rr             jsr     speak
000129r 1  4C rr rr             jmp     crlf
00012Cr 1               
00012Cr 1               ; /A names or numbers: those allophones
00012Cr 1               cmd_allo:
00012Cr 1  A9 00                lda     #0
00012Er 1  8D rr rr             sta     na
000131r 1  A2 02                ldx     #2
000133r 1  EC rr rr     @tok:   cpx     llen            ; the next word
000136r 1  90 03                bcc     :+
000138r 1  4C rr rr             jmp     @say
00013Br 1               :       ; (far)
00013Br 1  BD rr rr             lda     line,x
00013Er 1  C9 20                cmp     #' '
000140r 1  D0 03                bne     @w
000142r 1  E8                   inx
000143r 1  D0 EE                bne     @tok
000145r 1  8E rr rr     @w:     stx     t2              ; its start
000148r 1  EC rr rr     @we:    cpx     llen
00014Br 1  B0 0A                bcs     @wd
00014Dr 1  BD rr rr             lda     line,x
000150r 1  C9 20                cmp     #' '
000152r 1  F0 03                beq     @wd
000154r 1  E8                   inx
000155r 1  D0 F1                bne     @we
000157r 1  8E rr rr     @wd:    stx     t3              ; its end
00015Ar 1  AE rr rr             ldx     t2
00015Dr 1  BD rr rr             lda     line,x
000160r 1  C9 30                cmp     #'0'
000162r 1  90 35                bcc     @name
000164r 1  C9 3A                cmp     #'9'+1
000166r 1  B0 31                bcs     @name
000168r 1  A9 00                lda     #0              ; a number
00016Ar 1  8D rr rr             sta     t4
00016Dr 1  EC rr rr     @dig:   cpx     t3
000170r 1  B0 1B                bcs     @num
000172r 1  AD rr rr             lda     t4              ; t4 = t4 * 10 + digit
000175r 1  0A                   asl
000176r 1  0A                   asl
000177r 1  6D rr rr             adc     t4
00017Ar 1  0A                   asl
00017Br 1  8D rr rr             sta     t4
00017Er 1  BD rr rr             lda     line,x
000181r 1  29 0F                and     #$0F
000183r 1  18                   clc
000184r 1  6D rr rr             adc     t4
000187r 1  8D rr rr             sta     t4
00018Ar 1  E8                   inx
00018Br 1  D0 E0                bne     @dig
00018Dr 1  AD rr rr     @num:   lda     t4
000190r 1  C9 40                cmp     #64
000192r 1  B0 67                bcs     @bad
000194r 1  B0 03                bcs     :+
000196r 1  4C rr rr             jmp     @put
000199r 1               :       ; (far)
000199r 1  AD rr rr     @name:  lda     t3              ; a name: 1-3 letters against al_name
00019Cr 1  38                   sec
00019Dr 1  ED rr rr             sbc     t2
0001A0r 1  C9 04                cmp     #4
0001A2r 1  B0 57                bcs     @bad
0001A4r 1  8D rr rr             sta     t5              ; (its length)
0001A7r 1  A9 00                lda     #0
0001A9r 1  8D rr rr             sta     t4
0001ACr 1  AD rr rr     @try:   lda     t4              ; t6 = 3 * t4
0001AFr 1  0A                   asl
0001B0r 1  6D rr rr             adc     t4
0001B3r 1  8D rr rr             sta     t6
0001B6r 1  A2 00                ldx     #0
0001B8r 1  EC rr rr     @c:     cpx     t5
0001BBr 1  F0 23                beq     @tail
0001BDr 1  8A                   txa
0001BEr 1  18                   clc
0001BFr 1  6D rr rr             adc     t2
0001C2r 1  A8                   tay
0001C3r 1  B9 rr rr             lda     line,y
0001C6r 1  C9 61                cmp     #'a'
0001C8r 1  90 02                bcc     :+
0001CAr 1  29 DF                and     #$DF
0001CCr 1  8D rr rr     :       sta     t1
0001CFr 1  8A                   txa
0001D0r 1  18                   clc
0001D1r 1  6D rr rr             adc     t6
0001D4r 1  A8                   tay
0001D5r 1  B9 rr rr             lda     al_name,y
0001D8r 1  CD rr rr             cmp     t1
0001DBr 1  D0 14                bne     @next
0001DDr 1  E8                   inx
0001DEr 1  D0 D8                bne     @c
0001E0r 1  E0 03        @tail:  cpx     #3              ; the rest of the name blank?
0001E2r 1  F0 35                beq     @found
0001E4r 1  8A                   txa
0001E5r 1  18                   clc
0001E6r 1  6D rr rr             adc     t6
0001E9r 1  A8                   tay
0001EAr 1  B9 rr rr             lda     al_name,y
0001EDr 1  C9 20                cmp     #' '
0001EFr 1  F0 28                beq     @found
0001F1r 1  EE rr rr     @next:  inc     t4
0001F4r 1  AD rr rr             lda     t4
0001F7r 1  C9 40                cmp     #64
0001F9r 1  90 B1                bcc     @try
0001FBr 1  A9 3F        @bad:   lda     #'?'            ; not one: shown, skipped
0001FDr 1  20 03 FE             jsr     SBC_CHROUT
000200r 1  AE rr rr             ldx     t2
000203r 1  EC rr rr     @bl:    cpx     t3
000206r 1  B0 09                bcs     @bn
000208r 1  BD rr rr             lda     line,x
00020Br 1  20 03 FE             jsr     SBC_CHROUT
00020Er 1  E8                   inx
00020Fr 1  D0 F2                bne     @bl
000211r 1  A9 20        @bn:    lda     #' '
000213r 1  20 03 FE             jsr     SBC_CHROUT
000216r 1  4C rr rr             jmp     @nx
000219r 1  AD rr rr     @found: lda     t4
00021Cr 1  AE rr rr     @put:   ldx     na
00021Fr 1  9D rr rr             sta     abuf,x
000222r 1  EE rr rr             inc     na
000225r 1  AE rr rr     @nx:    ldx     t3
000228r 1  4C rr rr             jmp     @tok
00022Br 1  20 rr rr     @say:   jsr     crlf
00022Er 1  4C rr rr             jmp     flush
000231r 1               
000231r 1               ; ----------------------------------------------------------------------------
000231r 1               ; speak src .. send: a chunk at a time (Esc / Q between chunks stops it)
000231r 1               ; ----------------------------------------------------------------------------
000231r 1  A9 00        speak:  lda     #0
000233r 1  8D rr rr             sta     na
000236r 1  20 rr rr     @ch:    jsr     at_end
000239r 1  B0 27                bcs     @r
00023Br 1  20 rr rr             jsr     normalise
00023Er 1  20 rr rr             jsr     xlate
000241r 1  20 rr rr             jsr     allo
000244r 1  20 rr rr             jsr     flush
000247r 1  AD rr rr             lda     show
00024Ar 1  F0 03                beq     :+
00024Cr 1  20 rr rr             jsr     crlf
