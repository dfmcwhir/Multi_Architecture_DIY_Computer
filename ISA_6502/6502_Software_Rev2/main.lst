00135Ar 3               .assert * - pico_font = 768, error, "pico_font must be 768 bytes"
00135Ar 3               
00135Ar 2               
00135Ar 1               .endif
00135Ar 1               .include "drv_spo.s"            ; SPO256 speech chip
00135Ar 2               ; ============================================================================
00135Ar 2               ; drv_spo.s - SPO256A-AL2 speech chip on the AY-3-8910 sound card ($7F26)
00135Ar 2               ;
00135Ar 2               ;   $7F26 write: allophone (0-63)
00135Ar 2               ;   $7F26 read : D0 = STBY (1 = idle), D1 = /LRQ (0 = ready for the next one)
00135Ar 2               ;
00135Ar 2               ; Allophones go into a 64 byte queue.  With the VIA fitted the queue is fed
00135Ar 2               ; from its timer interrupt (every timeout: 60-180 times a second), so a
00135Ar 2               ; program hands over a whole phrase and carries on while it is spoken.  The
00135Ar 2               ; chip asks for its next allophone while it is still saying the last one, so
00135Ar 2               ; there are no gaps.  Without the VIA, SPO_PUT feeds the chip itself.
00135Ar 2               ;
00135Ar 2               ; Keep the card's SPO256 IRQ jumper (IRQ7) OFF: /LRQ stays low whenever the
00135Ar 2               ; chip is waiting, and nothing in software can turn it off, so it would
00135Ar 2               ; interrupt the CPU continuously.
00135Ar 2               ; ============================================================================
00135Ar 2               
00135Ar 2               SPO_PORT        = $7F26
00135Ar 2               SPO_QLEN        = 64                    ; (a power of 2)
00135Ar 2               SPO_PAUSE       = 3                     ; PA4: a short pause after each SAY
00135Ar 2               
00135Ar 2               .segment "DRVVARS"
000167r 2  xx           spo_ok:         .res 1                  ; $80 = the chip answered
000168r 2  xx           spo_in:         .res 1
000169r 2  xx           spo_out:        .res 1
00016Ar 2  xx xx xx xx  spo_q:          .res SPO_QLEN
00016Er 2  xx xx xx xx  
000172r 2  xx xx xx xx  
0001AAr 2               
0001AAr 2               .segment "BIOS"
00135Ar 2               
00135Ar 2               ; ----------------------------------------------------------------------------
00135Ar 2               ; spo_init - an idle SPO256 reads STBY = 1 and /LRQ = 0 (an empty bus reads
00135Ar 2               ; $7F: both 1).  Clobbers A.
00135Ar 2               ; ----------------------------------------------------------------------------
00135Ar 2               spo_init:
00135Ar 2  A9 00                lda     #0
00135Cr 2  8D rr rr             sta     spo_ok
00135Fr 2  8D rr rr             sta     spo_in
001362r 2  8D rr rr             sta     spo_out
001365r 2  AD 26 7F             lda     SPO_PORT
001368r 2  29 03                and     #$03
00136Ar 2  C9 01                cmp     #$01
00136Cr 2  D0 05                bne     @x
00136Er 2  A9 80                lda     #$80
001370r 2  8D rr rr             sta     spo_ok
001373r 2  60           @x:     rts
001374r 2               
001374r 2               ; ----------------------------------------------------------------------------
001374r 2               ; spo_tick - from the VIA interrupt (and SPO_PUT without a VIA): if the chip
001374r 2               ; wants an allophone and one is waiting, give it.  Clobbers A, X.
001374r 2               ; ----------------------------------------------------------------------------
001374r 2               spo_tick:
001374r 2  2C rr rr             bit     spo_ok
001377r 2  10 1C                bpl     @x
001379r 2  AE rr rr             ldx     spo_out
00137Cr 2  EC rr rr             cpx     spo_in
00137Fr 2  F0 14                beq     @x                      ; nothing waiting
001381r 2  AD 26 7F             lda     SPO_PORT
001384r 2  29 02                and     #$02                    ; /LRQ high: still busy
001386r 2  D0 0D                bne     @x
001388r 2  BD rr rr             lda     spo_q,x
00138Br 2  8D 26 7F             sta     SPO_PORT
00138Er 2  E8                   inx
00138Fr 2  8A                   txa
001390r 2  29 3F                and     #(SPO_QLEN - 1)
001392r 2  8D rr rr             sta     spo_out
001395r 2  60           @x:     rts
001396r 2               
001396r 2               ; ----------------------------------------------------------------------------
001396r 2               ; SPO_PUT - queue allophone A (0-63).  Waits while the queue is full.
001396r 2               ; Preserves X and Y.  Nothing happens if there is no chip.
001396r 2               ; ----------------------------------------------------------------------------
001396r 2               SPO_PUT:
001396r 2  2C rr rr             bit     spo_ok
001399r 2  10 29                bpl     @r
00139Br 2  29 3F                and     #$3F
00139Dr 2  48                   pha
00139Er 2  8A                   txa
00139Fr 2  48                   pha
0013A0r 2  AD rr rr     @full:  lda     spo_in                  ; full: (in + 1) = out
0013A3r 2  18                   clc
0013A4r 2  69 01                adc     #1
0013A6r 2  29 3F                and     #(SPO_QLEN - 1)
0013A8r 2  CD rr rr             cmp     spo_out
0013ABr 2  D0 03                bne     @room
0013ADr 2               .if .not HAS_VIA
0013ADr 2                       php
0013ADr 2                       sei
0013ADr 2                       jsr     spo_tick                ; no timer: feed it from here
0013ADr 2                       plp
0013ADr 2               .endif
0013ADr 2  4C rr rr             jmp     @full
0013B0r 2  BA           @room:  tsx
0013B1r 2  BD 02 01             lda     $0102,x                 ; the allophone
0013B4r 2  AE rr rr             ldx     spo_in
0013B7r 2  9D rr rr             sta     spo_q,x
0013BAr 2  E8                   inx
0013BBr 2  8A                   txa
0013BCr 2  29 3F                and     #(SPO_QLEN - 1)
0013BEr 2  8D rr rr             sta     spo_in
0013C1r 2  68                   pla
0013C2r 2  AA                   tax
0013C3r 2  68                   pla
0013C4r 2               .if .not HAS_VIA
0013C4r 2                       php
0013C4r 2                       sei
0013C4r 2                       jsr     spo_tick
0013C4r 2                       plp
0013C4r 2               .endif
0013C4r 2  60           @r:     rts
0013C5r 2               
0013C5r 2               ; ----------------------------------------------------------------------------
0013C5r 2               ; SPO_DRAIN - without the VIA: feed the chip until the queue is empty.
0013C5r 2               ; ----------------------------------------------------------------------------
0013C5r 2               SPO_DRAIN:
0013C5r 2               .if .not HAS_VIA
0013C5r 2                       bit     spo_ok
0013C5r 2                       bpl     @r
0013C5r 2               @l:     lda     spo_in
0013C5r 2                       cmp     spo_out
0013C5r 2                       beq     @r
0013C5r 2                       php
0013C5r 2                       sei
0013C5r 2                       jsr     spo_tick
0013C5r 2                       plp
0013C5r 2                       jmp     @l
0013C5r 2               .endif
0013C5r 2  60           @r:     rts
0013C6r 2               
0013C6r 2               ; ----------------------------------------------------------------------------
0013C6r 2               ; SPO_BUSY - C=1 while allophones are waiting or the chip is still speaking
0013C6r 2               ; ----------------------------------------------------------------------------
0013C6r 2               SPO_BUSY:
0013C6r 2  2C rr rr             bit     spo_ok
0013C9r 2  10 11                bpl     @no
0013CBr 2  AD rr rr             lda     spo_in
0013CEr 2  CD rr rr             cmp     spo_out
0013D1r 2  D0 07                bne     @yes
0013D3r 2  AD 26 7F             lda     SPO_PORT
0013D6r 2  29 01                and     #$01                    ; STBY = 0: still speaking
0013D8r 2  D0 02                bne     @no
0013DAr 2  38           @yes:   sec
0013DBr 2  60                   rts
0013DCr 2  18           @no:    clc
0013DDr 2  60                   rts
0013DEr 2               
0013DEr 2               ; ----------------------------------------------------------------------------
0013DEr 2               ; SPO_SAY - queue the allophones at A (low) / Y (high), ended by $FF, then a
0013DEr 2               ; short pause.  Returns at once (with the VIA).  Uses con_ptr.
0013DEr 2               ; ----------------------------------------------------------------------------
0013DEr 2               SPO_SAY:
0013DEr 2  85 rr                sta     con_ptr
0013E0r 2  84 rr                sty     con_ptr+1
0013E2r 2  A0 00                ldy     #0
0013E4r 2  B1 rr        @l:     lda     (con_ptr),y
0013E6r 2  C9 FF                cmp     #$FF
0013E8r 2  F0 06                beq     @end
0013EAr 2  20 rr rr             jsr     SPO_PUT
0013EDr 2  C8                   iny
0013EEr 2  D0 F4                bne     @l
0013F0r 2  A9 03        @end:   lda     #SPO_PAUSE
0013F2r 2  20 rr rr             jsr     SPO_PUT
0013F5r 2  4C rr rr             jmp     SPO_DRAIN
0013F8r 2               
0013F8r 1               .include "ch376_abs.s"          ; CH376 USB/SD driver       (CHVARS, BIOS)
0013F8r 2               ; ============================================================================
0013F8r 2               ; CH376 USB/SD file driver for 6502 - 8-bit PARALLEL interface   (ca65 syntax)
0013F8r 2               ; ============================================================================
0013F8r 2               ; HARDWARE
0013F8r 2               ;   CH376 D0-D7 -> 6502 D0-D7
0013F8r 2               ;   CH376 A0    -> 6502 A0          (A0=0: data port, A0=1: command/status port)
0013F8r 2               ;   CH376 CS#   -> your address decode (active low), e.g. $7F20-$7F21
0013F8r 2               ;   CH376 RD#   -> NAND(PHI2, R/W)          (low during a read cycle)
0013F8r 2               ;   CH376 WR#   -> NAND(PHI2, NOT R/W)      (low during a write cycle)
0013F8r 2               ;   CH376 INT#  -> optional (this code polls bit 7 of the status port instead)
0013F8r 2               ;   CH376 RST   -> reset circuit (or tie low->high at power-up)
0013F8r 2               ;   Many cheap CH376 modules only break out UART/SPI. Make sure your module
0013F8r 2               ;   exposes D0-D7/A0/CS/RD/WR and has the parallel interface selected.
0013F8r 2               ;
0013F8r 2               ; PORTS
0013F8r 2               ;   CH_DATA ($7F20) read/write data bytes
0013F8r 2               ;   CH_CMD  ($7F21) write = command code, read = status
0013F8r 2               ;       bit 7 (INTB): 0 = interrupt active (operation finished)
0013F8r 2               ;       bit 4 (BUSY): 1 = chip busy, don't access yet
0013F8r 2               ;
0013F8r 2               ; CONVENTIONS
0013F8r 2               ;   Routines that return a CH376 status in A: $14 = success, anything else
0013F8r 2               ;   is an error (or a "need data" code for read/write, handled internally).
0013F8r 2               ;   ch_init / ch_mount return carry set on failure.
0013F8r 2               ;   File names: 8.3, UPPERCASE, null terminated, root dir = "/NAME.EXT"
0013F8r 2               ; ============================================================================
0013F8r 2               
0013F8r 2               CH_BASE   = $7F20
0013F8r 2               CH_DATA   = CH_BASE
0013F8r 2               CH_CMD    = CH_BASE + 1
0013F8r 2               
0013F8r 2               ; CPU_KHZ (CPU clock in kHz) comes from config.inc
0013F8r 2               ; (the 40 ms waits use DELAY_MS, cpu_rev2.s, so any clock works)
0013F8r 2               
0013F8r 2               .zeropage
000006r 2  xx xx        zp_ptr:   .res 2    ; 2 bytes of zero page used for (pointer),Y while a transfer runs
000008r 2  xx xx        dir_ptr:  .res 2    ; SBC_DIR: where the next entry goes (shell.s)
00000Ar 2  xx xx        strptr:   .res 2    ; string pointer (LCD routines, monitor and CH376 messages); declared here
00000Cr 2                                   ; so it is known before first use (zero page addressing)
00000Cr 2               
00000Cr 2               ; --- variables -------------------------------------------------------------
00000Cr 2               ; All CH376 variables live in segment CHVARS (placed at $0280 by sbc.cfg).
00000Cr 2               ; Layout is identical to the old VARS+n block (90 bytes total).
00000Cr 2               .segment "CHVARS"
000000r 2  xx xx        ch_ptr:     .res 2   ; buffer pointer (caller sets, advanced by read/write)
000002r 2  xx xx        ch_len:     .res 2   ; bytes requested
000004r 2  xx xx        ch_got:     .res 2   ; bytes actually read (output of ch_read)
000006r 2  xx           ch_cnt:     .res 1   ; chunk counter
000007r 2  xx           ch_tmp:     .res 1   ; timeout counter
000008r 2  xx           ch_retry:   .res 1   ; mount retry counter
000009r 2  xx xx xx xx  ch_off:     .res 4   ; file offset for ch_seek (little endian)
00000Dr 2               ; --- used by ch376_loadsave.s
00000Dr 2  xx xx xx xx  ch_name:    .res 48  ; "/NAME.BAS",0 (a path such as "/GAMES/DEEP/X.BIN" for the monitor)
000011r 2  xx xx xx xx  
000015r 2  xx xx xx xx  
00003Dr 2  xx           ch_ready:   .res 1   ; 0 = CH376 not initialised / mounted
00003Er 2  xx           ch_dot:     .res 1   ; non-zero if the name contained a "."
00003Fr 2  xx           ch_dir:     .res 1   ; non-zero: LOAD "$..." (directory listing)
000040r 2  xx xx xx xx  ch_ent:     .res 32  ; directory entry from the chip
000044r 2  xx xx xx xx  
000048r 2  xx xx xx xx  
000060r 2  xx xx xx xx  ch_num:     .res 4   ; number being printed
000064r 2  xx           ch_col:     .res 1   ; column counter while printing a name
000065r 2  xx           ch_started: .res 1   ; leading-zero suppression flag
000066r 2  xx xx        ch_nfiles:  .res 2   ; files listed
000068r 2  xx           ch_sx:      .res 1   ; saved X / Y around the output routine
000069r 2  xx           ch_sy:      .res 1
00006Ar 2  xx           ch_lastcmd: .res 1   ; last command byte sent to the chip (diagnostics)
00006Br 2  xx           ch_laststs: .res 1   ; raw status port value when a wait timed out
00006Cr 2  xx           ch_mon:     .res 1   ; non-zero while a monitor command is using the CH376 code
00006Dr 2  xx           ch_raw:     .res 1   ; 0 = LOAD/SAVE (.BAS), 1 = LOADRAW/SAVERAW (.DAT)
00006Er 2  xx xx        ch_a0:      .res 2   ; LOADRAW/SAVERAW start address
000070r 2  xx           ch_stat:    .res 1   ; last CH376 status code that caused a ?DISK ERROR
000071r 2               
000071r 2               ; The 6502 can only do (pointer),Y indirection through ZERO PAGE, so two
000071r 2               ; zero-page bytes (zp_ptr, reserved above) are used while a transfer runs.
000071r 2               ; ZP_ENTER/ZP_LEAVE still save/restore them, which is harmless.
000071r 2               
000071r 2               
000071r 2               
000071r 2               .macro ZP_ENTER                      ; save zp pair, load it with ch_ptr
000071r 2                       lda zp_ptr
000071r 2                       pha
000071r 2                       lda zp_ptr+1
000071r 2                       pha
000071r 2                       lda ch_ptr
000071r 2                       sta zp_ptr
000071r 2                       lda ch_ptr+1
000071r 2                       sta zp_ptr+1
000071r 2               .endmacro
000071r 2               
000071r 2               .macro ZP_LEAVE                      ; store advanced pointer back, restore zp
000071r 2                       lda zp_ptr
000071r 2                       sta ch_ptr
000071r 2                       lda zp_ptr+1
000071r 2                       sta ch_ptr+1
000071r 2                       pla
000071r 2                       sta zp_ptr+1
000071r 2                       pla
000071r 2                       sta zp_ptr
000071r 2               .endmacro
000071r 2               
000071r 2               .segment "BIOS"
0013F8r 2               ; --- commands --------------------------------------------------------------
0013F8r 2               CMD_GET_IC_VER    = $01
0013F8r 2               CMD_RESET_ALL     = $05
0013F8r 2               CMD_CHECK_EXIST   = $06
0013F8r 2               CMD_SET_USB_MODE  = $15
0013F8r 2               CMD_GET_STATUS    = $22
0013F8r 2               CMD_RD_USB_DATA0  = $27
0013F8r 2               CMD_WR_REQ_DATA   = $2D
0013F8r 2               CMD_SET_FILE_NAME = $2F
0013F8r 2               CMD_DISK_CONNECT  = $30
0013F8r 2               CMD_DISK_MOUNT    = $31
0013F8r 2               CMD_FILE_OPEN     = $32
0013F8r 2               CMD_FILE_CREATE   = $34
0013F8r 2               CMD_FILE_ERASE    = $35
0013F8r 2               CMD_FILE_CLOSE    = $36
0013F8r 2               CMD_BYTE_LOCATE   = $39
0013F8r 2               CMD_BYTE_READ     = $3A
0013F8r 2               CMD_BYTE_RD_GO    = $3B
0013F8r 2               CMD_BYTE_WRITE    = $3C
0013F8r 2               CMD_BYTE_WR_GO    = $3D
0013F8r 2               
0013F8r 2               ; --- status / result codes -------------------------------------------------
0013F8r 2               CMD_RET_SUCCESS   = $51
0013F8r 2               USB_INT_SUCCESS   = $14
0013F8r 2               USB_INT_CONNECT   = $15
0013F8r 2               USB_INT_DISCONNECT= $16
0013F8r 2               USB_INT_DISK_READ = $1D
0013F8r 2               USB_INT_DISK_WRITE= $1E
0013F8r 2               USB_INT_DISK_ERR  = $1F
0013F8r 2               ERR_MISS_FILE     = $42      ; file not found
0013F8r 2               ERR_DISK_DISCON   = $82
0013F8r 2               ERR_DISK_FULL     = $B1
0013F8r 2               
0013F8r 2               USB_MODE_HOST     = $06      ; host mode, auto SOF
0013F8r 2               
0013F8r 2               
0013F8r 2               
0013F8r 2               ; ----------------------------------------------------------------------------
0013F8r 2               ; Low level
0013F8r 2               ; ----------------------------------------------------------------------------
0013F8r 2               ch_wait_busy:                        ; spin until BUSY (bit 4) clears
0013F8r 2  AD 21 7F             lda CH_CMD
0013FBr 2  29 10                and #$10
0013FDr 2  D0 F9                bne ch_wait_busy
0013FFr 2  60                   rts
001400r 2               
001400r 2               ch_cmd:                              ; A = command code
001400r 2  48                   pha
001401r 2  20 rr rr             jsr ch_wait_busy
001404r 2  68                   pla
001405r 2  8D rr rr             sta ch_lastcmd
001408r 2  8D 21 7F             sta CH_CMD
00140Br 2  EA EA EA EA          .repeat CPU_MHZ + 1          ; chip needs ~1.5us before the next access
00140Fr 2  EA           
001410r 2                       nop                          ; (2 cycles each: 2 us at any clock)
001410r 2                       .endrepeat
001410r 2  60                   rts
001411r 2               
001411r 2               ch_wr:                               ; A = data byte to send
001411r 2  48                   pha
001412r 2  20 rr rr             jsr ch_wait_busy
001415r 2  68                   pla
001416r 2  8D 20 7F             sta CH_DATA
001419r 2  60                   rts
00141Ar 2               
00141Ar 2               ch_rd:                               ; returns data byte in A
00141Ar 2  20 rr rr             jsr ch_wait_busy
00141Dr 2  AD 20 7F             lda CH_DATA
001420r 2  60                   rts
001421r 2               
001421r 2               ch_delay:                            ; X = ticks (~1285 cycles each)
001421r 2  A0 00        @outer: ldy #0
001423r 2  88           @inner: dey
001424r 2  D0 FD                bne @inner
001426r 2  CA                   dex
001427r 2  D0 F8                bne @outer
001429r 2  60                   rts
00142Ar 2               
00142Ar 2               ch_wait_int:                         ; wait for INT (status bit 7 = 0)
00142Ar 2  A9 10                lda #<(4 * CPU_MHZ)          ; ~3 s at any clock
00142Cr 2  8D rr rr             sta ch_tmp
00142Fr 2  A0 00                ldy #0
001431r 2  A2 00                ldx #0
001433r 2  AD 21 7F     @loop:  lda CH_CMD
001436r 2  10 0D                bpl @got
001438r 2  E8                   inx
001439r 2  D0 F8                bne @loop
00143Br 2  C8                   iny
00143Cr 2  D0 F5                bne @loop
00143Er 2  CE rr rr             dec ch_tmp
001441r 2  D0 F0                bne @loop
001443r 2  38                   sec                          ; timeout
001444r 2  60                   rts
001445r 2  18           @got:   clc
001446r 2  60                   rts
001447r 2               
001447r 2               ch_get_status:                       ; returns result code in A, releases INT
001447r 2  A9 22                lda #CMD_GET_STATUS
001449r 2  20 rr rr             jsr ch_cmd
00144Cr 2  4C rr rr             jmp ch_rd
00144Fr 2               
00144Fr 2               ch_wait_status:                      ; wait for INT then read status
00144Fr 2  20 rr rr             jsr ch_wait_int              ; carry set = timeout (A = $FF)
001452r 2  B0 03                bcs @timeout
001454r 2  4C rr rr             jmp ch_get_status
001457r 2               @timeout:
001457r 2  AD 21 7F             lda CH_CMD
00145Ar 2  8D rr rr             sta ch_laststs
00145Dr 2  A9 FF                lda #$FF
00145Fr 2  38                   sec
001460r 2  60                   rts
001461r 2               
001461r 2               ; ----------------------------------------------------------------------------
001461r 2               ; ch_init - reset chip, check it exists, switch to USB host mode
001461r 2               ;   out: carry clear = ok, set = failed
001461r 2               ; ----------------------------------------------------------------------------
001461r 2               ch_init:
001461r 2  A9 05                lda #CMD_RESET_ALL
001463r 2  8D 21 7F             sta CH_CMD                   ; raw write: no busy check during reset
001466r 2  A9 28                lda #40
001468r 2  20 rr rr             jsr DELAY_MS
00146Br 2               
00146Br 2  A9 06                lda #CMD_CHECK_EXIST
00146Dr 2  20 rr rr             jsr ch_cmd
001470r 2  A9 57                lda #$57
001472r 2  20 rr rr             jsr ch_wr
001475r 2  20 rr rr             jsr ch_rd
001478r 2  C9 A8                cmp #$A8                     ; chip returns bitwise NOT of $57
00147Ar 2  D0 18                bne @fail
00147Cr 2               
00147Cr 2  A9 15                lda #CMD_SET_USB_MODE
00147Er 2  20 rr rr             jsr ch_cmd
001481r 2  A9 06                lda #USB_MODE_HOST
001483r 2  20 rr rr             jsr ch_wr
001486r 2  A2 01                ldx #1                       ; >= 20us
001488r 2  20 rr rr             jsr ch_delay
00148Br 2  20 rr rr             jsr ch_rd
00148Er 2  C9 51                cmp #CMD_RET_SUCCESS
001490r 2  D0 02                bne @fail
001492r 2  18                   clc
001493r 2  60                   rts
001494r 2  38           @fail:  sec
001495r 2  60                   rts
001496r 2               
001496r 2               ; ----------------------------------------------------------------------------
001496r 2               ; ch_mount - wait for USB drive, connect + mount the filesystem
001496r 2               ;   out: carry clear = ok, set = no drive / unreadable filesystem
001496r 2               ; ----------------------------------------------------------------------------
001496r 2               ch_mount:
001496r 2  20 rr rr             jsr ch_wait_status           ; expect "device connected"
001499r 2  C9 15                cmp #USB_INT_CONNECT
00149Br 2  D0 27                bne @fail
00149Dr 2               
00149Dr 2  A9 30                lda #CMD_DISK_CONNECT
00149Fr 2  20 rr rr             jsr ch_cmd
0014A2r 2  20 rr rr             jsr ch_wait_status
0014A5r 2  C9 14                cmp #USB_INT_SUCCESS
0014A7r 2  D0 1B                bne @fail
0014A9r 2               
0014A9r 2  A9 05                lda #5
0014ABr 2  8D rr rr             sta ch_retry
0014AEr 2  A9 31        @try:   lda #CMD_DISK_MOUNT          ; some drives need a few tries
0014B0r 2  20 rr rr             jsr ch_cmd
0014B3r 2  20 rr rr             jsr ch_wait_status
0014B6r 2  C9 14                cmp #USB_INT_SUCCESS
0014B8r 2  F0 0C                beq @ok
0014BAr 2  A9 28                lda #40
0014BCr 2  20 rr rr             jsr DELAY_MS
0014BFr 2  CE rr rr             dec ch_retry
0014C2r 2  D0 EA                bne @try
0014C4r 2  38           @fail:  sec
0014C5r 2  60                   rts
0014C6r 2  18           @ok:    clc
0014C7r 2  60                   rts
0014C8r 2               
0014C8r 2               ; ----------------------------------------------------------------------------
0014C8r 2               ; File name / open / create / close
0014C8r 2               ; ----------------------------------------------------------------------------
0014C8r 2               ch_set_name:                         ; A = name lo, X = name hi
0014C8r 2  8D rr rr             sta ch_ptr
0014CBr 2  8E rr rr             stx ch_ptr+1
0014CEr 2  A5 rr 48 A5          ZP_ENTER
0014D2r 2  rr 48 AD rr  
0014D6r 2  rr 85 rr AD  
0014DEr 2  A9 2F                lda #CMD_SET_FILE_NAME
0014E0r 2  20 rr rr             jsr ch_cmd
0014E3r 2  A0 00                ldy #0
0014E5r 2  B1 rr        @l:     lda (zp_ptr),y
0014E7r 2  20 rr rr             jsr ch_wr
0014EAr 2  B1 rr                lda (zp_ptr),y
0014ECr 2  F0 03                beq @done                    ; terminator was sent too
0014EEr 2  C8                   iny
0014EFr 2  D0 F4                bne @l
0014F1r 2  A5 rr 8D rr  @done:  ZP_LEAVE
0014F5r 2  rr A5 rr 8D  
0014F9r 2  rr rr 68 85  
001501r 2  60                   rts
001502r 2               
001502r 2               ch_file_open:                        ; A/X = name. returns status in A
001502r 2  20 rr rr             jsr ch_set_name
001505r 2  A9 32                lda #CMD_FILE_OPEN
001507r 2  20 rr rr             jsr ch_cmd
00150Ar 2  4C rr rr             jmp ch_wait_status
00150Dr 2               
00150Dr 2               ch_file_create:                      ; A/X = name. creates/truncates file
00150Dr 2  20 rr rr             jsr ch_set_name
001510r 2  A9 34                lda #CMD_FILE_CREATE
001512r 2  20 rr rr             jsr ch_cmd
001515r 2  4C rr rr             jmp ch_wait_status
001518r 2               
001518r 2               ch_file_erase:                       ; A/X = name. deletes file
001518r 2  20 rr rr             jsr ch_set_name
00151Br 2  A9 35                lda #CMD_FILE_ERASE
00151Dr 2  20 rr rr             jsr ch_cmd
001520r 2  4C rr rr             jmp ch_wait_status
001523r 2               
001523r 2               ch_file_close:                       ; A = 1 update file length (after writing)
001523r 2  48                   pha                          ;     0 = no update (after reading)
001524r 2  A9 36                lda #CMD_FILE_CLOSE
001526r 2  20 rr rr             jsr ch_cmd
001529r 2  68                   pla
00152Ar 2  20 rr rr             jsr ch_wr
00152Dr 2  4C rr rr             jmp ch_wait_status
001530r 2               
001530r 2               ; ch_seek - move file pointer to 32-bit offset in ch_off (little endian)
001530r 2               ;   Set ch_off = $FFFFFFFF to seek to end (for appending).
001530r 2               ch_seek:
001530r 2  A9 39                lda #CMD_BYTE_LOCATE
001532r 2  20 rr rr             jsr ch_cmd
001535r 2  A2 00                ldx #0
001537r 2  BD rr rr     @l:     lda ch_off,x
00153Ar 2  20 rr rr             jsr ch_wr
00153Dr 2  E8                   inx
00153Er 2  E0 04                cpx #4
001540r 2  D0 F5                bne @l
001542r 2  4C rr rr             jmp ch_wait_status
001545r 2               
001545r 2               ; ----------------------------------------------------------------------------
001545r 2               ; ch_read - read ch_len bytes from the open file into (ch_ptr)
001545r 2               ;   in : ch_ptr = destination, ch_len = max bytes
001545r 2               ;   out: A = $14 on success, ch_got = bytes actually read (less at EOF),
001545r 2               ;        ch_ptr advanced past the data
001545r 2               ; ----------------------------------------------------------------------------
001545r 2               ch_read:
001545r 2  A5 rr 48 A5          ZP_ENTER
001549r 2  rr 48 AD rr  
00154Dr 2  rr 85 rr AD  
001555r 2  A9 00                lda #0
001557r 2  8D rr rr             sta ch_got
00155Ar 2  8D rr rr             sta ch_got+1
00155Dr 2  A9 3A                lda #CMD_BYTE_READ
00155Fr 2  20 rr rr             jsr ch_cmd
001562r 2  AD rr rr             lda ch_len
001565r 2  20 rr rr             jsr ch_wr
001568r 2  AD rr rr             lda ch_len+1
00156Br 2  20 rr rr             jsr ch_wr
00156Er 2  20 rr rr     @next:  jsr ch_wait_status
001571r 2  C9 1D                cmp #USB_INT_DISK_READ       ; $1D = a chunk (<=64 bytes) is ready
001573r 2  D0 3D                bne @done                    ; $14 = finished, else error
001575r 2  A9 27                lda #CMD_RD_USB_DATA0
001577r 2  20 rr rr             jsr ch_cmd
00157Ar 2  20 rr rr             jsr ch_rd                    ; first byte = chunk length
00157Dr 2  8D rr rr             sta ch_cnt
001580r 2  F0 28                beq @go
001582r 2  A0 00                ldy #0
001584r 2  20 rr rr     @copy:  jsr ch_rd
001587r 2  91 rr                sta (zp_ptr),y
001589r 2  C8                   iny
00158Ar 2  CC rr rr             cpy ch_cnt
00158Dr 2  D0 F5                bne @copy
00158Fr 2  18                   clc                          ; zp_ptr += ch_cnt
001590r 2  A5 rr                lda zp_ptr
001592r 2  6D rr rr             adc ch_cnt
001595r 2  85 rr                sta zp_ptr
001597r 2  90 02                bcc :+
001599r 2  E6 rr                inc zp_ptr+1
00159Br 2  18           :       clc                          ; ch_got += ch_cnt
00159Cr 2  AD rr rr             lda ch_got
00159Fr 2  6D rr rr             adc ch_cnt
0015A2r 2  8D rr rr             sta ch_got
0015A5r 2  90 03                bcc @go
0015A7r 2  EE rr rr             inc ch_got+1
0015AAr 2  A9 3B        @go:    lda #CMD_BYTE_RD_GO          ; ask for next chunk
0015ACr 2  20 rr rr             jsr ch_cmd
0015AFr 2  4C rr rr             jmp @next
0015B2r 2  AA           @done:  tax                          ; keep status while restoring zp
0015B3r 2  A5 rr 8D rr          ZP_LEAVE
0015B7r 2  rr A5 rr 8D  
0015BBr 2  rr rr 68 85  
0015C3r 2  8A                   txa
0015C4r 2  60                   rts
0015C5r 2               
0015C5r 2               ; ----------------------------------------------------------------------------
0015C5r 2               ; ch_write - write ch_len bytes from (ch_ptr) to the open file
0015C5r 2               ;   in : ch_ptr = source, ch_len = byte count
0015C5r 2               ;   out: A = $14 on success, ch_ptr advanced
0015C5r 2               ;   Call ch_file_close with A=1 afterwards so the file length is saved.
0015C5r 2               ; ----------------------------------------------------------------------------
0015C5r 2               ch_write:
0015C5r 2  A5 rr 48 A5          ZP_ENTER
0015C9r 2  rr 48 AD rr  
0015CDr 2  rr 85 rr AD  
0015D5r 2  A9 3C                lda #CMD_BYTE_WRITE
0015D7r 2  20 rr rr             jsr ch_cmd
0015DAr 2  AD rr rr             lda ch_len
0015DDr 2  20 rr rr             jsr ch_wr
0015E0r 2  AD rr rr             lda ch_len+1
0015E3r 2  20 rr rr             jsr ch_wr
0015E6r 2  20 rr rr     @next:  jsr ch_wait_status
0015E9r 2  C9 1E                cmp #USB_INT_DISK_WRITE      ; $1E = chip wants more data
0015EBr 2  D0 2E                bne @done                    ; $14 = finished, else error
0015EDr 2  A9 2D                lda #CMD_WR_REQ_DATA
0015EFr 2  20 rr rr             jsr ch_cmd
0015F2r 2  20 rr rr             jsr ch_rd                    ; how many bytes it wants (<=64)
0015F5r 2  8D rr rr             sta ch_cnt
0015F8r 2  F0 19                beq @go
0015FAr 2  A0 00                ldy #0
0015FCr 2  B1 rr        @copy:  lda (zp_ptr),y
0015FEr 2  20 rr rr             jsr ch_wr
001601r 2  C8                   iny
001602r 2  CC rr rr             cpy ch_cnt
001605r 2  D0 F5                bne @copy
001607r 2  18                   clc
001608r 2  A5 rr                lda zp_ptr
00160Ar 2  6D rr rr             adc ch_cnt
00160Dr 2  85 rr                sta zp_ptr
00160Fr 2  90 02                bcc @go
001611r 2  E6 rr                inc zp_ptr+1
001613r 2  A9 3D        @go:    lda #CMD_BYTE_WR_GO
001615r 2  20 rr rr             jsr ch_cmd
001618r 2  4C rr rr             jmp @next
00161Br 2  AA           @done:  tax
00161Cr 2  A5 rr 8D rr          ZP_LEAVE
001620r 2  rr A5 rr 8D  
001624r 2  rr rr 68 85  
00162Cr 2  8A                   txa
00162Dr 2  60                   rts
00162Er 2               
00162Er 2               
00162Er 1               .include "ch376_loadsave.s"     ; LOAD / SAVE / LOAD "$"    (BIOS)
00162Er 2               ; ============================================================================
00162Er 2               ; ch376_loadsave.s - EhBASIC "LOAD" and "SAVE" using the CH376 driver in
00162Er 2               ; ch376_abs.s (ch_init, ch_mount, ch_file_open, ch_file_create, ch_file_close,
00162Er 2               ; ch_read, ch_write ...).
00162Er 2               ;
00162Er 2               ;   LOAD "NAME"      -> reads /NAME.BAS into the BASIC program area
00162Er 2               ;   SAVE "NAME"      -> writes the current program to /NAME.BAS
00162Er 2               ;   LOAD "$"         -> lists the files in the root directory (the program in
00162Er 2               ;                       memory is NOT touched)
00162Er 2               ;   LOAD "$T*"       -> lists only matching files (the CH376's own wildcard
00162Er 2               ;                       matching, e.g. "$*.BAS" or "$GAME*")
00162Er 2               ;
00162Er 2               ;   - "U:" or "C:" in front picks the USB drive or the CF card (fs.s), e.g.
00162Er 2               ;     LOAD "C:GAME" or LOAD "C:$".  It stays picked until changed.
00162Er 2               ;   - The name is any string expression, converted to UPPERCASE.
00162Er 2               ;   - ".BAS" is appended if the name contains no ".".
00162Er 2               ;   - A leading "/" is added for you (root directory). "DIR/NAME" works too.
00162Er 2               ;   - SAVE writes BASIC's in-memory tokenised program (Smeml..Svarl-1).
00162Er 2               ;     Line links are rebuilt after loading, so files don't depend on where
00162Er 2               ;     the program was saved from.
00162Er 2               ;   - LOAD also takes a plain-text listing made on a PC (CR, LF or CR/LF line
00162Er 2               ;     ends).  A file with no $00 byte in it is text: it is moved to the top
00162Er 2               ;     of memory and fed to BASIC's line entry as if it were typed, quietly
00162Er 2               ;     (see ld_text / ld_getc).  Lines without a line number are skipped, not
00162Er 2               ;     run.  Lines longer than BASIC's input buffer (71 characters) are cut
00162Er 2               ;     short and reported.
00162Er 2               ;
00162Er 2               ; HOW EhBASIC CALLS US
00162Er 2               ;   basic.s dispatches the LOAD/SAVE tokens through V_LOAD/V_SAVE, which do
00162Er 2               ;   JMP (VEC_LD) / JMP (VEC_SV).  bios.s copies the addresses of CH_LOAD and
00162Er 2               ;   CH_SAVE into those RAM vectors at reset.  On entry the BASIC execute pointer
00162Er 2               ;   (Bpntrl/h) is just past the keyword, so we evaluate the argument with
00162Er 2               ;   LAB_EVEX/LAB_EVST.  SAVE finishes with RTS (back to the interpreter);
00162Er 2               ;   LOAD re-links the program and exits through LAB_1319 to the prompt.
00162Er 2               ;
00162Er 2               ; Variables (ch_name, ch_ready, ...) are declared in ch376_abs.s (CHVARS).
00162Er 2               ; ============================================================================
00162Er 2               
00162Er 2               .segment "BIOS"
00162Er 2               
00162Er 2               CH_NAME_MAX = 26                    ; longest name typed by the user
00162Er 2               
00162Er 2               ; EhBASIC error codes (offsets into LAB_BAER) used for argument errors
00162Er 2               EH_ERR_FC    = $08                  ; ?Function call error
00162Er 2               EH_ERR_TM    = $18                  ; ?Type mismatch   (raised by LAB_EVST)
00162Er 2               EH_ERR_LS    = $1A                  ; ?String too long
00162Er 2               
00162Er 2               CMD_FILE_ENUM_GO = $33              ; next directory entry
00162Er 2               
00162Er 2               ; --- private failure codes (CH376 codes are all < $F0)
00162Er 2               CH_E_TOOBIG  = $F0
00162Er 2               CH_E_BADFILE = $F1
00162Er 2               CH_E_NODISK  = $F2
00162Er 2               
00162Er 2               ; continue if A = USB_INT_SUCCESS, otherwise jump to "target" with A intact
00162Er 2               .macro CH_OK target
00162Er 2                       .local ok
00162Er 2                       cmp #USB_INT_SUCCESS
00162Er 2                       beq ok
00162Er 2                       jmp target
00162Er 2               ok:
00162Er 2               .endmacro
00162Er 2               
00162Er 2               ; ----------------------------------------------------------------------------
00162Er 2               ; CH_BOOT - call once at power-up/reset
00162Er 2               ; ----------------------------------------------------------------------------
00162Er 2               CH_BOOT:
00162Er 2  A9 00                lda #0
001630r 2  8D rr rr             sta ch_ready
001633r 2  8D rr rr             sta ch_mon
001636r 2  8D rr rr             sta ld_on                   ; no text LOAD running (CHRIN/CHROUT test it)
001639r 2  4C rr rr             jmp fs_boot                 ; (fs.s: the default device, the CF not mounted)
00163Cr 2               
00163Cr 2               ; ----------------------------------------------------------------------------
00163Cr 2               ; CH_LOAD  - BASIC LOAD "name"
00163Cr 2               ; ----------------------------------------------------------------------------
00163Cr 2               CH_LOAD:
00163Cr 2  A9 00                lda #0
00163Er 2  8D rr rr             sta ch_raw
001641r 2  20 rr rr             jsr ch_get_filename
001644r 2  AD rr rr             lda ch_dir                  ; LOAD "$..." -> directory listing
001647r 2  F0 03                beq @file
001649r 2  4C rr rr             jmp fs_dirlist
00164Cr 2  20 rr rr     @file:  jsr fs_prepare
00164Fr 2  90 05                bcc @ready
001651r 2  A9 F2                lda #CH_E_NODISK
001653r 2  4C rr rr             jmp ch_fail
001656r 2  20 rr rr     @ready: jsr mon_open                 ; (a path: its folders entered one by one)
001659r 2  C9 14 F0 03          CH_OK ch_fail
00165Dr 2  4C rr rr     
001660r 2               
001660r 2  38                   sec                         ; ch_len = Ememl - Smeml (room available)
001661r 2  A5 85                lda Ememl
001663r 2  E5 79                sbc Smeml
001665r 2  8D rr rr             sta ch_len
001668r 2  A5 86                lda Ememh
00166Ar 2  E5 7A                sbc Smemh
00166Cr 2  8D rr rr             sta ch_len+1
00166Fr 2  A5 79                lda Smeml                   ; destination = start of program
001671r 2  8D rr rr             sta ch_ptr
001674r 2  A5 7A                lda Smemh
001676r 2  8D rr rr             sta ch_ptr+1
001679r 2  20 rr rr             jsr fs_read
00167Cr 2  C9 14 F0 03          CH_OK ch_fail_close
001680r 2  4C rr rr     
001683r 2               
001683r 2  AD rr rr             lda ch_got+1                ; got >= room?  -> file did not fit
001686r 2  CD rr rr             cmp ch_len+1
001689r 2  90 0F                bcc @fits
00168Br 2  D0 08                bne @toobig
00168Dr 2  AD rr rr             lda ch_got
001690r 2  CD rr rr             cmp ch_len
001693r 2  90 05                bcc @fits
001695r 2               @toobig:
001695r 2  A9 F0                lda #CH_E_TOOBIG
001697r 2  4C rr rr             jmp ch_fail_close
00169Ar 2  AD rr rr     @fits:  lda ch_got+1                ; a program is at least 2 bytes ($00 $00)
00169Dr 2  D0 0C                bne @sizeok
00169Fr 2  AD rr rr             lda ch_got
0016A2r 2  C9 02                cmp #2
0016A4r 2  B0 05                bcs @sizeok
0016A6r 2  A9 F1                lda #CH_E_BADFILE
0016A8r 2  4C rr rr             jmp ch_fail_close
0016ABr 2               @sizeok:
0016ABr 2  A9 00                lda #0
0016ADr 2  20 rr rr             jsr fs_close
0016B0r 2  20 rr rr             jsr ld_istext               ; plain text (no $00 bytes in it)?
0016B3r 2  90 03                bcc @tokens
0016B5r 2  4C rr rr             jmp ld_text                 ; yes: type it in line by line
0016B8r 2               @tokens:
0016B8r 2  AD rr rr             lda ch_ptr                 ; ch_read advanced ch_ptr to end of data
0016BBr 2  85 7B                sta Svarl                   ; = new end of program / start of variables
0016BDr 2  AD rr rr             lda ch_ptr+1
0016C0r 2  85 7C                sta Svarh
0016C2r 2  A9 00                lda #0                      ; same as the warm start entry: clear any
0016C4r 2  85 DF                sta IrqBase                 ; ON IRQ / ON NMI set-up
0016C6r 2  85 DC                sta NmiBase
0016C8r 2  A9 rr                lda #<LAB_RMSG              ; print CR,LF,"Ready",CR,LF
0016CAr 2  A0 rr                ldy #>LAB_RMSG
0016CCr 2  20 rr rr             jsr ch_puts
0016CFr 2  4C rr rr             jmp LAB_1319                ; flush stack, CLEAR, rebuild line links, then
0016D2r 2                                                   ; wait for a command (we are not returning)
0016D2r 2               
0016D2r 2               ; ----------------------------------------------------------------------------
0016D2r 2               ; Text LOAD.  The file has been read to Smeml..ch_ptr-1 (ch_got bytes).
0016D2r 2               ; ----------------------------------------------------------------------------
0016D2r 2               .segment "DRVVARS"
0001AAr 2  xx           ld_on:      .res 1                  ; bit 7 set while a text file is being typed in
0001ABr 2  xx xx        ld_ptr:     .res 2                  ; next text byte
0001ADr 2  xx xx        ld_end:     .res 2                  ; end of the text (= the real end of memory)
0001AFr 2  xx           ld_last:    .res 1                  ; last character handed to BASIC
0001B0r 2  xx           ld_col:     .res 1                  ; characters on this line so far
0001B1r 2  xx           ld_skip:    .res 1                  ; non-zero: skipping a line with no number
0001B2r 2  xx           ld_long:    .res 1                  ; non-zero: some line was too long
0001B3r 2               .segment "BIOS"
0016D2r 2               
0016D2r 2               LD_MAXCOL = Ibuffe-Ibuffs           ; BASIC's input buffer size
0016D2r 2               
0016D2r 2               ; ld_istext - C=1 if there is no $00 byte in Smeml..ch_ptr-1
0016D2r 2               ; (a tokenised program always has $00 line ends)
0016D2r 2               ld_istext:
0016D2r 2  A5 79                lda Smeml
0016D4r 2  85 rr                sta zp_ptr
0016D6r 2  A5 7A                lda Smemh
0016D8r 2  85 rr                sta zp_ptr+1
0016DAr 2  A0 00                ldy #0
0016DCr 2  A5 rr        @lp:    lda zp_ptr
0016DEr 2  CD rr rr             cmp ch_ptr
0016E1r 2  D0 07                bne @chk
0016E3r 2  A5 rr                lda zp_ptr+1
0016E5r 2  CD rr rr             cmp ch_ptr+1
0016E8r 2  F0 0F                beq @yes
0016EAr 2  B1 rr        @chk:   lda (zp_ptr),y
0016ECr 2  F0 09                beq @no
0016EEr 2  E6 rr                inc zp_ptr
0016F0r 2  D0 EA                bne @lp
0016F2r 2  E6 rr                inc zp_ptr+1
0016F4r 2  4C rr rr             jmp @lp
0016F7r 2  18           @no:    clc
0016F8r 2  60                   rts
0016F9r 2  38           @yes:   sec
0016FAr 2  60                   rts
0016FBr 2               
0016FBr 2               ; ld_text - move the text to the top of memory, lower the end of memory to
0016FBr 2               ; just below it (so BASIC's own ?Out of memory check protects it), clear the
0016FBr 2               ; program and let BASIC's line entry read the text through CHRIN.
0016FBr 2               ld_text:
0016FBr 2  AD rr rr             lda ch_ptr                  ; source end
0016FEr 2  85 rr                sta zp_ptr
001700r 2  AD rr rr             lda ch_ptr+1
001703r 2  85 rr                sta zp_ptr+1
001705r 2  A5 85                lda Ememl                   ; destination end
001707r 2  85 rr                sta strptr
001709r 2  8D rr rr             sta ld_end
00170Cr 2  A5 86                lda Ememh
00170Er 2  85 rr                sta strptr+1
001710r 2  8D rr rr             sta ld_end+1
001713r 2  AD rr rr             lda ch_got                  ; count
001716r 2  8D rr rr             sta ch_len
001719r 2  AD rr rr             lda ch_got+1
00171Cr 2  8D rr rr             sta ch_len+1
00171Fr 2  A0 00                ldy #0
001721r 2  AD rr rr     @mv:    lda ch_len                  ; copy downwards from the top (the areas
001724r 2  0D rr rr             ora ch_len+1                ; may overlap)
001727r 2  F0 22                beq @moved
001729r 2  A5 rr                lda zp_ptr
00172Br 2  D0 02                bne :+
00172Dr 2  C6 rr                dec zp_ptr+1
00172Fr 2  C6 rr        :       dec zp_ptr
001731r 2  A5 rr                lda strptr
001733r 2  D0 02                bne :+
001735r 2  C6 rr                dec strptr+1
001737r 2  C6 rr        :       dec strptr
001739r 2  B1 rr                lda (zp_ptr),y
00173Br 2  91 rr                sta (strptr),y
00173Dr 2  AD rr rr             lda ch_len
001740r 2  D0 03                bne :+
001742r 2  CE rr rr             dec ch_len+1
001745r 2  CE rr rr     :       dec ch_len
001748r 2  4C rr rr             jmp @mv
00174Br 2  A5 rr        @moved: lda strptr                  ; start of the text = new end of memory
00174Dr 2  8D rr rr             sta ld_ptr
001750r 2  85 85                sta Ememl
001752r 2  A5 rr                lda strptr+1
001754r 2  8D rr rr             sta ld_ptr+1
001757r 2  85 86                sta Ememh
001759r 2  A9 0D                lda #$0D
00175Br 2  8D rr rr             sta ld_last
00175Er 2  A9 00                lda #0
001760r 2  8D rr rr             sta ld_col
001763r 2  8D rr rr             sta ld_skip
001766r 2  8D rr rr             sta ld_long
001769r 2  A8                   tay                         ; NEW: empty program
00176Ar 2  91 79                sta (Smeml),y
00176Cr 2  C8                   iny
00176Dr 2  91 79                sta (Smeml),y
00176Fr 2  18                   clc
001770r 2  A5 79                lda Smeml
001772r 2  69 02                adc #2
001774r 2  85 7B                sta Svarl
001776r 2  A5 7A                lda Smemh
001778r 2  69 00                adc #0
00177Ar 2  85 7C                sta Svarh
00177Cr 2  A9 00                lda #0
00177Er 2  85 DF                sta IrqBase
001780r 2  85 DC                sta NmiBase
001782r 2  A9 80                lda #$80                    ; CHRIN now reads the text, CHROUT is quiet
001784r 2  8D rr rr             sta ld_on
001787r 2  4C rr rr             jmp LAB_1319                ; CLEAR, flush the stack, wait for "input"
00178Ar 2               
00178Ar 2               ; ld_restore - give BASIC its real end of memory back.  Preserves X and Y.
00178Ar 2               ld_restore:
00178Ar 2  AD rr rr             lda ld_end
00178Dr 2  85 85                sta Ememl
00178Fr 2  85 81                sta Sstorl
001791r 2  AD rr rr             lda ld_end+1
001794r 2  85 86                sta Ememh
001796r 2  85 82                sta Sstorh
001798r 2  60                   rts
001799r 2               
001799r 2               ; ld_abort - called at the start of BASIC's error handler (LAB_XERR) so an
001799r 2               ; error during a text LOAD (e.g. ?Out of memory) stops it and is shown.
001799r 2               ; Preserves X (the error code) and Y.
001799r 2               ld_abort:
001799r 2  2C rr rr             bit ld_on
00179Cr 2  10 08                bpl @x
00179Er 2  A9 00                lda #0
0017A0r 2  8D rr rr             sta ld_on
0017A3r 2  4C rr rr             jmp ld_restore
0017A6r 2  60           @x:     rts
0017A7r 2               
0017A7r 2               ; ld_getc - CHRIN while a text LOAD runs.  Returns the next character with
0017A7r 2               ; C=1 (Z/N set from it), CR at line ends; at the end of the text it switches
0017A7r 2               ; back to the keyboard, prints the result and returns C=0, A=0.
0017A7r 2               ; Preserves X and Y.
0017A7r 2               ld_getc:
0017A7r 2  8A                   txa
0017A8r 2  48                   pha
0017A9r 2  98                   tya
0017AAr 2  48                   pha
0017ABr 2  A5 rr                lda zp_ptr
0017ADr 2  48                   pha
0017AEr 2  A5 rr                lda zp_ptr+1
0017B0r 2  48                   pha
0017B1r 2  AD rr rr     @next:  lda ld_ptr
0017B4r 2  CD rr rr             cmp ld_end
0017B7r 2  D0 17                bne @get
0017B9r 2  AD rr rr             lda ld_ptr+1
0017BCr 2  CD rr rr             cmp ld_end+1
0017BFr 2  D0 0F                bne @get
0017C1r 2  AD rr rr             lda ld_last                 ; end of the text: finish the last line
0017C4r 2  C9 0D                cmp #$0D
0017C6r 2  D0 03                bne :+
0017C8r 2  4C rr rr             jmp @done
0017CBr 2  A9 0D        :       lda #$0D
0017CDr 2  4C rr rr             jmp @eol
0017D0r 2  AD rr rr     @get:   lda ld_ptr
0017D3r 2  85 rr                sta zp_ptr
0017D5r 2  AD rr rr             lda ld_ptr+1
0017D8r 2  85 rr                sta zp_ptr+1
0017DAr 2  A0 00                ldy #0
0017DCr 2  B1 rr                lda (zp_ptr),y
0017DEr 2  EE rr rr             inc ld_ptr
0017E1r 2  D0 03                bne :+
0017E3r 2  EE rr rr             inc ld_ptr+1
0017E6r 2  C9 0A        :       cmp #$0A                    ; LF: a line end, unless right after CR
0017E8r 2  D0 09                bne @notlf
0017EAr 2  AD rr rr             lda ld_last
0017EDr 2  C9 0D                cmp #$0D
0017EFr 2  F0 C0                beq @next
0017F1r 2  A9 0D                lda #$0D
0017F3r 2  C9 0D        @notlf: cmp #$0D
0017F5r 2  F0 3C                beq @eol
0017F7r 2  C9 09                cmp #$09                    ; TAB -> space
0017F9r 2  D0 02                bne :+
0017FBr 2  A9 20                lda #' '
0017FDr 2  C9 20        :       cmp #' '
0017FFr 2  90 B0                bcc @next                   ; other control characters
001801r 2  C9 7F                cmp #$7F
001803r 2  B0 AC                bcs @next                   ; DEL and 8-bit bytes
001805r 2  AC rr rr             ldy ld_skip
001808r 2  D0 A7                bne @next                   ; in a line with no number
00180Ar 2  AC rr rr             ldy ld_col
00180Dr 2  D0 13                bne @count
00180Fr 2  C9 20                cmp #' '                    ; leading spaces don't count
001811r 2  F0 28                beq @ret
001813r 2  C9 30                cmp #'0'                    ; first character must be a digit
001815r 2  90 04                bcc @nonum
001817r 2  C9 3A                cmp #'9'+1
001819r 2  90 07                bcc @count
00181Br 2  A9 01        @nonum: lda #1
00181Dr 2  8D rr rr             sta ld_skip
001820r 2  D0 8F                bne @next                   ; always
001822r 2  EE rr rr     @count: inc ld_col
001825r 2  AC rr rr             ldy ld_col
001828r 2  C0 48                cpy #LD_MAXCOL+1
00182Ar 2  90 0F                bcc @ret
00182Cr 2  A0 01                ldy #1
00182Er 2  8C rr rr             sty ld_long
001831r 2  D0 08                bne @ret                    ; always
001833r 2  A0 00        @eol:   ldy #0
001835r 2  8C rr rr             sty ld_col
001838r 2  8C rr rr             sty ld_skip
00183Br 2  8D rr rr     @ret:   sta ld_last
00183Er 2  68                   pla
00183Fr 2  85 rr                sta zp_ptr+1
001841r 2  68                   pla
001842r 2  85 rr                sta zp_ptr
001844r 2  68                   pla
001845r 2  A8                   tay
001846r 2  68                   pla
001847r 2  AA                   tax
001848r 2  AD rr rr             lda ld_last                 ; Z/N from the character
00184Br 2  38                   sec
00184Cr 2  60                   rts
00184Dr 2               
00184Dr 2  A9 00        @done:  lda #0                      ; back to the keyboard
00184Fr 2  8D rr rr             sta ld_on
001852r 2  20 rr rr             jsr ld_restore
001855r 2  68                   pla
001856r 2  85 rr                sta zp_ptr+1
001858r 2  68                   pla
001859r 2  85 rr                sta zp_ptr
00185Br 2  AD rr rr             lda ld_long
00185Er 2  F0 07                beq @rdy
001860r 2  A9 rr                lda #<ld_msg_long
001862r 2  A0 rr                ldy #>ld_msg_long
001864r 2  20 rr rr             jsr ch_puts
001867r 2  A9 rr        @rdy:   lda #<LAB_RMSG
001869r 2  A0 rr                ldy #>LAB_RMSG
00186Br 2  20 rr rr             jsr ch_puts
00186Er 2  68                   pla
00186Fr 2  A8                   tay
001870r 2  68                   pla
001871r 2  AA                   tax
001872r 2  A9 00                lda #0
001874r 2  18                   clc
001875r 2  60                   rts
001876r 2               
001876r 2               ld_msg_long:
001876r 2  0D 0A 3F 41          .byte $0D,$0A,"?A LINE WAS TOO LONG (OVER 71) AND WAS CUT SHORT",$00
00187Ar 2  20 4C 49 4E  
00187Er 2  45 20 57 41  
0018A9r 2               
0018A9r 2               ; ----------------------------------------------------------------------------
0018A9r 2               ; CH_SAVE  - BASIC SAVE "name"
0018A9r 2               ; ----------------------------------------------------------------------------
0018A9r 2               CH_SAVE:
0018A9r 2  A9 00                lda #0
0018ABr 2  8D rr rr             sta ch_raw
0018AEr 2  20 rr rr             jsr ch_get_filename
0018B1r 2  AD rr rr             lda ch_dir                  ; SAVE "$..." makes no sense
0018B4r 2  F0 05                beq @ok1
0018B6r 2  A2 08                ldx #EH_ERR_FC
0018B8r 2  4C rr rr             jmp LAB_XERR
0018BBr 2  20 rr rr     @ok1:   jsr fs_prepare
0018BEr 2  90 05                bcc @ready
0018C0r 2  A9 F2                lda #CH_E_NODISK
0018C2r 2  4C rr rr             jmp ch_fail
0018C5r 2  A9 rr        @ready: lda #<ch_name
0018C7r 2  A2 rr                ldx #>ch_name
0018C9r 2  20 rr rr             jsr fs_create          ; creates / replaces the file
0018CCr 2  C9 14 F0 03          CH_OK ch_fail
0018D0r 2  4C rr rr     
0018D3r 2               
0018D3r 2  38                   sec                         ; ch_len = Svarl - Smeml
0018D4r 2  A5 7B                lda Svarl
0018D6r 2  E5 79                sbc Smeml
0018D8r 2  8D rr rr             sta ch_len
0018DBr 2  A5 7C                lda Svarh
0018DDr 2  E5 7A                sbc Smemh
0018DFr 2  8D rr rr             sta ch_len+1
0018E2r 2  A5 79                lda Smeml                   ; source = start of program
0018E4r 2  8D rr rr             sta ch_ptr
0018E7r 2  A5 7A                lda Smemh
0018E9r 2  8D rr rr             sta ch_ptr+1
0018ECr 2  20 rr rr             jsr fs_write
0018EFr 2  C9 14 F0 03          CH_OK ch_fail_close
0018F3r 2  4C rr rr     
0018F6r 2               
0018F6r 2  A9 01                lda #1                      ; close AND update the file length
0018F8r 2  20 rr rr             jsr fs_close
0018FBr 2  C9 14 F0 03          CH_OK ch_fail
0018FFr 2  4C rr rr     
001902r 2  60                   rts                         ; back to BASIC
001903r 2               
001903r 2               ; ----------------------------------------------------------------------------
001903r 2               ; ch_get_filename - evaluate the string argument, build "/NAME.BAS",0 in
001903r 2               ;                   ch_name. Raises normal BASIC errors for bad arguments.
001903r 2               ; ----------------------------------------------------------------------------
001903r 2               ch_get_filename:
001903r 2  20 rr rr             jsr LAB_EVEX                ; evaluate the expression at the BASIC pointer
001906r 2  20 rr rr             jsr LAB_EVST                ; must be a string (else ?Type mismatch);
001909r 2                                                   ; A = length, (ut1_pl) -> characters
001909r 2  8D rr rr             sta ch_cnt
00190Cr 2  F0 36                beq @bad
00190Er 2  C9 02                cmp #2                      ; "U:..." / "C:...": the device first
001910r 2  90 26                bcc @nodev
001912r 2  A0 01                ldy #1
001914r 2  B1 71                lda (ut1_pl),y
001916r 2  C9 3A                cmp #':'
001918r 2  D0 1E                bne @nodev
00191Ar 2  88                   dey
00191Br 2  B1 71                lda (ut1_pl),y
00191Dr 2  20 rr rr             jsr fs_letter
001920r 2  B0 22                bcs @bad                    ; not a device letter
001922r 2  18                   clc                         ; skip the 2 characters
001923r 2  A5 71                lda ut1_pl
001925r 2  69 02                adc #2
001927r 2  85 71                sta ut1_pl
001929r 2  90 02                bcc :+
00192Br 2  E6 72                inc ut1_ph
00192Dr 2  AD rr rr     :       lda ch_cnt
001930r 2  38                   sec
001931r 2  E9 02                sbc #2
001933r 2  8D rr rr             sta ch_cnt
001936r 2  F0 0C                beq @bad                    ; nothing after it
001938r 2  AD rr rr     @nodev: lda ch_cnt
00193Br 2  C9 1B                cmp #CH_NAME_MAX+1
00193Dr 2  90 0A                bcc @ok
00193Fr 2  A2 1A                ldx #EH_ERR_LS              ; ?String too long
001941r 2  4C rr rr             jmp LAB_XERR
001944r 2  A2 08        @bad:   ldx #EH_ERR_FC              ; empty name -> ?Function call error
001946r 2  4C rr rr             jmp LAB_XERR
001949r 2  A9 00        @ok:    lda #0
00194Br 2  8D rr rr             sta ch_dot
00194Er 2  8D rr rr             sta ch_dir
001951r 2  A9 2F                lda #'/'
001953r 2  8D rr rr             sta ch_name
001956r 2  A2 01                ldx #1                      ; X = index into ch_name
001958r 2  A0 00                ldy #0                      ; Y = index into the BASIC string
00195Ar 2  B1 71                lda (ut1_pl),y
00195Cr 2  C9 24                cmp #'$'
00195Er 2  D0 16                bne @copy
001960r 2  A9 01                lda #1                      ; "$..." = directory request
001962r 2  8D rr rr             sta ch_dir
001965r 2  8D rr rr             sta ch_dot                  ; (so no ".BAS" is appended)
001968r 2  C8                   iny                         ; skip the "$"
001969r 2  CC rr rr             cpy ch_cnt
00196Cr 2  D0 08                bne @copy                   ; "$pattern": copy the pattern
00196Er 2  A9 2A                lda #'*'                    ; plain "$": match everything
001970r 2  9D rr rr             sta ch_name,x
001973r 2  E8                   inx
001974r 2  D0 41                bne @term                   ; always taken
001976r 2  B1 71        @copy:  lda (ut1_pl),y
001978r 2  C9 2E                cmp #'.'
00197Ar 2  D0 09                bne @upper
00197Cr 2  A9 01                lda #1
00197Er 2  8D rr rr             sta ch_dot
001981r 2  A9 2E                lda #'.'
001983r 2  D0 0A                bne @store                  ; always taken
001985r 2  C9 61        @upper: cmp #'a'
001987r 2  90 06                bcc @store
001989r 2  C9 7B                cmp #'z'+1
00198Br 2  B0 02                bcs @store
00198Dr 2  29 DF                and #$DF                    ; to uppercase
00198Fr 2  9D rr rr     @store: sta ch_name,x
001992r 2  E8                   inx
001993r 2  C8                   iny
001994r 2  CC rr rr             cpy ch_cnt
001997r 2  D0 DD                bne @copy
001999r 2  AD rr rr             lda ch_dot
00199Cr 2  D0 19                bne @term
00199Er 2  AD rr rr             lda ch_raw                  ; no "." typed: append ".BAS" (LOAD/SAVE),
0019A1r 2  0A                   asl                         ; ".DAT" (LOADRAW/SAVERAW) or ".ARR"
0019A2r 2  0A                   asl                         ; (LOADARR/SAVEARR), 4 characters each
0019A3r 2  A8                   tay
0019A4r 2  18                   clc
0019A5r 2  69 04                adc #4
0019A7r 2  8D rr rr             sta ch_dot                  ; (flag no longer needed) = end index
0019AAr 2  B9 rr rr     @ext:   lda ch_ext,y
0019ADr 2  9D rr rr             sta ch_name,x
0019B0r 2  E8                   inx
0019B1r 2  C8                   iny
0019B2r 2  CC rr rr             cpy ch_dot
0019B5r 2  D0 F3                bne @ext
0019B7r 2  A9 00        @term:  lda #0
0019B9r 2  9D rr rr             sta ch_name,x
0019BCr 2  60                   rts
0019BDr 2               
0019BDr 2  2E 42 41 53  ch_ext: .byte ".BAS"
0019C1r 2  2E 44 41 54          .byte ".DAT"
0019C5r 2  2E 41 52 52          .byte ".ARR"
0019C9r 2               
0019C9r 2               ; ----------------------------------------------------------------------------
0019C9r 2               ; ch_prepare - make sure the CH376 is initialised and the disk is mounted
0019C9r 2               ;   out: carry clear = ready, set = no disk
0019C9r 2               ; ----------------------------------------------------------------------------
0019C9r 2               ch_prepare:
0019C9r 2  AD rr rr             lda ch_ready
0019CCr 2  D0 0F                bne @ok
0019CEr 2  20 rr rr             jsr ch_init
0019D1r 2  B0 0C                bcs @fail
0019D3r 2  20 rr rr             jsr ch_mount
0019D6r 2  B0 07                bcs @fail
0019D8r 2  A9 01                lda #1
0019DAr 2  8D rr rr             sta ch_ready
0019DDr 2  18           @ok:    clc
0019DEr 2  60                   rts
0019DFr 2  38           @fail:  sec
0019E0r 2  60                   rts
0019E1r 2               
0019E1r 2               ; ----------------------------------------------------------------------------
0019E1r 2               ; ch_dirlist - LOAD "$" : list the directory named by ch_name ("/*" etc.)
0019E1r 2               ;
0019E1r 2               ; CH376 enumeration: SET_FILE_NAME "/*", FILE_OPEN. For every match the chip
0019E1r 2               ; interrupts with USB_INT_DISK_READ and the 32-byte FAT directory entry can
0019E1r 2               ; be read with RD_USB_DATA0.  FILE_ENUM_GO fetches the next one; ERR_MISS_FILE
0019E1r 2               ; ($42) means there are no more.
0019E1r 2               ;
0019E1r 2               ; Entry layout: 0-7 name, 8-10 extension (space padded), 11 attributes,
0019E1r 2               ;               28-31 file size (little endian)
0019E1r 2               ; ----------------------------------------------------------------------------
0019E1r 2               ch_dirlist:
0019E1r 2  20 rr rr             jsr fs_prepare
0019E4r 2  90 05                bcc @ready
0019E6r 2  A9 F2                lda #CH_E_NODISK
0019E8r 2  4C rr rr             jmp ch_fail
0019EBr 2  A9 00        @ready: lda #0
0019EDr 2  8D rr rr             sta ch_nfiles
0019F0r 2  8D rr rr             sta ch_nfiles+1
0019F3r 2  A9 rr                lda #<ch_name
0019F5r 2  A2 rr                ldx #>ch_name
0019F7r 2  20 rr rr             jsr ch_set_name
0019FAr 2  A9 32                lda #CMD_FILE_OPEN
0019FCr 2  20 rr rr             jsr ch_cmd
0019FFr 2  20 rr rr     @next:  jsr ch_wait_status
001A02r 2  C9 1D                cmp #USB_INT_DISK_READ      ; $1D = an entry is available
001A04r 2  D0 31                bne @end
001A06r 2  A9 27                lda #CMD_RD_USB_DATA0
001A08r 2  20 rr rr             jsr ch_cmd
001A0Br 2  20 rr rr             jsr ch_rd                   ; length (normally 32)
001A0Er 2  8D rr rr             sta ch_cnt
001A11r 2  A0 00                ldy #0
001A13r 2  CC rr rr     @rd:    cpy ch_cnt
001A16r 2  B0 0D                bcs @got
001A18r 2  20 rr rr             jsr ch_rd
001A1Br 2  C0 20                cpy #32
001A1Dr 2  B0 03                bcs @skip                   ; never overflow ch_ent
001A1Fr 2  99 rr rr             sta ch_ent,y
001A22r 2  C8           @skip:  iny
001A23r 2  D0 EE                bne @rd
001A25r 2  AD rr rr     @got:   lda ch_cnt
001A28r 2  C9 20                cmp #32
001A2Ar 2  90 03                bcc @more                   ; short entry: ignore it
001A2Cr 2  20 rr rr             jsr ch_print_entry
001A2Fr 2  A9 33        @more:  lda #CMD_FILE_ENUM_GO
001A31r 2  20 rr rr             jsr ch_cmd
001A34r 2  4C rr rr             jmp @next
001A37r 2  C9 42        @end:   cmp #ERR_MISS_FILE          ; $42 = end of directory
001A39r 2  F0 03                beq @done
001A3Br 2  4C rr rr             jmp ch_fail                 ; anything else is a real error
001A3Er 2  AD rr rr     @done:  lda ch_nfiles
001A41r 2  0D rr rr             ora ch_nfiles+1
001A44r 2  D0 07                bne @ret
001A46r 2  A9 rr                lda #<msg_nofiles
001A48r 2  A0 rr                ldy #>msg_nofiles
001A4Ar 2  20 rr rr             jsr ch_puts                ; print null terminated string (A=lo, Y=hi)
001A4Dr 2  60           @ret:   rts                         ; back to BASIC ("OK")
001A4Er 2               
001A4Er 2               ; ch_print_entry - print one line for the entry in ch_ent, or nothing if it is
001A4Er 2               ; a volume label / hidden / system entry
001A4Er 2               ch_print_entry:
001A4Er 2  AD rr rr             lda ch_ent+11
001A51r 2  29 0E                and #$0E                    ; volume label, hidden, system
001A53r 2  F0 01                beq @show
001A55r 2  60                   rts
001A56r 2  EE rr rr     @show:  inc ch_nfiles
001A59r 2  D0 03                bne @c1
001A5Br 2  EE rr rr             inc ch_nfiles+1
001A5Er 2  A0 00        @c1:    ldy #0
001A60r 2  B9 rr rr     @name:  lda ch_ent,y
001A63r 2  C9 20                cmp #' '
001A65r 2  F0 08                beq @namedone
001A67r 2  20 rr rr             jsr ch_putc
001A6Ar 2  C8                   iny
001A6Br 2  C0 08                cpy #8
001A6Dr 2  90 F1                bcc @name
001A6Fr 2               @namedone:
001A6Fr 2  8C rr rr             sty ch_col                  ; characters printed so far
001A72r 2  AD rr rr             lda ch_ent+8
001A75r 2  C9 20                cmp #' '
001A77r 2  F0 1C                beq @pad                    ; no extension
001A79r 2  A9 2E                lda #'.'
001A7Br 2  20 rr rr             jsr ch_putc
001A7Er 2  EE rr rr             inc ch_col
001A81r 2  A0 08                ldy #8
001A83r 2  B9 rr rr     @ext:   lda ch_ent,y
001A86r 2  C9 20                cmp #' '
001A88r 2  F0 0B                beq @pad
001A8Ar 2  20 rr rr             jsr ch_putc
001A8Dr 2  EE rr rr             inc ch_col
001A90r 2  C8                   iny
001A91r 2  C0 0B                cpy #11
001A93r 2  90 EE                bcc @ext
001A95r 2  A9 20        @pad:   lda #' '                    ; pad the name field to 13 columns
001A97r 2  20 rr rr             jsr ch_putc
001A9Ar 2  EE rr rr             inc ch_col
001A9Dr 2  AD rr rr             lda ch_col
001AA0r 2  C9 0D                cmp #13
001AA2r 2  90 F1                bcc @pad
001AA4r 2  AD rr rr             lda ch_ent+11
001AA7r 2  29 10                and #$10                    ; directory?
001AA9r 2  F0 0A                beq @size
001AABr 2  A9 rr                lda #<msg_dir
001AADr 2  A0 rr                ldy #>msg_dir
001AAFr 2  20 rr rr             jsr ch_puts
001AB2r 2  4C rr rr             jmp @eol
001AB5r 2  A2 03        @size:  ldx #3                      ; size -> ch_num
001AB7r 2  BD rr rr     @cp:    lda ch_ent+28,x
001ABAr 2  9D rr rr             sta ch_num,x
001ABDr 2  CA                   dex
001ABEr 2  10 F7                bpl @cp
001AC0r 2  20 rr rr             jsr ch_print_num
001AC3r 2  4C rr rr     @eol:   jmp ch_crlf                 ; end of line (tail call)
001AC6r 2               
001AC6r 2               ; ch_print_num - print the 32-bit number in ch_num right-aligned in 10 columns
001AC6r 2               ch_print_num:
001AC6r 2  A9 00                lda #0
001AC8r 2  8D rr rr             sta ch_started
001ACBr 2  A0 00                ldy #0                      ; Y = 4 * index into ch_pow10
001ACDr 2  A2 00        @digit: ldx #0                      ; X = this digit
001ACFr 2  38           @sub:   sec
001AD0r 2  AD rr rr             lda ch_num
001AD3r 2  F9 rr rr             sbc ch_pow10,y
001AD6r 2  8D rr rr             sta ch_num
001AD9r 2  AD rr rr             lda ch_num+1
001ADCr 2  F9 rr rr             sbc ch_pow10+1,y
001ADFr 2  8D rr rr             sta ch_num+1
001AE2r 2  AD rr rr             lda ch_num+2
001AE5r 2  F9 rr rr             sbc ch_pow10+2,y
001AE8r 2  8D rr rr             sta ch_num+2
001AEBr 2  AD rr rr             lda ch_num+3
001AEEr 2  F9 rr rr             sbc ch_pow10+3,y
001AF1r 2  8D rr rr             sta ch_num+3
001AF4r 2  90 04                bcc @undo                   ; went negative: digit is complete
001AF6r 2  E8                   inx
001AF7r 2  4C rr rr             jmp @sub
001AFAr 2  18           @undo:  clc                         ; add the power back
001AFBr 2  AD rr rr             lda ch_num
001AFEr 2  79 rr rr             adc ch_pow10,y
001B01r 2  8D rr rr             sta ch_num
001B04r 2  AD rr rr             lda ch_num+1
001B07r 2  79 rr rr             adc ch_pow10+1,y
001B0Ar 2  8D rr rr             sta ch_num+1
001B0Dr 2  AD rr rr             lda ch_num+2
001B10r 2  79 rr rr             adc ch_pow10+2,y
001B13r 2  8D rr rr             sta ch_num+2
001B16r 2  AD rr rr             lda ch_num+3
001B19r 2  79 rr rr             adc ch_pow10+3,y
001B1Cr 2  8D rr rr             sta ch_num+3
001B1Fr 2  AD rr rr             lda ch_started
001B22r 2  D0 0C                bne @pr
001B24r 2  8A                   txa
001B25r 2  D0 09                bne @pr
001B27r 2  C0 24                cpy #36                     ; last digit is always printed
001B29r 2  F0 05                beq @pr
001B2Br 2  A9 20                lda #' '                    ; leading zero -> space
001B2Dr 2  4C rr rr             jmp @out
001B30r 2  A9 01        @pr:    lda #1
001B32r 2  8D rr rr             sta ch_started
001B35r 2  8A                   txa
001B36r 2  18                   clc
001B37r 2  69 30                adc #'0'
001B39r 2  20 rr rr     @out:   jsr ch_putc
001B3Cr 2  98                   tya
001B3Dr 2  18                   clc
001B3Er 2  69 04                adc #4
001B40r 2  A8                   tay
001B41r 2  C0 28                cpy #40
001B43r 2  F0 03                beq @fin
001B45r 2  4C rr rr             jmp @digit
001B48r 2  60           @fin:   rts
001B49r 2               
001B49r 2               ch_pow10:
001B49r 2  00 CA 9A 3B          .dword 1000000000, 100000000, 10000000, 1000000, 100000
001B4Dr 2  00 E1 F5 05  
001B51r 2  80 96 98 00  
001B5Dr 2  10 27 00 00          .dword 10000, 1000, 100, 10, 1
001B61r 2  E8 03 00 00  
001B65r 2  64 00 00 00  
001B71r 2               
001B71r 2               ; ch_putc - ch_prna (print char in A) that preserves X and Y
001B71r 2               ch_putc:
001B71r 2  8E rr rr             stx ch_sx
001B74r 2  8C rr rr             sty ch_sy
001B77r 2  20 rr rr             jsr ch_prna
001B7Ar 2  AE rr rr             ldx ch_sx
001B7Dr 2  AC rr rr             ldy ch_sy
001B80r 2  60                   rts
001B81r 2               
001B81r 2  20 20 20 20  msg_dir:     .byte "     <DIR>",0
001B85r 2  20 3C 44 49  
001B89r 2  52 3E 00     
001B8Cr 2  4E 4F 20 46  msg_nofiles: .byte "NO FILES",13,10,0
001B90r 2  49 4C 45 53  
001B94r 2  0D 0A 00     
001B97r 2               
001B97r 2               ; ----------------------------------------------------------------------------
001B97r 2               ; Error exits.  A = CH376 status or one of the CH_E_ codes.
001B97r 2               ; Prints a message, resets the stack and returns to the BASIC prompt.
001B97r 2               ; ----------------------------------------------------------------------------
001B97r 2               ch_fail_close:                      ; same, but close the open file first
001B97r 2  48                   pha
001B98r 2  A9 00                lda #0
001B9Ar 2  20 rr rr             jsr fs_close
001B9Dr 2  68                   pla
001B9Er 2               ch_fail:
001B9Er 2  2C rr rr             bit dir_cap                 ; SBC_DIR listing: back to its caller
001BA1r 2  10 03                bpl :+
001BA3r 2  4C rr rr             jmp dir_fail
001BA6r 2  C9 42        :       cmp #ERR_MISS_FILE
001BA8r 2  F0 64                beq @nofile
001BAAr 2  C9 B1                cmp #ERR_DISK_FULL
001BACr 2  F0 67                beq @full
001BAEr 2  C9 F0                cmp #CH_E_TOOBIG
001BB0r 2  F0 6A                beq @toobig
001BB2r 2  C9 F1                cmp #CH_E_BADFILE
001BB4r 2  F0 6D                beq @badfile
001BB6r 2  C9 F2                cmp #CH_E_NODISK
001BB8r 2  F0 70                beq @nodisk
001BBAr 2  8D rr rr             sta ch_stat                 ; anything else: remember the code,
001BBDr 2  A9 00                lda #0                      ; re-initialise next time
001BBFr 2  20 rr rr             jsr fs_unready
001BC2r 2  A9 rr                lda #<msg_io
001BC4r 2  A0 rr                ldy #>msg_io
001BC6r 2  20 rr rr             jsr ch_puts                ; "?DISK ERROR"
001BC9r 2  A9 20                lda #' '                    ; then the CH376 status code in hex, e.g.
001BCBr 2  20 rr rr             jsr ch_prna                ; ?DISK ERROR $FF  ($FF = chip never answered)
001BCEr 2  A9 24                lda #'$'
001BD0r 2  20 rr rr             jsr ch_prna
001BD3r 2  AD rr rr             lda ch_stat
001BD6r 2  4A                   lsr
001BD7r 2  4A                   lsr
001BD8r 2  4A                   lsr
001BD9r 2  4A                   lsr
001BDAr 2  20 rr rr             jsr ch_hexdig
001BDDr 2  AD rr rr             lda ch_stat
001BE0r 2  29 0F                and #$0F
001BE2r 2  20 rr rr             jsr ch_hexdig
001BE5r 2  AD rr rr             lda ch_stat
001BE8r 2  C9 FF                cmp #$FF
001BEAr 2  D0 1F                bne @nodiag
001BECr 2  A9 rr                lda #<msg_diag1
001BEEr 2  A0 rr                ldy #>msg_diag1
001BF0r 2  20 rr rr             jsr ch_puts
001BF3r 2  AD rr rr             lda ch_lastcmd
001BF6r 2  20 rr rr             jsr ch_hex2
001BF9r 2  A9 rr                lda #<msg_diag2
001BFBr 2  A0 rr                ldy #>msg_diag2
001BFDr 2  20 rr rr             jsr ch_puts
001C00r 2  AD rr rr             lda ch_laststs
001C03r 2  20 rr rr             jsr ch_hex2
001C06r 2  A9 29                lda #')'
001C08r 2  20 rr rr             jsr ch_prna
001C0Br 2               @nodiag:
001C0Br 2  4C rr rr             jmp @after
001C0Er 2  A9 rr        @nofile:  lda #<msg_nofile
001C10r 2  A0 rr                  ldy #>msg_nofile
001C12r 2  4C rr rr               jmp @print
001C15r 2  A9 rr        @full:    lda #<msg_full
001C17r 2  A0 rr                  ldy #>msg_full
001C19r 2  4C rr rr               jmp @print
001C1Cr 2  A9 rr        @toobig:  lda #<msg_toobig
001C1Er 2  A0 rr                  ldy #>msg_toobig
001C20r 2  4C rr rr               jmp @print
001C23r 2  A9 rr        @badfile: lda #<msg_badfile
001C25r 2  A0 rr                  ldy #>msg_badfile
001C27r 2  4C rr rr               jmp @print
001C2Ar 2  A9 rr        @nodisk:  lda #<msg_nodisk
001C2Cr 2  A0 rr                  ldy #>msg_nodisk
001C2Er 2  20 rr rr     @print: jsr ch_puts                ; print string at (Y,A)
001C31r 2  AD rr rr     @after: lda ch_mon                  ; called from the monitor?
001C34r 2  F0 0B                beq @basic
001C36r 2  20 rr rr             jsr ch_crlf                 ; (still in monitor mode: plain CR/LF)
001C39r 2  A9 00                lda #0
001C3Br 2  8D rr rr             sta ch_mon
001C3Er 2  4C rr rr             jmp WOZ_ENTRY               ; yes: back to the monitor prompt
001C41r 2  20 rr rr     @basic: jsr LAB_1491                ; flush stack, clear continue flag
001C44r 2  4C rr rr             jmp LAB_1274                ; BASIC warm start: "Ready" prompt
001C47r 2               
001C47r 2               ; ---- output wrappers: BASIC's print routines when called from BASIC, plain
001C47r 2               ;      CHROUT when called from the monitor (BASIC may never have been started)
001C47r 2               ch_puts:                            ; print zero terminated string, A=lo Y=hi
001C47r 2  AE rr rr             ldx ch_mon
001C4Ar 2  D0 03                bne @mon
001C4Cr 2  4C rr rr             jmp LAB_18C3
001C4Fr 2  85 rr        @mon:   sta strptr
001C51r 2  84 rr                sty strptr+1
001C53r 2  A0 00                ldy #0
001C55r 2  B1 rr        @l:     lda (strptr),y
001C57r 2  F0 06                beq @d
001C59r 2  20 rr rr             jsr ch_out                  ; (CHROUT, or SBC_DIR reading a listing)
001C5Cr 2  C8                   iny
001C5Dr 2  D0 F6                bne @l
001C5Fr 2  60           @d:     rts
001C60r 2               
001C60r 2               ch_prna:                            ; print character in A
001C60r 2  48                   pha
001C61r 2  AD rr rr             lda ch_mon
001C64r 2  D0 04                bne @mon
001C66r 2  68                   pla
001C67r 2  4C rr rr             jmp LAB_PRNA
001C6Ar 2  68           @mon:   pla
001C6Br 2  4C rr rr             jmp ch_out
001C6Er 2               
001C6Er 2               ch_crlf:
001C6Er 2  AD rr rr             lda ch_mon
001C71r 2  D0 03                bne @mon
001C73r 2  4C rr rr             jmp LAB_CRLF
001C76r 2  A9 0D        @mon:   lda #13
001C78r 2  20 rr rr             jsr ch_out
001C7Br 2  A9 0A                lda #10
001C7Dr 2  4C rr rr             jmp ch_out
001C80r 2               
001C80r 2               ; print the low nibble of A as a hex digit
001C80r 2               ch_hex2:
001C80r 2  48                   pha
001C81r 2  4A                   lsr
001C82r 2  4A                   lsr
001C83r 2  4A                   lsr
001C84r 2  4A                   lsr
001C85r 2  20 rr rr             jsr ch_hexdig
001C88r 2  68                   pla
001C89r 2  29 0F                and #$0F
001C8Br 2               ch_hexdig:
001C8Br 2  C9 0A                cmp #10
001C8Dr 2  90 05                bcc @dig
001C8Fr 2  69 36                adc #'A'-11                 ; carry is set here, so this adds 'A'-10
001C91r 2  4C rr rr             jmp ch_prna
001C94r 2  69 30        @dig:   adc #'0'
001C96r 2  4C rr rr             jmp ch_prna
001C99r 2               
001C99r 2  0D 0A 3F 46  msg_nofile:  .byte 13,10,"?FILE NOT FOUND",0
001C9Dr 2  49 4C 45 20  
001CA1r 2  4E 4F 54 20  
001CABr 2  0D 0A 3F 44  msg_full:    .byte 13,10,"?DISK FULL",0
001CAFr 2  49 53 4B 20  
001CB3r 2  46 55 4C 4C  
001CB8r 2  0D 0A 3F 46  msg_toobig:  .byte 13,10,"?FILE TOO LARGE",0
001CBCr 2  49 4C 45 20  
001CC0r 2  54 4F 4F 20  
001CCAr 2  0D 0A 3F 42  msg_badfile: .byte 13,10,"?BAD FILE",0
001CCEr 2  41 44 20 46  
001CD2r 2  49 4C 45 00  
001CD6r 2  0D 0A 3F 4E  msg_nodisk:  .byte 13,10,"?NO DISK",0
001CDAr 2  4F 20 44 49  
001CDEr 2  53 4B 00     
001CE1r 2  20 28 43 4D  msg_diag1:   .byte " (CMD $",0
001CE5r 2  44 20 24 00  
001CE9r 2  2C 20 50 4F  msg_diag2:   .byte ", PORT $",0
001CEDr 2  52 54 20 24  
001CF1r 2  00           
001CF2r 2  0D 0A 3F 44  msg_io:      .byte 13,10,"?DISK ERROR",0
001CF6r 2  49 53 4B 20  
001CFAr 2  45 52 52 4F  
001D00r 2               
001D00r 2               ; ============================================================================
001D00r 2               ; LOADRAW "name" [, start]     SAVERAW "name", start, end
001D00r 2               ;
001D00r 2               ;   Raw memory block files (".DAT" is added when the name has no extension).
001D00r 2               ;   SAVERAW writes the bytes start .. end-1.   (end is NOT included)
001D00r 2               ;   LOADRAW reads the whole file to "start".  Without a start address the file
001D00r 2               ;   goes to the first byte above BASIC's memory (Ememl), i.e. into the area you
001D00r 2               ;   reserved with the "Memory size?" question at cold start.
001D00r 2               ;   LOADRAW only accepts targets from Ememl up to Ram_top-1, so it can never
001D00r 2               ;   overwrite the program, variables, strings or system RAM.  Anything else
001D00r 2               ;   (or a file that does not fit) is a ?FUNCTION CALL ERROR / ?FILE TOO BIG.
001D00r 2               ; ============================================================================
001D00r 2               
001D00r 2               ; ch_getaddr - evaluate a numeric expression as an address 0..65535
001D00r 2               ;   out: Itempl/Itemph = value.  ?Function call error if negative or > 65535
001D00r 2               ch_getaddr:
001D00r 2  20 rr rr             jsr LAB_EVNM                ; evaluate, must be numeric
001D03r 2  A5 B0                lda FAC1_s
001D05r 2  30 09                bmi ch_fc
001D07r 2  A5 AC                lda FAC1_e
001D09r 2  C9 91                cmp #$91                    ; >= 65536 ?
001D0Br 2  B0 03                bcs ch_fc
001D0Dr 2  4C rr rr             jmp LAB_F2FX                ; to Itempl/Itemph
001D10r 2               
001D10r 2  A2 08        ch_fc:  ldx #EH_ERR_FC
001D12r 2  4C rr rr             jmp LAB_XERR
001D15r 2               
001D15r 2               ; ch_rawname - filename for the RAW commands (no directory listing)
001D15r 2               ch_rawname:                         ; A = 1 (.DAT) or 2 (.ARR)
001D15r 2  8D rr rr             sta ch_raw
001D18r 2  20 rr rr             jsr ch_get_filename
001D1Br 2  AD rr rr             lda ch_dir
001D1Er 2  D0 F0                bne ch_fc
001D20r 2  60                   rts
001D21r 2               
001D21r 2               BI_SAVERAW:
001D21r 2  A9 01                lda #1
001D23r 2  20 rr rr             jsr ch_rawname
001D26r 2  20 rr rr             jsr LAB_1C01                ; ","
001D29r 2  20 rr rr             jsr ch_getaddr
001D2Cr 2  A5 11                lda Itempl
001D2Er 2  8D rr rr             sta ch_a0
001D31r 2  A5 12                lda Itemph
001D33r 2  8D rr rr             sta ch_a0+1
001D36r 2  20 rr rr             jsr LAB_1C01                ; ","
001D39r 2  20 rr rr             jsr ch_getaddr
001D3Cr 2  38                   sec                         ; ch_len = end - start
001D3Dr 2  A5 11                lda Itempl
001D3Fr 2  ED rr rr             sbc ch_a0
001D42r 2  8D rr rr             sta ch_len
001D45r 2  A5 12                lda Itemph
001D47r 2  ED rr rr             sbc ch_a0+1
001D4Ar 2  8D rr rr             sta ch_len+1
001D4Dr 2  90 C1                bcc ch_fc                   ; end < start
001D4Fr 2  0D rr rr             ora ch_len
001D52r 2  F0 BC                beq ch_fc                   ; empty block
001D54r 2  20 rr rr             jsr fs_prepare
001D57r 2  90 05                bcc @ready
001D59r 2  A9 F2                lda #CH_E_NODISK
001D5Br 2  4C rr rr             jmp ch_fail
001D5Er 2  A9 rr        @ready: lda #<ch_name
001D60r 2  A2 rr                ldx #>ch_name
001D62r 2  20 rr rr             jsr fs_create
001D65r 2  C9 14 F0 03          CH_OK ch_fail
001D69r 2  4C rr rr     
001D6Cr 2  AD rr rr             lda ch_a0
001D6Fr 2  8D rr rr             sta ch_ptr
001D72r 2  AD rr rr             lda ch_a0+1
001D75r 2  8D rr rr             sta ch_ptr+1
001D78r 2  20 rr rr             jsr fs_write
001D7Br 2  C9 14 F0 03          CH_OK ch_fail_close
001D7Fr 2  4C rr rr     
001D82r 2  A9 01                lda #1                      ; close AND update the file length
001D84r 2  20 rr rr             jsr fs_close
001D87r 2  C9 14 F0 03          CH_OK ch_fail
001D8Br 2  4C rr rr     
001D8Er 2  60                   rts
001D8Fr 2               
001D8Fr 2               BI_LOADRAW:
001D8Fr 2  A9 01                lda #1
001D91r 2  20 rr rr             jsr ch_rawname
001D94r 2  20 C2 00             jsr LAB_GBYT                ; optional ", start"
001D97r 2  D0 0D                bne @addr
001D99r 2  A5 85                lda Ememl                   ; default: first byte above BASIC memory
001D9Br 2  8D rr rr             sta ch_a0
001D9Er 2  A5 86                lda Ememh
001DA0r 2  8D rr rr             sta ch_a0+1
001DA3r 2  4C rr rr             jmp @check
001DA6r 2  20 rr rr     @addr:  jsr LAB_1C01
001DA9r 2  20 rr rr             jsr ch_getaddr
001DACr 2  A5 11                lda Itempl
001DAEr 2  8D rr rr             sta ch_a0
001DB1r 2  A5 12                lda Itemph
001DB3r 2  8D rr rr             sta ch_a0+1
001DB6r 2  AD rr rr     @check: lda ch_a0+1                 ; start >= Ememl ?
001DB9r 2  C5 86                cmp Ememh
001DBBr 2  90 73                bcc lr_fc
001DBDr 2  D0 07                bne @hiok
001DBFr 2  AD rr rr             lda ch_a0
001DC2r 2  C5 85                cmp Ememl
001DC4r 2  90 6A                bcc lr_fc
001DC6r 2  AD rr rr     @hiok:  lda ch_a0+1                 ; start < Ram_top ?
001DC9r 2  C9 7F                cmp #>Ram_top
001DCBr 2  B0 63                bcs lr_fc
001DCDr 2  38                   sec                         ; room = Ram_top - start
001DCEr 2  A9 00                lda #<Ram_top
001DD0r 2  ED rr rr             sbc ch_a0
001DD3r 2  8D rr rr             sta ch_len
001DD6r 2  A9 7F                lda #>Ram_top
001DD8r 2  ED rr rr             sbc ch_a0+1
001DDBr 2  8D rr rr             sta ch_len+1
001DDEr 2  20 rr rr             jsr fs_prepare
001DE1r 2  90 05                bcc @ready
001DE3r 2  A9 F2                lda #CH_E_NODISK
001DE5r 2  4C rr rr             jmp ch_fail
001DE8r 2  A9 rr        @ready: lda #<ch_name
001DEAr 2  A2 rr                ldx #>ch_name
001DECr 2  20 rr rr             jsr fs_open
001DEFr 2  C9 14 F0 03          CH_OK ch_fail
001DF3r 2  4C rr rr     
001DF6r 2  AD rr rr             lda ch_a0
001DF9r 2  8D rr rr             sta ch_ptr
001DFCr 2  AD rr rr             lda ch_a0+1
001DFFr 2  8D rr rr             sta ch_ptr+1
001E02r 2  20 rr rr             jsr fs_read
001E05r 2  C9 14 F0 03          CH_OK ch_fail_close
001E09r 2  4C rr rr     
001E0Cr 2  AD rr rr             lda ch_got+1                ; got >= room?  -> file did not fit
001E0Fr 2  CD rr rr             cmp ch_len+1
001E12r 2  90 0F                bcc @fits
001E14r 2  D0 08                bne @toobig
001E16r 2  AD rr rr             lda ch_got
001E19r 2  CD rr rr             cmp ch_len
001E1Cr 2  90 05                bcc @fits
001E1Er 2               @toobig:
001E1Er 2  A9 F0                lda #CH_E_TOOBIG
001E20r 2  4C rr rr             jmp ch_fail_close
001E23r 2  A9 00        @fits:  lda #0
001E25r 2  20 rr rr             jsr fs_close
001E28r 2  C9 14 F0 03          CH_OK ch_fail
001E2Cr 2  4C rr rr     
001E2Fr 2  60                   rts
001E30r 2  4C rr rr     lr_fc:    jmp ch_fc
001E33r 2               
001E33r 2               ; (SAVEARR / LOADARR were removed for the CPU Rev2 ROM: their tokens are
001E33r 2               ; now SAY and VOICE ... see basic.s)
001E33r 2               
001E33r 1               .include "drv_spi.s"            ; 65SPI
001E33r 2               ; ============================================================================
001E33r 2               ; drv_spi.s - Daryl Rictor's 65SPI on the ISA6502_Advanced_IO card ($7F28-$7F2B)
001E33r 2               ;
001E33r 2               ;   $7F28  read: data in              write: data out (starts a shift)
001E33r 2               ;   $7F29  read: status               write: control
001E33r 2               ;          status  b7 TC  b6 BSY  b5 IER  b4 FRX  b3 TMO  b2 ECE  b1 CPOL  b0 CPHA
001E33r 2               ;          control b7 SR (software reset), b5-b0 as above
001E33r 2               ;   $7F2A  slave select register (SS0-SS7 outputs, active low; $FF = none)
001E33r 2               ;
001E33r 2               ; SCLK = PHI2 / 2 (the CPU clock), MSB first.  The driver uses the polled TC
001E33r 2               ; flag: a byte takes 16 CPU cycles, far less than an interrupt would cost, so
001E33r 2               ; the card's IRQ7 jumper can stay off.
001E33r 2               ; ============================================================================
001E33r 2               
001E33r 2               SPI_DATA        = $7F28
001E33r 2               SPI_STAT        = $7F29
001E33r 2               SPI_CTRL        = $7F29
001E33r 2               SPI_SS          = $7F2A
001E33r 2               
001E33r 2               SPI_MODE0       = $00                   ; CPOL 0, CPHA 0, PHI2 clock, no IRQ
001E33r 2               
001E33r 2               .segment "DRVVARS"
0001B3r 2  xx           spi_ok:         .res 1                  ; $80 = the 65SPI answered
0001B4r 2               
0001B4r 2               .segment "BIOS"
001E33r 2               
001E33r 2               ; ----------------------------------------------------------------------------
001E33r 2               ; spi_init - reset the 65SPI, mode 0, nothing selected.  C=0 if it answered:
001E33r 2               ; the mode bits written to the control register read back in the status.
001E33r 2               ; Clobbers A.
001E33r 2               ; ----------------------------------------------------------------------------
001E33r 2               spi_init:
001E33r 2  A9 00                lda     #0
001E35r 2  8D rr rr             sta     spi_ok
001E38r 2  A9 80                lda     #$80                    ; software reset
001E3Ar 2  8D 29 7F             sta     SPI_CTRL
001E3Dr 2  A9 FF                lda     #$FF                    ; no slave selected
001E3Fr 2  8D 2A 7F             sta     SPI_SS
001E42r 2  A9 03                lda     #$03                    ; mode 3: CPOL / CPHA should read back
001E44r 2  8D 29 7F             sta     SPI_CTRL
001E47r 2  AD 29 7F             lda     SPI_STAT
001E4Ar 2  29 3F                and     #$3F
001E4Cr 2  C9 03                cmp     #$03
001E4Er 2  D0 18                bne     @no
001E50r 2  A9 00                lda     #SPI_MODE0
001E52r 2  8D 29 7F             sta     SPI_CTRL
001E55r 2  AD 29 7F             lda     SPI_STAT
001E58r 2  29 3F                and     #$3F
001E5Ar 2  C9 00                cmp     #SPI_MODE0
001E5Cr 2  D0 0A                bne     @no
001E5Er 2  AD 28 7F             lda     SPI_DATA                ; clear TC
001E61r 2  A9 80                lda     #$80
001E63r 2  8D rr rr             sta     spi_ok
001E66r 2  18                   clc
001E67r 2  60                   rts
001E68r 2  38           @no:    sec
001E69r 2  60                   rts
001E6Ar 2               
001E6Ar 2               ; ----------------------------------------------------------------------------
001E6Ar 2               ; spi_xfer - send A, return the byte received in A.  Preserves X and Y.
001E6Ar 2               ; ----------------------------------------------------------------------------
001E6Ar 2               spi_xfer:
001E6Ar 2  8D 28 7F             sta     SPI_DATA                ; starts the shift
001E6Dr 2  2C 29 7F     @w:     bit     SPI_STAT                ; TC (bit 7) -> N
001E70r 2  10 FB                bpl     @w
001E72r 2  AD 28 7F             lda     SPI_DATA                ; the byte in (also clears TC)
001E75r 2  60                   rts
001E76r 2               
001E76r 2               ; ----------------------------------------------------------------------------
001E76r 2               ; spi_select - A = slave select register value (e.g. $FE = SS0), $FF = none
001E76r 2               ; ----------------------------------------------------------------------------
001E76r 2               spi_select:
001E76r 2  8D 2A 7F             sta     SPI_SS
001E79r 2  60                   rts
001E7Ar 2               
001E7Ar 1               .if HAS_IDE
001E7Ar 1               .include "drv_ide.s"            ; SPI-IDE / CF card (FAT16, DS1302 clock)
001E7Ar 2               ; ============================================================================
001E7Ar 2               ; drv_ide.s - Daryl Rictor's SPI to IDE/CF interface (FAT16), on 65SPI SS0
001E7Ar 2               ;
001E7Ar 2               ; Protocol (SPI mode 0, MSB first).  Every transaction is two shifts, SS0 held
001E7Ar 2               ; low across both, with at least 1.75 us (20 MHz AVR; 2.2 us with your 16 MHz
001E7Ar 2               ; ATmega32) between them:
001E7Ar 2               ;       Send Data   $01, byte          (host -> interface)
001E7Ar 2               ;       Get Status  $02, $00 -> status
001E7Ar 2               ;       Get Data    $03, $00 -> byte   (interface -> host)
001E7Ar 2               ; Status: b7 = ready for a command, b6 = data ready for the host, b5 = 0 when
001E7Ar 2               ; it can take data from the host, b4-b0 = the error code of the last command.
001E7Ar 2               ;
001E7Ar 2               ; This file makes the interface look like the CH376 to the LOAD / SAVE code
001E7Ar 2               ; and the monitor (fs.s picks one or the other):
001E7Ar 2               ;   ide_prepare    mount drive 0                      C=1 = no drive
001E7Ar 2               ;   ide_open       A/X = path; $14 file opened, $41 it was a directory (and
001E7Ar 2               ;                  it is now the current one), $42 not found, other = error
001E7Ar 2               ;   ide_create     A/X = path; create / replace it for writing
001E7Ar 2               ;   ide_read       ch_len bytes to (ch_ptr): ch_got = what there was, ch_ptr
001E7Ar 2               ;                  advanced (the interface itself pads with 0 past the end)
001E7Ar 2               ;   ide_write      ch_len bytes from (ch_ptr)
001E7Ar 2               ;   ide_close      close the file
001E7Ar 2               ;   ide_dirlist    list the directory named by ch_name ("/*", "*", "/A/*")
001E7Ar 2               ;   ide_time       A/Y -> 18 bytes: "mm/dd/yy hh:mm:ss",0  (DS1302)
001E7Ar 2               ;   ide_settime    A/Y -> 14 characters "dwyymmddHHMMSS"
001E7Ar 2               ; Paths: "/" at the start = from the root; the directories are entered one
001E7Ar 2               ; level at a time (the interface's own rule).  The interface's errors are
001E7Ar 2               ; turned into the CH376's codes where there is one ($42 not found, $B1 full),
001E7Ar 2               ; otherwise $E0 + its code.  $FF = it never answered (timeout).
001E7Ar 2               ; ============================================================================
001E7Ar 2               
001E7Ar 2               IDE_SS          = $FE                   ; SS0 low
001E7Ar 2               IDE_HANDLE      = $00                   ; the one file handle used
001E7Ar 2               
001E7Ar 2               IDE_C_CD        = $C3
001E7Ar 2               IDE_C_DIR       = $C1
001E7Ar 2               IDE_C_OPEN      = $C9
001E7Ar 2               IDE_C_READ      = $CA
001E7Ar 2               IDE_C_WRITE     = $CB
001E7Ar 2               IDE_C_CLOSE     = $CE
001E7Ar 2               IDE_C_CLOSEALL  = $C0
001E7Ar 2               IDE_C_SIZE      = $D0
001E7Ar 2               IDE_C_GETTIME   = $E0
001E7Ar 2               IDE_C_SETTIME   = $E1
001E7Ar 2               IDE_C_MOUNT     = $F4
001E7Ar 2               ; "erase file/directory" (the interface's command list, from the user):
001E7Ar 2               ; sent like CD, the command then the 0-ended name, in the folder entered.
001E7Ar 2               ; (0 here would make SBC_DELETE on C: answer $FD.)
001E7Ar 2               .ifndef IDE_C_DELETE
001E7Ar 2               IDE_C_DELETE    = $C4
001E7Ar 2               .endif
001E7Ar 2               
001E7Ar 2               ; 5-cycle loops for the gap between the two shifts: 2.2 us at CPU_KHZ
001E7Ar 2               IDE_GAP         = CPU_KHZ * 22 / 50000 + 1
001E7Ar 2               
001E7Ar 2               .if CPU_KHZ > 8000
001E7Ar 2                 .error "drv_ide.s: the 65SPI clocks at CPU/2 and the IDE interface (16 MHz AVR) takes at most 4 MHz"
001E7Ar 2               .endif
001E7Ar 2               
001E7Ar 2               .segment "DRVVARS"
0001B4r 2  xx           ide_ready:      .res 1                  ; 1 = drive mounted
0001B5r 2  xx           ide_st:         .res 1                  ; last status
0001B6r 2  xx           ide_m:          .res 1                  ; ide_wait: mask / value
0001B7r 2  xx           ide_v:          .res 1
0001B8r 2  xx xx xx     ide_to:         .res 3                  ; timeout counter
0001BBr 2  xx xx        ide_n:          .res 2                  ; byte counter
0001BDr 2  xx xx xx xx  ide_size:       .res 4                  ; open file: size
0001C1r 2  xx xx xx xx  ide_pos:        .res 4                  ;            position
0001C5r 2  xx xx xx xx  ide_comp:       .res 14                 ; one part of a path
0001C9r 2  xx xx xx xx  
0001CDr 2  xx xx xx xx  
0001D3r 2  xx           ide_t:          .res 1
0001D4r 2               
0001D4r 2               .segment "BIOS"
001E7Ar 2               
001E7Ar 2               ; ============================================================================
001E7Ar 2               ; Transactions
001E7Ar 2               ; ============================================================================
001E7Ar 2               
001E7Ar 2               ; ide_tx - one transaction: A = type ($01 / $02 / $03), X = byte to send.
001E7Ar 2               ; Returns the byte from the second shift in A.  Clobbers Y.
001E7Ar 2               ide_tx:
001E7Ar 2  48                   pha
001E7Br 2  A9 FE                lda     #IDE_SS
001E7Dr 2  8D 2A 7F             sta     SPI_SS
001E80r 2  68                   pla
001E81r 2  20 rr rr             jsr     spi_xfer
001E84r 2  A0 02                ldy     #IDE_GAP
001E86r 2  88           @g:     dey
001E87r 2  D0 FD                bne     @g
001E89r 2  8A                   txa
001E8Ar 2  20 rr rr             jsr     spi_xfer
001E8Dr 2  A0 FF                ldy     #$FF
001E8Fr 2  8C 2A 7F             sty     SPI_SS
001E92r 2  60                   rts
001E93r 2               
001E93r 2               ; ide_status - A = the status byte.  Clobbers X, Y.
001E93r 2               ide_status:
001E93r 2  A9 02                lda     #$02
001E95r 2  A2 00                ldx     #$00
001E97r 2  20 rr rr             jsr     ide_tx
001E9Ar 2  8D rr rr             sta     ide_st
001E9Dr 2  60                   rts
001E9Er 2               
001E9Er 2               ; ide_wait - wait until (status AND ide_m) = ide_v, about 3 s at most (one
001E9Er 2               ; status poll is roughly 130 CPU cycles; IDE_POLLS x 256 polls).
001E9Er 2               ; C=0: A = the status;  C=1: timed out (A = $FF).  Clobbers X, Y.
001E9Er 2               IDE_POLLS       = 90 * CPU_MHZ
001E9Er 2               ide_wait:
001E9Er 2  A9 00                lda     #0
001EA0r 2  8D rr rr             sta     ide_to
001EA3r 2  A9 68                lda     #<IDE_POLLS
001EA5r 2  8D rr rr             sta     ide_to+1
001EA8r 2  A9 01                lda     #>IDE_POLLS
001EAAr 2  8D rr rr             sta     ide_to+2
001EADr 2  20 rr rr     @l:     jsr     ide_status
001EB0r 2  2D rr rr             and     ide_m
001EB3r 2  CD rr rr             cmp     ide_v
001EB6r 2  F0 1B                beq     @ok
001EB8r 2  AD rr rr             lda     ide_to
001EBBr 2  D0 10                bne     @d0
001EBDr 2  AD rr rr             lda     ide_to+1
001EC0r 2  D0 08                bne     @d1
001EC2r 2  AD rr rr             lda     ide_to+2
001EC5r 2  F0 11                beq     @out
001EC7r 2  CE rr rr             dec     ide_to+2
001ECAr 2  CE rr rr     @d1:    dec     ide_to+1
001ECDr 2  CE rr rr     @d0:    dec     ide_to
001ED0r 2  4C rr rr             jmp     @l
001ED3r 2  AD rr rr     @ok:    lda     ide_st
001ED6r 2  18                   clc
001ED7r 2  60                   rts
001ED8r 2  AD rr rr     @out:   lda     ide_st                  ; for ?DISK ERROR $FF (CMD $xx, PORT $yy)
001EDBr 2  8D rr rr             sta     ch_laststs
001EDEr 2  A9 FF                lda     #$FF
001EE0r 2  38                   sec
001EE1r 2  60                   rts
001EE2r 2               
001EE2r 2               ; ide_cmd - start command A (waits until the interface is ready for one)
001EE2r 2               ; C=1 timeout.  Clobbers A, X, Y.
001EE2r 2               ide_cmd:
001EE2r 2  8D rr rr             sta     ch_lastcmd
001EE5r 2  A9 80                lda     #$80
001EE7r 2  8D rr rr             sta     ide_m
001EEAr 2  8D rr rr             sta     ide_v
001EEDr 2  20 rr rr             jsr     ide_wait
001EF0r 2  B0 06                bcs     @x
001EF2r 2  AD rr rr             lda     ch_lastcmd
001EF5r 2  4C rr rr             jmp     ide_put
001EF8r 2  60           @x:     rts
001EF9r 2               
001EF9r 2               ; ide_put - send byte A to the interface (waits until it can take it).
001EF9r 2               ; C=1 timeout.  Clobbers X, Y; preserves A.
001EF9r 2               ide_put:
001EF9r 2  48                   pha
001EFAr 2  A9 20                lda     #$20
001EFCr 2  8D rr rr             sta     ide_m
001EFFr 2  A9 00                lda     #$00
001F01r 2  8D rr rr             sta     ide_v
001F04r 2  20 rr rr             jsr     ide_wait
001F07r 2  B0 0B                bcs     @to
001F09r 2  68                   pla
001F0Ar 2  48                   pha
001F0Br 2  AA                   tax
001F0Cr 2  A9 01                lda     #$01
001F0Er 2  20 rr rr             jsr     ide_tx
001F11r 2  68                   pla
001F12r 2  18                   clc
001F13r 2  60                   rts
001F14r 2  68           @to:    pla
001F15r 2  38                   sec
001F16r 2  60                   rts
001F17r 2               
001F17r 2               ; ide_get - A = the next byte from the interface.  C=1 timeout.
001F17r 2               ; Clobbers X, Y.
001F17r 2               ide_get:
001F17r 2  A9 40                lda     #$40
001F19r 2  8D rr rr             sta     ide_m
001F1Cr 2  8D rr rr             sta     ide_v
001F1Fr 2  20 rr rr             jsr     ide_wait
001F22r 2  B0 08                bcs     @x
001F24r 2  A9 03                lda     #$03
001F26r 2  A2 00                ldx     #$00
001F28r 2  20 rr rr             jsr     ide_tx
001F2Br 2  18                   clc
001F2Cr 2  60           @x:     rts
001F2Dr 2               
001F2Dr 2               ; ide_end - wait for the command to finish; A = its result as a CH376 code
001F2Dr 2               ; ($14 = fine).  Clobbers X, Y.
001F2Dr 2               ide_end:
001F2Dr 2  A9 80                lda     #$80
001F2Fr 2  8D rr rr             sta     ide_m
001F32r 2  8D rr rr             sta     ide_v
001F35r 2  20 rr rr             jsr     ide_wait
001F38r 2  B0 1F                bcs     @x                      ; (A = $FF)
001F3Ar 2  29 1F                and     #$1F                    ; interface error -> CH376-style code
001F3Cr 2  F0 13                beq     @ok
001F3Er 2  C9 04                cmp     #$04
001F40r 2  F0 12                beq     @nf
001F42r 2  C9 0F                cmp     #$0F                    ; read past the end: not an error here
001F44r 2  F0 0B                beq     @ok
001F46r 2  C9 0B                cmp     #$0B
001F48r 2  F0 0D                beq     @full
001F4Ar 2  C9 0C                cmp     #$0C
001F4Cr 2  F0 09                beq     @full
001F4Er 2  09 E0                ora     #$E0
001F50r 2  60                   rts
001F51r 2  A9 14        @ok:    lda     #USB_INT_SUCCESS
001F53r 2  60                   rts
001F54r 2  A9 42        @nf:    lda     #ERR_MISS_FILE
001F56r 2  60                   rts
001F57r 2  A9 B1        @full:  lda     #ERR_DISK_FULL
001F59r 2  60           @x:     rts
001F5Ar 2               
001F5Ar 2               ; ide_putz - send the zero-ended string at (zp_ptr), the 0 too.  C=1 timeout.
001F5Ar 2               ide_putz:
001F5Ar 2  A0 00                ldy     #0
001F5Cr 2  B1 rr        @l:     lda     (zp_ptr),y
001F5Er 2  8C rr rr             sty     ide_t
001F61r 2  20 rr rr             jsr     ide_put
001F64r 2  B0 0A                bcs     @x
001F66r 2  AC rr rr             ldy     ide_t
001F69r 2  B1 rr                lda     (zp_ptr),y
001F6Br 2  F0 03                beq     @x                      ; (carry clear)
001F6Dr 2  C8                   iny
001F6Er 2  D0 EC                bne     @l
001F70r 2  60           @x:     rts
001F71r 2               
001F71r 2               ; ide_named - command A with the name in ide_comp; A = the result
001F71r 2               ide_named:
001F71r 2  20 rr rr             jsr     ide_cmd
001F74r 2  B0 10                bcs     @to
001F76r 2  A9 rr                lda     #<ide_comp
001F78r 2  85 rr                sta     zp_ptr
001F7Ar 2  A9 rr                lda     #>ide_comp
001F7Cr 2  85 rr                sta     zp_ptr+1
001F7Er 2  20 rr rr             jsr     ide_putz
001F81r 2  B0 03                bcs     @to
001F83r 2  4C rr rr             jmp     ide_end
001F86r 2  A9 FF        @to:    lda     #$FF
001F88r 2  60                   rts
001F89r 2               
001F89r 2               ; ============================================================================
001F89r 2               ; Paths
001F89r 2               ; ============================================================================
001F89r 2               
001F89r 2               ; ide_walk - A/X = a path.  A leading "/" goes to the root; every part
001F89r 2               ; followed by "/" is entered.  The last part is left in ide_comp ("" if the
001F89r 2               ; path ends in "/").  A = $14 if all went well, else the error.
001F89r 2               ide_walk:
001F89r 2  85 rr                sta     strptr                  ; (zero page: free while no message prints)
001F8Br 2  86 rr                stx     strptr+1
001F8Dr 2  A0 00                ldy     #0
001F8Fr 2  B1 rr                lda     (strptr),y
001F91r 2  C9 2F                cmp     #'/'
001F93r 2  D0 15                bne     @part
001F95r 2  A9 2F                lda     #'/'                    ; cd "/"
001F97r 2  8D rr rr             sta     ide_comp
001F9Ar 2  A9 00                lda     #0
001F9Cr 2  8D rr rr             sta     ide_comp+1
001F9Fr 2  A9 C3                lda     #IDE_C_CD
001FA1r 2  20 rr rr             jsr     ide_named
001FA4r 2  C9 14                cmp     #USB_INT_SUCCESS
001FA6r 2  D0 3A                bne     @x
001FA8r 2  A0 01                ldy     #1
001FAAr 2  A2 00        @part:  ldx     #0                      ; one part into ide_comp
001FACr 2  B1 rr        @c:     lda     (strptr),y
001FAEr 2  F0 2B                beq     @last
001FB0r 2  C9 2F                cmp     #'/'
001FB2r 2  F0 0B                beq     @dir
001FB4r 2  E0 0D                cpx     #13
001FB6r 2  B0 04                bcs     @c2                     ; (too long: cut off)
001FB8r 2  9D rr rr             sta     ide_comp,x
001FBBr 2  E8                   inx
001FBCr 2  C8           @c2:    iny
001FBDr 2  D0 ED                bne     @c
001FBFr 2  A9 00        @dir:   lda     #0                      ; a directory on the way: enter it
001FC1r 2  9D rr rr             sta     ide_comp,x
001FC4r 2  C8                   iny
001FC5r 2  8C rr rr             sty     ide_t
001FC8r 2  E0 00                cpx     #0
001FCAr 2  F0 09                beq     @skip                   ; ("//")
001FCCr 2  A9 C3                lda     #IDE_C_CD
001FCEr 2  20 rr rr             jsr     ide_named
001FD1r 2  C9 14                cmp     #USB_INT_SUCCESS
001FD3r 2  D0 0D                bne     @x
001FD5r 2  AC rr rr     @skip:  ldy     ide_t
001FD8r 2  4C rr rr             jmp     @part
001FDBr 2  A9 00        @last:  lda     #0
001FDDr 2  9D rr rr             sta     ide_comp,x
001FE0r 2  A9 14                lda     #USB_INT_SUCCESS
001FE2r 2  60           @x:     rts
001FE3r 2               
001FE3r 2               ; ============================================================================
001FE3r 2               ; The CH376-like calls
001FE3r 2               ; ============================================================================
001FE3r 2               
001FE3r 2               ; ide_prepare - mount drive 0 (once).  C=0 ready, C=1 no interface / drive.
001FE3r 2               ide_prepare:
001FE3r 2  AD rr rr             lda     ide_ready
001FE6r 2  D0 1F                bne     @ok
001FE8r 2  2C rr rr             bit     spi_ok
001FEBr 2  10 1C                bpl     @no
001FEDr 2  A9 F4                lda     #IDE_C_MOUNT
001FEFr 2  20 rr rr             jsr     ide_cmd
001FF2r 2  B0 15                bcs     @no
001FF4r 2  A9 00                lda     #0                      ; drive 0
001FF6r 2  20 rr rr             jsr     ide_put
001FF9r 2  B0 0E                bcs     @no
001FFBr 2  20 rr rr             jsr     ide_end
001FFEr 2  C9 14                cmp     #USB_INT_SUCCESS
002000r 2  D0 07                bne     @no
002002r 2  A9 01                lda     #1
002004r 2  8D rr rr             sta     ide_ready
002007r 2  18           @ok:    clc
002008r 2  60                   rts
002009r 2  38           @no:    sec
00200Ar 2  60                   rts
00200Br 2               
00200Br 2               ; ide_open - A/X = path: open the file for reading, or enter the directory
00200Br 2               ide_open:
00200Br 2  20 rr rr             jsr     ide_walk
00200Er 2  C9 14                cmp     #USB_INT_SUCCESS
002010r 2  D0 64                bne     @x
002012r 2  AD rr rr             lda     ide_comp
002015r 2  F0 5A                beq     @dir                    ; "/" or "A/": a directory
002017r 2  A9 C3                lda     #IDE_C_CD               ; a directory?  then we are in it now
002019r 2  20 rr rr             jsr     ide_named
00201Cr 2  C9 14                cmp     #USB_INT_SUCCESS
00201Er 2  F0 51                beq     @dir
002020r 2  C9 FF                cmp     #$FF
002022r 2  F0 52                beq     @x
002024r 2  A9 C9                lda     #IDE_C_OPEN             ; else open the file, read only
002026r 2  20 rr rr             jsr     ide_cmd
002029r 2  B0 49                bcs     @to
00202Br 2  A9 10                lda     #($10 | IDE_HANDLE)
00202Dr 2  20 rr rr             jsr     ide_put
002030r 2  B0 42                bcs     @to
002032r 2  A9 rr                lda     #<ide_comp
002034r 2  85 rr                sta     zp_ptr
002036r 2  A9 rr                lda     #>ide_comp
002038r 2  85 rr                sta     zp_ptr+1
00203Ar 2  20 rr rr             jsr     ide_putz
00203Dr 2  B0 35                bcs     @to
00203Fr 2  20 rr rr             jsr     ide_end
002042r 2  C9 14                cmp     #USB_INT_SUCCESS
002044r 2  D0 30                bne     @x
002046r 2  A9 D0                lda     #IDE_C_SIZE             ; its size, for ide_read
002048r 2  20 rr rr             jsr     ide_cmd
00204Br 2  B0 27                bcs     @to
00204Dr 2  A9 00                lda     #IDE_HANDLE
00204Fr 2  20 rr rr             jsr     ide_put
002052r 2  B0 20                bcs     @to
002054r 2  A2 00                ldx     #0
002056r 2  8E rr rr     @s:     stx     ide_t
002059r 2  20 rr rr             jsr     ide_get
00205Cr 2  B0 16                bcs     @to
00205Er 2  AE rr rr             ldx     ide_t
002061r 2  9D rr rr             sta     ide_size,x
002064r 2  A9 00                lda     #0
002066r 2  9D rr rr             sta     ide_pos,x
002069r 2  E8                   inx
00206Ar 2  E0 04                cpx     #4
00206Cr 2  D0 E8                bne     @s
00206Er 2  4C rr rr             jmp     ide_end
002071r 2  A9 41        @dir:   lda     #ERR_OPEN_DIR
002073r 2  60                   rts
002074r 2  A9 FF        @to:    lda     #$FF
002076r 2  60           @x:     rts
002077r 2               
002077r 2               ; ide_create - A/X = path: create or replace the file, for writing
002077r 2               ide_create:
002077r 2  20 rr rr             jsr     ide_walk
00207Ar 2  C9 14                cmp     #USB_INT_SUCCESS
00207Cr 2  D0 28                bne     @x
00207Er 2  AD rr rr             lda     ide_comp
002081r 2  F0 1E                beq     @dir
002083r 2  A9 C9                lda     #IDE_C_OPEN
002085r 2  20 rr rr             jsr     ide_cmd
002088r 2  B0 1A                bcs     @to
00208Ar 2  A9 20                lda     #($20 | IDE_HANDLE)     ; read/write: replaces a file
00208Cr 2  20 rr rr             jsr     ide_put
00208Fr 2  B0 13                bcs     @to
002091r 2  A9 rr                lda     #<ide_comp
002093r 2  85 rr                sta     zp_ptr
002095r 2  A9 rr                lda     #>ide_comp
002097r 2  85 rr                sta     zp_ptr+1
002099r 2  20 rr rr             jsr     ide_putz
00209Cr 2  B0 06                bcs     @to
00209Er 2  4C rr rr             jmp     ide_end
0020A1r 2  A9 41        @dir:   lda     #ERR_OPEN_DIR
0020A3r 2  60                   rts
0020A4r 2  A9 FF        @to:    lda     #$FF
0020A6r 2  60           @x:     rts
0020A7r 2               
0020A7r 2               ; ide_erase - A/X = path: delete the file
0020A7r 2               ide_erase:
0020A7r 2               .if IDE_C_DELETE
0020A7r 2  20 rr rr             jsr     ide_walk
0020AAr 2  C9 14                cmp     #USB_INT_SUCCESS
0020ACr 2  D0 0C                bne     @x
0020AEr 2  AD rr rr             lda     ide_comp
0020B1r 2  F0 05                beq     @dir
0020B3r 2  A9 C4                lda     #IDE_C_DELETE
0020B5r 2  4C rr rr             jmp     ide_named
0020B8r 2  A9 41        @dir:   lda     #ERR_OPEN_DIR
0020BAr 2  60           @x:     rts
0020BBr 2               .else
0020BBr 2                       lda     #$FD
0020BBr 2                       rts
0020BBr 2               .endif
0020BBr 2               
0020BBr 2               ; ide_close - close the file (A, the CH376's "update the length" flag, is not
0020BBr 2               ; needed)
0020BBr 2               ide_close:
0020BBr 2  A9 CE                lda     #IDE_C_CLOSE
0020BDr 2  20 rr rr             jsr     ide_cmd
0020C0r 2  B0 0A                bcs     @to
0020C2r 2  A9 00                lda     #IDE_HANDLE
0020C4r 2  20 rr rr             jsr     ide_put
0020C7r 2  B0 03                bcs     @to
0020C9r 2  4C rr rr             jmp     ide_end
0020CCr 2  A9 FF        @to:    lda     #$FF
0020CEr 2  60                   rts
0020CFr 2               
0020CFr 2               ; ide_count - send the 4-byte count ide_n (16 bit) after command A + handle
0020CFr 2               ide_count:
0020CFr 2  20 rr rr             jsr     ide_cmd
0020D2r 2  B0 23                bcs     @to
0020D4r 2  A9 00                lda     #IDE_HANDLE
0020D6r 2  20 rr rr             jsr     ide_put
0020D9r 2  B0 1C                bcs     @to
0020DBr 2  AD rr rr             lda     ide_n
0020DEr 2  20 rr rr             jsr     ide_put
0020E1r 2  B0 14                bcs     @to
0020E3r 2  AD rr rr             lda     ide_n+1
0020E6r 2  20 rr rr             jsr     ide_put
0020E9r 2  B0 0C                bcs     @to
0020EBr 2  A9 00                lda     #0
0020EDr 2  20 rr rr             jsr     ide_put
0020F0r 2  B0 05                bcs     @to
0020F2r 2  A9 00                lda     #0
0020F4r 2  20 rr rr             jsr     ide_put
0020F7r 2  60           @to:    rts
0020F8r 2               
0020F8r 2               ; ide_read - read up to ch_len bytes into (ch_ptr); ch_got = how many there
0020F8r 2               ; were (the rest of the file, or ch_len); ch_ptr advanced
0020F8r 2               ide_read:
0020F8r 2  A9 00                lda     #0
0020FAr 2  8D rr rr             sta     ch_got
0020FDr 2  8D rr rr             sta     ch_got+1
002100r 2  38                   sec                             ; what is left: size - pos
002101r 2  AD rr rr             lda     ide_size
002104r 2  ED rr rr             sbc     ide_pos
002107r 2  8D rr rr             sta     ide_n
00210Ar 2  AD rr rr             lda     ide_size+1
00210Dr 2  ED rr rr             sbc     ide_pos+1
002110r 2  8D rr rr             sta     ide_n+1
002113r 2  AD rr rr             lda     ide_size+2
002116r 2  ED rr rr             sbc     ide_pos+2
002119r 2  AA                   tax
00211Ar 2  AD rr rr             lda     ide_size+3
00211Dr 2  ED rr rr             sbc     ide_pos+3
002120r 2  B0 03                bcs     :+
002122r 2  4C rr rr             jmp     @none                   ; (past the end)
002125r 2  D0 15        :       bne     @len                    ; 16 MB or more left: ch_len
002127r 2  8A                   txa
002128r 2  D0 12                bne     @len                    ; 64K or more left: ch_len
00212Ar 2  AD rr rr             lda     ide_n+1                 ; less than ch_len left?
00212Dr 2  CD rr rr             cmp     ch_len+1
002130r 2  90 16                bcc     @go
002132r 2  D0 08                bne     @len
002134r 2  AD rr rr             lda     ide_n
002137r 2  CD rr rr             cmp     ch_len
00213Ar 2  90 0C                bcc     @go
00213Cr 2  AD rr rr     @len:   lda     ch_len
00213Fr 2  8D rr rr             sta     ide_n
002142r 2  AD rr rr             lda     ch_len+1
002145r 2  8D rr rr             sta     ide_n+1
002148r 2  AD rr rr     @go:    lda     ide_n
00214Br 2  0D rr rr             ora     ide_n+1
00214Er 2  D0 03                bne     :+
002150r 2  4C rr rr             jmp     @none
002153r 2               :
002153r 2  AD rr rr             lda     ide_n                   ; ch_got = count; pos += count
002156r 2  8D rr rr             sta     ch_got
002159r 2  AD rr rr             lda     ide_n+1
00215Cr 2  8D rr rr             sta     ch_got+1
00215Fr 2  18                   clc
002160r 2  AD rr rr             lda     ide_pos
002163r 2  6D rr rr             adc     ide_n
002166r 2  8D rr rr             sta     ide_pos
002169r 2  AD rr rr             lda     ide_pos+1
00216Cr 2  6D rr rr             adc     ide_n+1
00216Fr 2  8D rr rr             sta     ide_pos+1
002172r 2  90 08                bcc     :+
002174r 2  EE rr rr             inc     ide_pos+2
002177r 2  D0 03                bne     :+
002179r 2  EE rr rr             inc     ide_pos+3
00217Cr 2  A9 CA        :       lda     #IDE_C_READ
00217Er 2  20 rr rr             jsr     ide_count
002181r 2  B0 64                bcs     @to
002183r 2  A5 rr 48 A5          ZP_ENTER
002187r 2  rr 48 AD rr  
00218Br 2  rr 85 rr AD  
002193r 2  A0 00                ldy     #0
002195r 2  8C rr rr     @b:     sty     ide_t
002198r 2  20 rr rr             jsr     ide_get
00219Br 2  B0 3A                bcs     @to2
00219Dr 2  AC rr rr             ldy     ide_t
0021A0r 2  91 rr                sta     (zp_ptr),y
0021A2r 2  C8                   iny
0021A3r 2  D0 02                bne     :+
0021A5r 2  E6 rr                inc     zp_ptr+1
0021A7r 2  AD rr rr     :       lda     ide_n
0021AAr 2  D0 03                bne     :+
0021ACr 2  CE rr rr             dec     ide_n+1
0021AFr 2  CE rr rr     :       dec     ide_n
0021B2r 2  AD rr rr             lda     ide_n
0021B5r 2  0D rr rr             ora     ide_n+1
0021B8r 2  D0 DB                bne     @b
0021BAr 2  98                   tya                             ; zp_ptr += the last partial page
0021BBr 2  18                   clc
0021BCr 2  65 rr                adc     zp_ptr
0021BEr 2  85 rr                sta     zp_ptr
0021C0r 2  90 02                bcc     :+
0021C2r 2  E6 rr                inc     zp_ptr+1
0021C4r 2  A5 rr 8D rr  :       ZP_LEAVE
0021C8r 2  rr A5 rr 8D  
0021CCr 2  rr rr 68 85  
0021D4r 2  4C rr rr             jmp     ide_end
0021D7r 2  A5 rr 8D rr  @to2:   ZP_LEAVE
0021DBr 2  rr A5 rr 8D  
0021DFr 2  rr rr 68 85  
0021E7r 2  A9 FF        @to:    lda     #$FF
0021E9r 2  60                   rts
0021EAr 2  A9 14        @none:  lda     #USB_INT_SUCCESS
0021ECr 2  60                   rts
0021EDr 2               
0021EDr 2               ; ide_write - write ch_len bytes from (ch_ptr)
0021EDr 2               ide_write:
0021EDr 2  AD rr rr             lda     ch_len
0021F0r 2  8D rr rr             sta     ide_n
0021F3r 2  AD rr rr             lda     ch_len+1
0021F6r 2  8D rr rr             sta     ide_n+1
0021F9r 2  0D rr rr             ora     ide_n
0021FCr 2  F0 6E                beq     @ok
0021FEr 2  A9 CB                lda     #IDE_C_WRITE
002200r 2  20 rr rr             jsr     ide_count
002203r 2  B0 64                bcs     @to
002205r 2  A5 rr 48 A5          ZP_ENTER
002209r 2  rr 48 AD rr  
00220Dr 2  rr 85 rr AD  
002215r 2  A0 00                ldy     #0
002217r 2  B1 rr        @b:     lda     (zp_ptr),y
002219r 2  8C rr rr             sty     ide_t
00221Cr 2  20 rr rr             jsr     ide_put
00221Fr 2  B0 38                bcs     @to2
002221r 2  AC rr rr             ldy     ide_t
002224r 2  C8                   iny
002225r 2  D0 02                bne     :+
002227r 2  E6 rr                inc     zp_ptr+1
002229r 2  AD rr rr     :       lda     ide_n
00222Cr 2  D0 03                bne     :+
00222Er 2  CE rr rr             dec     ide_n+1
002231r 2  CE rr rr     :       dec     ide_n
002234r 2  AD rr rr             lda     ide_n
002237r 2  0D rr rr             ora     ide_n+1
00223Ar 2  D0 DB                bne     @b
00223Cr 2  98                   tya
00223Dr 2  18                   clc
00223Er 2  65 rr                adc     zp_ptr
002240r 2  85 rr                sta     zp_ptr
002242r 2  90 02                bcc     :+
002244r 2  E6 rr                inc     zp_ptr+1
002246r 2  A5 rr 8D rr  :       ZP_LEAVE
00224Ar 2  rr A5 rr 8D  
00224Er 2  rr rr 68 85  
002256r 2  4C rr rr             jmp     ide_end
002259r 2  A5 rr 8D rr  @to2:   ZP_LEAVE
00225Dr 2  rr A5 rr 8D  
002261r 2  rr rr 68 85  
002269r 2  A9 FF        @to:    lda     #$FF
00226Br 2  60                   rts
00226Cr 2  A9 14        @ok:    lda     #USB_INT_SUCCESS
00226Er 2  60                   rts
00226Fr 2               
00226Fr 2               ; ide_dirlist - list the directory named by ch_name ("/*", "*", "/A/*", or
00226Fr 2               ; with a pattern after the last "/" - the interface lists everything)
00226Fr 2               ide_dirlist:
00226Fr 2  20 rr rr             jsr     ide_prepare
002272r 2  90 05                bcc     :+
002274r 2  A9 F2                lda     #CH_E_NODISK
002276r 2  4C rr rr             jmp     ch_fail
002279r 2  A9 rr        :       lda     #<ch_name
00227Br 2  A2 rr                ldx     #>ch_name
00227Dr 2  20 rr rr             jsr     ide_walk
002280r 2  C9 14                cmp     #USB_INT_SUCCESS
002282r 2  D0 20                bne     @fail
002284r 2  A9 C1                lda     #IDE_C_DIR
002286r 2  20 rr rr             jsr     ide_cmd
002289r 2  B0 17                bcs     @to
00228Br 2  20 rr rr     @c:     jsr     ide_get
00228Er 2  B0 12                bcs     @to
002290r 2  C9 00                cmp     #0
002292r 2  F0 06                beq     @end
002294r 2  20 rr rr             jsr     ch_putc
002297r 2  4C rr rr             jmp     @c
00229Ar 2  20 rr rr     @end:   jsr     ide_end
00229Dr 2  C9 14                cmp     #USB_INT_SUCCESS
00229Fr 2  D0 03                bne     @fail
0022A1r 2  60                   rts
0022A2r 2  A9 FF        @to:    lda     #$FF
0022A4r 2  4C rr rr     @fail:  jmp     ch_fail
0022A7r 2               
0022A7r 2               ; ============================================================================
0022A7r 2               ; The DS1302 clock on the interface
0022A7r 2               ; ============================================================================
0022A7r 2               
0022A7r 2               ; ide_time - A/Y = a buffer of 18 bytes: "mm/dd/yy hh:mm:ss",0.
0022A7r 2               ; C=1 if the interface didn't answer.
0022A7r 2               ide_time:
0022A7r 2  85 rr                sta     zp_ptr
0022A9r 2  84 rr                sty     zp_ptr+1
0022ABr 2  2C rr rr             bit     spi_ok
0022AEr 2  10 2A                bpl     @no
0022B0r 2  A9 E0                lda     #IDE_C_GETTIME
0022B2r 2  20 rr rr             jsr     ide_cmd
0022B5r 2  B0 23                bcs     @no
0022B7r 2  A0 00                ldy     #0
0022B9r 2  8C rr rr     @c:     sty     ide_t
0022BCr 2  20 rr rr             jsr     ide_get
0022BFr 2  B0 19                bcs     @no
0022C1r 2  AC rr rr             ldy     ide_t
0022C4r 2  C0 11                cpy     #17
0022C6r 2  B0 02                bcs     :+
0022C8r 2  91 rr                sta     (zp_ptr),y
0022CAr 2  C8           :       iny
0022CBr 2  C9 00                cmp     #0
0022CDr 2  D0 EA                bne     @c
0022CFr 2  A0 11                ldy     #17
0022D1r 2  A9 00                lda     #0
0022D3r 2  91 rr                sta     (zp_ptr),y
0022D5r 2  20 rr rr             jsr     ide_end
0022D8r 2  18                   clc
0022D9r 2  60                   rts
0022DAr 2  38           @no:    sec
0022DBr 2  60                   rts
0022DCr 2               
0022DCr 2               ; ide_settime - A/Y = 14 characters "dwyymmddHHMMSS" (dw: 01 = Sunday)
0022DCr 2               ; C=1 if the interface didn't answer.
0022DCr 2               ide_settime:
0022DCr 2  85 rr                sta     zp_ptr
0022DEr 2  84 rr                sty     zp_ptr+1
0022E0r 2  2C rr rr             bit     spi_ok
0022E3r 2  10 20                bpl     @no
0022E5r 2  A9 E1                lda     #IDE_C_SETTIME
0022E7r 2  20 rr rr             jsr     ide_cmd
0022EAr 2  B0 19                bcs     @no
0022ECr 2  A0 00                ldy     #0
0022EEr 2  B1 rr        @c:     lda     (zp_ptr),y
0022F0r 2  8C rr rr             sty     ide_t
0022F3r 2  20 rr rr             jsr     ide_put
0022F6r 2  B0 0D                bcs     @no
0022F8r 2  AC rr rr             ldy     ide_t
0022FBr 2  C8                   iny
0022FCr 2  C0 0E                cpy     #14
0022FEr 2  D0 EE                bne     @c
002300r 2  20 rr rr             jsr     ide_end
002303r 2  18                   clc
002304r 2  60                   rts
002305r 2  38           @no:    sec
002306r 2  60                   rts
002307r 2               
002307r 1               .endif
002307r 1               .include "fs.s"                 ; U: / C: - the calls LOAD, SAVE and the monitor use
002307r 2               ; ============================================================================
002307r 2               ; fs.s - one set of file calls for LOAD / SAVE / LOADRAW / SAVERAW, LOAD "$",
002307r 2               ;        the monitor's L command and SBC_LOAD, on either storage device:
002307r 2               ;
002307r 2               ;   U:  the CH376 USB drive              (fs_dev = 0)
002307r 2               ;   C:  the CF card on the SPI-IDE card  (fs_dev = 1)
002307r 2               ;
002307r 2               ; A name may start with "U:" or "C:" to switch devices; the choice stays
002307r 2               ; until changed (like a DOS drive letter), e.g.  LOAD "C:GAME", SAVE "U:X",
002307r 2               ; LOAD "C:$", and in the monitor  L C:  then  L NAME.  At reset it is
002307r 2               ; FS_DEFAULT (config.inc).  Switching device in the monitor goes back to
002307r 2               ; that device's root directory.
002307r 2               ;
002307r 2               ; The calls take and return exactly what the CH376 driver does (A/X = name,
002307r 2               ; ch_ptr / ch_len / ch_got, CH376 status codes), so the code above them is the
002307r 2               ; same for both devices.
002307r 2               ; ============================================================================
002307r 2               
002307r 2               FS_USB          = 0
002307r 2               FS_CF           = 1
002307r 2               
002307r 2               .segment "DRVVARS"
0001D4r 2  xx           fs_dev:         .res 1
0001D5r 2               
0001D5r 2               .segment "BIOS"
002307r 2               
002307r 2               ; fs_boot - from CH_BOOT
002307r 2               fs_boot:
002307r 2  A9 00                lda     #FS_DEFAULT
002309r 2  8D rr rr             sta     fs_dev
00230Cr 2               .if HAS_IDE
00230Cr 2  A9 00                lda     #0
00230Er 2  8D rr rr             sta     ide_ready
002311r 2               .endif
002311r 2  60                   rts
002312r 2               
002312r 2               ; fs_unready - A = 0: both devices are set up again next time (keeps A)
002312r 2               fs_unready:
002312r 2  8D rr rr             sta     ch_ready
002315r 2               .if HAS_IDE
002315r 2  8D rr rr             sta     ide_ready
002318r 2               .endif
002318r 2  60                   rts
002319r 2               
002319r 2               ; fs_letter - A = a device letter (either case): C=0 and fs_dev set, or C=1
002319r 2               ; if it isn't U or C.  Y is kept.
002319r 2               fs_letter:
002319r 2  29 DF                and     #$DF
00231Br 2  C9 55                cmp     #'U'
00231Dr 2  F0 06                beq     @u
00231Fr 2               .if HAS_IDE
00231Fr 2  C9 43                cmp     #'C'
002321r 2  F0 09                beq     @c
002323r 2               .endif
002323r 2  38                   sec
002324r 2  60                   rts
002325r 2  A9 00        @u:     lda     #FS_USB
002327r 2  8D rr rr             sta     fs_dev
00232Ar 2  18                   clc
00232Br 2  60                   rts
00232Cr 2               .if HAS_IDE
00232Cr 2  A9 01        @c:     lda     #FS_CF
00232Er 2  8D rr rr             sta     fs_dev
002331r 2  18                   clc
002332r 2  60                   rts
002333r 2               .endif
002333r 2               
002333r 2               ; ---- the dispatch -------------------------------------------------------------
002333r 2               .if HAS_IDE
002333r 2                 .macro FS_GO usb, cf
002333r 2                       ldy     fs_dev
002333r 2                       bne     :+
002333r 2                       jmp     usb
002333r 2               :       jmp     cf
002333r 2                 .endmacro
002333r 2               .else
002333r 2                 .macro FS_GO usb, cf
002333r 2                       jmp     usb
002333r 2                 .endmacro
002333r 2               .endif
002333r 2               
002333r 2  AC rr rr D0  fs_prepare:     FS_GO   ch_prepare,    ide_prepare
002337r 2  03 4C rr rr  
00233Br 2  4C rr rr     
00233Er 2  AC rr rr D0  fs_dirlist:     FS_GO   ch_dirlist,    ide_dirlist
002342r 2  03 4C rr rr  
002346r 2  4C rr rr     
002349r 2  AC rr rr D0  fs_read:        FS_GO   ch_read,       ide_read
00234Dr 2  03 4C rr rr  
002351r 2  4C rr rr     
002354r 2  AC rr rr D0  fs_write:       FS_GO   ch_write,      ide_write
002358r 2  03 4C rr rr  
00235Cr 2  4C rr rr     
00235Fr 2  AC rr rr D0  fs_close:       FS_GO   ch_file_close, ide_close
002363r 2  03 4C rr rr  
002367r 2  4C rr rr     
00236Ar 2               
00236Ar 2               ; (A/X = name: Y is the only free register)
00236Ar 2  AC rr rr D0  fs_open:        FS_GO   ch_file_open,  ide_open
00236Er 2  03 4C rr rr  
002372r 2  4C rr rr     
002375r 2  AC rr rr D0  fs_create:      FS_GO   ch_file_create, ide_create
002379r 2  03 4C rr rr  
00237Dr 2  4C rr rr     
002380r 2  AC rr rr D0  fs_erase:       FS_GO   ch_file_erase, ide_erase
002384r 2  03 4C rr rr  
002388r 2  4C rr rr     
00238Br 2               
00238Br 2               ; ---- date and time (jump table) -----------------------------------------------
00238Br 2               ; FS_TIME - A/Y = 18 byte buffer <- "mm/dd/yy hh:mm:ss",0;  C=1 = no clock
00238Br 2               ; FS_SETTIME - A/Y -> 14 characters "dwyymmddHHMMSS" (dw 01 = Sunday)
00238Br 2               .if HAS_IDE
00238Br 2               FS_TIME         = ide_time
00238Br 2               FS_SETTIME      = ide_settime
00238Br 2               .else
00238Br 2               FS_TIME:
00238Br 2               FS_SETTIME:
00238Br 2                       sec
00238Br 2                       rts
00238Br 2               .endif
00238Br 2               
00238Br 1               .include "pcf8584.s"            ; PCF8584 I2C bridge driver (BIOS, BIOSVARS)
00238Br 2               ; ============================================================================
00238Br 2               ; pcf8584.s - PCF8584 parallel-bus to I2C bridge driver (master mode, polled)
00238Br 2               ;
00238Br 2               ; Ported from pcf8584_lcd_test.s (vasm) to ca65.  Contains only the bus layer:
00238Br 2               ;   pcf_init       initialise the chip                    C=1 on failure
00238Br 2               ;   i2c_start      START + address byte (i2c_addr)        C=1 on NACK / timeout
00238Br 2               ;   i2c_send       send byte in A                         C=1 on NACK / timeout
00238Br 2               ;   i2c_read1      START + read ONE byte, then STOP       C=1 on failure, A=byte
00238Br 2               ;   i2c_stop       STOP
00238Br 2               ;   delay_ms       delay A milliseconds
00238Br 2               ;
00238Br 2               ; Transfers are polled.  The chip's INT output (your IRQ4) stays silent because
00238Br 2               ; the ENI bit is never set in the control register.  The BIOS routes IRQ4 to
00238Br 2               ; EhBASIC's "ON IRQ" flag, so nothing happens there unless you add interrupt
00238Br 2               ; driven transfers later.
00238Br 2               ;
00238Br 2               ; Included from main.s after basic.s.  Code is in segment BIOS, variables in
00238Br 2               ; BIOSVARS (both placed by sbc.cfg).
00238Br 2               ; ============================================================================
00238Br 2               
00238Br 2               ; ---------------- user configuration ----------------------------------------
00238Br 2               ; CPU_MHZ (CPU clock in whole MHz) is set once, at the top of main.s
00238Br 2               
00238Br 2               PCF_S0      = $7F10         ; A0=0 : S0 data / S0' own addr / S2 clock (selected via S1)
00238Br 2               PCF_S1      = $7F11         ; A0=1 : S1 control (write) / status (read)
00238Br 2               
00238Br 2               PCF_OWN     = $55           ; PCF8584's own I2C address (must not clash with your devices)
00238Br 2               
00238Br 2               ; S2 clock register = (PCF CLK pin frequency) + (SCL frequency)
00238Br 2               ;   CLK pin freq: $00 = 3 MHz, $10 = 4.43 MHz, $14 = 6 MHz, $18 = 8 MHz, $1C = 12 MHz
00238Br 2               ;   SCL freq    : +0 = 90 kHz, +1 = 45 kHz, +2 = 11 kHz, +3 = 1.5 kHz
00238Br 2               ; NOTE: the original test file said "$00 = 8 MHz clock" but by the table above
00238Br 2               ; $00 means a 3 MHz clock on the CLK pin.  Set this for YOUR oscillator.
00238Br 2               PCF_CLOCK   = $00
00238Br 2               
00238Br 2               ; ---------------- PCF8584 bits ------------------------------------------------
00238Br 2               ; Control register (write)
00238Br 2               PCF_PIN     = $80
00238Br 2               PCF_ESO     = $40
00238Br 2               PCF_ES1     = $20
00238Br 2               PCF_STA     = $04
00238Br 2               PCF_STO     = $02
00238Br 2               PCF_ACK     = $01
00238Br 2               ; Status register (read)
00238Br 2               PCF_ST_LRB  = $08           ; last received bit: 0 = ACK, 1 = NACK
00238Br 2               PCF_ST_BB   = $01           ; bus busy (inverted: 1 = bus FREE)
00238Br 2               
00238Br 2               CTRL_IDLE   = PCF_PIN+PCF_ESO+PCF_ACK              ; $C1
00238Br 2               CTRL_START  = PCF_PIN+PCF_ESO+PCF_STA+PCF_ACK      ; $C5
00238Br 2               CTRL_STOP   = PCF_PIN+PCF_ESO+PCF_STO+PCF_ACK      ; $C3
00238Br 2               CTRL_NOACK  = PCF_PIN+PCF_ESO                      ; $C0 (receive last byte)
00238Br 2               
00238Br 2               ; ---------------- variables ---------------------------------------------------
00238Br 2               .segment "BIOSVARS"
000002r 2  xx           i2c_dly:    .res 1          ; delay_ms counter
000003r 2  xx           i2c_addr:   .res 1          ; slave address byte (incl. R/W bit) for i2c_start
000004r 2  xx           pcf_stat:   .res 1          ; last PCF status (for debugging)
000005r 2  xx           pcf_ready:  .res 1          ; non-zero once pcf_init has succeeded
000006r 2               
000006r 2               .segment "BIOS"
00238Br 2               
00238Br 2               ; ============================================================================
00238Br 2               ; PCF8584 initialisation (datasheet sequence)
00238Br 2               ; Returns C=0 on success, C=1 on failure (raw status in pcf_stat)
00238Br 2               ; ============================================================================
00238Br 2               pcf_init:
00238Br 2  A9 80                lda     #PCF_PIN            ; $80: ESO=0 -> next A0=0 access is S0' (own address)
00238Dr 2  8D 11 7F             sta     PCF_S1
002390r 2  A9 55                lda     #PCF_OWN
002392r 2  8D 10 7F             sta     PCF_S0              ; write own address
002395r 2  A9 A0                lda     #PCF_PIN+PCF_ES1    ; $A0: next A0=0 access is S2 (clock)
002397r 2  8D 11 7F             sta     PCF_S1
00239Ar 2  A9 00                lda     #PCF_CLOCK
00239Cr 2  8D 10 7F             sta     PCF_S0              ; write clock register
00239Fr 2  A9 01                lda     #1
0023A1r 2  20 rr rr             jsr     delay_ms            ; let the internal clock settle
0023A4r 2  A9 C1                lda     #CTRL_IDLE          ; $C1: serial interface on, ACK enabled
0023A6r 2  8D 11 7F             sta     PCF_S1
0023A9r 2  A9 01                lda     #1
0023ABr 2  20 rr rr             jsr     delay_ms
0023AEr 2  AD 11 7F             lda     PCF_S1              ; expect PIN=1 and BB=1 (bus free) -> $81
0023B1r 2  8D rr rr             sta     pcf_stat
0023B4r 2  29 81                and     #PCF_PIN+PCF_ST_BB
0023B6r 2  C9 81                cmp     #PCF_PIN+PCF_ST_BB
0023B8r 2  D0 02                bne     @fail
0023BAr 2  18                   clc
0023BBr 2  60                   rts
0023BCr 2  38           @fail:  sec
0023BDr 2  60                   rts
0023BEr 2               
0023BEr 2               ; ============================================================================
0023BEr 2               ; Wait for PIN to go low (byte transfer finished)
0023BEr 2               ; Returns C=0 and A=status, or C=1 on timeout.  Clobbers X, Y.
0023BEr 2               ; ============================================================================
0023BEr 2               pcf_wait_pin:
0023BEr 2  A2 10                ldx     #16
0023C0r 2  A0 00                ldy     #0
0023C2r 2  AD 11 7F     @loop:  lda     PCF_S1
0023C5r 2  10 08                bpl     @ok                 ; bit7 (PIN) = 0 -> done
0023C7r 2  88                   dey
0023C8r 2  D0 F8                bne     @loop
0023CAr 2  CA                   dex
0023CBr 2  D0 F5                bne     @loop
0023CDr 2  38                   sec
0023CEr 2  60                   rts
0023CFr 2  8D rr rr     @ok:    sta     pcf_stat
0023D2r 2  18                   clc
0023D3r 2  60                   rts
0023D4r 2               
0023D4r 2               ; ============================================================================
0023D4r 2               ; I2C: START + address.  i2c_addr = 8-bit address byte (incl. R/W)
0023D4r 2               ; Returns C=0 if slave ACKed, C=1 on timeout/NACK.  Clobbers A, X, Y.
0023D4r 2               ; ============================================================================
0023D4r 2               i2c_start:
0023D4r 2  A2 10                ldx     #16                 ; wait for bus free (BB=1)
0023D6r 2  A0 00                ldy     #0
0023D8r 2  AD 11 7F     @bb:    lda     PCF_S1
0023DBr 2  29 01                and     #PCF_ST_BB
0023DDr 2  D0 08                bne     @go
0023DFr 2  88                   dey
0023E0r 2  D0 F6                bne     @bb
0023E2r 2  CA                   dex
0023E3r 2  D0 F3                bne     @bb
0023E5r 2  38                   sec
0023E6r 2  60                   rts
0023E7r 2  AD rr rr     @go:    lda     i2c_addr
0023EAr 2  8D 10 7F             sta     PCF_S0              ; address goes into S0 first
0023EDr 2  A9 C5                lda     #CTRL_START
0023EFr 2  8D 11 7F             sta     PCF_S1              ; then START
0023F2r 2  20 rr rr             jsr     pcf_wait_pin
0023F5r 2  B0 04                bcs     @rts                ; timeout (C already set)
0023F7r 2  29 08                and     #PCF_ST_LRB         ; 0 = ACK
0023F9r 2  C9 01                cmp     #1                  ; A=0 -> C=0 ; A=8 -> C=1
0023FBr 2  60           @rts:   rts
0023FCr 2               
0023FCr 2               ; ============================================================================
0023FCr 2               ; I2C: send byte in A.  Returns C=0 if ACKed, C=1 on timeout/NACK
0023FCr 2               ; ============================================================================
0023FCr 2               i2c_send:
0023FCr 2  8D 10 7F             sta     PCF_S0
0023FFr 2  20 rr rr             jsr     pcf_wait_pin
002402r 2  B0 04                bcs     @rts
002404r 2  29 08                and     #PCF_ST_LRB
002406r 2  C9 01                cmp     #1
002408r 2  60           @rts:   rts
002409r 2               
002409r 2               ; ============================================================================
002409r 2               ; I2C: STOP
002409r 2               ; ============================================================================
002409r 2               i2c_stop:
002409r 2  A9 C3                lda     #CTRL_STOP
00240Br 2  8D 11 7F             sta     PCF_S1
00240Er 2  60                   rts
00240Fr 2               
00240Fr 2               ; ============================================================================
00240Fr 2               ; I2C: read ONE byte.  i2c_addr must hold the address byte with R/W = 1.
00240Fr 2               ; Sends START + address, receives a single byte with NACK, then STOP.
00240Fr 2               ; Returns C=0 and A = byte, or C=1 on NACK / timeout (bus is released).
00240Fr 2               ; Follows the sequence used by the Linux i2c-algo-pcf driver.
00240Fr 2               ; ============================================================================
00240Fr 2               i2c_read1:
00240Fr 2  20 rr rr             jsr     i2c_start           ; START + address (R)
002412r 2  B0 17                bcs     @fail
002414r 2  A9 C0                lda     #CTRL_NOACK         ; this is the last byte: do not ACK it
002416r 2  8D 11 7F             sta     PCF_S1
002419r 2  AD 10 7F             lda     PCF_S0              ; dummy read of S0 starts the byte clocking in
00241Cr 2  20 rr rr             jsr     pcf_wait_pin
00241Fr 2  B0 0A                bcs     @fail
002421r 2  A9 C3                lda     #CTRL_STOP          ; STOP, then fetch the received byte
002423r 2  8D 11 7F             sta     PCF_S1
002426r 2  AD 10 7F             lda     PCF_S0
002429r 2  18                   clc
00242Ar 2  60                   rts
00242Br 2  20 rr rr     @fail:  jsr     i2c_stop
00242Er 2  38                   sec
00242Fr 2  60                   rts
002430r 2               
002430r 2               ; ============================================================================
002430r 2               ; Delay A milliseconds (approximate, errs on the long side)
002430r 2               ; ============================================================================
002430r 2               delay_ms:
002430r 2  8D rr rr             sta     i2c_dly
002433r 2  A2 04        @ms:    ldx     #CPU_MHZ
002435r 2  A0 C8        @outer: ldy     #200                ; 200 * 5 cycles = 1000 cycles = 1 ms @ 1 MHz
002437r 2  88           @inner: dey
002438r 2  D0 FD                bne     @inner
00243Ar 2  CA                   dex
00243Br 2  D0 F8                bne     @outer
00243Dr 2  CE rr rr             dec     i2c_dly
002440r 2  D0 F1                bne     @ms
002442r 2  60                   rts
002443r 2               
002443r 1               .include "lcd_i2c.s"            ; I2C LCD                   (BIOS, BIOSVARS, ZEROPAGE)
002443r 2               ; ============================================================================
002443r 2               ; lcd_i2c.s - HD44780 LCD (4-bit) behind an MCP23008 I2C port expander
002443r 2               ;
002443r 2               ; Ported from pcf8584_lcd_test.s.  Uses the bus layer in pcf8584.s.
002443r 2               ;
002443r 2               ;   mcp_write      A = MCP register, Y = value
002443r 2               ;   lcd_init       full HD44780 power-up sequence (also sets lcd_ready)
002443r 2               ;   lcd_cmd        send command byte in A
002443r 2               ;   lcd_data       send character in A
002443r 2               ;   lcd_clear      clear display (includes the 1.6 ms wait)
002443r 2               ;   lcd_putbuf     send lcd_len characters from (strptr)
002443r 2               ;   lcd_puts       send zero terminated string at (strptr)  (kept from the test)
002443r 2               ;
002443r 2               ; ERRORS: any failed I2C access sets i2c_err non-zero and is "latched": while
002443r 2               ; i2c_err is set, mcp_write returns immediately, so a missing LCD costs one
002443r 2               ; timeout instead of dozens.  The caller clears i2c_err before a command and
002443r 2               ; looks at it afterwards (basic_i2c.s does that and raises "I2C Error").
002443r 2               ; ============================================================================
002443r 2               
002443r 2               ; ---------------- user configuration ----------------------------------------
002443r 2               MCP_ADDR_W  = $40           ; DEFAULT address: 0x20 << 1, R/W = 0 (write).  LCDINIT addr overrides it.
002443r 2               
002443r 2               ; ---------------- MCP23008 ------------------------------------------------------
002443r 2               MCP_IODIR   = $00
002443r 2               MCP_GPIO    = $09
002443r 2               
002443r 2               LCD_RS      = $80           ; GPIO7
002443r 2               LCD_E       = $40           ; GPIO6
002443r 2               LCD_BL      = $02           ; GPIO1
002443r 2               
002443r 2               ; ---------------- PCF8574 backpack (LCDINIT addr, 1) ----------------------------
002443r 2               LCP_RS      = $01           ; P0
002443r 2               LCP_E       = $04           ; P2   (P1 = RW, kept low)
002443r 2               LCP_BL      = $08           ; P3   P4-P7 = D4-D7
002443r 2               
002443r 2               ; ---------------- variables ---------------------------------------------------
002443r 2               .zeropage
00000Cr 2               ; strptr (zero page, 2 bytes) is declared in ch376_abs.s
00000Cr 2               
00000Cr 2               .segment "BIOSVARS"
000006r 2  xx           i2c_err:    .res 1          ; non-zero if any I2C error occurred (latched)
000007r 2  xx           lcd_rs:     .res 1          ; current RS bit ($00 or LCD_RS)
000008r 2  xx           lcd_val:    .res 1          ; GPIO value being sent
000009r 2  xx           mcp_reg:    .res 1          ; MCP register for mcp_write
00000Ar 2  xx           mcp_data:   .res 1          ; MCP data for mcp_write
00000Br 2  xx           lcd_ready:  .res 1          ; non-zero once lcd_init has run
00000Cr 2  xx           lcd_addr:   .res 1          ; I2C address byte (7 bit address << 1, R/W = 0) of the LCD
00000Dr 2  xx           lcd_type:   .res 1          ; 0 = MCP23008 backpack, 1 = PCF8574 backpack
00000Er 2  xx           lcd_len:    .res 1          ; characters left for lcd_putbuf
00000Fr 2               
00000Fr 2               .segment "BIOS"
002443r 2               
002443r 2               ; ============================================================================
002443r 2               ; MCP23008 register write.  A = register, Y = value
002443r 2               ; Sets i2c_err on failure.  Does nothing while i2c_err is already set.
002443r 2               ; Clobbers A, X, Y.
002443r 2               ; ============================================================================
002443r 2               mcp_write:
002443r 2  AE rr rr             ldx     i2c_err
002446r 2  D0 24                bne     @rts                ; earlier error: don't touch the bus
002448r 2  8D rr rr             sta     mcp_reg
00244Br 2  8C rr rr             sty     mcp_data
00244Er 2  AD rr rr             lda     lcd_addr            ; default MCP_ADDR_W, changed by LCDINIT addr
002451r 2  8D rr rr             sta     i2c_addr
002454r 2  20 rr rr             jsr     i2c_start
002457r 2  B0 14                bcs     @fail
002459r 2  AD rr rr             lda     mcp_reg
00245Cr 2  20 rr rr             jsr     i2c_send
00245Fr 2  B0 0C                bcs     @fail
002461r 2  AD rr rr             lda     mcp_data
002464r 2  20 rr rr             jsr     i2c_send
002467r 2  B0 04                bcs     @fail
002469r 2  20 rr rr             jsr     i2c_stop
00246Cr 2  60           @rts:   rts
00246Dr 2  20 rr rr     @fail:  jsr     i2c_stop
002470r 2  A9 FF                lda     #$FF
002472r 2  8D rr rr             sta     i2c_err
002475r 2  60                   rts
002476r 2               
002476r 2               ; ============================================================================
002476r 2               ; LCD (HD44780, 4-bit, via MCP23008)
002476r 2               ; ============================================================================
002476r 2               lcd_init:
002476r 2  AD rr rr             lda     lcd_type
002479r 2  D0 11                bne     @pcf
00247Br 2  A9 00                lda     #MCP_IODIR          ; all GPIO = outputs
00247Dr 2  A0 00                ldy     #$00
00247Fr 2  20 rr rr             jsr     mcp_write
002482r 2  A9 09                lda     #MCP_GPIO           ; backlight on, E=0, RS=0
002484r 2  A0 02                ldy     #LCD_BL
002486r 2  20 rr rr             jsr     mcp_write
002489r 2  4C rr rr             jmp     @common
00248Cr 2  A9 08        @pcf:   lda     #LCP_BL             ; PCF8574 has no registers: backlight on, E=0
00248Er 2  20 rr rr             jsr     lcp_write
002491r 2               @common:
002491r 2  A9 00                lda     #0
002493r 2  8D rr rr             sta     lcd_rs
002496r 2               
002496r 2  A9 32                lda     #50                 ; >40 ms after power up
002498r 2  20 rr rr             jsr     delay_ms
00249Br 2  A9 03                lda     #$03
00249Dr 2  20 rr rr             jsr     lcd_nibble
0024A0r 2  A9 05                lda     #5                  ; >4.1 ms
0024A2r 2  20 rr rr             jsr     delay_ms
0024A5r 2  A9 03                lda     #$03
0024A7r 2  20 rr rr             jsr     lcd_nibble
0024AAr 2  A9 01                lda     #1                  ; >100 us
0024ACr 2  20 rr rr             jsr     delay_ms
0024AFr 2  A9 03                lda     #$03
0024B1r 2  20 rr rr             jsr     lcd_nibble
0024B4r 2  A9 01                lda     #1
0024B6r 2  20 rr rr             jsr     delay_ms
0024B9r 2  A9 02                lda     #$02                ; switch to 4-bit mode
0024BBr 2  20 rr rr             jsr     lcd_nibble
0024BEr 2  A9 01                lda     #1
0024C0r 2  20 rr rr             jsr     delay_ms
0024C3r 2               
0024C3r 2  A9 28                lda     #$28                ; function set: 4-bit, 2 lines, 5x8
0024C5r 2  20 rr rr             jsr     lcd_cmd
0024C8r 2  A9 08                lda     #$08                ; display off
0024CAr 2  20 rr rr             jsr     lcd_cmd
0024CDr 2  20 rr rr             jsr     lcd_clear           ; clear display (+ wait)
0024D0r 2  A9 06                lda     #$06                ; entry mode: increment, no shift
0024D2r 2  20 rr rr             jsr     lcd_cmd
0024D5r 2  A9 0C                lda     #$0C                ; display on, cursor off, blink off
0024D7r 2  20 rr rr             jsr     lcd_cmd
0024DAr 2  A9 01                lda     #1
0024DCr 2  8D rr rr             sta     lcd_ready
0024DFr 2  60                   rts
0024E0r 2               
0024E0r 2               ; Clear display and wait for it to finish (needs ~1.6 ms)
0024E0r 2               lcd_clear:
0024E0r 2  A9 01                lda     #$01
0024E2r 2  20 rr rr             jsr     lcd_cmd
0024E5r 2  A9 03                lda     #3
0024E7r 2  4C rr rr             jmp     delay_ms
0024EAr 2               
0024EAr 2               ; Send command in A
0024EAr 2               lcd_cmd:
0024EAr 2  A0 00                ldy     #$00
0024ECr 2  8C rr rr             sty     lcd_rs
0024EFr 2  4C rr rr             jmp     lcd_byte
0024F2r 2               
0024F2r 2               ; Send data (character) in A
0024F2r 2               lcd_data:
0024F2r 2  A0 80                ldy     #LCD_RS
0024F4r 2  8C rr rr             sty     lcd_rs
0024F7r 2                       ; fall through
0024F7r 2               
0024F7r 2               ; Send full byte in A (RS already in lcd_rs), high nibble first
0024F7r 2               lcd_byte:
0024F7r 2  48                   pha
0024F8r 2  4A                   lsr
0024F9r 2  4A                   lsr
0024FAr 2  4A                   lsr
0024FBr 2  4A                   lsr
0024FCr 2  20 rr rr             jsr     lcd_nibble
0024FFr 2  68                   pla
002500r 2                       ; fall through, lcd_nibble masks to low nibble
002500r 2               
002500r 2               ; Send low nibble of A to LCD D4-D7 with an E pulse
002500r 2               lcd_nibble:
002500r 2  AE rr rr             ldx     lcd_type
002503r 2  D0 29                bne     lcd_nibble_pcf
002505r 2  29 0F                and     #$0F
002507r 2  AA                   tax
002508r 2  BD rr rr             lda     nibble_tab,x
00250Br 2  09 02                ora     #LCD_BL
00250Dr 2  0D rr rr             ora     lcd_rs
002510r 2  8D rr rr             sta     lcd_val
002513r 2               
002513r 2  A9 09                lda     #MCP_GPIO           ; data + RS valid, E low
002515r 2  AC rr rr             ldy     lcd_val
002518r 2  20 rr rr             jsr     mcp_write
00251Br 2               
00251Br 2  AD rr rr             lda     lcd_val             ; E high
00251Er 2  09 40                ora     #LCD_E
002520r 2  A8                   tay
002521r 2  A9 09                lda     #MCP_GPIO
002523r 2  20 rr rr             jsr     mcp_write
002526r 2               
002526r 2  A9 09                lda     #MCP_GPIO           ; E low (latches data)
002528r 2  AC rr rr             ldy     lcd_val
00252Br 2  4C rr rr             jmp     mcp_write
00252Er 2               
00252Er 2               ; PCF8574 variant of lcd_nibble.  Pins: P0=RS P1=RW(0) P2=E P3=BL P4-P7=D4-D7
00252Er 2               lcd_nibble_pcf:
00252Er 2  0A                   asl
00252Fr 2  0A                   asl
002530r 2  0A                   asl
002531r 2  0A                   asl                         ; nibble -> P7..P4
002532r 2  09 08                ora     #LCP_BL
002534r 2  AE rr rr             ldx     lcd_rs
002537r 2  F0 02                beq     @nors
002539r 2  09 01                ora     #LCP_RS
00253Br 2  8D rr rr     @nors:  sta     lcd_val
00253Er 2  20 rr rr             jsr     lcp_write           ; data + RS valid, E low
002541r 2  AD rr rr             lda     lcd_val
002544r 2  09 04                ora     #LCP_E
002546r 2  20 rr rr             jsr     lcp_write           ; E high
002549r 2  AD rr rr             lda     lcd_val
00254Cr 2  4C rr rr             jmp     lcp_write           ; E low (latches data)
00254Fr 2               
00254Fr 2               ; PCF8574 write: A = port value (a single byte, no register).
00254Fr 2               lcp_write:
00254Fr 2  AE rr rr             ldx     i2c_err
002552r 2  D0 19                bne     @rts
002554r 2  8D rr rr             sta     mcp_data
002557r 2  AD rr rr             lda     lcd_addr
00255Ar 2  8D rr rr             sta     i2c_addr
00255Dr 2  20 rr rr             jsr     i2c_start
002560r 2  B0 0C                bcs     @fail
002562r 2  AD rr rr             lda     mcp_data
002565r 2  20 rr rr             jsr     i2c_send
002568r 2  B0 04                bcs     @fail
00256Ar 2  4C rr rr             jmp     i2c_stop
00256Dr 2  60           @rts:   rts
00256Er 2  20 rr rr     @fail:  jsr     i2c_stop
002571r 2  A9 FF                lda     #$FF
002573r 2  8D rr rr             sta     i2c_err
002576r 2  60                   rts
002577r 2               
002577r 2               ; Send lcd_len characters from (strptr).  Stops early on an I2C error.
002577r 2               lcd_putbuf:
002577r 2  AD rr rr     @next:  lda     lcd_len
00257Ar 2  F0 18                beq     @done
00257Cr 2  AD rr rr             lda     i2c_err
00257Fr 2  D0 13                bne     @done
002581r 2  A0 00                ldy     #0
002583r 2  B1 rr                lda     (strptr),y
002585r 2  20 rr rr             jsr     lcd_data
002588r 2  E6 rr                inc     strptr
00258Ar 2  D0 02                bne     @nc
00258Cr 2  E6 rr                inc     strptr+1
00258Er 2  CE rr rr     @nc:    dec     lcd_len
002591r 2  4C rr rr             jmp     @next
002594r 2  60           @done:  rts
002595r 2               
002595r 2               ; Print zero-terminated string at (strptr)
002595r 2               lcd_puts:
002595r 2  A0 00                ldy     #0
002597r 2  B1 rr                lda     (strptr),y
002599r 2  F0 0C                beq     @done
00259Br 2  20 rr rr             jsr     lcd_data
00259Er 2  E6 rr                inc     strptr
0025A0r 2  D0 F3                bne     lcd_puts
0025A2r 2  E6 rr                inc     strptr+1
0025A4r 2  4C rr rr             jmp     lcd_puts
0025A7r 2  60           @done:  rts
0025A8r 2               
0025A8r 2               ; ============================================================================
0025A8r 2               ; Data
0025A8r 2               ; ============================================================================
0025A8r 2               ; LCD nibble (D7..D4 = bits 3..0) -> MCP GPIO bits.
0025A8r 2               ; Wiring assumed literally as stated: GPIO5=D4, GPIO4=D5, GPIO3=D6, GPIO2=D7.
0025A8r 2               ; If your wiring is actually GPIO2=D4 ... GPIO5=D7, replace this table with
0025A8r 2               ; $00,$04,$08,$0C,$10,$14,$18,$1C,$20,$24,$28,$2C,$30,$34,$38,$3C
0025A8r 2               nibble_tab:
0025A8r 2  00 20 10 30          .byte   $00,$20,$10,$30,$08,$28,$18,$38
0025ACr 2  08 28 18 38  
0025B0r 2  04 24 14 34          .byte   $04,$24,$14,$34,$0C,$2C,$1C,$3C
0025B4r 2  0C 2C 1C 3C  
0025B8r 2               
0025B8r 1               .include "basic_i2c.s"          ; I2CINIT/I2CWRITE/I2CREAD(), LCDINIT/PRINT/CMD
0025B8r 2               ; ============================================================================
0025B8r 2               ; basic_i2c.s - EhBASIC statements and function for the PCF8584 I2C bridge and
0025B8r 2               ;               the I2C LCD.  Glue between basic.s and pcf8584.s / lcd_i2c.s.
0025B8r 2               ;
0025B8r 2               ; NEW BASIC KEYWORDS (tokens are defined in basic.s, tokenized by EhBASIC):
0025B8r 2               ;
0025B8r 2               ;   I2CINIT                     initialise the PCF8584 (optional: done on first use)
0025B8r 2               ;   I2CWRITE addr, b1 [,b2...]  write bytes to the device at 7-bit address "addr"
0025B8r 2               ;                               (0-127, i.e. the datasheet address, NOT shifted).
0025B8r 2               ;                               Up to 32 data bytes; none is allowed (address probe).
0025B8r 2               ;                               A device that doesn't ACK gives "I2C Error".
0025B8r 2               ;   x = I2CREAD(addr)           read ONE byte from 7-bit address "addr" (0-255).
0025B8r 2               ;                               Returns -1 if the device doesn't answer, so it can
0025B8r 2               ;                               be used to scan the bus without raising an error.
0025B8r 2               ;
0025B8r 2               ;   LCDINIT [addr]              (re)initialise the LCD (optional: done on first use).
0025B8r 2               ;                               With addr (0-127) the LCD at that 7-bit I2C address is
0025B8r 2               ;                               used from now on; plain LCDINIT goes back to the default
0025B8r 2               ;                               address (MCP_ADDR_W in lcd_i2c.s, 0x20).
0025B8r 2               ;   LCDPRINT [col, row,] s$     write a string at the cursor, or first move the
0025B8r 2               ;                               cursor to col (0-39), row (0-3)
0025B8r 2               ;   LCDCMD n                    send raw HD44780 command byte n (LCDCMD 1 = clear
0025B8r 2               ;                               the display; LCDCMD 12 = display on, cursor off;
0025B8r 2               ;                               LCDCMD 15 = blinking cursor)
0025B8r 2               ;   (CPU Rev2: LCDPOS and LCDCLS are gone - their tokens are SAY and VOICE now.)
0025B8r 2               ;
0025B8r 2               ; Both the PCF8584 and the LCD are initialised automatically the first time they
0025B8r 2               ; are needed.  Arguments are fully evaluated BEFORE the bus is touched, so a
0025B8r 2               ; syntax error in a line never leaves the bus in the middle of a transfer.
0025B8r 2               ; ============================================================================
0025B8r 2               
0025B8r 2               I2C_BUF_MAX = 32                    ; most data bytes in one I2CWRITE
0025B8r 2               EH_ERR_I2C  = $24                   ; error code: "I2C Error" (see LAB_BAER in basic.s)
0025B8r 2               
0025B8r 2               .segment "BIOSVARS"
00000Fr 2  xx           i2c_n:      .res 1                  ; data bytes collected for I2CWRITE
000010r 2  xx           i2c_idx:    .res 1                  ; index while sending them
000011r 2  xx xx xx xx  i2c_buf:    .res I2C_BUF_MAX        ; the data bytes
000015r 2  xx xx xx xx  
000019r 2  xx xx xx xx  
000031r 2  xx           lcd_tmp:    .res 1                  ; argument scratch (LCDCMD / LCDPRINT)
000032r 2  xx           lcd_row:    .res 1
000033r 2               
000033r 2               .segment "BIOS"
0025B8r 2               
0025B8r 2               ; ----------------------------------------------------------------------------
0025B8r 2               ; I2C_BOOT - called from RESET: nothing is initialised yet
0025B8r 2               ; ----------------------------------------------------------------------------
0025B8r 2               I2C_BOOT:
0025B8r 2  A9 00                lda     #0
0025BAr 2  8D rr rr             sta     pcf_ready
0025BDr 2  8D rr rr             sta     lcd_ready
0025C0r 2  8D rr rr             sta     i2c_err
0025C3r 2  A9 40                lda     #MCP_ADDR_W
0025C5r 2  8D rr rr             sta     lcd_addr            ; default LCD address
0025C8r 2  A9 00                lda     #0
0025CAr 2  8D rr rr             sta     lcd_type            ; MCP23008
0025CDr 2  60                   rts
0025CEr 2               
0025CEr 2               ; ----------------------------------------------------------------------------
0025CEr 2               ; common helpers
0025CEr 2               ; ----------------------------------------------------------------------------
0025CEr 2               BI_ERR:                             ; raise "I2C Error" (never returns)
0025CEr 2  A2 24                ldx     #EH_ERR_I2C
0025D0r 2  4C rr rr             jmp     LAB_XERR
0025D3r 2               
0025D3r 2               BI_FC:                              ; raise "Function call Error" (never returns)
0025D3r 2  4C rr rr             jmp     LAB_FCER
0025D6r 2               
0025D6r 2               BI_CHK:                             ; error if the last operation failed
0025D6r 2  AD rr rr             lda     i2c_err
0025D9r 2  D0 F3                bne     BI_ERR
0025DBr 2  60                   rts
0025DCr 2               
0025DCr 2               pcf_ensure:                         ; make sure the PCF8584 is initialised
0025DCr 2  AD rr rr             lda     pcf_ready
0025DFr 2  D0 0A                bne     @ok
0025E1r 2  20 rr rr             jsr     pcf_init
0025E4r 2  B0 E8                bcs     BI_ERR
0025E6r 2  A9 01                lda     #1
0025E8r 2  8D rr rr             sta     pcf_ready
0025EBr 2  60           @ok:    rts
0025ECr 2               
0025ECr 2               lcd_ensure:                         ; make sure PCF8584 and LCD are initialised
0025ECr 2  20 rr rr             jsr     pcf_ensure
0025EFr 2  AD rr rr             lda     lcd_ready
0025F2r 2  D0 14                bne     @ok
0025F4r 2  A9 00                lda     #0
0025F6r 2  8D rr rr             sta     i2c_err
0025F9r 2  20 rr rr             jsr     lcd_init
0025FCr 2  AD rr rr             lda     i2c_err
0025FFr 2  F0 07                beq     @ok
002601r 2  A9 00                lda     #0
002603r 2  8D rr rr             sta     lcd_ready           ; failed: try the whole thing again next time
002606r 2  F0 C6                beq     BI_ERR              ; (always)
002608r 2  A9 00        @ok:    lda     #0
00260Ar 2  8D rr rr             sta     i2c_err             ; start the caller's operation with no error
00260Dr 2  60                   rts
00260Er 2               
00260Er 2               ; ----------------------------------------------------------------------------
00260Er 2               ; I2CINIT
00260Er 2               ; ----------------------------------------------------------------------------
00260Er 2               BI_I2CINIT:
00260Er 2  A9 00                lda     #0
002610r 2  8D rr rr             sta     pcf_ready
002613r 2  4C rr rr             jmp     pcf_ensure
002616r 2               
002616r 2               ; ----------------------------------------------------------------------------
002616r 2               ; I2CWRITE addr, b1 [, b2 ...]
002616r 2               ; ----------------------------------------------------------------------------
002616r 2               BI_I2CWRITE:
002616r 2  20 rr rr             jsr     LAB_GTBY            ; X = 7 bit address
002619r 2  E0 80                cpx     #$80
00261Br 2  B0 B6                bcs     BI_FC
00261Dr 2  8A                   txa
00261Er 2  0A                   asl
00261Fr 2  8D rr rr             sta     i2c_addr            ; address byte, R/W = 0
002622r 2  A9 00                lda     #0
002624r 2  8D rr rr             sta     i2c_n
002627r 2  20 C2 00     @more:  jsr     LAB_GBYT            ; next character
00262Ar 2  C9 2C                cmp     #','
00262Cr 2  D0 17                bne     @send
00262Er 2  20 rr rr             jsr     LAB_1C01            ; step over ","
002631r 2  20 rr rr             jsr     LAB_GTBY            ; X = data byte
002634r 2  AC rr rr             ldy     i2c_n
002637r 2  C0 20                cpy     #I2C_BUF_MAX
002639r 2  B0 98                bcs     BI_FC               ; too many bytes
00263Br 2  8A                   txa
00263Cr 2  99 rr rr             sta     i2c_buf,y
00263Fr 2  EE rr rr             inc     i2c_n
002642r 2  4C rr rr             jmp     @more
002645r 2  20 rr rr     @send:  jsr     pcf_ensure
002648r 2  20 rr rr             jsr     i2c_start
00264Br 2  B0 20                bcs     @fail
00264Dr 2  A9 00                lda     #0
00264Fr 2  8D rr rr             sta     i2c_idx
002652r 2  AD rr rr     @loop:  lda     i2c_idx
002655r 2  CD rr rr             cmp     i2c_n
002658r 2  F0 0F                beq     @done
00265Ar 2  AA                   tax
00265Br 2  BD rr rr             lda     i2c_buf,x
00265Er 2  20 rr rr             jsr     i2c_send
002661r 2  B0 0A                bcs     @fail
002663r 2  EE rr rr             inc     i2c_idx
002666r 2  4C rr rr             jmp     @loop
002669r 2  20 rr rr     @done:  jsr     i2c_stop
00266Cr 2  60                   rts
00266Dr 2  20 rr rr     @fail:  jsr     i2c_stop
002670r 2  4C rr rr             jmp     BI_ERR
002673r 2               
002673r 2               ; ----------------------------------------------------------------------------
002673r 2               ; I2CREAD(addr) - function, FAC1 = address on entry (numeric pre-processing is
002673r 2               ; done by the interpreter, see LAB_FTPL); result in FAC1
002673r 2               ; ----------------------------------------------------------------------------
002673r 2               BI_I2CRD:
002673r 2  20 rr rr             jsr     LAB_F2FX            ; integer part of FAC1 -> Itempl/Itemph
002676r 2  A5 12                lda     Itemph
002678r 2  D0 1D                bne     @fc
00267Ar 2  A5 11                lda     Itempl
00267Cr 2  C9 80                cmp     #$80
00267Er 2  B0 17                bcs     @fc
002680r 2  0A                   asl
002681r 2  09 01                ora     #1                  ; address byte, R/W = 1
002683r 2  8D rr rr             sta     i2c_addr
002686r 2  20 rr rr             jsr     pcf_ensure
002689r 2  20 rr rr             jsr     i2c_read1
00268Cr 2  B0 04                bcs     @none
00268Er 2  A8                   tay                         ; byte -> Y
00268Fr 2  4C rr rr             jmp     LAB_1FD0            ; convert Y to a number in FAC1 and return
002692r 2  A9 FF        @none:  lda     #$FF
002694r 2  4C rr rr             jmp     LAB_27DB            ; save A as signed integer byte: -1
002697r 2  4C rr rr     @fc:    jmp     LAB_FCER
00269Ar 2               
00269Ar 2               ; ----------------------------------------------------------------------------
00269Ar 2               ; LCDINIT
00269Ar 2               ; ----------------------------------------------------------------------------
00269Ar 2               BI_LCDINIT:
00269Ar 2  A9 00                lda     #0
00269Cr 2  8D rr rr             sta     lcd_type            ; default: MCP23008
00269Fr 2  20 C2 00             jsr     LAB_GBYT            ; anything after the keyword?
0026A2r 2  F0 20                beq     @default            ; no: use the default address
0026A4r 2  20 rr rr             jsr     LAB_GTBY            ; X = 7 bit I2C address
0026A7r 2  E0 80                cpx     #$80
0026A9r 2  B0 27                bcs     @fc
0026ABr 2  8A                   txa
0026ACr 2  0A                   asl
0026ADr 2  48                   pha                         ; keep the address byte
0026AEr 2  20 C2 00             jsr     LAB_GBYT            ; optional ", type"
0026B1r 2  F0 0D                beq     @notype
0026B3r 2  20 rr rr             jsr     LAB_1C01            ; scan for ","
0026B6r 2  20 rr rr             jsr     LAB_GTBY            ; X = 0 (MCP23008) or 1 (PCF8574)
0026B9r 2  E0 02                cpx     #2
0026BBr 2  B0 14                bcs     @fc2
0026BDr 2  8E rr rr             stx     lcd_type
0026C0r 2               @notype:
0026C0r 2  68                   pla
0026C1r 2  4C rr rr             jmp     @set
0026C4r 2               @default:
0026C4r 2  A9 40                lda     #MCP_ADDR_W
0026C6r 2  8D rr rr     @set:   sta     lcd_addr
0026C9r 2  A9 00                lda     #0
0026CBr 2  8D rr rr             sta     lcd_ready
0026CEr 2  4C rr rr             jmp     lcd_ensure
0026D1r 2  68           @fc2:   pla
0026D2r 2  4C rr rr     @fc:    jmp     LAB_FCER
0026D5r 2               
0026D5r 2               ; ----------------------------------------------------------------------------
0026D5r 2               ; LCDPRINT [col, row,] s$
0026D5r 2               ; ----------------------------------------------------------------------------
0026D5r 2               BI_LCDPRINT:
0026D5r 2  20 rr rr             jsr     LAB_EVEX            ; the first argument
0026D8r 2  24 5F                bit     Dtypef
0026DAr 2  30 3B                bmi     @str                ; a string: print it where the cursor is
0026DCr 2  20 rr rr             jsr     LAB_EVBY            ; X = column
0026DFr 2  E0 28                cpx     #40
0026E1r 2  B0 4B                bcs     @fc
0026E3r 2  8E rr rr             stx     lcd_tmp
0026E6r 2  20 rr rr             jsr     LAB_1C01            ; ","
0026E9r 2  20 rr rr             jsr     LAB_GTBY            ; X = row
0026ECr 2  E0 04                cpx     #4
0026EEr 2  B0 3E                bcs     @fc
0026F0r 2  BD rr rr             lda     row_tab,x
0026F3r 2  18                   clc
0026F4r 2  6D rr rr             adc     lcd_tmp
0026F7r 2  09 80                ora     #$80                ; "set DDRAM address" command
0026F9r 2  8D rr rr             sta     lcd_tmp
0026FCr 2  20 rr rr             jsr     LAB_1C01            ; ","
0026FFr 2  20 rr rr             jsr     LAB_EVEX            ; the string (arguments all read before
002702r 2  20 rr rr             jsr     LAB_EVST            ; the bus is used)
002705r 2  8D rr rr             sta     lcd_len
002708r 2  20 rr rr             jsr     lcd_ensure
00270Br 2  AD rr rr             lda     lcd_tmp
00270Er 2  20 rr rr             jsr     lcd_cmd             ; the cursor
002711r 2  20 rr rr             jsr     BI_CHK
002714r 2  4C rr rr             jmp     @put
002717r 2  20 rr rr     @str:   jsr     LAB_EVST            ; must be a string (else ?Type mismatch);
00271Ar 2                                                   ; A = length, (ut1_pl) -> characters
00271Ar 2  8D rr rr             sta     lcd_len
00271Dr 2  20 rr rr             jsr     lcd_ensure
002720r 2  A5 71        @put:   lda     ut1_pl
002722r 2  85 rr                sta     strptr
002724r 2  A5 72                lda     ut1_ph
002726r 2  85 rr                sta     strptr+1
002728r 2  20 rr rr             jsr     lcd_putbuf
00272Br 2  4C rr rr             jmp     BI_CHK
00272Er 2  4C rr rr     @fc:    jmp     LAB_FCER
002731r 2               
002731r 2               row_tab:
002731r 2  00 40 14 54          .byte   $00,$40,$14,$54     ; DDRAM start of rows 0-3 (16x2 uses the first two)
002735r 2               
002735r 2               ; ----------------------------------------------------------------------------
002735r 2               ; LCDCMD n
002735r 2               ; ----------------------------------------------------------------------------
002735r 2               BI_LCDCMD:
002735r 2  20 rr rr             jsr     LAB_GTBY            ; X = command byte
002738r 2  8E rr rr             stx     lcd_tmp
00273Br 2  20 rr rr             jsr     lcd_ensure
00273Er 2  AD rr rr             lda     lcd_tmp
002741r 2  20 rr rr             jsr     lcd_cmd
002744r 2  AD rr rr             lda     lcd_tmp
002747r 2  C9 04                cmp     #4                  ; clear / home need ~1.6 ms
002749r 2  B0 05                bcs     @nodly
00274Br 2  A9 03                lda     #3
00274Dr 2  20 rr rr             jsr     delay_ms
002750r 2  4C rr rr     @nodly: jmp     BI_CHK
002753r 2               
002753r 1               .include "basic_ay.s"           ; SOUND, NOTE, NOISE, ENVELOPE, VOICE, QUIET, AYREG, AYREAD(, SAY
002753r 2               ; ============================================================================
002753r 2               ; basic_ay.s - EhBASIC sound statements: the AY-3-8910 sound card ($7F22
002753r 2               ;              register number, $7F23 data; 2 MHz chip clock), or the ESP32_VGA
002753r 2               ;              card's 4-voice synthesizer (SND_DEV in config.inc), plus SAY
002753r 2               ;              for the SPO256 speech chip and a sound API for programs.
002753r 2               ;
002753r 2               ; BASIC KEYWORDS (their tokens follow I2CREAD( in basic.s, after all of
002753r 2               ; EhBASIC's own, so programs SAVEd before keep their meaning):
002753r 2               ;
002753r 2               ;   SOUND ch, freq, vol [, time]   a tone: channel 0-2 (ESP32: 0-3), frequency
002753r 2               ;                                  in Hz (31 - 65535), volume 0-15 (16: AY: follow
002753r 2               ;                                  the envelope, see ENVELOPE; ESP32: 15)
002753r 2               ;   NOTE ch, n, vol [, time]       the same with a note number: 0 = C1 ...
002753r 2               ;                                  36 = C4 (middle C), 45 = A4 (440 Hz) ... 95 = B8
002753r 2               ;   NOISE ch, period, vol [, time] noise on the channel instead of a tone;
002753r 2               ;                                  period 0-31 (0 = the highest hiss)
002753r 2               ;   ENVELOPE shape, period         AY only: the chip's envelope (one for all
002753r 2               ;                                  channels, used by volume 16): shape 0-15 (8 saw
002753r 2               ;                                  down, 12 saw up, 10 or 14 triangle, 0 one fade
002753r 2               ;                                  out, 13 fade in and hold), period 0-65535 (one
002753r 2               ;                                  ramp lasts period x 128 us)
002753r 2               ;   VOICE ch, wave [, a, d, s, r]  ESP32 only: the voice's waveform for SOUND and
002753r 2               ;                                  NOTE (0 square, 1 triangle, 2 saw, 3 sine,
002753r 2               ;                                  4 noise) and its envelope: attack, decay,
002753r 2               ;                                  sustain level, release, each 0-15
002753r 2               ;   QUIET                          all channels off
002753r 2               ;   AYREG reg, value               AY only: write any register (0-15) as it is.
002753r 2               ;                                  Register 7 bits 6 / 7 make I/O port A / B an
002753r 2               ;                                  output; SOUND, NOISE and QUIET now keep them.
002753r 2               ;   x = AYREAD(reg)                AY only: read a register back: 14 and 15 are
002753r 2               ;                                  the I/O ports A and B
002753r 2               ;   SAY a [, b ...]  /  SAY s$     the SPO256: allophones 0-63, as numbers or as
002753r 2               ;                                  the characters of a string (their codes AND
002753r 2               ;                                  63); a short pause is added at the end.  The
002753r 2               ;                                  program carries on while it speaks.
002753r 2               ;
002753r 2               ; time: in 1/60 s (the VIA's timer interrupt counts it down); 0 or left out =
002753r 2               ; until changed.  With a time, the note stops by itself while BASIC goes on -
002753r 2               ; and a timed SOUND / NOTE / NOISE first waits for the last timed one on its
002753r 2               ; channel to finish, so a tune is just one statement per note:
002753r 2               ;
002753r 2               ;   10 FOR I = 1 TO 8 : READ N : NOTE 0, N, 12, 15 : NEXT
002753r 2               ;   20 DATA 36,38,40,41,43,45,47,48
002753r 2               ;
002753r 2               ; plays a scale, a quarter of a second a note, one channel.  The other
002753r 2               ; channels can play at the same time (their own queue of one).  CTRL-C stops
002753r 2               ; a wait.  Without the timer interrupt (no VIA) a time is ignored.
002753r 2               ;
002753r 2               ; The interrupt writes the sound chip too (to stop a note), so every write
002753r 2               ; here is done with interrupts off.  ESP32: the interrupt then sends an I/O
002753r 2               ; command to the card - machine code that drives the card's I/O channel
002753r 2               ; itself should not run while a timed BASIC note is still playing.
002753r 2               ;
002753r 2               ; SOUND API for programs (jump table, see sbc_api.inc):
002753r 2               ;   SBC_SNDNOTE   A/Y -> 5 bytes: voice, note (0-95), volume (0-16), time
002753r 2               ;                 (16 bit, 1/60 s, 0 = hold).  Doesn't wait.  C=1 = bad values.
002753r 2               ;   SBC_SNDQUIET  everything off
002753r 2               ;   SBC_SNDBUSY   A = voice: C=1 while its timed note is still playing
002753r 2               ;   SBC_AYREAD    X = register -> A          (AY only)
002753r 2               ;   SBC_AYWRITE   X = register, A = value    (AY only; register 7 is tracked)
002753r 2               ; ============================================================================
002753r 2               
002753r 2               AY_ADDR     = $7F22
002753r 2               AY_DATA     = $7F23
002753r 2               AY_FULL     = 125000                ; 2 MHz / 16: the tone period is this / Hz
002753r 2               
002753r 2               .if SND_DEV = SND_ESP
002753r 2               SND_VOICES  = 4
002753r 2               .else
002753r 2               SND_VOICES  = 3
002753r 2               .endif
002753r 2               
002753r 2               .segment "BIOSVARS"
000033r 2  xx xx xx xx  snd_tl:     .res 4                  ; each channel: the time left (1/60 s)
000037r 2  xx xx xx xx  snd_th:     .res 4
00003Br 2  xx           snd_mix:    .res 1                  ; AY: the mixer (register 7) as last written
00003Cr 2  xx           snd_ch:     .res 1                  ; the statement's arguments
00003Dr 2  xx           snd_vol:    .res 1
00003Er 2  xx           snd_pl:     .res 1                  ;  the period (AY), Hz or note (ESP32)
00003Fr 2  xx           snd_ph:     .res 1
000040r 2  xx           snd_dl:     .res 1                  ;  the time
000041r 2  xx           snd_dh:     .res 1
000042r 2  xx xx xx     snd_q:      .res 3                  ; (the division)
000045r 2  xx xx        snd_r:      .res 2
000047r 2               
000047r 2               .segment "DRVVARS"
0001D5r 2  xx xx xx xx  snd_wave:   .res 4                  ; ESP32: each voice's waveform (VOICE)
0001D9r 2  xx           snd_kind:   .res 1                  ; ESP32: 0 a tone in Hz, 1 a note, 2 noise
0001DAr 2               
0001DAr 2               .segment "BIOS"
002753r 2               
002753r 2               ; ----------------------------------------------------------------------------
002753r 2               ; SND_BOOT - called from RESET: all quiet
002753r 2               ; ----------------------------------------------------------------------------
002753r 2               SND_BOOT:
002753r 2               AY_BOOT:
002753r 2               .if SND_DEV = SND_ESP
002753r 2                       ldx     #3
002753r 2                       lda     #WAVE_SQUARE
002753r 2               @w:     sta     snd_wave,x
002753r 2                       dex
002753r 2                       bpl     @w
002753r 2               .endif
002753r 2  A9 00                lda     #0
002755r 2  8D rr rr             sta     snd_mix             ; (AY: the I/O ports inputs)
002758r 2                       ; (on into BI_QUIET)
002758r 2               
002758r 2               ; ----------------------------------------------------------------------------
002758r 2               ; QUIET  (also SBC_SNDQUIET)
002758r 2               ; ----------------------------------------------------------------------------
002758r 2               BI_QUIET:
002758r 2  08                   php
002759r 2  78                   sei
00275Ar 2  A9 00                lda     #0
00275Cr 2  A2 03                ldx     #3
00275Er 2  9D rr rr     @c:     sta     snd_tl,x            ; no notes timed
002761r 2  9D rr rr             sta     snd_th,x
002764r 2  CA                   dex
002765r 2  10 F7                bpl     @c
002767r 2               .if SND_DEV = SND_AY
002767r 2  A2 08                ldx     #8                  ; volumes 0
002769r 2  20 rr rr     @v:     jsr     ay_w0
00276Cr 2  E8                   inx
00276Dr 2  E0 0B                cpx     #11
00276Fr 2  D0 F8                bne     @v
002771r 2  AD rr rr             lda     snd_mix             ; mixer: all off, the I/O port bits kept
002774r 2  09 3F                ora     #$3F
002776r 2  8D rr rr             sta     snd_mix
002779r 2  A2 07                ldx     #7
00277Br 2  20 rr rr             jsr     ay_w0
00277Er 2               .elseif SND_DEV = SND_ESP
00277Er 2                       bit     esp_ok
00277Er 2                       bpl     @x
00277Er 2                       lda     #IO_SNDSTOP
00277Er 2                       sta     VGA_IOCMD
00277Er 2               @x:
00277Er 2               .endif
00277Er 2  28                   plp
00277Fr 2  60                   rts
002780r 2               
002780r 2               .if SND_DEV = SND_AY
002780r 2               ; register X = A (interrupts already off; keeps A, X)
002780r 2  8E 22 7F     ay_w0:  stx     AY_ADDR
002783r 2  8D 23 7F             sta     AY_DATA
002786r 2  60                   rts
002787r 2               
002787r 2               ; register X = A with interrupts off (keeps A, X)
002787r 2  08           ay_w:   php
002788r 2  78                   sei
002789r 2  8E 22 7F             stx     AY_ADDR
00278Cr 2  8D 23 7F             sta     AY_DATA
00278Fr 2  28                   plp
002790r 2  60                   rts
002791r 2               .endif
002791r 2               
002791r 2               ; ----------------------------------------------------------------------------
002791r 2               ; SND_TICK - from the timer interrupt (60 a second): a timed note that runs
002791r 2               ; out is made silent (AY: its volume 0; ESP32: its gate off)
002791r 2               ; ----------------------------------------------------------------------------
002791r 2               SND_TICK:
002791r 2  A2 02                ldx     #(SND_VOICES - 1)
002793r 2  BD rr rr     @l:     lda     snd_tl,x
002796r 2  1D rr rr             ora     snd_th,x
002799r 2  F0 1F                beq     @n                  ; (not timed)
00279Br 2  BD rr rr             lda     snd_tl,x
00279Er 2  D0 03                bne     :+
0027A0r 2  DE rr rr             dec     snd_th,x
0027A3r 2  DE rr rr     :       dec     snd_tl,x
0027A6r 2  BD rr rr             lda     snd_tl,x
0027A9r 2  1D rr rr             ora     snd_th,x
0027ACr 2  D0 0C                bne     @n
0027AEr 2               .if SND_DEV = SND_AY
0027AEr 2  8A                   txa                         ; run out: its volume 0
0027AFr 2  18                   clc
0027B0r 2  69 08                adc     #8
0027B2r 2  8D 22 7F             sta     AY_ADDR
0027B5r 2  A9 00                lda     #0
0027B7r 2  8D 23 7F             sta     AY_DATA
0027BAr 2               .elseif SND_DEV = SND_ESP
0027BAr 2                       bit     esp_ok              ; run out: its gate off (release)
0027BAr 2                       bpl     @n
0027BAr 2                       lda     #IO_SNDGATE
0027BAr 2                       sta     VGA_IOCMD
0027BAr 2                       stx     VGA_IODATA
0027BAr 2                       lda     #0
0027BAr 2                       sta     VGA_IODATA
0027BAr 2               .endif
0027BAr 2  CA           @n:     dex
0027BBr 2  10 D6                bpl     @l
0027BDr 2  60                   rts
0027BEr 2               
0027BEr 2               ; ----------------------------------------------------------------------------
0027BEr 2               ; the arguments
0027BEr 2               ; ----------------------------------------------------------------------------
0027BEr 2  4C rr rr     snd_fc: jmp     LAB_FCER            ; "Function call Error"
0027C1r 2               
0027C1r 2               ; the channel (0 - SND_VOICES-1) into snd_ch
0027C1r 2               snd_getch:
0027C1r 2               .if SND_DEV = SND_NONE
0027C1r 2                       jmp     snd_fc              ; no sound device in this ROM
0027C1r 2               .else
0027C1r 2  20 rr rr             jsr     LAB_GTBY
0027C4r 2  E0 03                cpx     #SND_VOICES
0027C6r 2  B0 F6                bcs     snd_fc
0027C8r 2  8E rr rr             stx     snd_ch
0027CBr 2  60                   rts
0027CCr 2               .endif
0027CCr 2               
0027CCr 2               ; ", n" (0-65535) into Itempl / Itemph
0027CCr 2               snd_getw:
0027CCr 2  20 rr rr             jsr     LAB_1C01            ; ","
0027CFr 2  20 rr rr             jsr     LAB_EVNM            ; a number
0027D2r 2  4C rr rr             jmp     LAB_F2FX            ; as an integer 0-65535
0027D5r 2               
0027D5r 2               ; ", vol [, time]": the volume (0-16) and the time (0: none)
0027D5r 2               snd_getvt:
0027D5r 2  20 rr rr             jsr     LAB_1C01
0027D8r 2  20 rr rr             jsr     LAB_GTBY
0027DBr 2  E0 11                cpx     #17
0027DDr 2  B0 DF                bcs     snd_fc
0027DFr 2  8E rr rr             stx     snd_vol
0027E2r 2  A9 00                lda     #0
0027E4r 2  8D rr rr             sta     snd_dl
0027E7r 2  8D rr rr             sta     snd_dh
0027EAr 2  20 C2 00             jsr     LAB_GBYT            ; ", time"?
0027EDr 2  C9 2C                cmp     #','
0027EFr 2  D0 0D                bne     @r
0027F1r 2  20 rr rr             jsr     snd_getw
0027F4r 2  A5 11                lda     Itempl
0027F6r 2  8D rr rr             sta     snd_dl
0027F9r 2  A5 12                lda     Itemph
0027FBr 2  8D rr rr             sta     snd_dh
0027FEr 2  60           @r:     rts
0027FFr 2               
0027FFr 2               ; ----------------------------------------------------------------------------
0027FFr 2               ; SOUND ch, freq, vol [, time]
0027FFr 2               ; ----------------------------------------------------------------------------
0027FFr 2               BI_SOUND:
0027FFr 2  20 rr rr             jsr     snd_getch
002802r 2  20 rr rr             jsr     snd_getw            ; the frequency
002805r 2  A5 11                lda     Itempl
002807r 2  05 12                ora     Itemph
002809r 2  F0 B3                beq     snd_fc              ; (0 Hz)
00280Br 2               .if SND_DEV = SND_ESP
00280Br 2                       lda     Itempl              ; the card takes Hz
00280Br 2                       sta     snd_pl
00280Br 2                       lda     Itemph
00280Br 2                       sta     snd_ph
00280Br 2                       lda     #0
00280Br 2                       sta     snd_kind
00280Br 2                       jsr     snd_getvt
00280Br 2                       jmp     snd_play
00280Br 2               .else
00280Br 2  A9 48                lda     #<AY_FULL           ; period = 125000 / Hz
00280Dr 2  8D rr rr             sta     snd_q
002810r 2  A9 E8                lda     #>AY_FULL
002812r 2  8D rr rr             sta     snd_q+1
002815r 2  A9 01                lda     #^AY_FULL
002817r 2  8D rr rr             sta     snd_q+2
00281Ar 2  20 rr rr             jsr     snd_div
00281Dr 2  AD rr rr             lda     snd_q+2             ; more than 4095 (under 31 Hz): 4095
002820r 2  D0 1A                bne     @max
002822r 2  AD rr rr             lda     snd_q+1
002825r 2  C9 10                cmp     #$10
002827r 2  B0 13                bcs     @max
002829r 2  8D rr rr             sta     snd_ph
00282Cr 2  AD rr rr             lda     snd_q
00282Fr 2  8D rr rr             sta     snd_pl
002832r 2  0D rr rr             ora     snd_ph
002835r 2  D0 0F                bne     @ok
002837r 2  EE rr rr             inc     snd_pl              ; (0: 1)
00283Ar 2  D0 0A                bne     @ok
00283Cr 2  A9 FF        @max:   lda     #$FF
00283Er 2  8D rr rr             sta     snd_pl
002841r 2  A9 0F                lda     #$0F
002843r 2  8D rr rr             sta     snd_ph
002846r 2  20 rr rr     @ok:    jsr     snd_getvt
002849r 2  4C rr rr             jmp     snd_tone
00284Cr 2               .endif
00284Cr 2               
00284Cr 2               ; snd_q (24 bits) = snd_q / Itempl,h (16 bits)
00284Cr 2               snd_div:
00284Cr 2  A9 00                lda     #0
00284Er 2  8D rr rr             sta     snd_r
002851r 2  8D rr rr             sta     snd_r+1
002854r 2  A2 18                ldx     #24
002856r 2  0E rr rr     @l:     asl     snd_q
002859r 2  2E rr rr             rol     snd_q+1
00285Cr 2  2E rr rr             rol     snd_q+2
00285Fr 2  2E rr rr             rol     snd_r
002862r 2  2E rr rr             rol     snd_r+1
002865r 2  B0 10                bcs     @s                  ; (17 bits: more than the divisor)
002867r 2  AD rr rr             lda     snd_r
00286Ar 2  38                   sec
00286Br 2  E5 11                sbc     Itempl
00286Dr 2  A8                   tay
00286Er 2  AD rr rr             lda     snd_r+1
002871r 2  E5 12                sbc     Itemph
002873r 2  90 16                bcc     @n
002875r 2  B0 0B                bcs     @k
002877r 2  AD rr rr     @s:     lda     snd_r
00287Ar 2  E5 11                sbc     Itempl              ; (carry set)
00287Cr 2  A8                   tay
00287Dr 2  AD rr rr             lda     snd_r+1
002880r 2  E5 12                sbc     Itemph
002882r 2  8D rr rr     @k:     sta     snd_r+1
002885r 2  8C rr rr             sty     snd_r
002888r 2  EE rr rr             inc     snd_q
00288Br 2  CA           @n:     dex
00288Cr 2  D0 C8                bne     @l
00288Er 2  60                   rts
00288Fr 2               
00288Fr 2               ; ----------------------------------------------------------------------------
00288Fr 2               ; NOTE ch, n, vol [, time]
00288Fr 2               ; ----------------------------------------------------------------------------
00288Fr 2               BI_NOTE:
00288Fr 2  20 rr rr             jsr     snd_getch
002892r 2  20 rr rr             jsr     LAB_1C01
002895r 2  20 rr rr             jsr     LAB_GTBY            ; the note
002898r 2  E0 60                cpx     #96
00289Ar 2  90 03                bcc     :+
00289Cr 2  4C rr rr             jmp     LAB_FCER
00289Fr 2               :
00289Fr 2               .if SND_DEV = SND_ESP
00289Fr 2                       stx     snd_pl
00289Fr 2                       lda     #1
00289Fr 2                       sta     snd_kind
00289Fr 2                       jsr     snd_getvt
00289Fr 2                       jmp     snd_play
00289Fr 2               .else
00289Fr 2  BD rr rr             lda     snd_nlo,x
0028A2r 2  8D rr rr             sta     snd_pl
0028A5r 2  BD rr rr             lda     snd_nhi,x
0028A8r 2  8D rr rr             sta     snd_ph
0028ABr 2  20 rr rr             jsr     snd_getvt
0028AEr 2  4C rr rr             jmp     snd_tone
0028B1r 2               .endif
0028B1r 2               
0028B1r 2               ; ----------------------------------------------------------------------------
0028B1r 2               ; NOISE ch, period, vol [, time]
0028B1r 2               ; ----------------------------------------------------------------------------
0028B1r 2               BI_NOISE:
0028B1r 2  20 rr rr             jsr     snd_getch
0028B4r 2  20 rr rr             jsr     LAB_1C01
0028B7r 2  20 rr rr             jsr     LAB_GTBY            ; the noise period
0028BAr 2  E0 20                cpx     #32
0028BCr 2  90 03                bcc     :+
0028BEr 2  4C rr rr             jmp     LAB_FCER
0028C1r 2               :
0028C1r 2               .if SND_DEV = SND_ESP
0028C1r 2                       txa                         ; the AY's noise rate: 125000 / period Hz
0028C1r 2                       bne     :+                  ; (period 0: as 1)
0028C1r 2                       lda     #1
0028C1r 2               :       sta     Itempl
0028C1r 2                       lda     #0
0028C1r 2                       sta     Itemph
0028C1r 2                       lda     #<AY_FULL
0028C1r 2                       sta     snd_q
0028C1r 2                       lda     #>AY_FULL
0028C1r 2                       sta     snd_q+1
0028C1r 2                       lda     #^AY_FULL
0028C1r 2                       sta     snd_q+2
0028C1r 2                       jsr     snd_div
0028C1r 2                       lda     snd_q+2             ; above 31250 Hz (the card's sample rate):
0028C1r 2                       bne     @max                ; 31250
0028C1r 2                       lda     snd_q+1
0028C1r 2                       cmp     #>31250
0028C1r 2                       bcc     @ok
0028C1r 2                       bne     @max
0028C1r 2                       lda     snd_q
0028C1r 2                       cmp     #<31250
0028C1r 2                       bcc     @ok
0028C1r 2               @max:   lda     #<31250
0028C1r 2                       sta     snd_q
0028C1r 2                       lda     #>31250
0028C1r 2                       sta     snd_q+1
0028C1r 2               @ok:    lda     snd_q
0028C1r 2                       sta     snd_pl
0028C1r 2                       lda     snd_q+1
0028C1r 2                       sta     snd_ph
0028C1r 2                       lda     #2
0028C1r 2                       sta     snd_kind
0028C1r 2                       jsr     snd_getvt
0028C1r 2                       jmp     snd_play
0028C1r 2               .else
0028C1r 2  8E rr rr             stx     snd_pl
0028C4r 2  20 rr rr             jsr     snd_getvt
0028C7r 2  20 rr rr             jsr     snd_wait
0028CAr 2  08                   php
0028CBr 2  78                   sei
0028CCr 2  AD rr rr             lda     snd_pl
0028CFr 2  A2 06                ldx     #6
0028D1r 2  20 rr rr             jsr     ay_w0
0028D4r 2  AE rr rr             ldx     snd_ch              ; mixer: its noise on, its tone off
0028D7r 2  AD rr rr             lda     snd_mix
0028DAr 2  3D rr rr             and     noise_on,x
0028DDr 2  1D rr rr             ora     tone_off,x
0028E0r 2  4C rr rr             jmp     snd_go
0028E3r 2               .endif
0028E3r 2               
0028E3r 2               ; ----------------------------------------------------------------------------
0028E3r 2               ; snd_ctime - no timer interrupt: no times at all
0028E3r 2               ; ----------------------------------------------------------------------------
0028E3r 2               snd_ctime:
0028E3r 2  AD 0E 7F             lda     $7F0E               ; the VIA's timer 1 interrupt on?
0028E6r 2  29 40                and     #$40
0028E8r 2  D0 06                bne     @r
0028EAr 2  8D rr rr             sta     snd_dl
0028EDr 2  8D rr rr             sta     snd_dh
0028F0r 2  60           @r:     rts
0028F1r 2               
0028F1r 2               ; a timed note: wait for the last timed one on the channel to run out (only
0028F1r 2               ; when the timer interrupt is on; CTRL-C stops the wait)
0028F1r 2               snd_wait:
0028F1r 2  20 rr rr             jsr     snd_ctime
0028F4r 2  AD rr rr             lda     snd_dl
0028F7r 2  0D rr rr             ora     snd_dh
0028FAr 2  F0 11                beq     @r                  ; (this one isn't timed)
0028FCr 2  AE rr rr     @w:     ldx     snd_ch
0028FFr 2  BD rr rr             lda     snd_tl,x
002902r 2  1D rr rr             ora     snd_th,x
002905r 2  F0 06                beq     @r
002907r 2  20 rr rr             jsr     LAB_1629            ; (CTRL-C)
00290Ar 2  4C rr rr             jmp     @w
00290Dr 2  60           @r:     rts
00290Er 2               
00290Er 2               .if SND_DEV = SND_AY
00290Er 2               ; ----------------------------------------------------------------------------
00290Er 2               ; AY: the tone (snd_pl/ph) on channel snd_ch at snd_vol for snd_dl/dh
00290Er 2               ; ----------------------------------------------------------------------------
00290Er 2               snd_tone:
00290Er 2  20 rr rr             jsr     snd_wait
002911r 2               snd_tone_nw:
002911r 2  20 rr rr             jsr     snd_ctime
002914r 2  08                   php
002915r 2  78                   sei
002916r 2  AD rr rr             lda     snd_ch              ; the period
002919r 2  0A                   asl
00291Ar 2  AA                   tax
00291Br 2  AD rr rr             lda     snd_pl
00291Er 2  20 rr rr             jsr     ay_w0
002921r 2  E8                   inx
002922r 2  AD rr rr             lda     snd_ph
002925r 2  20 rr rr             jsr     ay_w0
002928r 2  AE rr rr             ldx     snd_ch              ; mixer: its tone on, its noise off
00292Br 2  AD rr rr             lda     snd_mix
00292Er 2  3D rr rr             and     tone_on,x
002931r 2  1D rr rr             ora     noise_off,x
002934r 2                       ; (on into snd_go)
002934r 2               
002934r 2               ; mixer = A (the I/O port bits 6-7 as they were), then the volume and the
002934r 2               ; time (interrupts off; ends with plp)
002934r 2  8D rr rr     snd_go: sta     snd_mix
002937r 2  A2 07                ldx     #7
002939r 2  20 rr rr             jsr     ay_w0
00293Cr 2  AE rr rr             ldx     snd_ch
00293Fr 2  AD rr rr             lda     snd_dl              ; the time, then the volume
002942r 2  9D rr rr             sta     snd_tl,x
002945r 2  AD rr rr             lda     snd_dh
002948r 2  9D rr rr             sta     snd_th,x
00294Br 2  8A                   txa
00294Cr 2  18                   clc
00294Dr 2  69 08                adc     #8
00294Fr 2  AA                   tax
002950r 2  AD rr rr             lda     snd_vol
002953r 2  20 rr rr             jsr     ay_w0
002956r 2  28                   plp
002957r 2  60                   rts
002958r 2               
002958r 2  FE FD FB     tone_on:    .byte   $FE, $FD, $FB   ; (and: its bit 0)
00295Br 2  01 02 04     tone_off:   .byte   $01, $02, $04   ; (or: its bit 1)
00295Er 2  F7 EF DF     noise_on:   .byte   $F7, $EF, $DF
002961r 2  08 10 20     noise_off:  .byte   $08, $10, $20
002964r 2               .endif
002964r 2               
002964r 2               .if SND_DEV = SND_ESP
002964r 2               ; ----------------------------------------------------------------------------
002964r 2               ; ESP32: play snd_kind (0 tone snd_pl/ph Hz, 1 note snd_pl, 2 noise snd_pl/ph
002964r 2               ; Hz) on voice snd_ch at snd_vol for snd_dl/dh
002964r 2               ; ----------------------------------------------------------------------------
002964r 2               snd_play:
002964r 2                       jsr     snd_wait
002964r 2               snd_play_nw:
002964r 2                       jsr     snd_ctime
002964r 2                       bit     esp_ok
002964r 2                       bmi     :+
002964r 2                       rts
002964r 2               :       php
002964r 2                       sei
002964r 2                       ldx     snd_ch
002964r 2                       lda     #IO_SNDWAVE         ; the waveform
002964r 2                       sta     VGA_IOCMD
002964r 2                       stx     VGA_IODATA
002964r 2                       lda     #WAVE_NOISE
002964r 2                       ldy     snd_kind
002964r 2                       cpy     #2
002964r 2                       beq     :+
002964r 2                       lda     snd_wave,x
002964r 2               :       sta     VGA_IODATA
002964r 2                       lda     #0                  ; (duty: the default, 50 %)
002964r 2                       sta     VGA_IODATA
002964r 2                       lda     #IO_SNDVOL          ; the volume 0-15 -> 0-255
002964r 2                       sta     VGA_IOCMD
002964r 2                       stx     VGA_IODATA
002964r 2                       lda     snd_vol
002964r 2                       cmp     #16
002964r 2                       bcc     :+
002964r 2                       lda     #15
002964r 2               :       sta     snd_q
002964r 2                       asl     a
002964r 2                       asl     a
002964r 2                       asl     a
002964r 2                       asl     a
002964r 2                       ora     snd_q
002964r 2                       sta     VGA_IODATA
002964r 2                       lda     snd_kind
002964r 2                       cmp     #1
002964r 2                       bne     @tone
002964r 2                       lda     #IO_SNDNOTE         ; a note: MIDI = n + 24 (36 = C4 = 60),
002964r 2                       sta     VGA_IOCMD           ; held (the tick ends a timed one)
002964r 2                       stx     VGA_IODATA
002964r 2                       lda     snd_pl
002964r 2                       clc
002964r 2                       adc     #24
002964r 2                       sta     VGA_IODATA
002964r 2                       lda     #0
002964r 2                       sta     VGA_IODATA
002964r 2                       jmp     @time
002964r 2               @tone:  lda     #IO_SNDFREQ         ; a frequency, then the gate on
002964r 2                       sta     VGA_IOCMD
002964r 2                       stx     VGA_IODATA
002964r 2                       lda     snd_pl
002964r 2                       sta     VGA_IODATA
002964r 2                       lda     snd_ph
002964r 2                       sta     VGA_IODATA
002964r 2                       lda     #IO_SNDGATE
002964r 2                       sta     VGA_IOCMD
002964r 2                       stx     VGA_IODATA
002964r 2                       lda     #1
002964r 2                       sta     VGA_IODATA
002964r 2               @time:  lda     snd_dl
002964r 2                       sta     snd_tl,x
002964r 2                       lda     snd_dh
002964r 2                       sta     snd_th,x
002964r 2                       plp
002964r 2                       rts
002964r 2               .endif
002964r 2               
002964r 2               ; ----------------------------------------------------------------------------
002964r 2               ; ENVELOPE shape, period   (AY)
002964r 2               ; ----------------------------------------------------------------------------
002964r 2               BI_ENVELOPE:
002964r 2               .if SND_DEV = SND_AY
002964r 2  20 rr rr             jsr     LAB_GTBY            ; the shape
002967r 2  E0 10                cpx     #16
002969r 2  B0 1A                bcs     @fc
00296Br 2  8E rr rr             stx     snd_vol
00296Er 2  20 rr rr             jsr     snd_getw            ; the period
002971r 2  A5 11                lda     Itempl
002973r 2  A2 0B                ldx     #11
002975r 2  20 rr rr             jsr     ay_w
002978r 2  A5 12                lda     Itemph
00297Ar 2  E8                   inx
00297Br 2  20 rr rr             jsr     ay_w
00297Er 2  AD rr rr             lda     snd_vol             ; the shape last: it starts the envelope
002981r 2  E8                   inx
002982r 2  4C rr rr             jmp     ay_w
002985r 2               @fc:
002985r 2               .endif
002985r 2  4C rr rr             jmp     LAB_FCER
002988r 2               
002988r 2               ; ----------------------------------------------------------------------------
002988r 2               ; VOICE ch, wave [, a, d, s, r]   (ESP32)
002988r 2               ; ----------------------------------------------------------------------------
002988r 2               BI_VOICE:
002988r 2               .if SND_DEV = SND_ESP
002988r 2                       jsr     snd_getch
002988r 2                       jsr     LAB_1C01
002988r 2                       jsr     LAB_GTBY            ; the waveform
002988r 2                       cpx     #5
002988r 2                       bcs     @fc
002988r 2                       txa
002988r 2                       ldx     snd_ch
002988r 2                       sta     snd_wave,x
002988r 2                       jsr     LAB_GBYT            ; an envelope?
002988r 2                       cmp     #','
002988r 2                       bne     @x
002988r 2                       ldx     #0
002988r 2               @e:     stx     snd_vol             ; (the index)
002988r 2                       jsr     LAB_1C01
002988r 2                       jsr     LAB_GTBY            ; a, d, s, r: 0-15
002988r 2                       cpx     #16
002988r 2                       bcs     @fc
002988r 2                       txa
002988r 2                       ldx     snd_vol
002988r 2                       sta     snd_q,x             ; (snd_q, snd_q+1, snd_q+2, snd_r)
002988r 2                       inx
002988r 2                       cpx     #4
002988r 2                       bne     @e
002988r 2                       bit     esp_ok
002988r 2                       bpl     @x
002988r 2                       php
002988r 2                       sei
002988r 2                       lda     #IO_SNDENV
002988r 2                       sta     VGA_IOCMD
002988r 2                       lda     snd_ch
002988r 2                       sta     VGA_IODATA
002988r 2                       ldx     #0
002988r 2               @s:     lda     snd_q,x
002988r 2                       sta     VGA_IODATA
002988r 2                       inx
002988r 2                       cpx     #4
002988r 2                       bne     @s
002988r 2                       plp
002988r 2               @x:     rts
002988r 2               @fc:
002988r 2               .endif
002988r 2  4C rr rr             jmp     LAB_FCER
00298Br 2               
00298Br 2               ; ----------------------------------------------------------------------------
00298Br 2               ; AYREG reg, value   (AY)
00298Br 2               ; ----------------------------------------------------------------------------
00298Br 2               BI_AYREG:
00298Br 2               .if SND_DEV = SND_AY
00298Br 2  20 rr rr             jsr     LAB_GTBY            ; the register
00298Er 2  E0 10                cpx     #16
002990r 2  B0 10                bcs     @fc
002992r 2  8E rr rr             stx     snd_ch
002995r 2  20 rr rr             jsr     LAB_1C01
002998r 2  20 rr rr             jsr     LAB_GTBY            ; the value
00299Br 2  8A                   txa
00299Cr 2  AE rr rr             ldx     snd_ch
00299Fr 2  4C rr rr             jmp     SND_AYWRITE
0029A2r 2               @fc:
0029A2r 2               .endif
0029A2r 2  4C rr rr             jmp     LAB_FCER
0029A5r 2               
0029A5r 2               ; ----------------------------------------------------------------------------
0029A5r 2               ; AYREAD(reg) - function: FAC1 = the register number; the value in FAC1  (AY)
0029A5r 2               ; ----------------------------------------------------------------------------
0029A5r 2               BI_AYRD:
0029A5r 2               .if SND_DEV = SND_AY
0029A5r 2  20 rr rr             jsr     LAB_F2FX
0029A8r 2  A5 12                lda     Itemph
0029AAr 2  D0 0D                bne     @fc
0029ACr 2  A6 11                ldx     Itempl
0029AEr 2  E0 10                cpx     #16
0029B0r 2  B0 07                bcs     @fc
0029B2r 2  20 rr rr             jsr     SND_AYREAD
0029B5r 2  A8                   tay
0029B6r 2  4C rr rr             jmp     LAB_1FD0            ; Y as a number in FAC1
0029B9r 2               @fc:
0029B9r 2               .endif
0029B9r 2  4C rr rr             jmp     LAB_FCER
0029BCr 2               
0029BCr 2               ; ----------------------------------------------------------------------------
0029BCr 2               ; SAY a [, b ...]  /  SAY s$
0029BCr 2               ; ----------------------------------------------------------------------------
0029BCr 2               BI_SAY:
0029BCr 2               .if HAS_SPO
0029BCr 2  20 rr rr     @next:  jsr     LAB_EVEX
0029BFr 2  24 5F                bit     Dtypef
0029C1r 2  30 0E                bmi     @str
0029C3r 2  20 rr rr             jsr     LAB_EVBY            ; X = the allophone
0029C6r 2  E0 40                cpx     #64
0029C8r 2  B0 2D                bcs     @fc
0029CAr 2  8A                   txa
0029CBr 2  20 rr rr             jsr     SPO_PUT
0029CEr 2  4C rr rr             jmp     @more
0029D1r 2  20 rr rr     @str:   jsr     LAB_EVST            ; A = length, (ut1_pl) = the characters
0029D4r 2  AA                   tax
0029D5r 2  F0 0B                beq     @more
0029D7r 2  A0 00                ldy     #0
0029D9r 2  B1 71        @c:     lda     (ut1_pl),y
0029DBr 2  20 rr rr             jsr     SPO_PUT             ; (keeps X and Y; uses the low 6 bits)
0029DEr 2  C8                   iny
0029DFr 2  CA                   dex
0029E0r 2  D0 F7                bne     @c
0029E2r 2  20 C2 00     @more:  jsr     LAB_GBYT
0029E5r 2  C9 2C                cmp     #','
0029E7r 2  D0 06                bne     @end
0029E9r 2  20 BC 00             jsr     LAB_IGBY
0029ECr 2  4C rr rr             jmp     @next
0029EFr 2  A9 03        @end:   lda     #SPO_PAUSE
0029F1r 2  20 rr rr             jsr     SPO_PUT
0029F4r 2  4C rr rr             jmp     SPO_DRAIN           ; (no VIA: speak it all now)
0029F7r 2               @fc:
0029F7r 2               .endif
0029F7r 2  4C rr rr             jmp     LAB_FCER
0029FAr 2               
0029FAr 2               ; ============================================================================
0029FAr 2               ; The sound API (jump table)
0029FAr 2               ; ============================================================================
0029FAr 2               
0029FAr 2               ; SND_API_NOTE - A/Y -> voice, note, volume, time lo, time hi.  C=1 = bad.
0029FAr 2               SND_API_NOTE:
0029FAr 2               .if SND_DEV <> SND_NONE
0029FAr 2  85 rr                sta     con_ptr
0029FCr 2  84 rr                sty     con_ptr+1
0029FEr 2  A0 00                ldy     #0
002A00r 2  B1 rr                lda     (con_ptr),y         ; voice
002A02r 2  C9 03                cmp     #SND_VOICES
002A04r 2  B0 32                bcs     @bad
002A06r 2  8D rr rr             sta     snd_ch
002A09r 2  C8                   iny
002A0Ar 2  B1 rr                lda     (con_ptr),y         ; note
002A0Cr 2  C9 60                cmp     #96
002A0Er 2  B0 28                bcs     @bad
002A10r 2  AA                   tax
002A11r 2  C8                   iny
002A12r 2  B1 rr                lda     (con_ptr),y         ; volume
002A14r 2  C9 11                cmp     #17
002A16r 2  B0 20                bcs     @bad
002A18r 2  8D rr rr             sta     snd_vol
002A1Br 2  C8                   iny
002A1Cr 2  B1 rr                lda     (con_ptr),y         ; time
002A1Er 2  8D rr rr             sta     snd_dl
002A21r 2  C8                   iny
002A22r 2  B1 rr                lda     (con_ptr),y
002A24r 2  8D rr rr             sta     snd_dh
002A27r 2                 .if SND_DEV = SND_AY
002A27r 2  BD rr rr             lda     snd_nlo,x
002A2Ar 2  8D rr rr             sta     snd_pl
002A2Dr 2  BD rr rr             lda     snd_nhi,x
002A30r 2  8D rr rr             sta     snd_ph
002A33r 2  20 rr rr             jsr     snd_tone_nw
002A36r 2                 .else
002A36r 2                       stx     snd_pl
002A36r 2                       lda     #1
002A36r 2                       sta     snd_kind
002A36r 2                       jsr     snd_play_nw
002A36r 2                 .endif
002A36r 2  18                   clc
002A37r 2  60                   rts
002A38r 2               .endif
002A38r 2  38           @bad:   sec
002A39r 2  60                   rts
002A3Ar 2               
002A3Ar 2               ; SND_API_BUSY - A = voice: C=1 while its timed note is still playing
002A3Ar 2               SND_API_BUSY:
002A3Ar 2  C9 03                cmp     #SND_VOICES
002A3Cr 2  B0 0B                bcs     @no
002A3Er 2  AA                   tax
002A3Fr 2  BD rr rr             lda     snd_tl,x
002A42r 2  1D rr rr             ora     snd_th,x
002A45r 2  F0 02                beq     @no
002A47r 2  38                   sec
002A48r 2  60                   rts
002A49r 2  18           @no:    clc
002A4Ar 2  60                   rts
002A4Br 2               
002A4Br 2               ; SND_AYREAD - X = register -> A   (0 without the AY)
002A4Br 2               SND_AYREAD:
002A4Br 2               .if SND_DEV = SND_AY
002A4Br 2  08                   php
002A4Cr 2  78                   sei
002A4Dr 2  8E 22 7F             stx     AY_ADDR
002A50r 2  AD 23 7F             lda     AY_DATA
002A53r 2  28                   plp
002A54r 2  60                   rts
002A55r 2               .else
002A55r 2                       lda     #0
002A55r 2                       rts
002A55r 2               .endif
002A55r 2               
002A55r 2               ; SND_AYWRITE - register X = A (register 7 is remembered, so SOUND / NOISE /
002A55r 2               ; QUIET keep the I/O port directions)
002A55r 2               SND_AYWRITE:
002A55r 2               .if SND_DEV = SND_AY
002A55r 2  E0 07                cpx     #7
002A57r 2  D0 03                bne     :+
002A59r 2  8D rr rr             sta     snd_mix
002A5Cr 2  4C rr rr     :       jmp     ay_w
002A5Fr 2               .else
002A5Fr 2                       rts
002A5Fr 2               .endif
002A5Fr 2               
002A5Fr 2               ; ----------------------------------------------------------------------------
002A5Fr 2               ; the tone periods of the notes (2 MHz clock): C1 = 0 ... B8 = 95
002A5Fr 2               ; ----------------------------------------------------------------------------
002A5Fr 2               snd_nlo:
002A5Fr 2  EE 18 4D 8E          .byte   $EE, $18, $4D, $8E, $DA, $2F, $8F, $F7, $68, $E1, $61, $E9   ; octave 1
002A63r 2  DA 2F 8F F7  
002A67r 2  68 E1 61 E9  
002A6Br 2  77 0C A7 47          .byte   $77, $0C, $A7, $47, $ED, $98, $47, $FC, $B4, $70, $31, $F4   ; octave 2
002A6Fr 2  ED 98 47 FC  
002A73r 2  B4 70 31 F4  
002A77r 2  BC 86 53 24          .byte   $BC, $86, $53, $24, $F6, $CC, $A4, $7E, $5A, $38, $18, $FA   ; octave 3
002A7Br 2  F6 CC A4 7E  
002A7Fr 2  5A 38 18 FA  
002A83r 2  DE C3 AA 92          .byte   $DE, $C3, $AA, $92, $7B, $66, $52, $3F, $2D, $1C, $0C, $FD   ; octave 4
002A87r 2  7B 66 52 3F  
002A8Br 2  2D 1C 0C FD  
002A8Fr 2  EF E1 D5 C9          .byte   $EF, $E1, $D5, $C9, $BE, $B3, $A9, $9F, $96, $8E, $86, $7F   ; octave 5
002A93r 2  BE B3 A9 9F  
002A97r 2  96 8E 86 7F  
002A9Br 2  77 71 6A 64          .byte   $77, $71, $6A, $64, $5F, $59, $54, $50, $4B, $47, $43, $3F   ; octave 6
002A9Fr 2  5F 59 54 50  
002AA3r 2  4B 47 43 3F  
002AA7r 2  3C 38 35 32          .byte   $3C, $38, $35, $32, $2F, $2D, $2A, $28, $26, $24, $22, $20   ; octave 7
002AABr 2  2F 2D 2A 28  
002AAFr 2  26 24 22 20  
002AB3r 2  1E 1C 1B 19          .byte   $1E, $1C, $1B, $19, $18, $16, $15, $14, $13, $12, $11, $10   ; octave 8
002AB7r 2  18 16 15 14  
002ABBr 2  13 12 11 10  
002ABFr 2               snd_nhi:
002ABFr 2  0E 0E 0D 0C          .byte   $0E, $0E, $0D, $0C, $0B, $0B, $0A, $09, $09, $08, $08, $07
002AC3r 2  0B 0B 0A 09  
002AC7r 2  09 08 08 07  
002ACBr 2  07 07 06 06          .byte   $07, $07, $06, $06, $05, $05, $05, $04, $04, $04, $04, $03
002ACFr 2  05 05 05 04  
002AD3r 2  04 04 04 03  
002AD7r 2  03 03 03 03          .byte   $03, $03, $03, $03, $02, $02, $02, $02, $02, $02, $02, $01
002ADBr 2  02 02 02 02  
002ADFr 2  02 02 02 01  
002AE3r 2  01 01 01 01          .byte   $01, $01, $01, $01, $01, $01, $01, $01, $01, $01, $01, $00
002AE7r 2  01 01 01 01  
002AEBr 2  01 01 01 00  
002AEFr 2  00 00 00 00          .byte   $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00
002AF3r 2  00 00 00 00  
002AF7r 2  00 00 00 00  
002AFBr 2  00 00 00 00          .byte   $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00
002AFFr 2  00 00 00 00  
002B03r 2  00 00 00 00  
002B07r 2  00 00 00 00          .byte   $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00
002B0Br 2  00 00 00 00  
002B0Fr 2  00 00 00 00  
002B13r 2  00 00 00 00          .byte   $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00
002B17r 2  00 00 00 00  
002B1Br 2  00 00 00 00  
002B1Fr 2               
002B1Fr 1               .include "basic_gfx.s"          ; CLS, COLOR, LOCATE, PLOT, SPRITE
002B1Fr 2               ; ============================================================================
002B1Fr 2               ; basic_gfx.s - EhBASIC statements for the PICO9918 and ESP32_VGA displays
002B1Fr 2               ;
002B1Fr 2               ; NEW BASIC KEYWORDS (tokens after AYREG in basic.s, so programs SAVEd before
002B1Fr 2               ; keep their meaning):
002B1Fr 2               ;
002B1Fr 2               ;   CLS                       clear the text screen
002B1Fr 2               ;   CLS 1                     graphics: text over a bitmap, sprites on
002B1Fr 2               ;   CLS 0                     back to text only
002B1Fr 2               ;   COLOR fg [, bg]           text colours from now on
002B1Fr 2               ;   LOCATE col, row           move the cursor
002B1Fr 2               ;   PLOT x, y, c              a point (c = 0 clears it on the PICO9918)
002B1Fr 2               ;   PLOT x, y, c, r [, f]     a circle, radius r; f = 1 filled
002B1Fr 2               ;   PLOT x, y TO x2, y2, c [, f]
002B1Fr 2               ;                             a line; f = 1 a box, f = 2 a filled box
002B1Fr 2               ;   SPRITE n, p, x, y [, c]   show sprite n with pattern p at x, y
002B1Fr 2               ;   SPRITE DEF p, addr        define pattern p from the bytes at addr
002B1Fr 2               ;                             (POKE them there first)
002B1Fr 2               ;
002B1Fr 2               ; What the numbers mean depends on the card (each is used its own way):
002B1Fr 2               ;                 ESP32_VGA                  PICO9918
002B1Fr 2               ;   bitmap        320 x 240                  256 x 192 (after CLS 1)
002B1Fr 2               ;   text          80 x 30                    80 x 30 / 40 x 24; 32 x 24 after CLS 1
002B1Fr 2               ;   colours       0-63 = %00RRGGBB,          0-15 (TMS9918A); in text mode
002B1Fr 2               ;                 64 = transparent           one pair for the whole screen
002B1Fr 2               ;   sprites       0-15, patterns 0-31,       0-31, patterns 0-63, 16 x 16,
002B1Fr 2               ;                 16 x 16, 256 bytes each    32 bytes each; c = colour
002B1Fr 2               ;                 (a byte a pixel); c =      (default 15); y >= 192 hides it.
002B1Fr 2               ;                 flags: 1 show, 2 h-flip,   Only after CLS 1.
002B1Fr 2               ;                 4 v-flip (default 1)
002B1Fr 2               ;   After CLS 1 the ESP32 text background is transparent (64), so the bitmap
002B1Fr 2               ;   shows through; COLOR fg, 64 keeps it that way.
002B1Fr 2               ;
002B1Fr 2               ; With the KB_MONITOR_TERM display CLS sends a form feed ($0C); the others
002B1Fr 2               ; give ?FC ERROR.  A BASIC program can tell the cards apart with
002B1Fr 2               ;   D = PEEK(65279)   ($FEFF: 0 none, 1 terminal, 2 PICO9918, 3 ESP32_VGA)
002B1Fr 2               ; ============================================================================
002B1Fr 2               
002B1Fr 2               .if CON_DISPLAY = DISP_PICO
002B1Fr 2               SPR_DEFAULT     = 15                    ; white
002B1Fr 2               .else
002B1Fr 2               SPR_DEFAULT     = 1                     ; ESP32: visible
002B1Fr 2               .endif
002B1Fr 2               
002B1Fr 2               .segment "BIOS"
002B1Fr 2               
002B1Fr 2               ; ---- argument helpers ----------------------------------------------------------
002B1Fr 2               ; a number 0-65535 -> Itempl / Itemph
002B1Fr 2               gx_getw:
002B1Fr 2  20 rr rr             jsr     LAB_EVNM
002B22r 2  4C rr rr             jmp     LAB_F2FX
002B25r 2               
002B25r 2               ; ", number" -> Itempl / Itemph
002B25r 2  20 rr rr     gx_cw:  jsr     LAB_1C01
002B28r 2  4C rr rr             jmp     gx_getw
002B2Br 2               
002B2Br 2               ; ", byte" -> X
002B2Br 2  20 rr rr     gx_cb:  jsr     LAB_1C01
002B2Er 2  4C rr rr             jmp     LAB_GTBY
002B31r 2               
002B31r 2               ; "[, byte]" -> X, C=1 if it was there (else X unchanged, C=0)
002B31r 2  20 C2 00     gx_opt: jsr     LAB_GBYT
002B34r 2  C9 2C                cmp     #','
002B36r 2  D0 05                bne     @no
002B38r 2  20 rr rr             jsr     gx_cb
002B3Br 2  38                   sec
002B3Cr 2  60                   rts
002B3Dr 2  18           @no:    clc
002B3Er 2  60                   rts
002B3Fr 2               
002B3Fr 2  4C rr rr     gx_fc:  jmp     LAB_FCER                ; ?FC ERROR
002B42r 2               
002B42r 2               ; ----------------------------------------------------------------------------
002B42r 2               ; CLS [mode]
002B42r 2               ; ----------------------------------------------------------------------------
002B42r 2               BI_CLS:
002B42r 2  20 C2 00             jsr     LAB_GBYT
002B45r 2  F0 0B                beq     @plain                  ; no mode
002B47r 2  20 rr rr             jsr     LAB_GTBY
002B4Ar 2  E0 02                cpx     #2
002B4Cr 2  B0 F1                bcs     gx_fc
002B4Er 2  8A                   txa
002B4Fr 2  4C rr rr             jmp     @do
002B52r 2  A9 FF        @plain: lda     #$FF
002B54r 2               @do:
002B54r 2               .if GFX_OK
002B54r 2  4C rr rr             jmp     gfx_cls
002B57r 2               .else
002B57r 2                       cmp     #1
002B57r 2                       beq     gx_fc                   ; no graphics on this display
002B57r 2                       lda     #$0C                    ; form feed
002B57r 2                       jmp     CHROUT
002B57r 2               .endif
002B57r 2               
002B57r 2               ; ----------------------------------------------------------------------------
002B57r 2               ; COLOR fg [, bg]
002B57r 2               ; ----------------------------------------------------------------------------
002B57r 2               BI_COLOR:
002B57r 2  20 rr rr             jsr     LAB_GTBY
002B5Ar 2  8E rr rr             stx     gfx_fg
002B5Dr 2  20 rr rr             jsr     gx_opt
002B60r 2  90 03                bcc     :+
002B62r 2  8E rr rr             stx     gfx_bg
002B65r 2               :
002B65r 2               .if GFX_OK
002B65r 2  4C rr rr             jmp     gfx_color
002B68r 2               .else
002B68r 2                       jmp     gx_fc
002B68r 2               .endif
002B68r 2               
002B68r 2               ; ----------------------------------------------------------------------------
002B68r 2               ; LOCATE col, row
002B68r 2               ; ----------------------------------------------------------------------------
002B68r 2               BI_LOCATE:
002B68r 2  20 rr rr             jsr     LAB_GTBY
002B6Br 2  8E rr rr             stx     gfx_x
002B6Er 2  20 rr rr             jsr     gx_cb
002B71r 2  8E rr rr             stx     gfx_y
002B74r 2               .if GFX_OK
002B74r 2  4C rr rr             jmp     gfx_locate
002B77r 2               .else
002B77r 2                       jmp     gx_fc
002B77r 2               .endif
002B77r 2               
002B77r 2               ; ----------------------------------------------------------------------------
002B77r 2               ; PLOT x, y, c [, r [, f]]   /   PLOT x, y TO x2, y2, c [, f]
002B77r 2               ; ----------------------------------------------------------------------------
002B77r 2               BI_PLOT:
002B77r 2               .if GFX_OK
002B77r 2  20 rr rr             jsr     gx_getw                 ; x
002B7Ar 2  A5 11                lda     Itempl
002B7Cr 2  8D rr rr             sta     gfx_x
002B7Fr 2  A5 12                lda     Itemph
002B81r 2  8D rr rr             sta     gfx_x+1
002B84r 2  20 rr rr             jsr     gx_cb                   ; y
002B87r 2  8E rr rr             stx     gfx_y
002B8Ar 2  A9 00                lda     #0
002B8Cr 2  8D rr rr             sta     gfx_y+1
002B8Fr 2  8D rr rr             sta     gfx_f
002B92r 2  20 C2 00             jsr     LAB_GBYT
002B95r 2  C9 B9                cmp     #TK_TO
002B97r 2  F0 1C                beq     @to
002B99r 2  20 rr rr             jsr     gx_cb                   ; c
002B9Cr 2  8E rr rr             stx     gfx_c
002B9Fr 2  20 rr rr             jsr     gx_opt                  ; r?
002BA2r 2  90 0E                bcc     @point
002BA4r 2  8E rr rr             stx     gfx_r
002BA7r 2  20 rr rr             jsr     gx_opt                  ; f?
002BAAr 2  90 03                bcc     :+
002BACr 2  8E rr rr             stx     gfx_f
002BAFr 2  4C rr rr     :       jmp     gfx_circle
002BB2r 2  4C rr rr     @point: jmp     gfx_plot
002BB5r 2  20 BC 00     @to:    jsr     LAB_IGBY                ; past TO
002BB8r 2  20 rr rr             jsr     gx_getw                 ; x2
002BBBr 2  A5 11                lda     Itempl
002BBDr 2  8D rr rr             sta     gfx_x1
002BC0r 2  A5 12                lda     Itemph
002BC2r 2  8D rr rr             sta     gfx_x1+1
002BC5r 2  20 rr rr             jsr     gx_cb                   ; y2
002BC8r 2  8E rr rr             stx     gfx_y1
002BCBr 2  A9 00                lda     #0
002BCDr 2  8D rr rr             sta     gfx_y1+1
002BD0r 2  20 rr rr             jsr     gx_cb                   ; c
002BD3r 2  8E rr rr             stx     gfx_c
002BD6r 2  20 rr rr             jsr     gx_opt                  ; f?
002BD9r 2  90 10                bcc     @line
002BDBr 2  E0 03                cpx     #3
002BDDr 2  90 03                bcc     :+
002BDFr 2  4C rr rr             jmp     gx_fc
002BE2r 2  8E rr rr     :       stx     gfx_f
002BE5r 2  8A                   txa
002BE6r 2  F0 03                beq     @line
002BE8r 2  4C rr rr             jmp     gfx_box
002BEBr 2  4C rr rr     @line:  jmp     gfx_line
002BEEr 2               .else
002BEEr 2                       jmp     gx_fc
002BEEr 2               .endif
002BEEr 2               
002BEEr 2               ; ----------------------------------------------------------------------------
002BEEr 2               ; SPRITE n, p, x, y [, c]   /   SPRITE DEF p, addr
002BEEr 2               ; ----------------------------------------------------------------------------
002BEEr 2               BI_SPRITE:
002BEEr 2               .if GFX_OK
002BEEr 2  20 C2 00             jsr     LAB_GBYT
002BF1r 2  C9 99                cmp     #TK_DEF
002BF3r 2  F0 33                beq     @def
002BF5r 2  20 rr rr             jsr     LAB_GTBY                ; n
002BF8r 2  8E rr rr             stx     gfx_n
002BFBr 2  20 rr rr             jsr     gx_cb                   ; p
002BFEr 2  8E rr rr             stx     gfx_p
002C01r 2  20 rr rr             jsr     gx_cw                   ; x
002C04r 2  A5 11                lda     Itempl
002C06r 2  8D rr rr             sta     gfx_x
002C09r 2  A5 12                lda     Itemph
002C0Br 2  8D rr rr             sta     gfx_x+1
002C0Er 2  20 rr rr             jsr     gx_cw                   ; y
002C11r 2  A5 11                lda     Itempl
002C13r 2  8D rr rr             sta     gfx_y
002C16r 2  A5 12                lda     Itemph
002C18r 2  8D rr rr             sta     gfx_y+1
002C1Br 2  20 rr rr             jsr     gx_opt                  ; c?
002C1Er 2  B0 02                bcs     :+
002C20r 2  A2 0F                ldx     #SPR_DEFAULT
002C22r 2  8E rr rr     :       stx     gfx_c
002C25r 2  4C rr rr             jmp     gfx_sprite
002C28r 2  20 BC 00     @def:   jsr     LAB_IGBY                ; past DEF
002C2Br 2  20 rr rr             jsr     LAB_GTBY                ; p
002C2Er 2  8E rr rr             stx     gfx_p
002C31r 2  20 rr rr             jsr     gx_cw                   ; addr
002C34r 2  A5 11                lda     Itempl
002C36r 2  85 rr                sta     con_ptr
002C38r 2  A5 12                lda     Itemph
002C3Ar 2  85 rr                sta     con_ptr+1
002C3Cr 2  4C rr rr             jmp     gfx_sprdef
002C3Fr 2               .else
002C3Fr 2                       jmp     gx_fc
002C3Fr 2               .endif
002C3Fr 2               
002C3Fr 1               .include "gamepad.s"            ; NES gamepad on the VIA    (BIOS, BIOSVARS)
002C3Fr 2               ; ============================================================================
002C3Fr 2               ; gamepad.s - NES style gamepad on the 65C22 VIA, typed into the input buffer
002C3Fr 2               ;
002C3Fr 2               ; The pad is read 60 times a second from the VIA's timer 1 interrupt (IRQ2).
002C3Fr 2               ; Every new button press puts the character assigned to that button into the
002C3Fr 2               ; same input buffer the keyboard and serial port use, so BASIC (GET, INPUT)
002C3Fr 2               ; and the monitor see it as if it had been typed.  A held button repeats like
002C3Fr 2               ; a keyboard key.
002C3Fr 2               ;
002C3Fr 2               ; WIRING (VIA port A; change the three PAD_..._BIT masks below if you wire it
002C3Fr 2               ; differently).  The pad's +5V and GND go to the supply:
002C3Fr 2               ;       PA0  <-  DATA   (pad pin "Data", needs a pull-up resistor, 10k to +5V)
002C3Fr 2               ;       PA1  ->  LATCH
002C3Fr 2               ;       PA2  ->  CLOCK
002C3Fr 2               ; The other port A pins are left alone.
002C3Fr 2               ;
002C3Fr 2               ; BUTTON NUMBERS (the order the pad shifts them out):
002C3Fr 2               ;       0 = A        1 = B        2 = Select    3 = Start
002C3Fr 2               ;       4 = Up       5 = Down     6 = Left      7 = Right
002C3Fr 2               ;
002C3Fr 2               ; DEFAULT CHARACTERS:  Up W, Down S, Left A, Right D (upper case), A = space; B, Select and
002C3Fr 2               ; Start are not assigned (0).  Change them from BASIC with
002C3Fr 2               ;       PADKEY button, char        e.g.  PADKEY 1, 13    (B = Enter)
002C3Fr 2               ;                                        PADKEY 4, ASC("W")
002C3Fr 2               ;       PADKEY                     restore the defaults
002C3Fr 2               ; char 0 switches a button off.  Or edit pad_defaults below.
002C3Fr 2               ; ============================================================================
002C3Fr 2               
002C3Fr 2               ; Rev2: PAD_ENABLE comes from HAS_GAMEPAD in config.inc, and the 60 Hz timer
002C3Fr 2               ; (and the VIA register names) moved to drv_via.s.  PAD_POLL is called from
002C3Fr 2               ; the tick in drv_via.s.
002C3Fr 2               PAD_ENABLE       = HAS_GAMEPAD      ; 0 = leave the VIA alone, no pad support
002C3Fr 2               PAD_DATA_BIT     = $01              ; PA0
002C3Fr 2               PAD_LATCH_BIT    = $02              ; PA1
002C3Fr 2               PAD_CLOCK_BIT    = $04              ; PA2
002C3Fr 2               PAD_REPEAT_DELAY = 20               ; polls (1/60 s) before a held button repeats
002C3Fr 2               PAD_REPEAT_RATE  = 6                ; polls between repeats (0 = no repeat)
002C3Fr 2               
002C3Fr 2               .segment "BIOSVARS"
000047r 2  xx xx xx xx  pad_map:    .res 8                  ; character for each button (0 = none)
00004Br 2  xx xx xx xx  
00004Fr 2  xx           pad_prev:   .res 1                  ; buttons down at the previous poll
000050r 2  xx           pad_now:    .res 1                  ; buttons down now (bit n = button n)
000051r 2  xx           pad_last:   .res 1                  ; buttons that are auto-repeating
000052r 2  xx           pad_cnt:    .res 1                  ; polls until the next repeat
000053r 2  xx           pad_new:    .res 1
000054r 2  xx           pad_tmp:    .res 1
000055r 2               
000055r 2               .segment "BIOS"
002C3Fr 2               
002C3Fr 2               ; ----------------------------------------------------------------------------
002C3Fr 2               ; PAD_INIT - called from RESET after VIA_INIT (which starts the tick).
002C3Fr 2               ; Clobbers A.
002C3Fr 2               ; ----------------------------------------------------------------------------
002C3Fr 2               PAD_INIT:
002C3Fr 2  20 rr rr             jsr     PAD_DEFAULTS
002C42r 2  A9 00                lda     #0
002C44r 2  8D rr rr             sta     pad_now
002C47r 2  8D rr rr             sta     pad_prev
002C4Ar 2  8D rr rr             sta     pad_last
002C4Dr 2  8D rr rr             sta     pad_cnt
002C50r 2  A9 01                lda     #PAD_ENABLE         ; 0 = no gamepad support: leave the VIA alone
002C52r 2  F0 12                beq     @off
002C54r 2  AD 01 7F             lda     PORTA               ; latch and clock idle low
002C57r 2  29 F9                and     #($FF ^ (PAD_LATCH_BIT | PAD_CLOCK_BIT))
002C59r 2  8D 01 7F             sta     PORTA
002C5Cr 2  AD 03 7F             lda     DDRA                ; latch + clock are outputs, data an input
002C5Fr 2  09 06                ora     #(PAD_LATCH_BIT | PAD_CLOCK_BIT)
002C61r 2  29 FE                and     #($FF ^ PAD_DATA_BIT)
002C63r 2  8D 03 7F             sta     DDRA
002C66r 2  60           @off:   rts
002C67r 2               
002C67r 2               ; PAD_STATE - for the fixed jump table: A = buttons held right now
002C67r 2               PAD_STATE:
002C67r 2  AD rr rr             lda     pad_now
002C6Ar 2  60                   rts
002C6Br 2               
002C6Br 2               ; Restore the default button characters
002C6Br 2               PAD_DEFAULTS:
002C6Br 2  A2 07                ldx     #7
002C6Dr 2  BD rr rr     @l:     lda     pad_defaults,x
002C70r 2  9D rr rr             sta     pad_map,x
002C73r 2  CA                   dex
002C74r 2  10 F7                bpl     @l
002C76r 2  60                   rts
002C77r 2               
002C77r 2               pad_defaults:
002C77r 2  20                   .byte   ' '                 ; 0 A
002C78r 2  00                   .byte   0                   ; 1 B
002C79r 2  00                   .byte   0                   ; 2 Select
002C7Ar 2  00                   .byte   0                   ; 3 Start
002C7Br 2  57                   .byte   'W'                 ; 4 Up
002C7Cr 2  53                   .byte   'S'                 ; 5 Down
002C7Dr 2  41                   .byte   'A'                 ; 6 Left
002C7Er 2  44                   .byte   'D'                 ; 7 Right
002C7Fr 2               
002C7Fr 2               ; ----------------------------------------------------------------------------
002C7Fr 2               ; PAD_POLL - read the pad and queue characters.  Called from the IRQ handler
002C7Fr 2               ; (registers are already saved there).
002C7Fr 2               ; ----------------------------------------------------------------------------
002C7Fr 2               PAD_POLL:
002C7Fr 2  AD 01 7F             lda     PORTA               ; latch pulse: the pad's shift register
002C82r 2  09 02                ora     #PAD_LATCH_BIT      ; loads the 8 button states
002C84r 2  8D 01 7F             sta     PORTA
002C87r 2  20 rr rr             jsr     pad_wait
002C8Ar 2  AD 01 7F             lda     PORTA
002C8Dr 2  29 FD                and     #($FF ^ PAD_LATCH_BIT)
002C8Fr 2  8D 01 7F             sta     PORTA
002C92r 2  A2 08                ldx     #8
002C94r 2  AD 01 7F     @bit:   lda     PORTA               ; data line is LOW while a button is down
002C97r 2  29 01                and     #PAD_DATA_BIT
002C99r 2  C9 01                cmp     #1                  ; carry = 1 when the line is high (not pressed)
002C9Br 2  6E rr rr             ror     pad_now             ; first button ends up in bit 0
002C9Er 2  AD 01 7F             lda     PORTA
002CA1r 2  09 04                ora     #PAD_CLOCK_BIT      ; clock pulse: shift to the next button
002CA3r 2  8D 01 7F             sta     PORTA
002CA6r 2  20 rr rr             jsr     pad_wait
002CA9r 2  AD 01 7F             lda     PORTA
002CACr 2  29 FB                and     #($FF ^ PAD_CLOCK_BIT)
002CAEr 2  8D 01 7F             sta     PORTA
002CB1r 2  20 rr rr             jsr     pad_wait
002CB4r 2  CA                   dex
002CB5r 2  D0 DD                bne     @bit
002CB7r 2  AD rr rr             lda     pad_now
002CBAr 2  49 FF                eor     #$FF                ; now bit = 1 when the button is down
002CBCr 2  C9 FF                cmp     #$FF
002CBEr 2  D0 02                bne     @ok
002CC0r 2  A9 00                lda     #0                  ; all 8 down = nothing plugged in
002CC2r 2  8D rr rr     @ok:    sta     pad_now
002CC5r 2               
002CC5r 2  AD rr rr             lda     pad_prev            ; buttons newly pressed
002CC8r 2  49 FF                eor     #$FF
002CCAr 2  2D rr rr             and     pad_now
002CCDr 2  8D rr rr             sta     pad_new
002CD0r 2  F0 11                beq     @held
002CD2r 2  8D rr rr             sta     pad_last            ; they are the ones that repeat
002CD5r 2  A9 14                lda     #PAD_REPEAT_DELAY
002CD7r 2  8D rr rr             sta     pad_cnt
002CDAr 2  AD rr rr             lda     pad_new
002CDDr 2  20 rr rr             jsr     pad_emit
002CE0r 2  4C rr rr             jmp     @done
002CE3r 2  AD rr rr     @held:  lda     pad_last
002CE6r 2  F0 24                beq     @done               ; nothing to repeat
002CE8r 2  2D rr rr             and     pad_now
002CEBr 2  8D rr rr             sta     pad_last            ; drop released buttons
002CEEr 2  F0 1C                beq     @done
002CF0r 2  A9 06                lda     #PAD_REPEAT_RATE    ; 0 = no auto repeat
002CF2r 2  F0 13                beq     @norep
002CF4r 2  CE rr rr             dec     pad_cnt
002CF7r 2  D0 13                bne     @done
002CF9r 2  A9 06                lda     #PAD_REPEAT_RATE
002CFBr 2  8D rr rr             sta     pad_cnt
002CFEr 2  AD rr rr             lda     pad_last
002D01r 2  20 rr rr             jsr     pad_emit
002D04r 2  4C rr rr             jmp     @done
002D07r 2  A9 00        @norep: lda     #0
002D09r 2  8D rr rr             sta     pad_last
002D0Cr 2  AD rr rr     @done:  lda     pad_now
002D0Fr 2  8D rr rr             sta     pad_prev
002D12r 2  60                   rts
002D13r 2               
002D13r 2               ; short delay for the pad's slow shift register (about 5 us at any clock)
002D13r 2               pad_wait:
002D13r 2  A0 04                ldy     #CPU_MHZ
002D15r 2  88           @l:     dey
002D16r 2  D0 FD                bne     @l
002D18r 2  60                   rts
002D19r 2               
002D19r 2               ; pad_emit - A = mask of buttons: queue the character of each one
002D19r 2               pad_emit:
002D19r 2  8D rr rr             sta     pad_tmp
002D1Cr 2  A0 00                ldy     #0
002D1Er 2  4E rr rr     @l:     lsr     pad_tmp
002D21r 2  90 17                bcc     @next
002D23r 2  B9 rr rr             lda     pad_map,y
002D26r 2  F0 12                beq     @next               ; button not assigned
002D28r 2  48                   pha
002D29r 2  A5 rr                lda     WRITE_PTR           ; keep clear of a full buffer
002D2Br 2  38                   sec
002D2Cr 2  E5 rr                sbc     READ_PTR
002D2Er 2  C9 F0                cmp     #$F0
002D30r 2  B0 07                bcs     @drop
002D32r 2  68                   pla
002D33r 2  20 rr rr             jsr     WRITE_BUFFER        ; (uses X, not Y)
002D36r 2  4C rr rr             jmp     @next
002D39r 2  68           @drop:  pla
002D3Ar 2  C8           @next:  iny
002D3Br 2  C0 08                cpy     #8
002D3Dr 2  D0 DF                bne     @l
002D3Fr 2  60                   rts
002D40r 2               
002D40r 2               ; ----------------------------------------------------------------------------
002D40r 2               ; PADKEY button, char   (BASIC statement)      PADKEY alone = defaults
002D40r 2               ; ----------------------------------------------------------------------------
002D40r 2               BI_PADKEY:
002D40r 2  20 C2 00             jsr     LAB_GBYT
002D43r 2  D0 03                bne     @set
002D45r 2  4C rr rr             jmp     PAD_DEFAULTS
002D48r 2  20 rr rr     @set:   jsr     LAB_GTBY            ; X = button 0-7
002D4Br 2  E0 08                cpx     #8
002D4Dr 2  B0 0F                bcs     @fc
002D4Fr 2  8A                   txa
002D50r 2  48                   pha
002D51r 2  20 rr rr             jsr     LAB_1C01            ; ","
002D54r 2  20 rr rr             jsr     LAB_GTBY            ; X = character code 0-255
002D57r 2  68                   pla
002D58r 2  A8                   tay
002D59r 2  8A                   txa
002D5Ar 2  99 rr rr             sta     pad_map,y
002D5Dr 2  60                   rts
002D5Er 2  4C rr rr     @fc:    jmp     LAB_FCER
002D61r 2               
002D61r 1               .include "jumptable.s"          ; fixed entry points for your programs (JUMPTAB)
002D61r 2               ; ============================================================================
002D61r 2               ; jumptable.s - FIXED entry points for programs you load with the monitor
002D61r 2               ;
002D61r 2               ; Every entry is a 3 byte JMP at a fixed address from $FE00, so programs built
002D61r 2               ; separately keep working when the ROM is rebuilt.  sbc_api.inc has the same
002D61r 2               ; addresses as ca65 equates.  Add new entries at the END only.
002D61r 2               ;
002D61r 2               ;   $FE00  SBC_CHRIN     C=1 + A = character, C=0 nothing waiting
002D61r 2               ;   $FE03  SBC_CHROUT    print A (A, X, Y preserved)
002D61r 2               ;   $FE06  SBC_MENU      boot menu
002D61r 2               ;   $FE09  SBC_COLD      EhBASIC cold start
002D61r 2               ;   $FE0C  SBC_WARM      EhBASIC warm start
002D61r 2               ;   $FE0F  SBC_MONITOR   monitor prompt
002D61r 2               ;   $FE12  SBC_PADSTATE  A = gamepad buttons held now
002D61r 2               ;   $FE15  SBC_LOAD      load a file (see sbc_api.inc)
002D61r 2               ;   $FE18  SBC_CWD       A/Y = monitor's current folder
002D61r 2               ;   ---- new for CPU Rev2 (check SBC_SYSINFO: Y = API version >= 2) ----
002D61r 2               ;   $FE1B  SBC_SYSINFO   A = display type, X = device status, Y = API version
002D61r 2               ;   $FE1E  SBC_SEROUT    send A out of the serial console port (A, X, Y kept)
002D61r 2               ;   $FE21  SBC_MOUSEON   A = 1 mouse reports on / 0 off.  C=1: no mouse
002D61r 2               ;   $FE24  SBC_MOUSE     A = buttons, X/Y = movement since last call;
002D61r 2               ;                        C=1 if a report arrived since the last call
002D61r 2               ;   $FE27  SBC_BANKSET   A = RAM bank (0-15) for $1000-$7EFF   (*)
002D61r 2               ;   $FE2A  SBC_BANKGET   A = bank selected, X = number of banks
002D61r 2               ;   $FE2D  SBC_TICKS     A/X/Y = 60 Hz counter, low/middle/high
002D61r 2               ;   $FE30  SBC_ACIAIN    serial card 6551: C=1 + A = byte, C=0 none
002D61r 2               ;   $FE33  SBC_ACIAOUT   serial card 6551: send A
002D61r 2               ;   $FE36  SBC_VSYNC     C=1 if a frame ended since the last call
002D61r 2               ;                        (PICO9918 / ESP32_VGA; A = the status)
002D61r 2               ;   $FE39  SBC_CONRESET  display back to the text console, cleared
002D61r 2               ;   $FE3C  SBC_SNDNOTE   A/Y -> voice, note, volume, time lo, time hi; C=1 bad
002D61r 2               ;   $FE3F  SBC_SNDQUIET  all sound off
002D61r 2               ;   $FE42  SBC_SNDBUSY   A = voice: C=1 while its timed note plays
002D61r 2               ;   $FE45  SBC_SAY       A/Y -> allophones ended by $FF (queued)
002D61r 2               ;   $FE48  SBC_SAYBUSY   C=1 while speaking
002D61r 2               ;   $FE4B  SBC_AYREAD    X = AY register -> A
002D61r 2               ;   $FE4E  SBC_AYWRITE   AY register X = A
002D61r 2               ;   $FE51  SBC_TIME      A/Y -> 18 bytes <- "mm/dd/yy hh:mm:ss",0; C=1 no clock
002D61r 2               ;   $FE54  SBC_SETTIME   A/Y -> "dwyymmddHHMMSS"; C=1 no clock
002D61r 2               ;   $FE57  SBC_DIR       A/Y -> block: the current folder into a table (shell.s)
002D61r 2               ;   $FE5A  SBC_RUN       A/Y -> block: load and start a program or BASIC program
002D61r 2               ;   $FE5D  SBC_SHELL     A = the shell's RAM bank (0 = none)
002D61r 2               ;   $FEFF  (a byte)      display type, for PEEK(65279) from BASIC
002D61r 2               ;
002D61r 2               ; (*) code that switches banks must itself be in ROM or $0000-$0FFF.
002D61r 2               ; ============================================================================
002D61r 2               .segment "JUMPTAB"
000000r 2  4C rr rr     JT_CHRIN:       jmp     CHRIN
000003r 2  4C rr rr     JT_CHROUT:      jmp     CHROUT
000006r 2  4C rr rr     JT_MENU:        jmp     shell_menu      ; (the shell if there is one)
000009r 2  4C rr rr     JT_COLD:        jmp     LAB_COLD
00000Cr 2  4C 00 00     JT_WARM:        jmp     LAB_WARM
00000Fr 2  4C rr rr     JT_MONITOR:     jmp     WOZ_ENTRY
000012r 2  4C rr rr     JT_PADSTATE:    jmp     PAD_STATE
000015r 2  4C rr rr     JT_LOAD:        jmp     SBC_LOAD
000018r 2  4C rr rr     JT_CWD:         jmp     sbc_cwd
00001Br 2  4C rr rr     JT_SYSINFO:     jmp     SYSINFO
00001Er 2  4C rr rr     JT_SEROUT:      jmp     SER_OUT
000021r 2  4C rr rr     JT_MOUSEON:     jmp     jt_mouseon
000024r 2  4C rr rr     JT_MOUSE:       jmp     jt_mouse
000027r 2  4C rr rr     JT_BANKSET:     jmp     BANK_SET
00002Ar 2  4C rr rr     JT_BANKGET:     jmp     BANK_GET
00002Dr 2  4C rr rr     JT_TICKS:       jmp     jt_ticks
000030r 2  4C rr rr     JT_ACIAIN:      jmp     jt_aciain
000033r 2  4C rr rr     JT_ACIAOUT:     jmp     jt_aciaout
000036r 2  4C rr rr     JT_VSYNC:       jmp     jt_vsync
000039r 2  4C rr rr     JT_CONRESET:    jmp     jt_conreset
00003Cr 2  4C rr rr     JT_SNDNOTE:     jmp     SND_API_NOTE
00003Fr 2  4C rr rr     JT_SNDQUIET:    jmp     BI_QUIET
000042r 2  4C rr rr     JT_SNDBUSY:     jmp     SND_API_BUSY
000045r 2  4C rr rr     JT_SAY:         jmp     jt_say
000048r 2  4C rr rr     JT_SAYBUSY:     jmp     jt_saybusy
00004Br 2  4C rr rr     JT_AYREAD:      jmp     SND_AYREAD
00004Er 2  4C rr rr     JT_AYWRITE:     jmp     SND_AYWRITE
000051r 2  4C rr rr     JT_TIME:        jmp     FS_TIME
000054r 2  4C rr rr     JT_SETTIME:     jmp     FS_SETTIME
000057r 2  4C rr rr     JT_DIR:         jmp     sbc_dir         ; stage 6
00005Ar 2  4C rr rr     JT_RUN:         jmp     sbc_run
00005Dr 2  4C rr rr     JT_SHELL:       jmp     sbc_shell
000060r 2  4C rr rr     JT_COPY:        jmp     sbc_copy        ; stage 6b
000063r 2  4C rr rr     JT_DELETE:      jmp     sbc_delete
000066r 2               
000066r 2               .segment "SYSBYTE"
000000r 2  02                           .byte   CON_DISPLAY     ; $FEFF
000001r 2               
000001r 2               .assert JT_CWD = $FE18, error, "jumptable.s: an old entry moved"
000001r 2               .assert JT_DIR = $FE57, error, "jumptable.s: SBC_DIR moved"
000001r 2               .assert JT_DELETE = $FE63, error, "jumptable.s: SBC_DELETE moved"
000001r 2               
000001r 2               .segment "BIOS"
002D61r 2               
002D61r 2               ; Entries whose driver may not be in this build get a harmless stand-in.
002D61r 2               .if MOUSE_SRC = MOUSE_AVR
002D61r 2               jt_mouseon      = MOUSE_ON
002D61r 2               jt_mouse        = MOUSE_READ
002D61r 2               .elseif MOUSE_SRC = MOUSE_ESP32
002D61r 2               jt_mouseon      = esp_mouse_on
002D61r 2               jt_mouse        = esp_mouse_read
002D61r 2               .else
002D61r 2               jt_mouseon:
002D61r 2                       sec                             ; no mouse interface
002D61r 2                       rts
002D61r 2               jt_mouse:
002D61r 2                       lda     #0
002D61r 2                       tax
002D61r 2                       tay
002D61r 2                       clc
002D61r 2                       rts
002D61r 2               .endif
002D61r 2               
002D61r 2               .if GFX_OK
002D61r 2               jt_vsync        = gfx_vsync
002D61r 2               .else
002D61r 2               jt_vsync:
002D61r 2                       lda     #0
002D61r 2                       clc
002D61r 2                       rts
002D61r 2               .endif
002D61r 2               
002D61r 2               .if CON_DISPLAY <> DISP_NONE
002D61r 2               jt_conreset:
002D61r 2  20 rr rr             jsr     disp_reset
002D64r 2  18                   clc
002D65r 2  60                   rts
002D66r 2               .else
002D66r 2               jt_conreset:
002D66r 2                       rts
002D66r 2               .endif
002D66r 2               
002D66r 2               .if HAS_SPO
002D66r 2               jt_say          = SPO_SAY
002D66r 2               jt_saybusy      = SPO_BUSY
002D66r 2               .else
002D66r 2               jt_say:
002D66r 2                       rts
002D66r 2               jt_saybusy:
002D66r 2                       clc
002D66r 2                       rts
002D66r 2               .endif
002D66r 2               
002D66r 2               .if HAS_VIA
002D66r 2               jt_ticks        = TICKS_GET
002D66r 2               .else
002D66r 2               jt_ticks:
002D66r 2                       lda     #0
002D66r 2                       tax
002D66r 2                       tay
002D66r 2                       rts
002D66r 2               .endif
002D66r 2               
002D66r 2               .if HAS_ACIA
002D66r 2               jt_aciain       = acia_getc
002D66r 2               jt_aciaout:                             ; A, X, Y preserved
002D66r 2  48                   pha
002D67r 2  8A                   txa
002D68r 2  48                   pha
002D69r 2  98                   tya
002D6Ar 2  48                   pha
002D6Br 2  BA                   tsx
002D6Cr 2  BD 03 01             lda     $0103,x                 ; the byte
002D6Fr 2  20 rr rr             jsr     acia_putc
002D72r 2  68                   pla
002D73r 2  A8                   tay
002D74r 2  68                   pla
002D75r 2  AA                   tax
002D76r 2  68                   pla
002D77r 2  60                   rts
002D78r 2               .else
002D78r 2               jt_aciain:
002D78r 2                       lda     #0
002D78r 2                       clc
002D78r 2                       rts
002D78r 2               jt_aciaout:
002D78r 2                       rts
002D78r 2               .endif
002D78r 2               
002D78r 1               .include "wozmon.s"             ; monitor                   (WOZMON)
002D78r 2               ; ============================================================================
002D78r 2               ; wozmon.s - Woz monitor, adapted for this SBC (segment WOZMON = $FF00 in sbc.cfg)
002D78r 2               ;
002D78r 2               ; Entered from the boot menu ([M]) or from BASIC with  CALL 65280  ($FF00).
002D78r 2               ; CTRL-C at the monitor prompt returns to the boot menu.
002D78r 2               ; Typing lower case is fine: letters are converted to upper case on input.
002D78r 2               ;
002D78r 2               ;   XXXX            examine address          XXXX.YYYY   examine a range
002D78r 2               ;   XXXX: AA BB ..  store bytes              XXXXR       run program at XXXX
002D78r 2               ;   ?               list commands            L NAME [XXXX]  load NAME.BIN (monitor_cmds.s)
002D78r 2               ; ============================================================================
002D78r 2               .segment "WOZMON"
000000r 2               
000000r 2               XAML            = $24                   ; Last "opened" location Low
000000r 2               XAMH            = $25                   ; Last "opened" location High
000000r 2               STL             = $26                   ; Store address Low
000000r 2               STH             = $27                   ; Store address High
000000r 2               L               = $28                   ; Hex value parsing Low
000000r 2               H               = $29                   ; Hex value parsing High
000000r 2               YSAV            = $2A                   ; Used to see if hex value is given
000000r 2               MODE            = $2B                   ; $00=XAM, $7F=STOR, $AE=BLOCK XAM
000000r 2               
000000r 2               IN              = $0200                 ; Input buffer (128 bytes, $0200-$027F)
000000r 2               
000000r 2               ; WOZ_ENTRY must stay the first thing in this segment: it is at $FF00.
000000r 2               WOZ_ENTRY:
000000r 2  D8                           CLD                     ; Clear decimal arithmetic mode.
000001r 2  58                           CLI
000002r 2  A2 FF                        LDX     #$FF
000004r 2  9A                           TXS                     ; Empty the stack
000005r 2  4C rr rr                     JMP     GETLINE         ; the prompt (U:\>), start a new line
000008r 2               
000008r 2               
000008r 2               NOTCR:
000008r 2  C9 08                        CMP     #$08            ; Backspace key?
00000Ar 2  F0 11                        BEQ     BACKSPACE       ; Yes.
00000Cr 2  C9 1B                        CMP     #$1B            ; ESC?
00000Er 2  F0 03                        BEQ     ESCAPE          ; Yes.
000010r 2  C8                           INY                     ; Advance text index.
000011r 2  10 0D                        BPL     NEXTCHAR        ; Auto ESC if line longer than 127.
000013r 2               
000013r 2               ESCAPE:
000013r 2  A9 5C                        LDA     #$5C            ; "\".
000015r 2  20 rr rr                     JSR     ECHO            ; Output it.
000018r 2               
000018r 2               GETLINE:
000018r 2  20 rr rr                     JSR     mon_prompt      ; CR LF and "U:\GAMES>" (shell.s)
00001Br 2               
00001Br 2  A0 01                        LDY     #$01            ; Initialize text index.
00001Dr 2  88           BACKSPACE:      DEY                     ; Back up text index.
00001Er 2  30 F8                        BMI     GETLINE         ; Beyond start of line, reinitialize.
000020r 2               
000020r 2               NEXTCHAR:
000020r 2  20 rr rr                     JSR     WOZ_GETC        ; Wait for a key (upper-cased, CTRL-C -> menu)
000023r 2  99 00 02                     STA     IN,Y            ; Add to text buffer.
000026r 2  20 rr rr                     JSR     ECHO            ; Echo it (CHRIN doesn't echo).
000029r 2  C9 0D                        CMP     #$0D            ; CR?
00002Br 2  D0 DB                        BNE     NOTCR           ; No.
00002Dr 2               
00002Dr 2  20 rr rr                     JSR     MON_HOOK        ; extra commands (monitor_cmds.s)
000030r 2  B0 E6                        BCS     GETLINE         ; carry set: it was one of ours
000032r 2               
000032r 2  A0 FF                        LDY     #$FF            ; Reset text index.
000034r 2  A9 00                        LDA     #$00            ; For XAM mode.
000036r 2  AA                           TAX                     ; X=0.
000037r 2               SETBLOCK:
000037r 2  0A                           ASL
000038r 2               SETSTOR:
000038r 2  0A                           ASL                     ; Leaves $7B if setting STOR mode.
000039r 2               SETMODE:
000039r 2  85 2B                        STA     MODE            ; $00 = XAM, $74 = STOR, $B8 = BLOK XAM.
00003Br 2               BLSKIP:
00003Br 2  C8                           INY                     ; Advance text index.
00003Cr 2               NEXTITEM:
00003Cr 2  B9 00 02                     LDA     IN,Y            ; Get character.
00003Fr 2  C9 0D                        CMP     #$0D            ; CR?
000041r 2  F0 D5                        BEQ     GETLINE         ; Yes, done this line.
000043r 2  C9 2E                        CMP     #$2E            ; "."?
000045r 2  90 F4                        BCC     BLSKIP          ; Skip delimiter.
000047r 2  F0 EE                        BEQ     SETBLOCK        ; Set BLOCK XAM mode.
000049r 2  C9 3A                        CMP     #$3A            ; ":"?
00004Br 2  F0 EB                        BEQ     SETSTOR         ; Yes, set STOR mode.
00004Dr 2  C9 52                        CMP     #$52            ; "R"?
00004Fr 2  F0 3B                        BEQ     RUNPROG         ; Yes, run user program.
000051r 2  86 28                        STX     L               ; $00 -> L.
000053r 2  86 29                        STX     H               ;    and H.
000055r 2  84 2A                        STY     YSAV            ; Save Y for comparison
000057r 2               
000057r 2               NEXTHEX:
000057r 2  B9 00 02                     LDA     IN,Y            ; Get character for hex test.
00005Ar 2  49 30                        EOR     #$30            ; Map digits to $0-9.
00005Cr 2  C9 0A                        CMP     #$0A            ; Digit?
00005Er 2  90 06                        BCC     DIG             ; Yes.
000060r 2  69 88                        ADC     #$88            ; Map letter "A"-"F" to $FA-FF.
000062r 2  C9 FA                        CMP     #$FA            ; Hex letter?
000064r 2  90 11                        BCC     NOTHEX          ; No, character not hex.
000066r 2               DIG:
000066r 2  0A                           ASL
000067r 2  0A                           ASL                     ; Hex digit to MSD of A.
000068r 2  0A                           ASL
000069r 2  0A                           ASL
00006Ar 2               
00006Ar 2  A2 04                        LDX     #$04            ; Shift count.
00006Cr 2               HEXSHIFT:
00006Cr 2  0A                           ASL                     ; Hex digit left, MSB to carry.
00006Dr 2  26 28                        ROL     L               ; Rotate into LSD.
00006Fr 2  26 29                        ROL     H               ; Rotate into MSD's.
000071r 2  CA                           DEX                     ; Done 4 shifts?
000072r 2  D0 F8                        BNE     HEXSHIFT        ; No, loop.
000074r 2  C8                           INY                     ; Advance text index.
000075r 2  D0 E0                        BNE     NEXTHEX         ; Always taken. Check next character for hex.
000077r 2               
000077r 2               NOTHEX:
000077r 2  C4 2A                        CPY     YSAV            ; Check if L, H empty (no hex digits).
000079r 2  F0 98                        BEQ     ESCAPE          ; Yes, generate ESC sequence.
00007Br 2               
00007Br 2  24 2B                        BIT     MODE            ; Test MODE byte.
00007Dr 2  50 10                        BVC     NOTSTOR         ; B6=0 is STOR, 1 is XAM and BLOCK XAM.
00007Fr 2               
00007Fr 2  A5 28                        LDA     L               ; LSD's of hex data.
000081r 2  81 26                        STA     (STL,X)         ; Store current 'store index'.
000083r 2  E6 26                        INC     STL             ; Increment store index.
000085r 2  D0 B5                        BNE     NEXTITEM        ; Get next item (no carry).
000087r 2  E6 27                        INC     STH             ; Add carry to 'store index' high order.
000089r 2  4C rr rr     TONEXTITEM:     JMP     NEXTITEM        ; Get next command item.
00008Cr 2               
00008Cr 2               RUNPROG:
00008Cr 2  6C 24 00                     JMP     (XAML)          ; Run at current XAM index.
00008Fr 2               
00008Fr 2               NOTSTOR:
00008Fr 2  30 30                        BMI     XAMNEXT         ; B7 = 0 for XAM, 1 for BLOCK XAM.
000091r 2               
000091r 2  A2 02                        LDX     #$02            ; Byte count.
000093r 2  B5 27        SETADR:         LDA     L-1,X           ; Copy hex data to
000095r 2  95 25                        STA     STL-1,X         ;  'store index'.
000097r 2  95 23                        STA     XAML-1,X        ; And to 'XAM index'.
000099r 2  CA                           DEX                     ; Next of 2 bytes.
00009Ar 2  D0 F7                        BNE     SETADR          ; Loop unless X = 0.
00009Cr 2               
00009Cr 2               NXTPRNT:
00009Cr 2  D0 19                        BNE     PRDATA          ; NE means no address to print.
00009Er 2  A9 0D                        LDA     #$0D            ; CR.
0000A0r 2  20 rr rr                     JSR     ECHO            ; Output it.
0000A3r 2  A9 0A                        LDA     #$0A            ; LF.
0000A5r 2  20 rr rr                     JSR     ECHO            ; Output it.
0000A8r 2  A5 25                        LDA     XAMH            ; 'Examine index' high-order byte.
0000AAr 2  20 rr rr                     JSR     PRBYTE          ; Output it in hex format.
0000ADr 2  A5 24                        LDA     XAML            ; Low-order 'examine index' byte.
0000AFr 2  20 rr rr                     JSR     PRBYTE          ; Output it in hex format.
0000B2r 2  A9 3A                        LDA     #$3A            ; ":".
0000B4r 2  20 rr rr                     JSR     ECHO            ; Output it.
0000B7r 2               
0000B7r 2               PRDATA:
0000B7r 2  A9 20                        LDA     #$20            ; Blank.
0000B9r 2  20 rr rr                     JSR     ECHO            ; Output it.
0000BCr 2  A1 24                        LDA     (XAML,X)        ; Get data byte at 'examine index'.
0000BEr 2  20 rr rr                     JSR     PRBYTE          ; Output it in hex format.
0000C1r 2  86 2B        XAMNEXT:        STX     MODE            ; 0 -> MODE (XAM mode).
0000C3r 2  A5 24                        LDA     XAML
0000C5r 2  C5 28                        CMP     L               ; Compare 'examine index' to hex data.
0000C7r 2  A5 25                        LDA     XAMH
0000C9r 2  E5 29                        SBC     H
0000CBr 2  B0 BC                        BCS     TONEXTITEM      ; Not less, so no more data to output.
0000CDr 2               
0000CDr 2  E6 24                        INC     XAML
0000CFr 2  D0 02                        BNE     MOD8CHK         ; Increment 'examine index'.
0000D1r 2  E6 25                        INC     XAMH
0000D3r 2               
0000D3r 2               MOD8CHK:
0000D3r 2  A5 24                        LDA     XAML            ; Check low-order 'examine index' byte
0000D5r 2  29 07                        AND     #$07            ; For MOD 8 = 0
0000D7r 2  10 C3                        BPL     NXTPRNT         ; Always taken.
0000D9r 2               
0000D9r 2               PRBYTE:
0000D9r 2  48                           PHA                     ; Save A for LSD.
0000DAr 2  4A                           LSR
0000DBr 2  4A                           LSR
0000DCr 2  4A                           LSR                     ; MSD to LSD position.
0000DDr 2  4A                           LSR
0000DEr 2  20 rr rr                     JSR     PRHEX           ; Output hex digit.
0000E1r 2  68                           PLA                     ; Restore A.
0000E2r 2               
0000E2r 2               PRHEX:
0000E2r 2  29 0F                        AND     #$0F            ; Mask LSD for hex print.
0000E4r 2  09 30                        ORA     #$30            ; Add "0".
0000E6r 2  C9 3A                        CMP     #$3A            ; Digit?
0000E8r 2  90 02                        BCC     ECHO            ; Yes, output it.
0000EAr 2  69 06                        ADC     #$06            ; Add offset for letter.
0000ECr 2               
0000ECr 2               ECHO:
0000ECr 2  4C rr rr                     JMP     CHROUT          ; Output it (CHROUT preserves A, X and Y).
0000EFr 2               
0000EFr 2               ; ----------------------------------------------------------------------------
0000EFr 2               ; WOZ_GETC lives in the BIOS segment: the WOZMON segment only has the 250 bytes
0000EFr 2               ; between $FF00 and the vectors at $FFFA.
0000EFr 2               ; ----------------------------------------------------------------------------
0000EFr 2               .segment "BIOS"
002D78r 2               ; Wait for a character.  Letters are converted to upper case (the monitor only
002D78r 2               ; understands upper case hex and "R").  CTRL-C goes back to the boot menu.
002D78r 2               ; Preserves X and Y.
002D78r 2               WOZ_GETC:
002D78r 2  20 rr rr                     JSR     CHRIN
002D7Br 2  90 FB                        BCC     WOZ_GETC
002D7Dr 2  C9 03                        CMP     #$03            ; CTRL-C?
002D7Fr 2  D0 03                        BNE     @notcc
002D81r 2  4C rr rr                     JMP     MENU            ; Yes: back to the boot menu.
002D84r 2  C9 61        @notcc:         CMP     #'a'
002D86r 2  90 06                        BCC     @done
002D88r 2  C9 7B                        CMP     #'z'+1
002D8Ar 2  B0 02                        BCS     @done
002D8Cr 2  29 DF                        AND     #$DF            ; "a".."z" -> "A".."Z"
002D8Er 2  60           @done:          RTS
002D8Fr 2               
002D8Fr 1               .include "monitor_cmds.s"       ; monitor commands ? and L  (BIOS)
002D8Fr 2               ; ============================================================================
002D8Fr 2               ; monitor_cmds.s - extra wozmon commands
002D8Fr 2               ;
002D8Fr 2               ; wozmon.s calls MON_HOOK when Enter is pressed, before it parses the line.
002D8Fr 2               ; MON_HOOK looks at the start of the line in the input buffer IN ($0200):
002D8Fr 2               ;
002D8Fr 2               ;   ?                   list the commands
002D8Fr 2               ;   L                   list the files in the current directory
002D8Fr 2               ;   L U:  /  L C:       switch to the USB drive / the CF card (then its root)
002D8Fr 2               ;   L DIR               change into directory DIR     L ..  up one level
002D8Fr 2               ;   L \  or  L /        back to the root directory     L A/B  several levels
002D8Fr 2               ;   L NAME [XXXX]       load NAME.BIN (from the current directory) into RAM at XXXX.
002D8Fr 2               ;                       Without XXXX the file goes to the last address used in
002D8Fr 2               ;                       the monitor (type the address, Enter, then L NAME).
002D8Fr 2               ;                       ".BIN" is added if NAME has no extension.
002D8Fr 2               ;                       Allowed targets: USER_RAM-$7EFF (config.inc).  Afterwards the monitor's
002D8Fr 2               ;                       current address is the load address, so  R  runs it.
002D8Fr 2               ;
002D8Fr 2               ; Returns carry set = line was a command and is finished, clear = not ours.
002D8Fr 2               ; "L" and "?" are not hex digits so they never clash with wozmon's own syntax.
002D8Fr 2               ; ============================================================================
002D8Fr 2               .segment "BIOS"
002D8Fr 2               
002D8Fr 2               MON_LOAD_MIN = USER_RAM
002D8Fr 2               MON_LOAD_TOP = $7F00                ; first address that is NOT loadable (I/O)
002D8Fr 2               
002D8Fr 2               MON_HOOK:
002D8Fr 2  AD 00 02             lda     IN
002D92r 2  C9 3F                cmp     #'?'
002D94r 2  D0 09                bne     @notq
002D96r 2  A9 rr                lda     #<mon_help
002D98r 2  A0 rr                ldy     #>mon_help
002D9Ar 2  20 rr rr             jsr     mon_puts
002D9Dr 2  38                   sec
002D9Er 2  60                   rts
002D9Fr 2  C9 54        @notq:  cmp     #'T'
002DA1r 2  D0 03                bne     @nott
002DA3r 2  4C rr rr             jmp     mon_time
002DA6r 2  C9 4C        @nott:  cmp     #'L'
002DA8r 2  D0 0B                bne     @not
002DAAr 2  AC 01 02             ldy     IN+1
002DADr 2  C0 0D                cpy     #$0D
002DAFr 2  F0 06                beq     @dir
002DB1r 2  C0 20                cpy     #' '
002DB3r 2  F0 4E                beq     @load
002DB5r 2  18           @not:   clc
002DB6r 2  60                   rts
002DB7r 2               
002DB7r 2               ; ---- L : list the current directory -------------------------------------------
002DB7r 2  A9 01        @dir:   lda     #1
002DB9r 2  8D rr rr             sta     ch_mon
002DBCr 2  20 rr rr             jsr     fs_prepare
002DBFr 2  90 05                bcc     @lp
002DC1r 2  A9 F2                lda     #CH_E_NODISK
002DC3r 2  4C rr rr             jmp     ch_fail
002DC6r 2  20 rr rr     @lp:    jsr     mon_copy_cwd        ; X = length of the current directory
002DC9r 2  8E rr rr             stx     mon_end
002DCCr 2  E0 00                cpx     #0
002DCEr 2  F0 0E                beq     @lroot
002DD0r 2  20 rr rr             jsr     mon_enter           ; open it, step by step (name "*" is then relative)
002DD3r 2  C9 41                cmp     #ERR_OPEN_DIR
002DD5r 2  F0 03                beq     @lrel
002DD7r 2  4C rr rr             jmp     ch_fail
002DDAr 2  A2 00        @lrel:  ldx     #0                  ; ch_name = "*"
002DDCr 2  F0 07                beq     @lset
002DDEr 2  A2 01        @lroot: ldx     #1                  ; ch_name = "/*"
002DE0r 2  A9 2F                lda     #'/'
002DE2r 2  8D rr rr             sta     ch_name
002DE5r 2  A9 2A        @lset:  lda     #'*'
002DE7r 2  9D rr rr             sta     ch_name,x
002DEAr 2  A9 00                lda     #0
002DECr 2  9D rr rr             sta     ch_name+1,x
002DEFr 2  20 rr rr             jsr     mon_showcwd         ; CR LF, "/GAMES"
002DF2r 2  A9 rr                lda     #<mon_crlf
002DF4r 2  A0 rr                ldy     #>mon_crlf
002DF6r 2  20 rr rr             jsr     mon_puts
002DF9r 2  20 rr rr             jsr     fs_dirlist
002DFCr 2  A9 00                lda     #0
002DFEr 2  8D rr rr             sta     ch_mon
002E01r 2  38                   sec
002E02r 2  60                   rts
002E03r 2               
002E03r 2               ; ---- L PATH [XXXX] : change directory, or load a file ---------------------------
002E03r 2               ; PATH is relative to the current directory; "..", ".", a leading "/" or "\"
002E03r 2               ; and several parts ("GAMES/DEEP") are understood.  A PATH that names a directory
002E03r 2               ; changes into it, anything else is a file (".BIN" is added when it has no ".").
002E03r 2  A0 01        @load:  ldy     #1
002E05r 2  B9 00 02     @sp1:   lda     IN,y                ; skip blanks
002E08r 2  C9 20                cmp     #' '
002E0Ar 2  D0 03                bne     @a1
002E0Cr 2  C8                   iny
002E0Dr 2  D0 F6                bne     @sp1
002E0Fr 2  C9 0D        @a1:    cmp     #$0D
002E11r 2  F0 A4                beq     @dir                ; "L   " = list
002E13r 2  BE 01 02             ldx     IN+1,y              ; "U:" / "C:" = the other device
002E16r 2  E0 3A                cpx     #':'
002E18r 2  D0 0D                bne     @nodev
002E1Ar 2  20 rr rr             jsr     mon_device
002E1Dr 2  90 03                bcc     :+
002E1Fr 2  4C rr rr             jmp     mon_badpath
002E22r 2  C8           :       iny
002E23r 2  C8                   iny
002E24r 2  4C rr rr             jmp     @sp1
002E27r 2  8C rr rr     @nodev: sty     mon_y
002E2Ar 2  20 rr rr             jsr     mon_path            ; ch_name = new path
002E2Dr 2  90 03                bcc     @pok
002E2Fr 2  4C rr rr             jmp     mon_badpath
002E32r 2  AD rr rr     @pok:   lda     mon_kind
002E35r 2  D0 5C                bne     @cd                 ; ends in "..", "." or "/": a directory
002E37r 2  AD rr rr             lda     mon_x
002E3Ar 2  F0 57                beq     @cd                 ; the root
002E3Cr 2  AD rr rr             lda     mon_flag
