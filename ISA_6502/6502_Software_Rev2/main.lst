000D4Er 2  C9 02                cmp     #2
000D50r 2  F0 1D                beq     @fill
000D52r 2  20 rr rr             jsr     @set00                  ; top: (x0,y0) - (x1,y0)
000D55r 2  20 rr rr             jsr     @to10
000D58r 2  20 rr rr             jsr     pv_line
000D5Br 2  20 rr rr             jsr     @to11                   ; right: on to (x1,y1)
000D5Er 2  20 rr rr             jsr     pv_line
000D61r 2  20 rr rr             jsr     @to01                   ; bottom: on to (x0,y1)
000D64r 2  20 rr rr             jsr     pv_line
000D67r 2  20 rr rr             jsr     @to00                   ; left: back to (x0,y0)
000D6Ar 2  20 rr rr             jsr     pv_line
000D6Dr 2  28                   plp
000D6Er 2  60                   rts
000D6Fr 2  20 rr rr     @fill:  jsr     @set00                  ; one line per row, y0 to y1
000D72r 2  20 rr rr     @row:   jsr     @to10x                  ; (x0,y) - (x1,y)
000D75r 2  AD rr rr             lda     gfx_y
000D78r 2  48                   pha
000D79r 2  AD rr rr             lda     gfx_y+1
000D7Cr 2  48                   pha
000D7Dr 2  20 rr rr             jsr     pv_line
000D80r 2  68                   pla
000D81r 2  8D rr rr             sta     gfx_y+1
000D84r 2  68                   pla
000D85r 2  8D rr rr             sta     gfx_y
000D88r 2  AD rr rr             lda     gfx_y                   ; last row?
000D8Br 2  CD rr rr             cmp     pb_y1
000D8Er 2  D0 08                bne     @nx
000D90r 2  AD rr rr             lda     gfx_y+1
000D93r 2  CD rr rr             cmp     pb_y1+1
000D96r 2  F0 12                beq     @end
000D98r 2  AD rr rr     @nx:    lda     pb_x0                   ; back to x0, next row towards y1
000D9Br 2  8D rr rr             sta     gfx_x
000D9Er 2  AD rr rr             lda     pb_x0+1
000DA1r 2  8D rr rr             sta     gfx_x+1
000DA4r 2  20 rr rr             jsr     @ystep
000DA7r 2  4C rr rr             jmp     @row
000DAAr 2  28           @end:   plp
000DABr 2  60                   rts
000DACr 2               
000DACr 2  AD rr rr     @set00: lda     pb_x0
000DAFr 2  8D rr rr             sta     gfx_x
000DB2r 2  AD rr rr             lda     pb_x0+1
000DB5r 2  8D rr rr             sta     gfx_x+1
000DB8r 2  AD rr rr             lda     pb_y0
000DBBr 2  8D rr rr             sta     gfx_y
000DBEr 2  AD rr rr             lda     pb_y0+1
000DC1r 2  8D rr rr             sta     gfx_y+1
000DC4r 2  60                   rts
000DC5r 2  AD rr rr     @to10:  lda     pb_y0                   ; target (x1, y0)
000DC8r 2  8D rr rr             sta     gfx_y1
000DCBr 2  AD rr rr             lda     pb_y0+1
000DCEr 2  8D rr rr             sta     gfx_y1+1
000DD1r 2  AD rr rr     @to10x: lda     pb_x1                   ; target x1, current row
000DD4r 2  8D rr rr             sta     gfx_x1
000DD7r 2  AD rr rr             lda     pb_x1+1
000DDAr 2  8D rr rr             sta     gfx_x1+1
000DDDr 2  AD rr rr             lda     gfx_y
000DE0r 2  8D rr rr             sta     gfx_y1
000DE3r 2  AD rr rr             lda     gfx_y+1
000DE6r 2  8D rr rr             sta     gfx_y1+1
000DE9r 2  60                   rts
000DEAr 2  AD rr rr     @to11:  lda     pb_x1
000DEDr 2  8D rr rr             sta     gfx_x1
000DF0r 2  AD rr rr             lda     pb_x1+1
000DF3r 2  8D rr rr             sta     gfx_x1+1
000DF6r 2  AD rr rr             lda     pb_y1
000DF9r 2  8D rr rr             sta     gfx_y1
000DFCr 2  AD rr rr             lda     pb_y1+1
000DFFr 2  8D rr rr             sta     gfx_y1+1
000E02r 2  60                   rts
000E03r 2  AD rr rr     @to01:  lda     pb_x0
000E06r 2  8D rr rr             sta     gfx_x1
000E09r 2  AD rr rr             lda     pb_x0+1
000E0Cr 2  8D rr rr             sta     gfx_x1+1
000E0Fr 2  AD rr rr             lda     pb_y1
000E12r 2  8D rr rr             sta     gfx_y1
000E15r 2  AD rr rr             lda     pb_y1+1
000E18r 2  8D rr rr             sta     gfx_y1+1
000E1Br 2  60                   rts
000E1Cr 2  AD rr rr     @to00:  lda     pb_x0
000E1Fr 2  8D rr rr             sta     gfx_x1
000E22r 2  AD rr rr             lda     pb_x0+1
000E25r 2  8D rr rr             sta     gfx_x1+1
000E28r 2  AD rr rr             lda     pb_y0
000E2Br 2  8D rr rr             sta     gfx_y1
000E2Er 2  AD rr rr             lda     pb_y0+1
000E31r 2  8D rr rr             sta     gfx_y1+1
000E34r 2  60                   rts
000E35r 2  AD rr rr     @ystep: lda     gfx_y                   ; y one step towards pb_y1
000E38r 2  CD rr rr             cmp     pb_y1
000E3Br 2  AD rr rr             lda     gfx_y+1
000E3Er 2  ED rr rr             sbc     pb_y1+1
000E41r 2  B0 09                bcs     @yd                     ; y >= y1: down
000E43r 2  EE rr rr             inc     gfx_y
000E46r 2  D0 03                bne     :+
000E48r 2  EE rr rr             inc     gfx_y+1
000E4Br 2  60           :       rts
000E4Cr 2  AD rr rr     @yd:    lda     gfx_y
000E4Fr 2  D0 03                bne     :+
000E51r 2  CE rr rr             dec     gfx_y+1
000E54r 2  CE rr rr     :       dec     gfx_y
000E57r 2  60                   rts
000E58r 2               
000E58r 2               ; ----------------------------------------------------------------------------
000E58r 2               ; pico_gcircle - circle centre gfx_x, gfx_y, radius gfx_r, colour gfx_c;
000E58r 2               ; gfx_f = 1 filled (midpoint circle)
000E58r 2               ; ----------------------------------------------------------------------------
000E58r 2               pico_gcircle:
000E58r 2  08                   php
000E59r 2  78                   sei
000E5Ar 2  A2 03                ldx     #3                      ; keep the centre
000E5Cr 2  BD rr rr     @k:     lda     gfx_x,x
000E5Fr 2  9D rr rr             sta     pc_cx,x
000E62r 2  CA                   dex
000E63r 2  10 F7                bpl     @k
000E65r 2  A9 00                lda     #0
000E67r 2  8D rr rr             sta     pc_x
000E6Ar 2  AD rr rr             lda     gfx_r
000E6Dr 2  8D rr rr             sta     pc_y
000E70r 2  38                   sec                             ; d = 1 - r
000E71r 2  A9 01                lda     #1
000E73r 2  ED rr rr             sbc     gfx_r
000E76r 2  8D rr rr             sta     pc_d
000E79r 2  A9 00                lda     #0
000E7Br 2  E9 00                sbc     #0
000E7Dr 2  8D rr rr             sta     pc_d+1
000E80r 2  AD rr rr     @loop:  lda     pc_y                    ; while x <= y
000E83r 2  CD rr rr             cmp     pc_x
000E86r 2  B0 03                bcs     :+
000E88r 2  4C rr rr             jmp     @done
000E8Br 2               :
000E8Br 2  AD rr rr             lda     pc_x                    ; the eight points (or four spans)
000E8Er 2  8D rr rr             sta     pc_a
000E91r 2  AD rr rr             lda     pc_y
000E94r 2  8D rr rr             sta     pc_b
000E97r 2  20 rr rr             jsr     pv_quad
000E9Ar 2  AD rr rr             lda     pc_y
000E9Dr 2  8D rr rr             sta     pc_a
000EA0r 2  AD rr rr             lda     pc_x
000EA3r 2  8D rr rr             sta     pc_b
000EA6r 2  20 rr rr             jsr     pv_quad
000EA9r 2  AD rr rr             lda     pc_d+1
000EACr 2  10 1E                bpl     @dpos
000EAEr 2  AD rr rr             lda     pc_x                    ; d < 0: d += 2x + 3
000EB1r 2  0A                   asl     a
000EB2r 2  8D rr rr             sta     pc_t
000EB5r 2  A9 00                lda     #0
000EB7r 2  2A                   rol     a
000EB8r 2  8D rr rr             sta     pc_t+1
000EBBr 2  18                   clc
000EBCr 2  AD rr rr             lda     pc_t
000EBFr 2  69 03                adc     #3
000EC1r 2  8D rr rr             sta     pc_t
000EC4r 2  90 03                bcc     :+
000EC6r 2  EE rr rr             inc     pc_t+1
000EC9r 2  4C rr rr     :       jmp     @addd
000ECCr 2  AD rr rr     @dpos:  lda     pc_y                    ; d >= 0: d += 2(x - y) + 5, y -= 1
000ECFr 2  F0 44                beq     @done                   ; (y = 0: finished)
000ED1r 2  38                   sec
000ED2r 2  AD rr rr             lda     pc_x
000ED5r 2  ED rr rr             sbc     pc_y
000ED8r 2  8D rr rr             sta     pc_t
000EDBr 2  A9 00                lda     #0
000EDDr 2  E9 00                sbc     #0
000EDFr 2  8D rr rr             sta     pc_t+1
000EE2r 2  0E rr rr             asl     pc_t
000EE5r 2  2E rr rr             rol     pc_t+1
000EE8r 2  18                   clc
000EE9r 2  AD rr rr             lda     pc_t
000EECr 2  69 05                adc     #5
000EEEr 2  8D rr rr             sta     pc_t
000EF1r 2  AD rr rr             lda     pc_t+1
000EF4r 2  69 00                adc     #0
000EF6r 2  8D rr rr             sta     pc_t+1
000EF9r 2  CE rr rr             dec     pc_y
000EFCr 2  18           @addd:  clc
000EFDr 2  AD rr rr             lda     pc_d
000F00r 2  6D rr rr             adc     pc_t
000F03r 2  8D rr rr             sta     pc_d
000F06r 2  AD rr rr             lda     pc_d+1
000F09r 2  6D rr rr             adc     pc_t+1
000F0Cr 2  8D rr rr             sta     pc_d+1
000F0Fr 2  EE rr rr             inc     pc_x
000F12r 2  4C rr rr             jmp     @loop
000F15r 2  28           @done:  plp
000F16r 2  60                   rts
000F17r 2               
000F17r 2               ; pv_quad - the 4 points (cx +- a, cy +- b), or with gfx_f the 2 spans
000F17r 2               ; cx - a ... cx + a on the rows cy +- b
000F17r 2               pv_quad:
000F17r 2  AD rr rr             lda     gfx_f
000F1Ar 2  D0 10                bne     @fill
000F1Cr 2  A0 03                ldy     #3
000F1Er 2  98           @p:     tya
000F1Fr 2  48                   pha
000F20r 2  20 rr rr             jsr     pv_cpt
000F23r 2  20 rr rr             jsr     pv_pset
000F26r 2  68                   pla
000F27r 2  A8                   tay
000F28r 2  88                   dey
000F29r 2  10 F3                bpl     @p
000F2Br 2  60                   rts
000F2Cr 2  A0 01        @fill:  ldy     #1
000F2Er 2  20 rr rr             jsr     pv_span
000F31r 2  A0 03                ldy     #3
000F33r 2                       ; (on into pv_span)
000F33r 2               pv_span:
000F33r 2  20 rr rr             jsr     pv_cpt                  ; gfx_x = cx - a, gfx_y = cy +- b
000F36r 2  AD rr rr             lda     pc_a                    ; 2a + 1 points
000F39r 2  0A                   asl     a
000F3Ar 2  8D rr rr             sta     pc_n
000F3Dr 2  A9 00                lda     #0
000F3Fr 2  2A                   rol     a
000F40r 2  8D rr rr             sta     pc_n+1
000F43r 2  EE rr rr             inc     pc_n
000F46r 2  D0 03                bne     @l
000F48r 2  EE rr rr             inc     pc_n+1
000F4Br 2  20 rr rr     @l:     jsr     pv_pset
000F4Er 2  EE rr rr             inc     gfx_x
000F51r 2  D0 03                bne     :+
000F53r 2  EE rr rr             inc     gfx_x+1
000F56r 2  AD rr rr     :       lda     pc_n
000F59r 2  D0 03                bne     :+
000F5Br 2  CE rr rr             dec     pc_n+1
000F5Er 2  CE rr rr     :       dec     pc_n
000F61r 2  AD rr rr             lda     pc_n
000F64r 2  0D rr rr             ora     pc_n+1
000F67r 2  D0 E2                bne     @l
000F69r 2  60                   rts
000F6Ar 2               
000F6Ar 2               ; pv_cpt - gfx_x = cx +- pc_a (Y bit 0: minus), gfx_y = cy +- pc_b (bit 1)
000F6Ar 2               pv_cpt:
000F6Ar 2  98                   tya
000F6Br 2  29 01                and     #1
000F6Dr 2  D0 15                bne     @xm
000F6Fr 2  18                   clc
000F70r 2  AD rr rr             lda     pc_cx
000F73r 2  6D rr rr             adc     pc_a
000F76r 2  8D rr rr             sta     gfx_x
000F79r 2  AD rr rr             lda     pc_cx+1
000F7Cr 2  69 00                adc     #0
000F7Er 2  8D rr rr             sta     gfx_x+1
000F81r 2  4C rr rr             jmp     @y
000F84r 2  38           @xm:    sec
000F85r 2  AD rr rr             lda     pc_cx
000F88r 2  ED rr rr             sbc     pc_a
000F8Br 2  8D rr rr             sta     gfx_x
000F8Er 2  AD rr rr             lda     pc_cx+1
000F91r 2  E9 00                sbc     #0
000F93r 2  8D rr rr             sta     gfx_x+1
000F96r 2  98           @y:     tya
000F97r 2  29 02                and     #2
000F99r 2  D0 13                bne     @ym
000F9Br 2  18                   clc
000F9Cr 2  AD rr rr             lda     pc_cy
000F9Fr 2  6D rr rr             adc     pc_b
000FA2r 2  8D rr rr             sta     gfx_y
000FA5r 2  AD rr rr             lda     pc_cy+1
000FA8r 2  69 00                adc     #0
000FAAr 2  8D rr rr             sta     gfx_y+1
000FADr 2  60                   rts
000FAEr 2  38           @ym:    sec
000FAFr 2  AD rr rr             lda     pc_cy
000FB2r 2  ED rr rr             sbc     pc_b
000FB5r 2  8D rr rr             sta     gfx_y
000FB8r 2  AD rr rr             lda     pc_cy+1
000FBBr 2  E9 00                sbc     #0
000FBDr 2  8D rr rr             sta     gfx_y+1
000FC0r 2  60                   rts
000FC1r 2               
000FC1r 2               ; ----------------------------------------------------------------------------
000FC1r 2               ; pico_gsprite - sprite gfx_n (0-31): pattern gfx_p (0-63), at gfx_x, gfx_y,
000FC1r 2               ; colour gfx_c (0-15).  y 192 or more hides it.  Graphics II only.
000FC1r 2               ; ----------------------------------------------------------------------------
000FC1r 2               pico_gsprite:
000FC1r 2  AD rr rr             lda     pico_mode
000FC4r 2  F0 3E                beq     @x
000FC6r 2  08                   php
000FC7r 2  78                   sei
000FC8r 2  AD rr rr             lda     gfx_n                   ; attribute address $3B00 + n * 4
000FCBr 2  29 1F                and     #$1F
000FCDr 2  0A                   asl     a
000FCEr 2  0A                   asl     a
000FCFr 2  A2 3B                ldx     #>G2_SATTR
000FD1r 2  20 rr rr             jsr     pv_waddr
000FD4r 2  AD rr rr             lda     gfx_y+1                 ; y (the VDP shows y + 1)
000FD7r 2  D0 0D                bne     @hide
000FD9r 2  AD rr rr             lda     gfx_y
000FDCr 2  C9 C0                cmp     #192
000FDEr 2  B0 06                bcs     @hide
000FE0r 2  38                   sec
000FE1r 2  E9 01                sbc     #1
000FE3r 2  4C rr rr             jmp     @y
000FE6r 2  A9 C0        @hide:  lda     #192
000FE8r 2  8D 1C 7F     @y:     sta     PICO_DATA
000FEBr 2                       VW
000FEBr 2  AD rr rr             lda     gfx_x
000FEEr 2  8D 1C 7F             sta     PICO_DATA
000FF1r 2                       VW
000FF1r 2  AD rr rr             lda     gfx_p                   ; 16x16: pattern * 4
000FF4r 2  29 3F                and     #$3F
000FF6r 2  0A                   asl     a
000FF7r 2  0A                   asl     a
000FF8r 2  8D 1C 7F             sta     PICO_DATA
000FFBr 2                       VW
000FFBr 2  AD rr rr             lda     gfx_c
000FFEr 2  29 0F                and     #$0F
001000r 2  8D 1C 7F             sta     PICO_DATA
001003r 2                       VW
001003r 2  28                   plp
001004r 2  60           @x:     rts
001005r 2               
001005r 2               ; pico_gsprdef - sprite pattern gfx_p (0-63) = the 32 bytes at con_ptr
001005r 2               ; (16x16: left column top to bottom, then the right column, as the TMS9918A)
001005r 2               pico_gsprdef:
001005r 2  2C rr rr             bit     pico_ok
001008r 2  10 2C                bpl     @x
00100Ar 2  08                   php
00100Br 2  78                   sei
00100Cr 2  AD rr rr             lda     gfx_p                   ; $1800 + p * 32
00100Fr 2  29 3F                and     #$3F
001011r 2  8D rr rr             sta     pico_t0
001014r 2  A9 00                lda     #0
001016r 2  A2 05                ldx     #5
001018r 2  0E rr rr     @m:     asl     pico_t0
00101Br 2  2A                   rol     a
00101Cr 2  CA                   dex
00101Dr 2  D0 F9                bne     @m
00101Fr 2  18                   clc
001020r 2  69 18                adc     #>G2_SPAT
001022r 2  AA                   tax
001023r 2  AD rr rr             lda     pico_t0
001026r 2  20 rr rr             jsr     pv_waddr
001029r 2  A0 00                ldy     #0
00102Br 2  B1 rr        @l:     lda     (con_ptr),y
00102Dr 2  8D 1C 7F             sta     PICO_DATA
001030r 2                       VW
001030r 2  C8                   iny
001031r 2  C0 20                cpy     #32
001033r 2  D0 F6                bne     @l
001035r 2  28                   plp
001036r 2  60           @x:     rts
001037r 2               
001037r 2               ; ----------------------------------------------------------------------------
001037r 2               ; pico_vsync - C=1 if a frame has ended since the last call; A = the status
001037r 2               ; bits (5th sprite / collision) seen since then.
001037r 2               ; ----------------------------------------------------------------------------
001037r 2               pico_vsync:
001037r 2               .if PICO_IRQ
001037r 2                       php
001037r 2                       sei
001037r 2                       lda     pico_st
001037r 2                       ldx     #0
001037r 2                       stx     pico_st
001037r 2                       plp
001037r 2               .else
001037r 2  08                   php
001038r 2  78                   sei
001039r 2  AD 1D 7F             lda     PICO_CTRL               ; status: bit 7 = frame ended
00103Cr 2  8D rr rr             sta     pico_t0
00103Fr 2  28                   plp
001040r 2  AD rr rr             lda     pico_t0
001043r 2               .endif
001043r 2  C9 80                cmp     #$80                    ; C = bit 7
001045r 2  60                   rts
001046r 2               
001046r 2               ; pico_irq - from irq.s (PICO_IRQ): read the status (that clears the VDP's
001046r 2               ; interrupt) and keep its bits for pico_vsync.  C=1 if it was a frame.
001046r 2               pico_irq:
001046r 2  2C rr rr             bit     pico_ok
001049r 2  10 0D                bpl     @no
00104Br 2  AD 1D 7F             lda     PICO_CTRL
00104Er 2  10 08                bpl     @no
001050r 2  0D rr rr             ora     pico_st
001053r 2  8D rr rr             sta     pico_st
001056r 2  38                   sec
001057r 2  60                   rts
001058r 2  18           @no:    clc
001059r 2  60                   rts
00105Ar 2               
00105Ar 2               .include "pico_font.inc"
00105Ar 3               ; pico_font.inc - 5x8 font for the PICO9918 text modes, characters $20-$7F
00105Ar 3               ; (8 bytes a character, top row first, bit 7 = leftmost pixel; the TMS text
00105Ar 3               ; modes show bits 7-2).  From the X11 'koi5x8' font (public domain misc-fixed
00105Ar 3               ; family); $7F is a block, used for nothing by the console.
00105Ar 3               pico_font:
00105Ar 3  00 00 00 00          .byte   $00,$00,$00,$00,$00,$00,$00,$00   ; $20
00105Er 3  00 00 00 00  
001062r 3  00 20 20 20          .byte   $00,$20,$20,$20,$20,$00,$20,$00   ; $21 !
001066r 3  20 00 20 00  
00106Ar 3  00 50 50 50          .byte   $00,$50,$50,$50,$00,$00,$00,$00   ; $22 "
00106Er 3  00 00 00 00  
001072r 3  50 50 F8 50          .byte   $50,$50,$F8,$50,$F8,$50,$50,$00   ; $23 #
001076r 3  F8 50 50 00  
00107Ar 3  20 70 A0 70          .byte   $20,$70,$A0,$70,$28,$70,$20,$00   ; $24 $
00107Er 3  28 70 20 00  
001082r 3  00 40 50 20          .byte   $00,$40,$50,$20,$50,$10,$00,$00   ; $25 %
001086r 3  50 10 00 00  
00108Ar 3  40 A0 A0 40          .byte   $40,$A0,$A0,$40,$A0,$A0,$50,$00   ; $26 &
00108Er 3  A0 A0 50 00  
001092r 3  00 20 20 20          .byte   $00,$20,$20,$20,$00,$00,$00,$00   ; $27 '
001096r 3  00 00 00 00  
00109Ar 3  00 20 40 40          .byte   $00,$20,$40,$40,$40,$40,$20,$00   ; $28 (
00109Er 3  40 40 20 00  
0010A2r 3  00 40 20 20          .byte   $00,$40,$20,$20,$20,$20,$40,$00   ; $29 )
0010A6r 3  20 20 40 00  
0010AAr 3  00 00 90 60          .byte   $00,$00,$90,$60,$F0,$60,$90,$00   ; $2A *
0010AEr 3  F0 60 90 00  
0010B2r 3  00 00 20 20          .byte   $00,$00,$20,$20,$F8,$20,$20,$00   ; $2B +
0010B6r 3  F8 20 20 00  
0010BAr 3  00 00 00 00          .byte   $00,$00,$00,$00,$00,$30,$20,$40   ; $2C ,
0010BEr 3  00 30 20 40  
0010C2r 3  00 00 00 00          .byte   $00,$00,$00,$00,$F0,$00,$00,$00   ; $2D -
0010C6r 3  F0 00 00 00  
0010CAr 3  00 00 00 00          .byte   $00,$00,$00,$00,$00,$20,$70,$20   ; $2E .
0010CEr 3  00 20 70 20  
0010D2r 3  00 10 10 20          .byte   $00,$10,$10,$20,$40,$80,$80,$00   ; $2F /
0010D6r 3  40 80 80 00  
0010DAr 3  00 20 50 50          .byte   $00,$20,$50,$50,$50,$50,$20,$00   ; $30 0
0010DEr 3  50 50 20 00  
0010E2r 3  00 20 60 20          .byte   $00,$20,$60,$20,$20,$20,$70,$00   ; $31 1
0010E6r 3  20 20 70 00  
0010EAr 3  00 60 90 10          .byte   $00,$60,$90,$10,$60,$80,$F0,$00   ; $32 2
0010EEr 3  60 80 F0 00  
0010F2r 3  00 F0 20 60          .byte   $00,$F0,$20,$60,$10,$90,$60,$00   ; $33 3
0010F6r 3  10 90 60 00  
0010FAr 3  00 20 60 A0          .byte   $00,$20,$60,$A0,$F0,$20,$20,$00   ; $34 4
0010FEr 3  F0 20 20 00  
001102r 3  00 F0 80 E0          .byte   $00,$F0,$80,$E0,$10,$90,$60,$00   ; $35 5
