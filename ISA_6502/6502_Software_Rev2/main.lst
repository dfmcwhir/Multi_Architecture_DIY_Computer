0036DFr 2  8E rr rr             stx     mon_end
0036E2r 2  E0 00                cpx     #0
0036E4r 2  F0 0E                beq     @root
0036E6r 2  20 rr rr             jsr     mon_enter
0036E9r 2  C9 41                cmp     #ERR_OPEN_DIR
0036EBr 2  F0 03                beq     @rel
0036EDr 2  4C rr rr             jmp     dir_fail
0036F0r 2  A2 00        @rel:   ldx     #0
0036F2r 2  F0 07                beq     @set
0036F4r 2  A2 01        @root:  ldx     #1
0036F6r 2  A9 2F                lda     #'/'
0036F8r 2  8D rr rr             sta     ch_name
0036FBr 2  A9 2A        @set:   lda     #'*'
0036FDr 2  9D rr rr             sta     ch_name,x
003700r 2  A9 00                lda     #0
003702r 2  9D rr rr             sta     ch_name+1,x
003705r 2  20 rr rr             jsr     fs_dirlist
003708r 2  A9 0D                lda     #13                 ; (a last line without its end)
00370Ar 2  20 rr rr             jsr     dir_char
00370Dr 2  A9 00                lda     #0
00370Fr 2  8D rr rr             sta     dir_cap
003712r 2  8D rr rr             sta     ch_mon
003715r 2  AD rr rr             lda     dir_n
003718r 2  18                   clc
003719r 2  60                   rts
00371Ar 2               
00371Ar 2               ; dir_fail - an error while listing (also from ch_fail): back to SBC_DIR's
00371Ar 2               ; caller, C=1, A = the code
