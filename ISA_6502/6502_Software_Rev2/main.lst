003841r 2  60                   rts
003842r 2               ; dir_ent+12..15 * 10 (= * 2 + * 8)
003842r 2  0E rr rr     dp_x10: asl     dir_ent+12
003845r 2  2E rr rr             rol     dir_ent+13
003848r 2  2E rr rr             rol     dir_ent+14
00384Br 2  2E rr rr             rol     dir_ent+15
00384Er 2  A0 03                ldy     #3
003850r 2  B9 rr rr     @k:     lda     dir_ent+12,y
003853r 2  99 rr rr             sta     dir_t,y
003856r 2  88                   dey
003857r 2  10 F7                bpl     @k
003859r 2  A0 02                ldy     #2
00385Br 2  0E rr rr     @s:     asl     dir_ent+12
00385Er 2  2E rr rr             rol     dir_ent+13
003861r 2  2E rr rr             rol     dir_ent+14
003864r 2  2E rr rr             rol     dir_ent+15
003867r 2  88                   dey
003868r 2  D0 F1                bne     @s
00386Ar 2  18                   clc
00386Br 2  A0 00                ldy     #0
00386Dr 2  B9 rr rr     @a:     lda     dir_ent+12,y
003870r 2  79 rr rr             adc     dir_t,y
003873r 2  99 rr rr             sta     dir_ent+12,y
003876r 2  C8                   iny
003877r 2  98                   tya
003878r 2  49 04                eor     #4
00387Ar 2  D0 F1                bne     @a
00387Cr 2  60                   rts
00387Dr 2               
00387Dr 2               ; ----------------------------------------------------------------------------
00387Dr 2               ; SBC_RUN - load a program from the current folder (SBC_CWD) and start it
00387Dr 2               ;   In : A/Y = a block:  +0 .byte 0 = a program (.BIN, loaded and run at
00387Dr 2               ;                              $0800 in bank 0), 1 = a BASIC program (BASIC
00387Dr 2               ;                              is started, the program loaded and RUN)
00387Dr 2               ;                        +1 .byte the device: 'U', 'C' or 0 (as it is)
00387Dr 2               ;                        +2 the file name, 8.3, ending with a 0 byte
00387Dr 2               ;   Out: only on an error: C=1, A = the code (as SBC_LOAD's), the caller's
00387Dr 2               ;        bank selected again
00387Dr 2               ;   The display is put back to the text console and the mouse turned off
00387Dr 2               ;   before the program starts.  When it ends with JMP SBC_MENU, the shell
00387Dr 2               ;   (SBC_SHELL) runs again.
00387Dr 2               ; ----------------------------------------------------------------------------
00387Dr 2               sbc_run:
00387Dr 2  85 rr                sta     strptr
00387Fr 2  84 rr                sty     strptr+1
003881r 2  AD rr rr             lda     bank_cur
003884r 2  8D rr rr             sta     sh_cur
003887r 2  A0 01                ldy     #1
003889r 2  B1 rr                lda     (strptr),y
00388Br 2  F0 05                beq     @dev
00388Dr 2  20 rr rr             jsr     fs_letter
003890r 2  B0 18                bcs     @bad
003892r 2  A0 00        @dev:   ldy     #0
003894r 2  B1 rr                lda     (strptr),y
003896r 2  8D rr rr             sta     run_kind
003899r 2  A2 00                ldx     #0                  ; the name (before leaving the caller's bank)
00389Br 2  A0 02                ldy     #2
00389Dr 2  B1 rr        @c:     lda     (strptr),y
00389Fr 2  9D rr rr             sta     run_blk+4,x
0038A2r 2  F0 0A                beq     @cd
0038A4r 2  E8                   inx
0038A5r 2  C8                   iny
0038A6r 2  E0 0D                cpx     #13
0038A8r 2  90 F3                bcc     @c
0038AAr 2  A9 FE        @bad:   lda     #$FE
0038ACr 2  38                   sec
0038ADr 2  60                   rts
0038AEr 2  E0 00        @cd:    cpx     #0
0038B0r 2  F0 F8                beq     @bad
0038B2r 2  A9 00                lda     #<USER_RAM
0038B4r 2  8D rr rr             sta     run_blk
0038B7r 2  A9 08                lda     #>USER_RAM
0038B9r 2  8D rr rr             sta     run_blk+1
0038BCr 2  A9 00                lda     #<($7F00 - USER_RAM)
0038BEr 2  8D rr rr             sta     run_blk+2
0038C1r 2  A9 77                lda     #>($7F00 - USER_RAM)
0038C3r 2  8D rr rr             sta     run_blk+3
0038C6r 2  AD rr rr             lda     run_kind
0038C9r 2  D0 35                bne     run_bas
0038CBr 2  A9 00                lda     #0                  ; the program, into bank 0
0038CDr 2  20 rr rr             jsr     BANK_SET
0038D0r 2  A9 rr                lda     #<run_blk
0038D2r 2  A0 rr                ldy     #>run_blk
0038D4r 2  20 rr rr             jsr     SBC_LOAD
0038D7r 2  90 0A                bcc     :+
0038D9r 2  48                   pha                         ; failed: back to the caller
0038DAr 2  AD rr rr             lda     sh_cur
0038DDr 2  20 rr rr             jsr     BANK_SET
0038E0r 2  68                   pla
0038E1r 2  38                   sec
0038E2r 2  60                   rts
0038E3r 2  20 rr rr     :       jsr     run_prep
0038E6r 2  A2 FF                ldx     #$FF
0038E8r 2  9A                   txs
0038E9r 2  58                   cli
0038EAr 2  4C 00 08             jmp     USER_RAM
0038EDr 2               
0038EDr 2               ; run_prep - bank 0, quiet, the text console, no mouse, a clean input buffer
0038EDr 2               run_prep:
0038EDr 2  A9 00                lda     #0
0038EFr 2  20 rr rr             jsr     BANK_SET
0038F2r 2  20 rr rr             jsr     BI_QUIET
0038F5r 2  A9 00                lda     #0
0038F7r 2  20 rr rr             jsr     jt_mouseon
0038FAr 2  20 rr rr             jsr     jt_conreset
0038FDr 2  4C rr rr             jmp     INIT_BUFFER
003900r 2               
003900r 2               ; a BASIC program: BASIC's cold start, with the keys typed for it:
003900r 2               ;   Enter (the memory size), LOAD "path/NAME.BAS" Enter, RUN Enter
003900r 2               run_bas:
003900r 2  20 rr rr             jsr     run_prep
003903r 2  78                   sei
003904r 2  A9 0D                lda     #13
003906r 2  20 rr rr             jsr     CON_PUTKEY
003909r 2  A0 00                ldy     #0
00390Br 2  B9 rr rr     @l:     lda     run_load,y
00390Er 2  F0 06                beq     @path
003910r 2  20 rr rr             jsr     CON_PUTKEY
003913r 2  C8                   iny
003914r 2  D0 F5                bne     @l
003916r 2  AD rr rr     @path:  lda     fs_dev              ; "U:" or "C:"
003919r 2  A8                   tay
00391Ar 2  B9 rr rr             lda     run_dev,y
00391Dr 2  20 rr rr             jsr     CON_PUTKEY
003920r 2  A9 3A                lda     #':'
003922r 2  20 rr rr             jsr     CON_PUTKEY
003925r 2  A0 01                ldy     #1                  ; the folder without its first "/"
003927r 2  B9 rr rr     @p:     lda     mon_cwd,y
00392Ar 2  F0 06                beq     @pe
00392Cr 2  20 rr rr             jsr     CON_PUTKEY
00392Fr 2  C8                   iny
003930r 2  D0 F5                bne     @p
003932r 2  C0 01        @pe:    cpy     #1
003934r 2  F0 05                beq     @nm                 ; (the top folder)
003936r 2  A9 2F                lda     #'/'
003938r 2  20 rr rr             jsr     CON_PUTKEY
00393Br 2  A0 00        @nm:    ldy     #0
00393Dr 2  B9 rr rr     @n:     lda     run_blk+4,y
003940r 2  F0 06                beq     @ne
003942r 2  20 rr rr             jsr     CON_PUTKEY
003945r 2  C8                   iny
003946r 2  D0 F5                bne     @n
003948r 2  A0 00        @ne:    ldy     #0
00394Ar 2  B9 rr rr     @r:     lda     run_run,y
00394Dr 2  F0 06                beq     @go
00394Fr 2  20 rr rr             jsr     CON_PUTKEY
003952r 2  C8                   iny
003953r 2  D0 F5                bne     @r
003955r 2  58           @go:    cli
003956r 2  A2 FF                ldx     #$FF
003958r 2  9A                   txs
003959r 2  4C rr rr             jmp     LAB_COLD
00395Cr 2               run_load:
00395Cr 2  4C 4F 41 44          .byte   "LOAD ", '"', 0
003960r 2  20 22 00     
003963r 2               run_run:
003963r 2  22 0D 52 55          .byte   '"', 13, "RUN", 13, 0
003967r 2  4E 0D 00     
00396Ar 2               run_dev:
00396Ar 2  55 43                .byte   "UC"
00396Cr 2               
00396Cr 2               ; ----------------------------------------------------------------------------
00396Cr 2               ; SBC_COPY - copy a file
00396Cr 2               ;   In : A/Y = a block:  +0 .byte the source's device ('U' / 'C')
00396Cr 2               ;                        +1 .word -> its full path, "/A/B/NAME.EXT",0
00396Cr 2               ;                        +3 .byte the destination's device
00396Cr 2               ;                        +4 .word -> its full path (replaced if it exists)
00396Cr 2               ;   Out: C=0 copied; C=1, A = the error (CH_E_TOOBIG $F0: it doesn't fit)
00396Cr 2               ;   The whole file is read first, into $1000-$7EFF of every RAM bank but the
00396Cr 2               ;   caller's (3 x 28,416 = 85,248 bytes with 4 banks), then written, so
00396Cr 2               ;   one file is open at a time (the CH376's limit) and a copy within one
00396Cr 2               ;   drive needs no seeking.  What was in those banks (a program in bank 0)
00396Cr 2               ;   is lost.  The caller's bank is selected again at the end.
00396Cr 2               ; ----------------------------------------------------------------------------
00396Cr 2               CP_SIZE         = $7F00 - $1000
00396Cr 2               
00396Cr 2               sbc_copy:
00396Cr 2  85 rr                sta     strptr
00396Er 2  84 rr                sty     strptr+1
003970r 2  AD rr rr             lda     bank_cur
003973r 2  8D rr rr             sta     sh_cur
003976r 2  A0 00                ldy     #0
003978r 2  B1 rr                lda     (strptr),y
00397Ar 2  8D rr rr             sta     cp_sdev
00397Dr 2  A0 03                ldy     #3
00397Fr 2  B1 rr                lda     (strptr),y
003981r 2  8D rr rr             sta     cp_ddev
003984r 2  A0 01                ldy     #1                  ; the source's path -> ch_name
003986r 2  20 rr rr             jsr     cp_ptr
003989r 2  A2 00                ldx     #0
00398Br 2  B1 rr        @s:     lda     (dir_ptr),y
00398Dr 2  9D rr rr             sta     ch_name,x
003990r 2  F0 08                beq     @d
003992r 2  C8                   iny
003993r 2  E8                   inx
003994r 2  E0 2D                cpx     #45
003996r 2  90 F3                bcc     @s
003998r 2  B0 14                bcs     cp_badp
00399Ar 2  A0 04        @d:     ldy     #4                  ; the destination's -> cp_dst
00399Cr 2  20 rr rr             jsr     cp_ptr
00399Fr 2  A2 00                ldx     #0
0039A1r 2  B1 rr        @t:     lda     (dir_ptr),y
0039A3r 2  9D rr rr             sta     cp_dst,x
0039A6r 2  F0 0A                beq     cp_src
0039A8r 2  C8                   iny
0039A9r 2  E8                   inx
0039AAr 2  E0 2D                cpx     #45
0039ACr 2  90 F3                bcc     @t
0039AEr 2               cp_badp:
0039AEr 2  A9 FE                lda     #$FE
0039B0r 2  38                   sec
0039B1r 2  60                   rts
0039B2r 2  AD rr rr     cp_src: lda     cp_sdev             ; read it
0039B5r 2  20 rr rr             jsr     fs_letter
0039B8r 2  B0 F4                bcs     cp_badp
0039BAr 2  20 rr rr             jsr     fs_prepare
0039BDr 2  90 03                bcc     :+
0039BFr 2  4C rr rr             jmp     cp_nodisk
0039C2r 2               :       ; (far)
0039C2r 2  20 rr rr             jsr     mon_open
0039C5r 2  C9 14                cmp     #USB_INT_SUCCESS
0039C7r 2  F0 03                beq     :+
0039C9r 2  4C rr rr             jmp     cp_err
0039CCr 2               :       ; (far)
0039CCr 2  A9 00                lda     #0
0039CEr 2  8D rr rr             sta     cp_b
0039D1r 2  8D rr rr             sta     cp_n
0039D4r 2  20 rr rr     @rb:    jsr     cp_bank
0039D7r 2  B0 2C                bcs     @full
0039D9r 2  20 rr rr             jsr     BANK_SET
0039DCr 2  20 rr rr             jsr     cp_buf
0039DFr 2  20 rr rr             jsr     fs_read
0039E2r 2  C9 14                cmp     #USB_INT_SUCCESS
0039E4r 2  F0 03                beq     :+
0039E6r 2  4C rr rr             jmp     cp_rderr
0039E9r 2               :       ; (far)
0039E9r 2  EE rr rr             inc     cp_n
0039ECr 2  AD rr rr             lda     ch_got
0039EFr 2  8D rr rr             sta     cp_last
0039F2r 2  AD rr rr             lda     ch_got+1
0039F5r 2  8D rr rr             sta     cp_last+1
0039F8r 2  C9 6F                cmp     #>CP_SIZE           ; a whole bank: there may be more
0039FAr 2  D0 35                bne     @eof
0039FCr 2  AD rr rr             lda     ch_got
0039FFr 2  C9 00                cmp     #<CP_SIZE
003A01r 2  F0 D1                beq     @rb
003A03r 2  D0 2C                bne     @eof
