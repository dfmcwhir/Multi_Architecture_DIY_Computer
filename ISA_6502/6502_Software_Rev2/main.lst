003AFBr 2               ; SBC_DELETE - delete a file
003AFBr 2               ;   In : A/Y = a block:  +0 .byte the device ('U' / 'C')
003AFBr 2               ;                        +1 .word -> the full path, "/A/B/NAME.EXT",0
003AFBr 2               ;   Out: C=0 deleted; C=1, A = the error ($42 not found)
003AFBr 2               ; ----------------------------------------------------------------------------
