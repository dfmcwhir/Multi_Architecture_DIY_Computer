00340Br 2               
00340Br 2               ; mon_device - A = a device letter: switch to it (fs.s).  Changing device
00340Br 2               ; goes back to the root.  C=1 if A isn't a device letter.  Keeps Y.
00340Br 2               mon_device:
00340Br 2  AE rr rr             ldx     fs_dev
00340Er 2  20 rr rr             jsr     fs_letter
003411r 2  B0 0B                bcs     @x
003413r 2  EC rr rr             cpx     fs_dev
003416r 2  F0 06                beq     @x                  ; (carry clear)
003418r 2  A9 00                lda     #0                  ; another device: its root
00341Ar 2  8D rr rr             sta     mon_cwd
00341Dr 2  18                   clc
00341Er 2  60           @x:     rts
00341Fr 2               
00341Fr 2               ; mon_copy_cwd - ch_name = mon_cwd, mon_x = X = its length
00341Fr 2               mon_copy_cwd:
00341Fr 2  A2 00                ldx     #0
003421r 2  BD rr rr     @l:     lda     mon_cwd,x
003424r 2  9D rr rr             sta     ch_name,x
003427r 2  F0 03                beq     @d
003429r 2  E8                   inx
00342Ar 2  D0 F5                bne     @l
00342Cr 2  8E rr rr     @d:     stx     mon_x
00342Fr 2  60                   rts
003430r 2               
003430r 2               ; mon_showcwd - CR LF and the current directory ("/" for the root)
003430r 2               mon_showcwd:
003430r 2  A9 rr                lda     #<mon_crlf
003432r 2  A0 rr                ldy     #>mon_crlf
003434r 2  20 rr rr             jsr     mon_puts
003437r 2  AD rr rr             lda     mon_cwd
00343Ar 2  D0 05                bne     @p
00343Cr 2  A9 2F                lda     #'/'
00343Er 2  4C rr rr             jmp     CHROUT
003441r 2  A9 rr        @p:     lda     #<mon_cwd
003443r 2  A0 rr                ldy     #>mon_cwd
003445r 2  4C rr rr             jmp     mon_puts
003448r 2               
003448r 2               mon_badpath:
003448r 2  A9 rr                lda     #<mon_badp
00344Ar 2  A0 rr                ldy     #>mon_badp
00344Cr 2  20 rr rr             jsr     mon_puts
00344Fr 2  38                   sec
003450r 2  60                   rts
003451r 2               
003451r 2               ; mon_path - turn the text at IN+mon_y into a full path in ch_name (starting at
003451r 2               ; the current directory unless the text begins with "/" or "\").
003451r 2               ;   out: carry clear: ch_name = path ("" = root), mon_x = its length,
003451r 2               ;        mon_kind = 1 if it ends in ".." "." or "/", mon_flag = last part has a ".",
003451r 2               ;        mon_y = index of the character after the path (blank or CR)
003451r 2               ;        carry set: path too long / part too long
003451r 2               mon_path:
003451r 2  20 rr rr             jsr     mon_copy_cwd
003454r 2  A9 00                lda     #0
003456r 2  8D rr rr             sta     mon_kind
003459r 2  8D rr rr             sta     mon_flag
00345Cr 2  AC rr rr             ldy     mon_y
00345Fr 2  B9 00 02             lda     IN,y
003462r 2  C9 2F                cmp     #'/'
003464r 2  F0 04                beq     @abs
003466r 2  C9 5C                cmp     #'\'
003468r 2  D0 0E                bne     @comp
00346Ar 2  C8           @abs:   iny                         ; absolute: start again at the root
00346Br 2  A9 00                lda     #0
00346Dr 2  8D rr rr             sta     mon_x
003470r 2  8D rr rr             sta     ch_name
003473r 2  A9 01                lda     #1
003475r 2  8D rr rr             sta     mon_kind
003478r 2  B9 00 02     @comp:  lda     IN,y
00347Br 2  C9 0D                cmp     #$0D
00347Dr 2  F0 06                beq     @fin
00347Fr 2  C9 20                cmp     #' '
003481r 2  F0 02                beq     @fin
003483r 2  D0 03                bne     @nfin
003485r 2  4C rr rr     @fin:   jmp     @end
003488r 2  C9 2F        @nfin:  cmp     #'/'
00348Ar 2  F0 04                beq     @sep
00348Cr 2  C9 5C                cmp     #'\'
00348Er 2  D0 08                bne     @word
003490r 2  C8           @sep:   iny
003491r 2  A9 01                lda     #1                  ; a trailing separator means "directory"
003493r 2  8D rr rr             sta     mon_kind
003496r 2  D0 E0                bne     @comp
003498r 2  A2 00        @word:  ldx     #0                  ; read one part into mon_comp
00349Ar 2  B9 00 02     @rd:    lda     IN,y
00349Dr 2  C9 0D                cmp     #$0D
00349Fr 2  F0 19                beq     @wend
0034A1r 2  C9 20                cmp     #' '
0034A3r 2  F0 15                beq     @wend
0034A5r 2  C9 2F                cmp     #'/'
0034A7r 2  F0 11                beq     @wend
0034A9r 2  C9 5C                cmp     #'\'
0034ABr 2  F0 0D                beq     @wend
0034ADr 2  E0 0D                cpx     #13
0034AFr 2  B0 07                bcs     @err
0034B1r 2  9D rr rr             sta     mon_comp,x
0034B4r 2  E8                   inx
0034B5r 2  C8                   iny
0034B6r 2  D0 E2                bne     @rd
0034B8r 2  38           @err:   sec
0034B9r 2  60                   rts
0034BAr 2  A9 00        @wend:  lda     #0
0034BCr 2  9D rr rr             sta     mon_comp,x
0034BFr 2  8C rr rr             sty     mon_y
0034C2r 2  8E rr rr             stx     mon_cl
0034C5r 2  E0 01                cpx     #1
0034C7r 2  D0 0E                bne     @n2
0034C9r 2  AD rr rr             lda     mon_comp
0034CCr 2  C9 2E                cmp     #'.'
0034CEr 2  D0 39                bne     @norm
0034D0r 2  A9 01                lda     #1                  ; "."  stay where we are
0034D2r 2  8D rr rr             sta     mon_kind
0034D5r 2  D0 6F                bne     @next
0034D7r 2  E0 02        @n2:    cpx     #2
0034D9r 2  D0 2E                bne     @norm
0034DBr 2  AD rr rr             lda     mon_comp
0034DEr 2  C9 2E                cmp     #'.'
0034E0r 2  D0 27                bne     @norm
0034E2r 2  AD rr rr             lda     mon_comp+1
0034E5r 2  C9 2E                cmp     #'.'
0034E7r 2  D0 20                bne     @norm
0034E9r 2  AE rr rr             ldx     mon_x               ; ".."  drop the last part
0034ECr 2  F0 0C                beq     @popd
0034EEr 2  CA           @pl:    dex
0034EFr 2  BD rr rr             lda     ch_name,x
0034F2r 2  C9 2F                cmp     #'/'
0034F4r 2  F0 04                beq     @popd
0034F6r 2  E0 00                cpx     #0
0034F8r 2  D0 F4                bne     @pl
0034FAr 2  8E rr rr     @popd:  stx     mon_x
0034FDr 2  A9 00                lda     #0
0034FFr 2  9D rr rr             sta     ch_name,x
003502r 2  A9 01                lda     #1
003504r 2  8D rr rr             sta     mon_kind
003507r 2  D0 3D                bne     @next
003509r 2  AD rr rr     @norm:  lda     mon_x               ; room for "/" + part?  (max 40 characters)
00350Cr 2  18                   clc
00350Dr 2  6D rr rr             adc     mon_cl
003510r 2  69 01                adc     #1
003512r 2  C9 29                cmp     #41
003514r 2  B0 A2                bcs     @err
003516r 2  AE rr rr             ldx     mon_x
003519r 2  A9 2F                lda     #'/'
00351Br 2  9D rr rr             sta     ch_name,x
00351Er 2  E8                   inx
00351Fr 2  A0 00                ldy     #0
003521r 2  8C rr rr             sty     mon_flag
003524r 2  B9 rr rr     @cp:    lda     mon_comp,y
003527r 2  F0 12                beq     @cpd
003529r 2  C9 2E                cmp     #'.'
00352Br 2  D0 07                bne     @nd
00352Dr 2  48                   pha
00352Er 2  A9 01                lda     #1
003530r 2  8D rr rr             sta     mon_flag
003533r 2  68                   pla
003534r 2  9D rr rr     @nd:    sta     ch_name,x
003537r 2  E8                   inx
003538r 2  C8                   iny
003539r 2  D0 E9                bne     @cp
00353Br 2  A9 00        @cpd:   lda     #0
00353Dr 2  9D rr rr             sta     ch_name,x
003540r 2  8E rr rr             stx     mon_x
003543r 2  8D rr rr             sta     mon_kind            ; (A = 0)
003546r 2  AC rr rr     @next:  ldy     mon_y
003549r 2  4C rr rr             jmp     @comp
00354Cr 2  8C rr rr     @end:   sty     mon_y
00354Fr 2  18                   clc
003550r 2  60                   rts
003551r 2               
003551r 2               ; ============================================================================
003551r 2               ; SBC_LOAD - load a whole file into RAM, for programs (jump table entry $FE15)
003551r 2               ;
003551r 2               ;   In : A = low, Y = high byte of a parameter block anywhere in RAM:
003551r 2               ;           +0 .word  address to load to
003551r 2               ;           +2 .word  most bytes to write (a longer file is cut off, still OK)
003551r 2               ;           +4 .byte  file name, 8.3, root directory, ends with a 0 byte
003551r 2               ;   Out: carry clear = loaded, X = length low, Y = length high
003551r 2               ;        carry set   = failed, A = error code: the CH376 status ($42 = file not
003551r 2               ;                      found), $FF = timeout / no drive, $FE = bad parameter block
003551r 2               ;   Prints nothing, never jumps to the monitor, closes the file before it
003551r 2               ;   returns.  Changes A, X, Y and flags (and strptr, the firmware's own zero
003551r 2               ;   page bytes).  Never writes beyond address + max - 1.
003551r 2               ; ============================================================================
003551r 2               SBC_LOAD_USES_CWD = 1               ; 1 = names are relative to the monitor's current
003551r 2                                                   ; directory (L DIR), 0 = always the root directory
003551r 2               SBC_LOAD:
003551r 2  85 rr                sta     strptr
003553r 2  84 rr                sty     strptr+1
003555r 2  20 rr rr             jsr     mon_copy_cwd        ; build "<current dir>/NAME.EXT",0 in ch_name
003558r 2  A9 01                lda     #SBC_LOAD_USES_CWD
00355Ar 2  D0 02                bne     @cw
00355Cr 2  A2 00                ldx     #0                  ; root only
00355Er 2  A9 2F        @cw:    lda     #'/'
003560r 2  9D rr rr             sta     ch_name,x
003563r 2  E8                   inx
003564r 2  8E rr rr             stx     mon_x               ; start of the file name part
003567r 2  8A                   txa
003568r 2  18                   clc
003569r 2  69 0C                adc     #12                 ; at most 12 characters
00356Br 2  8D rr rr             sta     mon_cl
00356Er 2  A0 04                ldy     #4
003570r 2  B1 rr        @cp:    lda     (strptr),y
003572r 2  F0 1A                beq     @term
003574r 2  EC rr rr             cpx     mon_cl
003577r 2  B0 11                bcs     @bad
003579r 2  C9 61                cmp     #'a'                ; lower case -> upper case
00357Br 2  90 06                bcc     @st
00357Dr 2  C9 7B                cmp     #'z'+1
00357Fr 2  B0 02                bcs     @st
003581r 2  29 DF                and     #$DF
003583r 2  9D rr rr     @st:    sta     ch_name,x
003586r 2  E8                   inx
003587r 2  C8                   iny
003588r 2  D0 E6                bne     @cp
00358Ar 2  A9 FE        @bad:   lda     #$FE                ; bad parameter block
00358Cr 2  38                   sec
00358Dr 2  60                   rts
00358Er 2  A9 00        @term:  lda     #0
003590r 2  9D rr rr             sta     ch_name,x
003593r 2  EC rr rr             cpx     mon_x
003596r 2  F0 F2                beq     @bad                ; empty name
003598r 2  A0 00                ldy     #0                  ; address and limit from the block
00359Ar 2  B1 rr                lda     (strptr),y
00359Cr 2  8D rr rr             sta     ch_a0
00359Fr 2  C8                   iny
0035A0r 2  B1 rr                lda     (strptr),y
0035A2r 2  8D rr rr             sta     ch_a0+1
0035A5r 2  C8                   iny
0035A6r 2  B1 rr                lda     (strptr),y
0035A8r 2  8D rr rr             sta     ch_len
0035ABr 2  C8                   iny
0035ACr 2  B1 rr                lda     (strptr),y
0035AEr 2  8D rr rr             sta     ch_len+1
0035B1r 2  20 rr rr             jsr     fs_prepare          ; initialise the CH376 / mount if needed
0035B4r 2  B0 55                bcs     sl_nodisk
0035B6r 2  20 rr rr                     jsr     mon_open
0035B9r 2  C9 14                cmp     #USB_INT_SUCCESS
0035BBr 2  D0 41                bne     sl_err              ; (nothing is open: no close needed)
0035BDr 2  AD rr rr             lda     ch_len
0035C0r 2  0D rr rr             ora     ch_len+1
0035C3r 2  F0 20                beq     sl_zero             ; room for 0 bytes: just report the file exists
0035C5r 2  AD rr rr             lda     ch_a0
0035C8r 2  8D rr rr             sta     ch_ptr
0035CBr 2  AD rr rr             lda     ch_a0+1
0035CEr 2  8D rr rr             sta     ch_ptr+1
0035D1r 2  20 rr rr             jsr     fs_read             ; reads at most ch_len bytes
0035D4r 2  C9 14                cmp     #USB_INT_SUCCESS
0035D6r 2  D0 18                bne     sl_rderr
0035D8r 2  A9 00                lda     #0
0035DAr 2  20 rr rr             jsr     fs_close
0035DDr 2  AE rr rr             ldx     ch_got
0035E0r 2  AC rr rr             ldy     ch_got+1
0035E3r 2  18                   clc
0035E4r 2  60                   rts
0035E5r 2               sl_zero:
0035E5r 2  A9 00                lda     #0
0035E7r 2  20 rr rr             jsr     fs_close
0035EAr 2  A2 00                ldx     #0
0035ECr 2  A0 00                ldy     #0
0035EEr 2  18                   clc
0035EFr 2  60                   rts
0035F0r 2               sl_rderr:
0035F0r 2  48                   pha                         ; read failed: close, start afresh next time
0035F1r 2  A9 00                lda     #0
0035F3r 2  20 rr rr             jsr     fs_unready
0035F6r 2  A9 00                lda     #0
0035F8r 2  20 rr rr             jsr     fs_close
0035FBr 2  68                   pla
0035FCr 2  38                   sec
0035FDr 2  60                   rts
0035FEr 2  C9 42        sl_err: cmp     #ERR_MISS_FILE      ; "file not found" is a normal answer
003600r 2  F0 07                beq     @ret
003602r 2  48                   pha
003603r 2  A9 00                lda     #0
003605r 2  20 rr rr             jsr     fs_unready            ; anything else: re-initialise next time
003608r 2  68                   pla
003609r 2  38           @ret:   sec
00360Ar 2  60                   rts
00360Br 2               sl_nodisk:
00360Br 2  A9 00                lda     #0
00360Dr 2  20 rr rr             jsr     fs_unready
003610r 2  A9 FF                lda     #$FF
003612r 2  38                   sec
003613r 2  60                   rts
003614r 2               
003614r 1               .include "shell.s"              ; SBC_DIR, SBC_RUN, SBC_SHELL, the monitor prompt (stage 6)
003614r 2               ; ============================================================================
003614r 2               ; shell.s - a file manager (or any "shell" program) kept in a RAM bank, and
003614r 2               ;           the monitor's prompt.  Stage 6.
003614r 2               ;
003614r 2               ; A shell is a program that runs in the banked window of one RAM bank (1-15).
003614r 2               ; Its bank starts with:   $1000  JMP entry     (entered with that bank selected)
003614r 2               ;                         $1003  "SH65"        (the signature)
003614r 2               ; Programs it starts run in bank 0 from $0800, as from the monitor; when they
003614r 2               ; finish (JMP SBC_MENU) the ROM goes back to the shell instead of the boot
003614r 2               ; menu.  After a reset the boot menu looks for a shell in the banks and
003614r 2               ; offers [G] to go back to it.
003614r 2               ;
003614r 2               ;   SBC_DIR    $FE57  read the current folder into a table
003614r 2               ;   SBC_RUN    $FE5A  load and start a program (.BIN) or a BASIC program
003614r 2               ;   SBC_SHELL  $FE5D  A = the shell's bank (0 = none)
003614r 2               ;   SBC_COPY   $FE60  copy a file (any folder, either drive), through the
003614r 2               ;                     RAM banks other than the caller's
003614r 2               ;   SBC_DELETE $FE63  delete a file
003614r 2               ; ============================================================================
003614r 2               
003614r 2               SH_ENTRY        = $1000
003614r 2               SH_SIG          = $1003
003614r 2               DIRLINE         = 40                    ; the longest listing line looked at
003614r 2               
003614r 2               .segment "DRVVARS"
0001ECr 2  xx           sh_bank:        .res 1                  ; the shell's bank, 0 = none
0001EDr 2  xx           sh_cur:         .res 1                  ; (the caller's bank)
0001EEr 2  xx           dir_cap:        .res 1                  ; bit 7: listings go to dir_char
0001EFr 2  xx           dir_sp:         .res 1                  ; the stack to go back to on an error
0001F0r 2  xx           dir_max:        .res 1
0001F1r 2  xx           dir_n:          .res 1
0001F2r 2  xx           dir_len:        .res 1
0001F3r 2  xx           dir_sx:         .res 1
0001F4r 2  xx           dir_sy:         .res 1
0001F5r 2  xx xx xx xx  dir_ent:        .res 16                 ; the entry being made
0001F9r 2  xx xx xx xx  
0001FDr 2  xx xx xx xx  
000205r 2  xx xx xx xx  dir_line:       .res DIRLINE
000209r 2  xx xx xx xx  
00020Dr 2  xx xx xx xx  
00022Dr 2  xx xx xx xx  dir_t:          .res 4
000231r 2  xx           run_kind:       .res 1
000232r 2  xx xx xx xx  run_blk:        .res 4 + 13             ; SBC_LOAD's block: $0800, $7700, name
000236r 2  xx xx xx xx  
00023Ar 2  xx xx xx xx  
000243r 2  xx           run_t:          .res 1
000244r 2  xx xx xx xx  cp_dst:         .res 46                 ; SBC_COPY: the destination's path
000248r 2  xx xx xx xx  
00024Cr 2  xx xx xx xx  
000272r 2  xx           cp_sdev:        .res 1                  ;   the devices ('U' / 'C')
000273r 2  xx           cp_ddev:        .res 1
000274r 2  xx           cp_b:           .res 1                  ;   the next bank to look at
000275r 2  xx           cp_n:           .res 1                  ;   banks filled
000276r 2  xx           cp_k:           .res 1
000277r 2  xx xx        cp_last:        .res 2                  ;   bytes in the last bank
000279r 2  xx           cp_probe:       .res 1
00027Ar 2               
00027Ar 2               .segment "BIOS"
003614r 2               
003614r 2               ; ----------------------------------------------------------------------------
003614r 2               ; sh_ok - C=0 if bank A holds a shell (its signature).  Keeps the selected
003614r 2               ; bank (and X).
003614r 2               ; ----------------------------------------------------------------------------
003614r 2  8D rr rr     sh_ok:  sta     run_t
003617r 2  AD rr rr             lda     bank_cur
00361Ar 2  8D rr rr             sta     sh_cur
00361Dr 2  AD rr rr             lda     run_t
003620r 2  F0 23                beq     @no
003622r 2  CD rr rr             cmp     bank_count
003625r 2  B0 1E                bcs     @no
003627r 2  20 rr rr             jsr     BANK_SET
00362Ar 2  A0 03                ldy     #3
00362Cr 2  B9 03 10     @c:     lda     SH_SIG,y
00362Fr 2  D9 rr rr             cmp     sh_sigtxt,y
003632r 2  D0 0B                bne     @nb
003634r 2  88                   dey
003635r 2  10 F5                bpl     @c
003637r 2  AD rr rr             lda     sh_cur
00363Ar 2  20 rr rr             jsr     BANK_SET
00363Dr 2  18                   clc
00363Er 2  60                   rts
00363Fr 2  AD rr rr     @nb:    lda     sh_cur
003642r 2  20 rr rr             jsr     BANK_SET
003645r 2  38           @no:    sec
003646r 2  60                   rts
003647r 2               sh_sigtxt:
003647r 2  53 48 36 35          .byte   "SH65"
00364Br 2               
00364Br 2               ; sh_find - A = the highest bank holding a shell, C=0; C=1 none
00364Br 2               sh_find:
00364Br 2  AE rr rr             ldx     bank_count
00364Er 2  CA           @b:     dex
00364Fr 2  F0 09                beq     @none
003651r 2  8A                   txa
003652r 2  20 rr rr             jsr     sh_ok
003655r 2  B0 F7                bcs     @b
003657r 2  8A                   txa
003658r 2  18                   clc
003659r 2  60                   rts
00365Ar 2  38           @none:  sec
00365Br 2  60                   rts
00365Cr 2               
00365Cr 2               ; ----------------------------------------------------------------------------
00365Cr 2               ; SBC_SHELL - A = the shell's bank (1-15), C=1 if there is no shell there;
00365Cr 2               ; A = 0: no shell (SBC_MENU goes to the boot menu again)
00365Cr 2               ; ----------------------------------------------------------------------------
00365Cr 2               sbc_shell:
00365Cr 2  C9 00                cmp     #0
00365Er 2  F0 07                beq     @set
003660r 2  48                   pha
003661r 2  20 rr rr             jsr     sh_ok
003664r 2  68                   pla
003665r 2  B0 04                bcs     @r
003667r 2  8D rr rr     @set:   sta     sh_bank
00366Ar 2  18                   clc
00366Br 2  60           @r:     rts
00366Cr 2               
00366Cr 2               ; ----------------------------------------------------------------------------
00366Cr 2               ; shell_menu - SBC_MENU: back to the shell if there is one, else the boot menu
00366Cr 2               ; ----------------------------------------------------------------------------
00366Cr 2               shell_menu:
00366Cr 2  AD rr rr             lda     sh_bank
00366Fr 2  F0 0A                beq     @menu
003671r 2  20 rr rr             jsr     sh_ok
003674r 2  90 08                bcc     sh_enter
003676r 2  A9 00                lda     #0
003678r 2  8D rr rr             sta     sh_bank
00367Br 2  4C rr rr     @menu:  jmp     MENU
00367Er 2               
00367Er 2               ; sh_enter - start the shell in bank sh_bank (a clean stack, sound off)
00367Er 2               sh_enter:
00367Er 2  D8                   cld
00367Fr 2  A2 FF                ldx     #$FF
003681r 2  9A                   txs
003682r 2  20 rr rr             jsr     BI_QUIET
003685r 2  A9 00                lda     #0
003687r 2  8D rr rr             sta     ld_on
00368Ar 2  8D rr rr             sta     dir_cap
00368Dr 2  8D rr rr             sta     ch_mon
003690r 2  AD rr rr             lda     sh_bank
003693r 2  20 rr rr             jsr     BANK_SET
003696r 2  58                   cli
003697r 2  4C 00 10             jmp     SH_ENTRY
00369Ar 2               
00369Ar 2               ; ----------------------------------------------------------------------------
00369Ar 2               ; SBC_DIR - the current folder (SBC_CWD) of a device, as a table
00369Ar 2               ;   In : A/Y = a block:  +0 .word table, +2 .byte the most entries,
00369Ar 2               ;                        +3 .byte the device: 'U', 'C' or 0 (as it is)
00369Ar 2               ;   Out: C=0, A = entries put in the table, 16 bytes each:
00369Ar 2               ;          0-7 name, 8-10 extension (both space padded), 11 attributes
00369Ar 2               ;          ($10 = a folder), 12-15 size (little endian).  "." and ".." are
00369Ar 2               ;          left out.
00369Ar 2               ;        C=1, A = error code (as SBC_LOAD's; $FE = bad device)
00369Ar 2               ;   The table may be in any bank's window: the caller's bank stays selected.
00369Ar 2               ; ----------------------------------------------------------------------------
00369Ar 2               sbc_dir:
00369Ar 2  85 rr                sta     strptr
00369Cr 2  84 rr                sty     strptr+1
00369Er 2  BA                   tsx
00369Fr 2  8E rr rr             stx     dir_sp
0036A2r 2  A0 00                ldy     #0
0036A4r 2  B1 rr                lda     (strptr),y
0036A6r 2  85 rr                sta     dir_ptr
0036A8r 2  C8                   iny
0036A9r 2  B1 rr                lda     (strptr),y
0036ABr 2  85 rr                sta     dir_ptr+1
0036ADr 2  C8                   iny
0036AEr 2  B1 rr                lda     (strptr),y
0036B0r 2  8D rr rr             sta     dir_max
0036B3r 2  C8                   iny
0036B4r 2  B1 rr                lda     (strptr),y
0036B6r 2  F0 08                beq     @dev
0036B8r 2  20 rr rr             jsr     fs_letter
0036BBr 2  90 03                bcc     @dev
0036BDr 2  A9 FE                lda     #$FE
0036BFr 2  60                   rts
0036C0r 2  A9 00        @dev:   lda     #0
