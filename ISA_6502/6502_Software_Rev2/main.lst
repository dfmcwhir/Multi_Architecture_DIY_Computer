00297Ar 2               AA_end_basic
00297Ar 2               
00297Ar 1               .include "bios.s"               ; reset, boot menu, vectors
00297Ar 2               ; ============================================================================
00297Ar 2               ; bios.s - reset, boot menu and vectors for the 6502 CPU Rev2 ROM
00297Ar 2               ;
00297Ar 2               ; The hardware is now handled by one driver file per card (drv_*.s), the
00297Ar 2               ; console by console.s and interrupts by irq.s; config.inc says which cards
00297Ar 2               ; the ROM is built for.  This file only starts everything up.
00297Ar 2               ;
00297Ar 2               ; Must be included AFTER basic.s (it uses LAB_COLD, LAB_WARM, VEC_IN,
00297Ar 2               ; NMI_vec, IrqBase and NmiBase).
00297Ar 2               ; ============================================================================
00297Ar 2               
00297Ar 2               .segment "BIOSVARS"
000000r 2  xx           DEVSTAT:        .res 1                  ; device status, shown on VIA port B:
000001r 2                                                       ; bit 0 VIA  1 serial 6551  2 display
000001r 2                                                       ; bit 3 AVR keyboard interface
000001r 2               
000001r 2               API_VERSION     = 2                     ; SBC_SYSINFO returns it in Y
000001r 2               
000001r 2               .segment "BIOS"
000000r 2               
000000r 2               ; ============================================================================
000000r 2               ; RESET - from the reset vector (through RESET_CWD)
000000r 2               ; ============================================================================
000000r 2               RESET:
000000r 2  78                   sei
000001r 2  D8                   cld
000002r 2  A2 FF                ldx     #$FF
000004r 2  9A                   txs
000005r 2                       ; Clear all BIOS / driver RAM, so nothing depends on what the RAM
000005r 2                       ; happened to hold at power-up (a short power cycle keeps the old
000005r 2                       ; contents, a long one doesn't).  Not cleared: EhBASIC's zero page and
000005r 2                       ; page 3 (for the warm start) and the program area.  Addresses as in
000005r 2                       ; sbc.cfg: ZP $E2-$EE, $0200-$02FF (wozmon buffer, CHVARS),
000005r 2                       ; $0380-$03FF (BIOSVARS), $0400-$07FF (console buffer, DRVVARS).
000005r 2  A9 00                lda     #0
000007r 2  A2 0C                ldx     #$0C
000009r 2  95 E2        @z:     sta     $E2,x
00000Br 2  CA                   dex
00000Cr 2  10 FB                bpl     @z
00000Er 2  AA                   tax                             ; X = 0
00000Fr 2  9D 00 02     @p:     sta     $0200,x
000012r 2  9D 00 04             sta     $0400,x
000015r 2  9D 00 05             sta     $0500,x
000018r 2  9D 00 06             sta     $0600,x
00001Br 2  9D 00 07             sta     $0700,x
00001Er 2  E8                   inx
00001Fr 2  D0 EE                bne     @p
000021r 2  A2 7F                ldx     #$7F
000023r 2  9D 80 03     @b:     sta     $0380,x
000026r 2  CA                   dex
000027r 2  10 FA                bpl     @b
000029r 2  20 rr rr             jsr     BANK_INIT               ; bank 0 selected, banks counted
00002Cr 2  A9 00                lda     #0
00002Er 2  8D rr rr             sta     DEVSTAT
000031r 2  20 rr rr             jsr     INIT_BUFFER
000034r 2  20 rr rr             jsr     CH_BOOT                 ; CH376: set up lazily on first use
000037r 2  20 rr rr             jsr     I2C_BOOT                ; PCF8584 and LCD: set up on first use
00003Ar 2  20 rr rr             jsr     SND_BOOT                ; sound quiet
00003Dr 2               .if HAS_SPO
00003Dr 2  20 rr rr             jsr     spo_init                ; speech chip
000040r 2               .endif
000040r 2               .if HAS_VIA
000040r 2  20 rr rr             jsr     VIA_INIT                ; port B LEDs, 60 Hz tick
000043r 2               .endif
000043r 2               .if HAS_GAMEPAD
000043r 2  20 rr rr             jsr     PAD_INIT                ; gamepad on VIA port A
000046r 2               .endif
000046r 2               .if HAS_SPI
000046r 2  20 rr rr             jsr     spi_init                ; 65SPI (the CF card is mounted on first use)
000049r 2               .endif
000049r 2               .if HAS_ACIA
000049r 2  20 rr rr             jsr     acia_init               ; serial card 6551
00004Cr 2               .endif
00004Cr 2               .if HAS_AVRKBD
00004Cr 2  20 rr rr             jsr     avrkbd_init             ; keyboard / mouse / serial console
00004Fr 2               .endif
00004Fr 2  20 rr rr             jsr     CON_INIT                ; display, and where output goes
000052r 2               .if HAS_VIA
000052r 2  2C rr rr             bit     via_ok
000055r 2  10 06                bpl     :+
000057r 2  AD rr rr             lda     DEVSTAT
00005Ar 2  8D 00 7F             sta     PORTB                   ; show what answered on the LEDs
00005Dr 2               :
00005Dr 2               .endif
00005Dr 2  20 rr rr             jsr     COPY_VECTORS            ; EhBASIC I/O vectors + NMI code into RAM
000060r 2                                                       ; (falls into MENU)
000060r 2               
000060r 2               ; ----------------------------------------------------------------------------
000060r 2               ; MENU - boot menu.  Also reachable with CTRL-C from the monitor.
000060r 2               ; ----------------------------------------------------------------------------
000060r 2               MENU:
000060r 2  D8                   cld
000061r 2  A2 FF                ldx     #$FF
000063r 2  9A                   txs
000064r 2  58                   cli
000065r 2  A9 rr                lda     #<MENU_MSG
000067r 2  A0 rr                ldy     #>MENU_MSG
000069r 2  20 rr rr             jsr     bios_puts
00006Cr 2  AD rr rr             lda     bank_count              ; "nn" banks (1-16)
00006Fr 2  C9 0A                cmp     #10
000071r 2  90 0A                bcc     @one
000073r 2  48                   pha
000074r 2  A9 31                lda     #'1'
000076r 2  20 rr rr             jsr     CHROUT
000079r 2  68                   pla
00007Ar 2  38                   sec
00007Br 2  E9 0A                sbc     #10
00007Dr 2  09 30        @one:   ora     #'0'
00007Fr 2  20 rr rr             jsr     CHROUT
000082r 2  A9 rr                lda     #<MENU_MSG2
000084r 2  A0 rr                ldy     #>MENU_MSG2
000086r 2  20 rr rr             jsr     bios_puts
000089r 2  20 rr rr             jsr     sh_find                 ; a shell in a RAM bank? (shell.s)
00008Cr 2  B0 07                bcs     @ns
00008Er 2  A9 rr                lda     #<MENU_MSG3
000090r 2  A0 rr                ldy     #>MENU_MSG3
000092r 2  20 rr rr             jsr     bios_puts
000095r 2  A9 3F        @ns:    lda     #'?'
000097r 2  20 rr rr             jsr     CHROUT
00009Ar 2  A9 20                lda     #' '
00009Cr 2  20 rr rr             jsr     CHROUT
00009Fr 2  20 rr rr     @wait:  jsr     CHRIN
0000A2r 2  90 FB                bcc     @wait
0000A4r 2  29 DF                and     #$DF                    ; force upper case
0000A6r 2  C9 47                cmp     #'G'
0000A8r 2  D0 0B                bne     @ng
0000AAr 2  20 rr rr             jsr     sh_find
0000ADr 2  B0 F0                bcs     @wait
0000AFr 2  8D rr rr             sta     sh_bank
0000B2r 2  4C rr rr             jmp     sh_enter                ; back to the file manager
0000B5r 2  C9 43        @ng:    cmp     #'C'
0000B7r 2  F0 0A                beq     @cold
0000B9r 2  C9 57                cmp     #'W'
0000BBr 2  F0 09                beq     @warm
0000BDr 2  C9 4D                cmp     #'M'
0000BFr 2  F0 08                beq     @mon
0000C1r 2  D0 DC                bne     @wait                   ; anything else: keep waiting
0000C3r 2  4C rr rr     @cold:  jmp     LAB_COLD                ; EhBASIC cold start
0000C6r 2  4C 00 00     @warm:  jmp     LAB_WARM                ; EhBASIC warm start (program in RAM is kept)
0000C9r 2  4C rr rr     @mon:   jmp     WOZ_ENTRY               ; wozmon
0000CCr 2               
0000CCr 2               MENU_MSG:
0000CCr 2  0D 0A 36 35          .byte   $0D,$0A,"6502 SBC CPU Rev2 - EhBASIC 2.22",$0D,$0A
0000D0r 2  30 32 20 53  
0000D4r 2  42 43 20 43  
0000F0r 2  52 41 4D 20          .byte   "RAM banks: ",$00
0000F4r 2  62 61 6E 6B  
0000F8r 2  73 3A 20 00  
0000FCr 2               MENU_MSG2:
0000FCr 2  0D 0A 5B 43          .byte   $0D,$0A,"[C]old start, [W]arm start, [M]onitor",$00
000100r 2  5D 6F 6C 64  
000104r 2  20 73 74 61  
000124r 2               MENU_MSG3:
000124r 2  2C 20 5B 47          .byte   ", [G]o to the file manager",$00
000128r 2  5D 6F 20 74  
00012Cr 2  6F 20 74 68  
00013Fr 2               
00013Fr 2               ; bios_puts - print the 0-ended string at A (low) / Y (high): mon_puts
00013Fr 2               bios_puts       = mon_puts
00013Fr 2               
00013Fr 2               ; ----------------------------------------------------------------------------
00013Fr 2               ; COPY_VECTORS - copy VEC_BLOCK to RAM, starting at VEC_IN:
00013Fr 2               ;   VEC_IN, VEC_OUT, VEC_LD, VEC_SV   EhBASIC's I/O vectors
00013Fr 2               ;   IRQ_vec: 10 bytes                 EhBASIC's RAM IRQ code (not used: the
00013Fr 2               ;                                     real IRQ vector goes to irq.s)
00013Fr 2               ;   NMI_vec: 10 bytes                 EhBASIC's RAM NMI code (NMI vector -> here)
00013Fr 2               ; Modifies A, Y, flags.
00013Fr 2               ; ----------------------------------------------------------------------------
00013Fr 2               COPY_VECTORS:
00013Fr 2  A0 1C                ldy     #VEC_BLOCK_END-VEC_BLOCK
000141r 2  B9 rr rr     @loop:  lda     VEC_BLOCK-1,y
000144r 2  99 04 03             sta     VEC_IN-1,y
000147r 2  88                   dey
000148r 2  D0 F7                bne     @loop
00014Ar 2  60                   rts
00014Br 2               
00014Br 2               VEC_BLOCK:
00014Br 2  rr rr                .word   CHRIN                   ; VEC_IN  - byte in from keyboard/serial
00014Dr 2  rr rr                .word   CHROUT                  ; VEC_OUT - byte out to screen/serial
00014Fr 2  rr rr                .word   CH_LOAD                 ; VEC_LD  - LOAD (ch376_loadsave.s)
000151r 2  rr rr                .word   CH_SAVE                 ; VEC_SV  - SAVE (ch376_loadsave.s)
000153r 2               IRQ_CODE:                               ; EhBASIC IRQ support (10 bytes)
000153r 2  48                   pha
000154r 2  A5 DF                lda     IrqBase
000156r 2  4A                   lsr     a
000157r 2  05 DF                ora     IrqBase
000159r 2  85 DF                sta     IrqBase
00015Br 2  68                   pla
00015Cr 2  40                   rti
00015Dr 2               NMI_CODE:                               ; EhBASIC NMI support (10 bytes)
00015Dr 2  48                   pha
00015Er 2  A5 DC                lda     NmiBase
000160r 2  4A                   lsr     a
000161r 2  05 DC                ora     NmiBase
000163r 2  85 DC                sta     NmiBase
000165r 2  68                   pla
000166r 2  40                   rti
000167r 2               VEC_BLOCK_END:
000167r 2               
000167r 2               ; ----------------------------------------------------------------------------
000167r 2               ; RESET_CWD - the reset vector comes here: start in the top folder ("" in
000167r 2               ; mon_cwd, which is random at power-up), then RESET.
000167r 2               ; ----------------------------------------------------------------------------
000167r 2               RESET_CWD:
000167r 2  A9 00                lda     #0
000169r 2  8D rr rr             sta     mon_cwd
00016Cr 2  4C rr rr             jmp     RESET
00016Fr 2               
00016Fr 2               ; sbc_cwd - A/Y = the monitor's current folder (jump table SBC_CWD)
00016Fr 2               sbc_cwd:
00016Fr 2  A9 rr                lda     #<mon_cwd
000171r 2  A0 rr                ldy     #>mon_cwd
000173r 2  60                   rts
000174r 2               
000174r 2               ; ----------------------------------------------------------------------------
000174r 2               ; SYSINFO - A = display type (config.inc DISP_...), X = DEVSTAT,
000174r 2               ;           Y = API version (jump table SBC_SYSINFO)
000174r 2               ; ----------------------------------------------------------------------------
000174r 2               SYSINFO:
000174r 2  A9 02                lda     #CON_DISPLAY
000176r 2  AE rr rr             ldx     DEVSTAT
000179r 2  A0 02                ldy     #API_VERSION
00017Br 2  60                   rts
00017Cr 2               
00017Cr 2               ; ============================================================================
00017Cr 2               ; Vectors  (segment RESETVEC is placed at $FFFA by sbc.cfg)
00017Cr 2               ; ============================================================================
00017Cr 2               .segment "RESETVEC"
000000r 2  17 03                .word   NMI_vec                 ; NMI   -> EhBASIC's RAM NMI handler
000002r 2  rr rr                .word   RESET_CWD               ; RESET
000004r 2  rr rr                .word   IRQ_ENTRY               ; IRQ   (irq.s)
000006r 2               
000006r 1               .include "cpu_rev2.s"           ; bank register, bank count
000006r 2               ; ============================================================================
000006r 2               ; cpu_rev2.s - CPU card Rev2 registers: RAM bank register and bank count
000006r 2               ;
000006r 2               ;   $7FFE write: bank register, D3-D0 -> bus A16-A19 (cleared by /RESET)
000006r 2               ;   $7FFE read : bank register on D3-D0 (D7-D4 not driven: AND #$0F)
000006r 2               ;   $7FFF read : interrupt register (irq.s)
000006r 2               ;
000006r 2               ; Banked window: $1000-$7EFF.  Physical address = bank x 32K + CPU address.
000006r 2               ; AS6C1008: banks 0-3, AS6C4008: banks 0-15, on-board RAM ("Block A"): 1.
000006r 2               ;
000006r 2               ; IMPORTANT for programs that switch banks: the code doing the switching (and
000006r 2               ; its stack and variables) must be in ROM or in $0000-$0FFF.  Everything the
000006r 2               ; BIOS and its interrupt handlers use is in $0000-$0FFF, so interrupts are safe
000006r 2               ; whatever bank is selected.
000006r 2               ; ============================================================================
000006r 2               
000006r 2               BANKREG         = $7FFE
000006r 2               BANK_PROBE      = $1000                 ; first byte of the banked window
000006r 2               
000006r 2               .segment "DRVVARS"
000000r 2  xx           bank_cur:       .res 1                  ; bank selected now
000001r 2  xx           bank_count:     .res 1                  ; banks found at boot (1-16)
000002r 2  xx xx xx xx  bank_save:      .res 16                 ; BANK_INIT scratch
000006r 2  xx xx xx xx  
00000Ar 2  xx xx xx xx  
000012r 2               
000012r 2               .segment "BIOS"
00017Cr 2               
00017Cr 2               ; ----------------------------------------------------------------------------
00017Cr 2               ; BANK_INIT - select bank 0 and count the banks.  Called from RESET with
00017Cr 2               ; interrupts off.  The byte at $1000 of each bank is put back afterwards, so a
00017Cr 2               ; warm start keeps everything.  Clobbers A, X.
00017Cr 2               ; ----------------------------------------------------------------------------
00017Cr 2               BANK_INIT:
00017Cr 2  A9 00                lda     #0
00017Er 2  8D FE 7F             sta     BANKREG
000181r 2  8D rr rr             sta     bank_cur
000184r 2  A9 01                lda     #1
000186r 2  8D rr rr             sta     bank_count
000189r 2               .if HAS_BANKS
000189r 2  A2 0F                ldx     #15                     ; 1. keep the probe byte of every bank
00018Br 2  8E FE 7F     @save:  stx     BANKREG
00018Er 2  AD 00 10             lda     BANK_PROBE
000191r 2  9D rr rr             sta     bank_save,x
000194r 2  CA                   dex
000195r 2  10 F4                bpl     @save
000197r 2  A2 0F                ldx     #15                     ; 2. write each bank's number into it,
000199r 2  8E FE 7F     @mark:  stx     BANKREG                 ;    high to low: banks that alias onto
00019Cr 2  8A                   txa                             ;    a lower one end up holding the
00019Dr 2  8D 00 10             sta     BANK_PROBE              ;    lower number
0001A0r 2  CA                   dex
0001A1r 2  10 F6                bpl     @mark
0001A3r 2  A2 01                ldx     #1                      ; 3. the first bank that doesn't read
0001A5r 2  8E FE 7F     @count: stx     BANKREG                 ;    back its own number is the count
0001A8r 2  EC 00 10             cpx     BANK_PROBE
0001ABr 2  D0 05                bne     @found
0001ADr 2  E8                   inx
0001AEr 2  E0 10                cpx     #16
0001B0r 2  D0 F3                bne     @count
0001B2r 2  8E rr rr     @found: stx     bank_count
0001B5r 2  A2 0F                ldx     #15                     ; 4. put the bytes back, high to low,
0001B7r 2  8E FE 7F     @rest:  stx     BANKREG                 ;    ending with bank 0 selected
0001BAr 2  BD rr rr             lda     bank_save,x
0001BDr 2  8D 00 10             sta     BANK_PROBE
0001C0r 2  CA                   dex
0001C1r 2  10 F4                bpl     @rest
0001C3r 2               .endif
0001C3r 2  60                   rts
0001C4r 2               
0001C4r 2               ; ----------------------------------------------------------------------------
0001C4r 2               ; BANK_SET - A = bank to select (0-15; only the low 4 bits are used).
0001C4r 2               ; Preserves X and Y.  See the note at the top about where the caller can be.
0001C4r 2               ; ----------------------------------------------------------------------------
0001C4r 2               BANK_SET:
0001C4r 2  29 0F                and     #$0F
0001C6r 2  8D rr rr             sta     bank_cur
0001C9r 2  8D FE 7F             sta     BANKREG
0001CCr 2  60                   rts
0001CDr 2               
0001CDr 2               ; ----------------------------------------------------------------------------
0001CDr 2               ; BANK_GET - A = bank selected now, X = number of banks found at boot.
0001CDr 2               ; ----------------------------------------------------------------------------
0001CDr 2               BANK_GET:
0001CDr 2  AE rr rr             ldx     bank_count
0001D0r 2  AD rr rr             lda     bank_cur
0001D3r 2  60                   rts
0001D4r 2               
0001D4r 2               ; ----------------------------------------------------------------------------
0001D4r 2               ; DELAY_MS - wait A milliseconds (1-255; 0 = 256), from CPU_KHZ.
0001D4r 2               ; Clobbers A, X, Y.  (Approximate: interrupts make it a little longer.)
0001D4r 2               ; ----------------------------------------------------------------------------
0001D4r 2               DLY_LOOPS       = CPU_KHZ / 5 - 3       ; 5-cycle loops per millisecond
0001D4r 2               
0001D4r 2               .segment "DRVVARS"
000012r 2  xx           dly_n:          .res 1
000013r 2               
000013r 2               .segment "BIOS"
0001D4r 2               DELAY_MS:
0001D4r 2  8D rr rr             sta     dly_n
0001D7r 2  A2 1D        @ms:    ldx     #<DLY_LOOPS
0001D9r 2  A0 04                ldy     #((DLY_LOOPS >> 8) + 1)
0001DBr 2  CA           @l:     dex                             ; 2
0001DCr 2  D0 FD                bne     @l                      ; 3
0001DEr 2  88                   dey
0001DFr 2  D0 FA                bne     @l
0001E1r 2  CE rr rr             dec     dly_n
0001E4r 2  D0 F1                bne     @ms
0001E6r 2  60                   rts
0001E7r 2               
0001E7r 1               .include "irq.s"                ; interrupt dispatch (built from config.inc)
0001E7r 2               ; ============================================================================
0001E7r 2               ; irq.s - interrupt dispatch for the CPU card Rev2
0001E7r 2               ;
0001E7r 2               ; The 74LS148 + '574 interrupt register at $7FFF reads (7 - n) * 2 for the
0001E7r 2               ; highest priority line that is active (IRQ0 highest).  IRQTABLE turns that
0001E7r 2               ; into the handler for line n.
0001E7r 2               ;
0001E7r 2               ; Each line's handler is built from config.inc: it calls the _irq routine of
0001E7r 2               ; every driver jumpered to that line, in a fixed order (keyboard first).  A
0001E7r 2               ; driver's _irq routine checks its own card and returns
0001E7r 2               ;       carry set   = it was this card, and it has been serviced
0001E7r 2               ;       carry clear = not this card
0001E7r 2               ; If no driver claims the interrupt it goes to IRQ_BASIC, which feeds
0001E7r 2               ; EhBASIC's ON IRQ (a plain RTI when BASIC hasn't enabled ON IRQ).
0001E7r 2               ; A source that is still active after the RTI simply interrupts again.
0001E7r 2               ;
0001E7r 2               ; Lines (see the design notes):
0001E7r 2               ;   0, 1  header (spare)       2  VIA (tick, gamepad)      3  serial card 6551
0001E7r 2               ;   4     PCF8584 (unused)     5  KB_MONITOR_TERM, or a 5/6 jumper card
0001E7r 2               ;   6     a 5/6 jumper card    7  65SPI / SPO256 (jumpers)
0001E7r 2               ; ============================================================================
0001E7r 2               
0001E7r 2               IRQPORT         = $7FFF
0001E7r 2               
0001E7r 2               .zeropage
000000r 2  xx xx        TEMP_IRQ_ADDR:  .res 2
000002r 2               
000002r 2               .segment "BIOS"
0001E7r 2               
0001E7r 2               IRQ_ENTRY:
0001E7r 2  48                   pha
0001E8r 2  8A                   txa
0001E9r 2  48                   pha
0001EAr 2  98                   tya
0001EBr 2  48                   pha
0001ECr 2  D8                   cld
0001EDr 2  AD FF 7F             lda     IRQPORT
0001F0r 2  29 0E                and     #$0E
0001F2r 2  AA                   tax
0001F3r 2  BD rr rr             lda     IRQTABLE,x
0001F6r 2  85 rr                sta     TEMP_IRQ_ADDR
0001F8r 2  BD rr rr             lda     IRQTABLE+1,x
0001FBr 2  85 rr                sta     TEMP_IRQ_ADDR+1
0001FDr 2  6C rr rr             jmp     (TEMP_IRQ_ADDR)
000200r 2               
000200r 2               IRQTABLE:                               ; register value 0 = IRQ7 ... 14 = IRQ0
000200r 2  rr rr rr rr          .word   IRQ7, IRQ6, IRQ5, IRQ4, IRQ3, IRQ2, IRQ1, IRQ0
000204r 2  rr rr rr rr  
000208r 2  rr rr rr rr  
000210r 2               
000210r 2               ; Not claimed by a driver: EhBASIC's ON IRQ.  If BASIC has enabled IRQ
000210r 2               ; handling, the flag is set and the BASIC handler runs after the current
000210r 2               ; statement (it must clear the source itself).  Otherwise IrqBase is 0 and
000210r 2               ; this does nothing.
000210r 2               IRQ_BASIC:
000210r 2  A5 DF                lda     IrqBase
000212r 2  4A                   lsr     a
000213r 2  05 DF                ora     IrqBase
000215r 2  85 DF                sta     IrqBase
000217r 2               IRQ_EXIT:
000217r 2  68                   pla
000218r 2  A8                   tay
000219r 2  68                   pla
00021Ar 2  AA                   tax
00021Br 2  68                   pla
00021Cr 2  40                   rti
00021Dr 2               
00021Dr 2               ; ----------------------------------------------------------------------------
00021Dr 2               ; IRQ_CALL handler - call one driver; if it claimed the interrupt, we're done
00021Dr 2               ; ----------------------------------------------------------------------------
00021Dr 2               .macro IRQ_CALL handler
00021Dr 2                       jsr     handler
00021Dr 2                       bcc     :+
00021Dr 2                       jmp     IRQ_EXIT
00021Dr 2               :
00021Dr 2               .endmacro
00021Dr 2               
00021Dr 2               ; ----------------------------------------------------------------------------
00021Dr 2               ; IRQ_LINE n - the handler for line n, from the settings in config.inc
00021Dr 2               ; ----------------------------------------------------------------------------
00021Dr 2               .macro IRQ_LINE n
00021Dr 2               .ident(.sprintf("IRQ%d", n)):
00021Dr 2                 .if HAS_AVRKBD                        ; keyboard first: typing stays responsive
00021Dr 2                   .if AVRKBD_IRQ = n
00021Dr 2                       IRQ_CALL avrkbd_irq
00021Dr 2                   .endif
00021Dr 2                 .endif
00021Dr 2                 .if ESP_KEYS
00021Dr 2                   .if ESP32_IRQ <> 0 .and ESP32_IRQ = n
00021Dr 2                       IRQ_CALL esp_irq
00021Dr 2                   .endif
00021Dr 2                 .endif
00021Dr 2                 .if CON_DISPLAY = DISP_PICO
00021Dr 2                   .if PICO_IRQ <> 0 .and PICO_IRQ = n
00021Dr 2                       IRQ_CALL pico_irq
00021Dr 2                   .endif
00021Dr 2                 .endif
00021Dr 2                 .if CON_DISPLAY = DISP_TERM
00021Dr 2                   .if n = 5
00021Dr 2                       IRQ_CALL term_irq
00021Dr 2                   .endif
00021Dr 2                 .endif
00021Dr 2                 .if HAS_ACIA
00021Dr 2                   .if n = 3
00021Dr 2                       IRQ_CALL acia_irq
00021Dr 2                   .endif
00021Dr 2                 .endif
00021Dr 2                 .if HAS_VIA
00021Dr 2                   .if n = 2
00021Dr 2                       IRQ_CALL via_irq
00021Dr 2                   .endif
00021Dr 2                 .endif
00021Dr 2                       jmp     IRQ_BASIC
00021Dr 2               .endmacro
00021Dr 2               
00021Dr 2  4C rr rr             IRQ_LINE 0
000220r 2  4C rr rr             IRQ_LINE 1
000223r 2  20 rr rr 90          IRQ_LINE 2
000227r 2  03 4C rr rr  
00022Br 2  4C rr rr     
00022Er 2  20 rr rr 90          IRQ_LINE 3
000232r 2  03 4C rr rr  
000236r 2  4C rr rr     
000239r 2  4C rr rr             IRQ_LINE 4
00023Cr 2  20 rr rr 90          IRQ_LINE 5
000240r 2  03 4C rr rr  
000244r 2  4C rr rr     
000247r 2  4C rr rr             IRQ_LINE 6
00024Ar 2  4C rr rr             IRQ_LINE 7
00024Dr 2               
00024Dr 1               .include "console.s"            ; CHRIN / CHROUT, input buffer
00024Dr 2               ; ============================================================================
00024Dr 2               ; console.s - console layer: CHRIN / CHROUT and the input buffer
00024Dr 2               ;
00024Dr 2               ; Input:  every driver that produces keys (keyboard, serial, gamepad) puts
00024Dr 2               ;         them in one 256 byte buffer from its interrupt handler with
00024Dr 2               ;         CON_PUTKEY.  CHRIN takes them out.  With CON_POLL = 1, CHRIN also
00024Dr 2               ;         polls the devices, so typing works even if an IRQ jumper is wrong.
00024Dr 2               ; Output: CHROUT sends each character to the display driver and/or the serial
00024Dr 2               ;         console, as chosen by CON_INIT at boot (con_out).
00024Dr 2               ;
00024Dr 2               ; The drivers chosen in config.inc are reached through these names:
00024Dr 2               ;   disp_init  C=0 if the display card answered
00024Dr 2               ;   disp_putc  print A (may change A, X, Y)
00024Dr 2               ;   ser_putc   send A out of the serial console (may change A, X, Y)
00024Dr 2               ; ============================================================================
00024Dr 2               
00024Dr 2               CON_TO_DISP     = $01                   ; con_out bits
00024Dr 2               CON_TO_SER      = $02
00024Dr 2               
00024Dr 2               ; ---- pick the drivers -------------------------------------------------------
00024Dr 2               .if CON_DISPLAY = DISP_TERM
00024Dr 2               disp_init       = term_init
00024Dr 2               disp_putc       = term_putc
00024Dr 2               disp_reset      = term_init
00024Dr 2               .elseif CON_DISPLAY = DISP_ESP32
00024Dr 2               disp_init       = esp_init
00024Dr 2               disp_putc       = esp_putc
00024Dr 2               disp_reset      = esp_reset
00024Dr 2               .elseif CON_DISPLAY = DISP_PICO
00024Dr 2               disp_init       = pico_init
00024Dr 2               disp_putc       = pico_putc
00024Dr 2               disp_reset      = pico_reset
00024Dr 2               .endif
00024Dr 2               
00024Dr 2               ; ---- graphics: the gfx_ calls used by BASIC (basic_gfx.s) --------------------
00024Dr 2               ; In:  gfx_x, gfx_y (16 bit; text column/row for gfx_locate), gfx_x1, gfx_y1,
00024Dr 2               ;      gfx_c colour (sprites: colour on the PICO9918, flags on the ESP32),
00024Dr 2               ;      gfx_r radius, gfx_f fill (circle 0/1, box 1/2), gfx_n sprite, gfx_p
00024Dr 2               ;      pattern, gfx_fg / gfx_bg text colours, con_ptr sprite data.
00024Dr 2               ; GFX_OK = 1 if the display has graphics.
00024Dr 2               .if CON_DISPLAY = DISP_ESP32
00024Dr 2               GFX_OK          = 1
00024Dr 2               gfx_cls         = esp_gcls              ; A = $FF clear, 0 text, 1 graphics
00024Dr 2               gfx_color       = esp_gcolor
00024Dr 2               gfx_locate      = esp_glocate
00024Dr 2               gfx_plot        = esp_gplot
00024Dr 2               gfx_line        = esp_gline
00024Dr 2               gfx_box         = esp_gbox
00024Dr 2               gfx_circle      = esp_gcircle
00024Dr 2               gfx_sprite      = esp_gsprite
00024Dr 2               gfx_sprdef      = esp_gsprdef
00024Dr 2               gfx_vsync       = esp_vsync
00024Dr 2               .elseif CON_DISPLAY = DISP_PICO
00024Dr 2               GFX_OK          = 1
00024Dr 2               gfx_cls         = pico_gcls
00024Dr 2               gfx_color       = pico_gcolor
00024Dr 2               gfx_locate      = pico_glocate
00024Dr 2               gfx_plot        = pico_gplot
00024Dr 2               gfx_line        = pico_gline
00024Dr 2               gfx_box         = pico_gbox
00024Dr 2               gfx_circle      = pico_gcircle
00024Dr 2               gfx_sprite      = pico_gsprite
00024Dr 2               gfx_sprdef      = pico_gsprdef
00024Dr 2               gfx_vsync       = pico_vsync
00024Dr 2               .else
00024Dr 2               GFX_OK          = 0
00024Dr 2               .endif
00024Dr 2               
00024Dr 2               .if CON_SERIAL = SER_AVR
00024Dr 2               ser_putc        = avrkbd_putc
00024Dr 2               .elseif CON_SERIAL = SER_ACIA
00024Dr 2               ser_putc        = acia_putc
00024Dr 2               .endif
00024Dr 2               
00024Dr 2               ; ---- RAM ----------------------------------------------------------------------
00024Dr 2               .zeropage
000002r 2  xx           READ_PTR:       .res 1
000003r 2  xx           WRITE_PTR:      .res 1
000004r 2  xx xx        con_ptr:        .res 2                  ; display drivers: font / sprite data
000006r 2               
000006r 2               .segment "DRVVARS"
000013r 2  xx xx        gfx_x:          .res 2                  ; (keep x, y, x1, y1 together and in
000015r 2  xx xx        gfx_y:          .res 2                  ;  this order: drv_pico.s copies them)
000017r 2  xx xx        gfx_x1:         .res 2
000019r 2  xx xx        gfx_y1:         .res 2
00001Br 2  xx           gfx_c:          .res 1
00001Cr 2  xx           gfx_r:          .res 1
00001Dr 2  xx           gfx_f:          .res 1
00001Er 2  xx           gfx_n:          .res 1
00001Fr 2  xx           gfx_p:          .res 1
000020r 2  xx           gfx_fg:         .res 1
000021r 2  xx           gfx_bg:         .res 1
000022r 2               
000022r 2               .segment "BIOSVARS"
000001r 2  xx           LAST_CHAR:      .res 1
000002r 2               
000002r 2               .segment "DRVVARS"
000022r 2  xx           con_out:        .res 1                  ; CON_TO_DISP / CON_TO_SER
000023r 2  xx           con_ch:         .res 1                  ; CHROUT's character
000024r 2               
000024r 2               .segment "INPUT_BUFFER"
000000r 2  xx xx xx xx  INPUT_BUFFER:   .res $100
000004r 2  xx xx xx xx  
000008r 2  xx xx xx xx  
000100r 2               
000100r 2               .segment "BIOS"
00024Dr 2               
00024Dr 2               ; ----------------------------------------------------------------------------
00024Dr 2               ; CON_INIT - start the display driver and choose where output goes.
00024Dr 2               ; Called from RESET after the serial/keyboard drivers.  Clobbers A, X, Y.
00024Dr 2               ; ----------------------------------------------------------------------------
00024Dr 2               CON_INIT:
00024Dr 2  A9 00                lda     #0
00024Fr 2  8D rr rr             sta     con_out
000252r 2               .if CON_DISPLAY <> DISP_NONE
000252r 2  20 rr rr             jsr     disp_init
000255r 2  B0 06                bcs     @nodisp
000257r 2  A9 01                lda     #CON_TO_DISP
000259r 2  8D rr rr             sta     con_out
00025Cr 2                 .if CON_MIRROR .and (CON_SERIAL <> SER_NONE)
00025Cr 2                       jsr     ser_ok
00025Cr 2                       bcs     @done
00025Cr 2                       lda     #(CON_TO_DISP | CON_TO_SER)
00025Cr 2                       sta     con_out
00025Cr 2                 .endif
00025Cr 2  60                   rts
00025Dr 2               @nodisp:
00025Dr 2               .endif
00025Dr 2               .if CON_SERIAL <> SER_NONE
00025Dr 2  20 rr rr             jsr     ser_ok                  ; no display: the serial console
000260r 2  B0 05                bcs     @done
000262r 2  A9 02                lda     #CON_TO_SER
000264r 2  8D rr rr             sta     con_out
000267r 2               .endif
000267r 2  60           @done:  rts
000268r 2               
000268r 2               ; ser_ok - C=0 if the serial console's device answered at boot
000268r 2               .if CON_SERIAL <> SER_NONE
000268r 2               ser_ok:
000268r 2                 .if CON_SERIAL = SER_AVR
000268r 2  AD rr rr             lda     avr_ok
00026Br 2                 .else
00026Br 2                       lda     acia_ok
00026Br 2                 .endif
00026Br 2  0A                   asl     a                       ; bit 7 -> carry: 1 = answered
00026Cr 2  B0 02                bcs     @yes
00026Er 2  38                   sec
00026Fr 2  60                   rts
000270r 2  18           @yes:   clc
000271r 2  60                   rts
000272r 2               .endif
000272r 2               
000272r 2               ; ----------------------------------------------------------------------------
000272r 2               ; CHROUT - print the character in A.  Preserves A, X and Y.
000272r 2               ; Used as EhBASIC's output vector and by the monitor.
000272r 2               ; ----------------------------------------------------------------------------
000272r 2               MONCOUT:
000272r 2               CHROUT:
000272r 2  2C rr rr             bit     ld_on                   ; quiet while LOAD types in a text file
000275r 2  10 03                bpl     @go
000277r 2  48                   pha                             ; (keep Z/N = the character, as below)
000278r 2  68                   pla
000279r 2  60                   rts
00027Ar 2  8D rr rr     @go:    sta     con_ch
00027Dr 2  48                   pha
00027Er 2  8A                   txa
00027Fr 2  48                   pha
000280r 2  98                   tya
000281r 2  48                   pha
000282r 2               .if CON_DISPLAY <> DISP_NONE
000282r 2  AD rr rr             lda     con_out
000285r 2  29 01                and     #CON_TO_DISP
000287r 2  F0 06                beq     @ser
000289r 2  AD rr rr             lda     con_ch
00028Cr 2  20 rr rr             jsr     disp_putc
00028Fr 2               @ser:
00028Fr 2               .endif
00028Fr 2               .if CON_SERIAL <> SER_NONE
00028Fr 2  AD rr rr             lda     con_out
000292r 2  29 02                and     #CON_TO_SER
000294r 2  F0 06                beq     @done
000296r 2  AD rr rr             lda     con_ch
000299r 2  20 rr rr             jsr     ser_putc
00029Cr 2               @done:
00029Cr 2               .endif
00029Cr 2  68                   pla
00029Dr 2  A8                   tay
00029Er 2  68                   pla
00029Fr 2  AA                   tax
0002A0r 2  68                   pla
0002A1r 2  60                   rts
0002A2r 2               
0002A2r 2               ; ----------------------------------------------------------------------------
0002A2r 2               ; SER_OUT - send A out of the serial console port, whether or not it is the
0002A2r 2               ; console right now (for terminal programs).  Preserves A, X and Y.
0002A2r 2               ; ----------------------------------------------------------------------------
0002A2r 2               SER_OUT:
0002A2r 2               .if CON_SERIAL <> SER_NONE
0002A2r 2  8D rr rr             sta     con_ch
0002A5r 2  48                   pha
0002A6r 2  8A                   txa
0002A7r 2  48                   pha
0002A8r 2  98                   tya
0002A9r 2  48                   pha
0002AAr 2  AD rr rr             lda     con_ch
0002ADr 2  20 rr rr             jsr     ser_putc
0002B0r 2  68                   pla
0002B1r 2  A8                   tay
0002B2r 2  68                   pla
0002B3r 2  AA                   tax
0002B4r 2  68                   pla
0002B5r 2               .endif
0002B5r 2  60                   rts
0002B6r 2               
0002B6r 2               ; ----------------------------------------------------------------------------
0002B6r 2               ; CHRIN - get a character without waiting, and without echo.
0002B6r 2               ;   carry set   = A is the character (Z/N reflect it: EhBASIC relies on that)
0002B6r 2               ;   carry clear = nothing waiting, A = 0
0002B6r 2               ; Preserves X and Y.  Used as EhBASIC's input vector and by the monitor.
0002B6r 2               ; ----------------------------------------------------------------------------
0002B6r 2               MONRDKEY:
0002B6r 2               CHRIN:
0002B6r 2  2C rr rr             bit     ld_on                   ; LOAD is typing in a text file?
0002B9r 2  10 03                bpl     @kbd
0002BBr 2  4C rr rr             jmp     ld_getc                 ; (ch376_loadsave.s)
0002BEr 2  8A           @kbd:   txa
0002BFr 2  48                   pha
0002C0r 2  98                   tya
0002C1r 2  48                   pha
0002C2r 2               .if CON_POLL
0002C2r 2  20 rr rr             jsr     CON_POLLDEV
0002C5r 2               .endif
0002C5r 2  20 rr rr             jsr     BUFFER_SIZE
0002C8r 2  F0 0C                beq     @none
0002CAr 2  20 rr rr             jsr     READ_BUFFER             ; A = the character (and LAST_CHAR)
0002CDr 2  68                   pla
0002CEr 2  A8                   tay
0002CFr 2  68                   pla
0002D0r 2  AA                   tax
0002D1r 2  AD rr rr             lda     LAST_CHAR               ; sets Z/N for the caller
0002D4r 2  38                   sec
0002D5r 2  60                   rts
0002D6r 2  68           @none:  pla
0002D7r 2  A8                   tay
0002D8r 2  68                   pla
0002D9r 2  AA                   tax
0002DAr 2  A9 00                lda     #0
0002DCr 2  18                   clc
0002DDr 2  60                   rts
0002DEr 2               
0002DEr 2               ; ----------------------------------------------------------------------------
0002DEr 2               ; CON_POLLDEV - check the input devices directly, with interrupts off (so an
0002DEr 2               ; interrupt handler can't read the same device at the same moment).
0002DEr 2               ; Each driver's _irq routine only reads its device when it has a byte.
0002DEr 2               ; Clobbers A, X, Y.
0002DEr 2               ; ----------------------------------------------------------------------------
0002DEr 2               .if CON_POLL
0002DEr 2               CON_POLLDEV:
0002DEr 2  08                   php
0002DFr 2  78                   sei
0002E0r 2                 .if HAS_AVRKBD
0002E0r 2  20 rr rr             jsr     avrkbd_irq
0002E3r 2                 .endif
0002E3r 2                 .if CON_DISPLAY = DISP_TERM
0002E3r 2                       jsr     term_irq
0002E3r 2                 .endif
0002E3r 2                 .if HAS_ACIA .and ACIA_TO_CON
0002E3r 2                       jsr     acia_irq
0002E3r 2                 .endif
0002E3r 2                 .if ESP_KEYS
0002E3r 2                       jsr     esp_irq
0002E3r 2                 .endif
0002E3r 2  28                   plp
0002E4r 2  60                   rts
0002E5r 2               .endif
0002E5r 2               
0002E5r 2               ; ----------------------------------------------------------------------------
0002E5r 2               ; CON_PUTKEY - put A in the input buffer (from interrupt handlers, or with
0002E5r 2               ; interrupts off).  A full buffer drops the byte.  Uses X; preserves A and Y.
0002E5r 2               ; ----------------------------------------------------------------------------
0002E5r 2               CON_PUTKEY:
0002E5r 2  A6 rr                ldx     WRITE_PTR
0002E7r 2  E8                   inx
0002E8r 2  E4 rr                cpx     READ_PTR
0002EAr 2  F0 06                beq     @full                   ; keep one slot free: full
0002ECr 2  CA                   dex
0002EDr 2  9D rr rr             sta     INPUT_BUFFER,x
0002F0r 2  E6 rr                inc     WRITE_PTR
0002F2r 2  60           @full:  rts
0002F3r 2               
0002F3r 2               ; ----------------------------------------------------------------------------
0002F3r 2               ; The buffer routines (names kept from the Rev1 BIOS; gamepad.s uses them)
0002F3r 2               ; ----------------------------------------------------------------------------
0002F3r 2               INIT_BUFFER:                            ; empty the buffer.  Modifies A
0002F3r 2  A9 00                lda     #0
0002F5r 2  85 rr                sta     READ_PTR
0002F7r 2  85 rr                sta     WRITE_PTR
0002F9r 2  60                   rts
0002FAr 2               
0002FAr 2               WRITE_BUFFER    = CON_PUTKEY            ; A -> buffer.  Modifies X
0002FAr 2               
0002FAr 2               READ_BUFFER:                            ; A (and LAST_CHAR) <- buffer.  Modifies X
0002FAr 2  A6 rr                ldx     READ_PTR
0002FCr 2  BD rr rr             lda     INPUT_BUFFER,x
0002FFr 2  8D rr rr             sta     LAST_CHAR
000302r 2  E6 rr                inc     READ_PTR
000304r 2  60                   rts
000305r 2               
000305r 2               BUFFER_SIZE:                            ; A = bytes waiting.  Modifies A
000305r 2  A5 rr                lda     WRITE_PTR
000307r 2  38                   sec
000308r 2  E5 rr                sbc     READ_PTR
00030Ar 2  60                   rts
00030Br 2               
00030Br 1               .include "drv_via.s"            ; 65C22: 60 Hz tick, LEDs (VIA names used below)
00030Br 2               ; ============================================================================
00030Br 2               ; drv_via.s - 65C22 VIA on the ISA6502_IO card ($7F00-$7F0F, IRQ2)
00030Br 2               ;
00030Br 2               ; Timer 1 is the 60 Hz system tick.  The timer counts only 16 bits, so on a
00030Br 2               ; fast clock it runs TICK_DIV times faster and every TICK_DIV-th timeout is a
00030Br 2               ; tick:  up to 3 MHz 60 Hz,  4-7 MHz 120 Hz (every 2nd),  8-11 MHz 180 Hz ...
00030Br 2               ; Each tick: the 60 Hz counter, the gamepad poll and BASIC's timed notes.
00030Br 2               ; Port A: gamepad (gamepad.s).  Port B: device status LEDs (DEVSTAT).
00030Br 2               ; ============================================================================
00030Br 2               
00030Br 2               PORTB           = $7F00
00030Br 2               PORTA           = $7F01
00030Br 2               DDRB            = $7F02
00030Br 2               DDRA            = $7F03
00030Br 2               VIA_T1CL        = $7F04                 ; timer 1 counter low  (reading clears its flag)
00030Br 2               VIA_T1CH        = $7F05                 ; timer 1 counter high (writing starts it)
00030Br 2               VIA_T1LL        = $7F06                 ; timer 1 latch low
00030Br 2               VIA_T1LH        = $7F07                 ; timer 1 latch high
00030Br 2               VIA_ACR         = $7F0B                 ; auxiliary control register
00030Br 2               IFR             = $7F0D
00030Br 2               IER             = $7F0E
00030Br 2               
00030Br 2               TICK_HZ         = 60
00030Br 2               TICK_DIV        = ((CPU_KHZ * 1000) / TICK_HZ - 2) / 65536 + 1
00030Br 2               TICK_T1         = (CPU_KHZ * 1000) / (TICK_HZ * TICK_DIV) - 2
00030Br 2               .assert TICK_T1 > 0 .and TICK_T1 < 65536, error, "TICK_T1 doesn't fit the 16 bit VIA timer"
00030Br 2               
00030Br 2               .segment "DRVVARS"
000024r 2  xx           via_ok:         .res 1                  ; $80 = VIA answered at boot
000025r 2  xx           tick_div:       .res 1                  ; timer 1 timeouts until the next tick
000026r 2  xx xx xx     ticks:          .res 3                  ; 60 Hz counter, low byte first
000029r 2               
000029r 2               .segment "BIOS"
00030Br 2               
00030Br 2               ; ----------------------------------------------------------------------------
00030Br 2               ; VIA_INIT - check the VIA is there, set up port B (LEDs) and start the tick.
00030Br 2               ; Clobbers A.
00030Br 2               ; ----------------------------------------------------------------------------
00030Br 2               VIA_INIT:
00030Br 2  A9 00                lda     #0
00030Dr 2  8D rr rr             sta     via_ok
000310r 2  8D rr rr             sta     ticks
000313r 2  8D rr rr             sta     ticks+1
000316r 2  8D rr rr             sta     ticks+2
000319r 2  A9 7F                lda     #$7F                    ; disable all VIA interrupts
00031Br 2  8D 0E 7F             sta     IER
00031Er 2  AD 0E 7F             lda     IER                     ; IER reads back with bit 7 = 1:
000321r 2  C9 80                cmp     #$80                    ; $80 now if the VIA is there
000323r 2  D0 35                bne     @done                   ; (an empty bus reads $7F)
000325r 2  A9 80                lda     #$80
000327r 2  8D rr rr             sta     via_ok
00032Ar 2  A9 01                lda     #1
00032Cr 2  0D rr rr             ora     DEVSTAT
00032Fr 2  8D rr rr             sta     DEVSTAT                 ; device status bit 0
000332r 2  A9 7F                lda     #$7F
000334r 2  8D 0D 7F             sta     IFR                     ; clear any old flags
000337r 2  A9 FF                lda     #$FF
000339r 2  8D 02 7F             sta     DDRB                    ; port B: status LEDs
00033Cr 2  A9 02                lda     #TICK_DIV
00033Er 2  8D rr rr             sta     tick_div
000341r 2  AD 0B 7F             lda     VIA_ACR                 ; timer 1 free running, interrupt on timeout
000344r 2  29 3F                and     #$3F
000346r 2  09 40                ora     #$40
000348r 2  8D 0B 7F             sta     VIA_ACR
00034Br 2  A9 33                lda     #<TICK_T1
00034Dr 2  8D 06 7F             sta     VIA_T1LL
000350r 2  A9 82                lda     #>TICK_T1
000352r 2  8D 05 7F             sta     VIA_T1CH                ; loads the counter and starts it
000355r 2  A9 C0                lda     #$C0                    ; enable the timer 1 interrupt
000357r 2  8D 0E 7F             sta     IER
00035Ar 2  60           @done:  rts
00035Br 2               
00035Br 2               ; ----------------------------------------------------------------------------
00035Br 2               ; via_irq - from irq.s.  C=1 = handled; C=0 = another VIA source wants
00035Br 2               ; attention (passed on to BASIC's ON IRQ).
00035Br 2               ; ----------------------------------------------------------------------------
00035Br 2               via_irq:
00035Br 2  AD 0D 7F             lda     IFR
00035Er 2  29 40                and     #$40                    ; timer 1 timeout?
000360r 2  F0 23                beq     @other
000362r 2  AD 04 7F             lda     VIA_T1CL                ; reading the low counter clears the flag
000365r 2               .if HAS_SPO
000365r 2  20 rr rr             jsr     spo_tick                ; speech: every timeout (60-180 Hz)
000368r 2               .endif
000368r 2  CE rr rr             dec     tick_div
00036Br 2  D0 18                bne     @other
00036Dr 2  A9 02                lda     #TICK_DIV
00036Fr 2  8D rr rr             sta     tick_div
000372r 2  EE rr rr             inc     ticks
000375r 2  D0 08                bne     :+
000377r 2  EE rr rr             inc     ticks+1
00037Ar 2  D0 03                bne     :+
00037Cr 2  EE rr rr             inc     ticks+2
00037Fr 2               :
00037Fr 2               .if HAS_GAMEPAD
00037Fr 2  20 rr rr             jsr     PAD_POLL
000382r 2               .endif
000382r 2               .if SND_DEV <> SND_NONE
000382r 2  20 rr rr             jsr     SND_TICK                ; timed notes (basic_ay.s)
000385r 2               .endif
000385r 2  AD 0D 7F     @other: lda     IFR
000388r 2  2D 0E 7F             and     IER
00038Br 2  29 3F                and     #$3F                    ; another enabled VIA source?
00038Dr 2  F0 02                beq     @mine
00038Fr 2  18                   clc
000390r 2  60                   rts
000391r 2  38           @mine:  sec
000392r 2  60                   rts
000393r 2               
000393r 2               ; ----------------------------------------------------------------------------
000393r 2               ; TICKS_GET - A/X/Y = the 60 Hz counter, low/middle/high
000393r 2               ; ----------------------------------------------------------------------------
000393r 2               TICKS_GET:
000393r 2  08                   php
000394r 2  78                   sei
000395r 2  AD rr rr             lda     ticks
000398r 2  AE rr rr             ldx     ticks+1
00039Br 2  AC rr rr             ldy     ticks+2
00039Er 2  28                   plp
00039Fr 2  60                   rts
0003A0r 2               
0003A0r 1               .include "drv_acia.s"           ; serial card 6551
0003A0r 2               ; ============================================================================
0003A0r 2               ; drv_acia.s - 6551 ACIA on the serial card ($7F14-$7F17, IRQ3)
0003A0r 2               ;
0003A0r 2               ; ACIA_TO_CON = 1 (config.inc: ACIA_CONSOLE, or CON_SERIAL = SER_ACIA):
0003A0r 2               ;     receive interrupts on; what arrives is typed into the console.
0003A0r 2               ; ACIA_TO_CON = 0:
0003A0r 2               ;     receive interrupts off; the port is free for your own programs
0003A0r 2               ;     (SBC_ACIAIN / SBC_ACIAOUT in the jump table, e.g. a modem).
0003A0r 2               ;
0003A0r 2               ; ACIA_WDC = 1: the W65C51N's "transmit register empty" flag doesn't work,
0003A0r 2               ; so after each byte the driver waits one character time instead.
0003A0r 2               ; ============================================================================
0003A0r 2               
0003A0r 2               ACIA_DATA       = $7F14
0003A0r 2               ACIA_STATUS     = $7F15
0003A0r 2               ACIA_CMD        = $7F16
0003A0r 2               ACIA_CTRL       = $7F17
0003A0r 2               
0003A0r 2               ; control register: 1 stop bit, 8 data bits, internal baud rate generator
0003A0r 2               .if ACIA_BAUD = 1200
0003A0r 2               ACIA_CTRL_VAL   = $18
0003A0r 2               .elseif ACIA_BAUD = 2400
0003A0r 2               ACIA_CTRL_VAL   = $1A
0003A0r 2               .elseif ACIA_BAUD = 4800
0003A0r 2               ACIA_CTRL_VAL   = $1C
0003A0r 2               .elseif ACIA_BAUD = 9600
0003A0r 2               ACIA_CTRL_VAL   = $1E
0003A0r 2               .elseif ACIA_BAUD = 19200
0003A0r 2               ACIA_CTRL_VAL   = $1F
0003A0r 2               .else
0003A0r 2                 .error "config.inc: ACIA_BAUD must be 1200, 2400, 4800, 9600 or 19200"
0003A0r 2               .endif
0003A0r 2               
0003A0r 2               ; command register: no parity, no echo, RTS low + TX interrupt off, DTR on;
0003A0r 2               ; receive interrupt on only when the port feeds the console
0003A0r 2               .if ACIA_TO_CON
0003A0r 2               ACIA_CMD_VAL    = $89
0003A0r 2               .else
0003A0r 2               ACIA_CMD_VAL    = $8B
0003A0r 2               .endif
0003A0r 2               
0003A0r 2               ; W65C51N: one character (11 bit times, a little margin) in 5-cycle loops
0003A0r 2               ACIA_CHAR_LOOPS = (CPU_KHZ * 11000 / ACIA_BAUD) / 5 + 1
0003A0r 2               
0003A0r 2               ; ~0.15 s timeout for "transmit register empty" in 11-cycle loops
0003A0r 2               ACIA_TX_TIMEOUT = CPU_KHZ * 150 / 11
0003A0r 2               .if ACIA_TX_TIMEOUT > $FE00
0003A0r 2                 ACIA_TX_TO    = $FE00
0003A0r 2               .else
0003A0r 2                 ACIA_TX_TO    = ACIA_TX_TIMEOUT
0003A0r 2               .endif
0003A0r 2               
0003A0r 2               .segment "DRVVARS"
000029r 2  xx           acia_ok:        .res 1                  ; $80 = answered at boot
00002Ar 2               
00002Ar 2               .segment "BIOS"
0003A0r 2               
0003A0r 2               ; ----------------------------------------------------------------------------
0003A0r 2               ; acia_init - C=0 if the 6551 answered.  Clobbers A.
0003A0r 2               ; ----------------------------------------------------------------------------
0003A0r 2               acia_init:
0003A0r 2  A9 00                lda     #0
0003A2r 2  8D rr rr             sta     acia_ok
0003A5r 2  8D 15 7F             sta     ACIA_STATUS             ; programmed reset
0003A8r 2  A9 1A                lda     #ACIA_CTRL_VAL
0003AAr 2  8D 17 7F             sta     ACIA_CTRL
0003ADr 2  4D 17 7F             eor     ACIA_CTRL               ; the control register reads back
0003B0r 2  D0 17                bne     @absent
0003B2r 2  A9 8B                lda     #ACIA_CMD_VAL
0003B4r 2  8D 16 7F             sta     ACIA_CMD
0003B7r 2  AD 14 7F             lda     ACIA_DATA               ; drop anything stale
0003BAr 2  A9 80                lda     #$80
0003BCr 2  8D rr rr             sta     acia_ok
0003BFr 2  A9 02                lda     #2
0003C1r 2  0D rr rr             ora     DEVSTAT
0003C4r 2  8D rr rr             sta     DEVSTAT                 ; device status bit 1
0003C7r 2  18                   clc
0003C8r 2  60                   rts
0003C9r 2               @absent:
0003C9r 2  38                   sec
0003CAr 2  60                   rts
0003CBr 2               
0003CBr 2               ; ----------------------------------------------------------------------------
0003CBr 2               ; acia_irq - from irq.s (and CHRIN's polling).  C=1 = a byte was received and
0003CBr 2               ; put in the console buffer; C=0 = not ours.  Clobbers A, X.
0003CBr 2               ; ----------------------------------------------------------------------------
0003CBr 2               acia_irq:
0003CBr 2  AD 15 7F             lda     ACIA_STATUS             ; (reading it clears the IRQ flag)
0003CEr 2  29 08                and     #$08                    ; receive register full?
0003D0r 2  F0 05                beq     @no
0003D2r 2  AD 14 7F             lda     ACIA_DATA
0003D5r 2               .if ACIA_TO_CON
0003D5r 2                       jsr     CON_PUTKEY
0003D5r 2               .endif
0003D5r 2  38                   sec
0003D6r 2  60                   rts
0003D7r 2  18           @no:    clc
0003D8r 2  60                   rts
0003D9r 2               
0003D9r 2               ; ----------------------------------------------------------------------------
0003D9r 2               ; acia_putc - send A.  Gives up after ~0.15 s if the 6551 never gets ready.
0003D9r 2               ; Preserves A; clobbers X, Y.
0003D9r 2               ; ----------------------------------------------------------------------------
0003D9r 2               acia_putc:
0003D9r 2  2C rr rr             bit     acia_ok
0003DCr 2  10 18                bpl     @x
0003DEr 2               .if ACIA_WDC
0003DEr 2                       sta     ACIA_DATA
0003DEr 2                       ldx     #<ACIA_CHAR_LOOPS
0003DEr 2                       ldy     #((ACIA_CHAR_LOOPS >> 8) + 1)
0003DEr 2               @d:     dex                             ; 5 cycles a loop
0003DEr 2                       bne     @d
0003DEr 2                       dey
0003DEr 2                       bne     @d
0003DEr 2               .else
0003DEr 2  48                   pha
0003DFr 2  A2 11                ldx     #<ACIA_TX_TO
0003E1r 2  A0 D6                ldy     #((ACIA_TX_TO >> 8) + 1)
0003E3r 2  AD 15 7F     @w:     lda     ACIA_STATUS             ; 4
0003E6r 2  29 10                and     #$10                    ; 2  transmit register empty?
0003E8r 2  D0 08                bne     @go                     ; 2
0003EAr 2  CA                   dex                             ; 2
0003EBr 2  D0 F6                bne     @w                      ; 3  (11 cycles a loop)
0003EDr 2  88                   dey
0003EEr 2  D0 F3                bne     @w
0003F0r 2  68                   pla                             ; timed out: drop the byte
0003F1r 2  60                   rts
0003F2r 2  68           @go:    pla
0003F3r 2  8D 14 7F             sta     ACIA_DATA
0003F6r 2               .endif
0003F6r 2  60           @x:     rts
0003F7r 2               
0003F7r 2               ; ----------------------------------------------------------------------------
0003F7r 2               ; acia_getc - for programs using the port themselves (ACIA_TO_CON = 0):
0003F7r 2               ; C=1 and A = the byte, or C=0 if nothing has arrived.  Preserves X and Y.
0003F7r 2               ; ----------------------------------------------------------------------------
0003F7r 2               acia_getc:
0003F7r 2  2C rr rr             bit     acia_ok
0003FAr 2  10 0C                bpl     @no
0003FCr 2  AD 15 7F             lda     ACIA_STATUS
0003FFr 2  29 08                and     #$08
000401r 2  F0 05                beq     @no
000403r 2  AD 14 7F             lda     ACIA_DATA
000406r 2  38                   sec
000407r 2  60                   rts
000408r 2  A9 00        @no:    lda     #0
00040Ar 2  18                   clc
00040Br 2  60                   rts
00040Cr 2               
00040Cr 1               .include "drv_avrkbd.s"         ; AVR keyboard / mouse / serial console
00040Cr 2               ; ============================================================================
00040Cr 2               ; drv_avrkbd.s - AVR keyboard / mouse / serial console interface
00040Cr 2               ;               (Serial Rev3 card or PICO9918 card; only one is fitted)
00040Cr 2               ;
00040Cr 2               ;   $7F1E read : next byte from the AVR's queue (reading it acknowledges it)
00040Cr 2               ;   $7F1E write: byte to send out of the AVR's serial port, or a command
00040Cr 2               ;   $7F1F read : status  D7 = KBAVAIL (1 = byte waiting)    -> BIT sets N
00040Cr 2               ;                        D6 = DBUSY   (1 = TX byte not taken) -> BIT sets V
00040Cr 2               ;   KBAVAIL drives the card's IRQ line (jumper 5 or 6: AVRKBD_IRQ).
00040Cr 2               ;
00040Cr 2               ; Byte stream from the AVR:
00040Cr 2               ;   $00-$FE        a key (PS/2 keyboard, or a byte from the serial port)
00040Cr 2               ;   $FF $FF        a literal $FF from the serial port
00040Cr 2               ;   $FF $01 b x y  mouse report: b buttons (bit0 L, bit1 R, bit2 M),
00040Cr 2               ;                  x/y signed movement (right / down positive)
00040Cr 2               ; Commands to the AVR:  $FF $01 mouse on   $FF $00 mouse off   $FF $FF = $FF
00040Cr 2               ;
00040Cr 2               ; The AVR loads its next byte only after the previous one has been read, so
00040Cr 2               ; a mouse report arrives one byte per interrupt; avr_state keeps track of
00040Cr 2               ; where we are between interrupts.  Exactly one byte is read per call, and
00040Cr 2               ; only when KBAVAIL says one is there.
00040Cr 2               ; ============================================================================
00040Cr 2               
00040Cr 2               AVR_DATA        = $7F1E
00040Cr 2               AVR_STAT        = $7F1F
00040Cr 2               AVR_ESC         = $FF
00040Cr 2               
00040Cr 2               ; Boot: wait up to ~0.2 s for DBUSY = 0 (the AVR clears it when it starts).
00040Cr 2               ; The loop is 11 cycles, 256 per page; at most 255 pages.
00040Cr 2               AVR_BOOT_PAGES0 = CPU_KHZ * 200 / 2816 + 1
00040Cr 2               .if AVR_BOOT_PAGES0 > 255
00040Cr 2               AVR_BOOT_PAGES  = 255
00040Cr 2               .else
00040Cr 2               AVR_BOOT_PAGES  = AVR_BOOT_PAGES0
00040Cr 2               .endif
00040Cr 2               ; Sending: give up after ~20 ms (11-cycle loops).  The AVR takes a byte in
00040Cr 2               ; well under 1 ms unless its 256 byte TX buffer is full (then ~87 us a byte).
00040Cr 2               AVR_TX_TO       = CPU_KHZ * 20 / 11
00040Cr 2               
00040Cr 2               .segment "DRVVARS"
00002Ar 2  xx           avr_ok:         .res 1                  ; $80 = the AVR answered
00002Br 2  xx           avr_state:      .res 1                  ; 0 normal, 1 after $FF, 2-4 mouse b/x/y
00002Cr 2  xx           ms_dx:          .res 1                  ; mouse movement since the last read,
00002Dr 2  xx           ms_dy:          .res 1                  ;   signed, held at -128 / +127
00002Er 2  xx           ms_btn:         .res 1                  ; mouse buttons now
00002Fr 2  xx           ms_new:         .res 1                  ; $80 = a report arrived since the last read
000030r 2               
000030r 2               .segment "BIOS"
00040Cr 2               
00040Cr 2               ; ----------------------------------------------------------------------------
00040Cr 2               ; avrkbd_init - C=0 if the AVR answered.  Turns mouse reports off (a 6502
00040Cr 2               ; reset doesn't reset the AVR).  Clobbers A, X, Y.
00040Cr 2               ; ----------------------------------------------------------------------------
00040Cr 2               avrkbd_init:
00040Cr 2  A9 00                lda     #0
00040Er 2  8D rr rr             sta     avr_ok
000411r 2  8D rr rr             sta     avr_state
000414r 2  8D rr rr             sta     ms_dx
000417r 2  8D rr rr             sta     ms_dy
00041Ar 2  8D rr rr             sta     ms_btn
00041Dr 2  8D rr rr             sta     ms_new
000420r 2  A2 00                ldx     #0
000422r 2  A0 FF                ldy     #AVR_BOOT_PAGES
000424r 2  2C 1F 7F     @w:     bit     AVR_STAT                ; 4
000427r 2  50 08                bvc     @ok                     ; 2  DBUSY clear: the AVR is running
000429r 2  CA                   dex                             ; 2
00042Ar 2  D0 F8                bne     @w                      ; 3
00042Cr 2  88                   dey
00042Dr 2  D0 F5                bne     @w
00042Fr 2  38                   sec                             ; DBUSY never cleared (an empty bus
000430r 2  60                   rts                             ; reads $7F: DBUSY looks stuck at 1)
000431r 2  A9 80        @ok:    lda     #$80
000433r 2  8D rr rr             sta     avr_ok
000436r 2  A9 08                lda     #8
000438r 2  0D rr rr             ora     DEVSTAT
00043Br 2  8D rr rr             sta     DEVSTAT                 ; device status bit 3
00043Er 2  A9 00                lda     #0
000440r 2  20 rr rr             jsr     MOUSE_ON                ; mouse reports off
000443r 2  18                   clc
000444r 2  60                   rts
000445r 2               
000445r 2               ; ----------------------------------------------------------------------------
000445r 2               ; avrkbd_irq - from irq.s (and CHRIN's polling).  Reads at most one byte.
000445r 2               ; C=1 = a byte was taken; C=0 = nothing waiting.  Clobbers A, X.
000445r 2               ; ----------------------------------------------------------------------------
000445r 2               avrkbd_irq:
000445r 2  2C 1F 7F             bit     AVR_STAT
000448r 2  30 02                bmi     @have
00044Ar 2  18                   clc
00044Br 2  60                   rts
00044Cr 2  AD 1E 7F     @have:  lda     AVR_DATA                ; reading it acknowledges it
00044Fr 2  AE rr rr             ldx     avr_state
000452r 2  D0 0E                bne     @esc
000454r 2  C9 FF                cmp     #AVR_ESC
000456r 2  F0 05                beq     @setesc
000458r 2  20 rr rr     @key:   jsr     CON_PUTKEY              ; a key
00045Br 2  38           @yes:   sec
00045Cr 2  60                   rts
00045Dr 2               @setesc:
00045Dr 2  EE rr rr             inc     avr_state               ; 0 -> 1
000460r 2  38                   sec
000461r 2  60                   rts
000462r 2               
000462r 2  E0 01        @esc:   cpx     #1
000464r 2  D0 14                bne     @mouse
000466r 2  A2 00                ldx     #0                      ; the byte after $FF:
000468r 2  8E rr rr             stx     avr_state
00046Br 2  C9 FF                cmp     #AVR_ESC
00046Dr 2  F0 E9                beq     @key                    ;   $FF $FF = a literal $FF
00046Fr 2  C9 01                cmp     #$01
000471r 2  D0 E8                bne     @yes                    ;   unknown: dropped
000473r 2  A9 02                lda     #2                      ;   $FF $01: a mouse report follows
000475r 2  8D rr rr             sta     avr_state
000478r 2  38                   sec
000479r 2  60                   rts
00047Ar 2               
00047Ar 2  E0 02        @mouse: cpx     #2
00047Cr 2  D0 08                bne     @xy
00047Er 2  8D rr rr             sta     ms_btn                  ; state 2: buttons
000481r 2  EE rr rr             inc     avr_state
000484r 2  38                   sec
000485r 2  60                   rts
000486r 2  E0 03        @xy:    cpx     #3                      ; (X is still avr_state)
000488r 2  F0 11                beq     @addx                   ; state 3: x -> ms_dx
00048Ar 2  A2 01                ldx     #1                      ; state 4: y -> ms_dy, report done
00048Cr 2  20 rr rr             jsr     ms_add
00048Fr 2  A9 80                lda     #$80
000491r 2  8D rr rr             sta     ms_new
000494r 2  A9 00                lda     #0
000496r 2  8D rr rr             sta     avr_state
000499r 2  38                   sec
00049Ar 2  60                   rts
00049Br 2  A2 00        @addx:  ldx     #0
00049Dr 2  20 rr rr             jsr     ms_add
0004A0r 2  EE rr rr             inc     avr_state
0004A3r 2  38                   sec
0004A4r 2  60                   rts
0004A5r 2               
0004A5r 2               ; ms_add - ms_dx,x = ms_dx,x + A, signed, held at -128 / +127
0004A5r 2  18           ms_add: clc
0004A6r 2  7D rr rr             adc     ms_dx,x
0004A9r 2  50 08                bvc     @st                     ; no signed overflow
0004ABr 2  30 04                bmi     @pos                    ; overflowed upward (wrapped negative)
0004ADr 2  A9 80                lda     #$80                    ; overflowed downward
0004AFr 2  D0 02                bne     @st
0004B1r 2  A9 7F        @pos:   lda     #$7F
0004B3r 2  9D rr rr     @st:    sta     ms_dx,x
0004B6r 2  60                   rts
0004B7r 2               
0004B7r 2               ; ----------------------------------------------------------------------------
0004B7r 2               ; avrkbd_putc - send A out of the AVR's serial port ($FF is sent as $FF $FF).
0004B7r 2               ; Preserves A; clobbers X, Y.
0004B7r 2               ; ----------------------------------------------------------------------------
0004B7r 2               avrkbd_putc:
0004B7r 2  2C rr rr             bit     avr_ok
0004BAr 2  10 1F                bpl     avr_x
0004BCr 2  C9 FF                cmp     #AVR_ESC
0004BEr 2  D0 03                bne     avr_send
0004C0r 2  20 rr rr             jsr     avr_send                ; first $FF of the pair
0004C3r 2                       ; (falls into avr_send for the second)
0004C3r 2               
0004C3r 2               ; avr_send - write A to $7F1E once DBUSY is clear.  If the AVR doesn't take a
0004C3r 2               ; byte within ~20 ms it is marked dead (avr_ok = 0) so output can't hang.
0004C3r 2               ; Preserves A; clobbers X, Y.
0004C3r 2               avr_send:
0004C3r 2  A2 68                ldx     #<AVR_TX_TO
0004C5r 2  A0 1D                ldy     #((AVR_TX_TO >> 8) + 1)
0004C7r 2  2C 1F 7F     @w:     bit     AVR_STAT                ; 4
0004CAr 2  50 0C                bvc     @go                     ; 2
0004CCr 2  CA                   dex                             ; 2
0004CDr 2  D0 F8                bne     @w                      ; 3
0004CFr 2  88                   dey
0004D0r 2  D0 F5                bne     @w
0004D2r 2  A2 00                ldx     #0
0004D4r 2  8E rr rr             stx     avr_ok
0004D7r 2  60                   rts
0004D8r 2  8D 1E 7F     @go:    sta     AVR_DATA
0004DBr 2  60           avr_x:  rts
0004DCr 2               
0004DCr 2               ; ----------------------------------------------------------------------------
0004DCr 2               ; MOUSE_ON - A = 1: mouse reports on, A = 0: off.  Clears the movement so far.
0004DCr 2               ; C=1 if there is no mouse interface.  Clobbers A, X, Y.
0004DCr 2               ; ----------------------------------------------------------------------------
0004DCr 2               MOUSE_ON:
0004DCr 2  2C rr rr             bit     avr_ok
0004DFr 2  10 1C                bpl     @none
0004E1r 2  48                   pha
0004E2r 2  A9 FF                lda     #AVR_ESC
0004E4r 2  20 rr rr             jsr     avr_send
0004E7r 2  68                   pla
0004E8r 2  29 01                and     #$01                    ; $FF $01 = on, $FF $00 = off
0004EAr 2  20 rr rr             jsr     avr_send
0004EDr 2  08                   php
0004EEr 2  78                   sei
0004EFr 2  A9 00                lda     #0
0004F1r 2  8D rr rr             sta     ms_dx
0004F4r 2  8D rr rr             sta     ms_dy
0004F7r 2  8D rr rr             sta     ms_new
0004FAr 2  28                   plp
0004FBr 2  18                   clc
0004FCr 2  60                   rts
0004FDr 2  38           @none:  sec
0004FEr 2  60                   rts
0004FFr 2               
0004FFr 2               ; ----------------------------------------------------------------------------
0004FFr 2               ; MOUSE_READ - A = buttons, X = x movement, Y = y movement (signed, since the
0004FFr 2               ; last MOUSE_READ; right/down positive).  C=1 if a report arrived since the
0004FFr 2               ; last call, C=0 if not (X = Y = 0 then).
0004FFr 2               ; ----------------------------------------------------------------------------
0004FFr 2               MOUSE_READ:
0004FFr 2  08                   php
000500r 2  78                   sei
000501r 2  AE rr rr             ldx     ms_dx
000504r 2  AC rr rr             ldy     ms_dy
000507r 2  A9 00                lda     #0
000509r 2  8D rr rr             sta     ms_dx
00050Cr 2  8D rr rr             sta     ms_dy
00050Fr 2  AD rr rr             lda     ms_new
000512r 2  0A                   asl     a                       ; bit 7 -> carry
000513r 2  A9 00                lda     #0
000515r 2  8D rr rr             sta     ms_new
000518r 2  AD rr rr             lda     ms_btn
00051Br 2  B0 03                bcs     @new
00051Dr 2  28                   plp
00051Er 2  18                   clc
00051Fr 2  60                   rts
000520r 2  28           @new:   plp
000521r 2  38                   sec
000522r 2  60                   rts
000523r 2               
000523r 1               .if CON_DISPLAY = DISP_TERM
000523r 1               .include "drv_kbterm.s"         ; KB_MONITOR_TERM display card
000523r 1               .elseif CON_DISPLAY = DISP_ESP32
000523r 1               .include "drv_esp32.s"          ; ESP32_VGA card (and esp32vga.inc)
000523r 1               .elseif CON_DISPLAY = DISP_PICO
000523r 1               .include "drv_pico.s"           ; PICO9918 card (and pico_font.inc)
000523r 2               ; ============================================================================
000523r 2               ; drv_pico.s - PICO9918 card as the console (VDP at $7F1C / $7F1D)
000523r 2               ;
000523r 2               ; Text console (CON_DISPLAY = DISP_PICO):
000523r 2               ;   * PICO9918 firmware 1.0+ (found at boot): 80 x 30 text (F18A T80 + 30 rows)
000523r 2               ;   * otherwise (or PICO_COLS = 40):         40 x 24 text (TMS9918A text mode)
000523r 2               ;   The cursor is the character under it shown inverse.  Characters $A0-$FF
000523r 2               ;   print as inverse copies of $20-$7F.  Control codes: CR, LF, BS, TAB and FF
000523r 2               ;   (clear screen); the others are ignored.
000523r 2               ;
000523r 2               ; Graphics (BASIC "CLS 1", or the gfx_ calls): Graphics II, 256 x 192, colours
000523r 2               ;   0-15 (2 colours in each 8 x 1 block), 32 sprites of 16 x 16, and the
000523r 2               ;   console carries on as 32 x 24 text drawn into the bitmap.  "CLS 0" goes
000523r 2               ;   back to the text mode.
000523r 2               ;
000523r 2               ; VRAM, text mode:     name table $0000 (up to 2400), patterns $1000
000523r 2               ; VRAM, Graphics II:   patterns $0000, colours $2000, sprite patterns $1800,
000523r 2               ;                      names $3800, sprite attributes $3B00
000523r 2               ;
000523r 2               ; Every routine here works with interrupts off while it talks to the VDP: a
000523r 2               ; status read in between the two writes of an address would spoil it.  Your
000523r 2               ; own programs that use the VDP directly must do the same (SEI ... CLI) if
000523r 2               ; PICO_IRQ is set.
000523r 2               ; ============================================================================
000523r 2               
000523r 2               .if PICO_IRQ
000523r 2               PICO_IE         = $20                   ; R1 interrupt enable
000523r 2               .else
000523r 2               PICO_IE         = $00
000523r 2               .endif
000523r 2               
000523r 2               ; VRAM layout
000523r 2               TXT_NAME        = $0000
000523r 2               TXT_PATT        = $1000
000523r 2               TXT_SATTR       = $1800                 ; (F18A only: sprites parked here)
000523r 2               G2_PATT         = $0000
000523r 2               G2_COLOR        = $2000
000523r 2               G2_SPAT         = $1800
000523r 2               G2_NAME         = $3800
000523r 2               G2_SATTR        = $3B00
000523r 2               
000523r 2               ; Wait between VDP accesses (PICO_SLOW nops; 0 for the PICO9918)
000523r 2               .macro VW
000523r 2                 .repeat PICO_SLOW
000523r 2                       nop
000523r 2                 .endrepeat
000523r 2               .endmacro
000523r 2               
000523r 2               .segment "DRVVARS"
000030r 2  xx           pico_ok:        .res 1                  ; $80 = the VDP answered
000031r 2  xx           pico_f18a:      .res 1                  ; $80 = PICO9918 1.0+: 80 columns, 30 rows
000032r 2  xx           pico_fw:        .res 1                  ; its firmware version ($12 = 1.2), 0 = unknown
000033r 2  xx           pico_mode:      .res 1                  ; 0 text, 1 Graphics II
000034r 2  xx           pico_cols:      .res 1
000035r 2  xx           pico_rows:      .res 1
000036r 2  xx           pico_col:       .res 1
000037r 2  xx           pico_row:       .res 1
000038r 2  xx           pico_cur:       .res 1                  ; $80 = cursor shown
000039r 2  xx           pico_st:        .res 1                  ; status bits gathered by pico_irq
00003Ar 2  xx           pico_ch:        .res 1
00003Br 2  xx           pico_t0:        .res 1
00003Cr 2  xx           pico_t1:        .res 1
00003Dr 2  xx           pico_t2:        .res 1
00003Er 2  xx           pico_n:         .res 1                  ; pv_copy byte count (0 = 256)
00003Fr 2  xx xx        pico_addr:      .res 2
000041r 2  xx xx        pico_src:       .res 2
000043r 2  xx xx        pico_dst:       .res 2
000045r 2  xx xx        pico_cnt:       .res 2
000047r 2  xx xx xx xx  pico_buf:       .res 256
00004Br 2  xx xx xx xx  
00004Fr 2  xx xx xx xx  
000147r 2               ; line / circle working values
000147r 2  xx xx        pl_dx:          .res 2
000149r 2  xx xx        pl_dy:          .res 2
00014Br 2  xx xx        pl_err:         .res 2
00014Dr 2  xx xx        pl_e2:          .res 2
00014Fr 2  xx           pl_sx:          .res 1
000150r 2  xx           pl_sy:          .res 1
000151r 2  xx           pc_x:           .res 1
000152r 2  xx           pc_y:           .res 1
000153r 2  xx xx        pc_d:           .res 2
000155r 2  xx xx        pc_t:           .res 2
000157r 2  xx           pc_a:           .res 1
000158r 2  xx           pc_b:           .res 1
000159r 2  xx xx        pc_cx:          .res 2
00015Br 2  xx xx        pc_cy:          .res 2
00015Dr 2  xx xx        pc_n:           .res 2
00015Fr 2  xx xx        pb_x0:          .res 2
000161r 2  xx xx        pb_y0:          .res 2
000163r 2  xx xx        pb_x1:          .res 2
000165r 2  xx xx        pb_y1:          .res 2
000167r 2               
000167r 2               .segment "BIOS"
000523r 2               
000523r 2               ; ============================================================================
000523r 2               ; Low level (interrupts must already be off)
000523r 2               ; ============================================================================
000523r 2               
000523r 2               ; pv_waddr - VRAM write address A (low) / X (high)
000523r 2               pv_waddr:
000523r 2  8D 1D 7F             sta     PICO_CTRL
000526r 2                       VW
000526r 2  8A                   txa
000527r 2  29 3F                and     #$3F
000529r 2  09 40                ora     #$40
00052Br 2  8D 1D 7F             sta     PICO_CTRL
00052Er 2                       VW
00052Er 2  60                   rts
00052Fr 2               
00052Fr 2               ; pv_raddr - VRAM read address A (low) / X (high), then about 2 us for the
00052Fr 2               ; VDP to fetch the first byte before it is read
00052Fr 2               PV_RDLY         = CPU_KHZ * 2 / 5000 + 1        ; 5-cycle loops
00052Fr 2               pv_raddr:
00052Fr 2  8D 1D 7F             sta     PICO_CTRL
000532r 2                       VW
000532r 2  8A                   txa
000533r 2  29 3F                and     #$3F
000535r 2  8D 1D 7F             sta     PICO_CTRL
000538r 2  A2 02                ldx     #PV_RDLY
00053Ar 2  CA           @w:     dex
00053Br 2  D0 FD                bne     @w
00053Dr 2  60                   rts
00053Er 2               
00053Er 2               ; pv_reg - VDP register X = A
00053Er 2               pv_reg:
00053Er 2  8D 1D 7F             sta     PICO_CTRL
000541r 2                       VW
000541r 2  8A                   txa
000542r 2  09 80                ora     #$80
000544r 2  8D 1D 7F             sta     PICO_CTRL
000547r 2                       VW
000547r 2  60                   rts
000548r 2               
000548r 2               ; pv_fill - write A pico_cnt times (16 bit, at the address already set).
000548r 2               ; Clobbers X, Y.
000548r 2               pv_fill:
000548r 2  AC rr rr             ldy     pico_cnt
00054Br 2  F0 06                beq     @pages
00054Dr 2  8D 1C 7F     @lo:    sta     PICO_DATA
000550r 2                       VW
000550r 2  88                   dey
000551r 2  D0 FA                bne     @lo
000553r 2  AE rr rr     @pages: ldx     pico_cnt+1
000556r 2  F0 09                beq     @x
000558r 2  8D 1C 7F     @pg:    sta     PICO_DATA
00055Br 2                       VW
00055Br 2  88                   dey
00055Cr 2  D0 FA                bne     @pg
00055Er 2  CA                   dex
00055Fr 2  D0 F7                bne     @pg
000561r 2  60           @x:     rts
000562r 2               
000562r 2               ; pv_copy - copy pico_n bytes (0 = 256) of VRAM from pico_src to pico_dst
000562r 2               ; through pico_buf.  Clobbers A, X, Y.
000562r 2               pv_copy:
000562r 2  AD rr rr             lda     pico_src
000565r 2  AE rr rr             ldx     pico_src+1
000568r 2  20 rr rr             jsr     pv_raddr
00056Br 2  A0 00                ldy     #0
00056Dr 2  AD 1C 7F     @r:     lda     PICO_DATA
000570r 2  99 rr rr             sta     pico_buf,y
000573r 2                       VW
000573r 2  C8                   iny
000574r 2  CC rr rr             cpy     pico_n
000577r 2  D0 F4                bne     @r
000579r 2  AD rr rr             lda     pico_dst
00057Cr 2  AE rr rr             ldx     pico_dst+1
00057Fr 2  20 rr rr             jsr     pv_waddr
000582r 2  A0 00                ldy     #0
000584r 2  B9 rr rr     @w:     lda     pico_buf,y
000587r 2  8D 1C 7F             sta     PICO_DATA
00058Ar 2                       VW
00058Ar 2  C8                   iny
00058Br 2  CC rr rr             cpy     pico_n
00058Er 2  D0 F4                bne     @w
000590r 2  60                   rts
000591r 2               
000591r 2               ; pv_unlock - the F18A unlock sequence (VR57 = $1C, twice)
000591r 2               pv_unlock:
000591r 2  A9 1C                lda     #$1C
000593r 2  A2 39                ldx     #57
000595r 2  20 rr rr             jsr     pv_reg
000598r 2  A9 1C                lda     #$1C
00059Ar 2  A2 39                ldx     #57
00059Cr 2  4C rr rr             jmp     pv_reg
00059Fr 2               
00059Fr 2               ; pv_color - A = the console colours as one byte: fg << 4 | bg
00059Fr 2               pv_color:
00059Fr 2  AD rr rr             lda     gfx_fg
0005A2r 2  0A                   asl     a
0005A3r 2  0A                   asl     a
0005A4r 2  0A                   asl     a
0005A5r 2  0A                   asl     a
0005A6r 2  0D rr rr             ora     gfx_bg
0005A9r 2  60                   rts
0005AAr 2               
0005AAr 2               ; ============================================================================
0005AAr 2               ; Start-up
0005AAr 2               ; ============================================================================
0005AAr 2               
0005AAr 2               ; ----------------------------------------------------------------------------
0005AAr 2               ; pico_init - C=0 if the VDP answered.  Text mode, cleared.  Clobbers A, X, Y.
0005AAr 2               ; ----------------------------------------------------------------------------
0005AAr 2               pico_init:
0005AAr 2  08                   php
0005ABr 2  78                   sei
0005ACr 2  A9 00                lda     #0
0005AEr 2  8D rr rr             sta     pico_ok
0005B1r 2  8D rr rr             sta     pico_f18a
0005B4r 2  8D rr rr             sta     pico_fw
0005B7r 2  8D rr rr             sta     pico_cur
0005BAr 2  8D rr rr             sta     pico_st
0005BDr 2  A9 0F                lda     #PICO_FG
0005BFr 2  8D rr rr             sta     gfx_fg
0005C2r 2  A9 04                lda     #PICO_BG
0005C4r 2  8D rr rr             sta     gfx_bg
0005C7r 2                       ; The PICO9918 takes a while to boot after power-up (it shows its
0005C7r 2                       ; logo meanwhile) and ignores the bus until then: keep trying for
0005C7r 2                       ; PICO_BOOT_MS, and once it answers give it PICO_SETTLE_MS more.
0005C7r 2  A9 2C                lda     #<(PICO_BOOT_MS / 10)
0005C9r 2  8D rr rr             sta     pico_cnt
0005CCr 2  A9 01                lda     #>(PICO_BOOT_MS / 10)
0005CEr 2  8D rr rr             sta     pico_cnt+1
0005D1r 2  20 rr rr     @try:   jsr     pv_present
0005D4r 2  90 1B                bcc     @found
0005D6r 2  A9 0A                lda     #10
0005D8r 2  20 rr rr             jsr     DELAY_MS
0005DBr 2  AD rr rr             lda     pico_cnt
0005DEr 2  D0 03                bne     :+
0005E0r 2  CE rr rr             dec     pico_cnt+1
0005E3r 2  CE rr rr     :       dec     pico_cnt
0005E6r 2  AD rr rr             lda     pico_cnt
0005E9r 2  0D rr rr             ora     pico_cnt+1
0005ECr 2  D0 E3                bne     @try
0005EEr 2  4C rr rr             jmp     @absent
0005F1r 2  A9 64        @found: lda     #PICO_SETTLE_MS
0005F3r 2  20 rr rr             jsr     DELAY_MS
0005F6r 2  20 rr rr             jsr     pv_present              ; still there after settling?
0005F9r 2  B0 19                bcs     @absent
0005FBr 2  20 rr rr             jsr     pv_detect
0005FEr 2  20 rr rr             jsr     pv_text
000601r 2  A9 80                lda     #$80
000603r 2  8D rr rr             sta     pico_ok
000606r 2  A9 04                lda     #4
000608r 2  0D rr rr             ora     DEVSTAT
00060Br 2  8D rr rr             sta     DEVSTAT                 ; device status bit 2
00060Er 2  20 rr rr             jsr     pv_curon
000611r 2  28                   plp
000612r 2  18                   clc
000613r 2  60                   rts
000614r 2               @absent:
000614r 2  28                   plp
000615r 2  38                   sec
000616r 2  60                   rts
000617r 2               
000617r 2               ; pv_present - C=0 if the VDP answers: R1 = display off, then $A5 $5A written
000617r 2               ; at VRAM $3FFE and read back (an empty bus reads $7F).  Clobbers A, X.
000617r 2               pv_present:
000617r 2  A9 80                lda     #$80                    ; R1: 16K, display off
000619r 2  A2 01                ldx     #1
00061Br 2  20 rr rr             jsr     pv_reg
00061Er 2  A9 FE                lda     #$FE
000620r 2  A2 3F                ldx     #$3F
000622r 2  20 rr rr             jsr     pv_waddr
000625r 2  A9 A5                lda     #$A5
000627r 2  8D 1C 7F             sta     PICO_DATA
00062Ar 2                       VW
00062Ar 2  A9 5A                lda     #$5A
00062Cr 2  8D 1C 7F             sta     PICO_DATA
00062Fr 2                       VW
00062Fr 2  A9 FE                lda     #$FE
000631r 2  A2 3F                ldx     #$3F
000633r 2  20 rr rr             jsr     pv_raddr
000636r 2  AD 1C 7F             lda     PICO_DATA
000639r 2  C9 A5                cmp     #$A5
00063Br 2  D0 09                bne     @no
00063Dr 2                       VW
00063Dr 2  AD 1C 7F             lda     PICO_DATA
000640r 2  C9 5A                cmp     #$5A
000642r 2  D0 02                bne     @no
000644r 2  18                   clc
000645r 2  60                   rts
000646r 2  38           @no:    sec
000647r 2  60                   rts
000648r 2               
000648r 2               ; pv_detect - a PICO9918 with firmware 1.0+?  (F18A unlock, then its
000648r 2               ; configuration registers: option 0 = Pico model 1/2, option 2 = firmware.)
000648r 2               ; On a TMS9918A the writes land in R0-R7 (set again by pv_text) and the
000648r 2               ; status reads don't match.
000648r 2               pv_detect:
000648r 2               .if PICO_COLS <> 40
000648r 2  20 rr rr             jsr     pv_unlock
00064Br 2  A9 80                lda     #$80                    ; VR50: registers to power-up values
00064Dr 2  A2 32                ldx     #50                     ; (keeps the palette)
00064Fr 2  20 rr rr             jsr     pv_reg
000652r 2  20 rr rr             jsr     pv_unlock
000655r 2  A9 00                lda     #0                      ; option 0: Pico model
000657r 2  A2 3A                ldx     #58
000659r 2  20 rr rr             jsr     pv_reg
00065Cr 2  A9 0C                lda     #$0C                    ; status register 12 = the option
00065Er 2  A2 0F                ldx     #15
000660r 2  20 rr rr             jsr     pv_reg
000663r 2  AD 1D 7F             lda     PICO_CTRL
000666r 2  8D rr rr             sta     pico_t0
000669r 2                       VW
000669r 2  A9 02                lda     #2                      ; option 2: firmware version
00066Br 2  A2 3A                ldx     #58
00066Dr 2  20 rr rr             jsr     pv_reg
000670r 2  AD 1D 7F             lda     PICO_CTRL
000673r 2  8D rr rr             sta     pico_t1
000676r 2                       VW
000676r 2  A9 00                lda     #0                      ; status register 0 again
000678r 2  A2 0F                ldx     #15
00067Ar 2  20 rr rr             jsr     pv_reg
00067Dr 2  AD rr rr             lda     pico_t0
000680r 2  C9 01                cmp     #1
000682r 2  F0 04                beq     @model
000684r 2  C9 02                cmp     #2
000686r 2  D0 13                bne     @no
000688r 2  AD rr rr     @model: lda     pico_t1
00068Br 2  C9 10                cmp     #$10                    ; 1.0 or later
00068Dr 2  90 0C                bcc     @no
00068Fr 2  C9 A0                cmp     #$A0
000691r 2  B0 08                bcs     @no
000693r 2  8D rr rr             sta     pico_fw
000696r 2  A9 80                lda     #$80
000698r 2  8D rr rr             sta     pico_f18a
00069Br 2               @no:
00069Br 2               .endif
00069Br 2  60                   rts
00069Cr 2               
00069Cr 2               ; ----------------------------------------------------------------------------
00069Cr 2               ; pv_text - text mode: registers, font (normal at $20, inverse at $A0),
00069Cr 2               ; cleared screen, cursor home.  Clobbers A, X, Y.
00069Cr 2               ; ----------------------------------------------------------------------------
00069Cr 2               pv_text:
00069Cr 2  A9 00                lda     #0
00069Er 2  8D rr rr             sta     pico_mode
0006A1r 2  8D rr rr             sta     pico_cur
0006A4r 2  A9 80                lda     #$80                    ; R1: display off while loading
0006A6r 2  A2 01                ldx     #1
0006A8r 2  20 rr rr             jsr     pv_reg
0006ABr 2  2C rr rr             bit     pico_f18a
0006AEr 2  10 22                bpl     @t40
0006B0r 2  A9 50                lda     #80
0006B2r 2  8D rr rr             sta     pico_cols
0006B5r 2  A9 1E                lda     #30
0006B7r 2  8D rr rr             sta     pico_rows
0006BAr 2  A9 04                lda     #$04                    ; R0: T80 (with M1 in R1)
0006BCr 2  A2 00                ldx     #0
0006BEr 2  20 rr rr             jsr     pv_reg
0006C1r 2  A9 00                lda     #$00                    ; R2: names at $0000.  Unlocked, the
0006C3r 2  A2 02                ldx     #2                      ; F18A uses all 4 bits: (R2 & $0F) << 10
0006C5r 2  20 rr rr             jsr     pv_reg                  ; ($03 would put them at $0C00)
0006C8r 2  A9 40                lda     #$40                    ; VR49: 30 rows
0006CAr 2  A2 31                ldx     #49
0006CCr 2  20 rr rr             jsr     pv_reg
0006CFr 2  4C rr rr             jmp     @common
0006D2r 2  A9 28        @t40:   lda     #40
0006D4r 2  8D rr rr             sta     pico_cols
0006D7r 2  A9 18                lda     #24
0006D9r 2  8D rr rr             sta     pico_rows
0006DCr 2  A9 00                lda     #$00                    ; R0: text
0006DEr 2  A2 00                ldx     #0
0006E0r 2  20 rr rr             jsr     pv_reg
0006E3r 2  A9 00                lda     #$00                    ; R2: names at $0000
0006E5r 2  A2 02                ldx     #2
0006E7r 2  20 rr rr             jsr     pv_reg
0006EAr 2               @common:
0006EAr 2  A9 02                lda     #$02                    ; R4: patterns at $1000
0006ECr 2  A2 04                ldx     #4
0006EEr 2  20 rr rr             jsr     pv_reg
0006F1r 2  2C rr rr             bit     pico_f18a               ; unlocked, the F18A shows sprites in
0006F4r 2  10 2A                bpl     @nospr                  ; text mode too, and with 30 rows the
0006F6r 2  A9 00                lda     #0                      ; $D0 end marker doesn't work: process
0006F8r 2  A2 33                ldx     #51                     ; no sprites (VR51 = 0) ...
0006FAr 2  20 rr rr             jsr     pv_reg
0006FDr 2  A9 30                lda     #(TXT_SATTR / $80)      ; ... and keep all 32 below the screen
0006FFr 2  A2 05                ldx     #5
000701r 2  20 rr rr             jsr     pv_reg
000704r 2  A9 00                lda     #<TXT_SATTR
000706r 2  A2 18                ldx     #>TXT_SATTR
000708r 2  20 rr rr             jsr     pv_waddr
00070Br 2  A0 20                ldy     #32
00070Dr 2  A9 F0        @spr:   lda     #$F0                    ; y = 240: off the bottom
00070Fr 2  8D 1C 7F             sta     PICO_DATA
000712r 2                       VW
000712r 2  A9 00                lda     #0
000714r 2  8D 1C 7F             sta     PICO_DATA
000717r 2                       VW
000717r 2  8D 1C 7F             sta     PICO_DATA
00071Ar 2                       VW
00071Ar 2  8D 1C 7F             sta     PICO_DATA
00071Dr 2                       VW
00071Dr 2  88                   dey
00071Er 2  D0 ED                bne     @spr
000720r 2               @nospr:
000720r 2  20 rr rr             jsr     pv_color                ; R7: text colours
000723r 2  A2 07                ldx     #7
000725r 2  20 rr rr             jsr     pv_reg
000728r 2  A9 00                lda     #<(TXT_PATT + $20 * 8)  ; the font
00072Ar 2  A2 11                ldx     #>(TXT_PATT + $20 * 8)
00072Cr 2  20 rr rr             jsr     pv_waddr
00072Fr 2  A9 00                lda     #$00
000731r 2  20 rr rr             jsr     pv_font
000734r 2  A9 00                lda     #<(TXT_PATT + $A0 * 8)  ; and inverse
000736r 2  A2 15                ldx     #>(TXT_PATT + $A0 * 8)
000738r 2  20 rr rr             jsr     pv_waddr
00073Br 2  A9 FF                lda     #$FF
00073Dr 2  20 rr rr             jsr     pv_font
000740r 2  20 rr rr             jsr     pv_clear
000743r 2  A9 D0                lda     #($D0 | PICO_IE)        ; R1: 16K, display on, text
000745r 2  A2 01                ldx     #1
000747r 2  4C rr rr             jmp     pv_reg
00074Ar 2               
00074Ar 2               ; pv_font - send the 768 byte font, each byte EOR A
00074Ar 2               pv_font:
00074Ar 2  8D rr rr             sta     pico_t0
00074Dr 2  A9 rr                lda     #<pico_font
00074Fr 2  85 rr                sta     con_ptr
000751r 2  A9 rr                lda     #>pico_font
000753r 2  85 rr                sta     con_ptr+1
000755r 2  A2 03                ldx     #3
000757r 2  A0 00                ldy     #0
000759r 2  B1 rr        @l:     lda     (con_ptr),y
00075Br 2  4D rr rr             eor     pico_t0
00075Er 2  8D 1C 7F             sta     PICO_DATA
000761r 2                       VW
000761r 2  C8                   iny
000762r 2  D0 F5                bne     @l
000764r 2  E6 rr                inc     con_ptr+1
000766r 2  CA                   dex
000767r 2  D0 F0                bne     @l
000769r 2  60                   rts
00076Ar 2               
00076Ar 2               ; pv_clear - clear the screen (and the bitmap, in Graphics II), cursor home.
00076Ar 2               ; The cursor must be off.  Clobbers A, X, Y.
00076Ar 2               pv_clear:
00076Ar 2  A9 00                lda     #0
00076Cr 2  8D rr rr             sta     pico_col
00076Fr 2  8D rr rr             sta     pico_row
000772r 2  AD rr rr             lda     pico_mode
000775r 2  D0 16                bne     @g2
000777r 2  A9 00                lda     #<TXT_NAME
000779r 2  A2 00                ldx     #>TXT_NAME
00077Br 2  20 rr rr             jsr     pv_waddr
00077Er 2  A9 60                lda     #<2400
000780r 2  8D rr rr             sta     pico_cnt
000783r 2  A9 09                lda     #>2400
000785r 2  8D rr rr             sta     pico_cnt+1
000788r 2  A9 20                lda     #' '
00078Ar 2  4C rr rr             jmp     pv_fill
00078Dr 2  A9 00        @g2:    lda     #<G2_PATT
00078Fr 2  A2 00                ldx     #>G2_PATT
000791r 2  20 rr rr             jsr     pv_waddr
000794r 2  A9 00                lda     #<6144
000796r 2  8D rr rr             sta     pico_cnt
000799r 2  A9 18                lda     #>6144
00079Br 2  8D rr rr             sta     pico_cnt+1
00079Er 2  A9 00                lda     #0
0007A0r 2  20 rr rr             jsr     pv_fill
0007A3r 2  A9 00                lda     #<G2_COLOR
0007A5r 2  A2 20                ldx     #>G2_COLOR
0007A7r 2  20 rr rr             jsr     pv_waddr
0007AAr 2  20 rr rr             jsr     pv_color
0007ADr 2  4C rr rr             jmp     pv_fill                 ; (pico_cnt is still 6144)
0007B0r 2               
0007B0r 2               ; ----------------------------------------------------------------------------
0007B0r 2               ; pv_g2 - Graphics II: registers, names 0-255 x 3, everything cleared, all
0007B0r 2               ; sprites below the screen.  Clobbers A, X, Y.
0007B0r 2               ; ----------------------------------------------------------------------------
0007B0r 2               pv_g2:
0007B0r 2  A9 01                lda     #1
0007B2r 2  8D rr rr             sta     pico_mode
0007B5r 2  A9 00                lda     #0
0007B7r 2  8D rr rr             sta     pico_cur
0007BAr 2  A9 20                lda     #32
0007BCr 2  8D rr rr             sta     pico_cols
0007BFr 2  A9 18                lda     #24
0007C1r 2  8D rr rr             sta     pico_rows
0007C4r 2  A9 82                lda     #$82                    ; R1: display off, 16x16 sprites
0007C6r 2  A2 01                ldx     #1
0007C8r 2  20 rr rr             jsr     pv_reg
0007CBr 2  2C rr rr             bit     pico_f18a
0007CEr 2  10 0E                bpl     :+
0007D0r 2  A9 00                lda     #$00                    ; VR49: 24 rows (and the $D0 sprite end)
0007D2r 2  A2 31                ldx     #49
0007D4r 2  20 rr rr             jsr     pv_reg
0007D7r 2  A9 20                lda     #32                     ; VR51: all 32 sprites again
0007D9r 2  A2 33                ldx     #51
0007DBr 2  20 rr rr             jsr     pv_reg
0007DEr 2  A9 02        :       lda     #$02                    ; R0: Graphics II
0007E0r 2  A2 00                ldx     #0
0007E2r 2  20 rr rr             jsr     pv_reg
0007E5r 2  A9 0E                lda     #$0E                    ; R2: names at $3800
0007E7r 2  A2 02                ldx     #2
0007E9r 2  20 rr rr             jsr     pv_reg
0007ECr 2  A9 FF                lda     #$FF                    ; R3: colours at $2000
0007EEr 2  A2 03                ldx     #3
0007F0r 2  20 rr rr             jsr     pv_reg
0007F3r 2  A9 03                lda     #$03                    ; R4: patterns at $0000
0007F5r 2  A2 04                ldx     #4
0007F7r 2  20 rr rr             jsr     pv_reg
0007FAr 2  A9 76                lda     #$76                    ; R5: sprite attributes at $3B00
0007FCr 2  A2 05                ldx     #5
0007FEr 2  20 rr rr             jsr     pv_reg
000801r 2  A9 03                lda     #$03                    ; R6: sprite patterns at $1800
000803r 2  A2 06                ldx     #6
000805r 2  20 rr rr             jsr     pv_reg
000808r 2  AD rr rr             lda     gfx_bg                  ; R7: border = the background
00080Br 2  A2 07                ldx     #7
00080Dr 2  20 rr rr             jsr     pv_reg
000810r 2  A9 00                lda     #<G2_NAME               ; names 0-255, three times
000812r 2  A2 38                ldx     #>G2_NAME
000814r 2  20 rr rr             jsr     pv_waddr
000817r 2  A2 03                ldx     #3
000819r 2  A0 00                ldy     #0
00081Br 2  98           @n:     tya
00081Cr 2  8D 1C 7F             sta     PICO_DATA
00081Fr 2                       VW
00081Fr 2  C8                   iny
000820r 2  D0 F9                bne     @n
000822r 2  CA                   dex
000823r 2  D0 F6                bne     @n
000825r 2  A9 00                lda     #<G2_SATTR              ; 32 sprites: y = 192 (below the screen)
000827r 2  A2 3B                ldx     #>G2_SATTR
000829r 2  20 rr rr             jsr     pv_waddr
00082Cr 2  A2 20                ldx     #32
00082Er 2  A9 C0        @s:     lda     #192
000830r 2  8D 1C 7F             sta     PICO_DATA
000833r 2                       VW
000833r 2  A9 00                lda     #0
000835r 2  8D 1C 7F             sta     PICO_DATA
000838r 2                       VW
000838r 2  8D 1C 7F             sta     PICO_DATA
00083Br 2                       VW
00083Br 2  8D 1C 7F             sta     PICO_DATA
00083Er 2                       VW
00083Er 2  CA                   dex
00083Fr 2  D0 ED                bne     @s
000841r 2  20 rr rr             jsr     pv_clear
000844r 2  A9 C2                lda     #($C2 | PICO_IE)        ; R1: 16K, display on, 16x16 sprites
000846r 2  A2 01                ldx     #1
000848r 2  4C rr rr             jmp     pv_reg
00084Br 2               
00084Br 2               ; ============================================================================
00084Br 2               ; Console output
00084Br 2               ; ============================================================================
00084Br 2               
00084Br 2               ; ----------------------------------------------------------------------------
00084Br 2               ; pico_putc - print A.  Clobbers A, X, Y.
00084Br 2               ; ----------------------------------------------------------------------------
00084Br 2               pico_putc:
00084Br 2  2C rr rr             bit     pico_ok
00084Er 2  30 01                bmi     :+
000850r 2  60                   rts
000851r 2  08           :       php
000852r 2  78                   sei
000853r 2  8D rr rr             sta     pico_ch
000856r 2  20 rr rr             jsr     pv_curoff
000859r 2  AD rr rr             lda     pico_ch
00085Cr 2  C9 20                cmp     #$20
00085Er 2  90 26                bcc     @ctl
000860r 2  C9 80                cmp     #$80                    ; $80-$9F have no glyph: a space
000862r 2  90 09                bcc     @draw
000864r 2  C9 A0                cmp     #$A0
000866r 2  B0 05                bcs     @draw
000868r 2  A9 20                lda     #' '
00086Ar 2  8D rr rr             sta     pico_ch
00086Dr 2  20 rr rr     @draw:  jsr     pv_glyph                ; draw it at the cursor
000870r 2  EE rr rr             inc     pico_col
000873r 2  AD rr rr             lda     pico_col
000876r 2  CD rr rr             cmp     pico_cols
000879r 2  90 52                bcc     @done
00087Br 2  A9 00                lda     #0                      ; end of the line: wrap
00087Dr 2  8D rr rr             sta     pico_col
000880r 2  20 rr rr             jsr     pv_lf
000883r 2  4C rr rr             jmp     @done
000886r 2  C9 0D        @ctl:   cmp     #$0D
000888r 2  D0 07                bne     @c1
00088Ar 2  A9 00                lda     #0
00088Cr 2  8D rr rr             sta     pico_col
00088Fr 2  F0 3C                beq     @done
000891r 2  C9 0A        @c1:    cmp     #$0A
000893r 2  D0 06                bne     @c2
000895r 2  20 rr rr             jsr     pv_lf
000898r 2  4C rr rr             jmp     @done
00089Br 2  C9 08        @c2:    cmp     #$08
00089Dr 2  D0 0B                bne     @c3
00089Fr 2  AD rr rr             lda     pico_col
0008A2r 2  F0 29                beq     @done
0008A4r 2  CE rr rr             dec     pico_col
0008A7r 2  4C rr rr             jmp     @done
0008AAr 2  C9 09        @c3:    cmp     #$09
0008ACr 2  D0 18                bne     @c4
0008AEr 2  AD rr rr             lda     pico_col                ; next multiple of 8
0008B1r 2  18                   clc
0008B2r 2  69 08                adc     #8
0008B4r 2  29 F8                and     #$F8
0008B6r 2  CD rr rr             cmp     pico_cols
0008B9r 2  90 05                bcc     :+
0008BBr 2  AE rr rr             ldx     pico_cols
0008BEr 2  CA                   dex
0008BFr 2  8A                   txa
0008C0r 2  8D rr rr     :       sta     pico_col
0008C3r 2  4C rr rr             jmp     @done
0008C6r 2  C9 0C        @c4:    cmp     #$0C
0008C8r 2  D0 03                bne     @done
0008CAr 2  20 rr rr             jsr     pv_clear
0008CDr 2  20 rr rr     @done:  jsr     pv_curon
0008D0r 2  28                   plp
0008D1r 2  60                   rts
0008D2r 2               
0008D2r 2               ; pv_lf - down a line, scrolling at the bottom
0008D2r 2               pv_lf:
0008D2r 2  EE rr rr             inc     pico_row
0008D5r 2  AD rr rr             lda     pico_row
0008D8r 2  CD rr rr             cmp     pico_rows
0008DBr 2  90 06                bcc     @x
0008DDr 2  CE rr rr             dec     pico_row
0008E0r 2  4C rr rr             jmp     pv_scroll
0008E3r 2  60           @x:     rts
0008E4r 2               
0008E4r 2               ; pv_scroll - everything up a line, bottom line cleared.  Clobbers A, X, Y.
0008E4r 2               pv_scroll:
0008E4r 2  AD rr rr             lda     pico_mode
0008E7r 2  D0 5F                bne     @g2
0008E9r 2  AD rr rr             lda     pico_cols               ; text: row by row through pico_buf
0008ECr 2  8D rr rr             sta     pico_n
0008EFr 2  A9 00                lda     #<TXT_NAME
0008F1r 2  8D rr rr             sta     pico_dst
0008F4r 2  A9 00                lda     #>TXT_NAME
0008F6r 2  8D rr rr             sta     pico_dst+1
0008F9r 2  AD rr rr             lda     pico_cols
0008FCr 2  8D rr rr             sta     pico_src
0008FFr 2  A9 00                lda     #0
000901r 2  8D rr rr             sta     pico_src+1
000904r 2  AE rr rr             ldx     pico_rows
000907r 2  CA                   dex
000908r 2  8E rr rr     @tl:    stx     pico_t2
00090Br 2  20 rr rr             jsr     pv_copy
00090Er 2  AD rr rr             lda     pico_src                ; dst = src, src += cols
000911r 2  8D rr rr             sta     pico_dst
000914r 2  AD rr rr             lda     pico_src+1
000917r 2  8D rr rr             sta     pico_dst+1
00091Ar 2  18                   clc
00091Br 2  AD rr rr             lda     pico_src
00091Er 2  6D rr rr             adc     pico_cols
000921r 2  8D rr rr             sta     pico_src
000924r 2  90 03                bcc     :+
000926r 2  EE rr rr             inc     pico_src+1
000929r 2  AE rr rr     :       ldx     pico_t2
00092Cr 2  CA                   dex
00092Dr 2  D0 D9                bne     @tl
00092Fr 2  AD rr rr             lda     pico_dst                ; the last row: spaces
000932r 2  AE rr rr             ldx     pico_dst+1
000935r 2  20 rr rr             jsr     pv_waddr
000938r 2  AD rr rr             lda     pico_cols
00093Br 2  8D rr rr             sta     pico_cnt
00093Er 2  A9 00                lda     #0
000940r 2  8D rr rr             sta     pico_cnt+1
000943r 2  A9 20                lda     #' '
000945r 2  4C rr rr             jmp     pv_fill
000948r 2               
000948r 2  A9 00        @g2:    lda     #>G2_PATT               ; Graphics II: patterns, then colours
00094Ar 2  20 rr rr             jsr     pv_g2up
00094Dr 2  A9 00                lda     #0
00094Fr 2  20 rr rr             jsr     pv_fill
000952r 2  A9 20                lda     #>G2_COLOR
000954r 2  20 rr rr             jsr     pv_g2up
000957r 2  20 rr rr             jsr     pv_color
00095Ar 2  4C rr rr             jmp     pv_fill
00095Dr 2               
00095Dr 2               ; pv_g2up - A = table page: 23 character rows (256 bytes each) up one, then
00095Dr 2               ; the address set to the last row and pico_cnt = 256, ready for pv_fill
00095Dr 2               pv_g2up:
00095Dr 2  8D rr rr             sta     pico_dst+1
000960r 2  8D rr rr             sta     pico_t1
000963r 2  18                   clc
000964r 2  69 01                adc     #1
000966r 2  8D rr rr             sta     pico_src+1
000969r 2  A9 00                lda     #0
00096Br 2  8D rr rr             sta     pico_src
00096Er 2  8D rr rr             sta     pico_dst
000971r 2  8D rr rr             sta     pico_n                  ; 256 bytes a row
000974r 2  A2 17                ldx     #23
000976r 2  8E rr rr     @l:     stx     pico_t2
000979r 2  20 rr rr             jsr     pv_copy
00097Cr 2  EE rr rr             inc     pico_src+1
00097Fr 2  EE rr rr             inc     pico_dst+1
000982r 2  AE rr rr             ldx     pico_t2
000985r 2  CA                   dex
000986r 2  D0 EE                bne     @l
000988r 2  A9 00                lda     #0
00098Ar 2  AE rr rr             ldx     pico_dst+1
00098Dr 2  20 rr rr             jsr     pv_waddr
000990r 2  A9 00                lda     #0
000992r 2  8D rr rr             sta     pico_cnt
000995r 2  A9 01                lda     #1
000997r 2  8D rr rr             sta     pico_cnt+1
00099Ar 2  60                   rts
00099Br 2               
00099Br 2               ; pv_txtaddr - pico_addr = text name table address of the cursor
00099Br 2               pv_txtaddr:
00099Br 2  AD rr rr             lda     pico_row
00099Er 2  8D rr rr             sta     pico_t0
0009A1r 2  A9 00                lda     #0
0009A3r 2  8D rr rr             sta     pico_addr
0009A6r 2  8D rr rr             sta     pico_addr+1
0009A9r 2  A2 08                ldx     #8                      ; pico_addr = row * cols
0009ABr 2  0E rr rr     @m:     asl     pico_addr
0009AEr 2  2E rr rr             rol     pico_addr+1
0009B1r 2  0E rr rr             asl     pico_t0
0009B4r 2  90 0F                bcc     @n
0009B6r 2  18                   clc
0009B7r 2  AD rr rr             lda     pico_addr
0009BAr 2  6D rr rr             adc     pico_cols
0009BDr 2  8D rr rr             sta     pico_addr
0009C0r 2  90 03                bcc     @n
0009C2r 2  EE rr rr             inc     pico_addr+1
0009C5r 2  CA           @n:     dex
0009C6r 2  D0 E3                bne     @m
0009C8r 2  18                   clc                             ; + col
0009C9r 2  AD rr rr             lda     pico_addr
0009CCr 2  6D rr rr             adc     pico_col
0009CFr 2  8D rr rr             sta     pico_addr
0009D2r 2  90 03                bcc     :+
0009D4r 2  EE rr rr             inc     pico_addr+1
0009D7r 2  60           :       rts
0009D8r 2               
0009D8r 2               ; pv_g2addr - pico_addr = Graphics II pattern address of the cursor cell
0009D8r 2               pv_g2addr:
0009D8r 2  AD rr rr             lda     pico_col
0009DBr 2  0A                   asl     a
0009DCr 2  0A                   asl     a
0009DDr 2  0A                   asl     a
0009DEr 2  8D rr rr             sta     pico_addr
0009E1r 2  AD rr rr             lda     pico_row
0009E4r 2  8D rr rr             sta     pico_addr+1
0009E7r 2  60                   rts
0009E8r 2               
0009E8r 2               ; pv_glyph - draw pico_ch at the cursor
0009E8r 2               pv_glyph:
0009E8r 2  AD rr rr             lda     pico_mode
0009EBr 2  D0 13                bne     @g2
0009EDr 2  20 rr rr             jsr     pv_txtaddr
0009F0r 2  AD rr rr             lda     pico_addr
0009F3r 2  AE rr rr             ldx     pico_addr+1
0009F6r 2  20 rr rr             jsr     pv_waddr
0009F9r 2  AD rr rr             lda     pico_ch
0009FCr 2  8D 1C 7F             sta     PICO_DATA
0009FFr 2                       VW
0009FFr 2  60                   rts
000A00r 2  AD rr rr     @g2:    lda     pico_ch                 ; $A0-$FF: inverse
000A03r 2  A2 00                ldx     #0
000A05r 2  C9 A0                cmp     #$A0
000A07r 2  90 05                bcc     :+
000A09r 2  A2 FF                ldx     #$FF
000A0Br 2  38                   sec
000A0Cr 2  E9 80                sbc     #$80
