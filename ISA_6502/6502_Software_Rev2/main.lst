003735r 2               
003735r 2               ; dir_char - a character of the listing: collect a line; at its end, make
003735r 2               ; an entry of it if it is "NAME.EXT  <DIR>" or "NAME.EXT  12345"
003735r 2               dir_char:
003735r 2  8E rr rr             stx     dir_sx
003738r 2  8C rr rr             sty     dir_sy
00373Br 2  C9 0D                cmp     #13
00373Dr 2  F0 18                beq     @eol
00373Fr 2  C9 0A                cmp     #10
003741r 2  F0 14                beq     @eol
003743r 2  AE rr rr             ldx     dir_len
003746r 2  E0 28                cpx     #DIRLINE
003748r 2  B0 06                bcs     @r
