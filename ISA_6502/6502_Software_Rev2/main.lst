003306r 2               ; ---------------------------------------------------------------------------
003306r 2               ; Current directory and path helpers
003306r 2               ; ---------------------------------------------------------------------------
003306r 2               .segment "BIOSVARS"
000055r 2  xx xx xx xx  mon_cwd:    .res 32                 ; current directory: "" (root) or "/A/B" (max 31)
000059r 2  xx xx xx xx  
00005Dr 2  xx xx xx xx  
000075r 2               .segment "CHVARS"
000071r 2  xx           mon_x:      .res 1                  ; length of the path in ch_name
000072r 2  xx           mon_y:      .res 1                  ; read position in the input line
000073r 2  xx           mon_cl:     .res 1                  ; length of the path part being read
000074r 2  xx           mon_kind:   .res 1                  ; 1 = path ends in a directory ("..", ".", "/")
000075r 2  xx           mon_end:    .res 1                  ; end of the directory part of ch_name
000076r 2  xx           mon_t:      .res 1
000077r 2  xx           mon_flag:   .res 1                  ; 1 = last part contains a "."
000078r 2               mon_comp    = ch_ent                ; scratch: the path part being read (ch_ent is free here)
000078r 2               .segment "BIOS"
003306r 2               
003306r 2               ERR_OPEN_DIR     = $41              ; CH376: FILE_OPEN found a directory
003306r 2               
003306r 2               ; mon_enter - open the directories of the path in ch_name[0..mon_end) one level
003306r 2               ; at a time ("/A" first, then "B" relative to it).  The CH376 keeps the last
003306r 2               ; directory it opened as the current one.
003306r 2               ;   out: A = status of the last open (ERR_OPEN_DIR = all went well)
003306r 2               mon_enter:
003306r 2  A0 00                ldy     #0
003308r 2  CC rr rr     @next:  cpy     mon_end
00330Br 2  B0 38                bcs     @done
00330Dr 2  A2 00                ldx     #0
00330Fr 2  B9 rr rr             lda     ch_name,y           ; the '/'
003312r 2  C0 00                cpy     #0
003314r 2  D0 04                bne     @skip               ; only the first name starts with '/'
003316r 2  9D rr rr             sta     mon_comp,x
003319r 2  E8                   inx
00331Ar 2  C8           @skip:  iny
00331Br 2  CC rr rr     @cp:    cpy     mon_end
00331Er 2  B0 0E                bcs     @end
003320r 2  B9 rr rr             lda     ch_name,y
003323r 2  C9 2F                cmp     #'/'
003325r 2  F0 07                beq     @end
003327r 2  9D rr rr             sta     mon_comp,x
00332Ar 2  E8                   inx
00332Br 2  C8                   iny
00332Cr 2  D0 ED                bne     @cp
00332Er 2  A9 00        @end:   lda     #0
003330r 2  9D rr rr             sta     mon_comp,x
003333r 2  8C rr rr             sty     mon_t
003336r 2  A9 rr                lda     #<mon_comp
003338r 2  A2 rr                ldx     #>mon_comp
00333Ar 2  20 rr rr             jsr     fs_open
00333Dr 2  AC rr rr             ldy     mon_t
003340r 2  C9 41                cmp     #ERR_OPEN_DIR
003342r 2  F0 C4                beq     @next
003344r 2  60                   rts
003345r 2  A9 41        @done:  lda     #ERR_OPEN_DIR
003347r 2  60                   rts
003348r 2               
003348r 2               ; mon_open - FILE_OPEN the full path in ch_name ("/NAME.EXT" or "/A/B/NAME.EXT")
003348r 2               ;   out: A = status.  Directories are entered one level at a time first.
003348r 2               mon_open:
003348r 2  A2 00                ldx     #0
00334Ar 2  8E rr rr             stx     mon_end             ; position of the last '/'
00334Dr 2  BD rr rr     @f:     lda     ch_name,x
003350r 2  F0 0A                beq     @e
003352r 2  C9 2F                cmp     #'/'
003354r 2  D0 03                bne     @n
003356r 2  8E rr rr             stx     mon_end
003359r 2  E8           @n:     inx
00335Ar 2  D0 F1                bne     @f
00335Cr 2  AD rr rr     @e:     lda     mon_end
00335Fr 2  F0 20                beq     @root               ; file in the root directory
003361r 2  20 rr rr             jsr     mon_enter
003364r 2  C9 41                cmp     #ERR_OPEN_DIR
003366r 2  D0 20                bne     @r
003368r 2  AE rr rr             ldx     mon_end             ; the last part, now relative
00336Br 2  E8                   inx
00336Cr 2  A0 00                ldy     #0
00336Er 2  BD rr rr     @m:     lda     ch_name,x
003371r 2  99 rr rr             sta     mon_comp,y
003374r 2  F0 04                beq     @go
003376r 2  E8                   inx
003377r 2  C8                   iny
003378r 2  D0 F4                bne     @m
00337Ar 2  A9 rr        @go:    lda     #<mon_comp
00337Cr 2  A2 rr                ldx     #>mon_comp
00337Er 2  4C rr rr             jmp     fs_open
003381r 2  A9 rr        @root:  lda     #<ch_name
003383r 2  A2 rr                ldx     #>ch_name
003385r 2  4C rr rr             jmp     fs_open
003388r 2  60           @r:     rts
003389r 2               
003389r 2               ; mon_time - "T": show the date and time; "T dwyymmddHHMMSS": set it first
003389r 2               ; (the DS1302 on the SPI-IDE card)
003389r 2               mon_time:
003389r 2  AD 01 02             lda     IN+1
00338Cr 2  C9 0D                cmp     #$0D
00338Er 2  F0 1F                beq     @show
003390r 2  C9 20                cmp     #' '
003392r 2  D0 3D                bne     @bad
003394r 2  A2 00                ldx     #0                  ; 14 digits
003396r 2  BD 02 02     @d:     lda     IN+2,x
003399r 2  C9 30                cmp     #'0'
00339Br 2  90 34                bcc     @bad
00339Dr 2  C9 3A                cmp     #'9'+1
00339Fr 2  B0 30                bcs     @bad
0033A1r 2  E8                   inx
0033A2r 2  E0 0E                cpx     #14
0033A4r 2  D0 F0                bne     @d
0033A6r 2  A9 02                lda     #<(IN+2)
0033A8r 2  A0 02                ldy     #>(IN+2)
0033AAr 2  20 rr rr             jsr     FS_SETTIME
0033ADr 2  B0 19                bcs     @no
0033AFr 2  A9 rr        @show:  lda     #<mon_tbuf
0033B1r 2  A0 rr                ldy     #>mon_tbuf
0033B3r 2  20 rr rr             jsr     FS_TIME
0033B6r 2  B0 10                bcs     @no
0033B8r 2  A9 rr                lda     #<mon_crlf
0033BAr 2  A0 rr                ldy     #>mon_crlf
0033BCr 2  20 rr rr             jsr     mon_puts
0033BFr 2  A9 rr                lda     #<mon_tbuf
0033C1r 2  A0 rr                ldy     #>mon_tbuf
0033C3r 2  20 rr rr             jsr     mon_puts
0033C6r 2  38                   sec
0033C7r 2  60                   rts
0033C8r 2  A9 rr        @no:    lda     #<mon_noclk
0033CAr 2  A0 rr                ldy     #>mon_noclk
0033CCr 2  20 rr rr             jsr     mon_puts
0033CFr 2  38                   sec
0033D0r 2  60                   rts
0033D1r 2  A9 rr        @bad:   lda     #<mon_tbad
0033D3r 2  A0 rr                ldy     #>mon_tbad
0033D5r 2  20 rr rr             jsr     mon_puts
0033D8r 2  38                   sec
0033D9r 2  60                   rts
0033DAr 2               
0033DAr 2  0D 0A 3F 4E  mon_noclk:   .byte 13,10,"?NO CLOCK",0
