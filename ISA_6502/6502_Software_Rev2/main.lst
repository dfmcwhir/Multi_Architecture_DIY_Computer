00374Dr 2  EE rr rr             inc     dir_len
003750r 2  AE rr rr     @r:     ldx     dir_sx
003753r 2  AC rr rr             ldy     dir_sy
003756r 2  60                   rts
003757r 2  AD rr rr     @eol:   lda     dir_len
00375Ar 2  F0 F4                beq     @r
00375Cr 2  20 rr rr             jsr     dir_parse
00375Fr 2  A9 00                lda     #0
003761r 2  8D rr rr             sta     dir_len
003764r 2  F0 EA                beq     @r
003766r 2               
003766r 2  60           dp_no:  rts
003767r 2               
003767r 2               ; dir_parse - dir_line (dir_len) -> an entry at (dir_ptr), if it is one
003767r 2               dir_parse:
003767r 2  A2 0F                ldx     #15                 ; blank entry: spaces, then zeros
003769r 2  A9 00        @clr:   lda     #0
00376Br 2  E0 0B                cpx     #11
00376Dr 2  B0 02                bcs     :+
00376Fr 2  A9 20                lda     #' '
003771r 2  9D rr rr     :       sta     dir_ent,x
003774r 2  CA                   dex
003775r 2  10 F2                bpl     @clr
003777r 2  A2 00                ldx     #0
003779r 2  20 rr rr             jsr     dp_blanks
00377Cr 2  A0 00                ldy     #0                  ; the name: 1-8 characters
00377Er 2  20 rr rr     @nm:    jsr     dp_char
003781r 2  B0 0F                bcs     @nme
003783r 2  C9 2E                cmp     #'.'
003785r 2  F0 0B                beq     @nme
003787r 2  C0 08                cpy     #8
003789r 2  B0 DB                bcs     dp_no
00378Br 2  99 rr rr             sta     dir_ent,y
00378Er 2  C8                   iny
00378Fr 2  E8                   inx
003790r 2  D0 EC                bne     @nm
003792r 2  C0 00        @nme:   cpy     #0
003794r 2  F0 D0                beq     dp_no                 ; ("." and ".." too)
003796r 2  C9 2E                cmp     #'.'
003798r 2  D0 13                bne     @sp
00379Ar 2  E8                   inx                         ; the extension: up to 3
00379Br 2  A0 08                ldy     #8
00379Dr 2  20 rr rr     @ex:    jsr     dp_char
0037A0r 2  B0 0B                bcs     @sp
0037A2r 2  C0 0B                cpy     #11
0037A4r 2  B0 C0                bcs     dp_no
0037A6r 2  99 rr rr             sta     dir_ent,y
0037A9r 2  C8                   iny
0037AAr 2  E8                   inx
0037ABr 2  D0 F0                bne     @ex
0037ADr 2  20 rr rr     @sp:    jsr     dp_blanks           ; then <DIR> or the size
0037B0r 2  EC rr rr             cpx     dir_len
0037B3r 2  B0 59                bcs     @no
0037B5r 2  BD rr rr             lda     dir_line,x
0037B8r 2  C9 3C                cmp     #'<'
0037BAr 2  D0 07                bne     @num
0037BCr 2  A9 10                lda     #$10
0037BEr 2  8D rr rr             sta     dir_ent+11
0037C1r 2  D0 2B                bne     @put
0037C3r 2  20 rr rr     @num:   jsr     dp_digit
0037C6r 2  B0 46                bcs     @no
0037C8r 2  48           @dg:    pha                         ; size = size * 10 + digit
0037C9r 2  20 rr rr             jsr     dp_x10
0037CCr 2  68                   pla
0037CDr 2  18                   clc
0037CEr 2  6D rr rr             adc     dir_ent+12
0037D1r 2  8D rr rr             sta     dir_ent+12
0037D4r 2  90 0D                bcc     :+
0037D6r 2  EE rr rr             inc     dir_ent+13
0037D9r 2  D0 08                bne     :+
0037DBr 2  EE rr rr             inc     dir_ent+14
0037DEr 2  D0 03                bne     :+
0037E0r 2  EE rr rr             inc     dir_ent+15
0037E3r 2  E8           :       inx
0037E4r 2  EC rr rr             cpx     dir_len
0037E7r 2  B0 05                bcs     @put
0037E9r 2  20 rr rr             jsr     dp_digit
0037ECr 2  90 DA                bcc     @dg
0037EEr 2  AD rr rr     @put:   lda     dir_n               ; room for it?
0037F1r 2  CD rr rr             cmp     dir_max
0037F4r 2  B0 18                bcs     @no
0037F6r 2  EE rr rr             inc     dir_n
0037F9r 2  A0 0F                ldy     #15
0037FBr 2  B9 rr rr     @cp:    lda     dir_ent,y
0037FEr 2  91 rr                sta     (dir_ptr),y
003800r 2  88                   dey
003801r 2  10 F8                bpl     @cp
003803r 2  A5 rr                lda     dir_ptr
003805r 2  18                   clc
003806r 2  69 10                adc     #16
003808r 2  85 rr                sta     dir_ptr
00380Ar 2  90 02                bcc     @no
00380Cr 2  E6 rr                inc     dir_ptr+1
00380Er 2  60           @no:    rts
00380Fr 2               
00380Fr 2               ; X past the blanks in dir_line
00380Fr 2               dp_blanks:
00380Fr 2  EC rr rr             cpx     dir_len
003812r 2  B0 0A                bcs     @r
003814r 2  BD rr rr             lda     dir_line,x
003817r 2  C9 20                cmp     #' '
003819r 2  D0 03                bne     @r
00381Br 2  E8                   inx
00381Cr 2  D0 F1                bne     dp_blanks
00381Er 2  60           @r:     rts
00381Fr 2               ; the name character at X: C=1 at a blank or the end (A = '.' if a dot)
00381Fr 2               dp_char:
00381Fr 2  EC rr rr             cpx     dir_len
003822r 2  B0 13                bcs     @end
003824r 2  BD rr rr             lda     dir_line,x
003827r 2  C9 21                cmp     #' '+1
003829r 2  90 0C                bcc     @end
00382Br 2  C9 61                cmp     #'a'                ; (upper case)
00382Dr 2  90 06                bcc     :+
00382Fr 2  C9 7B                cmp     #'z'+1
003831r 2  B0 02                bcs     :+
003833r 2  29 DF                and     #$DF
003835r 2  18           :       clc
003836r 2  60                   rts
003837r 2  38           @end:   sec
003838r 2  60                   rts
003839r 2               ; the digit at X -> A (0-9), C=0; C=1 not a digit
003839r 2               dp_digit:
003839r 2  BD rr rr             lda     dir_line,x
00383Cr 2  38                   sec
00383Dr 2  E9 30                sbc     #'0'
