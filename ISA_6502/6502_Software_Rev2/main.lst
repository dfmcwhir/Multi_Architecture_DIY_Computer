000D3Er 2               ; pico_gbox - rectangle with corners gfx_x, gfx_y and gfx_x1, gfx_y1 in gfx_c;
000D3Er 2               ; gfx_f = 1 outline, 2 filled
000D3Er 2               ; ----------------------------------------------------------------------------
000D3Er 2               pico_gbox:
000D3Er 2  08                   php
000D3Fr 2  78                   sei
000D40r 2  A2 07                ldx     #7                      ; keep the corners
000D42r 2  BD rr rr     @k:     lda     gfx_x,x
000D45r 2  9D rr rr             sta     pb_x0,x
000D48r 2  CA                   dex
000D49r 2  10 F7                bpl     @k
