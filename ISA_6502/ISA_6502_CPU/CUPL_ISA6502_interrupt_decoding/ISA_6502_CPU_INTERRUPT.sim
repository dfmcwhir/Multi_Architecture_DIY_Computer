%SIGNAL
PIN   2 =  A0 
PIN   3 =  A1 
PIN   4 =  A2 
PIN   5 =  A3 
PIN   6 =  A4 
PIN   7 =  A5 
PIN   8 =  A6 
PIN   9 =  A7 
PIN  10 =  IOen 
PIN  22 = !OE 
PIN  23 = !OEtmp 
%END

%FIELD
FIELD addr = A7,A6,A5,A4,A3,A2,A1,A0
%END

%EQUATION
!OE =>
    !A7
  # !A6
  # !A5
  # !A4
  # !A3
  # !A2
  # !A1
  # !A0
  # IOen

!OEtmp =>
    OE

OE.oe  =>
    1 

OEtmp.oe  =>
    1 

%END
