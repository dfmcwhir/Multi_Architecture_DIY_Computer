Name     ISA_6502_CPU_INTERRUPT ;
PartNo   00 ;
Date     10/25/2026 ;
Revision 02 ;
Designer Engineer ;
Company  none ;
Assembly None ;
Location  ;
Device   g22v10 ;

/*
 * CPU board I/O registers:
 *   $7FFF read : interrupt register ('574 /OE)
 *   $7FFE write: bank register  (D3-D0 -> bus A19-A16)
 *   $7FFE read : bank register readback on D3-D0 (D7-D4 not driven:
 *                use AND #$0F)
 *
 * Rev 02 changes
 *   - Interrupt register /OE now requires a read. Before, a write to $7FFF
 *     would have the '574 and the CPU driving the data bus together.
 *     It is still not gated with the clock (fast enough for 8 MHz):
 *     driving during clock-low of a read cycle is harmless here.
 *   - 4-bit bank register, loaded on the rising edge of /CLK (pin 1, from
 *     the 74ACT74 /Q), i.e. a few ns after the CPU clock falls at the end
 *     of the write cycle - inside the 65C02's write data hold time.
 *   - Bank outputs drive bus A16-A19 except while /DMA is low, so a future
 *     DMA master can drive those lines itself.
 *
 * /RESET (pin 22) clears the bank register to bank 0. Writing 0 to $7FFE
 * in BIOS init as well does no harm.
 *
 * New connections compared with rev 01:
 *   pin 1   <- /CLK (74ACT74 FF1 /Q)
 *   pin 11  <- R/W (CPU, or buffered R/W from the 74ACT00)
 *   pin 13  <- /DMA (bus DRQ2 line, high = normal)
 *   pins 14-17 <-> D0-D3 (data bus)
 *   pins 18-21  -> bus A16-A19
 *   pin 22  <- /RESET (was a spare copy of /OE)
 *   pin 23   -> interrupt register '574 /OE, as before
 */

/* *************** INPUT PINS *********************/
PIN 1    =  nCLK                     ; /* /CLK, register clock              */
PIN 2    =  A0                       ;
PIN 3    =  A1                       ;
PIN 4    =  A2                       ;
PIN 5    =  A3                       ;
PIN 6    =  A4                       ;
PIN 7    =  A5                       ;
PIN 8    =  A6                       ;
PIN 9    =  A7                       ;
PIN 10   =  IOen                     ; /* /IOen from main GAL (pin level)   */
PIN 11   =  RW                       ; /* R/W, high = read                  */
PIN 13   =  nDMA                     ; /* /DMA, high = normal               */

/* *************** I/O AND OUTPUT PINS ***************/
PIN 14   =  D0                       ; /* data bus, bidirectional           */
PIN 15   =  D1                       ;
PIN 16   =  D2                       ;
PIN 17   =  D3                       ;
PIN 18   =  BA16                     ; /* bank bit 0 -> bus A16 (registered) */
PIN 19   =  BA17                     ; /* bank bit 1 -> bus A17             */
PIN 20   =  BA18                     ; /* bank bit 2 -> bus A18             */
PIN 21   =  BA19                     ; /* bank bit 3 -> bus A19             */
PIN 22   =  nRESET                   ; /* bus /RESET, clears bank register  */
PIN 23   =  !OE                      ; /* interrupt register /OE -> '574    */

/** Declarations and Intermediate Variable Definitions  **/

field addr = [A7..0] ;

INTSEL  = addr:['h'ff] & !IOen;      /* $7FFF */
BANKSEL = addr:['h'fe] & !IOen;      /* $7FFE */
BANKWR  = BANKSEL & !RW;
BANKRD  = BANKSEL & RW;

/** Logic Equations **/

/* interrupt register: reads only */
OE    = INTSEL & RW;

/* bank register: load D3-D0 on a write to $7FFE, otherwise hold */
BA16.d = (BANKWR & D0) # (!BANKWR & BA16);
BA17.d = (BANKWR & D1) # (!BANKWR & BA17);
BA18.d = (BANKWR & D2) # (!BANKWR & BA18);
BA19.d = (BANKWR & D3) # (!BANKWR & BA19);

BA16.oe = nDMA;
BA17.oe = nDMA;
BA18.oe = nDMA;
BA19.oe = nDMA;

/* /RESET clears the bank register to bank 0 (AR and SP are shared by
   all registers in a 22V10, so set once) */
BA16.ar = !nRESET;
BA16.sp = 'b'0;

/* bank register readback: drive D3-D0 on a read of $7FFE */
D0 = BA16;
D1 = BA17;
D2 = BA18;
D3 = BA19;
D0.oe = BANKRD;
D1.oe = BANKRD;
D2.oe = BANKRD;
D3.oe = BANKRD;
