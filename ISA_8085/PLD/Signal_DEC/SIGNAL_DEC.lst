 10:
 11:/* *************** INPUT PINS *********************/
 12:pin 1    = CLK_IN                       ; /*                                 */ 
 13:PIN 2    = IOM                          ; /*                                 */ 
 14:PIN 3     = A15                         ; /*                                 */ 
 15:PIN 4     = SWAPMEM                     ; /*                                 */ 
 16:PIN 5     = RD                          ; /*                                 */ 
 17:PIN 6     = WR                          ; /*                                 */ 
 18:
 19:/* *************** OUTPUT PINS *********************/
 20:PIN 12     = RAMEN                      ; /*                                 */
 21:PIN 13     = ROMEN                      ; /*                                 */
 22:PIN 14     = IOEN                       ; /*                                 */ 
 23:PIN 15     = IOR                        ; /*                                 */ 
 24:PIN 16     = IOW                        ; /*                                 */ 
 25:PIN 17     = MEMR                       ; /*                                 */ 
 26:PIN 18     = MEMW                       ; /*                                 */ 
 27:PIN 19     = CLK_OUT                    ; /*                                 */ 
 28:
 29:/** Declarations and Intermediate Variable Definitions  **/
 30:
 31:/** Logic Equations **/
 32:
 33:!ROMEN = (A15 & !IOM & SWAPMEM) # (!A15 & !IOM & !SWAPMEM);
 34:!RAMEN = (!A15 & !IOM & SWAPMEM) # (A15 & !IOM & !SWAPMEM);
 35:!IOEN = IOM;
 36:!IOR = IOM & !RD;
 37:!IOW = IOM & !WR;
 38:!MEMR = !IOM & !RD;
 39:!MEMW = !IOM & !WR;
 40:CLK_OUT = !CLK_IN;
