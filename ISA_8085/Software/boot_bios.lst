     389/ 4C5 :                                 INCLUDE "basic.asm"
(1)    1/ 4C5 :                         ; =====================================================================
(1)    2/ 4C5 :                         ;  Tiny BASIC for the 8085 board  (original implementation)
(1)    3/ 4C5 :                         ;  - 16 bit signed integers, variables A-Z, array @(0..127)
(1)    4/ 4C5 :                         ;  - Statements: LET IF GOTO GOSUB RETURN FOR/TO/STEP NEXT PRINT (?) INPUT
(1)    5/ 4C5 :                         ;                REM END STOP RUN LIST NEW POKE OUT CLS MON
(1)    6/ 4C5 :                         ;                SAVE LOAD DIR ERASE   (CH376 USB storage; LOAD "$" = DIR)
(1)    7/ 4C5 :                         ;  - Functions:  ABS(x) RND(x) SIZE PEEK(x) IN(x)     $hhhh = hex literal
(1)    8/ 4C5 :                         ;  - Operators:  + - * /  and  = < > <= >= <> #  (result 1 or 0)
(1)    9/ 4C5 :                         ;  Uses only 8080 instructions.  Text pointer lives in DE, values in HL.
(1)   10/ 4C5 :                         ; =====================================================================
(1)   11/ 4C5 :                         
(1)   12/ 4C5 : =0DH                    CR          EQU 0DH
(1)   13/ 4C5 : =0AH                    LF          EQU 0AH
(1)   14/ 4C5 : =22H                    QT          EQU 22H
(1)   15/ 4C5 : =8H                     BS          EQU 08H
(1)   16/ 4C5 : =7FH                    DEL         EQU 7FH
(1)   17/ 4C5 : =4FH                    LBMAX       EQU 79
(1)   18/ 4C5 :                         
(1)   19/ 4C5 :                         ; ---------------- RAM map ----------------
(1)   20/ 4C5 : =8300H                  LINBUF      EQU 8300H               ; command line (80)
(1)   21/ 4C5 : =8350H                  INBUF       EQU 8350H               ; INPUT line (80)
(1)   22/ 4C5 : =83A0H                  FBUF        EQU 83A0H               ; SAVE/LOAD line buffer (96)
(1)   23/ 4C5 : =8400H                  ARRAY       EQU 8400H               ; @(0..127), 256 bytes
(1)   24/ 4C5 : =8500H                  VARTAB      EQU 8500H               ; A-Z, 52 bytes
(1)   25/ 4C5 : =8540H                  BVARS       EQU 8540H               ; scalars, cleared at cold start
(1)   26/ 4C5 : =8540H                  PRGEND      EQU 8540H
(1)   27/ 4C5 : =8542H                  CURLIN      EQU 8542H               ; address of running line record, 0 = direct mode
(1)   28/ 4C5 : =8544H                  FORVAR      EQU 8544H
(1)   29/ 4C5 : =8546H                  FORLIM      EQU 8546H
(1)   30/ 4C5 : =8548H                  NXVAR       EQU 8548H
(1)   31/ 4C5 : =854AH                  NXLIM       EQU 854AH
(1)   32/ 4C5 : =854CH                  NXSTP       EQU 854CH
(1)   33/ 4C5 : =854EH                  NXLN        EQU 854EH
