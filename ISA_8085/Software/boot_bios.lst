     387/ 29C :                         
     388/ 29C :                                 INCLUDE "ch376.asm"
(1)    1/ 29C :                         ; =====================================================================
(1)    2/ 29C :                         ;  CH376 driver - parallel interface, ports 20H (data) / 21H (command)
(1)    3/ 29C :                         ;  Polled: INT# is read from status bit 7 (0 = interrupt pending),
(1)    4/ 29C :                         ;  busy is status bit 4.  All routines preserve nothing unless noted.
(1)    5/ 29C :                         ;  Status codes returned in A: 14H = success, 1DH = more data,
(1)    6/ 29C :                         ;  1EH = write more, 42H = file not found, F0H/F1H/F2H = init errors,
(1)    7/ 29C :                         ;  FFH = timeout.
(1)    8/ 29C :                         ; =====================================================================
(1)    9/ 29C :                         
(1)   10/ 29C : =20H                    CH_DATA     EQU 20H
(1)   11/ 29C : =21H                    CH_CMD      EQU 21H
(1)   12/ 29C :                         
(1)   13/ 29C :                         ; CPU clock in kHz (4.9152 MHz crystal / 2 = 2.4576 MHz) - used only for
(1)   14/ 29C :                         ; the post-reset delay.
(1)   15/ 29C : =99AH                   CPUKHZ      EQU 2458
(1)   16/ 29C : =0E00H                  CHDLYCNT    EQU (35*CPUKHZ)/24      ; about 35 ms per CH_DELAY
(1)   17/ 29C :                         
(1)   18/ 29C :                         ; RAM (inside the cleared 8030-80FF block)
(1)   19/ 29C : =8037H                  CHFLAG      EQU 8037H               ; 1 = mounted
