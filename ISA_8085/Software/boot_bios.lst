(1) 1870/1215 :                         
     390/1215 :                                 INCLUDE "monitor.asm"
(1)    1/1215 :                         ; =====================================================================
(1)    2/1215 :                         ;  Monitor for the 8085 board.  Works on whichever console is selected
(1)    3/1215 :                         ;  (CONSEL).  Reuses the console and number routines from basic.asm.
(1)    4/1215 :                         ;
(1)    5/1215 :                         ;   D [s [e]]       dump memory (hex + ASCII); D alone continues
(1)    6/1215 :                         ;   E a             examine/modify: type hex + Enter to change, Enter to
(1)    7/1215 :                         ;                   skip to the next byte, "." to quit
(1)    8/1215 :                         ;   F s e v         fill s..e with v
(1)    9/1215 :                         ;   M s e d         move s..e to d (overlap safe)
(1)   10/1215 :                         ;   G a             call the program at a (end it with RET to come back)
(1)   11/1215 :                         ;   L               load Intel HEX arriving on the SERIAL port
(1)   12/1215 :                         ;   S s e           send s..e as Intel HEX out of the SERIAL port
(1)   13/1215 :                         ;   DIR             list the USB disk        (also "$")
(1)   14/1215 :                         ;   LD name a       load file name (default .BIN) into memory at a
(1)   15/1215 :                         ;   SV name s e     save s..e to file name (default .BIN)
(1)   16/1215 :                         ;   I p / O p v     read / write I/O port p
(1)   17/1215 :                         ;   C n             switch console: 0 = serial, 1 = keyboard/display
(1)   18/1215 :                         ;   K               hex-dump keys typed on the display keyboard (Ctrl-C ends)
(1)   19/1215 :                         ;   Z               send a test line to the display card
(1)   20/1215 :                         ;   R               show registers saved by the last RST 1 breakpoint
(1)   21/1215 :                         ;   B               cold start BASIC         W  warm start BASIC
(1)   22/1215 :                         ;   ?               help
(1)   23/1215 :                         ;  All numbers are hex.  RST 1 (opcode CFH) in a program is a breakpoint.
(1)   24/1215 :                         ; =====================================================================
(1)   25/1215 :                         
(1)   26/1215 :                         ; monitor variables live at the bottom of the stack area (FC00-FC5F);
 AS V1.42 Beta [Bld 311] - Source File boot_bios.asm(monitor.asm) - Page 45 - 10/9/2026 11:51:38


(1)   27/1215 :                         ; the command line borrows BASIC's INPUT buffer
(1)   28/1215 : =0FC00H                 MVARS       EQU 0FC00H
(1)   29/1215 : =0FC00H                 MN_LAST     EQU MVARS+0             ; word: where "D" continues
(1)   30/1215 : =0FC02H                 MN_A1       EQU MVARS+2             ; parsed arguments
(1)   31/1215 : =0FC04H                 MN_A2       EQU MVARS+4
(1)   32/1215 : =0FC06H                 MN_A3       EQU MVARS+6
(1)   33/1215 : =0FC08H                 MN_CNT      EQU MVARS+8
