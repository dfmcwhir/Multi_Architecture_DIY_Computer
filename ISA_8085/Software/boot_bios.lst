(1) 2512/16E4 :                         
     443/16E4 :                                 INCLUDE "monitor.asm"
(1)    1/16E4 :                         ; =====================================================================
(1)    2/16E4 :                         ;  Monitor for the 8085 board.  Works on whichever console is selected
(1)    3/16E4 :                         ;  (CONSEL).  Reuses the console and number routines from basic.asm.
(1)    4/16E4 :                         ;
(1)    5/16E4 :                         ;   D [s [e]]       dump memory (hex + ASCII); D alone continues
(1)    6/16E4 :                         ;   E a             examine/modify: type hex + Enter to change, Enter to
(1)    7/16E4 :                         ;                   skip to the next byte, "." to quit
(1)    8/16E4 :                         ;   F s e v         fill s..e with v
(1)    9/16E4 :                         ;   M s e d         move s..e to d (overlap safe)
(1)   10/16E4 :                         ;   G a             call the program at a (end it with RET to come back)
(1)   11/16E4 :                         ;   L               load Intel HEX arriving on the SERIAL port
(1)   12/16E4 :                         ;   S s e           send s..e as Intel HEX out of the SERIAL port
(1)   13/16E4 :                         ;   DIR             list the USB disk        (also "$")
(1)   14/16E4 :                         ;   LD name a       load file name (default .BIN) into memory at a
(1)   15/16E4 :                         ;   SV name s e     save s..e to file name (default .BIN)
(1)   16/16E4 :                         ;   I p / O p v     read / write I/O port p
(1)   17/16E4 :                         ;   C n             switch console: 0 = serial, 1 = keyboard/display
(1)   18/16E4 :                         ;   K               hex-dump keys typed on the display keyboard (Ctrl-C ends)
(1)   19/16E4 :                         ;   Z               send a test line to the display card
(1)   20/16E4 :                         ;   R               show registers saved by the last RST 1 breakpoint
(1)   21/16E4 :                         ;   B               cold start BASIC         W  warm start BASIC
(1)   22/16E4 :                         ;   ?               help
(1)   23/16E4 :                         ;  All numbers are hex.  RST 1 (opcode CFH) in a program is a breakpoint.
(1)   24/16E4 :                         ; =====================================================================
(1)   25/16E4 :                         
(1)   26/16E4 :                         ; monitor variables live at the bottom of the stack area (FC00-FC5F);
(1)   27/16E4 :                         ; the command line borrows BASIC's INPUT buffer
 AS V1.42 Beta [Bld 311] - Source File boot_bios.asm(monitor.asm) - Page 57 - 11/4/2026 15:54:28


