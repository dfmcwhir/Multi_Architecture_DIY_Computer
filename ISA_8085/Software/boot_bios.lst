     442/ 516 :                                 INCLUDE "basic.asm"
(1)    1/ 516 :                         ; =====================================================================
(1)    2/ 516 :                         ;  Tiny BASIC for the 8085 board  (original implementation)
(1)    3/ 516 :                         ;  - 16 bit signed integers, variables A-Z, array @(0..127)
(1)    4/ 516 :                         ;  - Statements: LET IF GOTO GOSUB RETURN FOR/TO/STEP NEXT PRINT (?) INPUT
(1)    5/ 516 :                         ;                REM END STOP RUN LIST NEW POKE OUT CLS MON
(1)    6/ 516 :                         ;                SAVE LOAD DIR ERASE   (CH376 USB storage; LOAD "$" = DIR)
(1)    7/ 516 :                         ;                SETISR irq,line   CLRISR irq     (BASIC interrupt handlers)
(1)    8/ 516 :                         ;  - Functions:  ABS(x) RND(x) SIZE PEEK(x) IN(x)     $hhhh = hex literal
(1)    9/ 516 :                         ;                USR(addr[,arg])  call machine code   IFR  VIA flags latched
(1)   10/ 516 :                         ;  - PRINT $(x) prints x in hex
(1)   11/ 516 :                         ;  - Operators (lowest first):  OR XOR | AND | = < > <= >= <> # | << >> | + - | * /
(1)   12/ 516 :                         ;                NOT x     relations give -1 (true) or 0, so AND/OR/NOT work on them
(1)   13/ 516 :                         ;  - PRINT: "text"  expr  CHR$(n) (any raw byte, e.g. VT100 ESC = CHR$(27))
(1)   14/ 516 :                         ;           $(expr) (hex)   ; and , separators
(1)   15/ 516 :                         ;  - SEND d,byte,...   INKEY(d)    raw access to the serial card (d=0) or the
(1)   16/ 516 :                         ;                keyboard/display card (d=1), for whichever is not the console
(1)   17/ 516 :                         ;  - SETISR (statement, irq)   run a statement when IRQ n happens, any time
(1)   18/ 516 :                         ;  Uses only 8080 instructions.  Text pointer lives in DE, values in HL.
(1)   19/ 516 :                         ; =====================================================================
(1)   20/ 516 :                         
(1)   21/ 516 : =0DH                    CR          EQU 0DH
(1)   22/ 516 : =0AH                    LF          EQU 0AH
(1)   23/ 516 : =22H                    QT          EQU 22H
(1)   24/ 516 : =8H                     BS          EQU 08H
(1)   25/ 516 : =7FH                    DEL         EQU 7FH
