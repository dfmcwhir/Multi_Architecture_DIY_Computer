      32/   0 :                         
      33/   0 :                         ; Console selected at power-up: 0 = serial card, 1 = keyboard/display card
      34/   0 : =1H                     DEFCON      EQU 1
      35/   0 :                         
      36/   0 :                         ; 1 = interrupt driven receive (RST 6.5 unmasked)
      37/   0 :                         ; 0 = polled only: RST 6.5 stays masked.  Use 0 to find out whether the
      38/   0 :                         ;     interrupt hardware is what is blocking the keyboard.  Keys are still
      39/   0 :                         ;     read whenever a program waits for one; characters typed while BASIC is
      40/   0 :                         ;     busy printing or running are lost.
      41/   0 : =1H                     USEIRQ      EQU 1
      42/   0 : =1DH                    SIMVAL      EQU 1FH-(2*USEIRQ)  ; 1DH = unmask 6.5 only, 1FH = mask everything
