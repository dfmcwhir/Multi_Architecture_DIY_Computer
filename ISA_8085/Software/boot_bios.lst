     440/ 2D1 :                         
     441/ 2D1 :                                 INCLUDE "ch376.asm"
(1)    1/ 2D1 :                         ; =====================================================================
(1)    2/ 2D1 :                         ;  CH376 driver - parallel interface, ports 20H (data) / 21H (command)
(1)    3/ 2D1 :                         ;  Polled: INT# is read from status bit 7 (0 = interrupt pending),
(1)    4/ 2D1 :                         ;  busy is status bit 4.  All routines preserve nothing unless noted.
(1)    5/ 2D1 :                         ;  Status codes returned in A: 14H = success, 1DH = more data,
(1)    6/ 2D1 :                         ;  1EH = write more, 42H = file not found, F0H/F1H/F2H = init errors,
(1)    7/ 2D1 :                         ;  FFH = timeout.
(1)    8/ 2D1 :                         ; =====================================================================
(1)    9/ 2D1 :                         
(1)   10/ 2D1 : =20H                    CH_DATA     EQU 20H
(1)   11/ 2D1 : =21H                    CH_CMD      EQU 21H
(1)   12/ 2D1 :                         
(1)   13/ 2D1 :                         ; CPU clock in kHz (4.9152 MHz crystal / 2 = 2.4576 MHz) - used only for
(1)   14/ 2D1 :                         ; the post-reset delay.
(1)   15/ 2D1 : =99AH                   CPUKHZ      EQU 2458
(1)   16/ 2D1 : =0E00H                  CHDLYCNT    EQU (35*CPUKHZ)/24      ; about 35 ms per CH_DELAY
(1)   17/ 2D1 :                         
(1)   18/ 2D1 :                         ; RAM (inside the cleared 8030-80FF block)
(1)   19/ 2D1 : =803DH                  CHBTMO      EQU 803DH               ; word: busy-wait loop count, 0 = 65536 (normal)
(1)   20/ 2D1 : =803FH                  CHRES       EQU 803FH               ; result of the boot-time CH_INIT
(1)   21/ 2D1 : =8037H                  CHFLAG      EQU 8037H               ; 1 = mounted
(1)   22/ 2D1 : =8038H                  CHCNT       EQU 8038H               ; bytes left in CHBUF
(1)   23/ 2D1 : =8039H                  CHEOF       EQU 8039H
(1)   24/ 2D1 : =803AH                  CHPTR       EQU 803AH               ; word
(1)   25/ 2D1 : =8040H                  CHBUF       EQU 8040H               ; 64 bytes
(1)   26/ 2D1 : =8080H                  NAMEBUF     EQU 8080H               ; 32 bytes
(1)   27/ 2D1 : =80A0H                  DIRBUF      EQU 80A0H               ; 64 bytes (32 used)
(1)   28/ 2D1 :                         
(1)   29/ 2D1 :                         ; ---------------- low level ----------------
(1)   30/ 2D1 :                         ; wait until not busy; CY=1 on timeout
(1)   31/ 2D1 : C5                      CH_BUSY:PUSH B
(1)   32/ 2D2 : E5                              PUSH H
(1)   33/ 2D3 : 2A 3D 80                        LHLD CHBTMO             ; 0 = full length wait; CH_INIT shortens it while probing
(1)   34/ 2D6 : 44                              MOV  B,H
(1)   35/ 2D7 : 4D                              MOV  C,L
(1)   36/ 2D8 : E1                              POP  H
(1)   37/ 2D9 : DB 21                   CBY1:   IN   CH_CMD
(1)   38/ 2DB : E6 10                           ANI  10H
(1)   39/ 2DD : CA E9 02                        JZ   CBY2
