 54:PIN 7  = nRD ;       /* Z80 /RD                                       */
 55:PIN 8  = nWR ;       /* Z80 /WR                                       */
 56:PIN 9  = nMREQ ;     /* Z80 /MREQ                                     */
 57:PIN 10 = nM1 ;       /* Z80 /M1                                       */
 58:PIN 11 = CLK ;       /* CPU clock (74ACT74 FF1 Q)                     */
 59:PIN 13 = RDYS ;      /* 74ACT74 FF2 Q, low = stretching               */
 60:
 61:/* *************** OUTPUT PINS *********************/
 62:PIN 14 = !IOR ;      /* bus pin 14 /IOR (via 33R optional)            */
 63:PIN 15 = !IOW ;      /* bus pin 13 /IOW                               */
 64:PIN 16 = F1 ;        /* state bit - test point, no connection         */
 65:PIN 17 = RAMEN ;     /* RAM CE2 (active high)                         */
 66:PIN 18 = F2 ;        /* state bit - test point, no connection         */
 67:PIN 19 = !BUSIOEN ;  /* bus pin 32 /IO_EN                             */
 68:PIN 20 = CLK_D ;     /* 74ACT74 FF1 D (pin 2)                         */
 69:PIN 21 = STR_D ;     /* 74ACT74 FF2 D (pin 12), low = stretch         */
 70:PIN 22 = !ROMEN ;    /* ROM /CS                                       */
 71:PIN 23 = RA16 ;      /* RAM A16                                       */
 72:
 73:/** Intermediate terms **/
 74:IOCYC = !nIORQ & nM1 & (!nRD # !nWR);   /* real I/O cycle, not INTA */
 75:
 76:/** I/O cycle shaping **/
 77:F1.d = IOCYC;
 78:F2.d = F1 & IOCYC;
 79:F1.ar = 'b'0;
 80:F1.sp = 'b'0;
 81:
 82:BUSIOEN = F2 & IOCYC;
 83:IOW     = F2 & IOCYC & !nWR;
 84:IOR     = F2 & IOCYC & !nRD & CLK;
 85:
 86:/** Clock stretcher **/
 87:/* FF1 next state: stays high while RDYS is low */
 88:CLK_D = !(CLK & RDYS);
 89:/* FF2 input: bus request, or one self-stretch period per I/O cycle */
 90:STR_D = nSTRBUS & !(F2 & IOCYC & RDYS);
 91:
 92:/** Memory **/
 93:ROMEN = !nMREQ & !A15 & !ROMDIS;
 94:RAMEN = !nMREQ & (A15 # ROMDIS # !nWR);
 95:RA16  = BA16 & A15;
 96:
 97:

[0016cb] Please note: no expression assigned to:  F2.ar
[0016cb] Please note: no expression assigned to:  F2.sp


