Created Sat Oct 31 12:08:27 2026

 54:
 55:/** Decodes (written out, no field ranges, to keep product terms low) **/
 56:P_FF = A7 & A6 & A5 & A4 & A3 & A2 & A1 & A0;
 57:P_FE = A7 & A6 & A5 & A4 & A3 & A2 & A1 & !A0;
 58:P_FD = A7 & A6 & A5 & A4 & A3 & A2 & !A1 & A0;
 59:
 60:BANKWR = P_FE & !nIOW;
 61:BANKRD = P_FE & !nIOR;
 62:ROMWR  = P_FD & !nIOW;
 63:
 64:/** Interrupt register **/
 65:INTOE = P_FF & !nIOR;
 66:
 67:/** Bank register **/
 68:BA16.d = BANKWR & D0 # !BANKWR & BA16;
 69:BA17.d = BANKWR & D1 # !BANKWR & BA17;
 70:BA18.d = BANKWR & D2 # !BANKWR & BA18;
 71:BA19.d = BANKWR & D3 # !BANKWR & BA19;
 72:BA16.oe = 'b'1;
 73:BA17.oe = 'b'1;
 74:BA18.oe = 'b'1;
 75:BA19.oe = 'b'1;
 76:
 77:/** ROM disable **/
 78:ROMDIS.d  = ROMWR & D0 # !ROMWR & ROMDIS;
 79:ROMDIS.oe = 'b'1;
 80:
 81:/* /RESET clears every register (AR is shared by all of them) */
 82:BA16.ar = !nRESET;
 83:BA16.sp = 'b'0;
 84:
 85:/** Bank readback **/
 86:D0 = BA16;
 87:D1 = BA17;
 88:D2 = BA18;
 89:D3 = BA19;
 90:D0.oe = BANKRD;
 91:D1.oe = BANKRD;
 92:D2.oe = BANKRD;
 93:D3.oe = BANKRD;
 94:
 95:

[0016cb] Please note: no expression assigned to:  BA17.ar
[0016cb] Please note: no expression assigned to:  BA17.sp
[0016cb] Please note: no expression assigned to:  BA18.ar
[0016cb] Please note: no expression assigned to:  BA18.sp
[0016cb] Please note: no expression assigned to:  BA19.ar
[0016cb] Please note: no expression assigned to:  BA19.sp
